+    const std::uint32_t pursuers = (roster.key >> 16 | roster.walking) & 0xFFFFu;
+    if (retreat_escapes(world, hold.pathing, safety, pursuers)) return true;
+    debug_block({ std::printf("STANDKEEP %d %u bag %d hp %.0f\n", world.round, my_handle(), bag_at_stake(world), my_health()); });
+    kept_stand = {world.round, static_cast<std::uint32_t>(world.me().handle)};
