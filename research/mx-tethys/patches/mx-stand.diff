+// Whether leaving a stand we win for home (retreat) gets us out before the pursuers (bit i: enemies[i])
+// kill us. The escape plan's fewest hits on any way out, this turn's by Safety as retreat prices it: none
+// escapes. Else they hit us on at least that many turns (2 reads two or more, or no way home), each stun of
+// theirs a turn more, and the walk fails if the pursuers kill us, never acting, within those turns (every one
+// striking each turn from where it stands now, at our tile). No plan (no pursuer near, home cut off, fuel
+// short): as before.
+bool retreat_escapes(const World& world, Pathing& pathing, Safety& safety, std::uint32_t pursuers) {
+    auto& plan = escape::plan(world, pathing, safety);
+    if (!plan.active()) return true;
+    const vec2 here = my_position();
+    const auto& home = pathing.to_ally_spawn();
+    const auto& blocked = pathing.blocked();
+    const float taken = world.me().taken;
+    const auto fewest = [&](bool slack) {
+        int h = escape::many;
+        for (auto d : directions) {
+            const vec2 q = here + d;
+            if (h == 0) break;
+            if (!in_bounds(q) || test(blocked, q) || home.at(q) == unreachable) continue;
+            const int later = plan.after_walk(q, slack);
+            if (later >= h) continue;
+            h = std::min(h, later + (safety.touched(q, taken) ? 1 : 0));
+        }
+        if (plan.dash_now() && h > 0) {
+            h = std::min(h, plan.keep_dash(slack));
+            for (auto q : Tiles<5 * 5>{pathing.dash_landings()}) h = std::min(h, plan.after_dash(q, slack));
+            for (auto d : directions)
+                if (const vec2 w = here + d; in_bounds(w) && !test(blocked, w)) h = std::min(h, plan.walk_dash(w, slack));
+        }
+        return h;
+    };
+    int h = fewest(false);
+    if (h > 0) {
+        plan.want_slack();
+        if (plan.slack_ready()) h = std::min(h, fewest(true));
+    }
+    if (h == 0) return true;
+    int turns = h;
+    if (world.me().facts().passive != Passive::stun_immune) {
+        int stuns = 0;
+        for (auto left = pursuers; left; left &= left - 1) {
+            const auto& f = world.enemies[static_cast<std::size_t>(std::countr_zero(left))].facts();
+            if (f.abilities[0].stuns || f.abilities[1].stuns) stuns += (turns + ability_cooldown - 1) / ability_cooldown;
+        }
+        turns += stuns;
+    }
+    turns = std::min(turns, Safety::chase_horizon);
+    return safety.turns_to_kill_chased(here, turns, pursuers) == 0;
+}
