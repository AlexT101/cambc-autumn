+// The enemy's farm, team_farm's mirror from what we see: its score and the bags we believe its champions carry
+// (World empties one at a tribute or a death), over its champions' camp output as last read, with our prior.
+const TeamFarm& enemy_farm(const World& world) {
+    static TeamFarm kept;
+    static int round = -1;
+    static std::uint32_t observations = ~0u;
+    if (round == world.round && observations == world.observations) return kept;
+    round = world.round, observations = world.observations;
+    int collected = world.score.enemy;
+    float output = 0;
+    for (const auto& e : world.enemies) collected += e.alive ? e.gems : 0, output += camp_output(e);
+    const float n = static_cast<float>(std::max<std::size_t>(1, world.enemies.size()));
+    const float per_round = (static_cast<float>(collected) + n * income_prior_gems)
+                            / (static_cast<float>(std::max(0, world.round)) + prior_rounds_per_gem * income_prior_gems);
+    kept.per_output = per_round / std::max(1.0f, output);
+    kept.to_win = static_cast<float>(std::max(0, static_cast<int>(cambc::constants::winning_gems) - collected)) / per_round;
+    return kept;
+}
+
+const ChampionBelief* enemy_prism(const World& world) {
+    for (const auto& e : world.enemies)
+        if (e.facts().passive == Passive::gem_focus) return e.alive ? &e : nullptr;
+    return nullptr;
+}
+
+// prism_premium for the living enemy Prism: what one more gem in its bag (with `gems` more) compounds into for the
+// enemy, at its Focus as last read and the enemy's pace. Its health is left out: a hurt Prism keeps its Focus
+// until it tributes, and we cannot see whether it means to.
+float enemy_prism_premium(const World& world, int gems) {
+    const ChampionBelief* p = enemy_prism(world);
+    if (!p || gems <= 0) return 0.0f;
+    const auto& map = world.map();
+    const int bag = p->gems, room = static_cast<int>(cambc::constants::winning_gems) - world.score.enemy - bag - gems;
+    const int last = rounds_left(world) - map.width - map.height - endgame_margin - tribute_turns(bag + gems, p->fast_tribute);
+    if (room < 0 || last <= 0) return 0.0f;
+    static int round = -1;
+    static std::uint32_t observations = ~0u;
+    static float rate = 0, to_win = 0, kept_horizon = -1, growth = 0;
+    if (round != world.round || observations != world.observations) {
+        round = world.round, observations = world.observations, kept_horizon = -1;
+        const auto& f = p->facts();
+        const float per_gem = cambc::constants::passive_abilities::prism_focus_per_gem;
+        const float output = (f.raw_output(p->strength, p->focus + per_gem) - f.raw_output(p->strength, p->focus)) * camp_scale(*p);
+        const auto& ef = enemy_farm(world);
+        rate = output * ef.per_output, to_win = ef.to_win;
+    }
+    const float horizon = std::max(0.0f, std::min(to_win, static_cast<float>(last)));
+    if (horizon != kept_horizon) kept_horizon = horizon, growth = std::expm1(rate * horizon);
+    return std::max(0.0f, std::min(growth, static_cast<float>(room) / static_cast<float>(gems)));
+}
+
+// The enemy Prism's take of the map's gem supply: its part of the enemy's pace (enemy_farm, by its share of the
+// enemy's camp output) over the gems all groups yield a round, each once a respawn and capture.
+float enemy_prism_take(const World& world) {
+    const ChampionBelief* p = enemy_prism(world);
+    if (!p) return 0.0f;
+    const auto& map = world.map();
+    static const StaticMap* supplied = nullptr;
+    static float supply = 0;
+    if (supplied != &map) {
+        supplied = &map, supply = 0;
+        for (const auto& G : map.groups) supply += static_cast<float>(G.gems) / static_cast<float>(G.respawn + capture_rounds(false));
+    }
+    float output = 0;
+    for (const auto& e : world.enemies) output += camp_output(e);
+    const auto& ef = enemy_farm(world);
+    const float pace = ef.per_output * std::max(1.0f, output); // the enemy's gems a round
+    return supply > 0 ? pace * camp_output(*p) / std::max(1.0f, output) / supply : 0.0f;
+}
+
+// Where we believe the enemy Prism is: in sight, its tile; else the centre of where it may be (its last fix, or its
+// spawn since its respawn), the box growing evenly about it.
+vec2 enemy_prism_tile(const World& world) {
+    const ChampionBelief* p = enemy_prism(world);
+    const auto& map = world.map();
+    if (!p) return map.enemy_spawn_centre;
+    if (p->visible) return p->pos;
+    if (p->tracked && p->possible_box.x0 <= p->possible_box.x1)
+        return {std::clamp((p->possible_box.x0 + p->possible_box.x1) / 2, 0, map.width - 1),
+                std::clamp((p->possible_box.y0 + p->possible_box.y1) / 2, 0, map.height - 1)};
+    return p->pos_round >= 0 ? p->pos : map.enemy_spawn_centre;
+}
