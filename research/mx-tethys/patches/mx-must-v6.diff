diff -ruN bots/variants/chy-ref/src/combat/muster.cc bots/variants/mx-must/src/combat/muster.cc
--- bots/variants/chy-ref/src/combat/muster.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/mx-must/src/combat/muster.cc	2026-11-13 16:30:16.636189071 +0000
@@ -0,0 +1,222 @@
+// The team's answer to a threat on its Prism. Prism reads the local fight against the enemies that
+// can strike it from within sight, with the allies already near it. Won: nothing changes. Not won, and
+// with allies that can join within the horizon, it calls them (comms::muster): an ally in time walks to
+// it and holds beside it, and Prism walks to meet the nearest. The brief's leave-now is not here: it
+// lost on train (v1, v2).
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// Enemies and allies that need more turns of walking than this to join are not counted.
+constexpr int horizon = comms::muster_horizon;
+
+struct Read {
+    MusterRead outcome = MusterRead::none;
+    bool threat = false; // an enemy can strike Prism within the horizon
+    int strike = 0;      // turns before the first counted enemy can
+    int near = 0, called = 0, enemies = 0;
+    int latest = 0; // the farthest walk of an ally counted in
+    vec2 meet{-1, -1}; // the nearest of them
+};
+
+bool won(const Trade& t) { return !t.lost && !t.self_falls; }
+
+// Where ally a is for the read: seen or posted recently (recent_tile, with the steps it may have
+// closed since), else the centre of the group it claims, where its work keeps it.
+bool ally_tile(const World& world, const ChampionBelief& a, vec2& at, int& slack) {
+    if (recent_tile(world, a, at, slack)) return true;
+    const int g = comms::claim_of(world, a.index);
+    if (g < 0 || g >= static_cast<int>(world.map().groups.size())) return false;
+    at = world.map().groups[static_cast<std::size_t>(g)].centre, slack = 0;
+    return true;
+}
+
+// An enemy's turns of walking before it can strike p, if within the horizon: an enemy in sight of p
+// strikes within vision_radius less its reach (on open ground), and that bounds the ones counted.
+int enemy_walk(Safety& safety, const ChampionBelief& e, vec2 p, int limit) {
+    return e.visible ? safety.approach(e, p, limit) : safety.unseen_approach(e, p, limit);
+}
+
+Read read_fight(const World& world, Safety& safety, vec2 here) {
+    Read r;
+    std::array<std::int8_t, 16> walk{}, arrive{};
+    std::uint32_t enemies = 0;
+    int first = horizon + 1;
+    const auto& spawn = world.map().near_enemy_spawn;
+    for (auto left = safety.live_enemies(); left; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        // Enemies by their spawn are not counted, as pursuers are not (Safety::late).
+        if (e.index >= 16 || (e.visible ? test(spawn, e.pos) : safety.possible_on_spawn(e))) continue;
+        const int w = enemy_walk(safety, e, here, horizon);
+        if (w > horizon) continue;
+        r.threat = true;
+        if (w > std::max(0, vision_radius - safety.strike_of(e).reach)) continue;
+        enemies |= 1u << e.index, walk[static_cast<std::size_t>(e.index)] = static_cast<std::int8_t>(w), first = std::min(first, w);
+    }
+    if (!enemies) return r;
+    r.strike = first;
+    r.enemies = std::popcount(enemies);
+    // The fight starts at the first strike: each enemy joins after its walk beyond it.
+    for (auto left = enemies; left; left &= left - 1) walk[static_cast<std::size_t>(std::countr_zero(left))] -= static_cast<std::int8_t>(first);
+    std::uint32_t near = 0, coming = 0;
+    int in_sight = 1; // us and the allies we see, as the enemies are counted
+    for (const auto& a : world.allies) {
+        if (!a.alive || a.index >= 16) continue;
+        if (a.is_self) {
+            near |= 1u << a.index;
+            continue;
+        }
+        in_sight += a.visible;
+        // In a channel it cannot come; a recall or tribute holds it until done.
+        if (a.visible && a.channel != Channel::none) continue;
+        vec2 at;
+        int slack = 0;
+        if (!ally_tile(world, a, at, slack)) continue;
+        const int steps = std::max(0, dist(at, here) - slack - safety_params::fight_ally_radius);
+        if (steps == 0 && a.visible) near |= 1u << a.index;
+        // One within the horizon joins the fight late, after its walk beyond the first strike: the
+        // fight decides whether Prism lasts until it comes.
+        else if (steps <= horizon) {
+            coming |= 1u << a.index, arrive[static_cast<std::size_t>(a.index)] = static_cast<std::int8_t>(std::max(0, steps - first));
+            if (!in_bounds(r.meet) || dist(at, here) < dist(r.meet, here)) r.meet = at;
+            // Posted as a cap on path length: the slack it may have closed is not counted on.
+            r.latest = std::min(horizon, std::max(r.latest, steps + slack));
+        }
+    }
+    r.near = std::popcount(near);
+    // With no ally that can come, no answer changes anything: the fight is not played.
+    if (!coming) return r.outcome = MusterRead::lost, r;
+    // Not outnumbered in sight, a lost fight is still Prism's death: the fight decides, not the count
+    // (`even` only labels the read). Lost near, the allies that can come are called whether or not the
+    // fight with them is won (leaving instead lost on train), so that fight is not played either.
+    if (won(safety.muster_trade(near, arrive, enemies, walk))) return r.outcome = r.enemies <= in_sight ? MusterRead::even : MusterRead::held, r;
+    r.called = std::popcount(coming);
+    return r.outcome = MusterRead::call, r;
+}
+
+// Prism's state across turns: a call holds while the threat stands (the allies it brought make the
+// fight won, and must not walk off for that).
+struct State {
+    bool calling = false;
+    int latest = 0;
+    vec2 meet{-1, -1}; // the nearest ally called, as the read placed it
+} prism_state;
+int posted_round = -1;
+
+void post(int round, vec2 at, int deadline) {
+    comms::muster(round, at, deadline);
+    posted_round = round;
+}
+
+void prism_muster(World& world, Safety& safety) {
+    auto& s = prism_state;
+    if (world.me().facts().passive != Passive::gem_focus || !world.me().alive) return void(s = {});
+    const vec2 here = my_position();
+    if (!in_bounds(here) || test(world.map().ally_spawn, here)) return void(s = {});
+    if (!enemy_seen(world) && !safety.unseen_may_hit_within(here, horizon)) return void(s = {});
+    // One fight at most; short of it a call stands for those beside Prism.
+    if (!fuel_ok(end_reserve + safety.fight_cost_estimate())) {
+        note_shortcut("muster-fuel");
+        if (s.calling) post(world.round, here, 0);
+        return;
+    }
+    const Read r = read_fight(world, safety, here);
+    // Not even a counted enemy left: nothing for a call to hold.
+    if (!r.threat || r.enemies == 0) s = {};
+    // A lost stand is Prism's own retreat's (want_home): leaving on this read lost more than it saved
+    // (v1 42.3%, v2 47.5% on train).
+    else if (r.outcome == MusterRead::call) s.calling = true, s.latest = r.latest, s.meet = r.meet;
+    // The deadline: an ally whose walk is no longer than the farthest counted in comes.
+    if (s.calling) post(world.round, here, s.latest);
+    debug_block({
+        std::printf("MREAD %d %u %c %d %d %d %d %d\n", world.round, my_handle(), "-EHCL"[static_cast<int>(r.outcome)], r.strike, r.near,
+                    r.called, r.enemies, static_cast<int>(s.calling));
+    });
+}
+
+void keep_muster(const World& world) {
+    const auto& s = prism_state;
+    if (!s.calling || posted_round == world.round || world.me().facts().passive != Passive::gem_focus || !world.me().alive) return;
+    if (const vec2 here = my_position(); in_bounds(here)) post(world.round, here, s.latest);
+}
+
+// An ally's answer to the call this turn: where Prism is and the longest walk there worth making.
+struct Answer {
+    int round = -1;
+    std::uint32_t handle = 0;
+    bool on = false;
+    vec2 at{-1, -1};
+    int turns = 0;
+};
+Answer answer;
+
+const Answer& read_answer(const World& world, Safety& safety) {
+    const auto me = static_cast<std::uint32_t>(world.me().handle);
+    if (answer.round == world.round && answer.handle == me) return answer;
+    answer = {world.round, me};
+    if (!world.me().alive || world.me().facts().passive == Passive::gem_focus) return answer;
+    const auto* prism = support_pair(world)[0];
+    if (!prism || prism->facts().passive != Passive::gem_focus) return answer;
+    vec2 at;
+    int turns = 0;
+    bool floor = false;
+    if (!comms::muster_call(world, *prism, at, turns, floor)) return answer;
+    answer.on = true, answer.at = at, answer.turns = turns;
+    debug_block({ std::printf("MHEAR %d %u %d %d\n", world.round, my_handle(), dist(my_position(), at), turns); });
+    return answer;
+}
+
+const bitboard* muster_hold(const World& world, Safety& safety) {
+    const auto& a = read_answer(world, safety);
+    if (!a.on || dist(my_position(), a.at) > safety_params::fight_ally_radius) return nullptr;
+    static bitboard out{cambc::uninitialized};
+    static bitboard square{cambc::uninitialized};
+    clear_board(square);
+    draw_square(square, a.at, static_cast<float>(safety_params::fight_ally_radius));
+    not_into(square, out);
+    return &out;
+}
+
+// Calling, Prism walks to meet the nearest ally it called rather than work on alone: the walks from both
+// ends halve the time to the majority.
+bool prism_meet(const World& world, Pathing& pathing) {
+    const auto& s = prism_state;
+    const int r = safety_params::fight_ally_radius;
+    if (!s.calling || !in_bounds(s.meet) || dist(my_position(), s.meet) <= r) return false;
+    // A called ally now within its radius has come: no walk.
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible && dist(a.pos, my_position()) <= r) return false;
+    static bitboard goals{cambc::uninitialized};
+    clear_board(goals);
+    draw_square(goals, s.meet, static_cast<float>(r));
+    goals &= world.map().standable;
+    if (!pathing.step_towards(goals)) return false;
+    decision = Branch::muster;
+    debug_block({ std::printf("MMEET %d %u %d %d\n", world.round, my_handle(), s.meet.x, s.meet.y); });
+    return true;
+}
+
+bool muster_walk(const World& world, Pathing& pathing, Safety& safety) {
+    if (!my_can_move() || stunned_turn) return false;
+    if (world.me().facts().passive == Passive::gem_focus) return prism_meet(world, pathing);
+    const auto& a = read_answer(world, safety);
+    if (!a.on) return false;
+    const vec2 here = my_position();
+    const int r = safety_params::fight_ally_radius;
+    if (dist(here, a.at) <= r || a.turns <= 0) return false;
+    static bitboard goals{cambc::uninitialized};
+    clear_board(goals);
+    draw_square(goals, a.at, static_cast<float>(r));
+    goals &= world.map().standable;
+    // Only an ally whose walk to Prism's side is within the deadline comes: the read counted it in.
+    if (!pathing.step_towards(goals, nullptr, a.turns)) return false;
+    decision = Branch::muster;
+    debug_block({ std::printf("MJOIN %d %u %d %d %d\n", world.round, my_handle(), a.at.x, a.at.y, a.turns); });
+    return true;
+}
+
+} // namespace
+
+} // namespace aph
