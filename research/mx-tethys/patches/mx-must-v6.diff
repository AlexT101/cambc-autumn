+Trade Safety::muster_trade(std::uint32_t allies, const std::array<std::int8_t, 16>& arrive, std::uint32_t enemies,
+                           const std::array<std::int8_t, 16>& walk) {
+    world_.throw_if_stale();
+    build();
+    enemies &= threat_mask_;
+    if (!enemies) return {};
+    Side us, them;
+    fill(us, world_, world_.allies, allies, made_);
+    fill(them, world_, world_.enemies, enemies, made_);
+    int k = 0;
+    for (auto left = allies; left && k < us.count; left &= left - 1, ++k)
+        us.fighters[k].arrives_at = std::max<int>(us.fighters[k].arrives_at, arrive[static_cast<std::size_t>(std::countr_zero(left))]);
+    k = 0;
+    for (auto left = enemies; left && k < them.count; left &= left - 1, ++k)
+        them.fighters[k].arrives_at = std::max<int>(them.fighters[k].arrives_at, walk[static_cast<std::size_t>(std::countr_zero(left))]);
+    const auto before = fuel();
+    const auto t = trade(us, them, true, true, true);
+    if (const auto after = fuel(); after < before) costliest_fight_ = std::max(costliest_fight_, before - after);
+    return t;
+}
