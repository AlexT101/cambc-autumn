+// The team's Monolith operation ends on a real change, never on one body's pick: the Monolith no
+// longer alive (its capture is then the holders'), an enemy near it whose force beats ours there
+// (mono_contested and the fight read: our clear would be theirs to take; the record then holds it
+// called off), a death in the crew under this operation (the team re-decides: farm may declare it
+// again on what is left to do), or too few rounds left to clear and capture it. A call-off lifts
+// when one of us near it has seen no enemy near it lately, when it is no longer alive, or after
+// crew_ban_rounds (a crew's ban on a group it was driven from).
+void mono_op_check(const World& world, Safety& safety, Memory& memory) {
+    const int b = comms::mono_blocked();
+    if (b < 0) memory.mono_block_since = -1;
+    else if (memory.mono_block_since < 0) memory.mono_block_since = world.round;
+    if (b >= 0 && world.me().alive) {
+        const auto& G = world.map().groups[b];
+        // Clear: no enemy seen near it lately (crew_seen_rounds), as one of us near it reads.
+        bool clear = world.camps[b].state != CampState::alive || world.round - memory.mono_block_since >= params::crew_ban_rounds;
+        if (!clear) {
+            clear = dist(my_position(), G.centre) <= vision_radius;
+            for (const auto& e : world.enemies)
+                clear = clear && !(e.alive && e.pos_round >= world.round - params::crew_seen_rounds && in_bounds(e.pos) && dist(e.pos, G.centre) <= params::crew_enemy_radius);
+        }
+        if (clear) {
+            comms::post_mono_op(-1);
+            memory.mono_block_since = -1;
+            debug_block({ std::printf("MONO UNBLOCK %d %u g%d\n", world.round, my_handle(), b); });
+        }
+    }
+    const int g = comms::mono_op();
+    const int epoch = comms::mono_epoch();
+    float power = 0;
+    bool died = false;
+    // A death among the members claiming it at our previous turn, under the same declaration; one
+    // leaving the crew (a Prism now keeping its bag) is no death. Read by the living only.
+    const bool same = memory.mono_op == g && memory.mono_epoch == epoch && world.me().alive;
+    for (const auto& a : world.allies) {
+        if (g >= 0 && mono_crew(world, a, g)) power += camp_output(a);
+        died |= same && (memory.mono_alive >> (a.index & 31) & 1) && !a.alive;
+    }
+    if (memory.mono_op != g || memory.mono_epoch != epoch) memory.mono_op_since = world.round;
+    memory.mono_op = g, memory.mono_epoch = epoch;
+    memory.mono_alive = g >= 0 ? mono_committed(world, g, memory.claim) : 0;
+    if (g < 0 || !world.me().alive) return;
+    const auto& c = world.camps[g];
+    const auto load = siege_load(world, g);
+    const auto& G = world.map().groups[g];
+    // Its state as seen since the operation began: an older belief out of sight is no change.
+    const bool gone = c.state != CampState::alive && c.state_round >= memory.mono_op_since;
+    // An enemy near it ends it only where the fight read there loses, read by one of us near it
+    // (short of fuel for the read, not read).
+    const bool contested = !gone && c.state == CampState::alive && mono_contested(world, g) && dist(my_position(), G.centre) <= params::crew_enemy_radius
