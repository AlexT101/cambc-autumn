+// A member of the team's Monolith operation: living, no gold farmer (farms_gold), and no Prism
+// keeping its bag, whose own farm compounds (prism_premium) and which comes only to hold the
+// capture alone (left_for_prism).
+bool mono_crew(const World& world, const ChampionBelief& a, int g) {
+    if (!a.alive || farms_gold(world, a)) return false;
+    return a.facts().passive != Passive::gem_focus || !keeps_bag(world, a, world.map().groups[g].gems);
+}
+
+std::uint32_t mono_committed(const World& world, int g, int my_claim) {
+    std::uint32_t kept = 0;
+    for (const auto& a : world.allies)
+        if (mono_crew(world, a, g) && (a.is_self ? my_claim : comms::claim_of(world, a.index)) == g) kept |= 1u << (a.index & 31);
+    return kept;
+}
+
+MonoPlan plan_mono(const World& world, const CrewAllies& allies, int g) {
+    MonoPlan plan;
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    float health = 0;
+    for (std::size_t i = 0; i < G.members.size(); ++i)
+        health += c.state == CampState::respawning ? G.members[i].max_health : std::max(0.0f, c.health[i]);
+    if (!(health > 0)) return plan;
+    std::array<std::pair<int, float>, 16> work{}; // arrival, output
+    std::array<const CrewAllies::Ally*, 16> pool;
+    int n = 0, stuns = 0;
+    float survivable = home_survivable(world.me());
+    for (int i = 0; i < allies.n; ++i) {
+        const auto& x = allies.at[static_cast<std::size_t>(i)];
+        const auto& a = *x.a;
+        if (!mono_crew(world, a, g)) continue;
+        // Out of sight and never seen on the map, its walk is the one from our spawn.
+        const vec2 p = a.is_self ? allies.here : a.pos;
+        const int arrive = a.is_self || in_bounds(p) ? crew_arrival(world, a, g, p)
+                                                     : std::max(0, world.map().ally_steps(g) - a.facts().attack_range());
+        work[static_cast<std::size_t>(n)] = {arrive, crew_output(x)};
+        if (!x.has_pool) read_pool(allies, x);
+        pool[static_cast<std::size_t>(n++)] = &x;
+        plan.output += crew_output(x);
+        survivable = std::min(survivable, home_survivable(a));
+        for (const auto& ab : a.facts().abilities) stuns += ab.stuns;
+    }
+    plan.crew = n;
+    if (n == 0) return plan;
+    // Each works from its arrival: the kill comes at the t where the outputs since then sum to the health.
+    std::sort(work.begin(), work.begin() + n);
+    float rate = 0, done = 0, t = static_cast<float>(work[0].first);
+    for (int k = 0; k < n; ++k) {
+        rate += work[static_cast<std::size_t>(k)].second;
+        const float next = k + 1 < n ? static_cast<float>(work[static_cast<std::size_t>(k + 1)].first) : std::numeric_limits<float>::infinity();
+        if (done + rate * (next - t) >= health) {
+            t += (health - done) / rate;
+            break;
+        }
+        done += rate * (next - t), t = next;
+    }
+    plan.rounds = t;
+    // The hits at the whole crew's output, over the rounds it is awake from the first arrival; a stun
+    // skips an attack, and each stunning slot is back every ability_cooldown rounds.
+    float clear = 0;
+    const float damage = min_camp_damage(world, g, plan.output, &clear, 0, -1, survivable);
+    const float awake = std::max(clear, t - static_cast<float>(work[0].first));
+    const float skipped = std::min(1.0f, static_cast<float>(stuns) / static_cast<float>(ability_cooldown));
+    CrewPlan p;
+    p.damage = plan.damage = damage * (clear > 0 ? awake / clear : 1.0f) * (1.0f - skipped);
+    std::sort(pool.begin(), pool.begin() + n, [](const CrewAllies::Ally* x, const CrewAllies::Ally* y) { return x->a->index < y->a->index; });
+    share_damage(pool.data(), n, p);
+    plan.trips = p.trips;
+    return plan;
+}
+
 } // namespace
 
 } // namespace aph
