+// run_pass's walk-only and dash-kept sets, by every hit count the plan's turns 2..horizon can hold.
+int Plan::least_hits(const std::array<Rows, horizon + 1>& hits, const Rows& goal) const {
+    constexpr int J = horizon; // at most horizon - 1 hits on turns 2..horizon: s[J - 1] is every tile with a way
+    std::array<Rows, J> s0, s1, t0, t1;
+    s0.fill(goal), s1.fill(goal);
+    for (int k = horizon; k >= 2; --k) {
+        const Rows hit = hits[k], clear = ~hit;
+        for (int j = 0; j < J; ++j) {
+            t0[j] = s0[j] & clear;
+            if (j > 0) t0[j] |= s0[j - 1] & hit;
+            if (dash_) {
+                t1[j] = s1[j] & clear;
+                if (j > 0) t1[j] |= s1[j - 1] & hit;
+            }
+        }
+        for (int j = 0; j < J; ++j) {
+            const Rows g0 = grow(t0[j]);
+            if (dash_) {
+                Rows k1 = t1[j];
+                if (k >= dash_turn_) k1 |= dash_landings(g0, path_, walk_);
