+// economy/control.cc: the control map. c, our share of the force that can reach a group while
+// we would work it, prices it: the enemy contests it at its share 1 - c and wins a contest at
+// Lanchester's L = (1-c)^2 / (c^2 + (1-c)^2), so we keep it at 1 - (1-c) L; kept, it is ours and,
+// at the same 1 - c, denied to them, each gem of theirs counting as one of ours in the race.
+// A body whose death costs `stake` (>= 1) times an empty one's keeps it only through that many
+// such risks: (1 - (1-c) L)^stake.
+namespace control {
+// Diagnosis: the static side weights (home_ground's times the middle band's) in place of the map's.
+inline constexpr bool static_weights = false;
+// Diagnosis: home_ground's static weight kept beside the map's; the death stake priced.
+inline constexpr bool keep_home = false, staked = false;
+// Diagnosis: a fixed horizon, half the spawns' distance, and ourselves at our own tile.
+inline constexpr bool sharp = true;
+// The static weights scaled by our keep chance against the usual one (the spawns'), at most mid_exposure.
+inline constexpr bool relative = true;
+// Shares smoothed by one body of each team.
+inline constexpr bool smoothed = true;
+constexpr float keep_of(float c) {
+    const float o = 1.0f - c, lose = o * o / (c * c + o * o);
+    return 1.0f - o * lose;
+}
+constexpr float weight_of(float c) { return keep_of(c) * (2.0f - c); }
+// No weight_of is higher (nor, as stake >= 1, any staked weight): its grid's most, plus its slope (below 2.6) times the grid's half step.
+inline constexpr float most = [] {
+    float best = 0;
+    for (int i = 0; i <= 10000; ++i) best = std::max(best, weight_of(static_cast<float>(i) / 10000.0f));
+    return static_weights || relative ? std::max(best, params::mid_exposure) + 2e-4f : best + 2e-4f;
+}();
+// The weights by group (padded to 4 lanes, the padding 1); group g's block is made this round.
+const float* weights(const World& world, int g);
+float weight(const World& world, int g);
+float share(const World& world, int g);
+} // namespace control
 float spell_output(const ChampionBelief& c);
 float basic_output(const ChampionBelief& c);
