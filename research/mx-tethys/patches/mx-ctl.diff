+// The control map: how strongly each team can bring force to a camp group while we would work it,
+// and the farm weight that follows (farm.cc). Per group, lazily, once per round and tile.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+namespace control {
+
+namespace {
+
+// A body's fighting strength: Lanchester's, the square root of its output times its effective health
+// (a team's strength is the square of the sum). Out of sight, at its full health.
+float mass(const ChampionBelief& c) {
+    const float health = c.visible || c.is_self ? effective_hp(c) : c.max_health / std::max(c.taken, 1e-3f);
+    return std::sqrt(std::max(0.0f, output(c)) * std::max(0.0f, health));
+}
+
+// A body at `p`, within `slack` tiles of it; for an unseen enemy, last seen `age` rounds ago.
+struct Source {
+    vec2 p;
+    float mass;
+    int slack, age;
+};
+
+struct Map {
+    int round = -1;
+    vec2 here{-1, -1};
+    std::uint32_t camps = 0, gems = 0, observations = 0; // World::camps_version, our bag and World::observations at the build
+    float self_mass = 0, output = 1, prior = 0, stake = 1, mean_mass = 0;
+    std::vector<Source> ours, theirs;
+    std::vector<vec2> mirrored; // the mirror of each of our bodies' tiles: where an enemy we know nothing of is
+    std::vector<float> share, weight; // by group, padded to 4 lanes
+    std::vector<std::uint8_t> done;   // by block of 4
+};
+Map map_;
+
+// The reach kernel: 1 at the site, 0 at `horizon` tiles.
+inline float reach(int d, float horizon) { return std::max(0.0f, 1.0f - static_cast<float>(d) / horizon); }
+
+void build(const World& world) {
+    auto& m = map_;
+    m.round = world.round, m.here = my_position(), m.camps = world.camps_version, m.gems = my_gems(), m.observations = world.observations;
+    m.ours.clear(), m.theirs.clear(), m.mirrored.clear();
+    m.prior = 0;
+    const auto& smap = world.map();
+    float output = 0;
+    int n = 0;
+    m.mirrored.push_back(smap.mirror(m.here));
+    for (const auto& a : world.allies) {
+        if (!a.alive) continue;
+        output += camp_output(a), ++n;
+        if (a.is_self) {
+            m.self_mass = mass(a);
+            continue;
+        }
+        vec2 at{-1, -1};
+        int told = -1, slack = 0, age = 0;
+        if (a.visible) {
+            at = a.pos;
+        } else {
+            // Out of sight: the fresher of its post (to within 2) and our last sighting, aged as an enemy's
+            // sighting is; else its claim.
+            vec2 posted;
+            const bool fresh_post = comms::told_ally(a.index, posted, told) && in_bounds(posted) && told > a.pos_round;
+            if (fresh_post) at = posted, age = std::max(0, world.round - told), slack = 2 + age;
+            else if (a.pos_round >= 0 && in_bounds(a.pos)) at = a.pos, age = std::max(0, world.round - a.pos_round), slack = age;
+            else if (const int g = comms::claim_of(world, a.index); g >= 0 && g < static_cast<int>(smap.groups.size())) at = smap.groups[g].centre;
+            else continue;
+        }
+        if (!in_bounds(at)) continue;
+        m.ours.push_back({at, mass(a), slack, age});
+        m.mirrored.push_back(smap.mirror(at));
+    }
+    m.output = n > 0 ? std::max(1.0f, output / static_cast<float>(n)) : 1.0f;
+    float total = m.self_mass;
+    for (const auto& o : m.ours) total += o.mass;
+    m.mean_mass = std::max(1.0f, total / static_cast<float>(1 + m.ours.size()));
+    for (const auto& e : world.enemies) {
+        if (!e.alive) continue; // dead until its respawn
+        const float w = mass(e);
+        if (e.visible) m.theirs.push_back({e.pos, w, 0, 0});
+        else if (e.pos_round >= 0 && in_bounds(e.pos)) m.theirs.push_back({e.pos, w, 0, std::max(0, world.round - e.pos_round)});
+        else m.prior += w;
+    }
+    // What our death costs, against an empty body's (respawn_time rounds of our farm): our bag (and a
+    // partner's) changes hands, ours lost at its Focus premium (a keeping Prism's) and theirs gained.
+    const int bag = bag_at_stake(world);
+    if (bag > 0) {
+        const float idle = static_cast<float>(cambc::constants::respawn_time) * team_farm(world).per_output * camp_output(world.me());
+        const float premium = prism_premium(world, world.me(), 1);
+        m.stake = idle > 0 ? 1.0f + static_cast<float>(bag) * (2.0f + premium) / idle : 1.0f;
+    } else {
+        m.stake = 1;
+    }
+    const std::size_t padded = (smap.groups.size() + 3) & ~std::size_t{3};
+    m.share.assign(padded, 0.5f), m.weight.assign(padded, 1.0f);
+    m.done.assign(padded / 4, 0);
+}
+
+void compute(const World& world, int g) {
+    auto& m = map_;
+    const auto& smap = world.map();
+    const auto& group = smap.groups[g];
+    const vec2 site = group.centre;
+    // The window an enemy can contest it in: our walk there, its clear at the team's mean output and the capture.
+    [[maybe_unused]] const float clear = g < static_cast<int>(world.clear_health.size()) ? world.clear_health[g] / m.output : 0.0f;
+    float horizon = std::max(1.0f, static_cast<float>(dist(m.here, site) + capture_rounds(world)) + clear);
+    // We are at the site if we take it.
+    float ours = m.self_mass;
+    if constexpr (sharp) {
+        // Half the way between the spawns, the line between the two sides: a body on its spawn reaches the middle.
+        horizon = std::max(static_cast<float>(capture_rounds(world)), 0.5f * static_cast<float>(dist(smap.ally_spawn_centre, smap.enemy_spawn_centre)));
+        ours = m.self_mass * reach(dist(m.here, site), horizon);
+    }
+    // An ally seen `age` rounds ago counts for as much of the window as that sighting still covers.
+    for (const auto& s : m.ours)
+        ours += s.mass * reach(std::max(0, dist(s.p, site) - s.slack), horizon) * (s.age > 0 ? horizon / (horizon + static_cast<float>(s.age)) : 1.0f);
+    float theirs = 0, prior = m.prior;
+    for (const auto& s : m.theirs) {
+        if (s.age == 0) {
+            theirs += s.mass * reach(dist(s.p, site), horizon);
+            continue;
+        }
+        // Seen `age` rounds ago: as close as it may have walked since, weighed by how much of the
+        // window that sighting still covers; the rest is where we know nothing of it.
+        const float kept = horizon / (horizon + static_cast<float>(s.age));
+        theirs += kept * s.mass * reach(std::max(0, dist(s.p, site) - s.age), horizon);
+        prior += (1.0f - kept) * s.mass;
+    }
+    if (prior > 0) {
+        // An enemy we know nothing of does as we do: the mirror of our bodies.
+        float near = 0;
+        for (const vec2 p : m.mirrored) near += reach(dist(p, site), horizon);
+        theirs += prior * near / static_cast<float>(m.mirrored.size());
+    }
+    // One body of each team unaccounted for, at the mean body's strength, keeps a lone sighting from reading as
+    // the whole ground.
+    const float c = smoothed ? (ours + m.mean_mass) / (ours + theirs + 2 * m.mean_mass) : ours + theirs > 0 ? ours / (ours + theirs) : 0.5f;
+    if constexpr (static_weights || relative) {
+        // The static side weight control replaced: home_ground's, times the middle band's.
+        const float side = home_side(smap, g, world.round <= 2);
+        const float home = std::pow(std::min(1.0f, 2.0f * side), params::home_power);
+        const auto ease = [](float x) {
+            x = std::clamp(x, 0.0f, 1.0f);
+            return x * x * (3.0f - 2.0f * x);
+        };
+        constexpr float e = params::mid_edge;
+        const float in = std::min(ease((side - params::mid_low_share + e) / (2 * e)), ease((params::own_ground_share + e - side) / (2 * e)));
+        m.share[g] = c;
+        m.weight[g] = home * (group.has_monolith ? home : 1.0f) * (1.0f + (params::mid_exposure - 1.0f) * in);
+        if constexpr (relative) {
+            // The static weights hold at the control a group has with each team at its spawn; the map
+            // prices the departure from it, our chance to keep the group against that one's.
+            const float ka = reach(dist(smap.ally_spawn_centre, site), horizon), ke = reach(dist(smap.enemy_spawn_centre, site), horizon);
+            const float usual = keep_of(smoothed ? (1 + ka) / (2 + ka + ke) : ka + ke > 0 ? ka / (ka + ke) : 0.5f), now = keep_of(c);
+            // A body whose death costs `stake` times an empty one's takes that departure `stake` times over.
+            const float ratio = now / std::max(usual, 1e-6f);
+            m.weight[g] = std::min(params::mid_exposure, m.weight[g] * (staked && m.stake > 1 ? std::pow(ratio, m.stake) : ratio));
+        }
+        return;
+    }
+    m.share[g] = c;
+    const float keep = keep_of(c);
+    m.weight[g] = (staked && m.stake > 1 ? std::pow(keep, m.stake) : keep) * (2.0f - c);
+    if constexpr (keep_home) m.weight[g] *= std::pow(std::min(1.0f, 2.0f * home_side(smap, g, world.round <= 2)), params::home_power);
+}
+
+} // namespace
+
+const float* weights(const World& world, int g) {
+    auto& m = map_;
+    const vec2 here = my_position();
+    if (m.round != world.round || m.here != here || m.camps != world.camps_version || m.gems != my_gems()
+        || m.observations != world.observations)
+        build(world);
+    const int lo = g & ~3, n = static_cast<int>(world.map().groups.size());
+    if (lo >= 0 && lo < n && !m.done[static_cast<std::size_t>(lo >> 2)]) {
+        m.done[static_cast<std::size_t>(lo >> 2)] = 1;
+        for (int h = lo; h < std::min(lo + 4, n); ++h) compute(world, h);
+    }
+    return m.weight.data();
+}
+
+float weight(const World& world, int g) { return weights(world, g)[g]; }
+
+float share(const World& world, int g) {
+    weights(world, g);
+    return map_.share[g];
+}
+
+} // namespace control
+
+} // namespace
+
+} // namespace aph
