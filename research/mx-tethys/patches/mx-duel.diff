+Trade Safety::duel(std::uint32_t allies, int enemy, bool they_first) {
+    struct Kept {
+        int round = -1;
+        std::uint32_t generation = 0, allies = 0;
+        int enemy = -1;
+        bool they_first = false;
+        Trade trade;
+    };
+    static std::array<Kept, 8> kept;
+    static int next = 0;
+    for (const auto& k : kept)
+        if (k.round == world_.round && k.generation == generation_ && k.allies == allies && k.enemy == enemy && k.they_first == they_first) return k.trade;
+    world_.throw_if_stale();
+    Side us, them;
+    fill(us, world_, world_.allies, allies, made_);
+    fill(them, world_, world_.enemies, 1u << enemy, made_);
+    const auto ready = [](Side& side) {
+        for (int i = 0; i < side.count; ++i) {
+            auto& f = side.fighters[i];
+            for (auto& r : f.ready_at)
+                if (r != never) r = 0;
+            f.next_cast = next_cast(f);
+            f.arrives_at = 0;
+        }
+        side.stunned = 0;
+    };
+    ready(us), ready(them);
+    // Unseen, it may have been home since: it heals there (rules: rounds.turn_end).
+    if (const auto& e = world_.enemies[static_cast<std::size_t>(enemy)]; !e.visible && them.count > 0) {
+        auto& f = them.fighters[0];
+        f.health = f.max_health;
+        them.alive = 1;
+    }
+    auto& slot = kept[static_cast<std::size_t>(next++ % static_cast<int>(kept.size()))];
+    slot = {world_.round, generation_, allies, enemy, they_first, trade(us, them, they_first, true)};
+    return slot.trade;
+}
