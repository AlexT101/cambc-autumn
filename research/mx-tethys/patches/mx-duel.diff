+DuelTerm duel_term(const World& world) {
+    DuelTerm t;
+    const auto& me = world.me();
+    const ChampionBelief* p = nullptr;
+    for (const auto& e : world.enemies)
+        if (e.facts().passive == Passive::gem_focus) p = &e;
+    if (!p || !p->alive || !in_bounds(p->pos) || p->pos_round < 0) return t;
+    t.on = true;
+    t.enemy = p->index;
+    t.at = p->pos;
+    t.age = p->visible ? 0 : std::max(0, world.round - p->pos_round);
+    t.act = enemy_reach::act_range(p->facts());
+    t.width = world.map().width, t.height = world.map().height;
+    t.self = 1u << me.index;
+    const float life = params::life_value / params::gem_value;
+    const auto* partner = linked_partner(world, me);
+    const float bag = static_cast<float>(pair_gems(world, me));
+    const bool prism = me.facts().passive == Passive::gem_focus;
+    t.loss = life * (partner && partner->alive ? 2.0f : 1.0f) + bag * (prism && bag > 0 ? 1.0f + prism_premium(world, me, 1) : 1.0f);
+    if (prism) t.gain = life + static_cast<float>(p->gems) * (1.0f + (p->gems > 0 ? prism_premium(world, me, p->gems) : 0.0f));
+    return t;
+}
