+// The enemy Prism at a stand of ours. The duel with it decides by Focus (Safety::duel, the allies claiming the
+// stand beside us): one we lose even striking first costs the chance it comes during our stay times our
+// fall (the life, abilities' life_value in gems, of each body that falls, and the bag at a keeping Prism's
+// premium); one our Prism wins even striking second gains that chance times its fall (its life and the bag
+// the killer takes, at our premium). Between, who strikes first decides, and the static weights stand.
+// The chance: its tile at each round uniform over the square it can have walked to since last seen, within
+// the map (Safety's weight for an unseen enemy, carried forward), at the stay's likeliest round.
+struct DuelTerm {
+    bool on = false;
+    int enemy = -1;
+    vec2 at{-1, -1};
+    int age = 0, act = 0, width = 0, height = 0;
+    float loss = 0, gain = 0; // gems
+    std::uint32_t self = 0;
+    std::array<std::pair<std::uint32_t, float>, 4> kept{};
+    int n_kept = 0;
+
+    // The stake beside the allies `mask` (ours included): -loss, gain or 0.
+    float stake(Safety& safety, std::uint32_t mask) {
+        for (int i = 0; i < n_kept; ++i)
+            if (kept[i].first == mask) return kept[i].second;
+        float s = 0;
+        if (params::duel::avoid && safety.duel(mask, enemy, false).self_falls) s = -loss;
+        else if (params::duel::seek && gain > 0) {
+            const Trade t = safety.duel(mask, enemy, true);
+            if (!t.self_falls && t.turns_to_kill_them > 0) s = gain;
+        }
+        if (n_kept < static_cast<int>(kept.size())) kept[n_kept++] = {mask, s};
+        return s;
+    }
+    // Its square's share within act of `stand` once it has walked r rounds.
+    float share(vec2 stand, int r) const {
+        const auto span = [](int c, int s, int r, int act, int n) {
+            const int lo = std::max(c - r, 0), hi = std::min(c + r, n - 1);
+            return std::pair{hi - lo + 1, std::max(0, std::min(hi, s + act) - std::max(lo, s - act) + 1)};
+        };
+        const auto [wx, ox] = span(at.x, stand.x, r, act, width);
+        const auto [wy, oy] = span(at.y, stand.y, r, act, height);
+        return static_cast<float>(ox * oy) / static_cast<float>(std::max(1, wx * wy));
+    }
+    float chance(vec2 stand, int arrive, int leave) const {
+        const int d = dist(stand, at), lo = age + arrive, hi = age + std::max(arrive, leave);
+        if (d - act > hi) return 0.0f;
+        float most = 0;
+        for (const int r : {lo, hi, std::clamp(d - act, lo, hi), std::clamp(d, lo, hi), std::clamp(d + act, lo, hi)}) most = std::max(most, share(stand, r));
+        return most;
+    }
+};
