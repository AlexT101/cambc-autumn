+// Every movement set contains the origin; one strike from there proves a hit without
+// building the movement geometry or pricing the other ways.
+bool Reach::hits(vec2 p) const {
+    const auto& memo = memo_[static_cast<std::size_t>((p.x & 7) | (p.y & 7) << 3)];
+    if (memo.stamp == stamp_ && memo.p == p) return memo.blow.hits;
+    const int dx = p.x - origin_.x, dy = p.y - origin_.y;
+    const int d = std::max(std::abs(dx), std::abs(dy));
+    if (const auto& t = terrain(world_->map()); t.inside(p)) {
+        if (d <= ways_->blind_range && ways_->blind_range > 0) return true;
+        if (d <= ways_->direct_range
+            && ((d <= 1 && !t.bush(p)) || (sight(*world_, p, d > 1) & win_bit(win_r - dx, win_r - dy)))) return true;
+    }
+    return at(p).hits;
+}
