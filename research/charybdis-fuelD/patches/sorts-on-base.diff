 namespace {
 
+template <class Iter, class Before>
+void stable_small_sort(Iter begin, Iter end, Before before) {
+    for (auto at = begin; at != end; ++at) {
+        const auto value = *at;
+        auto to = at;
+        while (to != begin && before(value, *(to - 1))) *to = *(to - 1), --to;
+        *to = value;
+    }
+}
