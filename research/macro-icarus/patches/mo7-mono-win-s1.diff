+int enemy_window(const World& world) {
+    bool prism = false;
+    int prism_left = 0, first = 0, second = 0; // the two longest waits of dead bodies
+    for (const auto& e : world.enemies) {
+        const int left = e.alive ? 0 : std::max(0, e.respawn_earliest - world.round);
+        if (e.facts().passive == Passive::gem_focus) prism = true, prism_left = std::max(prism_left, left);
+        if (left > first) second = first, first = left;
+        else if (left > second) second = left;
+    }
+    return prism ? std::max(prism_left, second) : unreachable;
+}
+
+bool mono_engaged(const World& world, int g) {
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    if (c.state != CampState::alive) return false;
+    for (std::size_t i = 0; i < G.members.size(); ++i)
+        if (G.members[i].strength > 0 && c.health[i] < G.members[i].max_health) return true;
+    if (c.awake != Awake::awake) return false;
+    if (crew_in_reach(world, g, my_position(), world.me().facts().attack_range())) return true;
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible && crew_in_reach(world, g, a.pos, a.facts().attack_range())) return true;
+    return false;
+}
+
+bool mono_may_start(const World& world, int g, float rounds) {
+    return !farm_monolith(world, g) || mono_engaged(world, g)
+           || static_cast<float>(enemy_window(world)) >= rounds + static_cast<float>(capture_rounds(world));
+}
+
+bool mono_exposed(const World& world, int g, bitboard& out) {
+    if (!farm_monolith(world, g) || world.camps[g].state != CampState::alive) return false;
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    const float life = my_health_and_shield(world);
+    static bitboard square{cambc::uninitialized};
+    for (std::size_t i = 0; i < G.members.size(); ++i) {
+        const auto& m = G.members[i];
+        if (m.strength <= 0 || c.health[i] <= 0) continue;
+        int cover = unreachable;
+        for (const auto& a : world.allies)
+            if (!a.is_self && a.alive && a.visible && a.channel != Channel::teleport && !real_recall(a) && test(G.threat(), a.pos)) // mono_trapped's cover
+                cover = std::min(cover, dist(a.pos, m.pos));
+        // From d away, as mono_trapped counts, min(cover, reach) + 1 - d phases of its fire before a step a phase
+        // takes us behind the nearest ally or out of its reach: lethal for d up to min(cover, reach) + 1 - life / fire.
+        const float fire = m.strength * camp_hit_factor();
+        const int behind = std::min(cover, m.reach);
+        const float lethal = static_cast<float>(behind + 1) - life / fire;
+        const float r = std::min(static_cast<float>(behind), std::floor(lethal));
+        if (r < 0) continue;
+        clear_board(square);
+        draw_square(square, m.pos, r);
+        out |= square;
+    }
+    return true;
+}
+
 } // namespace
 
 } // namespace aph
