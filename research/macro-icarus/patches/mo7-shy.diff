+const bitboard* stun_shy_tiles(const World& world) {
+    const auto& self = world.me();
+    if (self.facts().passive != Passive::linked_pair && !self.facts().heals()) return nullptr;
+    static bitboard shy{cambc::uninitialized};
+    bool any = false;
+    const float life = my_health_and_shield(world);
+    // Our turn's most damage, a ready damage cast and a basic: a Prism it kills is struck, not shunned.
+    float burst = self.strength;
+    for (int s = 0; s < 2; ++s)
+        if (const auto& ab = self.facts().abilities[s]; ab.kind == AbilityKind::damage && my_can_cast() && self.ability_ready(s, world.round))
+            burst = std::max(burst, self.strength + ab.multiplier * self.focus);
+    burst *= champion_dealt_factor();
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus) continue;
+        // Visible, or seen at its last tile within its stun's cooldown.
+        if (!e.visible && !(e.pos_source == Source::seen && e.pos_round >= world.round - ability_cooldown && in_bounds(e.pos))) continue;
+        if (e.visible && e.health <= burst) continue;
+        int stun = -1;
+        for (int s = 0; s < 2; ++s)
+            if (e.facts().abilities[s].stuns && e.facts().abilities[s].target == Targeting::unit) stun = s;
+        if (stun < 0 || e.ready_round[stun] > next_turn_round(world, e)) continue;
+        // Its stun takes our next turn, so its turn after lands too: stun and basic, then ground hit and basic.
+        float hit = 0;
+        for (const auto& ab : e.facts().abilities)
+            if (ab.kind == AbilityKind::damage) hit += ab.multiplier * e.focus;
+        hit = (hit + 2 * e.strength) * self.taken;
+        if (hit < life) continue;
+        if (!any) clear_board(shy), any = true;
+        // Within its stun's reach where it acts before our next turn, a step more where it acts twice (it may walk first).
+        draw_square(shy, e.pos, static_cast<float>(ability_range + (turns_before_ours(world, e) >= 2 ? 1 : 0)));
+    }
+    return any ? &shy : nullptr;
+}
