+struct ChannelRecord {
+    int end_round = -1;
+    bool channelling = false; // at the turn end of end_round
+    float turns = 0, cancels = 0;
+    std::vector<int> enemy_scores; // by round, as read at our turns
+    int scores_round = -1;
+} channels;
+
+void note_tribute_start(const World& world) {
+    auto& c = channels;
+    if (c.enemy_scores.empty()) c.enemy_scores.reserve(cambc::constants::max_rounds + 1);
+    if (static_cast<int>(c.enemy_scores.size()) <= world.round) c.enemy_scores.resize(static_cast<std::size_t>(world.round) + 1);
+    for (int r = std::max(world.first_round, c.scores_round + 1); r <= world.round; ++r)
+        c.enemy_scores[static_cast<std::size_t>(r)] = world.score.enemy;
+    c.scores_round = world.round;
+    if (c.end_round != world.round - 1 || !c.channelling) return;
+    c.channelling = false;
+    // A completed channel scores the whole bag, capture shares paid since included: one left is cancelled.
+    if (!world.me().alive || (!my_state().contains(cambc::champion_state::submitting_gems) && my_gems() > 0)) c.cancels += 1;
+}
+
+void note_tribute_end(const World& world) {
+    auto& c = channels;
+    c.end_round = world.round;
+    c.channelling = world.me().alive && my_state().contains(cambc::champion_state::submitting_gems);
+    if (c.channelling) c.turns += 1;
+}
+
+// The posterior mean of our tribute's cancel hazard a channel turn: a Gamma prior worth one cancel at
+// params::tribute_cancel_hazard, updated with our channels.
+float tribute_hazard() { return (1 + channels.cancels) / (1 / params::tribute_cancel_hazard + channels.turns); }
+
+// Expected rounds to complete a `turns` channel cancelled at hazard h a turn and restarted each time.
+float channel_rounds(int turns, float h) { return (std::pow(1 - h, -static_cast<float>(turns)) - 1) / h; }
+
+// The shortest channel whose expected waste, restarts included, is the channel itself:
+// channel_rounds(b) >= 2b, i.e. (1-h)^-b >= 1 + 2hb.
+int channel_cap(float h) {
+    static float last = -1;
+    static int kept = 0;
+    if (h == last) return kept;
+    const float step = 1 / (1 - h);
+    float grown = 1;
+    int b = 0;
+    do grown *= step, ++b;
+    while (grown < 1 + 2 * h * static_cast<float>(b) && b < static_cast<int>(cambc::constants::max_rounds));
+    last = h;
+    return kept = b;
+}
+
+// The strongest enemy Prism's Focus: as last seen (a dead one's without the bag it lost, drop_bag), and
+// out of sight since that sighting or its respawn grown by every gem a team takes, at our own team's
+// rate so far (the map is symmetric); never seen, from its base at the start. -1 with no enemy Prism.
+float enemy_prism_focus(const World& world) {
+    int taken = world.score.ally;
+    for (const auto& b : world.allies) taken += comms::bag_of(world, b.index);
+    const float per_round = static_cast<float>(taken) / static_cast<float>(std::max(1, world.round));
+    constexpr float per_gem = cambc::constants::passive_abilities::prism_focus_per_gem;
+    float enemy = -1;
+    for (const auto& e : world.enemies) {
+        if (e.facts().passive != Passive::gem_focus) continue;
+        const int since = std::max({0, e.stats_round, e.respawned_round});
+        const float grown = e.alive && !e.visible ? per_gem * per_round * static_cast<float>(std::max(0, world.round - since)) : 0.0f;
+        enemy = std::max(enemy, e.focus + grown);
+    }
+    return enemy;
+}
+
+// Rounds until the enemy reaches the win at its tribute rate over the later half of the game so far
+// (as World::ally_rate); infinite if it scored nothing there.
+float enemy_eta(const World& world) {
+    const auto& c = channels;
+    const int from = std::max(world.first_round, world.round / 2);
+    if (world.round <= from || from > c.scores_round) return INFINITY;
+    const int gained = world.score.enemy - c.enemy_scores[static_cast<std::size_t>(from)];
+    if (gained <= 0) return INFINITY;
+    const float rate = static_cast<float>(gained) / static_cast<float>(world.round - from);
+    return static_cast<float>(std::max(0, static_cast<int>(cambc::constants::winning_gems) - world.score.enemy)) / rate;
+}
+
+// Steps to the nearest altar, by a recall home when no walk leaves here (closing_now's).
+int altar_walk_steps(const World& world, Pathing& pathing) {
+    const auto& field = pathing.to_any_altar();
+    int walk = field.at(my_position());
+    if (walk == unreachable) {
+        const int out = field.at(recall_landing(world));
+        walk = out == unreachable ? 0 : recall_turns(world) + out;
+    }
+    return walk;
+}
+
+// Prism's bag, short of the win, has a channel past channel_cap: its restarts waste more than it takes.
+// It goes to an altar when the Focus it gives up decides no duel (`a`: every enemy Prism at most our Focus
+// without it), or the enemy is due to win before we could convert it (`b`). Once decided it holds until
+// the bag is banked or lost: an unseen enemy Prism's estimate grows while we walk.
+bool race_bank_now(const World& world, Pathing& pathing) {
+    static bool latched = false;
+    const int bag = static_cast<int>(my_gems());
+    if (bag == 0) return latched = false;
+    if (latched) return true;
+    const float h = tribute_hazard();
+    const int turns = tribute_turns(world, bag), cap = channel_cap(h);
+    if (turns < cap) return false;
+    const float enemy = enemy_prism_focus(world);
+    const float after = world.me().focus - cambc::constants::passive_abilities::prism_focus_per_gem * static_cast<float>(bag);
+    const float eta = enemy_eta(world);
+    const bool focus_free = enemy <= after;
+    if (!focus_free && !(eta < channel_rounds(turns, h) + static_cast<float>(altar_walk_steps(world, pathing)))) return false;
+    debug_block({
+        std::printf("RACEBANK %d %d %d %.4f %c %.1f %.1f %.0f\n", world.round, bag, cap, static_cast<double>(h), focus_free ? 'a' : 'b',
+                    static_cast<double>(enemy), static_cast<double>(after), static_cast<double>(std::isfinite(eta) ? eta : -1.0f));
+    });
+    return latched = true;
+}
+
+bool race_bank(const World& world, Pathing& pathing) {
+    struct Key {
+        std::uint32_t round, observations, gems;
+        vec2 here;
+        bool operator==(const Key&) const = default;
+    };
+    static Key last{~0u};
+    static bool kept = false;
+    const Key key{static_cast<std::uint32_t>(world.round), world.observations, my_gems(), my_position()};
+    if (key == last) return kept;
+    kept = race_bank_now(world, pathing);
+    last = key;
+    return kept;
+}
+
+// Prism keeps the gems it carries or gains for their Focus, until its bag wins, the game closes or its
+// channel outgrows what it can convert (race_bank).
 bool keeps_gems(const World& world, Pathing& pathing) {
-    return world.me().facts().passive == Passive::gem_focus && !winning_bag(world) && !closing(world, pathing);
+    return world.me().facts().passive == Passive::gem_focus && !winning_bag(world) && !closing(world, pathing) && !race_bank(world, pathing);
 }
 
 bool retaining_gems(const World& world, Pathing& pathing) { return my_gems() > 0 && keeps_gems(world, pathing); }
