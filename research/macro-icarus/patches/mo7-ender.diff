+bool reaches_channel(const World& world, const ChampionBelief& e) {
+    if (e.channel != Channel::tribute) return false;
+    const auto& f = world.me().facts();
+    int steps = std::max(0, dist(my_position(), e.pos) - f.attack_range());
+    if (const int dash = f.slot_of(AbilityKind::dash); dash >= 0 && world.me().ability_ready(dash, world.round) && my_can_cast())
+        steps = std::max(0, steps - dash_range);
+    // A step a turn from this one: in range by our turn `steps` rounds on, which must come before the channel lands.
+    return turn_start(world, world.me(), world.round + steps) < turn_start(world, e, e.channel_end_round);
+}
