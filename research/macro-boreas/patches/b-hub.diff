+// Off Prism, our Prism ally as farm_turn's hub bonus reads it: alive, keeping its bag (its posted one
+// unseen) with a gem more, not dominant, not channelling away, its tile known (recent_tile). `extra`:
+// that bag less its belief's gems, which keeps_bag adds to the gems asked about.
+struct HubPrism {
+    const ChampionBelief* a = nullptr;
+    int extra = 0, slack = 0;
+    vec2 at;
+};
+HubPrism hub_prism(const World& world) {
+    HubPrism hub;
+    if (world.me().facts().passive == Passive::gem_focus) return hub;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || a.facts().passive != Passive::gem_focus) continue;
+        if (a.visible && held_back(world, a, false)) return hub;
+        const int bag = a.visible ? a.gems : comms::bag_of(world, a.index);
+        vec2 at;
+        int slack = 0;
+        if (prism_dominant(world, a) || !recent_tile(world, a, at, slack) || !keeps_bag(world, a, bag - a.gems + 1)) return hub;
+        hub.a = &a, hub.extra = bag - a.gems, hub.slack = slack, hub.at = at;
+        return hub;
+    }
+    return hub;
+}
