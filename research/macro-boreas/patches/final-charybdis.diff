+    for (int i = 0; i < 8; ++i) {
+        const vec2 q = here + directions[i];
+        if (in_bounds(q) && test(open, q) && safety.burst_lethal(q)) made.tiles |= 1u << i;
+    }
+    return made.tiles;
+}
