+// Our Prism's work steps end on no tile beside us where an enemy Prism's stun burst kills us
+// (Safety::burst_lethal): only the strike search's priced fights take one. Bit i for directions[i];
+// once a tile and Safety, for the guard and its cover. Prism has no dash: single steps only.
+unsigned burst_out(const World& world, Safety& safety, vec2 here) {
+    if (world.me().facts().passive != Passive::gem_focus) return 0;
+    static struct {
+        std::uint32_t generation = 0;
+        vec2 here{-1, -1};
+        unsigned tiles = 0;
+    } made;
+    if (made.generation == Safety::generation() && made.here == here) return made.tiles;
+    made.generation = Safety::generation(), made.here = here, made.tiles = 0;
+    bool any = false;
+    for (const auto& e : world.enemies) any |= e.alive && (e.visible || e.tracked) && e.facts().passive == Passive::gem_focus;
