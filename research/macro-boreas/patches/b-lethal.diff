+Safety::Burst Safety::stun_burst(vec2 p) {
+    Burst out;
+    // The lost turn still ends, healing us on our spawn (rules abilities.stun): there the burst holds
+    // only for a Prism with two turns before ours, both before that turn end.
+    const bool spawn = test(world_.map().ally_spawn, p);
+    for (auto left = live_enemies(); left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        const auto& f = e.facts();
+        if (f.passive != Passive::gem_focus || gone(e)) continue;
+        int stun = -1, ground = -1;
+        for (int s = 0; s < 2; ++s) {
+            const auto& a = f.abilities[static_cast<std::size_t>(s)];
+            if (a.kind != AbilityKind::damage) continue;
+            if (a.stuns && a.target == Targeting::unit) stun = s;
+            else if (a.target == Targeting::ground) ground = s;
+        }
+        if (stun < 0) continue;
+        const int turns = turns_before_ours(world_, e);
+        if (turns == 0 || (spawn && turns < 2)) continue;
+        // Only a stun on its first turn before ours hands it a turn before our next: one after a walk
+        // lands on its second, the last before ours (teams alternate), and one_turn_lethal prices it.
+        const int cast = f.abilities[static_cast<std::size_t>(stun)].range(), basic = f.attack_range();
+        int d;
+        if (e.visible) d = dist(p, acts_from(e));
+        else {
+            if (!possible_within(e, p, cast) || !credible_unseen(e)) continue;
+            // As Threat::at counts an unseen enemy: out to unseen_radius of its possible tiles.
+            const auto& x = foe(e);
+            const int radius = std::min(cast, unseen_radius(x.strike.reach, x.tiles));
+            if (!possible_within(e, p, radius)) continue;
+            int lo = 0;
+            d = radius;
+            while (lo < d) {
+                const int mid = (lo + d) / 2;
+                if (possible_within(e, p, mid)) d = mid;
+                else lo = mid + 1;
+            }
+        }
+        const int t1 = next_turn_round(world_, e);
+        if (d > cast || !e.ability_ready(stun, t1)) continue;
+        const float focus = hit_focus(e), hit = hit_strength(e);
+        // The stun with a basic attack, then the ground spell with another on the turn handed back.
+        float most = f.abilities[static_cast<std::size_t>(stun)].multiplier * focus + (d <= basic ? 2 * hit : 0.0f);
+        if (ground >= 0 && e.ability_ready(ground, t1 + 1)) most += f.abilities[static_cast<std::size_t>(ground)].multiplier * focus;
+        most *= world_.me().taken;
+        if (most > out.damage) out = {most, e.index, d};
+    }
+    return out;
+}
+
+bool Safety::burst_lethal(vec2 p) {
+    if (own_health_ < 0) own_health_ = my_health() + (world_.me().shield_slot >= 0 ? shield_value(world_.me().handle) : 0.0f);
+    const float health = test(world_.map().ally_spawn, p) ? own_health_ - my_health() + my_max_health() : own_health_;
+    const auto b = stun_burst(p);
+    return b.enemy >= 0 && b.damage >= health;
+}
+
 } // namespace aph
