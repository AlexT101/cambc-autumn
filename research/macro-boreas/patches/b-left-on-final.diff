+bool World::note_left(int group) {
+    if (group < 0 || group >= static_cast<int>(camps.size())) return false;
+    auto& c = camps[group];
+    if (c.state != CampState::alive || c.state_round == round) return false; // in view: our own reading stands
+    const auto& members = map().groups[group].members;
+    for (std::size_t i = 0; i < members.size(); ++i) c.health[i] = 0.0f;
+    ++camp_geometry_version, ++c.geometry_version;
+    ++c.version;
+    c.state = CampState::cleared;
+    c.awake = Awake::asleep;
+    c.asleep = 0;
+    c.holder.reset();
+    c.held_since = -1;
+    camp_moved(static_cast<std::size_t>(group));
+    note_stirring(group);
+    return true;
+}
