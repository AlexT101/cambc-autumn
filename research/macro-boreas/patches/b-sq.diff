+// The squad zone's anchor (farm.cc): our Prism, alive and keeping its bag (keeps_bag at the bag it posts
+// while unseen), where it is seen now, else as posted or seen within a capture's rounds, else its claim's
+// centre. Not for Prism itself; false with no such Prism or nothing known of it.
+// The zone's counts for the traces (debug builds only print them).
+struct SquadTrace {
+    int turns = 0, cut = 0, fallback = 0, rounds = 0;
+    long long dist = 0;
+};
+SquadTrace squad_trace;
+
+bool squad_anchor(const World& world, vec2& at) {
+    if (world.me().facts().passive == Passive::gem_focus) return false;
+    const int recent = cambc::constants::capture_time;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || a.facts().passive != Passive::gem_focus) continue;
+        if (!keeps_bag(world, a, a.visible ? 0 : comms::bag_of(world, a.index) - a.gems)) return false;
+        if (a.visible) return at = a.pos, true;
+        int told = -1;
+        if (params::comms_ally && comms::told_ally(a.index, at, told) && told >= world.round - recent && told > a.pos_round) return true;
+        if (a.pos_source == Source::seen && a.pos_round >= world.round - recent && in_bounds(a.pos)) return at = a.pos, true;
+        const int g = comms::claim_of(world, a.index);
+        if (g >= 0 && g < static_cast<int>(world.map().groups.size())) return at = world.map().groups[g].centre, true;
+        return false;
+    }
+    return false;
+}
+
 // Prism ally a's Focus is at least twice that of every living enemy Prism we have seen, where its hits
 // already kill in duels about half the time: a gem's Focus more there is worth less than an ally's
 // capture now. No enemy Prism, or none seen: not.
