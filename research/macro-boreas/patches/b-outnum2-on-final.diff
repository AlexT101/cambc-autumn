+bool outnumbered_near(const World& world, Safety& safety, vec2 p);
+
+// Our Prism's work steps end on no tile beside us where it would be outnumbered (outnumbered_near):
+// else they walk it back toward the pack it just retreated from, and the retreat fires again.
+// Bit i for directions[i]; once a tile and Safety, like burst_out.
+unsigned outnum_out(const World& world, Safety& safety, vec2 here) {
+    if (world.me().facts().passive != Passive::gem_focus) return 0;
+    static struct {
+        std::uint32_t generation = 0;
+        vec2 here{-1, -1};
+        unsigned tiles = 0;
+    } made;
+    if (made.generation == Safety::generation() && made.here == here) return made.tiles;
+    made.generation = Safety::generation(), made.here = here, made.tiles = 0;
+    // outnumbered_near's distance test, one step looser for the tiles beside us.
+    const auto& spawn = world.map().near_enemy_spawn;
+    int near = 0;
+    for (auto left = safety.seen_enemies(); left && near < 2; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (!e.alive || test(spawn, e.pos)) continue;
+        const int reach = safety.strike_of(e).reach;
+        const vec2 from = e.teleport_pending() && in_bounds(e.tp_dest) ? e.tp_dest : e.pos;
+        if (reach >= 0 && dist(here, from) - reach <= params::pursuit_steps + 1) ++near;
+    }
+    if (near < 2) return 0;
+    const auto& open = world.map().open_for_us;
+    for (int i = 0; i < 8; ++i) {
+        const vec2 q = here + directions[i];
+        // Our spawn is exempt from the retreat (decide), so not kept off either.
+        if (in_bounds(q) && test(open, q) && !test(world.map().ally_spawn, q) && outnumbered_near(world, safety, q)) made.tiles |= 1u << i;
+    }
+    debug_block({ if (made.tiles) std::printf("OUTMASK %d %u %d %d %02x\n", world.round, my_handle(), here.x, here.y, made.tiles); });
+    return made.tiles;
+}
