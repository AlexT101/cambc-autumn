+// The rounds Prism ally a may take to reach cleared gem group G and still be worth an ally leaving it
+// (left_for_prism) or a's walk there (farm's 'L' picks). Leaving delays G's payout, and so its next
+// return, costing about G.gems a cycle of its respawn and hold, while a's carry adds carried_bonus a
+// gem: it pays while the delay is under carried_bonus x cycle. A hold's rounds besides, and no longer
+// than G's respawn.
+int collect_window(const World& world, const ChampionBelief& a, const CampGroup& G, float price) {
+    const int hold = cambc::constants::capture_time;
+    const float b = carried_bonus(world, a, G.gems, price);
+    const int extra = static_cast<int>(std::floor(std::min(b * static_cast<float>(G.respawn + hold), static_cast<float>(G.respawn))));
+    return std::max(hold, std::min(G.respawn, hold + extra));
+}
