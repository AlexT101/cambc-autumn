+// Our work steps and dashes end on no tile within `radius` (at most dash_range) where an enemy Prism's
+// stun burst kills us (Safety::burst_lethal): only the strike search's priced fights take one. Bit
+// burst_bit(d) for offset d; once a tile, radius and Safety, for the guard and its cover.
+constexpr int burst_bit(int dx, int dy) { return (dy + dash_range) * (2 * dash_range + 1) + dx + dash_range; }
+static_assert((2 * dash_range + 1) * (2 * dash_range + 1) <= 32);
+std::uint32_t burst_out(const World& world, Safety& safety, vec2 here, int radius) {
+    radius = std::min(radius, dash_range);
+    static struct {
+        std::uint32_t generation = 0;
+        vec2 here{-1, -1};
+        int radius = -1;
+        std::uint32_t tiles = 0;
+    } made;
+    if (made.generation == Safety::generation() && made.here == here && made.radius == radius) return made.tiles;
+    made.generation = Safety::generation(), made.here = here, made.radius = radius, made.tiles = 0;
+    bool any = false;
+    for (const auto& e : world.enemies) any |= e.alive && (e.visible || e.tracked) && e.facts().passive == Passive::gem_focus;
