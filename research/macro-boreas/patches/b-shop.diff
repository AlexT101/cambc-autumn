+// The max health our Prism must exceed against the living enemy Prisms we have seen, each as seen:
+// the burst (its damage spells' multipliers x its Focus: struck first, ours loses its next turn to
+// the stun and takes the ground spell too) and its own max health (a Prism with no more than its
+// killer's dies first far more often).
+float prism_threat(const World& world) {
+    float threat = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus || e.stats_round < 0) continue;
+        float multiplier = 0;
+        for (int s = 0; s < 2; ++s)
+            if (e.facts().abilities[s].kind == AbilityKind::damage) multiplier += e.facts().abilities[s].multiplier;
+        threat = std::max({threat, multiplier * e.focus, e.max_health});
+    }
+    return threat;
+}
