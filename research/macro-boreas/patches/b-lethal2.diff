+// Our Prism's work steps end on no tile beside us where an enemy Prism's stun burst kills us
+// (Safety::burst_lethal): only the strike search's priced fights take one. Bit i for directions[i];
+// once a tile and Safety, for the guard and its cover. Prism has no dash: single steps only.
+unsigned burst_out(const World& world, Safety& safety, vec2 here) {
+    if (world.me().facts().passive != Passive::gem_focus) return 0;
+    static struct {
+        std::uint32_t generation = 0;
+        vec2 here{-1, -1};
+        unsigned tiles = 0;
+    } made;
+    if (made.generation == Safety::generation() && made.here == here) return made.tiles;
+    made.generation = Safety::generation(), made.here = here, made.tiles = 0;
+    bool any = false;
+    for (const auto& e : world.enemies)
+        any |= e.alive && e.facts().passive == Passive::gem_focus && (e.visible || e.tracked || !safety.capture_evidence().empty());
+    if (!any) return 0;
+    const auto& open = world.map().open_for_us;
+    for (int i = 0; i < 8; ++i) {
+        const vec2 q = here + directions[i];
+        if (in_bounds(q) && test(open, q) && safety.burst_lethal(q)) made.tiles |= 1u << i;
+    }
+    debug_block({
+        if (made.tiles) {
+            unsigned base = 0;
+            for (int i = 0; i < 8; ++i)
+                if (made.tiles >> i & 1 && safety.burst_lethal(here + directions[i], false)) base |= 1u << i;
+            std::printf("BLG %d %u %d %d %x %d base %x ev %d\n", world.round, my_handle(), here.x, here.y, made.tiles,
+                        static_cast<int>(safety.burst_lethal(here)), base, static_cast<int>(safety.capture_evidence().size()));
+        }
+    });
+    return made.tiles;
+}
