+namespace {
+
+struct PrismGrowth {
+    int from = -1;        // the round growth counts from
+    int stats_round = -1; // the reading, respawn and bag `from` last followed
+    int respawned = -1;
+    int gems = 0; // its bag as last read, 0 once we believe it banked
+};
+struct EnemyPrisms {
+    std::array<PrismGrowth, 16> growth;
+    std::array<int, 16> gems{}; // every enemy's believed bag at the last note
+    int score = -1, round = -1;
+    float rate = 0;
+};
+EnemyPrisms enemy_prisms;
+
+float prism_gems_grown(const World& world, const ChampionBelief& e) {
+    const auto& g = enemy_prisms.growth[static_cast<std::size_t>(e.index)];
+    if (g.from < 0 || world.round <= g.from) return 0;
+    const float most = static_cast<float>(std::max(0, static_cast<int>(cambc::constants::winning_gems) - world.score.enemy - g.gems));
+    return std::min(most, enemy_prisms.rate * static_cast<float>(world.round - g.from));
+}
+
+} // namespace
+
+void note_enemy_prisms(const World& world, float rate) {
+    auto& s = enemy_prisms;
+    if (s.round == world.round) return;
+    s.round = world.round, s.rate = rate;
+    const int n = std::min(static_cast<int>(world.enemies.size()), 16);
+    const int jump = s.score < 0 ? 0 : world.score.enemy - s.score;
+    s.score = world.score.enemy;
+    // Bags World emptied since the last note: tributes it put down to their carriers.
+    int explained = 0;
+    for (int i = 0; i < n; ++i) {
+        const auto& e = world.enemies[static_cast<std::size_t>(i)];
+        if (e.alive && e.facts().passive != Passive::gem_focus) explained += std::max(0, s.gems[static_cast<std::size_t>(i)] - e.gems);
+    }
+    for (int i = 0; i < n; ++i) {
+        const auto& e = world.enemies[static_cast<std::size_t>(i)];
+        auto& g = s.growth[static_cast<std::size_t>(i)];
+        const int before = s.gems[static_cast<std::size_t>(i)];
+        s.gems[static_cast<std::size_t>(i)] = e.gems;
+        if (e.facts().passive != Passive::gem_focus || !e.alive) continue;
+        const float grown = prism_gems_grown(world, e);
+        bool banked = false;
+        if (e.visible || g.from < 0 || e.stats_round != g.stats_round || e.respawned_round != g.respawned || e.gems < before)
+            g = {world.round, e.stats_round, e.respawned_round, e.gems};
+        // Not its bag plus `grown`: the real bag is mostly below that upper bound, and a bank missed
+        // leaves the growth running all game.
+        else if (jump > 0 && jump - explained >= std::max(1, g.gems))
+            g.from = world.round, g.gems = 0, banked = true;
+        debug_block({
+            const float seen = e.focus, est = prism_focus_estimate(world, e);
+            if (!e.visible && est >= 1.25f * seen)
+                std::printf("PFE %d %u e%d seen %d est %d age %d grown %.1f rate %.2f t%d\n", world.round, my_handle(), i, static_cast<int>(seen),
+                            static_cast<int>(est), world.round - g.from, static_cast<double>(prism_gems_grown(world, e)), static_cast<double>(rate), e.tracked);
+            if (banked) std::printf("PFR %d %u e%d jump %d expl %d grown %.1f\n", world.round, my_handle(), i, jump, explained, static_cast<double>(grown));
+        });
+    }
+}
+
+float prism_focus_estimate(const World& world, const ChampionBelief& e) {
+    if (e.visible || e.index < 0 || e.index >= 16) return e.focus;
+    return e.focus + cambc::constants::passive_abilities::prism_focus_per_gem * prism_gems_grown(world, e);
+}
+
+std::span<const vec2> Safety::capture_evidence() {
+    if (evidence_observations_ == world_.observations && evidence_round_ == world_.round) return {evidence_.data(), static_cast<std::size_t>(evidence_n_)};
+    evidence_observations_ = world_.observations, evidence_round_ = world_.round, evidence_n_ = 0;
+    const auto& groups = world_.map().groups;
+    const std::size_t n = std::min(groups.size(), world_.camps.size());
+    for (std::size_t g = 0; g < n && evidence_n_ < static_cast<int>(evidence_.size()); ++g) {
+        const auto& c = world_.camps[g];
+        const auto& G = groups[g];
+        if (G.gems <= 0 || c.state != CampState::cleared || c.state_round != world_.round || c.holder != team::enemy) continue;
+        // A capturer we see, or a tracked enemy that may stand on an unseen camp tile, explains the hold.
+        bool seen = false;
+        for (const auto& e : world_.enemies) {
+            if (!e.alive || seen) continue;
+            if (e.visible) seen = test(G.tiles(), e.pos);
+            else if (e.tracked)
+                for (const auto& m : G.members) seen |= !test(world_.visible, m.pos) && e.possible_box.meets(m.pos, 0) && test(e.possible, m.pos);
+        }
+        if (seen) continue;
+        for (const auto& m : G.members)
+            if (!test(world_.visible, m.pos) && evidence_n_ < static_cast<int>(evidence_.size())) evidence_[static_cast<std::size_t>(evidence_n_++)] = m.pos;
+    }
+    return {evidence_.data(), static_cast<std::size_t>(evidence_n_)};
+}
+
+Safety::Burst Safety::stun_burst(vec2 p, bool extended) {
+    Burst out;
+    // The lost turn still ends, healing us on our spawn (rules abilities.stun): there the burst holds
+    // only for a Prism with two turns before ours, both before that turn end.
+    const bool spawn = test(world_.map().ally_spawn, p);
+    std::uint32_t untracked = 0;
+    if (extended) {
+        for (int i = 0; i < std::min(static_cast<int>(world_.enemies.size()), 16); ++i)
+            if (const auto& e = world_.enemies[static_cast<std::size_t>(i)]; e.alive && !e.visible && !e.tracked && e.facts().passive == Passive::gem_focus)
+                untracked |= 1u << i;
+        if (untracked && capture_evidence().empty()) untracked = 0;
+    }
+    for (auto left = live_enemies() | untracked; left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        const auto& f = e.facts();
+        if (f.passive != Passive::gem_focus || gone(e)) continue;
+        int stun = -1, ground = -1;
+        for (int s = 0; s < 2; ++s) {
+            const auto& a = f.abilities[static_cast<std::size_t>(s)];
+            if (a.kind != AbilityKind::damage) continue;
+            if (a.stuns && a.target == Targeting::unit) stun = s;
+            else if (a.target == Targeting::ground) ground = s;
+        }
+        if (stun < 0) continue;
+        const int turns = turns_before_ours(world_, e);
+        if (turns == 0 || (spawn && turns < 2)) continue;
+        // Only a stun on its first turn before ours hands it a turn before our next: one after a walk
+        // lands on its second, the last before ours (teams alternate), and one_turn_lethal prices it.
+        const int cast = f.abilities[static_cast<std::size_t>(stun)].range(), basic = f.attack_range();
+        int d;
+        if (e.visible) d = dist(p, acts_from(e));
+        else if (!e.tracked) {
+            d = cast + 1;
+            for (const vec2 q : capture_evidence()) d = std::min(d, dist(p, q));
+        } else {
+            if (!possible_within(e, p, cast) || !credible_unseen(e)) continue;
+            // As Threat::at counts an unseen enemy: out to unseen_radius of its possible tiles.
+            const auto& x = foe(e);
+            const int radius = std::min(cast, unseen_radius(x.strike.reach, x.tiles));
+            if (!possible_within(e, p, radius)) continue;
+            int lo = 0;
+            d = radius;
+            while (lo < d) {
+                const int mid = (lo + d) / 2;
+                if (possible_within(e, p, mid)) d = mid;
+                else lo = mid + 1;
+            }
+        }
+        const int t1 = next_turn_round(world_, e);
+        if (d > cast || !e.ability_ready(stun, t1)) continue;
+        const float focus = extended ? prism_focus_estimate(world_, e) * e.scale : hit_focus(e), hit = hit_strength(e);
+        // The stun with a basic attack, then the ground spell with another on the turn handed back.
+        float most = f.abilities[static_cast<std::size_t>(stun)].multiplier * focus + (d <= basic ? 2 * hit : 0.0f);
+        if (ground >= 0 && e.ability_ready(ground, t1 + 1)) most += f.abilities[static_cast<std::size_t>(ground)].multiplier * focus;
+        most *= world_.me().taken;
+        if (most > out.damage) out = {most, e.index, d};
+    }
+    return out;
+}
+
+bool Safety::burst_lethal(vec2 p, bool extended) {
+    if (own_health_ < 0) own_health_ = my_health() + (world_.me().shield_slot >= 0 ? shield_value(world_.me().handle) : 0.0f);
+    const float health = test(world_.map().ally_spawn, p) ? own_health_ - my_health() + my_max_health() : own_health_;
+    const auto b = stun_burst(p, extended);
+    return b.enemy >= 0 && b.damage >= health;
+}
+
 } // namespace aph
