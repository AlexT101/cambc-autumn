--- bots/charybdis/src/combat/guard.cc	2026-11-11 21:19:35.414928387 +0000
+++ bots/variants/b-outnum/src/combat/guard.cc	2026-11-11 21:27:35.597933153 +0000
@@ -903,6 +903,25 @@
     else guard_steps(world, pathing, safety);
 }
 
+bool outnumbered_near(const World& world, Safety& safety, vec2 p) {
+    const auto& spawn = world.map().near_enemy_spawn;
+    int enemies = 0;
+    for (auto left = safety.seen_enemies(); left; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (!e.alive || test(spawn, e.pos)) continue;
+        const int reach = safety.strike_of(e).reach;
+        const vec2 from = e.teleport_pending() && in_bounds(e.tp_dest) ? e.tp_dest : e.pos;
+        // By distance first: approach() may build a walk field.
+        if (reach < 0 || dist(p, from) - reach > params::pursuit_steps) continue;
+        if (safety.approach(e, p, params::pursuit_steps) <= params::pursuit_steps) ++enemies;
+    }
+    if (enemies < 2) return false;
+    int ours = 0;
+    for (const auto& a : world.allies)
+        if (a.alive && (a.is_self || (a.visible && dist(p, a.pos) <= params::pack_ally_radius))) ++ours;
+    return enemies > ours;
+}
