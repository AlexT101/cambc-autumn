+// Diagnostic phase probe: scales ONE constant by `mult` in rounds [lo, hi] only, read at its use with
+// the turn's round. which: 0 none (the bot as chy-ref), 1 recall_health_fraction, 2 camp_risk,
+// 3 home_power, 4 mid_exposure's premium over 1 (max_exposure's alike, so exposure_most still bounds),
+// 5 hurt_retreat_ratio and home_retreat_ratio, 6 gold_price_scale.
+namespace phaseknob {
+constexpr int which = 0;
+constexpr int lo = 1, hi = 200;
+constexpr float mult = 1.0f;
+} // namespace phaseknob
+enum PhaseKnob : int { pk_recall = 1, pk_camp_risk, pk_home_power, pk_mid_exposure, pk_retreat, pk_gold_price };
+// The knob is compiled in for constant `id` (its caches then key on pk_in).
+constexpr bool pk_live(int id) { return phaseknob::which != 0 && phaseknob::which == id; }
+constexpr bool pk_in(int id, int round) { return pk_live(id) && round >= phaseknob::lo && round <= phaseknob::hi; }
+constexpr float pk(int id, float base, int round) { return pk_in(id, round) ? base * phaseknob::mult : base; }
+// drawn_home's and may_draw_home's gate, "either recall line is at most recall_health_fraction": a
+// scaled-down fraction may fall below safe_recall_health_fraction.
+inline float pk_recall_gate(int round) {
+    if constexpr (!pk_live(pk_recall)) return recall_health_fraction;
+    const float r = pk(pk_recall, recall_health_fraction, round);
+    return r < safe_recall_health_fraction ? safe_recall_health_fraction : r;
+}
+// A premium over 1 (mid_exposure, max_exposure) scales by mult.
+constexpr float pk_premium(int id, float base, int round) { return pk_in(id, round) ? 1.0f + (base - 1.0f) * phaseknob::mult : base; }
+
 } // namespace aph::params
