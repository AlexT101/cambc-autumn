 // A group's weight by its side of the map: 1 in our half, falling towards the enemy spawn. Kept
 // per group. The first turn reads one group's enemy steps; the turn end then decodes them all,
 // since a play turn's farm weighs nearly every group.
+// Phase knob (home_power): the share is kept, and its weight at each side of the window; crossing it,
+// home_weights take the weights read for the new side.
+float home_ground_phased(const StaticMap& map, int g, bool first_turn) {
+    struct Kept {
+        float share = -1; // until read; 1 (weight 1) without both walks
+        float weight[2] = {-1, -1};
+    };
+    static std::array<Kept, 256> cache;
+    static bool kept_in = false;
+    const bool in = params::pk_in(params::pk_home_power, static_cast<int>(turn_round()));
+    const float power = params::pk(params::pk_home_power, params::home_power, static_cast<int>(turn_round()));
+    if (in != kept_in) {
+        kept_in = in;
+        for (std::size_t k = 0; k < cache.size(); ++k) {
+            auto& c = cache[k];
+            if (c.share < 0) continue;
+            if (c.weight[in] < 0) c.weight[in] = std::pow(c.share, power);
+            home_weights()[k] = c.weight[in];
+        }
+    }
+    Kept uncached;
+    auto& c = static_cast<std::size_t>(g) < cache.size() ? cache[g] : uncached;
+    if (c.share < 0) {
+        int from_us = map.ally_steps(g);
+        int from_them = first_turn ? map.enemy_steps_of(g) : map.enemy_steps(g);
+        if (from_us == unreachable) {
+            from_us = dist(map.ally_spawn_centre, map.groups[g].centre);
+            from_them = dist(map.enemy_spawn_centre, map.groups[g].centre);
+        }
+        c.share = 1.0f;
+        if (from_us != unreachable && from_them != unreachable)
+            c.share = std::min(1.0f, 2.0f * static_cast<float>(from_them) / static_cast<float>(from_us + from_them));
+    }
+    if (c.weight[in] < 0) {
+        c.weight[in] = c.share == 1.0f ? 1.0f : std::pow(c.share, power);
+        if (static_cast<std::size_t>(g) < 256) home_weights()[static_cast<std::size_t>(g)] = c.weight[in];
+    }
+    return c.weight[in];
+}
+
 float home_ground(const StaticMap& map, int g, bool first_turn) {
+    if constexpr (params::pk_live(params::pk_home_power)) return home_ground_phased(map, g, first_turn);
     struct Kept {
         float weight = -1; // until read
     };
