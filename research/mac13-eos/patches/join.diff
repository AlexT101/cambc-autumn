+// A visible teammate already trades blows with visible e, near enough for us to join (as pack_joiners):
+// one of them stands in the other's attack range.
+bool in_contact(const World& world, const ChampionBelief& e, vec2 here) {
+    if (!e.visible || dist(here, e.pos) > safety_params::chasing_ally_radius) return false;
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible
+            && dist(a.pos, e.pos) <= std::max(a.facts().attack_range(), e.facts().attack_range()))
+            return true;
+    return false;
+}
