+// Stance: a risk posture by the lead (score plus carried gems, ours minus theirs; bot.cc stance_lead).
+// Past about 75 gems either way the mirror's game is mostly decided (research/mac13-eos leadwin.py):
+// the leader's only risk is variance, the trailer's only hope. AHEAD (`safe`) recalls at a higher health,
+// asks more spare health of camps, discounts enemy ground more, drops the middle band's premium and
+// retreats from smaller packs; BEHIND (`risky`) the reverse. The state enters past `enter` and leaves
+// inside `leave` (each change re-reads the caches keyed on it). Past `deep_enter` behind, where the
+// mirror wins about 15% or less, DEEP doubles BEHIND's deviation (variance is worth more the further
+// behind); it leaves inside `deep_leave`, BEHIND's hysteresis width. Past `hopeless_enter` (the mirror
+// wins 3-9%), HOPELESS goes further (BEHIND's multipliers cubed, the premium's deviation tripled), with
+// the same hysteresis.
+namespace stance {
+inline constexpr bool safe = false, risky = true;
+inline constexpr int enter = 75, leave = 45;
+inline constexpr int deep_enter = 150, deep_leave = deep_enter - (enter - leave);
+inline constexpr int hopeless_enter = 300, hopeless_leave = hopeless_enter - (enter - leave);
+inline constexpr float up = 1.4f, down = 0.7f;          // recall, camp_risk, retreat ratios
+inline constexpr float home_up = 2.0f, home_down = 0.5f; // home_power
+// mid_exposure's premium over 1, BEHIND and DEEP only: it is a race for the contested middle and our front yard,
+// not a price of exposure (dropping it in r201-500 cost 2.4 points), so AHEAD keeps it.
+inline constexpr float premium_up = 2.0f;
+// DEEP: recall and camp_risk x0.5 (the recall line floored at the safe line, as BEHIND's), retreat
+// ratios x2 (both scale alike, so the home ratio stays below the hurt one), home_power x0.25, premium x3.
+inline constexpr float deep_down = 0.5f, deep_up = 2.0f, deep_home = 0.25f, deep_premium = 3.0f;
+// HOPELESS: BEHIND's multipliers cubed (DEEP's are about their squares), the premium's deviation
+// tripled. The recall line then reaches the safe line, its floor, on the default line (0.3155 x 0.343).
+inline constexpr float hopeless_down = down * down * down, hopeless_up = up * up * up,
+                       hopeless_home = home_down * home_down * home_down, hopeless_premium = 4.0f;
+} // namespace stance
+// From st_behind up, each state is further behind than the last (compared with >=).
+enum StanceState : int { st_even = 0, st_ahead = 1, st_behind = 2, st_deep = 3, st_hopeless = 4 };
+// The turn's state (bot.cc decide), even for a side whose posture is off.
+inline int stance_state = st_even;
+enum PhaseKnob : int { pk_recall = 1, pk_camp_risk, pk_home_power, pk_mid_exposure, pk_retreat, pk_gold_price };
