 // farm finish on: with less at their start the turn ran out 98% and 99.7% of the time (5,120 games at the real budget,
 // research/ideas-2026-11-12/fightfuel).
 inline constexpr std::uint64_t goal_least = 4000, farm_least = 6000;
+
+// The stance's lead (params::stance): tributed gems and carried bags, ours minus theirs. Teammates'
+// bags as posted (comms, in fours rounded up, capped at 508, a round late), ours now (the post is last
+// turn's: a tribute landing at our turn start would count twice). An enemy's bag is its last reading
+// plus what it would have collected since at our rate a body, less its share of the enemy's tributes
+// since: against the replays' true bags, bias -6 and mean error 53 gems (research/mac13-eos stancefit.py).
+int stance_lead(const World& world) {
+    int ours = 0;
+    for (int i = 0; i < static_cast<int>(world.allies.size()); ++i) {
+        const auto& a = world.allies[static_cast<std::size_t>(i)];
+        if (!a.alive) continue;
+        // A post at its cap (a Prism's big bag) is read exactly while in sight.
+        const int posted = a.is_self ? static_cast<int>(my_gems()) : comms::bag_of(world, i);
+        ours += posted >= 508 && a.visible ? std::max(posted, a.gems) : posted;
+    }
+    int alive = 0;
+    for (const auto& e : world.enemies) alive += e.alive;
+    const float per_body = static_cast<float>(world.score.ally + ours) / static_cast<float>(std::max(1, world.round)) / static_cast<float>(std::max(1, alive));
+    float theirs = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive) continue;
+        theirs += static_cast<float>(e.gems);
+        if (e.visible) continue;
+        // Since the reading, or the respawn that emptied the bag.
+        const int since = std::max({e.stats_round, e.respawned_round, 0});
+        const float tributed = static_cast<float>(world.score.enemy - world.enemy_score_at(since)) / static_cast<float>(std::max(1, alive));
+        theirs += std::max(0.0f, per_body * static_cast<float>(world.round - since) - tributed);
+    }
+    return world.score.ally + ours - world.score.enemy - static_cast<int>(theirs);
+}
+void update_stance(const World& world) {
+    namespace S = params::stance;
+    const int lead = stance_lead(world);
+    int& s = params::stance_state;
+    const int was = s;
+    const bool behind = s >= params::st_behind;
+    if (lead >= S::enter) s = params::st_ahead;
+    else if (lead <= -S::hopeless_enter) s = params::st_hopeless;
+    else if (lead <= -S::deep_enter) s = s == params::st_hopeless && lead <= -S::hopeless_leave ? params::st_hopeless : params::st_deep;
+    else if (lead <= -S::enter) s = s >= params::st_deep && lead <= -S::deep_leave ? params::st_deep : params::st_behind;
+    else if ((s == params::st_ahead && lead < S::leave) || (behind && lead > -S::leave)) s = params::st_even;
+    else if (s >= params::st_deep) s = params::st_behind;
+    if (world.round % 10 == 0 || s != was) debug_block({
+        int ours = 0;
+        for (int i = 0; i < static_cast<int>(world.allies.size()); ++i)
+            if (world.allies[static_cast<std::size_t>(i)].alive) ours += comms::bag_of(world, i);
+        std::printf("STANCE %d %u %d %d %d %d %d %d", world.round, static_cast<std::uint32_t>(world.me().handle), s, lead, s != was,
+                    world.score.ally, world.score.enemy, ours);
+        for (const auto& e : world.enemies)
+            std::printf(" %d:%d:%d:%d", e.alive ? 1 : 0, e.gems, e.visible ? 0 : world.round - std::max({e.stats_round, e.respawned_round, 0}), static_cast<int>(e.type));
+        std::printf("\n");
+    });
+}
+
 void decide(World& world, Pathing& pathing, Safety& safety, Memory& memory) {
     comeback::cooked(world); // every turn: the cook's hysteresis reads each round's scores
+    update_stance(world);
     // Last turn's, for continue_recall: kept only while that recall is, else farm sets it again.
     const int recall_farm = std::exchange(memory.recall_farm, -1);
     if (!world.me().alive || !banks_bag(world, pathing)) memory.banking = false;
