diff -ruN bots/variants/chy-ref/src/combat/escort.cc bots/variants/stack3/src/combat/escort.cc
--- bots/variants/chy-ref/src/combat/escort.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/stack3/src/combat/escort.cc	2026-11-13 08:04:52.297209605 +0000
@@ -0,0 +1,164 @@
+// The encounter escort (research/mac13-eos escort). Support decides Prism encounters: with no ally
+// within 8 our Prism died in 25% of them, with 4 or more in 9%, and the enemy's 7% against 19%. A
+// standing cohesion costs the farm, so only an encounter calls the team in, and only the allies whose
+// walk joins our Prism's fight (fight_ally_radius) before the meeting is over.
+// - Our Prism meets the enemy Prism when its strike can reach us within two of its turns. It posts
+//   its tile and the meeting's horizon (comms::encounter): the turns until the enemy Prism is in
+//   reach, then the duel's (Safety::duel, theirs first) to its first kill, or the fight's horizon.
+//   Vision is personal: the post reaches allies who see neither Prism.
+// - An ally that walks within the radius in the horizon steps towards our Prism instead of farming,
+//   never onto a tile where it could be killed; Cassi and Issac only both together. Beside it, the
+//   farm goes on within the radius. A capture hold, a bag, a shop trip, a fight, a chase or a siege come first.
+// - Our Prism's retreat in an encounter steps towards the nearest ally in sight beyond the radius, onto
+//   a tile no threat can kill it on whose fight (its allies within the radius counted) is not lost;
+//   else it retreats home as before.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// The enemy Prism's next turn's reach: its spells exclude a walk, so its ground spell at ability_range and its 3x3
+// (a walk and a basic attack reach less).
+constexpr int prism_strike_reach = ability_range + 1;
+// It could strike within two of its turns.
+constexpr int encounter_distance = prism_strike_reach + 1;
+
+// A team picks each champion once, so each side has at most one Prism, fixed all match.
+const ChampionBelief* prism_of(const std::vector<ChampionBelief>& side) {
+    for (const auto& c : side)
+        if (c.facts().passive == Passive::gem_focus) return &c;
+    return nullptr;
+}
+const ChampionBelief* enemy_prism(const World& world) {
+    static const int i = [&] {
+        const auto* p = prism_of(world.enemies);
+        return p ? p->index : -1;
+    }();
+    return i >= 0 ? &world.enemies[static_cast<std::size_t>(i)] : nullptr;
+}
+const ChampionBelief* ally_prism(const World& world) {
+    static const int i = [&] {
+        const auto* p = prism_of(world.allies);
+        return p ? p->index : -1;
+    }();
+    return i >= 0 ? &world.allies[static_cast<std::size_t>(i)] : nullptr;
+}
+
+// Our Prism's turn end, dead or alive.
+void post_encounter(const World& world, Safety& safety) {
+    const auto& me = world.me();
+    if (me.facts().passive != Passive::gem_focus) return;
+    bool on = false;
+    int horizon = 0;
+    const vec2 here = me.alive ? my_position() : vec2{-1, -1};
+    // Ren's reflection can kill us in our own turn: we then read as off the map.
+    if (me.alive && here.x >= 0) {
+        const auto* e = enemy_prism(world);
+        if (e && e->alive && dist(here, e->pos) <= encounter_distance && (safety.live_enemies() >> e->index & 1)
+            && (e->visible || safety.credible_unseen(*e))) {
+            // Short of the duel's fuel, the fight's whole horizon: an escort too many rather than none.
+            int resolve = comms::encounter_horizons.back();
+            if (fuel_ok(posts_cost + safety.fight_cost_estimate())) {
+                const Trade t = safety.duel(me, *e, true);
+                if (t.turns_to_kill_us > 0) resolve = std::min(resolve, t.turns_to_kill_us);
+                if (t.turns_to_kill_them > 0) resolve = std::min(resolve, t.turns_to_kill_them);
+            }
+            horizon = std::max(0, dist(here, e->pos) - prism_strike_reach) + resolve;
+            on = true;
+            debug_block({ std::printf("ESC %d %u P %d %d %d\n", world.round, my_handle(), horizon, dist(here, e->pos), e->visible ? 1 : 0); });
+        }
+    }
+    comms::encounter(world.round, on, here, horizon);
+}
+
+// At the farm's turn: an escort step towards our Prism in its encounter (true), or, beside it, the
+// farm kept within the radius (`work_avoid`: the work guard's own board, merged).
+bool escort(const World& world, Pathing& pathing, Safety& safety, const Memory& memory, const bitboard* work_avoid) {
+    const auto& me = world.me();
+    // A siege at work keeps its stage: its hits and heal trips are priced by siege() alone.
+    if (me.facts().passive == Passive::gem_focus || !my_can_move() || memory.siege) return false;
+    vec2 at;
+    int horizon = 0;
+    if (!comms::told_encounter(world, at, horizon)) return false;
+    const auto* p = ally_prism(world);
+    if (!p || !p->alive) return false;
+    const vec2 prism = p->visible ? p->pos : at;
+    const vec2 here = my_position();
+    constexpr int r = safety_params::fight_ally_radius;
+    const int d = dist(here, prism);
+    if (d <= r) {
+        // Willow keeps her own stations (guard_work); the rest keep within the radius.
+        if (!me.facts().heals()) {
+            static bitboard box{cambc::uninitialized}, stay{cambc::uninitialized};
+            clear_board(box);
+            draw_square(box, prism, static_cast<float>(r));
+            not_into(box, stay);
+            if (work_avoid) stay |= *work_avoid;
+            guard_work(world, pathing, safety, memory.damage, &stay);
+        }
+        debug_block({ std::printf("ESC %d %u I %d %d\n", world.round, my_handle(), horizon, d); });
+        return false;
+    }
+    // A step a turn: Chebyshev bounds the walk from below.
+    if (d - r > horizon) {
+        debug_block({ std::printf("ESC %d %u f %d %d\n", world.round, my_handle(), horizon, d); });
+        return false;
+    }
+    // One death takes both: the pair goes only together, and only while each sees the other.
+    if (const auto* q = partner(world); q && (!q->alive || !q->visible || dist(q->pos, prism) - r > horizon)) {
+        debug_block({ std::printf("ESC %d %u l %d %d\n", world.round, my_handle(), horizon, d); });
+        return false;
+    }
+    static bitboard goals{cambc::uninitialized}, lethal{cambc::uninitialized};
+    clear_board(goals);
+    draw_square(goals, prism, static_cast<float>(r));
+    clear_board(lethal);
+    for (const vec2 dir : directions)
+        if (const vec2 q = here + dir; in_bounds(q) && safety.lethal(q)) set_tile(lethal, q);
+    const bool moved = pathing.step_towards(goals, &lethal, horizon);
+    debug_block({ std::printf("ESC %d %u %c %d %d\n", world.round, my_handle(), moved ? 'S' : 'n', horizon, d); });
+    return moved;
+}
+
+bool retreat_to_escort(const World& world, Pathing& pathing, Safety& safety) {
+    const auto& me = world.me();
+    if (me.facts().passive != Passive::gem_focus || !my_can_move()) return false;
+    const vec2 here = my_position();
+    const auto* e = enemy_prism(world);
+    if (!e || !e->alive || dist(here, e->pos) > encounter_distance || !(safety.live_enemies() >> e->index & 1)
+        || !(e->visible || safety.credible_unseen(*e)))
+        return false;
+    constexpr int r = safety_params::fight_ally_radius;
+    const ChampionBelief* near = nullptr;
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible && (!near || dist(a.pos, here) < dist(near->pos, here))) near = &a;
+    // One already within the radius is in the fight, and retreat_step ranks its own steps.
+    if (!near || dist(near->pos, here) <= r) return false;
+    // A walk the dash was put off for is the escape plan's.
+    if (walk_dash_deferred(world) && my_can_cast()) return false;
+    // lethal() reads no damage from a one-cast kill whose slot is ready the turn after next (ATLAS fix 5):
+    // retreat_step keeps out of its reach, and so does this step.
+    std::array<ComingCast, 8> coming;
+    const int casts = fuel_ok(params::refine_fuel) ? coming_casts(world, coming) : 0;
+    const auto& blocked = pathing.blocked();
+    std::optional<vec2> best;
+    for (const vec2 d : directions) {
+        const vec2 q = here + d;
+        if (!in_bounds(q) || test(blocked, q) || dist(q, near->pos) >= dist(here, near->pos)) continue;
+        bool cast_reach = false;
+        for (int i = 0; i < casts; ++i) cast_reach |= dist(q, coming[static_cast<std::size_t>(i)].pos) <= coming[static_cast<std::size_t>(i)].reach;
+        if (cast_reach) continue;
+        if (best && (dist(q, near->pos) > dist(*best, near->pos) || (dist(q, near->pos) == dist(*best, near->pos) && dist(q, e->pos) <= dist(*best, e->pos)))) continue;
+        if (!fuel_ok(goal_least + safety.fight_cost_estimate())) break;
+        if (safety.lethal(q) || safety.fight(q).lost) continue;
+        best = q;
+    }
+    const bool moved = best && pathing.try_move(*best);
+    debug_block({ std::printf("ESC %d %u %c %d %d\n", world.round, my_handle(), moved ? 'Z' : 'z', dist(here, near->pos), dist(here, e->pos)); });
+    return moved;
+}
+
+} // namespace
+
+} // namespace aph
diff -ruN bots/variants/chy-ref/src/combat/fight.cc bots/variants/stack3/src/combat/fight.cc
--- bots/variants/chy-ref/src/combat/fight.cc	2026-11-13 01:55:41.151951223 +0000
+++ bots/variants/stack3/src/combat/fight.cc	2026-11-13 08:00:15.885949922 +0000
@@ -211,17 +211,54 @@
     std::array<float, side * side> memo_;
 };
 
+// A visible enemy whose one cast kills us, with that slot cooling on its next turn and ready on the
+// one after, near enough that our step changes whether we stand inside the cast's reach then: that
+// reach plus the step it walks first. Every step reads no damage from it now (a slot ready on its
+// next turn is in Safety's damage and avoid()), and a walk home lets it follow at our pace and cast
+// once the cooldown ends.
+struct ComingCast {
+    vec2 pos;
+    int reach;
+};
+
+int coming_casts(const World& world, std::array<ComingCast, 8>& out) {
+    const float life = my_health_and_shield(world), taken = world.me().taken;
+    const vec2 here = my_position();
+    int n = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible || n == static_cast<int>(out.size())) continue;
+        const int round = next_turn_round(world, e);
+        const vec2 from = e.teleport_pending() && in_bounds(e.tp_dest) ? e.tp_dest : e.pos; // it acts from there
+        int reach = -1;
+        for (int s = 0; s < 2; ++s) {
+            if (e.ability_ready(s, round) || !e.ability_ready(s, round + 1)) continue;
+            const auto &k = strike_with(e, 1u << s), &basic = strike_with(e, 0);
+            for (int d = k.reach; d >= 0; --d)
+                if (k.at(d) * taken >= life && k.at(d) > basic.at(d)) {
+                    reach = std::max(reach, d + 1);
+                    break;
+                }
+        }
+        // A step moves us by at most 1: farther out, every step stays clear of it.
+        if (reach >= 0 && dist(here, from) <= reach + 1) out[static_cast<std::size_t>(n++)] = {from, reach};
+    }
+    return n;
+}
+
 // Inside danger the shortest walk home, ties in compass order, can lead along the enemies we flee:
 // rank the steps by the damage they risk, then stun-free first, then steps home, then distance from
 // visible enemies. A sideways step wins only on damage, or off a sole Prism's hold; one away from home only if it leaves every
