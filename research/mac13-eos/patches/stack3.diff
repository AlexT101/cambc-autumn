+float Safety::stun_follow_up(vec2 p, float blow_scale, float& cost) {
+    // The stunner: of the visible blows at p that stun, the one giving up least for its stun turn.
+    const ChampionBelief* stunner = nullptr;
+    unsigned stun_slot = 0;
+    cost = 0;
+    for (const auto& t : threats()) {
+        if (!t.visible) continue;
+        const auto& e = *t.belief;
+        const Blow b = t.at(p);
+        if (!b.stuns) continue;
+        auto& x = struck(e);
+        // A threat may act only after our next turn: its stun takes the one after.
+        const int turns = turns_before_ours(world_, e, x.turns);
+        if (turns < 1) continue;
