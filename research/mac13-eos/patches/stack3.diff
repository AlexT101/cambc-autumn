+    if (!stunner) return 0;
+    // The camp phase after next: members stunned now act in it.
+    float total = camp_damage(p, true, false);
+    for (auto left = live_enemies(); left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (e.visible ? !in_square(p, acts_from(e), Strike::max_reach) : !e.possible_box.meets(p, Strike::max_reach)) continue;
+        if (gone(e)) continue;
+        auto& x = foe(e);
+        if (!e.visible && x.weight <= 0) continue;
+        // With turn order stable, each enemy has two turns between ours now and ours after the
+        // lost one, in the rounds from its next (`first`, before a stun took it): with fewer than
+        // two before our next turn, the second falls in the window, and worst_damage counted the
+        // first wherever it fell. The stunner's second turn counts though both come before ours:
+        // threat_strike widens to its better turn, never the sum.
+        const bool lost = turn_lost(e);
+        const int turns = turns_before_ours(world_, e, x.turns);
+        if (turns + (lost ? 1 : 0) >= 2 && &e != stunner) continue;
+        // A stunner losing its turn now has only its stun turn before our next: no turn follows it.
+        if (&e == stunner && lost) continue;
+        const int first = next_turn_round(world_, e) - (lost ? 1 : 0);
+        if (first + 1 > world_.round + 2) continue; // a teleport's channel
+        // A slot cast on its first turn is still cooling (rules abilities.cooldown).
+        const unsigned later = ready_slots(e, first + 1);
+        if (e.visible) {
+            const int d = dist(p, acts_from(e));
+            unsigned used = 0;
+            bool walked = !lost;
+            if (&e == stunner) {
+                used = stun_slot;
+                walked = !e.facts().abilities[std::countr_zero(stun_slot)].excludes_walking;
+            } else if (!lost && blow(e, p).hits) {
+                used = best_cast(e, ready_slots(e, first), d);
+                if (used == 1u || used == 2u) walked = !e.facts().abilities[std::countr_zero(used)].excludes_walking;
+            }
+            total += strike_with(e, later & ~used).at(walked ? std::max(0, d - 1) : d) * blow_scale;
+        } else {
+            if (x.strike.reach < 0) continue;
+            if (x.asked != p) x.asked = p, x.near = possible_within(e, p, x.strike.reach);
+            if (!x.near) continue;
+            total += strike_with(e, later & ~best_cast(e, ready_slots(e, first), 0)).at(0) * blow_scale;
+        }
+    }
+    return total;
