+        const unsigned slot = a[0].stuns ? 1u : 2u;
+        // Over two turns before ours, the stun may follow a walk.
+        const int d = dist(p, acts_from(e)) - (turns >= 2 ? 1 : 0);
+        const float given = std::max(0.0f, b.damage - strike_with(e, slot).at(std::max(0, d))) * blow_scale;
+        if (!stunner || given < cost) stunner = &e, stun_slot = slot, cost = given;
