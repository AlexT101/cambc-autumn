+Trade Safety::duel(const ChampionBelief& a, const ChampionBelief& e, bool they_first) {
+    struct Memo {
+        std::uint32_t generation;
+        int a, e;
+        bool first;
+        Trade trade;
+    };
+    static std::array<Memo, 4> memo{};
+    static int next = 0;
+    for (const auto& m : memo)
+        if (m.generation == generation_ && m.a == a.index && m.e == e.index && m.first == they_first) return m.trade;
+    world_.throw_if_stale();
+    Side us, them;
+    fill(us, world_, world_.allies, 1u << a.index, made_);
+    // Both as at the turn's start, ours too: a slot spent on this turn's work is back within the duel,
+    // and the verdicts steer the next turns' steps, not this turn's casts.
+    fill(them, world_, world_.enemies, 1u << e.index, made_);
+    // Played out without our fall's early ends, which leave who kills whom unknown in a fight they cannot win.
+    const auto [ours, theirs] = simulate(us, them, they_first);
+    Trade t;
+    t.allies = us.count, t.enemies = them.count;
+    t.turns_to_kill_them = ours, t.turns_to_kill_us = theirs;
+    t.lost = t.self_falls = theirs > 0;
+    memo[static_cast<std::size_t>(next++ % 4)] = {generation_, a.index, e.index, they_first, t};
+    return t;
+}
