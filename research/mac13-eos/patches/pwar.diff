+// Diagnosis (debug only): our Prism with an enemy Prism believed within 10.
+void trace_prism_war(const World& world, Safety& safety) {
+    if (world.is_stale() || !world.me().alive || world.me().facts().passive != Passive::gem_focus) return;
+    const vec2 here = my_position(), start = world.turn_start;
+    if (here.x < 0) return;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus || e.pos_round < 0 || e.pos.x < 0) continue;
+        const int d0 = dist(start, e.pos), d1 = dist(here, e.pos);
+        if (std::min(d0, d1) > 10) continue;
+        int allies = 0, enemies = 0;
+        for (const auto& a : world.allies)
+            if (!a.is_self && a.alive && a.visible && dist(here, a.pos) <= 8) ++allies;
+        for (const auto& o : world.enemies)
+            if (o.alive && o.pos.x >= 0 && world.round - o.pos_round <= 2 && dist(here, o.pos) <= 8) ++enemies;
+        const bool leth1 = safety.lethal(here), leth0 = safety.lethal(start);
+        const auto t = safety.fight(here);
+        std::printf("PW %d %u %c %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d\n", world.round, my_handle(), static_cast<char>(decision),
+                    e.visible ? 1 : 0, world.round - e.pos_round, d0, d1, static_cast<int>(my_record().focus), static_cast<int>(e.focus),
+                    static_cast<int>(my_health()), static_cast<int>(my_max_health()), static_cast<int>(e.health), static_cast<int>(e.max_health),
+                    allies, enemies, leth0 ? 1 : 0, leth1 ? 1 : 0, t.enemies > 0 ? (t.lost ? 1 : 0) : -1, t.self_falls ? 1 : 0, turn_acts.casts[0], turn_acts.casts[1],
+                    turn_acts.walked ? 1 : 0, my_cooldown(0), std::max(0, e.ready_round[0] - world.round), std::max(0, e.ready_round[1] - world.round),
+                    static_cast<int>(my_gems()), e.gems, e.acted ? 1 : 0);
+    }
+}
