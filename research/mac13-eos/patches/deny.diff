+    const bool denied = static_cast<std::size_t>(g) < n.counting.size() && n.counting[static_cast<std::size_t>(g)];
+    std::printf("CONTEST START %d %u g%d denied %d branch %c gems %d\n", world.round, my_handle(), g, static_cast<int>(denied),
