+// A tribute channel turn's gems (tribute rule): smaller bags never bank (bankable_bag_now), so
+// they do not take their carrier off to an altar.
+constexpr int free_bag_gems = 10;
+
+// The pack around a target at p: the visible teammates within chasing_ally_radius of it, beyond the
+// fight's own roster (`key`), that are free to join. Each of them weighs the same fight with us in
+// it, so a won one is joined by all of them, each arriving after its walk (walk_allies_in). Not
+// Willow (she holds no fight), nor a teammate in a channel, holding a capture, banking a bag, or under
+// the recall line, which keep their own work. Only while we stand that near ourselves.
+std::uint32_t pack_joiners(const World& world, vec2 here, vec2 p, std::uint32_t key) {
+    constexpr int r = safety_params::chasing_ally_radius;
+    if (dist(here, p) > r) return 0;
+    std::uint32_t out = 0;
+    const auto& map = world.map();
+    for (std::size_t i = 0; i < world.allies.size() && i < 16; ++i) {
+        const auto& a = world.allies[i];
+        if (a.is_self || !a.alive || !a.visible || (key >> i & 1) || dist(a.pos, p) > r) continue;
+        if ((a.facts().heals() && world.round >= params::willow_fight_until) || held_by_channel(a)) continue;
+        if (a.health < params::recall_health_fraction * a.max_health) continue;
+        if (a.facts().passive != Passive::gem_focus && a.gems >= free_bag_gems) continue;
+        if (const int g = map.group_at(a.pos); g >= 0 && world.camps[g].state == CampState::cleared) continue;
+        out |= 1u << i;
+    }
+    return out;
+}
