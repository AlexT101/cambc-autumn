+// Lanchester's square law: a side's strength in a fight goes as its numbers squared. Every
+// champion's liveness is readable in or out of view, so both counts are known to all our bodies
+// (Cassi and Issac are two). Off our own ground a group is worth this times itself, below 1 when
+// outnumbered; 1 within the opening plan's horizon.
+float posture(const World& world) {
+    if (world.round <= params::open_plan::horizon) return 1.0f;
+    int us = 0, them = 0;
+    for (const auto& a : world.allies) us += a.alive;
+    for (const auto& e : world.enemies) them += e.alive;
+    const float ratio = static_cast<float>(us) / static_cast<float>(std::max(1, them));
+    return std::min(params::posture_cap, ratio * ratio);
+}
