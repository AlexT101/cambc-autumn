+            };
+            // The join's checks the loop left unread (too_late, the kited hits), read again as there.
+            // Short of the fuel for an altar field or a clear, refused.
+            const auto join_valid = [&](Valued& v) {
+                if (v.valid != 0) return v.valid > 0;
+                auto& known = group_facts[v.g];
+                if (known.to_altar < 0 && !fuel_ok(loop_reserve() + full_field_cost_estimate())) return false;
