+    std::vector<int> kited;  // groups kite() may own (farm's kited_of)
+    std::uint64_t kited_members = 0;
+    template <class Exposure, class Kited> [[gnu::noinline]] void read_map(const StaticMap& m, Exposure&& exposed, Kited&& is_kited) {
+        const int n = static_cast<int>(m.groups.size());
+        map = &m, lanes = (n + 3) & ~3;
+        for (auto* v : {&x, &y, &id, &gems, &pro_gems, &gold, &pro_gold, &off}) v->assign(lanes, 0);
+        for (auto* v : {&full, &exposure, &wait, &worth, &clear, &lo, &head}) v->assign(lanes, 0.0f);
+        marked.clear(), kited.clear(), kited_members = 0;
