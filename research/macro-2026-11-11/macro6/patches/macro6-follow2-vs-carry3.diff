+        for (int i = 0; i < valued_n; ++i) rivals += !valued[i].wins && !is_pick(valued[i]) && valued[i].value > 0 && valued[i].value <= pick_value;
+        auto& follow = follow_up;
+        const auto lanes = static_cast<std::uint64_t>(n_groups);
+        const std::uint64_t scan_cost = 15 * lanes + 300;
+        std::uint64_t spent = 0; // debug builds: the re-rank's fuel
+        (void)spent;
+        debug_block({ spent = fuel(); });
+        int scans = 0, changed = -1;
+        bool begun = false;
+        (void)scans, (void)begun;
+        // The map's columns read each group's exposure (its side: a decode ~150 a group) once a game;
+        // each kited group's plan may rebuild its stands, a board pass per member (~200, as warm_clears').
+        const std::uint64_t map_cost = follow.map == &map ? 0 : 350 * lanes + 3000;
+        std::uint64_t kite_members = follow.kited_members;
+        if (follow.map != &map)
+            for (const auto& G : groups) kite_members += G.members.size(); // before the list, every group's
+        const std::uint64_t kite_cost = 200 * kite_members;
+        if ((b >= 0 || to_share) && rivals > 0 && fuel_ok(loop_reserve() + 35 * lanes + 1500 + map_cost + kite_cost)) {
+            if (follow.map != &map) follow.read_map(map, exposure, kited_of);
+            // The next jobs: groups alive or respawning, not a Monolith, no ally claims, and neither
+            // kite() nor siege() keeps from farm.
+            follow.horizon = horizon;
+            follow.unmark();
+            world.each_cleared([&](int g) { follow.mark_off(g); });
+            world.each_respawning([&](int g) {
+                follow.mark_wait(g, std::max(0, camp_data[g].respawn_round - world.round));
+                return false;
+            });
+            for (int w = 0; w < 4; ++w)
+                for (auto bits = claimed_bits[w]; bits; bits &= bits - 1)
+                    if (const int g = 64 * w + std::countr_zero(bits); g < n_groups) follow.mark_off(g);
+            for (const int g : follow.kited)
+                if (camp_data[g].state != CampState::cleared && kite_owns(world, g)) follow.mark_off(g);
+            if (const int g = siege_declined(world); g >= 0 && g < n_groups) follow.mark_off(g);
