+                    float joint_rounds = 0;
+                    const float hits = v.kite_hits >= 0 ? v.kite_hits : soften * min_camp_damage(world, v.g, v.kite_output, &joint_rounds) * v.kite_scale;
+                    ok = !(hits > spare_health);
+                }
+                v.valid = ok ? 1 : -1;
