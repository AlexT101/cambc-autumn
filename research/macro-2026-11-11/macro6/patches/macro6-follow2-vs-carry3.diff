+            begun = true;
+            // δ for a job ending at its group after its rounds: its follow-ups fit in the rounds left,
+            // each at least the capture. A capture that wins has none.
+            const auto delta = [&](const Valued& v) {
+                const float limit = static_cast<float>(left) - v.rounds;
+                // Across a crystal hop, or out of a pocket, the crow's distances are no walk.
+                if (v.wins || limit < cap_rounds || in_pocket || (hop_any && map.group_hop(v.g) >= 0)) return 0.0f;
