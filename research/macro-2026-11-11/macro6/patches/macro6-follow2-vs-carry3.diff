+                else return after_loop(layers);
+            };
+            const float most = follow.most;
+            const auto may_rival = [&](const Valued& v) { return !v.wins && !is_pick(v) && v.value > 0 && v.value <= pick_value && lift(v, most) > pick_value; };
+            bool any = false;
+            for (int i = 0; i < valued_n; ++i) any = any || may_rival(valued[i]);
+            if (most > 0 && any && fuel_ok(loop_reserve() + scan_cost)) {
+                float won = pick ? lift(*pick, delta(*pick)) : pick_value;
+                Valued* winner = nullptr;
+                for (int i = 0; i < valued_n; ++i) {
+                    Valued& v = valued[i];
+                    if (!may_rival(v) || !(lift(v, most) > won)) continue;
+                    if (!fuel_ok(loop_reserve() + scan_cost)) break;
+                    if (const float value = lift(v, delta(v)); value > won && (v.own || join_valid(v)) && fuel_ok(reserve_for(v))) won = value, winner = &v;
+                }
+                changed = 0;
+                if (winner) {
+                    changed = 1;
+                    const Valued& w = *winner;
+                    debug_block({
+                        std::printf("FOLLOW2 CHANGE %d %u g%d%c %.4f over g%d%c %.4f (adj %.4f) delta-most %.3f rho %.4f\n", round, my_handle(), w.g,
+                                    w.own ? 'o' : 'j', w.value, to_share ? shared : b, to_share ? 'j' : pick ? 'o' : 'x', pick_value, won, most, follow.rho);
+                    });
+                    // The value with δ stays above the other kind's, so the pick below commits it.
+                    if (w.own) best = w.g, best_value = won, best_steps = w.steps, best_spell = w.spell, best_priced = w.priced;
+                    else shared = w.g, shared_value = won, shared_steps = w.steps, shared_priced = w.priced;
+                }
+            }
+        }
+        debug_block({
+            auto& s = follow_stats;
+            spent -= fuel();
+            if (rivals > 0) ++s.rivalled;
+            if (changed >= 0) ++s.weighed, s.changed += changed, s.scans += scans;
+            s.fuel += static_cast<double>(spent);
+            if (spare_out) evict(spare), spare_out = false;
+            if (begun && evicted_value >= 0 && evicted_value + follow.most * evicted_lift > pick_value) ++s.missed;
+            if (round - s.last >= 50) {
+                s.last = round;
+                std::printf("FOLLOW2 SUM %d %u %c turns %d rivalled %d weighed %d changed %d scans %d missed %d fuel %.0f\n", round, my_handle(),
+                            opening ? 'O' : repricing ? 'R' : 'L', s.turns, s.rivalled, s.weighed, s.changed, s.scans, s.missed, s.fuel);
+            }
         });
     }
     if (banks_bag && (best < 0 || best_value <= from_altar_value)) return false;
