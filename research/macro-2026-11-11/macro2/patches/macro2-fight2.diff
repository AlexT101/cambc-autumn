diff -ruN -x .cambc -x compile_commands.json ocean-ref-b7c87cf/src/combat/skirmish.cc macro2-fight2/src/combat/skirmish.cc
--- ocean-ref-b7c87cf/src/combat/skirmish.cc	1970-01-01 00:00:00.000000000 +0000
+++ macro2-fight2/src/combat/skirmish.cc	2026-11-11 03:41:09.907386778 +0000
@@ -0,0 +1,229 @@
+// The skirmish verdict: one fight for every ally present against every enemy present, worked out by
+// the first member to act in a round and posted (comms::FightPost) for the members acting after it,
+// so that a group the fight favours stays and strikes together.
+// Each champion's own verdicts (want_home's stand, prey's chase, the step guard) see only the allies
+// near its own tile, so allies in one skirmish could reach opposite ones.
+//
+// The fight is Safety::skirmish_fight's, judged by net kills (a kill is worth about what a death
+// costs): engage when we take more than we lose even when they strike first. Otherwise there is no
+// verdict, and each member decides alone as before. The focus is the enemy that fight fells first.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+struct SkirmishTurn {
+    int round = -1;
+    comms::Verdict verdict = comms::Verdict::none;
+    int focus = -1;
+    std::uint32_t members = 0, enemies = 0;
+    bool member = false; // the verdict binds us this turn
+    bool posted = false; // we worked it out
+};
+SkirmishTurn sk_turn;
+
+// The engaged verdict we last posted, for its outcome trace at our next turn.
+struct SkirmishPosted {
+    int round = -1, focus = -1;
+    std::uint32_t members = 0;
+};
+SkirmishPosted sk_posted;
+
+// The engaging verdict that last bound us (its round and focus), for its hysteresis.
+struct SkirmishHeld {
+    int round = -1, focus = -1;
+};
+SkirmishHeld sk_held;
+
+// An ally that fights where it stands: not held by a tribute or a teleport, nor a healer past its
+// early fights, whose own judgement sends it home from any enemy (want_home).
+bool fights(const World& world, const ChampionBelief& a) {
+    if (a.facts().heals() && world.round >= params::willow_fight_until) return false;
+    return a.alive && (a.is_self || (a.visible && a.channel != Channel::tribute && !a.teleport_pending()));
+}
+
+bool members_alive(const World& world, std::uint32_t members) {
+    for (auto left = members; left; left &= left - 1) {
+        const auto i = static_cast<std::size_t>(std::countr_zero(left));
+        if (i >= world.allies.size() || !world.allies[i].alive) return false;
+    }
+    return true;
+}
+
+// Visible and alive now, after any hits this turn.
+bool live_in_sight(const ChampionBelief& e) { return e.alive && e.visible && visible_record(e.handle) != nullptr; }
+
+// The roster: us and the allies near us (Safety's fight square), the enemies that could strike any
+// of them before our next turn (the credible unseen too) or that any of them could strike this
+// turn, then the allies those enemies could strike or be struck by.
+std::uint32_t skirmish_key(const World& world, Safety& safety) {
+    const vec2 here = my_position();
+    std::uint32_t allies = 0;
+    for (auto left = safety.fight_allies(here); left; left &= left - 1)
+        if (fights(world, world.allies[static_cast<std::size_t>(std::countr_zero(left))])) allies |= 1u << std::countr_zero(left);
+    const auto tile = [&](const ChampionBelief& a) { return a.is_self ? here : a.pos; };
+    const auto turn = [&](const ChampionBelief& a) { return a.is_self ? world.round : next_turn_round(world, a); };
+    std::uint32_t enemies = 0;
+    for (auto left = allies; left; left &= left - 1) {
+        const auto& a = world.allies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (const auto key = safety.fight_key(tile(a)); key != Safety::no_fight) enemies |= key >> 16;
+        const auto& s = strike(a, turn(a));
+        for (const auto& e : world.enemies)
+            if (e.alive && e.visible && s.hits(dist(tile(a), e.pos))) enemies |= 1u << e.index;
+    }
+    std::uint32_t seen = 0;
+    for (auto left = enemies; left; left &= left - 1)
+        if (const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))]; e.visible) seen |= 1u << e.index;
+    if (!seen) return Safety::no_fight;
+    for (const auto& a : world.allies) {
+        if (a.is_self || (allies >> a.index & 1) || !fights(world, a)) continue;
+        bool in = false;
+        const auto& s = strike(a, turn(a));
+        for (auto left = seen; left && !in; left &= left - 1)
+            in = s.hits(dist(a.pos, world.enemies[static_cast<std::size_t>(std::countr_zero(left))].pos));
+        if (!in)
+            if (const auto key = safety.fight_key(a.pos); key != Safety::no_fight) in = (key >> 16 & seen) != 0;
+        if (in) allies |= 1u << a.index;
+    }
+    return allies | enemies << 16;
+}
+
+void trace_outcome(const World& world) {
+    if (sk_posted.round < 0) return;
+    debug_block({
+        const auto& e = world.enemies[static_cast<std::size_t>(sk_posted.focus)];
+        int alive = 0;
+        for (auto left = sk_posted.members; left; left &= left - 1)
+            alive += world.allies[static_cast<std::size_t>(std::countr_zero(left))].alive;
+        std::printf("SKO %d %u %d %d %d %.2f %d/%d\n", world.round, my_handle(), sk_posted.round, sk_posted.focus, e.alive ? 1 : 0,
+                    e.alive && e.visible ? e.health / std::max(1.0f, e.max_health) : -1.0f, alive, std::popcount(sk_posted.members));
+    });
+    sk_posted.round = -1;
+}
+
+void skirmish_verdict(const World& world, Safety& safety) {
+    world.throw_if_stale();
+    sk_turn = {};
+    sk_turn.round = world.round;
+    if (!world.me().alive) return;
+    trace_outcome(world);
+    // A tribute's channel is kept or cancelled by its own judgement (continue_tribute), and a
+    // teleport holds us: such a turn neither follows nor posts.
+    if (const auto state = my_state(); state.contains(cambc::champion_state::submitting_gems) || state.contains(cambc::champion_state::teleporting))
+        return;
+    if (!enemy_seen(world)) return;
+    const int me = world.me().index;
+    comms::FightPost post;
+    // An engaging post binds only a member that sees its focus (vision is each champion's own):
+    // without it, its retreat lines would go with no fight to join. Such a member decides alone.
+    const auto sees_focus = [&] {
+        if (post.focus < 0 || post.focus >= static_cast<int>(world.enemies.size())) return false;
+        const auto& e = world.enemies[static_cast<std::size_t>(post.focus)];
+        return live_in_sight(e) && !test(world.map().near_enemy_spawn, e.pos);
+    };
+    if (comms::fight_post(world, post) && (post.members >> me & 1) && members_alive(world, post.members)) {
+        if (post.verdict == comms::Verdict::engage && !sees_focus()) {
+            debug_block({ std::printf("SKF %d %u e %d %u\n", world.round, my_handle(), post.focus, post.members); });
+            return;
+        }
+        sk_turn.verdict = post.verdict, sk_turn.focus = post.focus, sk_turn.members = post.members, sk_turn.member = true;
+        if (post.verdict == comms::Verdict::engage) sk_held = {world.round, post.focus};
+        debug_block({ std::printf("SKF %d %u %c %d %u\n", world.round, my_handle(), "-NED"[static_cast<int>(post.verdict)], post.focus, post.members); });
+        return;
+    }
+    // Most turns with an enemy in sight have no group within its reach: only distances and the
+    // cached fight square are read before the roster's fight keys and walks.
+    {
+        const vec2 here = my_position();
+        std::uint32_t near = 0;
+        for (auto left = safety.fight_allies(here); left; left &= left - 1)
+            if (fights(world, world.allies[static_cast<std::size_t>(std::countr_zero(left))])) near |= 1u << std::countr_zero(left);
+        if (std::popcount(near) < 2) return;
+        bool reach = false;
+        for (const auto& e : world.enemies) {
+            if (reach) break;
+            if (!e.alive || !e.visible) continue;
+            // A visible teleport strikes from where it lands (Safety's blows).
+            const vec2 from = e.teleport_pending() && in_bounds(e.tp_dest) ? e.tp_dest : e.pos;
+            for (auto left = near; left && !reach; left &= left - 1) {
+                const auto& a = world.allies[static_cast<std::size_t>(std::countr_zero(left))];
+                reach = std::min(dist(a.is_self ? here : a.pos, e.pos), dist(a.is_self ? here : a.pos, from)) <= Strike::max_reach;
+            }
+        }
+        if (!reach) return;
+    }
+    if (!fuel_ok(safety.fight_cost_estimate() + search_reserve)) {
+        note_shortcut("skirmish-fuel");
+        return;
+    }
+    const auto key = skirmish_key(world, safety);
+    // Alone, our own verdicts are already one judgement: the shared one is for a group.
+    if (key == Safety::no_fight || std::popcount(key & 0xFFFFu) < 2) return;
+    // The enemies who walk into reach of any of us in time join, as in prey's fights: the soonest walk each.
+    std::uint32_t late = 0;
+    for (auto left = key & 0xFFFFu; left; left &= left - 1) {
+        const auto& a = world.allies[static_cast<std::size_t>(std::countr_zero(left))];
+        const auto l = safety.late(a.is_self ? my_position() : a.pos, key);
+        for (int j = 0; j < 16; ++j)
+            if (const auto w = l >> 2 * j & 3, had = late >> 2 * j & 3; w && (!had || w < had))
+                late = (late & ~(3u << 2 * j)) | w << 2 * j;
+    }
+    // A kill is worth about what a death costs: engage on net kills, which must hold even when they
+    // strike first. One engaged last round stays while its focus is in sight and the fight is not
+    // lost on net: a fight under way is not dropped for a turn's walk-in delays.
+    const auto hold = safety.skirmish_fight(key, true, late);
+    const auto usable = [&](int i) {
+        if (i < 0 || i >= static_cast<int>(world.enemies.size())) return false;
+        const auto& e = world.enemies[static_cast<std::size_t>(i)];
+        // On its spawn's edge it heals at its every turn end, which the fight does not count.
+        return live_in_sight(e) && !test(world.map().near_enemy_spawn, e.pos);
+    };
+    const bool kept = sk_held.round == world.round - 1 && usable(sk_held.focus) && (key >> 16 >> sk_held.focus & 1);
+    comms::Verdict verdict = comms::Verdict::none;
+    int focus = -1;
+    if (hold.theirs_lost > hold.ours_lost && usable(hold.fallen)) verdict = comms::Verdict::engage, focus = hold.fallen;
+    else if (kept && hold.played && hold.theirs_lost >= hold.ours_lost) verdict = comms::Verdict::engage, focus = sk_held.focus;
+    sk_turn.verdict = verdict, sk_turn.focus = focus;
+    sk_turn.members = key & 0xFFFFu, sk_turn.enemies = key >> 16;
+    sk_turn.member = sk_turn.posted = true;
+    comms::post_fight(world, {verdict, focus, sk_turn.members});
+    if (verdict == comms::Verdict::engage) sk_posted = {world.round, focus, sk_turn.members}, sk_held = {world.round, focus};
+    debug_block({
+        // Pooled health, ours and the visible enemies', for the share the engagement study buckets by.
+        float ours = 0, theirs = 0;
+        for (auto left = sk_turn.members; left; left &= left - 1)
+            if (const auto& a = world.allies[static_cast<std::size_t>(std::countr_zero(left))]; a.is_self) ours += my_health();
+            else ours += a.health;
+        for (auto left = sk_turn.enemies; left; left &= left - 1)
+            if (const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))]; e.visible) theirs += e.health;
+        std::printf("SKV %d %u %c %d %u %u %u tf %d %d %d-%d kept %d hp %d %d\n", world.round, my_handle(), "-NED"[static_cast<int>(verdict)], focus,
+                    sk_turn.members, sk_turn.enemies, late, hold.ours, hold.theirs, hold.theirs_lost, hold.ours_lost, kept ? 1 : 0,
+                    static_cast<int>(ours), static_cast<int>(theirs));
+    });
+}
+
+// Willow holds no fight but early (willow_early): its own judgement keeps it.
+bool skirmish_binds(const World& world) {
+    return sk_turn.round == world.round && sk_turn.member && world.me().alive && (!world.me().facts().heals() || willow_early(world));
+}
+
+bool skirmish_engaged(const World& world) { return skirmish_binds(world) && sk_turn.verdict == comms::Verdict::engage; }
+
+const ChampionBelief* skirmish_focus(const World& world) {
+    if (!skirmish_engaged(world) || sk_turn.focus < 0) return nullptr;
+    const auto& e = world.enemies[static_cast<std::size_t>(sk_turn.focus)];
+    return live_in_sight(e) && !test(world.map().near_enemy_spawn, e.pos) ? &e : nullptr;
+}
+
+void skirmish_trace(const World& world) {
+    if (sk_turn.round != world.round || !sk_turn.member) return;
+    debug_block({
+        std::printf("SKA %d %u %c %d %c %d\n", world.round, my_handle(), "-NED"[static_cast<int>(sk_turn.verdict)], sk_turn.focus,
+                    static_cast<char>(decision), sk_turn.posted ? 1 : 0);
+    });
+}
+
+} // namespace
+
+} // namespace aph
