+    float sum = 0;
+    for (int s = 0; s < ability_cooldown; ++s)
+        if (k.when[ally][s] > world.round - ability_cooldown) sum += k.loss[ally][s];
+    return sum / static_cast<float>(ability_cooldown);
+}
+
+// The tank of a crew's clear of a's claimed group: two or more allies we see claim it, and a has
+// crew_tank's best tank_score among them (us aside: Willow keeps out of reach). Its live members' hits.
+float planned_fire(const World& world, const ChampionBelief& a) {
+    const int g = comms::claim_of(world, a.index);
+    const auto& map = world.map();
+    if (g < 0 || g >= static_cast<int>(map.groups.size()) || map.groups[g].strength <= 0 || world.camps[g].state != CampState::alive
+        || (map.shared_gems && big_group(map.groups[g])))
+        return 0;
+    int claimers = 0;
+    const float score = tank_score(a);
+    for (const auto& b : world.allies) {
+        if (b.is_self || !b.alive || !b.visible || comms::claim_of(world, b.index) != g) continue;
+        ++claimers;
+        if (&b != &a && (tank_score(b) > score || (tank_score(b) == score && b.index < a.index))) return 0;
+    }
+    if (claimers < 2) return 0;
+    const auto& G = map.groups[g];
+    float fire = 0;
+    for (std::size_t i = 0; i < G.members.size(); ++i)
+        if (world.camps[g].health[i] > 0) fire += G.members[i].strength;
+    return fire * a.camp_taken;
