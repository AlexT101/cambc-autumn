+// Our Prism's stun is its one answer to an enemy Prism's burst, and a slot cast now is back only
+// after ability_cooldown rounds: while an enemy Prism could walk (a step a turn) into ability range
+// of us by then, the stun stays off camps. Untracked, it is within a step a round of its last tile.
+bool stun_reserved(const World& world) {
+    if (world.me().type != cambc::champion_type::prism) return false;
+    const vec2 here = my_position();
+    constexpr int far = ability_range + ability_cooldown;
+    for (const auto& e : world.enemies)
+        if (e.alive && e.type == cambc::champion_type::prism
+            && (e.visible   ? dist(here, e.pos) <= far
+                : e.tracked ? possible_within(e, here, far)
+                            : dist(here, e.pos) - e.age(world.round) <= far))
+            return true;
+    return false;
+}
