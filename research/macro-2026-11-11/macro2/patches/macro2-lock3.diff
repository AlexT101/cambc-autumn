diff -ruN -x .cambc -x compile_commands.json ocean-ref-b7c87cf/src/economy/lockout.cc macro2-lock3/src/economy/lockout.cc
--- ocean-ref-b7c87cf/src/economy/lockout.cc	1970-01-01 00:00:00.000000000 +0000
+++ macro2-lock3/src/economy/lockout.cc	2026-11-11 06:04:20.060799921 +0000
@@ -0,0 +1,197 @@
+// Lockouts: while every altar our bags could use carries an enemy lock, the team's score rate is
+// zero. A carrier ref's banking walked up to a lock stays and hits it until it breaks.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// The tiles a champion of attack range r hits the altar's lock from (it must see it), and their field.
+const Field* lock_stands(const World& world, Pathing& pathing, int a, int r) {
+    static std::vector<std::array<std::optional<Field>, 2>> fields;
+    static std::vector<std::array<bool, 2>> built;
+    const auto& map = world.map();
+    if (fields.size() < map.altars.size()) fields.resize(map.altars.size()), built.resize(map.altars.size(), {false, false});
+    const int k = r > melee_range ? 1 : 0;
+    auto& f = fields[static_cast<std::size_t>(a)][static_cast<std::size_t>(k)];
+    if (!built[static_cast<std::size_t>(a)][static_cast<std::size_t>(k)]) {
+        if (!fuel_ok(end_reserve + full_field_cost_estimate())) return nullptr; // built on a later turn
+        built[static_cast<std::size_t>(a)][static_cast<std::size_t>(k)] = true;
+        static bitboard goals{cambc::uninitialized};
+        map.viewers_into(map.altars[static_cast<std::size_t>(a)].pos, r, goals);
+        goals &= map.standable;
+        if (!board_empty(goals)) f.emplace(make_field(pathing.static_walls(), goals));
+    }
+    return f ? &*f : nullptr;
+}
+
+// The ally's bag as seen, else as posted.
+int ally_bag(const World& world, const ChampionBelief& a) {
+    if (a.is_self) return static_cast<int>(my_gems());
+    return a.visible ? a.gems : comms::bag_of(world, a.index);
+}
+
+// Willow stays with her mate while ocean's support code has one alive for her.
+bool support_bound(const World& world, const ChampionBelief& a) {
+    if (!support_healer(a)) return false;
+    const auto pair = support_pair(world);
+    return pair[0] && pair[0]->alive;
+}
+
+bool lock_believed(const World& world, int a, int& hits) {
+    const auto& b = world.altars[static_cast<std::size_t>(a)];
+    const int full = static_cast<int>(cambc::constants::altar_lock_hits);
+    int shared = -1, shared_hits = 0;
+    const bool posted = comms::shared_lock(shared, shared_hits) && shared == a;
+    if (b.enemy_lock) {
+        hits = b.enemy_lock_hits > 0 ? b.enemy_lock_hits : full;
+        // A teammate's later sighting of an altar we no longer see counts its hits since.
+        if (posted && b.seen_round < world.round) hits = std::min(hits, shared_hits);
+        return true;
+    }
+    // A teammate's sighting, unless we see the altar unlocked this round.
+    if (posted && b.seen_round < world.round) {
+        hits = shared_hits;
+        return true;
+    }
+    return false;
+}
+
+bool altar_reached(const World& world, Pathing& pathing, int a) {
+    if (altar_steps(world, pathing, my_position(), a) != unreachable) return true;
+    for (const auto& h : world.map().hops())
+        if (h.altar == a) return true;
+    return altar_steps(world, pathing, recall_landing(world), a) != unreachable;
+}
+
+const Lockout& lockout(const World& world, Pathing& pathing) {
+    static Lockout lo;
+    static int round = -1;
+    static std::uint32_t seen = 0;
+    if (round == world.round && seen == world.observations) return lo;
+    round = world.round, seen = world.observations;
+    lo = {};
+    const auto& map = world.map();
+    const int n = static_cast<int>(map.altars.size());
+    if (n == 0 || !world.me().alive || my_position().x < 0) return lo;
+    // Most turns: no lock believed anywhere.
+    std::array<int, 16> hits{};
+    bool any = false;
+    for (int a = 0; a < n && a < static_cast<int>(hits.size()); ++a) {
+        hits[static_cast<std::size_t>(a)] = 0;
+        int h = 0;
+        if (lock_believed(world, a, h)) hits[static_cast<std::size_t>(a)] = h, any = true;
+    }
+    if (!any || n > static_cast<int>(hits.size())) return lo;
+    int team_gems = 0;
+    for (const auto& a : world.allies)
+        if (a.alive) team_gems += ally_bag(world, a);
+    if (team_gems <= 0) return lo;
+    bool reached = false;
+    for (int a = 0; a < n; ++a) {
+        if (!altar_reached(world, pathing, a)) continue;
+        if (hits[static_cast<std::size_t>(a)] == 0) return lo; // an unlocked altar banks
+        reached = true;
+    }
+    if (!reached) return lo;
+    // The roster: allies that can walk up and hit, nearest first. Team cost of a lock: the k-th
+    // nearest's walk plus the ceil(hits / k) turns k of them hit it in, at the best k.
+    struct Body {
+        int steps, index;
+    };
+    std::array<Body, 8> roster;
+    int best_cost = unreachable;
+    for (int a = 0; a < n; ++a) {
+        const int h = hits[static_cast<std::size_t>(a)];
+        if (h == 0 || !altar_reached(world, pathing, a)) continue;
+        int m = 0;
+        for (const auto& c : world.allies) {
+            if (!c.alive || m == static_cast<int>(roster.size()) || support_bound(world, c)) continue;
+            if (c.is_self ? channel_held() : held_by_channel(c)) continue;
+            const vec2 p = c.is_self ? my_position() : c.pos;
+            if (!in_bounds(p)) continue;
+            const Field* f = lock_stands(world, pathing, a, c.facts().attack_range());
+            const int s = f ? f->at(p) : unreachable;
+            if (s != unreachable) roster[static_cast<std::size_t>(m++)] = {s, c.index};
+        }
+        if (m == 0) continue;
+        std::sort(roster.begin(), roster.begin() + m, [](const Body& x, const Body& y) { return x.steps != y.steps ? x.steps < y.steps : x.index < y.index; });
+        int cost = unreachable;
+        for (int k = 1; k <= m; ++k) cost = std::min(cost, roster[static_cast<std::size_t>(k - 1)].steps + (h + k - 1) / k);
+        if (cost >= best_cost) continue;
+        best_cost = cost;
+        lo.altar = a, lo.hits = h;
+    }
+    lo.active = lo.altar >= 0;
+    return lo;
+}
+
+// A breaker's turn: a carrier whose bank walk (ref's: its bag, its altar) has brought it to a stand
+// of that altar's lock hits it there every turn, rather than leave between hits. Anyone else banks
+// or farms as ref does.
+bool break_lockout(World& world, Pathing& pathing, Safety& safety, Memory& memory) {
+    if (!banks_bag(world, pathing)) return false;
+    const auto& lo = lockout(world, pathing);
+    if (!lo.active) return false;
+    int steps = unreachable, hits = 0;
+    const int a = bank_walk_altar(world, pathing, memory, steps);
+    const auto& f = world.me().facts();
+    const Field* stands = a >= 0 ? lock_stands(world, pathing, a, f.attack_range()) : nullptr;
+    const bool locked = a >= 0 && lock_believed(world, a, hits);
+    // A hop that beats the walk takes a bag with a crystal elsewhere (bank_gems).
+    if (!locked || !stands || stands->at(my_position()) != 0 || (carries_crystal() && hop_route(world, pathing, memory).steps < steps)) {
+        debug_block({ std::printf("SIEGE %d %u %d wait %d\n", world.round, my_handle(), locked ? a : lo.altar, locked ? hits : lo.hits); });
+        return false;
+    }
+    decision = Branch::lock_siege;
+    memory.claim = -1;
+    debug_block({ std::printf("SIEGE %d %u %d breaker %d\n", world.round, my_handle(), a, hits); });
+    // From a stand a hit needs no walk; with the attack spent we still stay. A breaking hit within
+    // reach tributes at once, as bank_gems does.
+    if (break_lock(world, a)) submit_here(world, safety, memory);
+    return true;
+}
+
+// Our sighting for the team's lock record: the lock we see at its altar (or clearing it, seen
+// without one), else the first enemy lock we see when the record is empty.
+void post_lock_sighting(const World& world) {
+    comms::post_lock(-2, 0);
+    if (!world.me().alive || world.is_stale()) return;
+    const vec2 here = my_position();
+    if (here.x < 0) return;
+    const auto& altars = world.map().altars;
+    // world.visible is as of the turn's start; the lock read below is from where we stand now.
+    const auto sees = [&](int a) {
+        const vec2 p = altars[static_cast<std::size_t>(a)].pos;
+        return (here == world.turn_start && test(world.visible, p)) || dist(here, p) <= 1;
+    };
+    namespace raw = cambc::detail;
+    std::uint32_t count{};
+    ok(raw::sdk_altar_locks(nullptr, 0, &count));
+    static std::vector<raw::altar_lock_info> locks;
+    if (locks.size() < count) locks.resize(count);
+    if (count > 0) ok(raw::sdk_altar_locks(locks.data(), count, &count));
+    const auto own = static_cast<std::uint32_t>(raw::cached_my_team);
+    const auto enemy_at = [&](int a) -> int {
+        const vec2 p = altars[static_cast<std::size_t>(a)].pos;
+        for (std::uint32_t i = 0; i < count && i < locks.size(); ++i)
+            if (locks[i].team != own && locks[i].x == p.x && locks[i].y == p.y) return static_cast<int>(locks[i].hits_remaining);
+        return 0;
+    };
+    int shared = -1, hits = 0;
+    if (comms::shared_lock(shared, hits)) {
+        if (!sees(shared)) return;
+        const int left = enemy_at(shared);
+        comms::post_lock(left > 0 ? shared : -1, left);
+        if (left > 0) return;
+    }
+    for (std::uint32_t i = 0; i < count && i < locks.size(); ++i) {
+        if (locks[i].team == own) continue;
+        const int a = world.map().altar_at({locks[i].x, locks[i].y});
+        if (a >= 0) return comms::post_lock(a, static_cast<int>(locks[i].hits_remaining));
+    }
+}
+
+} // namespace
+
+} // namespace aph
