+// Our Prism against each visible enemy Prism within vision at our turn's end: its burst on our tile
+// before our next turn, our health, our stun and whether Safety calls the tile lethal.
+void trace_duel(const World& world, Safety& safety) {
+    if (!world.me().alive || world.me().type != cambc::champion_type::prism) return;
+    const vec2 here = my_position();
+    if (here.x < 0) return;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible || e.type != cambc::champion_type::prism || dist(here, e.pos) > vision_radius) continue;
+        std::printf("DUEL %d %u %d %.0f %.0f %d %d %d %d %d\n", world.round, my_handle(), dist(here, e.pos), safety.blow(e, here).damage,
+                    my_health(), static_cast<int>(my_cooldown(0) == 0), my_gems(), static_cast<int>(e.gems),
+                    turns_before_ours(world, e), static_cast<int>(safety.lethal(here)));
+    }
+}
+
