+// Two turns cast both slots, one a turn (rules turn.cast): a slot ready on the first (`first`) and the
+// other by the second (`second`), each turn with its basic attack, raising `out` to that sum. `moved`:
+// the first turn acts from where it ends (moved_strike's).
+void add_two_casts(const ChampionBelief& c, unsigned first, unsigned second, bool moved, Strike& out) {
+    const auto& f = c.facts();
+    for (unsigned a = 0; a < 2; ++a) {
+        const unsigned b = 1 - a;
+        if (!(first >> a & 1) || !(second >> b & 1)) continue;
+        const Strike one = moved ? compute_strike(f, hit_strength(c), hit_focus(c), 1u << a, true) : strike_slots(c, 1u << a).value;
+        const Strike& two = strike_slots(c, 1u << b).value;
+        for (int d = 0; d <= std::min({one.reach, two.reach, out.reach}); ++d) out.damage[d] = std::max(out.damage[d], one.at(d) + two.at(d));
+    }
+}
