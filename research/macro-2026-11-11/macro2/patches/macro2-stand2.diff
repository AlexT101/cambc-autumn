+bool Safety::roster_strikes_first(const StandRoster& r, vec2 p) {
+    if (r.key == no_fight) return false;
+    // We strike an arrival on our turn only if our reach covers where it strikes from.
+    const int ours = strike(world_.me(), world_.round + 1).reach;
+    for (auto left = r.key >> 16 & threat_mask_; left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
