+// The farthest c can strike on its turn in `round` at no cost to that turn: from where it stands,
+// and a melee champion's basic attacks after its walk too (rules turn.melee); -1 if nothing.
+static int standing_reach(const ChampionBelief& c, int round) {
+    auto& m = strike_memo(c, round);
+    if (m.value.reach < 0) return -1;
+    if (!m.standing_known) m.standing_known = true, m.standing = compute_strike(c.facts(), hit_strength(c), hit_focus(c), m.slots, true);
+    const auto& f = c.facts();
+    return f.ranged ? m.standing.reach : std::max(m.standing.reach, f.basic_reach() + 1);
+}
