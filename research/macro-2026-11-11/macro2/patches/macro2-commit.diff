+// Farm's commitment: what its choice was made on, to drop that choice only once some of it changes.
+// rate() is a ratio, so a near small group can overtake a far big one as both come a round nearer:
+// held to, that drift no longer throws away the walk made.
+struct CommitGroup {
+    std::uint32_t version = 0;
+    int respawn_round = -1;
+    CampState state = CampState::alive;
+    std::int8_t holder = 0;                 // 0 none, 1 ours, 2 theirs
+    std::uint8_t enemies = 0, claimers = 0; // bit i: enemies[i] in sight near it, allies[i] claiming it
+};
+struct FarmCommit {
+    int target = -1; // the choice the reading is for
+    int walked = -1; // the last round it was chosen, walked on to or stood by
+    // A group passed over only because the choice was kept keeps its older reading.
+    std::vector<CommitGroup> groups;
+    std::uint8_t enemies = 0; // in sight near us
+    std::array<int, 8> claims{};
+    std::array<std::uint8_t, 8> seen{}; // alive | visible << 1
+    // The sitting choice's value, else -1: with nothing new it only rises, so a fall is news missed.
+    float value = -1;
+    float health = 0, max_health = 0, line = 0;
+    std::uint32_t context = 0, clearing = 0, gold_context = 0;
+    int planned = -1;
+    bool pull = false, recall_out = false, partner = false;
+};
+FarmCommit& farm_commit() {
+    static FarmCommit commit;
+    return commit;
+}
+// news_moves may move a choice; the rest only trace. A return on schedule is no news: a respawning
+// group is priced as the live one it becomes.
+enum CommitNews : unsigned {
+    news_gap = 1, news_old = 2, news_new = 4, news_claim = 8, news_crew = 16, news_enemy = 32, news_self = 64,
+    news_pull = 128, news_drop = 256, news_unpriced = 512, news_moves = 1023,
+    trace_return = 1024, trace_price = 2048, trace_partial = 4096,
+};
+constexpr const char* news_names[] = {"gap", "old", "new", "claim", "crew", "enemy", "self", "pull", "drop", "unpriced", "return", "price", "partial"};
+std::int8_t holder_code(const CampBelief& c) { return !c.holder ? 0 : *c.holder == team::ally ? 1 : 2; }
+// The state part of a group's news: 0 as read, 1 changed, 2 back on schedule (returned at its round,
+// asleep at full health).
+int group_news(const CommitGroup& was, const CampBelief& now, const CampGroup& G, int round) {
+    if (was.version == now.version && was.respawn_round == now.respawn_round && was.state == now.state && was.holder == holder_code(now))
+        return 0;
+    if (was.state != CampState::respawning || now.state != CampState::alive || round < was.respawn_round || now.awake == Awake::awake)
+        return 1;
+    for (std::size_t i = 0; i < G.members.size(); ++i)
+        if (!(now.health[i] >= G.members[i].max_health)) return 1;
+    return 2;
+}
