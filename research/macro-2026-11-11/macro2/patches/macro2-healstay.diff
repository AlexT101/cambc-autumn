+    const int horizon = state.contains(cambc::champion_state::recalling) ? static_cast<int>(my_channel_time()) : me.recall_turns();
+    for (const auto& h : world.allies) {
+        if (h.is_self || !h.facts().heals()) continue;
+        float amount = 0;
+        int wait = heal_ready_in(world, h, horizon, amount);
+        if (wait < 0) return 0; // a team drafts one healer
+        // Having acted this round, her cooldown ticks again only at her next turn's end.
+        if (h.acted && wait > 0 && ++wait > horizon) return 0;
+        const int range = h.facts().abilities[h.facts().slot_of(AbilityKind::heal)].range(), d = dist(here, h.pos);
+        // She steps at most once to heal (heal_views): in range she must see us now; a step away, she
+        // must think the step worth it, and a bush hides us from her outside our cluster.
+        if (d > range + 1) return 0;
+        if (d <= range) {
+            const auto viewers = attack_viewers(world, here, std::min(range, Reach::Window::radius));
+            const int x = h.pos.x - here.x, y = h.pos.y - here.y;
+            if (!static_cast<bool>(viewers & Reach::Window::bit(Reach::Window::at(x, y)))) return 0;
+        } else if (test(world.map().bushes, here) || !worth_healing(amount, std::min(amount, missing), my_health() / my_max_health())) {
+            return 0;
+        }
+        const HealTarget mine{&me, here, std::min(amount, missing), my_health() / my_max_health(),
+                              heal_value(world, me, here, std::min(amount, missing), my_max_health())};
+        const auto pair = support_pair(world);
