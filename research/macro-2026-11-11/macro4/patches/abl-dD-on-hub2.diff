+float carry_premium(const World& world, const ChampionBelief& c) {
+    if (c.facts().passive != Passive::gem_focus) return 0;
+    // One Prism kit, and the premium reads only the round and our race: once a round.
+    static int round = -1;
+    static float rho = 0;
+    if (round != world.round) round = world.round, rho = hub_premium(world, c.facts());
+    return rho;
+}
+
+float bag_worth(const World& world, const ChampionBelief& c) {
+    const int gems = pair_gems(world, c);
+    return gems <= 0 ? 0.0f : params::gem_value * static_cast<float>(gems) * (1.0f + carry_premium(world, c));
+}
+
+bool fall_outweighs(const World& world, std::uint32_t enemies) {
+    const int bag = bag_at_stake(world);
+    if (bag <= 0) return false;
+    const float ours = params::gem_value * static_cast<float>(bag) * (1.0f + carry_premium(world, world.me()));
+    float theirs = params::life_value;
+    for (auto left = enemies & 0xFFFFu; left && ours > theirs; left &= left - 1)
+        if (const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))]; e.visible) theirs += bag_worth(world, e);
+    return ours > theirs;
+}
+
 // A visible enemy that could act on p before a hold begun now pays: within the capture's rounds of
 // acting there (enemy_reach's distance less its act range), a dash further for a dasher. Prism's holds
 // only: the Marcella and Tavi holders keep sole_capture_holder's enemy_seen gate.
