 }
 
+bool Safety::lethal_without(vec2 p, int enemy, float reply) {
+    if (!lethal(p)) return false;
+    const auto& victim = world_.enemies[static_cast<std::size_t>(enemy)];
+    // Camp members pick the nearest champion: one in our reach that the victim stands as near turns on
+    // us once it dies, which the members found with it alive do not count.
+    bool sheltered = false;
+    const auto& groups = world_.map().groups;
+    world_.each_stirring([&](int g) {
+        const auto& members = groups[g].members;
+        for (std::size_t i = 0; i < members.size() && !sheltered; ++i)
+            if (const auto& m = members[i]; world_.camps[g].health[i] > 0 && m.strength > 0 && dist(p, m.pos) <= m.reach)
+                sheltered = dist(victim.pos, m.pos) <= dist(p, m.pos);
+    });
+    if (sheltered) return true;
+    const float health = (test(world_.map().ally_spawn, p) ? own_health_ - my_health() + my_max_health() : own_health_) - reply;
+    // Cassi and Issac die together.
+    const auto* pair = linked_partner(world_, victim);
+    const int other = pair ? pair->index : -1;
+    float total = camp_damage(p, true, true);
+    for (const auto& t : threats())
+        if (t.enemy != enemy && t.enemy != other) total += t.at(p).damage * world_.me().taken;
+    return total >= health;
+}
