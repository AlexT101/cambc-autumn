+    // no strike (a stun of ours or a teleport takes every turn before ours) counts none.
+    const bool late = struck(e).strike.reach < 0;
+    x.counted = late ? 0 : std::max(1, x.turns.before);
+    x.follow = x.turns.before + x.turns.after - x.counted;
+    x.round = next_turn_round(world_, e) + std::max(0, x.counted - 1);
+    x.ready_counted = ready_slots(e, x.round);
+    x.ready_last = ready_slots(e, x.turns.last);
+    for (unsigned k = 0; k < 3; ++k) x.strikes[k] = &strike_with(e, k == 0 ? 0u : 1u << (k - 1));
+    x.ceiling = follow_damage(x, 0, x.follow, 0);
+    return x;
+}
+
+// Without the threat build: the enemies stun_window() reads, threats() and late_enemy() ones.
+float Safety::window_ceiling() {
+    auto& m = window_ceiling_memo;
+    if (m.generation == generation_) return m.value;
+    m.generation = generation_;
+    m.value = 0;
+    for (auto left = live_enemies(); left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (gone(e)) continue;
+        if (struck(e).strike.reach >= 0 ? e.visible || foe(e).weight > 0 : e.visible) m.value += window_foe(e).ceiling;
+    }
+    return m.value;
+}
+
+bool Safety::stun_may_land(vec2 p) {
+    return any_threat_at(p, [](const Blow& b) { return b.hits && b.stuns; });
+}
+
+// Each enemy's turns after the lost one (window_turns) are priced by follow_damage from where its
+// turns before it can have brought it, without the slot its blow at p took; a stunner's, without
+// its stun's slot, from where its stun leaves it. The stunner is whichever adds the most.
+Safety::StunWindow Safety::stun_window(vec2 p, float blow_scale) {
+    StunWindow out;
+    // A stunner first: only it opens the window. One acting after our next turn stuns the turn after
+    // it, not this window.
+    const auto stuns = [&](const Threat& t, const ChampionBelief& e, int d) {
+        if (d >= unreachable || stun_slot(e.facts()) < 0 || window_foe(e).turns.before <= 0) return false;
+        const Blow b = t.at(p);
+        return b.hits && b.stuns;
+    };
+    const auto distance = [&](const Threat& t, const ChampionBelief& e) {
+        return t.visible ? dist(p, acts_from(e)) : t.steps ? steps_at(*t.steps, p) : static_cast<int>(unreachable);
+    };
+    bool any = false;
+    for (const auto& t : threats()) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(t.enemy)];
+        if ((any = stuns(t, e, distance(t, e)))) break;
+    }
+    if (!any) return out;
+    float follows = 0, best = 0, best_before = 0, best_after = 0, most_after = 0;
+    for (const auto& t : threats()) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(t.enemy)];
+        const int d = distance(t, e);
+        if (d >= unreachable) continue;
+        const auto& x = window_foe(e);
+        const Blow b = t.at(p);
+        const unsigned spent = b.hits ? spent_slot(x, d, b.damage) : 0;
+        // A dash spent on the blow ends within its basic reach of us.
+        int near = std::max(0, d - x.counted);
+        for (int k = 0; k < 2; ++k)
+            if ((spent >> k & 1) && e.facts().abilities[static_cast<std::size_t>(k)].kind == AbilityKind::dash)
+                near = std::min(near, e.facts().basic_reach());
+        const float plain = follow_damage(x, near, x.follow, spent);
+        follows += plain;
+        if (!stuns(t, e, d)) continue;
+        const int s = stun_slot(e.facts());
+        const auto& a = e.facts().abilities[static_cast<std::size_t>(s)];
+        const auto& stun = *x.strikes[static_cast<std::size_t>(s) + 1];
+        // Its blow with the stun. With two turns before ours, its other slot on the other turn (or a
+        // walk in first): the two-turn strike counts a second basic attack only, so it may add that slot.
+        float as_stun = std::min(b.damage, stun.at(d));
+        if (x.counted >= 2) {
+            const int o = 1 - s;
+            const auto& rest = x.ready_counted >> o & 1 ? *x.strikes[static_cast<std::size_t>(o) + 1] : *x.strikes[0];
+            as_stun = std::min(b.damage + std::max(0.0f, rest.at(d) - x.strikes[0]->at(d)),
+                               std::max(stun.at(d), stun.at(std::max(0, d - 1))) + rest.at(d));
+        }
+        // An exclusive stun is cast standing; a landing ends beside us, a stunning attack in its range.
+        int left = std::max(0, d - (x.counted - (a.excludes_walking ? 1 : 0)));
+        if (a.lands()) left = std::min(left, a.radius);
+        else if (a.kind == AbilityKind::attack_reset) left = std::min(left, e.facts().basic_reach());
+        const float after = follow_damage(x, left, x.follow, 1u << s) - plain;
+        const float before = as_stun - b.damage;
+        if (!out.open || before + after > best) best = before + after, best_before = before, best_after = after;
+        most_after = out.open ? std::max(most_after, after) : after;
+        out.open = true;
+    }
+    if (!out.open) return out;
+    // Enemies with no turn before ours (a stun of ours or a teleport takes them) act after it.
+    for (auto left = seen_enemies(); left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (gone(e) || struck(e).strike.reach >= 0) continue;
+        const auto& x = window_foe(e);
+        follows += follow_damage(x, dist(p, acts_from(e)), x.follow, 0);
+    }
+    // The camp phase of the round our turn after next falls in; stunned members skip only the next.
+    const float camp = camp_damage(p, true, false);
+    out.before = best_before * blow_scale;
+    out.after = (follows + best_after) * blow_scale + camp;
+    out.after_only = (follows + most_after) * blow_scale + camp;
+    return out;
+}
