+// The bag our missing health exposes, in the rounds it took to farm: an enemy's one-turn burst B (its
+// kit at its last-read Strength and Focus, both slots ready) kills us at health h with weight
+// min(1, B / h), so a heal takes back what that weight gained over full health, on the bag a death
+// hands over (a Prism's at its premium), at our rounds alive per gem.
+float bag_risk_rounds(const World& world) {
+    const int bag = bag_at_stake(world);
+    const float health = my_health(), full = my_max_health();
+    if (bag <= 0 || health <= 0 || health >= full) return 0;
+    // Strikes and rates hold for the round, our health and bag for the turn.
+    static struct {
+        int round = -1, bag = 0;
+        float health = 0, value = 0;
+    } kept;
+    if (kept.round == world.round && kept.bag == bag && kept.health == health) return kept.value;
+    float burst = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive) continue;
+        const auto& k = strike_with(e, 3u);
+        for (int d = 0; d <= k.reach; ++d) burst = std::max(burst, k.damage[static_cast<std::size_t>(d)]);
+    }
+    burst *= world.me().taken;
+    float value = 0;
+    if (burst > 0) {
+        const float exposed = std::min(1.0f, burst / health) - std::min(1.0f, burst / full);
+        const auto rates = income_rates(world);
+        value = exposed * static_cast<float>(bag) * (1.0f + carry_premium(world, world.me())) * rates.turns / rates.gems;
+    }
+    kept = {world.round, bag, health, value};
+    return value;
+}
