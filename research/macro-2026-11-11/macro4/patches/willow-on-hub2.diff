+// Willow as a field spawn: what its heals restore to the allies near it, which they price into their
+// heal trips, recalls and clear budgets. All off without a living healer.
+// Willow keeps within this of the ally it follows (willow_follow).
+inline constexpr int willow_follow_dist = 2;
+struct WillowCover {
+    const ChampionBelief* healer = nullptr; // us or one we see, alive, off spawn, able to heal soon
+    vec2 at{-1, -1};
+    float amount = 0;  // its heal: 3x Focus
+    int ready_in = 0;  // rounds until its heal can land (a turn of its own), 0 when it can this round
+    int range = 0;     // its heal range
+    float fill = 0;    // u: its realised heal per cooldown over 3x Focus, as we measured it (params::willow_fill_prior first)
+};
+// Read once per observation.
+const WillowCover& willow_cover(const World& world);
+// Health each of Willow's heals is expected to restore to ally `a` (us included) where it stands now:
+// u x 3F, split over the allies within its heal range plus its follow leash. 0 when a is not covered:
+// beyond that leash, or beyond heal range while Willow posts another ally.
+float willow_share(const World& world, const ChampionBelief& a);
+// Willow's heals that land within `rounds`: one each cooldown from its next.
+int willow_heals_within(const World& world, float rounds);
+// A clear of group g is worked within Willow's heal range: Willow within its range of a stand in the
+// group's reach (its follow leash further when it posts a as its cover).
+bool willow_covers_group(const World& world, const ChampionBelief& a, int g);
+// Willow's next heal is likely ours, as heal_ally picks: it sees us in its range, and we gain from it at
+// least as much as any ally in its range.
+bool willow_heals_us_next(const World& world);
+// Our measurement of u (WillowCover::fill): the turn's start credits the health we gained off spawn
+// since the last turn's end, which noted what Willow could have restored us.
+void willow_turn_start(const World& world, const Memory& memory);
+void willow_turn_end(const World& world);
 
