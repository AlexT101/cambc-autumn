+    const float gain = std::min(c.amount, my_max_health() - health);
+    const float dps = safety.camp_damage(here);
+    if (gain <= dps) return false;
+    const bool lifts = !camp_trapped(world, pathing, safety, here, health + gain, false);
+    debug_block({
+        if (lifts) std::printf("WIL TRAP %d %u gain %.0f dps %.0f hp %.0f\n", world.round, my_handle(), gain, dps, health);
