+// The enemy Prism's bag, for the Focus race: `bag` from `round` (a reading in sight at its stats round,
+// none while dead, which it respawns without, or what race_track leaves after a tribute). `empty`: the
+// round its bag was last known empty, -1 unknown; `rate`: its gems a round from then to its latest
+// reading, -1 until one. `score`: their score at our last update, -1 before it.
+struct RaceTrack {
+    bool seen = false; // read in sight at least once
+    int bag = 0, round = -1, read_round = -1, empty = -1, score = -1;
+    float rate = -1;
+};
+RaceTrack prism_race;
+
+// The gems an enemy champion earns a round, as their team has been seen to: their score and the
+// living bags as last read (the Prism's as tracked), over the rounds played, per champion
+// (champion_gem_rate's, theirs).
+float enemy_gem_rate(const World& world) {
+    if (world.enemies.empty()) return 0;
+    int gems = world.score.enemy;
+    for (const auto& e : world.enemies)
+        if (e.alive) gems += e.facts().passive == Passive::gem_focus ? prism_race.bag : e.gems;
+    return static_cast<float>(gems) / static_cast<float>(std::max(1, world.round)) / static_cast<float>(world.enemies.size());
+}
+
+const ChampionBelief* enemy_prism(const World& world) {
+    for (const auto& e : world.enemies)
+        if (e.facts().passive == Passive::gem_focus) return &e;
+    return nullptr;
+}
+
+// The enemy Prism's bag now, -1 never seen: the tracked bag grown since at its own observed rate, else
+// at enemy_gem_rate.
+float race_enemy_bag(const World& world) {
+    const auto* prism = enemy_prism(world);
+    if (!prism_race.seen || !prism) return -1;
+    if (!prism->alive) return 0;
+    const float rate = prism_race.rate >= 0 ? prism_race.rate : enemy_gem_rate(world);
+    return static_cast<float>(prism_race.bag) + rate * static_cast<float>(world.round - prism_race.round);
+}
+
 // Extra gems of output per gem Prism carries. A gem stays carried until the bag must leave for an
 // altar: the round limit or the race's end (race_left), less the last trip sole_capture_holder keeps
 // back. Its extra damage d a round, at the map's gems per health point, is discounted by the farm's
 // own horizon h (rate's 1 + r / h): the sum over t < H of d / (1 + t / h) is d h ln(1 + H / h).
-float hub_premium(const World& world, const ChampionFacts& prism) {
+float hub_premium(const World& world, const ChampionFacts& prism, int bag) {
     const auto& map = world.map();
     const float h = cycle_horizon(map);
     const int carried = std::min(rounds_left(world), race_left(world)) - (map.width + map.height + endgame_margin);
     if (carried <= 0) return 0;
-    const float rho = gem_damage_rate(prism) * camp_gem_density(map) * h * std::log1p(static_cast<float>(carried) / h);
+    float rho = gem_damage_rate(prism) * camp_gem_density(map) * h * std::log1p(static_cast<float>(carried) / h);
+    // Ahead of the enemy Prism's bag, once seen, our burst (Focus times the damage spells' multipliers)
+    // outdoes theirs by the bags' difference in Focus: once that exceeds the enemy Prism's max health the
+    // race is won and more gems in ours buy nothing; linear in between.
+    if (const float theirs = race_enemy_bag(world); theirs >= 0 && static_cast<float>(bag) > theirs) {
+        const auto* enemy = enemy_prism(world);
+        float multipliers = 0;
+        for (const auto& a : prism.abilities)
+            if (a.kind == AbilityKind::damage) multipliers += a.multiplier;
+        const float lead = multipliers * cambc::constants::passive_abilities::prism_focus_per_gem * (static_cast<float>(bag) - theirs);
+        if (enemy && enemy->max_health > 0) rho *= std::clamp(1.0f - lead / enemy->max_health, 0.0f, 1.0f);
+    }
     return std::clamp(rho, 0.0f, params::hub_rho_most);
 }
 
