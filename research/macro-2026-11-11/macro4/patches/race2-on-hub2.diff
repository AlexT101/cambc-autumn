+// Whether an unseen enemy may have been tributing: some tile it may stand on is within 1 of an altar.
+bool could_tribute(const World& world, const ChampionBelief& e) {
+    static bitboard tributes;
+    static bool built = false;
+    if (!built) {
+        for (const auto& a : world.map().altars) tributes |= a.tribute_tiles();
+        built = true;
+    }
+    return !e.tracked || !(e.possible & tributes).is_empty();
+}
+
+void race_track(const World& world) {
+    // Their score's jump since our last update, less the bags World saw land (update_scores empties the
+    // bags whose tributes it can attribute, and a bag read in sight is its own): the rest is unexplained.
+    static std::array<int, 16> last_gems{};
+    int jump = prism_race.score >= 0 ? world.score.enemy - prism_race.score : 0;
+    prism_race.score = world.score.enemy;
+    const ChampionBelief* prism = nullptr;
+    for (std::size_t i = 0; i < world.enemies.size() && i < last_gems.size(); ++i) {
+        const auto& e = world.enemies[i];
+        if (e.facts().passive == Passive::gem_focus) prism = &e;
+        else if (e.alive) jump -= std::max(0, last_gems[i] - e.gems);
+        last_gems[i] = e.gems;
+    }
+    if (!prism) return;
+    auto& t = prism_race;
+    if (!prism->alive) {
+        t.bag = 0, t.round = t.empty = world.round;
+    } else if (prism->stats_round > t.read_round) {
+        // A reading, in sight now or after a move last turn (observe()).
+        t.seen = true, t.bag = prism->gems, t.round = t.read_round = prism->stats_round;
+        if (t.bag == 0) t.empty = t.round;
+        else if (t.empty >= 0 && t.round > t.empty) t.rate = static_cast<float>(t.bag) / static_cast<float>(t.round - t.empty);
+    } else if (prism->gems < t.bag) {
+        t.bag = prism->gems, t.round = t.empty = world.round; // World gave it a tribute
+    } else if (t.seen && jump > 0 && could_tribute(world, *prism)
+               && std::none_of(world.enemies.begin(), world.enemies.end(), [&](const ChampionBelief& e) {
+                      return &e != prism && e.alive && !e.visible && could_tribute(world, e);
+                  })) {
+        // A tribute no other bag explains, with no other unseen enemy that may have made it (their bags
+        // as last read are often short of what they carry), takes up to the jump from what we believe it
+        // carries. Not known empty: its rate is read only from known-empty starts.
+        t.bag = static_cast<int>(std::max(0.0f, race_enemy_bag(world) - static_cast<float>(jump))), t.round = world.round;
+    }
+    debug_block({
+        if (t.seen && world.round % 50 == 0)
+            std::printf("RACE %d %u enemy %.0f bag %d@%d read %d empty %d rate %.2f alive %d\n", world.round, my_handle(), race_enemy_bag(world), t.bag,
+                        t.round, t.read_round, t.empty, t.rate, prism->alive ? 1 : 0);
+    });
+}
