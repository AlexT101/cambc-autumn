+bool hub_coming(const World& world, int g);
+bool hub_hands_at(const World& world, const CampGroup& G, int timer, int steps);
+const ChampionBelief* hub_hands_over(const World& world, Pathing& pathing, const CampGroup& G, int g);
+bool hub_awaited(const World& world, Pathing& pathing, const CampGroup& G, int g, int timer);
