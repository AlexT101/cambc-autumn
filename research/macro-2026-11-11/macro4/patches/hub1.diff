diff -ruN '--exclude=.cambc' bots/ocean/src/economy/hub.cc bots/variants/macro4-hub1/src/economy/hub.cc
--- bots/ocean/src/economy/hub.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/macro4-hub1/src/economy/hub.cc	2026-11-11 02:51:46.741479763 +0000
@@ -0,0 +1,168 @@
+// The team's gem hub: an allied Prism. Every gem it carries adds Focus to both its damage spells until
+// it is tributed, so a gem Prism carries is worth more than the same gem in any other ally's bag.
+// Allies value gems Prism can collect at that premium, hold a cleared group until Prism takes it, and
+// Prism values collecting allies' captures.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// Gems per camp health point over the map's gem groups: farm_step_value's exchange rate.
+float camp_gem_density(const StaticMap& map) {
+    static float density = -1;
+    if (density < 0) {
+        float gems = 0, health = 0;
+        for (const auto& g : map.groups) {
+            if (g.gems == 0 || (g.has_monolith && !map.monolith_only)) continue;
+            gems += static_cast<float>(g.gems);
+            for (const auto& m : g.members) health += m.max_health;
+        }
+        density = health > 0 ? gems / health : 0.0f;
+    }
+    return density;
+}
+
+// The damage a round one carried gem adds: its Focus times the damage spells' multipliers, each cast
+// once a cooldown.
+float gem_damage_rate(const ChampionFacts& f) {
+    float multipliers = 0;
+    for (const auto& a : f.abilities)
+        if (a.kind == AbilityKind::damage) multipliers += a.multiplier;
+    return cambc::constants::passive_abilities::prism_focus_per_gem * multipliers / static_cast<float>(ability_cooldown);
+}
+
+// Extra gems of output per gem Prism carries. A gem stays carried until the bag must leave for an
+// altar: the round limit or the race's end (race_left), less the last trip sole_capture_holder keeps
+// back. Its extra damage d a round, at the map's gems per health point, is discounted by the farm's
+// own horizon h (rate's 1 + r / h): the sum over t < H of d / (1 + t / h) is d h ln(1 + H / h).
+float hub_premium(const World& world, const ChampionFacts& prism) {
+    const auto& map = world.map();
+    const float h = cycle_horizon(map);
+    const int carried = std::min(rounds_left(world), race_left(world)) - (map.width + map.height + endgame_margin);
+    if (carried <= 0) return 0;
+    const float rho = gem_damage_rate(prism) * camp_gem_density(map) * h * std::log1p(static_cast<float>(carried) / h);
+    return std::clamp(rho, 0.0f, params::hub_rho_most);
+}
+
+// A visible enemy that could act on p before a hold begun now pays: within the capture's rounds of
+// acting there (enemy_reach's distance less its act range), a dash further for a dasher. Prism's holds
+// only: the Marcella and Tavi holders keep sole_capture_holder's enemy_seen gate.
+bool hold_reached(const World& world, vec2 p) {
+    if (!enemy_seen(world)) return false;
+    const int window = capture_rounds(false);
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible) continue;
+        const auto who = enemy_reach::profile(e.facts());
+        if (enemy_reach::within(world, e, enemy_reach::origin(e), p, window + who.act + (who.dasher ? dash_range : 0))) return true;
+    }
+    return false;
+}
+
+// What threatens a hold of Prism's at p: an enemy that may see it (enemy_may_see) or reach it in time.
+bool hold_threatened(const World& world, vec2 p) { return enemy_may_see(world, p) || hold_reached(world, p); }
+
+const Hub& team_hub(const World& world) {
+    static Hub hub;
+    static int round = -1;
+    if (round == world.round) return hub;
+    round = world.round;
+    hub = Hub{};
+    if (world.me().facts().passive == Passive::gem_focus) return hub;
+    const ChampionBelief* prism = nullptr;
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.facts().passive == Passive::gem_focus) prism = &a;
+    // Collecting, not channelling, fleeing hurt (sole_capture_holder's fit_on), or between claims.
+    if (!prism || held_by_channel(*prism) || (prism->max_health > 0 && prism->health < params::hurt_health_fraction * prism->max_health)
+        || comms::claim_of(world, prism->index) < 0)
+        return hub;
+    // Where it is: in sight, else as last seen or posted within a capture's rounds (an older tile says
+    // little of where it will be for this hold).
+    const int window = capture_rounds(false);
+    vec2 at = prism->pos;
+    int at_round = prism->visible ? world.round : prism->pos_round;
+    if (vec2 told; !prism->visible) {
+        int told_round = -1;
+        if (params::comms_ally && comms::told_ally(prism->index, told, told_round) && told_round > at_round) at = told, at_round = told_round;
+    }
+    if (!in_bounds(at) || at_round < world.round - window) return hub;
+    hub.prism = prism, hub.at = at;
+    hub.bag = prism->visible ? prism->gems : comms::bag_of(world, prism->index);
+    hub.rho = hub_premium(world, prism->facts());
+    return hub;
+}
+
+// Prism's walk to group g from where we believe it is: the group's centre field there (as our own
+// steps are read), else the Chebyshev steps. A posted tile is only good to within 2 and may be a wall
+// the field never reaches: the Chebyshev steps then too.
+int hub_steps(const World& world, Pathing& pathing, const Hub& hub, int g) {
+    if (const auto* centre = pathing.from_centre(g))
+        if (const int steps = centre->at(hub.at); steps != unreachable) return steps;
+    return steps_to(world.map().groups[g], hub.at);
+}
+
+// A group's worth to the team, carried to Prism, over its worth in our bag: our payout `ours` rounds
+// away, Prism's (by joining, or holding afresh) `theirs`, each discounted as rate() does (1 + r / h).
+float hub_factor(const World& world, float rho, float ours, float theirs) {
+    const float h = cycle_horizon(world.map());
+    return std::max(1.0f, (1.0f + rho) * (h + ours) / (h + theirs));
+}
+
+// Prism's payout on G: with a free tile beside ours and Prism there before our payout, its hold joins
+// ours; otherwise (every tile held, or our payout past) it holds afresh on arrival. `fast`: its
+// Capture emblem.
+float hub_payout(float ours, int steps, bool shared, bool fast) {
+    const float fresh = static_cast<float>(steps + capture_rounds(fast));
+    return shared && static_cast<float>(steps) < ours ? ours : std::max(ours, fresh);
+}
+
+float hub_gain(const World& world, const Hub& hub, const CampGroup& G, float ours, int steps, bool shared) {
+    if (!hub.on() || G.gems <= 0 || G.has_monolith || steps == unreachable) return 1;
+    // As sole_capture_holder's Prism branch: not a hold that wins its bag or that it could not bank in time.
+    const auto& map = world.map();
+    if (world.score.ally + hub.bag + G.gems >= static_cast<int>(cambc::constants::winning_gems)
+        || rounds_left(world) <= tribute_turns(hub.bag + G.gems, hub.prism->fast_tribute) + map.width + map.height + endgame_margin)
+        return 1;
+    return hub_factor(world, hub.rho, ours, hub_payout(ours, steps, shared && G.members.size() > 1, hub.prism->fast_capture));
+}
+
+// Prism claims our hold's group g: it is coming to take it.
+bool hub_coming(const World& world, int g) {
+    const auto& hub = team_hub(world);
+    return hub.on() && comms::claim_of(world, hub.prism->index) == g;
+}
+
+// Whether we would step off G, `timer` rounds from our payout, for Prism coming to hold it afresh
+// from `steps` away: it pays the team more than our payout (hub_gain, no tile shared) and no enemy
+// threatens the hold.
+bool hub_hands_at(const World& world, const CampGroup& G, int timer, int steps) {
+    const auto& hub = team_hub(world);
+    return hub.on() && hub_gain(world, hub, G, static_cast<float>(timer), steps, false) > 1.0f && !hold_threatened(world, my_position());
+}
+
+// On G's tile with our count running, Prism coming for it but not on a tile (sole_capture_holder's
+// yield): step off for it to hold afresh (hub_hands_at) at the last turn before our payout, or once it
+// stands beside the tiles and every tile is ours. Prism, else null.
+const ChampionBelief* hub_hands_over(const World& world, Pathing& pathing, const CampGroup& G, int g) {
+    if (!hub_coming(world, g)) return nullptr;
+    const auto& hub = team_hub(world);
+    const auto& prism = *hub.prism;
+    if (prism.visible && test(G.tiles(), prism.pos)) return nullptr;
+    const int timer = fresh_ally_capture(world, G);
+    if (timer < 1) return nullptr;
+    const bool beside = prism.visible && test(G.adjacent(), prism.pos) && free_tiles(G.tiles()).is_empty();
+    if (!beside && timer > 1) return nullptr; // it may join in time; else we leave as the payout falls due
+    return hub_hands_at(world, G, timer, beside ? 1 : hub_steps(world, pathing, hub, g)) ? &prism : nullptr;
+}
+
+// A capture recall would keep us on G's tiles to its payout `timer` rounds away: not while Prism is
+// coming and we would hand the hold over at its last turn.
+bool hub_awaited(const World& world, Pathing& pathing, const CampGroup& G, int g, int timer) {
+    if (!hub_coming(world, g)) return false;
+    const int steps = hub_steps(world, pathing, team_hub(world), g);
+    return steps != unreachable && hub_hands_at(world, G, 1, std::max(1, steps - std::max(0, timer - 1)));
+}
+
+} // namespace
+
+} // namespace aph
