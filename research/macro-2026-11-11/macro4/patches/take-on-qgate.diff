+// The gems one of ours earns a round, as champion_gem_rate counts them but from what every ally reads
+// alike, so that a holder and its taker agree: the score and the bags as posted.
+float posted_gem_rate(const World& world) {
+    static int round = -1;
+    static float r = 0;
+    if (round == world.round) return r;
+    round = world.round;
+    int gems = world.score.ally;
+    for (const auto& a : world.allies) {
+        if (!a.alive && !a.is_self) continue;
+        const int bag = comms::bag_of(world, a.index);
+        gems += a.is_self ? 4 * std::min(127, (bag + 3) / 4) : bag; // ours as comms posts it
+    }
+    const int played = std::max(1, world.round);
+    r = world.allies.empty() ? 0.0f : static_cast<float>(gems) / static_cast<float>(played) / static_cast<float>(world.allies.size());
+    return r;
+}
+
+// A champion's fight power with the health it has now (gold_efficiency's output x health).
+float work_power(const ChampionBelief& a) { return camp_output(a) * std::max(0.0f, a.is_self ? my_health() : a.health); }
+
+// What a earns the team a round away from a hold: the team's rate (posted_gem_rate) by its share of
+// the living's power, so a hurt or weak ally earns least elsewhere.
+float work_rate(const World& world, const ChampionBelief& a) {
+    static int round = -1;
+    static float mean = 0;
+    if (round != world.round) {
+        round = world.round;
+        float sum = 0;
+        int n = 0;
+        for (const auto& b : world.allies)
+            if (b.alive || b.is_self) sum += work_power(b), ++n;
+        mean = n > 0 ? sum / static_cast<float>(n) : 0.0f;
+    }
+    return mean > 0 ? posted_gem_rate(world) * work_power(a) / mean : 0.0f;
+}
+
+// The rounds a spends holding G: the count left, else a fresh hold's.
+int rounds_held(const ChampionBelief& a, int timer) { return timer >= 0 ? timer : capture_rounds(a.fast_capture); }
+
+// What the team makes of a holding G for `rounds`: its hold (holder_value at `price`) less what a
+// would earn elsewhere meanwhile (work_rate). Allies rank holders by it at the shared price
+// (value_holder) and a taker comes only where it ranks first on arrival (takeover_margin), so both
+// agree. Prism's premium is its collection's (farm's Q): the sole hold that earns it is judged by
+// what the observer sees, which holder and taker need not share.
+float team_hold(const World& world, const ChampionBelief& a, const CampGroup& G, float rounds, float price) {
+    return holder_value(world, a, G, price) - rounds * work_rate(world, a);
+}
