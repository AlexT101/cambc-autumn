+float carry_premium(const World& world, const ChampionBelief& c) {
+    if (c.facts().passive != Passive::gem_focus) return 0;
+    // One Prism kit, and the premium reads only the round and our race: once a round.
+    static int round = -1;
+    static float rho = 0;
+    if (round != world.round) round = world.round, rho = hub_premium(world, c.facts());
+    return rho;
+}
+
+float bag_worth(const World& world, const ChampionBelief& c) {
+    const int gems = pair_gems(world, c);
+    return gems <= 0 ? 0.0f : params::gem_value * static_cast<float>(gems) * (1.0f + carry_premium(world, c));
+}
