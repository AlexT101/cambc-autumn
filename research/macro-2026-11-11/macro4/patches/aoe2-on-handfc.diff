+    AreaHits h;
+    const auto n = static_cast<float>(std::min<std::size_t>(map.groups[g].members.size(), area_members));
+    if (n < 2) return h;
+    constexpr auto square = static_cast<float>(area_square);
+    h.ground = h.splash = h.kite_ground = std::min(n, square), h.landing = h.kite_landing = std::min(n, square - 1);
+    return h;
