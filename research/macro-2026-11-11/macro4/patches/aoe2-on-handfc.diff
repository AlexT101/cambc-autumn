+        for (int g = 0; g < static_cast<int>(map.groups.size()); ++g) {
+            const auto h = area_hits_full(map, g);
+            most.ground = std::max(most.ground, h.ground), most.landing = std::max(most.landing, h.landing), most.splash = std::max(most.splash, h.splash);
+        }
+    }
+    return most;
+}
+
+// Whether c's area hits on camps are priced: a ground damage spell, a damaging landing or Varg's splash.
+// Not Prism's: priced single-target, its harvesting stays as it was.
+bool hits_area(const ChampionBelief& c) {
+    const auto& f = c.facts();
+    if (f.passive == Passive::gem_focus) return false;
+    if (f.passive == Passive::splash_attack) return true;
+    for (const auto& a : f.abilities)
+        if ((a.kind == AbilityKind::damage && a.target == Targeting::ground) || a.lands()) return true;
+    return false;
+}
+AreaCoef area_coef(const ChampionBelief& c) {
+    AreaCoef k;
+    if (!hits_area(c)) return k;
+    const auto& f = c.facts();
+    const float scale = camp_scale(c);
+    for (int s = 0; s < 2; ++s) {
+        const auto& a = f.abilities[s];
+        if (a.kind == AbilityKind::damage && a.target == Targeting::ground) k.ground += f.output_scale[s] * c.focus * scale;
+        else if (a.lands()) k.landing += f.output_scale[s] * c.focus * scale;
+    }
