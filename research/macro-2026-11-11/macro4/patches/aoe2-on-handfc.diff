--- macro4-handfc/src/economy/camps.cc	2026-11-11 07:30:38.254721690 +0000
+++ macro4-aoe2/src/economy/camps.cc	2026-11-11 08:14:31.238211363 +0000
@@ -146,6 +146,241 @@
 // output() on camps, at least 1: a divisor for clear times.
 float camp_output(const ChampionBelief& c) { return std::max(1.0f, c.facts().raw_output(c.strength, c.focus) * camp_scale(c)); }
 
+// Basic attacks a turn per attack, with the reset spread over its cooldown.
+float attack_rate(const ChampionFacts& f) { return f.has_attack_reset() ? 1.0f + 1.0f / static_cast<float>(ability_cooldown) : 1.0f; }
+
+// Per group, static, bit i for member i (the first 63): for each tile a ground cast or a landing could
+// centre on, the members within its radius, bit 63 set where a landing can (a tile in a row equal to
+// the one before it left out); each member's splash neighbourhood; the strikers. `full`: the hits with
+// every member alive, splash at the largest neighbourhood, so that any alive set's hits are at most
+// these. All groups' masks share one pool, reserved once.
+struct AreaMasks {
+    bool built = false;
+    int at = 0, n_masks = 0, n_near = 0; // in area_pool: the masks, then the neighbourhoods
+    std::uint64_t strikers = 0;
+    AreaHits full;
+};
+constexpr int area_members = 63;
+constexpr std::uint64_t area_lands = std::uint64_t{1} << area_members;
+std::vector<AreaMasks> area_masks_kept;
+int area_masks_built = 0;
+std::vector<std::uint64_t> area_pool, area_cells; // area_cells: scratch
+static_assert(splash_radius == ground_radius); // a member's own cell holds its splash neighbourhood
+static_assert([] {
+    for (const auto& f : champion_table)
+        for (const auto& a : f.abilities)
+            if (a.lands() && a.radius != ground_radius) return false;
+    return true;
+}()); // the landing footprint is the ground cast's
+constexpr int area_square = (2 * ground_radius + 1) * (2 * ground_radius + 1);
+// What build_area_masks spends on g (measured: ~1.5k on a pair, ~19k on 49 members).
+std::uint64_t area_masks_cost(const StaticMap& map, int g) { return 800 + 400 * static_cast<std::uint64_t>(map.groups[g].members.size()); }
+bool area_masks_ready(int g) { return static_cast<std::size_t>(g) < area_masks_kept.size() && area_masks_kept[g].built; }
+void build_area_masks(const StaticMap& map, int g, AreaMasks& m);
+extern AreaColumns area_columns_kept;
+void area_column(const StaticMap& map, int g);
+const AreaMasks& area_masks(const StaticMap& map, int g) {
+    if (area_masks_kept.size() != map.groups.size()) {
+        area_masks_kept.assign(map.groups.size(), {}), area_masks_built = 0, area_pool.clear();
+        // A mask per tile within the radius of a member, at most area_square a member, and a neighbourhood each.
+        std::size_t most = 0;
+        for (const auto& G : map.groups) most += (area_square + 1) * std::min<std::size_t>(G.members.size(), area_members);
+        area_pool.reserve(most);
+    }
+    auto& m = area_masks_kept[g];
+    if (m.built) return m;
+    m.built = true, ++area_masks_built;
+    build_area_masks(map, g, m);
+    if (area_columns_kept.ground.size() == map.groups.size() + 3) area_column(map, g);
+    return m;
+}
+void build_area_masks(const StaticMap& map, int g, AreaMasks& m) {
+    const auto& members = map.groups[g].members;
+    const int n = static_cast<int>(std::min<std::size_t>(members.size(), area_members));
+    if (n < 2) return;
+    int x0 = map.width, y0 = map.height, x1 = -1, y1 = -1;
+    for (int i = 0; i < n; ++i) {
+        const vec2 p = members[i].pos;
+        x0 = std::min(x0, p.x), y0 = std::min(y0, p.y), x1 = std::max(x1, p.x), y1 = std::max(y1, p.y);
+        if (members[i].strength > 0) m.strikers |= std::uint64_t{1} << i;
+    }
+    constexpr int r = ground_radius;
+    const int w = x1 - x0 + 1 + 2 * r;
+    area_cells.assign(static_cast<std::size_t>(w * (y1 - y0 + 1 + 2 * r)), 0);
+    auto* cells = area_cells.data();
+    for (int i = 0; i < n; ++i) {
+        auto* c = cells + (members[i].pos.y - y0) * w + (members[i].pos.x - x0);
+        for (int dy = 0; dy <= 2 * r; ++dy, c += w)
+            for (int dx = 0; dx <= 2 * r; ++dx) c[dx] |= std::uint64_t{1} << i;
+    }
+    m.at = static_cast<int>(area_pool.size());
+    int ground = 1, landing = 1;
+    // Map::standable excludes every camp tile, so a landing is never counted on a member's.
+    for (int y = y0 - r, k = 0; y <= y1 + r; ++y) {
+        std::uint64_t last = 0;
+        for (int x = x0 - r; x <= x1 + r; ++x, ++k) {
+            auto c = cells[k];
+            if (!(c & (c - 1)) || !in_bounds({x, y})) continue;
+            const int hit = std::popcount(c);
+            ground = std::max(ground, hit);
+            if (test(map.standable, {x, y})) c |= area_lands, landing = std::max(landing, hit);
+            if (c != last) area_pool.push_back(c), last = c;
+        }
+    }
+    m.n_masks = static_cast<int>(area_pool.size()) - m.at;
+    int splash = 1;
+    for (int i = 0; i < n; ++i) {
+        const auto near = cells[(members[i].pos.y - y0 + r) * w + (members[i].pos.x - x0 + r)];
+        area_pool.push_back(near), splash = std::max(splash, std::popcount(near));
+    }
+    m.n_near = n;
+    m.full.ground = m.full.kite_ground = static_cast<float>(ground);
+    m.full.landing = m.full.kite_landing = static_cast<float>(landing), m.full.splash = static_cast<float>(splash);
+}
+AreaHits area_hits_of(const StaticMap& map, int g, const CampBelief& belief) {
+    AreaHits h;
+    const auto& m = area_masks(map, g);
+    if (belief.state == CampState::cleared || m.n_near == 0) return h;
+    std::uint64_t alive = 0;
+    for (int i = 0; i < m.n_near; ++i)
+        if (belief.state == CampState::respawning || belief.health[i] > 0) alive |= std::uint64_t{1} << i;
+    const int live = std::popcount(alive);
+    if (live < 2) return h;
+    const std::uint64_t* masks = area_pool.data() + m.at;
+    const auto most = [&](std::uint64_t of, float& ground, float& landing) {
+        int best = 1, lands = 1;
+        for (int k = 0; k < m.n_masks; ++k) {
+            const int hit = std::popcount(masks[k] & of);
+            best = std::max(best, hit);
+            if (masks[k] & area_lands) lands = std::max(lands, hit);
+        }
+        ground = static_cast<float>(best), landing = static_cast<float>(lands);
+    };
+    most(alive, h.ground, h.landing);
+    // A kite casts at strikers only; with none alive it has no clear, and with no other alive its hits are these.
+    if (const auto strikers = alive & m.strikers; strikers != alive && strikers) most(strikers, h.kite_ground, h.kite_landing);
+    else h.kite_ground = h.ground, h.kite_landing = h.landing;
+    const std::uint64_t* near = masks + m.n_masks;
+    int splash = 0;
+    for (auto b = alive; b; b &= b - 1) splash += std::popcount(near[std::countr_zero(b)] & alive);
+    h.splash = static_cast<float>(splash) / static_cast<float>(live);
+    return h;
