+    };
+    static std::vector<Kept> kept;
+    if (kept.size() != world.camps.size()) kept.assign(world.camps.size(), {});
+    auto& k = kept[g];
+    const auto& belief = world.camps[g];
+    const auto version = belief.state == CampState::alive ? belief.geometry_version : belief.version;
+    if (k.version == version && k.state == belief.state) return k.hits;
+    // Short of fuel for its first build, a group's pricing counts no area hit (warm_clears builds it).
+    static const AreaHits none;
+    if (!area_masks_ready(g) && !fuel_ok(area_build_reserve + area_masks_cost(world.map(), g))) return none;
+    k = {version, belief.state, area_hits_of(world.map(), g, belief)};
+    return k.hits;
