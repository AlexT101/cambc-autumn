+float bag_worth(const World& world, const ChampionBelief& e) {
+    static int round = -1;
+    static float scale = 1;
+    if (round != world.round) {
+        round = world.round;
+        const auto& f = world.me().facts();
+        scale = f.passive == Passive::gem_focus ? 1.0f + hub_premium(world, f) : 1.0f;
+    }
+    return params::gem_value * static_cast<float>(pair_gems(world, e)) * scale;
+}
