@@ -2094,9 +2094,17 @@
             // tie: the reach had we acted first, so reach <= tie <= reach + 1 and no other lies
             // between them. Both are plain minima: an other with d - 1 >= reach lowers neither.
             int reach = m.reach, tie = m.reach;
+            // A Monolith's fire is too heavy to bet that an enemy yet to act stays nearer: it may walk
+            // (and dash) away first (params::camp_flee).
+            const bool heavy = params::camp_flee && m.type == cambc::camp_type::monolith;
             for (int k = 0; k < k_near; ++k) {
                 auto& o = others.at[near[k]];
-                if (const int d = dist(o.pos, m.pos); d - 1 < reach) reach = std::min(reach, d - first(o)), tie = std::min(tie, d);
+                int d = dist(o.pos, m.pos);
+                if (heavy && o.belief->side == team::enemy && !held_this_round(*o.belief, world_.round)) {
+                    const int dash = o.belief->facts().slot_of(AbilityKind::dash);
+                    d += 1 + (dash >= 0 && o.belief->ability_ready(dash, world_.round) ? 2 : 0);
+                }
+                if (d - 1 < reach) reach = std::min(reach, d - first(o)), tie = std::min(tie, d);
             }
             emit(m, reach, tie);
         }
