 } // namespace
 
+// Static per group: the farm loop's first clear of a group builds it (~2k a group, more for big ones).
+bool warm_stand_reach(const StaticMap& map, int range, std::uint64_t floor) {
+    static int next = 0;
+    const auto round = round_now();
+    for (; next < static_cast<int>(map.groups.size()); ++next) {
+        const auto members = static_cast<std::uint64_t>(map.groups[next].members.size());
+        if (round_now() != round || !fuel_ok(floor + 4000 + 200 * members)) return false;
+        (void)stand_reach(map, next, range);
+    }
+    return true;
+}
+
 } // namespace aph
