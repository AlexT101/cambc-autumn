+bool deadline_stage(World& world, Pathing& pathing, Safety& safety, const Memory& memory, const bitboard* zone) {
+    for (const auto& altar : world.altars)
+        if (altar.enemy_lock) return false;
+    if (memory.avoid_altar >= 0 && world.round < memory.avoid_until) return false;
+    const auto& field = pathing.to_any_altar();
+    const vec2 here = my_position();
+    const int steps = field.at(here);
+    if (steps == 0 || steps == unreachable) return false;
+    const auto& blocked = pathing.blocked();
+    vec2 best = here;
+    int best_steps = steps;
+    for (const auto d : directions) {
+        const vec2 p = here + d;
+        if (!in_bounds(p) || !test(world.map().open_for_us, p) || test(blocked, p)
+            || (zone && test(*zone, p)) || (pathing.guard() && test(*pathing.guard(), p))) continue;
+        const int next = field.at(p);
+        if (next >= best_steps) continue;
+        const auto risk = support_exposure_raw(world, safety, p, true, true);
+        if (!risk.safe() || risk.stun) continue;
+        best = p, best_steps = next;
+    }
+    world.throw_if_stale();
+    if (best == here) return false;
+    const bool moved = pathing.try_move(best);
+    see_again(world, pathing, safety);
+    world.throw_if_stale();
+    debug_block({ std::printf("FSTAGE-MOVE %d %u %d,%d moved %d steps %d %d\n", world.round,
+        my_handle(), best.x, best.y, moved, steps, best_steps); });
+    return moved;
+}
