--- bots/charybdis/src/bot.cc	2026-11-13 13:14:17.401699384 +0000
+++ bots/charybdis/src/bot.cc	2026-11-13 13:05:34.022326232 +0000
@@ -524,10 +524,24 @@
 // Buys what we may here: consumables on our spawn or dead, shards there too or anywhere for Tavi.
 // The crystal first: an altar only it reaches holds our bags, and shards could spend its gold.
 // True if shards changed our stats.
+// One tribute site: a lone altar, or two side by side at the centre (the gate's one-site split). A lock
+// there covers every altar the enemy can bank at; elsewhere its gold is worth more as shards.
+static bool one_site_map(const World& world) {
+    const auto& map = world.map();
+    const int n = static_cast<int>(map.altars.size());
+    if (n == 1) return true;
+    if (n != 2) return false;
+    const float cx = (map.width - 1) / 2.0f, cy = (map.height - 1) / 2.0f;
+    const float half = std::max(map.width, map.height) / 2.0f;
+    float sum = 0;
+    for (const auto& a : map.altars) sum += std::max(std::abs(a.pos.x - cx), std::abs(a.pos.y - cy)) / half;
+    return sum / n < 0.06f;
+}
+
 bool shop(const World& world, const Memory& memory, bool consumables, bool shards) {
     if (consumables) buy_crystal(memory);
     const bool bought = shards && buy_shards(world);
-    if (consumables) buy_lock();
+    if (consumables && one_site_map(world)) buy_lock();
     return bought;
 }
 
