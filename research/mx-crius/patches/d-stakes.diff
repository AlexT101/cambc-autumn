diff -ruN bots/variants/chy-ref/src/economy/stakes.cc bots/variants/d-stakes/src/economy/stakes.cc
--- bots/variants/chy-ref/src/economy/stakes.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/d-stakes/src/economy/stakes.cc	2026-11-13 16:29:11.140257119 +0000
@@ -0,0 +1,129 @@
+#include "../model/stakes.h"
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// team_farm for the enemy side, from its score, the bags last seen on its living and the stats last seen.
+const TeamFarm& enemy_farm(const World& world) {
+    static TeamFarm kept;
+    static int round = -1;
+    static std::uint32_t observations = ~0u;
+    if (round == world.round && observations == world.observations) return kept;
+    round = world.round, observations = world.observations;
+    int collected = world.score.enemy;
+    float output = 0;
+    for (const auto& e : world.enemies) collected += e.alive ? std::max(0, e.gems) : 0, output += camp_output(e);
+    const float n = static_cast<float>(std::max<std::size_t>(1, world.enemies.size()));
+    const float per_round = (static_cast<float>(collected) + n * income_prior_gems)
+                            / (static_cast<float>(std::max(0, world.round)) + prior_rounds_per_gem * income_prior_gems);
+    kept.per_output = per_round / std::max(1.0f, output);
+    kept.to_win = static_cast<float>(std::max(0, static_cast<int>(cambc::constants::winning_gems) - collected)) / per_round;
+    return kept;
+}
+
+const TeamFarm& side_farm(const World& world, const ChampionBelief& c) { return c.side == team::ally ? team_farm(world) : enemy_farm(world); }
+
+// linked_partner by handle: turn_order's live copy of us is not an element of world.allies.
+const ChampionBelief* pair_partner(const World& world, const ChampionBelief& c) {
+    if (c.facts().passive != Passive::linked_pair) return nullptr;
+    for (const auto& o : c.side == team::ally ? world.allies : world.enemies)
+        if (o.handle != c.handle && o.facts().passive == Passive::linked_pair) return &o;
+    return nullptr;
+}
+
+int bag_of(const World& world, const ChampionBelief& c) { return c.side == team::ally ? team_bag(world, c) : c.alive ? std::max(0, c.gems) : 0; }
+
+// prism_premium for either side: an enemy Prism's as ours is read (keeps_bag, team_farm), from its side's score,
+// farm and the stats last seen.
+float premium(const World& world, const ChampionBelief& c, int gems) {
+    if (c.side == team::ally) return prism_premium(world, c, gems);
+    if (gems <= 0 || c.facts().passive != Passive::gem_focus || !c.alive) return 0.0f;
+    const auto& map = world.map();
+    const int bag = bag_of(world, c), room = static_cast<int>(cambc::constants::winning_gems) - world.score.enemy - bag - gems;
+    const int last = rounds_left(world) - map.width - map.height - endgame_margin - tribute_turns(bag + gems, c.fast_tribute);
+    if ((c.visible && c.health < params::hurt_health_fraction * c.max_health) || room <= 0 || last <= 0) return 0.0f;
+    const auto& f = c.facts();
+    const float per_gem = cambc::constants::passive_abilities::prism_focus_per_gem;
+    const float output = (f.raw_output(c.strength, c.focus + per_gem) - f.raw_output(c.strength, c.focus)) * camp_scale(c);
+    const auto& tf = enemy_farm(world);
+    const float growth = std::expm1(output * tf.per_output * std::max(0.0f, std::min(tf.to_win, static_cast<float>(last))));
+    return std::max(0.0f, std::min(growth, static_cast<float>(room) / static_cast<float>(gems)));
+}
+
+// Gold's price in gems for both sides' kills and farms: capture.cc's one number for all, so allies agree.
+constexpr float stake_gold_price = holder_gold_price;
+
+// A body's farm lost to its respawn: its share of its side's farm (gems a round per camp output) over the
+// respawn, a keeping Prism's premium on those gems, and the gold the map pays with them at its gold rate.
+float respawn_gems(const World& world, const ChampionBelief& b) {
+    static const cambc::enum_map<cambc::item_type> none{};
+    const float rounds = static_cast<float>(cambc::constants::respawn_time);
+    const float gems = rounds * side_farm(world, b).per_output * camp_output(b);
+    const float gold_rate = b.side == team::ally ? ally_gold_paid(world, b) : aph::gold_rate(b.facts(), none);
+    return gems * (1.0f + premium(world, b, static_cast<int>(gems + 0.5f)))
+           + gems * income_prior(world.map()).gold * gold_rate * stake_gold_price;
+}
+
+struct LifeKey {
+    int round = -1;
+    std::uint32_t observations = ~0u, gems = ~0u;
+    float value = 0;
+};
+
+float life_gems(const World& world, const ChampionBelief& victim) {
+    // Per victim per round, every input held: the planner and Safety read it for each foe often.
+    static std::array<LifeKey, 32> kept;
+    auto& k = kept[static_cast<std::size_t>((victim.side == team::enemy ? 16 : 0) + (victim.index & 15))];
+    if (k.round == world.round && k.observations == world.observations && k.gems == my_gems()) return k.value;
+    float v = respawn_gems(world, victim);
+    if (const auto* p = pair_partner(world, victim); p && p->alive) v += respawn_gems(world, *p);
+    v += static_cast<float>(cambc::constants::kill_gold) * stake_gold_price;
+    k = {world.round, world.observations, my_gems(), v};
+    return v;
+}
+
+float bag_gems(const World& world, const ChampionBelief& victim, const ChampionBelief* killer) {
+    const int bag = victim.side == team::ally ? team_bag(world, victim) + [&] {
+        const auto* p = pair_partner(world, victim);
+        return p && p->alive ? team_bag(world, *p) : 0;
+    }() : pair_gems(world, victim);
+    if (bag <= 0) return 0.0f;
+    // The killer's side: gems past its win are worth nothing.
+    const bool enemy_kills = victim.side == team::ally;
+    const int score = enemy_kills ? world.score.enemy : world.score.ally;
+    const int room = static_cast<int>(cambc::constants::winning_gems) - score - (killer ? bag_of(world, *killer) : 0);
+    const int kept = std::clamp(bag, 0, std::max(0, room));
+    return static_cast<float>(kept) * (1.0f + (killer && kept > 0 ? premium(world, *killer, kept) : 0.0f));
+}
+
+// The planner's kill worth already pays the victim's health (kill_distance), and with params::life_value on it averages
+// above life_gems at params::gem_value (research/mx-crius, line D trace): life_value keeps the level, life_gems its share.
+float life_stake(const World& world, const ChampionBelief& victim) { return params::life_value * life_gems(world, victim) / params::life_gems_mean; }
+
+float bag_stake(const World& world, const ChampionBelief& victim, const ChampionBelief* killer) {
+    return params::gem_value * bag_gems(world, victim, killer);
+}
+
+float kill_stake(const World& world, const ChampionBelief& victim, const ChampionBelief* killer) {
+    return life_stake(world, victim) + bag_stake(world, victim, killer);
+}
+
+float ally_bag_stake(const World& world, const ChampionBelief& c) {
+    // Per ally per round, every input held: Safety reads ours for each fight it simulates.
+    static std::array<LifeKey, 16> kept;
+    auto& k = kept[static_cast<std::size_t>(c.index & 15)];
+    if (k.round == world.round && k.observations == world.observations && k.gems == my_gems()) return k.value;
+    float most = bag_stake(world, c, nullptr);
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && e.facts().passive == Passive::gem_focus) most = std::max(most, bag_stake(world, c, &e));
+    k = {world.round, world.observations, my_gems(), most};
+    return most;
+}
+
+float ally_kill_stake(const World& world, const ChampionBelief& c) { return life_stake(world, c) + ally_bag_stake(world, c); }
+
+} // namespace
+
+} // namespace aph
