diff -ruN bots/variants/chy-ref/src/model/stakes.h bots/variants/d-stakes/src/model/stakes.h
--- bots/variants/chy-ref/src/model/stakes.h	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/d-stakes/src/model/stakes.h	2026-11-13 16:09:04.242802986 +0000
@@ -0,0 +1,30 @@
+#pragma once
+// What a champion's death is worth, in gems, from the economy's own prices (economy/stakes.cc), and in the
+// fight planner's units (enemy health points): the bag at params::gem_value a gem, the life at its share of params::life_value. Every fight valuation reads these
+// in place of fixed life and bag values. Defined in unity.cpp's one translation unit.
+
+namespace aph {
+
+class World;
+struct ChampionBelief;
+
+namespace {
+
+// The victim's side loses its respawn's farm (each body of a linked pair), the killer's side gains the kill gold.
+float life_gems(const World& world, const ChampionBelief& victim);
+// What the killer's side gains by the victim's bag (both bags for a linked pair): the gems up to its win, a
+// keeping Prism killer's premium on them. `killer` null: no premium.
+float bag_gems(const World& world, const ChampionBelief& victim, const ChampionBelief* killer);
+// life_stake + bag_stake: a kill's worth beyond the victim's health.
