+// Where the team and the enemies can be, for race_first, read once a turn.
+struct RaceField {
+    struct Span {
+        vec2 at{-1, -1};  // where it was (its spawn if never seen or dead)
+        int spread = 0;   // how far from `at` it may be by now, either way
+        int delay = 0;    // rounds before it walks (a respawn)
+        int window = 0;   // dead: how much later its respawn may come
+        GrowBox box;      // tracked: the tiles it may stand on, whose nearest is its least distance
+        bool boxed = false;
+        int index = 0;
+    };
+    std::array<vec2, 8> allies{};
+    int n_allies = 0;
+    std::array<Span, 8> enemies{};
+    int n_enemies = 0;
+};
+RaceField race_field(const World& world) {
+    RaceField f;
+    const auto& map = world.map();
+    for (const auto& a : world.allies) {
+        if (!a.alive || f.n_allies >= 8) continue;
+        vec2 at = a.is_self ? my_position() : a.pos;
+        if (!a.is_self && !a.visible && params::comms_ally) {
+            vec2 told{-1, -1};
+            int when = -1;
+            if (comms::told_ally(a.index, told, when) && when > a.pos_round) at = told;
+        }
+        if (in_bounds(at)) f.allies[static_cast<std::size_t>(f.n_allies++)] = at;
+    }
+    for (const auto& e : world.enemies) {
+        if (f.n_enemies >= 8) break;
+        RaceField::Span s;
+        s.index = e.index;
+        // Unseen, it is taken where it was, displaced as a walk of no known aim since: sqrt(rounds) either
+        // way, never nearer than its possible tiles allow. Its possible box alone spans most of the map
+        // within a few dozen rounds, which would put an enemy first at nearly every group.
+        const auto drift = [](int rounds) { return static_cast<int>(std::ceil(std::sqrt(static_cast<float>(std::max(0, rounds))))); };
+        if (!e.alive) {
+            s.at = map.enemy_spawn_centre;
+            const int from = e.respawn_earliest >= 0 ? e.respawn_earliest : world.round + static_cast<int>(cambc::constants::respawn_time);
+            // Its respawn turn cannot walk.
+            s.delay = std::max(0, from - world.round) + 1;
+            s.window = e.respawn_latest >= from ? e.respawn_latest - from : 0;
+        } else if (e.visible) {
+            s.at = e.teleport_pending() ? e.tp_dest : e.pos;
+        } else {
