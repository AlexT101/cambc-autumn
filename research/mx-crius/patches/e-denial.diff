+// Denial: in the race to winning_gems, a gem the enemy does not get moves the race as one we get, by
+// 1/r_them rounds against 1/r_us, so a group g taken now is worth W_us(g) + p(g) W_them(g) r_us / r_them:
+// p(g) what our going takes off the enemy's chance of capturing it, W_them its gems, times (1 + their
+// Prism's premium) where their Prism would take them. The paces are the tributed scores' (both exact, read
+// alike by every ally; bags are exact only for ours) with gem_income_rate's prior on each body.
+// p from P, the chance some enemy reaches g before the team (race_first), and the measured share of middle
+// groups their waker captures: alone q_free, with an enemy within 8 at the wake q_contest (1,700 mirror games,
+// research/mx-crius). Enemy first, going makes their capture a contested one: q_free - q_contest. We first,
+// leaving it gives it to them as often as they would have come first, P q_free, while taking it loses it to
+// them when they come, P (1 - q_contest). So p = P (q_free - q_contest) + (1 - P) P (q_free + q_contest - 1).
+inline constexpr float q_free = 0.935f, q_contest = 0.75f;
+constexpr float deny_p(float first) {
+    return first * ((q_free - q_contest) + (1.0f - first) * (q_free + q_contest - 1.0f));
+}
+// deny_p's most over [0, 1]: at P = (a + b) / 2b for p = P (a + b (1 - P)), clamped.
+inline constexpr float deny_p_most = [] {
+    constexpr float a = q_free - q_contest, b = q_free + q_contest - 1.0f;
+    constexpr float at = (a + b) / (2.0f * b);
+    return deny_p(at < 1.0f ? at : 1.0f) * 1.0001f;
+}();
+struct RaceTerms {
+    float ratio = 1;                // r_us / r_them
+    std::array<float, 8> premium{}; // by enemy index: a gem's premium to a Prism carrying gems when last seen
+    float premium_most = 0;
+    int room = 0;                   // gems short of the enemy's win
+    float most = 1;                 // 1 + deny_p_most ratio (1 + premium_most): bounds 1 + deny
+};
+const RaceTerms& race_terms(const World& world) {
+    static RaceTerms kept;
+    static int round = -1;
+    static std::uint32_t observations = ~0u, gems = ~0u;
+    if (round == world.round && observations == world.observations && gems == my_gems()) return kept;
+    round = world.round, observations = world.observations, gems = my_gems();
+    RaceTerms t;
+    const float prior_rounds = static_cast<float>(std::max(0, world.round)) + prior_rounds_per_gem * income_prior_gems;
+    const int ours = world.score.ally, theirs = world.score.enemy;
+    float their_output = 0;
+    for (const auto& e : world.enemies)
+        if (e.alive) their_output += camp_output(e);
+    const auto pace = [&](int collected, std::size_t bodies) {
+        return (static_cast<float>(collected) + static_cast<float>(std::max<std::size_t>(1, bodies)) * income_prior_gems) / prior_rounds;
+    };
+    const float r_us = pace(ours, world.allies.size()), r_them = pace(theirs, world.enemies.size());
+    t.ratio = r_us / r_them;
+    const int win = static_cast<int>(cambc::constants::winning_gems);
+    t.room = std::max(0, win - world.score.enemy);
+    // prism_premium's growth, at their pace per output (their last-seen stats) and to their win.
+    const auto& map = world.map();
+    const float to_win = static_cast<float>(std::max(0, win - theirs)) / r_them, per_output = r_them / std::max(1.0f, their_output);
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.gems <= 0 || e.facts().passive != Passive::gem_focus || e.index < 0 || e.index >= 8) continue;
+        const auto& f = e.facts();
+        const float per_gem = cambc::constants::passive_abilities::prism_focus_per_gem;
+        const float output = (f.raw_output(e.strength, e.focus + per_gem) - f.raw_output(e.strength, e.focus)) * camp_scale(e);
+        const int last = rounds_left(world) - map.width - map.height - endgame_margin - tribute_turns(e.gems, e.fast_tribute);
+        const float horizon = std::max(0.0f, std::min(to_win - static_cast<float>(e.gems) / r_them, static_cast<float>(last)));
+        // No more than gems past their win allow (deny_of's cap is at most room - 1 a gem).
+        const float p = std::clamp(std::expm1(output * per_output * horizon), 0.0f, static_cast<float>(std::max(0, t.room - 1)));
+        t.premium[static_cast<std::size_t>(e.index)] = p, t.premium_most = std::max(t.premium_most, p);
+    }
+    t.most = 1.0f + deny_p_most * t.ratio * (1.0f + t.premium_most);
+    kept = t;
+    return kept;
+}
