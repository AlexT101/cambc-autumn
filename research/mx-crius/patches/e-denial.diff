+            // of its index stands, mirrored.
+            const bool seen = e.pos_round >= 0 && in_bounds(e.pos) && !(e.pos_source == Source::inferred && e.stats_round < 0 && e.respawned_round < 0);
+            s.at = seen ? e.pos : map.enemy_spawn_centre;
+            if (!seen && e.index < static_cast<int>(world.allies.size()) && world.allies[static_cast<std::size_t>(e.index)].alive) {
+                const auto& a = world.allies[static_cast<std::size_t>(e.index)];
+                const vec2 from = a.is_self ? my_position() : a.pos;
+                if (in_bounds(from)) s.at = map.mirror(from);
+            }
+            s.spread = drift(seen ? world.round - e.pos_round : world.round);
+            if (e.tracked && e.possible_box.x0 <= e.possible_box.x1) s.box = e.possible_box, s.boxed = true;
+        }
+        f.enemies[static_cast<std::size_t>(f.n_enemies++)] = s;
+    }
+    return f;
+}
