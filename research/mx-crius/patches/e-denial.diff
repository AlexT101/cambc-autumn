+// The chance enemy span s stands on tile c first against the team's arrival `ours`, both waiting out
+// `ready` rounds (a respawn: both there by its return, an even chance). Its arrival is uniform within
+// its spread of the Chebyshev distance from `at`, after its delay.
+float race_first(const RaceField::Span& s, vec2 c, int ours, int ready) {
+    const int d = dist(s.at, c);
+    int least = 0;
+    if (s.boxed) {
+        const auto& b = s.box;
+        least = std::max({0, b.x0 - c.x, c.x - b.x1, b.y0 - c.y, c.y - b.y1});
+    }
+    const int near = std::max(least, d - s.spread) + s.delay;
+    const int far = std::max(near, d + s.spread + s.delay + s.window);
+    const float span = static_cast<float>(far - near + 1);
+    // Over near..far: arrivals before `ours` count whole, at it half.
+    if (ours <= ready) return 0.5f * std::clamp(static_cast<float>(ready - near + 1) / span, 0.0f, 1.0f);
+    return std::clamp((static_cast<float>(ours - near) + 0.5f) / span, 0.0f, 1.0f);
+}
