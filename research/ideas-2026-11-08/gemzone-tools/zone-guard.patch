diff -ruN oc-base25/src/economy/gem_zone.cc oc-zone2/src/economy/gem_zone.cc
--- a/bots/ocean/src/economy/gem_zone.cc	1970-01-01 00:00:00.000000000 +0000
+++ b/bots/ocean/src/economy/gem_zone.cc	2026-11-08 05:32:22.619622958 +0000
@@ -0,0 +1,248 @@
+// Gem zones (research/ideas-2026-11-08/gem-zone.md): on a map whose gem income lies in one small
+// area, our strongest bodies farm only its groups while any is up, fight enemies by it, and hold it
+// while a capture is pending or a group is about to return; the rest farm as before. By symmetry
+// such an area is shared: the top teams take it (00stampede, 00ribs) while we farm gold elsewhere.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+constexpr int zone_stand_count = 6;      // stand tiles kept, best first
+constexpr std::uint64_t zone_build_fuel = 60000; // spare fuel a turn needs to build the zone or its stands
+
+struct GemZone {
+    bool on = false;
+    std::vector<char> member;             // by group
+    int x0 = 0, y0 = 0, x1 = -1, y1 = -1; // the members' box
+    std::vector<vec2> stands;             // best first; built at the first hold
+    bool stands_built = false;
+    std::optional<Field> to_zone;         // from the zone's camp tiles over static walls
+};
+
+struct Box {
+    int x0, y0, x1, y1;
+};
+
+int box_gap(const Box& a, const Box& b) {
+    int d = 0;
+    if (b.x0 - a.x1 > d) d = b.x0 - a.x1;
+    if (a.x0 - b.x1 > d) d = a.x0 - b.x1;
+    if (b.y0 - a.y1 > d) d = b.y0 - a.y1;
+    if (a.y0 - b.y1 > d) d = a.y0 - b.y1;
+    return d;
+}
+
+int zone_gap_to(const GemZone& z, vec2 p) { return box_gap({z.x0, z.y0, z.x1, z.y1}, {p.x, p.y, p.x, p.y}); }
+
+// Gem groups by gems a round (gems over respawn). A zone holding zone_share (> half) of that and at
+// most zone_extent across contains the rate-weighted median tile, so only groups within zone_extent
+// of it are linked (box gaps of at most zone_gap), from the group nearest it. A zone with a Monolith
+// stays the siege's and farm's operation. Static, built once on a turn with zone_build_fuel spare.
+GemZone& gem_zone(const World& world) {
+    static GemZone z;
+    static bool built = false;
+    if (built || !fuel_ok(zone_build_fuel)) return z;
+    built = true;
+    const auto& groups = world.map().groups;
+    const int n = static_cast<int>(groups.size());
+    struct Gem {
+        int g;
+        Box box;
+        float rate;
+    };
+    std::vector<Gem> gems;
+    float total = 0;
+    for (int g = 0; g < n; ++g) {
+        const auto& G = groups[g];
+        if (G.gems <= 0) continue;
+        Box b{1 << 20, 1 << 20, -(1 << 20), -(1 << 20)};
+        for (const auto& m : G.members) b = {std::min(b.x0, m.pos.x), std::min(b.y0, m.pos.y), std::max(b.x1, m.pos.x), std::max(b.y1, m.pos.y)};
+        const float rate = static_cast<float>(G.gems) / static_cast<float>(std::max(1, G.respawn));
+        gems.push_back({g, b, rate});
+        total += rate;
+    }
+    if (gems.empty() || !(total > 0)) return z;
+    const auto median = [&](bool y) {
+        std::vector<std::pair<int, float>> at;
+        at.reserve(gems.size());
+        for (const auto& e : gems) at.emplace_back(y ? groups[e.g].centre.y : groups[e.g].centre.x, e.rate);
+        std::sort(at.begin(), at.end());
+        float run = 0;
+        for (const auto& [v, r] : at)
+            if ((run += r) >= total / 2) return v;
+        return at.back().first;
+    };
+    const vec2 mid{median(false), median(true)};
+    const Box at_mid{mid.x, mid.y, mid.x, mid.y};
+    std::vector<int> near; // indices into gems
+    for (int i = 0; i < static_cast<int>(gems.size()); ++i)
+        if (box_gap(gems[static_cast<std::size_t>(i)].box, at_mid) <= params::zone_extent) near.push_back(i);
+    if (near.empty()) return z;
+    int seed = near[0];
+    for (const int i : near)
+        if (box_gap(gems[static_cast<std::size_t>(i)].box, at_mid) < box_gap(gems[static_cast<std::size_t>(seed)].box, at_mid)) seed = i;
+    std::vector<int> cluster{seed};
+    std::vector<char> in(gems.size(), 0);
+    in[static_cast<std::size_t>(seed)] = 1;
+    for (std::size_t k = 0; k < cluster.size(); ++k)
+        for (const int i : near)
+            if (!in[static_cast<std::size_t>(i)] && box_gap(gems[static_cast<std::size_t>(i)].box, gems[static_cast<std::size_t>(cluster[k])].box) <= params::zone_gap)
+                in[static_cast<std::size_t>(i)] = 1, cluster.push_back(i);
+    float share = 0;
+    Box zb{1 << 20, 1 << 20, -(1 << 20), -(1 << 20)};
+    for (const int i : cluster) {
+        const auto& e = gems[static_cast<std::size_t>(i)];
+        if (groups[e.g].has_monolith) return z;
+        share += e.rate;
+        zb = {std::min(zb.x0, e.box.x0), std::min(zb.y0, e.box.y0), std::max(zb.x1, e.box.x1), std::max(zb.y1, e.box.y1)};
+    }
+    if (!(share >= params::zone_share * total) || std::max(zb.x1 - zb.x0, zb.y1 - zb.y0) + 1 > params::zone_extent) return z;
+    z.member.assign(static_cast<std::size_t>(n), 0);
+    for (const int i : cluster) z.member[static_cast<std::size_t>(gems[static_cast<std::size_t>(i)].g)] = 1;
+    z.x0 = zb.x0, z.y0 = zb.y0, z.x1 = zb.x1, z.y1 = zb.y1;
+    z.on = true;
+    debug_block({ std::printf("GEMZONE %d %d,%d-%d,%d groups %d\n", world.round, z.x0, z.y0, z.x1, z.y1, static_cast<int>(cluster.size())); });
+    return z;
+}
+
+// Stand tiles within zone_stand_radius of the zone's box, the best zone_stand_count: out of every
+// camp member's reach first, then bushes, then nearer the zone, then nearer our spawn.
+void build_stands(const World& world, GemZone& z) {
+    z.stands_built = true;
+    const auto& map = world.map();
+    const int r = params::zone_stand_radius;
+    static bitboard danger{cambc::uninitialized};
+    clear_board(danger);
+    for (const auto& G : map.groups)
+        if (G.strength > 0 && zone_gap_to(z, G.centre) <= r + G.reach + G.threat_radius()) or_into(danger, G.threat(), danger);
+    struct Scored {
+        int score;
+        vec2 p;
+    };
+    std::array<Scored, zone_stand_count> best;
+    int kept = 0;
+    const auto& field = map.from_ally_spawn();
+    for (int x = z.x0 - r; x <= z.x1 + r; ++x)
+        for (int y = z.y0 - r; y <= z.y1 + r; ++y) {
+            const vec2 p{x, y};
+            if (!in_bounds(p)) continue;
+            const int d = zone_gap_to(z, p);
+            if (d == 0 || !test(map.standable, p) || test(map.near_enemy_spawn, p)) continue;
+            const int home = field.at(p);
+            if (home == unreachable) continue;
+            const Scored s{(test(danger, p) ? 1 << 21 : 0) + (test(map.bushes, p) ? 0 : 1 << 20) + (d << 12) + std::min(home, 4095), p};
+            if (kept == zone_stand_count && s.score >= best[kept - 1].score) continue;
+            int at = kept < zone_stand_count ? kept++ : kept - 1;
+            for (; at > 0 && best[static_cast<std::size_t>(at - 1)].score > s.score; --at) best[static_cast<std::size_t>(at)] = best[static_cast<std::size_t>(at - 1)];
+            best[static_cast<std::size_t>(at)] = s;
+        }
+    for (int k = 0; k < kept; ++k) z.stands.push_back(best[static_cast<std::size_t>(k)].p);
+}
+
+// Our walk to the nearest of the zone's camp tiles.
+int steps_to_zone(Pathing& pathing, const World& world, GemZone& z) {
+    if (!z.to_zone) {
+        static bitboard goal{cambc::uninitialized};
+        clear_board(goal);
+        for (int g = 0; g < static_cast<int>(z.member.size()); ++g)
+            if (z.member[static_cast<std::size_t>(g)]) or_into(goal, world.map().groups[g].tiles(), goal);
+        z.to_zone.emplace(make_field(pathing.static_walls(), goal));
+    }
+    return z.to_zone->at(my_position());
+}
+
+// Our rank among living allies by guard_power (ties by index), or -1 past params::zone_guards.
+int zone_rank(const World& world) {
+    const auto& me = world.me();
+    const float mine = guard_power(me);
+    int rank = 0, alive = 0;
+    for (const auto& a : world.allies) {
+        alive += a.alive;
+        if (a.is_self || !a.alive) continue;
+        const float p = guard_power(a);
+        rank += p > mine || (p == mine && a.index < me.index);
+    }
+    return rank < std::min(params::zone_guards, alive - params::zone_farmers_min) ? rank : -1;
+}
+
+bool in_gem_zone(const World& world, int g) {
+    const auto& z = gem_zone(world);
+    return z.on && g >= 0 && g < static_cast<int>(z.member.size()) && z.member[static_cast<std::size_t>(g)];
+}
+
+// A zone guard's turn after the bag, the shop and the altar guard: fight an enemy by the zone (chase
+// prices it), contest an enemy hold, farm the zone's groups only while one is up or pending, and
+// hold our stand tile while a capture is pending or a group returns within our walk plus
+// zone_hold_slack. Anything else is the usual turn: two guards idle through every respawn, or by a
+// group our kite owns, cost more gold than the hold won (gz644: 31.7%).
+bool zone_turn(World& world, Pathing& pathing, Safety& safety, Memory& memory, const Pathing::GuardState& strike_guard) {
+    if (world.round == world.first_round) return false;
+    auto& z = gem_zone(world);
+    if (!z.on) return false;
+    const int rank = zone_rank(world);
+    if (rank < 0) return false;
+    const int walk = steps_to_zone(pathing, world, z);
+    bool workable = false, pending = false;
+    for (int g = 0; g < static_cast<int>(z.member.size()); ++g) {
+        if (!z.member[static_cast<std::size_t>(g)]) continue;
+        const auto& c = world.camps[g];
+        const auto& G = world.map().groups[g];
+        if (c.state == CampState::cleared) pending = true;
+        else if (c.state == CampState::respawning) pending |= c.respawn_round >= 0 && c.respawn_round - world.round <= walk + params::zone_hold_slack;
+        else workable |= !(world.map().shared_gems && big_group(G) && kite_owns(world, g));
+    }
+    if (!workable && !pending) return false;
+    bool near = false;
+    for (const auto& e : world.enemies) near |= e.alive && e.visible && zone_gap_to(z, e.pos) <= params::zone_leash;
+    if (near) {
+        const auto work_guard = pathing.held_guard();
+        pathing.restore_guard(strike_guard);
+        if (chase(world, pathing, safety)) return true;
+        strike_guard_known(pathing, my_position());
+        pathing.restore_guard(work_guard);
+    }
+    if (contest_capture(world, pathing, memory)) {
+        decision = Branch::contest;
+        return true;
+    }
+    // A zone-only farm that finds nothing is tried again only after zone_retry_rounds, so a turn
+    // rarely pays for two farm calls.
+    static int retry = 0;
+    if (world.round >= retry) {
+        decision = Branch::farm;
+        const int claim = memory.claim, group = memory.farm_group;
+        farm_zone_only = true;
+        const bool farmed = farm(world, pathing, safety, memory);
+        farm_zone_only = false;
+        if (farmed) return true;
+        memory.claim = claim, memory.farm_group = group;
+        retry = world.round + params::zone_retry_rounds;
+    }
+    if (!pending) return false;
+    if (!z.stands_built) {
+        if (!fuel_ok(zone_build_fuel)) return false;
+        build_stands(world, z);
+    }
+    if (z.stands.empty()) return false;
+    decision = Branch::hold_zone;
+    memory.claim = -1;
+    memory.farm_group = -1;
+    const int i = rank % static_cast<int>(z.stands.size());
+    const vec2 stand = z.stands[static_cast<std::size_t>(i)];
+    if (!my_can_move() || my_position() == stand) return true;
+    static std::array<std::optional<Field>, zone_stand_count> fields;
+    auto& field = fields[static_cast<std::size_t>(i)];
+    if (!field) {
+        static bitboard goal{cambc::uninitialized};
+        clear_board(goal);
+        set_tile(goal, stand);
+        field.emplace(make_field(pathing.static_walls(), goal));
+    }
+    step_safely(world, pathing, *field, safety);
+    return true;
+}
+
+} // namespace
+
+} // namespace aph
