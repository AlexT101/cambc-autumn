diff --git a/bots/ocean/src/economy/gem_zone.cc b/bots/ocean/src/economy/gem_zone.cc
new file mode 100644
index 000000000..06d91bfce
--- /dev/null
+++ b/bots/ocean/src/economy/gem_zone.cc
@@ -0,0 +1,111 @@
+// Gem zones (research/ideas-2026-11-08/gem-zone.md): on a map whose gem income lies in one small
+// area, farm weighs that area's groups at params::zone_worth (farm.cc's MirrorPull). By symmetry
+// such an area is shared: the top teams take it (00stampede, 00ribs) while we farm gold elsewhere.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+constexpr std::uint64_t zone_build_fuel = 80000; // spare fuel the turn that builds the zone needs
+
+struct GemZone {
+    bool on = false;
+    std::vector<char> member;             // by group
+    int x0 = 0, y0 = 0, x1 = -1, y1 = -1; // the members' box
+};
+
+struct Box {
+    int x0, y0, x1, y1;
+};
+
+int box_gap(const Box& a, const Box& b) {
+    int d = 0;
+    if (b.x0 - a.x1 > d) d = b.x0 - a.x1;
+    if (a.x0 - b.x1 > d) d = a.x0 - b.x1;
+    if (b.y0 - a.y1 > d) d = b.y0 - a.y1;
+    if (a.y0 - b.y1 > d) d = a.y0 - b.y1;
+    return d;
+}
+
+// Gem groups by gems a round (gems over respawn). A zone holding zone_share (> half) of that and at
+// most zone_extent across contains the rate-weighted median tile, so only groups within zone_extent
+// of it are linked (box gaps of at most zone_gap), from the group nearest it. A zone with a Monolith
+// stays the siege's and farm's operation. Static, built once on a turn with zone_build_fuel spare.
+GemZone& gem_zone(const World& world) {
+    static GemZone z;
+    static bool built = false;
+    if (built || !fuel_ok(zone_build_fuel)) return z;
+    built = true;
+    const auto& groups = world.map().groups;
+    const int n = static_cast<int>(groups.size());
+    struct Gem {
+        int g;
+        Box box;
+        float rate;
+    };
+    std::vector<Gem> gems;
+    float total = 0;
+    for (int g = 0; g < n; ++g) {
+        const auto& G = groups[g];
+        if (G.gems <= 0) continue;
+        Box b{1 << 20, 1 << 20, -(1 << 20), -(1 << 20)};
+        for (const auto& m : G.members) b = {std::min(b.x0, m.pos.x), std::min(b.y0, m.pos.y), std::max(b.x1, m.pos.x), std::max(b.y1, m.pos.y)};
+        const float rate = static_cast<float>(G.gems) / static_cast<float>(std::max(1, G.respawn));
+        gems.push_back({g, b, rate});
+        total += rate;
+    }
+    if (gems.empty() || !(total > 0)) return z;
+    const auto median = [&](bool y) {
+        std::vector<std::pair<int, float>> at;
+        at.reserve(gems.size());
+        for (const auto& e : gems) at.emplace_back(y ? groups[e.g].centre.y : groups[e.g].centre.x, e.rate);
+        std::sort(at.begin(), at.end());
+        float run = 0;
+        for (const auto& [v, r] : at)
+            if ((run += r) >= total / 2) return v;
+        return at.back().first;
+    };
+    const vec2 mid{median(false), median(true)};
+    const Box at_mid{mid.x, mid.y, mid.x, mid.y};
+    std::vector<int> near; // indices into gems
+    for (int i = 0; i < static_cast<int>(gems.size()); ++i)
+        if (box_gap(gems[static_cast<std::size_t>(i)].box, at_mid) <= params::zone_extent) near.push_back(i);
+    if (near.empty()) return z;
+    int seed = near[0];
+    for (const int i : near)
+        if (box_gap(gems[static_cast<std::size_t>(i)].box, at_mid) < box_gap(gems[static_cast<std::size_t>(seed)].box, at_mid)) seed = i;
+    std::vector<int> cluster{seed};
+    std::vector<char> in(gems.size(), 0);
+    in[static_cast<std::size_t>(seed)] = 1;
+    for (std::size_t k = 0; k < cluster.size(); ++k)
+        for (const int i : near)
+            if (!in[static_cast<std::size_t>(i)] && box_gap(gems[static_cast<std::size_t>(i)].box, gems[static_cast<std::size_t>(cluster[k])].box) <= params::zone_gap)
+                in[static_cast<std::size_t>(i)] = 1, cluster.push_back(i);
+    float share = 0;
+    Box zb{1 << 20, 1 << 20, -(1 << 20), -(1 << 20)};
+    for (const int i : cluster) {
+        const auto& e = gems[static_cast<std::size_t>(i)];
+        if (groups[e.g].has_monolith) return z;
+        share += e.rate;
+        zb = {std::min(zb.x0, e.box.x0), std::min(zb.y0, e.box.y0), std::max(zb.x1, e.box.x1), std::max(zb.y1, e.box.y1)};
+    }
+    if (!(share >= params::zone_share * total) || std::max(zb.x1 - zb.x0, zb.y1 - zb.y0) + 1 > params::zone_extent) return z;
+    z.member.assign(static_cast<std::size_t>(n), 0);
+    for (const int i : cluster) z.member[static_cast<std::size_t>(gems[static_cast<std::size_t>(i)].g)] = 1;
+    z.x0 = zb.x0, z.y0 = zb.y0, z.x1 = zb.x1, z.y1 = zb.y1;
+    z.on = true;
+    debug_block({ std::printf("GEMZONE %d %d,%d-%d,%d groups %d\n", world.round, z.x0, z.y0, z.x1, z.y1, static_cast<int>(cluster.size())); });
+    return z;
+}
+
+bool gem_zone_on(const World& world) { return gem_zone(world).on; }
+
+bool in_gem_zone(const World& world, int g) {
+    const auto& z = gem_zone(world);
+    return z.on && g >= 0 && g < static_cast<int>(z.member.size()) && z.member[static_cast<std::size_t>(g)];
+}
+
+} // namespace
+
+} // namespace aph
