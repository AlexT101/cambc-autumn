+// An ally claims g and its lone hold would pay the team more than ours (value_holder's terms): our
+// work there feeds a better holder. Intercontinental Fish and Mite clear beside such an ally and let it hold.
+bool claimed_by_better_holder(const World& world, int g) {
+    const auto& G = world.map().groups[g];
+    if (G.has_monolith || G.gems + G.gold <= 0 || holders(G) != 1) return false;
+    float mine = -1;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || comms::claim_of(world, a.index) != g) continue;
+        if (mine < 0) mine = holder_value(world, world.me(), G, holder_gold_price);
+        if (holder_value(world, a, G, holder_gold_price) > mine + 1e-3f) return true;
+    }
+    return false;
+}
