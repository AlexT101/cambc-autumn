diff -ruN -x .cambc oc-base26/src/model/context.h oc-ctx-g2-26/src/model/context.h
--- oc-base26/src/model/context.h	1970-01-01 00:00:00.000000000 +0000
+++ oc-ctx-g2-26/src/model/context.h	2026-11-08 11:43:52.382252422 +0000
@@ -0,0 +1,100 @@
+#pragma once
+// Context knobs (research/ideas-2026-11-08/context-knobs.md): a knob as a function of the map and the game state,
+//   x = clamp(base + sum_i w_i f_i, lo, hi),
+// base the knob's global constant (tuned on its own; these terms are offsets on it, so the two compose). A gate is the
+// sign of the same sum. Map features come from the draft's PlanFacts (draft.cc condition_on_map sets them once);
+// state features are read in play, and only by knobs with a nonzero state weight. All weights zero: the knob is its
+// constant, at compile time.
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace aph::ctx {
+
+enum Feature : int {
+    // Map: indicators, then standardised logs (mean and SD over ladder-mix suites, fresh-63xxxx and -67xxxx).
+    one_site,    // the altar tiles form one site (tiles within Chebyshev 3 merged)
+    short_spawn, // the spawn-to-spawn walk is at most short_spawn_max
+    long_spawn,  // ... over long_spawn_min
+    multi_short, // several sites and a short walk
+    multi_long,  // several sites and a long walk
+    z_area,      // log(width * height)
+    z_spawn,     // log(spawn walk)
+    z_gems,      // log(1 + gems a side)
+    z_altars,    // log(altar tiles)
+    map_count,
+    // State, read at the knob's use.
+    score_gap = map_count, // (ally - enemy tributed gems) / 100
+    round_frac,            // round / 2000
+    alive_gap,             // allies alive - enemies alive
+    count
+};
+using Weights = std::array<float, count>;
+
+inline constexpr int short_spawn_max = 40, long_spawn_min = 73;
+inline constexpr float mu_area = 7.895f, sd_area = 0.754f, mu_spawn = 3.964f, sd_spawn = 0.694f, mu_gems = 5.189f,
+                       sd_gems = 0.754f, mu_altars = 0.812f, sd_altars = 0.598f;
+
+struct MapContext {
+    bool set = false;
+    std::array<float, map_count> f{};
+};
+inline MapContext& map_context() {
+    static MapContext m;
+    return m;
+}
+// From the map facts: spawn_dist < 0 for spawns not joined on foot (counted as long), sites 0 for no altar.
+inline void set_map(int width, int height, int spawn_dist, int altars, int gems_side, int sites) {
+    auto& m = map_context();
+    m.set = true;
+    const float s = spawn_dist < 0 ? 1e4f : static_cast<float>(spawn_dist);
+    m.f[one_site] = sites == 1 ? 1.0f : 0.0f;
+    m.f[short_spawn] = s <= static_cast<float>(short_spawn_max) ? 1.0f : 0.0f;
+    m.f[long_spawn] = s > static_cast<float>(long_spawn_min) ? 1.0f : 0.0f;
+    m.f[multi_short] = sites > 1 ? m.f[short_spawn] : 0.0f;
+    m.f[multi_long] = sites > 1 ? m.f[long_spawn] : 0.0f;
+    m.f[z_area] = (std::log(static_cast<float>(std::max(1, width * height))) - mu_area) / sd_area;
+    m.f[z_spawn] = (std::log(std::clamp(s, 1.0f, 400.0f)) - mu_spawn) / sd_spawn;
+    m.f[z_gems] = (std::log1p(static_cast<float>(std::max(0, gems_side))) - mu_gems) / sd_gems;
+    m.f[z_altars] = (std::log(static_cast<float>(std::max(1, altars))) - mu_altars) / sd_altars;
+}
+
+struct State {
+    float score_gap = 0, round_frac = 0, alive_gap = 0;
+};
+
+constexpr bool zero(const Weights& w) {
+    for (const float v : w)
+        if (v != 0) return false;
+    return true;
+}
+constexpr bool uses_state(const Weights& w) {
+    for (int i = map_count; i < count; ++i)
+        if (w[i] != 0) return true;
+    return false;
+}
+
+// The sum of the terms; `state` (a callable returning State) is called only if W reads state.
+template <const Weights& W, class StateFn> float terms(StateFn&& state) {
+    float sum = 0;
+    if (const auto& m = map_context(); m.set)
+        for (int i = 0; i < map_count; ++i) sum += W[i] * m.f[i];
+    if constexpr (uses_state(W)) {
+        const State s = state();
+        sum += W[score_gap] * s.score_gap + W[round_frac] * s.round_frac + W[alive_gap] * s.alive_gap;
+    }
+    return sum;
+}
+inline State no_state() { return {}; }
+
+template <const Weights& W, class StateFn = State (*)()> float knob(float base, float lo, float hi, StateFn&& state = no_state) {
+    if constexpr (zero(W)) return base;
+    else return std::clamp(base + terms<W>(state), lo, hi);
+}
+// A gate: on where base + the terms is positive.
+template <const Weights& W, class StateFn = State (*)()> bool gate(float base, StateFn&& state = no_state) {
+    if constexpr (zero(W)) return base > 0;
+    else return base + terms<W>(state) > 0;
+}
+
+} // namespace aph::ctx
