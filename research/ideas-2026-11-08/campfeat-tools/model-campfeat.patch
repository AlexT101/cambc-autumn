+// campfeat: out-of-fold logits per game (map-grouped folds) at the lab's initial_lam.
+function cvdumpCommand(o) {
+  const lab = o.lab, table = mapTable(lab), rows = gameRows(lab, table), cfg = readJson(path.join(lab, 'config.json'), {});
+  const lam = { ...OPP_LAM, ...cfg.initial_lam, ...(o.lam ? JSON.parse(o.lam) : {}) };
+  startPool(rows, +(o.threads ?? 8), true);
+  const warm = fitAll(poolView(-1, 0), lam, 0), out = [];
+  let loss = 0, n = 0;
+  for (let k = 0; k < FOLDS; k++) {
+    const fit = fitAll(poolView(k, 0), lam, 0, warm);
+    for (const r of rows) if (r.fold === k) { const e = dot(fit.picks[r.picks].theta, r); loss += softplus(e) - r.win * e; n++; out.push(`${r.key} ${r.picks} ${r.win} ${e.toFixed(6)}`); }
+    console.error(`fold ${k} done`);
+  }
+  stopPool();
+  fs.writeFileSync(o.out, out.join('\n') + '\n');
+  console.log(`cv ${(loss / n).toFixed(6)} on ${n} games; lam ${JSON.stringify(lam)}`);
+}
+// campfeat: per map and pick count, each champion's base score b_c + w_c . z (and the synergy vector once per pick count).
+function basesCommand(o) {
+  const table = mapTable(o.lab), m = readJson(o.model), out = [];
+  if (m.features.join() !== FEAT.map(f => f[0]).join()) throw new Error('features differ');
+  const lay = m.layout;
+  for (const p of PICKS) out.push(`S ${p} ${Array.from({ length: PAIRS.length }, (_, j) => m.picks[p].theta[lay.SYN + j]).join(' ')}`);
+  for (const mp of table.maps) for (const p of PICKS) {
+    const th = m.picks[p].theta, b = [];
+    for (let c = 0; c < NC; c++) { let v = th[lay.B + c]; for (let k = 0; k < K; k++) v += th[lay.W + c * K + k] * mp.z[k]; b.push(v.toFixed(6)); }
+    out.push(`B ${mp.key} ${p} ${mp.picks} ${b.join(' ')}`);
+  }
+  fs.writeFileSync(o.out, out.join('\n') + '\n');
+}
+// campfeat: in-sample logits of a model.json (same features as the lab) per game, with the team lists.
+function predictCommand(o) {
+  const lab = o.lab, table = mapTable(lab), rows = gameRows(lab, table), m = readJson(o.model);
+  if (m.features.join() !== FEAT.map(f => f[0]).join()) throw new Error('features differ');
+  const dm = Math.max(...m.mean.map((v, k) => Math.abs(v - table.mean[k]))); console.error(`max mean diff ${dm}`);
+  const out = rows.map(r => `${r.key} ${r.picks} ${r.win} ${dot(m.picks[r.picks].theta, r).toFixed(6)} ${r.A.join(',')} ${r.B.join(',')} ${r.fold} ${r.half}`);
+  fs.writeFileSync(o.out, out.join('\n') + '\n');
+}
+// campfeat: a fit on one half of the maps (hash(key#half) % 2 == half), as model.json.
+function halffitCommand(o) {
+  const lab = o.lab, table = mapTable(lab), rows = gameRows(lab, table), cfg = readJson(path.join(lab, 'config.json'), {});
+  const lam = { ...OPP_LAM, ...cfg.initial_lam, ...(o.lam ? JSON.parse(o.lam) : {}) }, h = +o.half;
+  startPool(rows, +(o.threads ?? 8), true);
+  const fit = fitAll(h >= 0 ? poolView(-1, 0, 0, 1 - h) : poolView(-1, 0), lam, 0);
+  stopPool();
+  const round = a => Array.from(a, v => +v.toPrecision(7));
+  fs.writeFileSync(o.out, JSON.stringify({ half: h, features: FEAT.map(f => f[0]), transforms: FEAT.map(f => f[1] ?? null), mean: table.mean, sd: table.sd,
+    layout: L, lam, picks: Object.fromEntries(PICKS.map(p => [p, { theta: round(fit.picks[p].theta) }])) }));
+  console.log(`halffit ${h}: ${rows.filter(r => h < 0 || r.half === h).length} games`);
+}
