diff -ruN -x .cambc -x compile_commands.json chy-ref/src/model/kill_zone.cc rk1np/src/model/kill_zone.cc
--- chy-ref/src/model/kill_zone.cc	1970-01-01 00:00:00.000000000 +0000
+++ rk1np/src/model/kill_zone.cc	2026-11-13 08:17:37.008909526 +0000
@@ -0,0 +1,443 @@
+#include "kill_zone.h"
+#include <algorithm>
+#include <bit>
+#include <vector>
+#include "enemy_reach.h"
+#include "pathing.h"
+#include "safety.h"
+#include "world.h"
+
+namespace aph::kill_zone {
+
+namespace {
+
+// What `a` deals its victim, at each distance from where a's next turn (in round `first`) starts,
+// before the victim acts again: that turn's strike, or with a ready stun on a stunnable victim the
+// stun's turn and the turn the stun hands back (round first + 1, the stun's slot cooling then).
+// `ready(slot, round)`.
+struct Burst {
+    std::array<float, Strike::max_reach + 1> damage{};
+    bool stun = false;   // some distance's best opens with a stun
+    bool unit = false;   // that stun is a walk-excluding unit cast: it needs a visible target from where it stands
+    int one = -1;        // farthest distance its one-turn strike (walks and dashes in) kills at, set by the caller
+    bool ground = false; // a ground spell is in that burst
+};
+
+template <class Ready> Burst burst_of(const ChampionBelief& a, int first, bool stunnable, Ready&& ready) {
+    Burst b;
+    const auto& f = a.facts();
+    const unsigned now = (ready(0, first) ? 1u : 0u) | (ready(1, first) ? 2u : 0u);
+    const unsigned later = (ready(0, first + 1) ? 1u : 0u) | (ready(1, first + 1) ? 2u : 0u);
+    const Strike& one = strike_with(a, now);
+    for (int d = 0; d <= Strike::max_reach; ++d) b.damage[static_cast<std::size_t>(d)] = one.at(d);
+    if (!stunnable) return b;
+    for (int s = 0; s < 2; ++s) {
+        const auto& ab = f.abilities[static_cast<std::size_t>(s)];
+        if (!(now >> s & 1) || !ab.stuns) continue;
+        const Strike& st = strike_with(a, 1u << s);
+        // A slot cast on the stun's turn is not back the round after (rules abilities.cooldown).
+        const unsigned rest = later & ~(1u << s);
+        const Strike& next = strike_with(a, rest);
+        bool used = false;
+        for (int d = 1; d <= st.reach; ++d) {
+            if (!st.stuns[static_cast<std::size_t>(d)]) continue;
+            // A walk or a dash on the stun's turn leaves it nearer for the next.
+            const int d2 = ab.kind == AbilityKind::dash ? std::min(d, 1) : ab.excludes_walking ? d : std::max(1, d - 1);
+            const float total = st.at(d) + next.at(d2);
+            if (total > b.damage[static_cast<std::size_t>(d)]) b.damage[static_cast<std::size_t>(d)] = total, used = true;
+        }
+        if (!used) continue;
+        b.stun = true;
+        b.unit |= ab.target == Targeting::unit && ab.excludes_walking;
+        for (int t = 0; t < 2; ++t) {
+            const auto& o = f.abilities[static_cast<std::size_t>(t)];
+            b.ground |= (t == s || (rest >> t & 1)) && o.target == Targeting::ground && o.hits_enemies();
+        }
+    }
+    return b;
+}
+
+struct Key {
+    int round = -1;
+    std::uint32_t observations = 0, stun_reads = 0, generation = 0;
+    float life = -1;
+    bool cast = false;
+    bool operator==(const Key&) const = default;
+};
+
+Model model_;
+Key key_;
+
+// Debug: the parts that fired this turn.
+struct Trace {
+    int round = -1;
+    std::uint32_t handle = 0;
+    char parts[24]{};
+    int n = 0;
+    int killers = 0;
+};
+Trace trace_;
+
+bool window_has(const Reach::Window& w, vec2 offset) {
+    return static_cast<bool>(w & Reach::Window::bit(Reach::Window::at(offset.x, offset.y)));
+}
+
+} // namespace
+
+std::uint32_t Model::at(const World& world, vec2 p, bool acting) const {
+    std::uint32_t bits = 0;
+    for (int i = 0; i < n; ++i) {
+        const auto& k = killers[static_cast<std::size_t>(i)];
+        if (acting && k.turns == 0) continue;
+        const int d = dist(p, k.at);
+        if (d > k.radius) continue;
+        if (k.sight && d <= ability_range && !window_has(k.seen, {p.x - k.at.x, p.y - k.at.y})) continue;
+        // A turn ended on our spawn heals us to full first (rules rounds.turn_end).
+        if (!k.full && test(world.map().ally_spawn, p)) continue;
+        bits |= 1u << i;
+    }
+    return bits;
+}
+
+bool reads(const World& world) {
+    if constexpr (params::kz_prism && params::kz_allies) return true;
+    else return world.me().facts().passive == Passive::gem_focus ? params::kz_prism : params::kz_allies;
+}
+
+const Model& none() {
+    static const Model empty;
+    return empty;
+}
+
+bool Model::near(vec2 p, int r) const {
+    for (int i = 0; i < n; ++i)
+        if (dist(p, killers[static_cast<std::size_t>(i)].at) <= killers[static_cast<std::size_t>(i)].radius + r) return true;
+    return false;
+}
+
+const Model& model(const World& world, Safety& safety) {
+    const auto& me = world.me();
+    if (!me.alive) {
+        model_.n = 0;
+        return model_;
+    }
+    const Key now{world.round, world.observations, world.stun_reads, Safety::generation(), my_health_and_shield(world), my_can_cast()};
+    if (now == key_) return model_;
+    key_ = now;
+    auto& m = model_;
+    m.n = 0;
+    ++m.stamp;
+    // Short of fuel no zones: every reader then acts as before.
+    if (!fuel_ok(params::refine_fuel / 2)) return m;
+    const float life = now.life, taken = me.taken;
+    const float full_life = my_max_health() + my_live_shield(world);
+    const bool stunnable = me.facts().passive != Passive::stun_immune;
+    const vec2 here = my_position();
+    // Our burst on our turn: a slot cast now (and the cast unspent), the next turn's ready in time.
+    std::array<int, 2> cooldown{};
+    bool cooldowns_read = false;
+    const auto ours = [&](int s, int round) {
+        if (!cooldowns_read) {
+            cooldowns_read = true;
+            for (int t = 0; t < 2; ++t) cooldown[static_cast<std::size_t>(t)] = my_cooldown(t);
+        }
+        // It ticks at each of our turn ends.
+        return cooldown[static_cast<std::size_t>(s)] <= round - world.round && (round > world.round || now.cast);
+    };
+    for (const auto& e : world.enemies) {
+        if (m.n == static_cast<int>(m.killers.size())) break;
+        if (!e.alive || !in_bounds(e.pos)) continue;
+        if (!e.visible && !(e.tracked && e.pos_round >= 0 && world.round - e.pos_round <= params::track_horizon)) continue;
+        const vec2 from = enemy_reach::origin(e);
+        // Beyond any burst's reach and a walk for each of two turns.
+        if (dist(here, from) > Strike::max_reach + vision_radius) continue;
+        const int turns = turns_before_ours(world, e);
+        // A stun takes its next turn: with no other before ours, it acts again only after ours.
+        if (turn_lost(e) && turns == 0) continue;
+        const int first = next_turn_round(world, e);
+        const auto theirs = [&](int s, int round) { return e.cooldowns_uncertain() || e.ability_ready(s, round); };
+        const auto kill_reach = [&](const Burst& x) {
+            for (int d = Strike::max_reach; d >= 1; --d)
+                if (x.damage[static_cast<std::size_t>(d)] * taken >= life) return d;
+            return -1;
+        };
+        Burst b = burst_of(e, first, stunnable, theirs);
+        int r = kill_reach(b);
+        const Strike& plain = strike_with(e, (theirs(0, first) ? 1u : 0u) | (theirs(1, first) ? 2u : 0u));
+        for (int d = Strike::max_reach; d >= 1 && b.one < 0; --d)
+            if (plain.at(d) * taken >= life) b.one = d;
+        // Two turns before our next: a walk on the first, then the burst (which may start on the second,
+        // with what is ready by then).
+        int r2 = -1;
+        if (turns >= 2) {
+            const Burst late = burst_of(e, first + 1, stunnable, theirs);
+            if (const int k = kill_reach(late); k >= 0) r2 = k + 1, b.ground |= late.ground && late.stun;
+            if (r >= 0) ++r;
+        }
+        r = std::max(r, r2);
+        if (r < 0) continue;
+        // One-sided: our own burst does not kill it from where we stand this turn (the strike tables walk
+        // us in): that standoff is the strike search's to price. Anywhere else it acts first.
+        const float their_life = e.health + e.shield;
+        const Burst back = burst_of(me, world.round, e.facts().passive != Passive::stun_immune, ours);
+        if (const int d0 = dist(here, from); d0 >= 1 && d0 <= Strike::max_reach && back.damage[static_cast<std::size_t>(d0)] * e.taken >= their_life)
+            continue;
+        Killer k;
+        k.enemy = e.index;
+        k.at = from;
+        k.turns = turns;
+        k.burst = b.damage[1] * taken;
+        k.full = k.burst >= full_life;
+        k.prism = e.facts().passive == Passive::gem_focus;
+        // A ground spell needs neither sight nor a target and its area reaches past its range: the
+        // tile past the kill's reach too (measured: P(death) by a ready Prism .37 at 5, .10 at 6).
+        if (b.stun && b.ground) ++r;
+        // Sight bounds only a kill that needs a walk-excluding unit stun from where it stands.
+        k.sight = b.stun && b.unit && !b.ground && b.one < 0 && turns < 2 && !test(world.map().bushes, from);
+        k.radius = r;
+        if (k.sight) k.seen = seen_from(world, from, ability_range);
+        // Contested: our side wins the fight there, with allies at hand.
+        bool allies = false;
+        for (const auto& a : world.allies)
+            allies |= !a.is_self && a.alive && a.visible && dist(a.pos, from) <= safety_params::fight_ally_radius;
+        if (allies && fuel_ok(safety.fight_cost_estimate() + params::refine_fuel) && !safety.fight(from, false).lost) {
+            debug_block({ note('c'); });
+            continue;
+        }
+        m.killers[static_cast<std::size_t>(m.n++)] = k;
+    }
+    debug_block({
+        if (m.n > 0) {
+            if (trace_.round != world.round) note('-');
+            trace_.killers = std::max(trace_.killers, m.n);
+        }
+    });
+    return m;
+}
+
+namespace {
+
+// How deep p lies in the zones `bits` holds it in: its margins to their edges, summed.
+int depth(const Model& m, vec2 p, std::uint32_t bits) {
+    int sum = 0;
+    for (auto left = bits; left; left &= left - 1) {
+        const auto& k = m[std::countr_zero(left)];
+        sum += k.radius + 1 - dist(p, k.at);
+    }
+    return sum;
+}
+
+// A step from `here` (in zones bh) onto q (in zones bq) leads out: no zone gained, and fewer zones or
+// less deep in them.
+bool leads_out(const Model& m, vec2 here, std::uint32_t bh, vec2 q, std::uint32_t bq) {
+    if (bq & ~bh) return false;
+    return std::popcount(bq) < std::popcount(bh) || depth(m, q, bq) < depth(m, here, bh);
+}
+
+bool keep_off_in(const World& world, const Model& m, vec2 here, vec2 q) {
+    if (!m.n) return false;
+    const std::uint32_t bq = m.at(world, q);
+    return bq && !leads_out(m, here, m.at(world, here), q, bq);
+}
+
+} // namespace
+
+bool keep_off(const World& world, Safety& safety, vec2 here, vec2 q) { return keep_off_in(world, model(world, safety), here, q); }
+
+const bitboard* scratch(int slot) {
+    static bitboard s0{cambc::uninitialized}, s1{cambc::uninitialized}, s2{cambc::uninitialized}, s3{cambc::uninitialized};
+    return (slot & 3) == 0 ? &s0 : (slot & 3) == 1 ? &s1 : (slot & 3) == 2 ? &s2 : &s3;
+}
+
+const bitboard* with_zones(const World& world, Safety& safety, vec2 here, int radius, const bitboard* guard, int slot) {
+    const auto& m = model(world, safety);
+    if (!m.n || !m.near(here, radius)) return guard;
+    bitboard& out = *const_cast<bitboard*>(scratch(slot));
+    bool copied = false;
+    for (int dy = -radius; dy <= radius; ++dy)
+        for (int dx = -radius; dx <= radius; ++dx) {
+            const vec2 q{here.x + dx, here.y + dy};
+            if ((dx == 0 && dy == 0) || !in_bounds(q) || !keep_off_in(world, m, here, q)) continue;
+            if (!copied) {
+                copied = true;
+                if (guard) copy_into(*guard, out);
+                else clear_board(out);
+            }
+            set_tile(out, q);
+        }
+    debug_block({
+        if (copied) note('g');
+    });
+    return copied ? &out : guard;
+}
+
+namespace {
+
+struct GroupZone {
+    int last = -1000;      // the last round it was wholly zoned
+    std::uint32_t by = 0;  // the killers then, by enemy index
+    int round = -1;        // `factor`'s
+    std::uint32_t stamp = 0;
+    int range = -1;
+    float factor = 1;
+};
+std::vector<GroupZone> group_zones;
+int last_drop = -1000; // the last round any group was wholly zoned
+
+// The share of g's work tiles outside the zones, 1 with none near.
+float work_share(const World& world, const Model& m, int g, int range, std::uint32_t& by) {
+    const auto& map = world.map();
+    const auto& G = map.groups[static_cast<std::size_t>(g)];
+    const auto& c = world.camps[static_cast<std::size_t>(g)];
+    const bool prism = world.me().facts().passive == Passive::gem_focus;
+    const auto radius = [&](const Killer& k) { return prism && k.prism ? std::max(k.radius, prism_farm_radius) : k.radius; };
+    const bool cleared = c.state == CampState::cleared;
+    // Distance alone first: most groups lie far from every zone.
+    int extent = 0;
+    for (std::size_t i = 0; i < G.members.size(); ++i) extent = std::max(extent, dist(G.centre, G.members[i].pos));
+    const int reach = extent + (cleared ? 0 : range);
+    bool near = false, full = false;
+    by = 0;
+    for (int i = 0; i < m.n; ++i)
+        if (const auto& k = m[i]; dist(G.centre, k.at) <= radius(k) + reach) near = true, full |= k.full, by |= 1u << k.enemy;
+    if (!near) return 1;
+    static bitboard work{cambc::uninitialized}, zone{cambc::uninitialized};
+    if (cleared) {
+        copy_into(G.tiles(), work);
+    } else {
+        clear_board(work);
+        const bool respawning = c.state == CampState::respawning;
+        for (std::size_t i = 0; i < G.members.size(); ++i)
+            if (respawning || c.health[i] > 0) draw_square(work, G.members[i].pos, static_cast<float>(range));
+        and_into(work, map.standable, work);
+    }
+    const auto total = board_count(work);
+    if (total == 0) return 1;
+    clear_board(zone);
+    for (int i = 0; i < m.n; ++i)
+        if (const auto& k = m[i]; dist(G.centre, k.at) <= radius(k) + reach) draw_square(zone, k.at, static_cast<float>(radius(k)));
+    if (!full) drop(zone, map.ally_spawn);
+    drop(work, zone);
+    return static_cast<float>(board_count(work)) / static_cast<float>(total);
+}
+
+} // namespace
+
+bool zoning(const World& world, const Model& m) { return m.n > 0 || world.round - last_drop <= 2; }
+
+float farm_factor(const World& world, const Model& m, int g, int range) {
+    if (g < 0 || g >= static_cast<int>(world.camps.size()) || !zoning(world, m)) return 1;
+    if (static_cast<int>(group_zones.size()) != static_cast<int>(world.camps.size())) group_zones.assign(world.camps.size(), {});
+    auto& z = group_zones[static_cast<std::size_t>(g)];
+    if (z.round == world.round && z.stamp == m.stamp && z.range == range) return z.factor;
+    z.round = world.round, z.stamp = m.stamp, z.range = range;
+    std::uint32_t by = 0;
+    float f = m.n && fuel_ok(params::refine_fuel / 2) ? work_share(world, m, g, range, by) : 1.0f;
+    if (f <= 0) {
+        z.last = last_drop = world.round;
+        z.by = by;
+    } else if (z.by && world.round - z.last <= 2) {
+        // Dropped for a zone: it stays dropped until that killer has been out of reach of it for
+        // 2 rounds (turn order alternates every round), or is dead.
+        bool alive = false;
+        for (auto left = z.by; left; left &= left - 1) alive |= world.enemies[static_cast<std::size_t>(std::countr_zero(left))].alive;
+        if (alive) f = 0;
+        else z.by = 0;
+    }
+    z.factor = f;
+    return f;
+}
+
+bool altar_zoned(const World& world, Safety& safety, int altar) {
+    const auto& m = model(world, safety);
+    if (!m.n) return false;
+    const vec2 a = world.map().altars[static_cast<std::size_t>(altar)].pos;
+    if (!m.near(a, cambc::constants::submit_gems_range)) return false;
+    const auto& open = world.map().open_for_us;
+    bool any = false;
+    for (int dy = -1; dy <= 1; ++dy)
+        for (int dx = -1; dx <= 1; ++dx) {
+            const vec2 q{a.x + dx, a.y + dy};
+            if (!in_bounds(q) || !test(open, q)) continue;
+            any = true;
+            if (!m.at(world, q)) return false;
+        }
+    return any;
+}
+
+bool killer_at(const World& world, Safety& safety, vec2 p, int& enemy) {
+    const auto& m = model(world, safety);
+    enemy = -1;
+    if (!m.n) return false;
+    const std::uint32_t bits = m.at(world, p, true);
+    if (!bits) return false;
+    if (std::popcount(bits) == 1) enemy = m[std::countr_zero(bits)].enemy;
+    return true;
+}
+
+int radius_of(const World& world, Safety& safety, int enemy) {
+    const auto& m = model(world, safety);
+    for (int i = 0; i < m.n; ++i)
+        if (m[i].enemy == enemy) return m[i].radius;
+    return -1;
+}
+
+bool step_out(const World& world, Pathing& pathing, Safety& safety) {
+    if (!my_can_move()) return false;
+    const auto& m = model(world, safety);
+    if (!m.n) return false;
+    const vec2 here = my_position();
+    const std::uint32_t bh = m.at(world, here);
+    if (!bh) return false;
+    struct Option {
+        vec2 p;
+        int zones, depth;
+        float damage;
+    };
+    std::array<Option, 8> options;
+    int n = 0;
+
+    const auto& blocked = pathing.blocked();
+    const auto* guard = pathing.guard();
+    const auto& open = world.map().open_for_us;
+    for (const auto d : directions) {
+        const vec2 q = here + d;
+        if (!in_bounds(q) || !test(open, q) || test(blocked, q) || (guard && test(*guard, q))) continue;
+        const std::uint32_t bq = m.at(world, q);
+        if (!leads_out(m, here, bh, q, bq)) continue;
+        options[static_cast<std::size_t>(n++)] = {q, std::popcount(bq), depth(m, q, bq), safety.damage_bound(q, false, world.me().taken)};
+    }
+    std::sort(options.begin(), options.begin() + n, [](const Option& a, const Option& b) {
+        if (a.zones != b.zones) return a.zones < b.zones;
+        if (a.damage != b.damage) return a.damage < b.damage;
+        return a.depth < b.depth;
+    });
+    for (int i = 0; i < n; ++i)
+        if (pathing.try_move(options[static_cast<std::size_t>(i)].p)) {
+            debug_block({ note('o'); });
+            return true;
+        }
+    return false;
+}
+
+void note(char part) {
+    const auto round = static_cast<int>(cambc::round_number());
+    if (trace_.round != round) trace_ = {}, trace_.round = round, trace_.handle = my_handle();
+    if (part == '-' || trace_.n >= static_cast<int>(sizeof(trace_.parts)) - 1) return;
+    for (int i = 0; i < trace_.n; ++i)
+        if (trace_.parts[i] == part) return;
+    trace_.parts[trace_.n++] = part;
+}
+
+void print(const World& world) {
+    if (trace_.round != world.round || (trace_.n == 0 && trace_.killers == 0)) return;
+    trace_.parts[trace_.n] = 0;
+    const auto& m = model_;
+    std::printf("KZ %d %u k%d %s", world.round, my_handle(), trace_.killers, trace_.n ? trace_.parts : "-");
+    if (key_.round == world.round)
+        for (int i = 0; i < m.n; ++i)
+            std::printf(" e%d:r%d:t%d:d%d:b%.0f", m[i].enemy, m[i].radius, m[i].turns, dist(my_position(), m[i].at), m[i].burst);
+    std::printf("\n");
+}
+
+} // namespace aph::kill_zone
