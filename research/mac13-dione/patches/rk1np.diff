+    if (follow <= 0) return false;
+    // The lost turn still ends: on our spawn it heals us to full first (rules abilities.stun).
+    const bool dies = test(world_.map().ally_spawn, p) ? follow >= health : first - cost + follow >= health;
+    debug_block({
+        static int last_round = -1;
+        static vec2 last{-1, -1};
+        if (dies && (last_round != world_.round || last != p)) {
+            last_round = world_.round, last = p;
+            std::printf("PZFIX3 %d %u %d %d hp %.0f first %.0f cost %.0f follow %.0f\n", world_.round, my_handle(), p.x, p.y, health, first,
+                        cost, follow);
+        }
+    });
+    return dies;
+}
+
+bool Safety::stunner_near(vec2 p) {
+    if (world_.me().facts().passive == Passive::stun_immune) return false;
+    for (auto left = seen_enemies(); left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        const auto& a = e.facts().abilities;
+        if (!(a[0].stuns || a[1].stuns) || !in_square(p, acts_from(e), Strike::max_reach)) continue;
+        // Strike bounds the Reach blow; a stun after our next turn takes nothing from it.
+        auto& x = struck(e);
+        if (x.strike.blow(dist(p, acts_from(e))).stuns && turns_before_ours(world_, e, x.turns) >= 1) return true;
+    }
+    return false;
+}
+
+namespace {
+
+// The slots ready on a turn in `round`, as strike_memo reads them.
+unsigned ready_slots(const ChampionBelief& c, int round) {
+    const bool uncertain = c.cooldowns_uncertain();
+    return (uncertain || c.ability_ready(0, round) ? 1u : 0u) | (uncertain || c.ability_ready(1, round) ? 2u : 0u);
+}
+
+// The slot of `slots` a turn's best strike at distance d casts, as a mask; 0 if the basic attack
+// alone does as well.
+unsigned best_cast(const ChampionBelief& c, unsigned slots, int d) {
+    const float best = strike_with(c, slots).at(d);
+    if (strike_with(c, 0).at(d) >= best) return 0;
+    for (unsigned s = 0; s < 2; ++s)
+        if ((slots >> s & 1) && strike_with(c, 1u << s).at(d) >= best) return 1u << s;
+    return slots;
+}
+
+} // namespace
+
+float Safety::stun_follow_up(vec2 p, float blow_scale, float& cost) {
+    // The stunner: of the visible blows at p that stun, the one giving up least for its stun turn.
+    const ChampionBelief* stunner = nullptr;
+    unsigned stun_slot = 0;
+    cost = 0;
+    for (const auto& t : threats()) {
+        if (!t.visible) continue;
+        const auto& e = *t.belief;
+        const Blow b = t.at(p);
+        if (!b.stuns) continue;
+        auto& x = struck(e);
+        // A threat may act only after our next turn: its stun takes the one after.
+        const int turns = turns_before_ours(world_, e, x.turns);
+        if (turns < 1) continue;
+        const auto& a = e.facts().abilities;
+        const unsigned slot = a[0].stuns ? 1u : 2u;
+        // Over two turns before ours, the stun may follow a walk.
+        const int d = dist(p, acts_from(e)) - (turns >= 2 ? 1 : 0);
+        const float given = std::max(0.0f, b.damage - strike_with(e, slot).at(std::max(0, d))) * blow_scale;
+        if (!stunner || given < cost) stunner = &e, stun_slot = slot, cost = given;
+    }
+    if (!stunner) return 0;
+    // The camp phase after next: members stunned now act in it.
+    float total = camp_damage(p, true, false);
+    for (auto left = live_enemies(); left; left &= left - 1) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (e.visible ? !in_square(p, acts_from(e), Strike::max_reach) : !e.possible_box.meets(p, Strike::max_reach)) continue;
+        if (gone(e)) continue;
+        auto& x = foe(e);
+        if (!e.visible && x.weight <= 0) continue;
+        // With turn order stable, each enemy has two turns between ours now and ours after the
+        // lost one, in the rounds from its next (`first`, before a stun took it): with fewer than
+        // two before our next turn, the second falls in the window, and worst_damage counted the
+        // first wherever it fell. The stunner's second turn counts though both come before ours:
+        // threat_strike widens to its better turn, never the sum.
+        const bool lost = turn_lost(e);
+        const int turns = turns_before_ours(world_, e, x.turns);
+        if (turns + (lost ? 1 : 0) >= 2 && &e != stunner) continue;
+        // A stunner losing its turn now has only its stun turn before our next: no turn follows it.
+        if (&e == stunner && lost) continue;
+        const int first = next_turn_round(world_, e) - (lost ? 1 : 0);
+        if (first + 1 > world_.round + 2) continue; // a teleport's channel
+        // A slot cast on its first turn is still cooling (rules abilities.cooldown).
+        const unsigned later = ready_slots(e, first + 1);
+        if (e.visible) {
+            const int d = dist(p, acts_from(e));
+            unsigned used = 0;
+            bool walked = !lost;
+            if (&e == stunner) {
+                used = stun_slot;
+                walked = !e.facts().abilities[std::countr_zero(stun_slot)].excludes_walking;
+            } else if (!lost && blow(e, p).hits) {
+                used = best_cast(e, ready_slots(e, first), d);
+                if (used == 1u || used == 2u) walked = !e.facts().abilities[std::countr_zero(used)].excludes_walking;
+            }
+            total += strike_with(e, later & ~used).at(walked ? std::max(0, d - 1) : d) * blow_scale;
+        } else {
+            if (x.strike.reach < 0) continue;
+            if (x.asked != p) x.asked = p, x.near = possible_within(e, p, x.strike.reach);
+            if (!x.near) continue;
+            total += strike_with(e, later & ~best_cast(e, ready_slots(e, first), 0)).at(0) * blow_scale;
+        }
+    }
+    return total;
 }
 
