+        if (own <= 0) continue;
+        // A self-shield ready in the window (Heart of Ruin, Varg) adds its amount.
+        const int shield = e.facts().slot_of(AbilityKind::shield);
+        const float hp = effective_hp(e) + (shield >= 0 && e.ability_ready(shield, next_turn_round(world, e) + window - 1) ? self_shield_amount(e) / e.taken : 0.0f);
+        bool sim = false;
+        // Where our fall counts, the fight must spare us too.
+        if (dealt < hp || falls) {
+            if (!fuel_ok(safety.fight_cost_estimate() + end_reserve)) continue;
+            const auto found = safety.fight_key(e.pos);
+            const auto key = (found == Safety::no_fight ? safety.fight_allies(e.pos) : found) | 1u << (16 + e.index);
+            // As prey's chase fight: those not striking it on their next turn join late, and so do
+            // the enemies who walk to it.
+            std::uint32_t delayed = 0;
+            for (auto left = key & 0xFFFFu; left; left &= left - 1) {
+                const auto& a = world.allies[static_cast<std::size_t>(std::countr_zero(left))];
+                if (!a.alive || (!a.is_self && !a.visible)) continue;
+                const vec2 from = a.is_self ? here : a.pos;
+                if (!strike(a, a.is_self ? world.round : next_turn_round(world, a)).hits(dist(from, e.pos))) delayed |= 1u << a.index;
+            }
+            std::array<int, 2> cooldowns;
+            for (int s = 0; s < 2; ++s) cooldowns[static_cast<std::size_t>(s)] = std::max(0, me.ready_round[static_cast<std::size_t>(s)] - world.round);
