+// Kill zones: the tiles where a turn ended hands an enemy our death before we act again.
+//
+// An enemy is a killer for us when its burst kills us: its ready stun's damage plus, as the stun
+// takes our next turn (rules abilities.stun), its best damage on the turn the stun hands back (the
+// other ready slot or basics); without a stun, its strike before our next turn. Both Prism spells
+// exclude walking, so its burst (1.5x + 1x Focus) comes from where it starts its turn.
+// Its zone is the tiles within its burst's reach of where it starts its next turn: a unit stun
+// needs its sight of us; a burst with a ground spell (no sight, no target) reaches one tile more;
+// one more when it has two turns before our next (a walk first). Only one-sided killers zone: one
+// our own burst (the same rule, from our turn) kills from inside its zone is a standoff the strike
+// search prices. A zone our side wins the fight in (Safety::fight at the killer, our allies near
+// it) is contested, not avoided. Rebuilt whenever what it reads changes; nothing persists but the
+// farm's hysteresis.
+#pragma once
+#include <array>
+#include <cstdint>
+#include "../util.h"
+#include "safety.h"
+
+namespace aph {
+
+class World;
+class Safety;
+class Pathing;
+struct ChampionBelief;
+
+namespace kill_zone {
+
+struct Killer {
+    int enemy = -1;      // index into World::enemies
+    vec2 at{-1, -1};     // where its next turn starts
+    int radius = -1;     // its zone: within `radius` of `at`
+    int turns = 0;       // its turns before our next (turns_before_ours); 0: its next comes after ours
+    bool sight = false;  // a unit stun opens a one-turn burst: tiles within ability range need its sight
+    bool full = false;   // the burst kills us at full health too: our spawn is in the zone
+    bool prism = false;  // a Prism (our Prism's farm choice widens its zone)
+    float burst = 0;     // after our Durability
+    Reach::Window seen;  // with `sight`: the tiles within ability range of `at` it sees
+};
+
+struct Model {
+    std::array<Killer, 8> killers;
+    int n = 0;
+    std::uint32_t stamp = 0; // changes with every rebuild
+    // Bits (by killer slot) whose zone holds p. `acting`: only killers with a turn before our next.
+    std::uint32_t at(const World& world, vec2 p, bool acting = false) const;
+    // Some zone may hold a tile within r of p (distance alone).
+    bool near(vec2 p, int r) const;
+    const Killer& operator[](int i) const { return killers[static_cast<std::size_t>(i)]; }
+};
+
+// This turn's zones for us, rebuilt when the beliefs, our health or our readiness change.
+const Model& model(const World& world, Safety& safety);
+
+// Whether this champion reads the zones at all (params::kz_prism, kz_allies); every use site checks it.
+bool reads(const World& world);
+// No zones, for a champion that does not read them.
+const Model& none();
+
+// Bits (by killer slot) of the zones holding p.
+inline std::uint32_t at(const World& world, Safety& safety, vec2 p, bool acting = false) {
+    const auto& m = model(world, safety);
+    return m.n ? m.at(world, p, acting) : 0;
+}
+
+// A goal step from `here` onto q keeps off the zones: q is in a zone, and does not lead out (no zone
+// gained, and fewer zones or less deep in them; step_out's rule too).
+bool keep_off(const World& world, Safety& safety, vec2 here, vec2 q);
+
+// Adds keep_off's tiles within `radius` of `here` to `guard` (null: none) in scratch board `slot`
+// (0-3: a guard and its cover each keep their own), valid until that slot's next call; `guard`
+// itself if it adds none.
+const bitboard* with_zones(const World& world, Safety& safety, vec2 here, int radius, const bitboard* guard, int slot);
+// with_zones' scratch board `slot`.
+const bitboard* scratch(int slot);
+
+// The farm's factor on group g's worth, in [0, 1]: the share of its work tiles (in our attack range
+// of a live member, or its camp tiles once cleared) outside every zone, 0 while a group dropped for
+// a zone stays dropped (until its killer has left that reach of it for 2 rounds, or died). Our
+// Prism reads an enemy Prism's zone at prism_farm_radius.
+float farm_factor(const World& world, const Model& m, int g, int range);
+inline constexpr int prism_farm_radius = 8;
+// farm_factor can read below 1 for some group: zones, or a group dropped lately.
+bool zoning(const World& world, const Model& m);
+
+// An altar whose tribute tiles all lie in zones.
+bool altar_zoned(const World& world, Safety& safety, int altar);
+
+// The enemy index of the only acting killer whose zone holds p, -1 with several; false if none.
+bool killer_at(const World& world, Safety& safety, vec2 p, int& enemy);
+
+// The zone radius of enemy `enemy` for us, -1 if it zones nothing.
+int radius_of(const World& world, Safety& safety, int enemy);
+
+// A goal turn left us in a zone with the walk unspent: the step out (fewer zones, else farther from
+// every killer holding us), among the steps the guard allows. True if it moved.
+bool step_out(const World& world, Pathing& pathing, Safety& safety);
+
+// Debug: the parts that fired this turn (KZ line).
+void note(char part);
+void print(const World& world);
+
+} // namespace kill_zone
+
+} // namespace aph
