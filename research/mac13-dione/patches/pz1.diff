+// Our Prism is dominant (it denies): every living enemy Prism seen and at most half its Focus
+// (prism_dominant; with none alive, vacuous), and the two hardest living enemies' strikes before our
+// next turn (threat_strike's upper bounds) leave it standing at the health it has now.
+bool prism_denies(const World& world, Safety& safety) {
+    const auto& me = world.me();
+    if (me.facts().passive != Passive::gem_focus) return false;
+    bool prism = false;
+    float first = 0, second = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive) continue;
+        if (e.facts().passive == Passive::gem_focus) {
+            if (e.stats_round < 0) return false;
+            prism = true;
+        }
+        const auto& s = safety.strike_of(e);
+        float most = 0;
+        for (int d = 0; d <= s.reach && d <= Strike::max_reach; ++d) most = std::max(most, s.damage[static_cast<std::size_t>(d)]);
+        if (most > first) second = first, first = most;
+        else second = std::max(second, most);
+    }
+    return (!prism || prism_dominant(world, me)) && first + second < my_health();
+}
