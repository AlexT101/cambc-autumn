+bool harmless_group(const World& world, int g) {
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    if (c.state == CampState::respawning) return G.strength <= 0;
+    for (std::size_t i = 0; i < G.members.size(); ++i)
+        if (G.members[i].strength > 0 && c.health[i] > 0) return false;
+    return true;
