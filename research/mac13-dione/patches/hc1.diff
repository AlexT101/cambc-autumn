+// camps hit the nearest champion in reach whatever group it works.
+bool harmless_work_near(const World& world, Pathing& pathing, Safety& safety, vec2 here) {
+    const int home = pathing.to_ally_spawn().at(here);
+    const auto& groups = world.map().groups;
