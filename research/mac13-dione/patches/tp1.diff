+// Trips priced as the guarded walk takes them. The work guard keeps every step off tiles where the
+// fight of the visible enemies hitting the tile is lost (step_guard), and a carried bag's walk keeps
+// out of the pack zone, so a static route through their reach detours or stalls at its edge. As the
+// guard prices a tile, each visible threat whose fight (with the allies beside us) is lost blocks its
+// reach (as enemy_area() draws it), and each pair that loses together where neither does alone blocks
+// where both reach; the zone too. One flood from here goes round them; where it cannot reach a group,
+// a second flood from what it reached gives the steps the way spends inside them, standing for the
+// rounds it is held up. Both only add to the static steps, so every lower bound farm prunes on holds.
+struct GuardedTrips {
+    int round = -1;
+    vec2 here{-1, -1};
+    std::uint32_t generation = 0;
+    bool zoned = false;
+    bool on = false;
+    std::uint32_t seen = 0; // the visible enemies blocking, by index
+    bitboard blocked{cambc::uninitialized};
+    std::optional<Field> around, inside;
+};
+GuardedTrips guarded_trips;
+
+// The rounds after a choice is dropped (Memory::guard_drop) that it stays dropped.
+inline constexpr int guard_drop_rounds = 3;
+
+std::uint32_t visible_enemies(const World& world) {
+    std::uint32_t bits = 0;
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && e.index < 32) bits |= 1u << e.index;
+    return bits;
+}
+
+// This turn's guarded trips from `here`, null where they are the static ones (no such fight or zone),
+// we stand inside what they avoid (the fight's to settle), or the fuel above `reserve` is short.
+const GuardedTrips* guarded_for(const World& world, Pathing& pathing, Safety& safety, vec2 here, const bitboard* zone, std::uint64_t reserve) {
+    auto& gt = guarded_trips;
+    if (gt.round == world.round && gt.here == here && gt.generation == Safety::generation() && gt.zoned == (zone != nullptr))
+        return gt.on ? &gt : nullptr;
+    gt.round = world.round, gt.here = here, gt.generation = Safety::generation(), gt.zoned = zone != nullptr, gt.on = false;
+    gt.seen = 0;
+    const std::uint64_t floods = 2 * full_field_cost_estimate() + reserve;
+    // The threats' build first: it can cost several thousand.
+    if (!fuel_ok(safety.build_cost_estimate() + floods)) {
+        note_shortcut("guarded-trips-fuel");
+        return nullptr;
+    }
+    constexpr int most = 6;
+    std::array<const Threat*, most> foes{};
+    int n = 0;
+    if (enemy_seen(world) && safety.any_threat())
+        for (const auto& t : safety.threats())
+            if (t.visible && n < most) foes[static_cast<std::size_t>(n++)] = &t;
+    if (n == 0 && !zone) return nullptr;
+    auto& blocked = gt.blocked;
+    clear_board(blocked);
+    if (n > 0) {
+        // As step_guard: a fall counts where it costs more than the fight (a partner, Prism, a bag).
+        const bool linked = partner(world) != nullptr || world.me().facts().passive == Passive::gem_focus
+                            || params::gem_value * static_cast<float>(bag_at_stake(world)) >= params::life_value;
+        const std::uint32_t allies = safety.fight_allies(here);
+        bool short_fuel = false;
+        const auto loses = [&](std::uint32_t enemies) {
+            const std::uint32_t key = enemies | allies;
+            if (!safety.known_fight_of(key) && !fuel_ok(safety.fight_cost_estimate() + 1000 + floods)) return short_fuel = true, false;
+            const auto t = safety.fight_of(key);
+            return t.lost || (t.self_falls && linked);
+        };
+        const auto bit = [&](int i) { return 1u << (16 + foes[static_cast<std::size_t>(i)]->enemy); };
+        static std::array<bitboard, most> reach;
+        const auto draw = [&](int i) {
+            const auto& t = *foes[static_cast<std::size_t>(i)];
+            const auto& e = *t.belief;
+            auto& b = reach[static_cast<std::size_t>(i)];
+            clear_board(b);
+            // As enemy_area() draws a visible threat.
+            if (e.teleport_pending() && in_bounds(e.tp_dest)) draw_square(b, e.tp_dest, static_cast<float>(t.strike.reach));
+            else if (const int r = safety.reach_of(e).reach(); r >= 0) draw_square(b, t.pos, static_cast<float>(r));
+        };
+        for (int i = 0; i < n; ++i) draw(i);
+        unsigned alone = 0;
+        for (int i = 0; i < n && !short_fuel; ++i)
+            if (loses(bit(i))) alone |= 1u << i, blocked |= reach[static_cast<std::size_t>(i)], gt.seen |= 1u << foes[static_cast<std::size_t>(i)]->enemy;
+        static bitboard both{cambc::uninitialized};
+        for (int i = 0; i < n && !short_fuel; ++i)
+            for (int j = i + 1; j < n && !short_fuel; ++j) {
+                if ((alone >> i & 1) || (alone >> j & 1)) continue;
+                and_into(reach[static_cast<std::size_t>(i)], reach[static_cast<std::size_t>(j)], both);
+                if (board_empty(both) || !loses(bit(i) | bit(j))) continue;
+                blocked |= both;
+                gt.seen |= 1u << foes[static_cast<std::size_t>(i)]->enemy | 1u << foes[static_cast<std::size_t>(j)]->enemy;
+            }
+        if (short_fuel) {
+            note_shortcut("guarded-trips-fuel");
+            return nullptr;
+        }
+    }
+    if (zone) blocked |= *zone;
+    if (board_empty(blocked) || test(blocked, here)) return nullptr;
+    static bitboard walls{cambc::uninitialized}, root{cambc::uninitialized}, reached{cambc::uninitialized}, unused{cambc::uninitialized};
+    or_into(pathing.static_walls(), blocked, walls);
+    clear_board(root);
+    set_tile(root, here);
+    // Refilled in place: a new distance field allocates and clears its buffer. Not counted in the
+    // fields' cost estimates, which turns without threats read.
+    const auto refill = [](std::optional<Field>& slot, const bitboard& w, const bitboard& goals, bitboard& visited) {
+        if (!slot) slot.emplace();
+        not_into(w, slot->goals);
+        slot->goals &= goals;
+        (void)slot->steps.compute_with_expansion_count(w, slot->goals, visited);
+    };
+    refill(gt.around, walls, root, reached);
+    refill(gt.inside, pathing.static_walls(), reached, unused);
+    world.throw_if_stale();
+    gt.on = true;
+    return &gt;
+}
+
+// The walk's steps to the group from the guarded trips: round what they avoid to its centre, or to a
+// tile beside it (an enemy at the camp may leave its edge free), else the static steps and those
+// spent inside what they avoid. Never fewer than `steps`, the static ones.
+int around_steps(const GuardedTrips& gt, vec2 centre) {
+    int a = gt.around->at(centre);
+    if (a == unreachable)
+        for (const auto d : directions)
+            if (const vec2 q = centre + d; in_bounds(q))
+                if (const int b = gt.around->at(q); b != unreachable) a = std::min(a, b + 1);
+    return a;
+}
+int guarded_steps(const GuardedTrips& gt, vec2 centre, int steps) {
+    if (const int a = around_steps(gt, centre); a != unreachable) return std::max(steps, a);
+    const int in = gt.inside->at(centre);
+    return in == unreachable ? steps : steps + in;
+}
