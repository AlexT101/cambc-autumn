+vec2 forecast_formation_step(const World& world, vec2 here, vec2 parent, float amount,
+                            const std::array<FormationWorker, 8>& workers, int count) {
+    const auto& map = world.map();
+    // Preserve any possible stationary basic/cast, without taking an action to test it.
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && dist(here, e.pos) <= ability_range) return parent;
+    for (int y = -3; y <= 3; ++y)
+        for (int x = -3; x <= 3; ++x) {
+            const vec2 p = here + vec2{x, y};
+            if (!in_bounds(p)) continue;
+            const int g = map.group_at(p);
+            if (g < 0) continue;
+            const auto& c = world.camps[g];
+            if (c.state_round == world.round && c.asleep_read_epoch == world.camp_observation_epoch
+                && (c.state == CampState::cleared || c.state == CampState::respawning)) continue;
+            return parent;
+        }
+
+    int finalist = -1;
+    float gain = 0, fraction = 0, parent_upper = 0;
+    for (int a = 0; a < count; ++a) {
+        const auto& w = workers[a];
+        const int g = comms::claim_of(world, w.ally->index);
+        if (g < 0 || g >= static_cast<int>(world.camps.size())) continue;
+        const auto& G = map.groups[g];
+        const auto& c = world.camps[g];
+        if (G.members.size() > 16 || c.state != CampState::alive || c.state_round != world.round
+            || c.last_damaged_round != world.round) continue;
+        int work_range = w.ally->facts().attack_range();
+        for (const auto& ability : w.ally->facts().abilities)
+            if (ability.hits_enemies()) work_range = std::max(work_range, ability.reach());
+        bool working = false;
+        float damage = 0;
+        for (std::size_t m = 0; m < G.members.size(); ++m) {
+            const auto& member = G.members[m];
+            if (c.health_round[m] != world.round || !(c.health[m] > 0) || !test(world.visible, member.pos)) continue;
+            working |= dist(w.pos, member.pos) <= work_range;
+            const int distance = dist(w.pos, member.pos);
+            if (!(member.strength > 0) || c.maybe_asleep(m) || distance > member.reach) continue;
+            bool nearest = true;
+            const auto competes = [&](const ChampionBelief& other) {
+                return other.handle != w.ally->handle && other.alive && other.visible
+                       && dist(other.is_self ? here : other.pos, member.pos) <= distance;
+            };
+            for (const auto& other : world.allies) nearest &= !competes(other);
+            for (const auto& other : world.enemies) nearest &= !competes(other);
+            if (nearest) damage += member.strength;
+        }
+        if (!working || !(damage > 0) || w.health <= damage) continue;
+        // Both owned mitigation passives assumed; shield-capable recipients were excluded.
+        const float injury = 0.63f * damage;
+        const float projected = std::min(amount, w.top - w.health + injury);
+        const float projected_fraction = (w.health - injury) / w.top;
+        if (!worth_healing(amount, projected, projected_fraction)) continue;
+        if (dist(parent, w.pos) <= 4) parent_upper = std::max(parent_upper, projected);
+        if (finalist < 0 || projected > gain || (projected == gain && projected_fraction < fraction)
+            || (projected == gain && projected_fraction == fraction
+                && static_cast<std::uint32_t>(w.ally->handle) < static_cast<std::uint32_t>(workers[finalist].ally->handle)))
+            finalist = a, gain = projected, fraction = projected_fraction;
+    }
+    if (finalist < 0 || gain <= parent_upper) return parent;
+    const vec2 recipient = workers[finalist].pos;
+    const auto viewers = attack_viewers(world, recipient, 4);
+    if (support_view(viewers, recipient, here) || support_view(viewers, recipient, parent)) return parent;
+    vec2 best = parent;
+    int best_home = unreachable;
+    for (int k = 1; k < 9; ++k) {
+        const auto& tile = willow_stations->tiles[k];
+        if (!tile.legal || !tile.risk.safe() || !test(map.standable, tile.p)) continue;
+        const int g = map.group_at(tile.p);
+        if (g >= 0 && world.camps[g].state == CampState::cleared) continue;
+        if (!support_view(viewers, recipient, tile.p)) continue;
+        const int home = dist(tile.p, map.ally_spawn_centre);
+        if (best == parent || home < best_home) best = tile.p, best_home = home;
+    }
+    debug_block({ if (best != parent) std::printf("WFF %d %u parent %d,%d step %d,%d ally %u gain %.3f upper %.3f\n",
+        world.round, my_handle(), parent.x, parent.y, best.x, best.y,
+        static_cast<std::uint32_t>(workers[finalist].ally->handle), gain, parent_upper); });
+    world.throw_if_stale();
+    return best;
+}
