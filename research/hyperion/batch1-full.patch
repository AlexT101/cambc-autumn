+            dashed |= f.abilities[s].kind == AbilityKind::dash;
+        }
+    char mv = '-';
+    if (p != probe.at) {
+        const int d = dist(p, probe.at);
+        const int i = (p.y - probe.at.y + 1) * 3 + p.x - probe.at.x + 1;
+        const bool gains = d == 1 && probe.field[4] >= 0 && probe.field[i] >= 0 && probe.field[i] < probe.field[4];
+        mv = dashed || d > 1 ? 'd' : !probe.walks ? 'w' : gains ? 's' : probe.field[4] < 0 ? 'n' : 'o';
+    }
+    // The move against the nearest visible enemy: '+' closer, '-' farther, '=' level.
+    char toward = '.';
