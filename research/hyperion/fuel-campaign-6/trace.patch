+namespace aph {
+// TRACE: the goal board of an outermost walk call (fuel paused inside debug_block).
+inline void trace_goal_board(const bitboard& goals, vec2 me) {
+    debug_block({
+        static vec2 buf[10240];
+        const std::uint32_t n = std::min<std::uint32_t>(positions_into(goals, buf, 10240), 10240);
+        tr.goal_n = static_cast<int>(n);
+        long sx = 0, sy = 0;
+        int best = 1 << 30;
+        vec2 nb{-1, -1};
+        for (std::uint32_t i = 0; i < n; ++i) {
+            sx += buf[i].x, sy += buf[i].y;
+            const int d = dist(me, buf[i]);
+            if (d < best) best = d, nb = buf[i];
+        }
+        tr.goal_near = nb;
+        tr.goal_dist = n ? best : -1;
+        tr.goal_cen = n ? vec2{static_cast<int>(sx / static_cast<long>(n)), static_cast<int>(sy / static_cast<long>(n))} : vec2{-1, -1};
+    });
+}
+inline void trace_goal_tile(vec2 t, vec2 me) {
+    debug_block({ tr.goal_n = 1, tr.goal_near = tr.goal_cen = t, tr.goal_dist = dist(me, t); });
+}
+inline void trace_tag(char kind, bool ok) {
+    debug_block({
+        ++tr.walk_calls;
+        tr.walk_fails += !ok;
+        if (tr.ntags < static_cast<int>(sizeof(tr.tags)) - 2) tr.tags[tr.ntags++] = kind, tr.tags[tr.ntags++] = ok ? '+' : '-';
+    });
+}
+struct TraceDepth {
+    bool outer;
+    TraceDepth() : outer(tr.depth++ == 0) {}
+    ~TraceDepth() { --tr.depth; }
+};
+} // namespace aph
