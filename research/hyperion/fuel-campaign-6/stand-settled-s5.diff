+// The damage their side must deal before our fighter `self` falls, while hurt() keeps to the order of
+// health its members start in: every member weaker (weakest()'s order) falls first, a linked body
+// takes its partner down free, and self's own partner falling ends it. That order holds while no
+// shield or heal of ours comes or goes and no Ren of theirs hits ours back.
+// `at_self`: the walk ends at self, not at its partner, so camp hits (straight onto self) count
+// towards it too.
+float damage_to_fell(const Side& us, int self, bool& at_self) {
+    unsigned left = 0;
+    NO_UNROLL
+    for (int i = 0; i < us.count; ++i) left |= static_cast<unsigned>(us.fighters[i].health > 0) << i;
+    const int partner = us.fighters[self].link;
