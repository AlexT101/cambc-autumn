+// A quiet bank approach that retreat immediately undoes needs a different destination.
+// Keep retreating to spawn rather than retrying the same approach next turn.
+void bank_reversal_home(const World& world, Memory& memory, vec2 start) {
+    static vec2 previous_start{-1, -1};
+    static int previous_round = -1;
+    static bool previous_banking = false;
+    const vec2 here = my_position();
+    const bool reversed = previous_round == world.round - 1 && previous_banking
+                          && decision == Branch::retreat && here == previous_start && here != start;
+    previous_start = start, previous_round = world.round;
+    previous_banking = decision == Branch::bank && memory.banking;
+    if (!reversed || my_gems() == 0 || memory.damage > 0 || engaged || engaged_before) return;
+    memory.bank_fled = true;
+    debug_block({ std::printf("BANK-HOME %d %u\n", world.round, my_handle()); });
+}
