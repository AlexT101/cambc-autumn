+// A work step immediately undone by retreat has not advanced its group. Reconsider it
+// while the nearest enemy keeps tributing, and let farm choose other work in the meantime.
+void farm_reversal(const World& world, Memory& memory, vec2 start) {
+    static vec2 previous_start{-1, -1};
+    static int previous_round = -1, previous_group = -1;
+    static Branch previous_branch = Branch::none;
+    const vec2 here = my_position();
+    const bool reversed = previous_round == world.round - 1 && previous_branch == Branch::farm
+                          && decision == Branch::retreat && here == previous_start && here != start;
+    const int group = previous_group;
+    previous_start = start, previous_round = world.round, previous_branch = decision, previous_group = memory.farm_group;
+    if (!reversed || group < 0 || memory.damage > 0 || engaged || engaged_before) return;
+    const ChampionBelief* nearest = nullptr;
+    int distance = unreachable;
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && dist(start, e.pos) < distance) nearest = &e, distance = dist(start, e.pos);
+    if (!nearest || nearest->channel != Channel::tribute) return;
+    memory.refused_farm = group;
+    memory.farm_blocker = nearest->index;
+    memory.farm_blocker_pos = nearest->pos;
+    memory.farm_group = memory.claim = -1;
+    memory.crew = false;
+    debug_block({ std::printf("FARM-REVERSE %d %u group %d enemy %d at %d %d\n", world.round, my_handle(), group, nearest->index, nearest->pos.x, nearest->pos.y); });
+}
