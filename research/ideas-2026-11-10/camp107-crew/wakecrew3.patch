+bool wake_endangers_ally(const World& world, int group, int hit_member, float damage, bool stun) {
+    const auto& c = world.camps[group];
+    if (c.state != CampState::alive || c.awake != Awake::asleep) return false;
+    const auto& G = world.map().groups[group];
+    if (G.strength <= 0 || G.has_monolith) return false;
+    int striker = -1;
+    for (int i = 0; i < static_cast<int>(G.members.size()); ++i)
+        if (c.health[i] > 0 && G.members[i].strength > 0) {
+            if (striker >= 0) return false;
+            striker = i;
+        }
+    if (striker < 0 || (hit_member == striker && damage >= c.health[striker])) return false;
+    const auto& m = G.members[striker];
+    const ChampionBelief* nearest = nullptr;
+    int near = m.reach + 1, slot = 999;
+    const auto consider = [&](const ChampionBelief& a) {
+        if (!a.alive || (!a.is_self && !a.visible)) return;
+        const int d = dist(a.is_self ? my_position() : a.pos, m.pos);
+        const int order = world.slot(a, world.round + 1);
+        if (d <= m.reach && (d < near || (d == near && order < slot))) nearest = &a, near = d, slot = order;
+    };
+    for (const auto& a : world.allies) consider(a);
+    for (const auto& a : world.enemies) consider(a);
+    if (!nearest || nearest->is_self) return false;
+    bool allied = false;
+    for (const auto& a : world.allies) allied |= &a == nearest;
+    if (!allied || test(world.map().ally_spawn, nearest->pos)) return false;
+    const int phases = std::max(0, m.reach - near + 1 - (hit_member == striker && stun));
+    const float exposure = m.strength * nearest->camp_taken * static_cast<float>(phases);
+    if (exposure < nearest->health + nearest->shield) return false;
+    // A prior action may already have woken it; never withhold damage from an ongoing fight.
+    std::uint32_t state = 0;
+    if (cambc::detail::sdk_camp_state(m.handle, &state) != 0 || state != 2) return false;
+    debug_block({ std::printf("CREW WAKE WAIT %d %u g%d ally%d damage%.0f hp%.0f\n", world.round, my_handle(), group, nearest->index, exposure, nearest->health); });
+    return true;
+}
