+// Prism's bag at stake (research/ideas-2026-11-09/prismhp.md), in rounds lost a round alive: its death rate with this
+// bag, times a death's respawn, walk out and the bag's gems at bag::gem_stake rounds each. Max health above ours
+// cuts it by exp(-bag::health_odds x the health added), the odds a share-and-time-controlled fit gives it.
+float bag_risk(const World& world, float steps) {
+    if (world.me().facts().passive != Passive::gem_focus) return 0;
+    const float g = static_cast<float>(my_gems());
+    if (g <= 0) return 0;
+    const float rate = params::bag::death_rate / (1.0f + g / params::bag::death_gems);
+    return rate * (static_cast<float>(cambc::constants::respawn_time) + steps + params::bag::gem_stake * g);
+}
