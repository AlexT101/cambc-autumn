+// Prism's threatened line raised by its bag (research/ideas-2026-11-09/prismhp.md). A logistic fit of our live Prism's
+// death within 6 rounds while an enemy is within 6 gives the hazard
+//   logit p = c + bag::share * h + bag::lg * ln(1+g) + bag::share_lg * h ln(1+g) + bag::enemy * n_e + bag::ally * n_a
+// (h: health share, g: gems carried, n_e / n_a: visible enemies / allies within 5). Retreat pays once p x stake beats
+// the heal trip. The tuned line holds for an empty bag, which fixes the trip's price; a bag scales the stake from a
+// death's respawn and walk out to that plus gem_stake rounds a gem, and the line is where p falls to the scaled price.
+float bag_line(const World& world, vec2 p, float base) {
+    const int gems = static_cast<int>(my_gems());
+    if (gems <= 0 || world.me().facts().passive != Passive::gem_focus) return base;
+    int ne = 0, na = 0;
+    for (const auto& e : world.enemies) ne += e.alive && e.visible && dist(e.pos, p) <= params::bag::near;
+    for (const auto& a : world.allies) na += !a.is_self && a.alive && a.visible && dist(a.pos, p) <= params::bag::near;
+    const auto& map = world.map();
+    const float out = map.from_ally_spawn_ready() && map.from_ally_spawn().at(p) != unreachable
+                          ? static_cast<float>(map.from_ally_spawn().at(p)) : static_cast<float>(dist(p, map.ally_spawn_centre));
+    const float c = params::bag::c + params::bag::enemy * static_cast<float>(ne) + params::bag::ally * static_cast<float>(na);
+    const float lg = std::log1p(static_cast<float>(gems));
+    // logit of the trip's price, from the empty-bag line.
+    const float x0 = c + params::bag::share * base, q0 = 1.0f / (1.0f + std::exp(-x0));
+    const float death = static_cast<float>(cambc::constants::respawn_time) + out;
+    const float q = q0 * death / (death + params::bag::gem_stake * static_cast<float>(gems));
+    const float lq = std::log(q / (1.0f - q));
+    const float line = (lq - c - params::bag::lg * lg) / (params::bag::share + params::bag::share_lg * lg);
+    return std::clamp(line, base, params::bag::cap);
+}
