     const float health = my_health();
-    // Either line is at most recall_health_fraction: above it, no line needs working out.
-    if (health < params::recall_health_fraction * my_max_health() && health < recall_line(world, safety, hold.p) * my_max_health()
-        && !finishing_camp(world, hold.p) && !hold.keeps_us(safety))
-        return true;
+    // Either line is at most recall_health_fraction (a bag's at most bag::cap): above it, no line needs working out.
+    const bool bag = my_gems() > 0 && world.me().facts().passive == Passive::gem_focus;
+    if (health < (bag ? std::max(params::bag::cap, params::recall_health_fraction) : params::recall_health_fraction) * my_max_health()) {
+        float line = recall_line(world, safety, hold.p);
+        // Only the threatened line: the hazard was fitted with an enemy near.
+        if (bag && line == params::recall_health_fraction) line = bag_line(world, hold.p, line);
+        if (health < line * my_max_health() && !finishing_camp(world, hold.p) && !hold.keeps_us(safety)) return true;
+    }
     return outmatched(world, safety, hold) && !hold.keeps_us(safety);
 }
 
