+// How far a champion may still move before the next camp phase: none once it has acted this round,
+// while stunned or channelling; else a walk, and a dash's two more when one is ready.
+int free_steps(const ChampionBelief& c) {
+    if (c.acted || c.stun_pending || c.channel != Channel::none) return 0;
+    const auto& f = c.facts();
+    const int s = f.slot_of(AbilityKind::dash);
+    return 1 + (s >= 0 && c.ability_ready(s, c.stats_round) ? dash_range : 0);
