+// A touched group whose sleeping strikers include one an enemy held in place is nearest.
+bool Search::aggro_group(int k) {
+    if (any_held < 0) {
+        any_held = 0;
+        for (const auto& o : world.enemies) any_held |= o.alive && o.visible && (o.acted || o.channel != Channel::none);
+    }
+    if (!any_held) return false;
+    if (!(wakers_known >> k & 1)) find_wakers(k);
+    for (int i = waker_begin[k]; i < waker_end[k]; ++i)
+        if (const auto& w = plan_tables.wakers[i]; w.enemy >= 0 && w.other_d <= w.reach) return true;
+    return false;
+}
