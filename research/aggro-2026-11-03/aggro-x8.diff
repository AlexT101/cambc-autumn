+// A touched group whose sleeping strikers include one an enemy held in place is nearest.
+// A held enemy in a sleeping striker's reach, the precondition of every credited wake: found from
+// the enemies' tiles (groups_near keeps its answers by tile), so the common turn without one skips
+// reading camp members at all.
+bool Search::held_in_box(int g) const {
+    // Each group's members' reach squares, bounded: static for the game.
+    struct Box {
+        int x0, y0, x1, y1;
+    };
+    static std::vector<Box> boxes;
+    const auto& groups_map = world.map().groups;
+    if (boxes.size() != groups_map.size()) {
+        boxes.assign(groups_map.size(), Box{1 << 20, 1 << 20, -(1 << 20), -(1 << 20)});
+        for (std::size_t h = 0; h < groups_map.size(); ++h)
+            for (const auto& mb : groups_map[h].members) {
+                auto& b = boxes[h];
+                b.x0 = std::min(b.x0, mb.pos.x - mb.reach), b.x1 = std::max(b.x1, mb.pos.x + mb.reach);
+                b.y0 = std::min(b.y0, mb.pos.y - mb.reach), b.y1 = std::max(b.y1, mb.pos.y + mb.reach);
+            }
+    }
+    const auto& b = boxes[static_cast<std::size_t>(g)];
+    for (int e = 0; e < n_held; ++e)
+        if (const vec2 p = held_pos[e]; p.x >= b.x0 && p.x <= b.x1 && p.y >= b.y0 && p.y <= b.y1) return true;
+    return false;
+}
+
+// A held enemy in a sleeping striker's reach, the precondition of every credited wake: the common
+// turn without one skips reading camp members at all.
+bool Search::aggro_possible() {
+    if (any_held >= 0) return any_held;
+    any_held = 0;
+    const auto& map = world.map();
+    bool close = false;
+    for (std::size_t e = 0; e < world.enemies.size(); ++e)
+        if (const auto& o = world.enemies[e]; o.alive && o.visible && (o.acted || o.channel != Channel::none) && n_held < 8) {
+            held_pos[n_held] = o.pos, held_index[n_held++] = static_cast<std::int8_t>(e);
+            close |= dist(o.pos, here) <= ability_range + 1 + map.max_camp_reach;
+        }
+    if (!close) return false;
+    // read_members' query from our tile, so groups_near answers from its cache.
+    for (int g : map.groups_near(here, grid_r + range + 1)) {
+        const auto& c = world.camps[g];
+        if (c.state != CampState::alive || c.fully_awake() || !held_in_box(g)) continue;
+        const auto& members = map.groups[g].members;
+        for (std::size_t i = 0; i < members.size(); ++i) {
+            if (c.health[i] <= 0 || members[i].strength <= 0 || !c.maybe_asleep(i)) continue;
+            for (int e = 0; e < n_held; ++e)
+                if (const vec2 p = held_pos[e]; dist(p, members[i].pos) <= members[i].reach && dist(p, here) <= ability_range + 1 + map.max_camp_reach)
+                    return any_held = 1;
+        }
+    }
+    return false;
+}
+
+bool Search::aggro_group(int k) {
+    if (aggro_known >> k & 1) return aggro_yes >> k & 1;
+    aggro_known |= static_cast<std::uint16_t>(1u << k);
+    if (!aggro_possible()) return false;
+    if (!(wakers_known >> k & 1)) {
+        // A waker's target needs a held enemy in its reach: checked by distance before find_wakers.
+        const int g = groups[k];
+        if (!held_in_box(g)) return false;
+        const auto& c = world.camps[g];
+        const auto& members = world.map().groups[g].members;
+        bool near = false;
+        for (std::size_t i = 0; i < members.size() && !near; ++i) {
+            const auto& mb = members[i];
+            if (c.health[i] <= 0 || mb.strength <= 0 || !c.maybe_asleep(i)) continue;
+            for (int e = 0; e < n_held; ++e) near |= dist(held_pos[e], mb.pos) <= mb.reach;
+        }
+        if (!near) return false;
+        find_wakers(k);
+    }
+    for (int i = waker_begin[k]; i < waker_end[k]; ++i)
+        if (const auto& w = plan_tables.wakers[i]; w.enemy >= 0 && w.other_d <= w.reach)
+            return aggro_yes |= static_cast<std::uint16_t>(1u << k), true;
+    return false;
+}
+
 float Search::leaf_value(const Node& s) const {
     return s.value + (s.walk && !s.excl && walks ? step : 0.0f);
 }
