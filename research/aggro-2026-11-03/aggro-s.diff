 // comes as the target weakens (kill_distance).
 inline constexpr float chip_value = 0.4f;
 
+// Camp aggro (bot.cc aggro_camp): wake a sleeping group onto held enemies when its woken strikers
+// hitting them total at least aggro_min_strength; Monolith groups too if aggro_monolith; only from
+// outside every woken striker's reach if aggro_self_out; no ally seen within this many rounds near.
+inline constexpr float aggro_min_strength = 20;
+inline constexpr bool aggro_monolith = true;
+inline constexpr bool aggro_self_out = true;
+inline constexpr int aggro_ally_memory = 5;
+// Enemies yet to act count as targets too (they may walk off: a wasted wake, never a hit on us).
+inline constexpr bool aggro_unheld = false;
+// A cast wakes only for at least this much credited Strength; 0: never.
+inline constexpr float aggro_spell_min = 60;
 } // namespace aph::params
