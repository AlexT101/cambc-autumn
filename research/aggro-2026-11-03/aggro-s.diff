+// Turn end: an unused basic attack or cast wakes sleeping groups whose woken strikers would each
+// hit an enemy held in place (acted this round, or channelling): camps attack at the next round's
+// start, the nearest champion in reach, before anyone can walk off. Never one that would hit us or
+// an ally, seen or lately seen near. A stunned striker skips that attack: no credit.
+struct AggroGroup {
+    int g;
+    bool bad;
+    float credit;
+    std::array<float, 32> member_credit;
+};
+
+bool aggro_camp(const World& world) {
+    if (stunned_turn || !world.me().alive || channelling()) return false;
+    const bool atk = my_can_attack(), cst = my_can_cast();
+    if (!atk && !cst) return false;
+    const vec2 here = my_position();
+    if (here.x < 0) return false;
+    const auto& map = world.map();
+    const auto& f = world.me().facts();
+    const int range = f.attack_range(), next = world.round + 1;
+    const int self_slot = world.slot(world.me(), next);
+    static std::vector<AggroGroup> gs;
+    gs.clear();
+    for (int g : map.groups_near(here, cst ? ability_range + ground_radius : range)) {
+        const auto& c = world.camps[g];
+        const auto& grp = map.groups[g];
+        if (c.state != CampState::alive || grp.strength <= 0 || c.fully_awake() || grp.members.size() > 32) continue;
+        AggroGroup a{g, g == siege_group() || (grp.has_monolith && !params::aggro_monolith), 0, {}};
+        for (std::size_t i = 0; i < grp.members.size() && !a.bad; ++i) {
+            const auto& m = grp.members[i];
+            if (c.health[i] <= 0 || m.strength <= 0 || !c.maybe_asleep(i)) continue;
+            const int ds = dist(here, m.pos);
+            if (params::aggro_self_out && ds <= m.reach) { a.bad = true; break; }
+            int bd = ds <= m.reach ? ds : m.reach + 1, bs = self_slot;
+            bool enemy = false;
+            const auto consider = [&](const ChampionBelief& o, bool foe) {
+                const int d = dist(o.pos, m.pos);
+                if (d > m.reach || d > bd) return;
+                const int sl = world.slot(o, next);
+                if (d == bd && sl > bs) return;
+                bd = d, bs = sl, enemy = foe;
+            };
+            for (const auto& o : world.allies) {
+                if (o.is_self || !o.alive) continue;
+                if (o.visible) consider(o, false);
+                else if (o.pos_round >= world.round - params::aggro_ally_memory
+                         && dist(o.pos, m.pos) <= m.reach + 1 + (world.round - o.pos_round)) a.bad = true;
+            }
+            for (const auto& e : world.enemies)
+                if (e.alive && e.visible && (params::aggro_unheld || e.acted || e.channel != Channel::none)) consider(e, true);
+            if (bd > m.reach) continue; // no one in its reach: it sleeps again
+            if (!enemy) a.bad = true;
+            else a.member_credit[i] = m.strength, a.credit += m.strength;
+        }
+        gs.push_back(a);
+    }
+    // A basic attack on a member of one group: free at the turn's end.
+    if (atk) {
+        int best_g = -1, best_i = -1;
+        float best = 0;
+        for (const auto& a : gs) {
+            if (a.bad || a.credit < params::aggro_min_strength || a.credit <= best) continue;
+            const auto& grp = map.groups[a.g];
+            int target = -1;
+            for (std::size_t i = 0; i < grp.members.size(); ++i) {
+                const auto& m = grp.members[i];
+                if (world.camps[a.g].health[i] <= 0 || dist(here, m.pos) > range || !cambc::vision::has_camp(m.pos)) continue;
+                if (target < 0 || (m.strength <= 0 && grp.members[static_cast<std::size_t>(target)].strength > 0)) target = static_cast<int>(i);
+            }
+            if (target >= 0) best = a.credit, best_g = a.g, best_i = target;
+        }
+        if (best_g >= 0) {
+            throw_if_stale();
+            try {
+                cambc::self().attack(map.groups[best_g].camp(best_i));
+                debug_block({ std::printf("AGGRO %d %u a g%d %.0f\n", world.round, my_handle(), best_g, best); });
+                return true;
+            } catch (const cambc::error&) {
+            }
+        }
+    }
+    if (!cst || params::aggro_spell_min <= 0) return false;
+    // A cast: a unit spell on one member, or a ground 3x3 touching every group with a member in it.
+    const auto find = [&](int g) -> const AggroGroup* {
+        for (const auto& a : gs) if (a.g == g) return &a;
+        return nullptr;
+    };
+    int best_slot = -1;
+    float best = 0;
+    vec2 best_tile{-1, -1};
+    int best_g = -1, best_i = -1;
+    for (int s = 0; s < 2; ++s) {
+        const auto& ab = f.abilities[s];
+        if (!(ab.kind == AbilityKind::damage || ab.kind == AbilityKind::stun) || !world.me().ability_ready(s, world.round)
+            || (ab.excludes_walking && here != world.turn_start))
+            continue;
+        if (ab.target == Targeting::unit) {
+            for (const auto& a : gs) {
+                if (a.bad) continue;
+                const auto& grp = map.groups[a.g];
+                for (std::size_t i = 0; i < grp.members.size(); ++i) {
+                    const auto& m = grp.members[i];
+                    if (world.camps[a.g].health[i] <= 0 || dist(here, m.pos) > ab.range() || !cambc::vision::has_camp(m.pos)) continue;
+                    const float v = a.credit - (ab.stuns ? a.member_credit[i] : 0.0f);
+                    if (v > best) best = v, best_slot = s, best_g = a.g, best_i = static_cast<int>(i), best_tile = {-1, -1};
+                }
+            }
+        } else if (ab.target == Targeting::ground) {
+            for (const auto& a : gs) {
+                if (a.bad || a.credit <= best) continue;
+                const auto& grp = map.groups[a.g];
+                for (std::size_t i = 0; i < grp.members.size(); ++i) {
+                    if (world.camps[a.g].health[i] <= 0) continue;
+                    const vec2 mp = grp.members[i].pos;
+                    for (int dy = -ground_radius; dy <= ground_radius; ++dy)
+                        for (int dx = -ground_radius; dx <= ground_radius; ++dx) {
+                            const vec2 t{mp.x + dx, mp.y + dy};
+                            if (dist(here, t) > ab.range() || !in_bounds(t)) continue;
+                            // Every live member in the 3x3, of any group, wakes its group.
+                            float v = 0;
+                            bool bad = false;
+                            std::uint32_t seen = 0;
+                            for (int h : map.groups_near(t, ground_radius)) {
+                                const auto& hc = world.camps[h];
+                                if (hc.state != CampState::alive) continue;
+                                const auto& hg = map.groups[h];
+                                bool touched = false;
+                                float stunned = 0;
+                                for (std::size_t j = 0; j < hg.members.size(); ++j)
+                                    if (hc.health[j] > 0 && dist(t, hg.members[j].pos) <= ground_radius) touched = true;
+                                if (!touched) continue;
+                                const auto* ag = find(h);
+                                if (!ag) {
+                                    if (hg.strength > 0 && !hc.fully_awake()) bad = true; // out of our reckoning
+                                    continue;
+                                }
+                                if (ag->bad) { bad = true; break; }
+                                if (seen >> (ag - gs.data()) & 1) continue;
+                                seen |= 1u << (ag - gs.data());
+                                if (ab.stuns)
+                                    for (std::size_t j = 0; j < hg.members.size(); ++j)
+                                        if (hc.health[j] > 0 && dist(t, hg.members[j].pos) <= ground_radius) stunned += ag->member_credit[j];
+                                v += ag->credit - stunned;
+                            }
+                            if (!bad && v > best) best = v, best_slot = s, best_tile = t, best_g = -1;
+                        }
+                }
+            }
+        }
+    }
+    if (best_slot < 0 || best < params::aggro_spell_min) return false;
+    throw_if_stale();
+    bool cast = false;
+    try {
+        if (best_g >= 0) cast = cast_slot_on(best_slot, static_cast<cambc::handle_camp_t>(map.groups[best_g].camp(best_i)));
+        else cast = cast_slot(best_slot, best_tile);
+    } catch (const cambc::error&) {
+        return false;
+    }
+    if (cast) camp_hits() += 1;
+    debug_block({ std::printf("AGGRO %d %u s%d %.0f %d\n", world.round, my_handle(), best_slot, best, cast ? 1 : 0); });
+    return cast;
+}
+
 // Our farm choice when a walk to it is to be searched, else -1.
 int walk_target(const World& world, Pathing& pathing, const Memory& memory) {
     const int g = memory.farm_group;
@@ -469,6 +633,7 @@
     if (!support_owned && !search_priced_end()) shield_if_needed(world, safety, memory.claim);
     end_ward = place_ward(world, memory); // where we end the turn
     place_lock(world);
+    aggro_camp(world);
     if (!support_owned) start_recall(world);
     count_use(world, could_attack);
 }
