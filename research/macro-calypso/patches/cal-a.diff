+// Which enemy bodies provably cannot contest a group before our work there ends (contest_absent):
+// each one's earliest turn in its action range of a member, from what we know of it this turn. A
+// dead one walks from its spawn from the turn after its earliest respawn; a tracked one from the
+// box `possible` lies in (or by a recall to its spawn and the walk from there); any other could be
+// anywhere. Chebyshev distances, so terrain only delays it.
+struct EnemyContest {
+    enum class Kind : std::uint8_t { anywhere, dead, tracked };
+    Kind kind = Kind::anywhere;
+    GrowBox box;
+    int start = 0, recall = 0; // dead: the rounds until it first walks; tracked: until a recall lands it
+    int reach = 0, dash_steps = 0, dash_ready = 0;
+    bool dash_maybe = false;
+};
+struct ContestTurn {
+    std::uint32_t round = ~0u, observations = 0;
+    std::vector<EnemyContest> enemies;
+    int could = 0; // bodies some group may find absent (dead or tracked)
+};
+
+int box_dist(const GrowBox& b, vec2 p) {
+    return std::max(std::max({b.x0 - p.x, 0, p.x - b.x1}), std::max({b.y0 - p.y, 0, p.y - b.y1}));
+}
+
+const ContestTurn& contest_turn(const World& world) {
+    static ContestTurn t;
+    if (t.round == static_cast<std::uint32_t>(world.round) && t.observations == world.observations) return t;
+    t.round = static_cast<std::uint32_t>(world.round), t.observations = world.observations;
+    t.enemies.clear(), t.could = 0;
+    const int round = world.round;
+    for (const auto& e : world.enemies) {
+        auto& c = t.enemies.emplace_back();
+        const auto& f = e.facts();
+        const int dash = f.slot_of(AbilityKind::dash);
+        c.reach = f.action_range;
+        c.dash_steps = dash >= 0 ? f.abilities[dash].range() : 0;
+        if (!e.alive) {
+            if (e.respawn_earliest < 0) continue;
+            // No walk on the respawn turn; abilities come back ready.
+            c.kind = EnemyContest::Kind::dead, c.box = world.map().enemy_spawn_box;
+            c.start = std::max(e.respawn_earliest, round) + 1 - round;
+        } else if (e.tracked && e.possible_box.x0 <= e.possible_box.x1) {
+            c.kind = EnemyContest::Kind::tracked, c.box = e.possible_box;
+            // A box dated before this round misses its turns since, a dash and a step each.
+            if (e.at.round < round) c.box.grow((round - e.at.round) * (1 + c.dash_steps));
+            c.dash_ready = dash >= 0 ? std::max(0, e.ready_round[dash] - round) : 0;
+            c.dash_maybe = e.cooldowns_uncertain();
+            // A recall believed under way lands at its end; else one started unseen as soon as the fix
+            // allows (the round after, if it had acted), with a Home emblem it may have bought unseen.
+            const int first = e.fixed.round + (e.fixed.slot >= 0 ? 1 : 0);
+            c.recall = e.channel == Channel::recall ? std::max(0, e.channel_end_round - round) : std::max(0, first + home_recall_time - round);
+        } else {
+            continue;
+        }
+        ++t.could;
+    }
+    return t;
+}
+
+// The nearest member's distance from the enemy spawn box, by group: static, kept.
+int spawn_gap(const StaticMap& map, int g) {
+    static std::vector<int> gaps;
+    if (gaps.size() != map.groups.size()) gaps.assign(map.groups.size(), -1);
+    int& gap = gaps[static_cast<std::size_t>(g)];
+    if (gap < 0) {
+        gap = unreachable;
+        for (const auto& m : map.groups[g].members) gap = std::min(gap, box_dist(map.enemy_spawn_box, m.pos));
+    }
+    return gap;
+}
+
+// The share of enemy bodies that may be absent from some group this turn: an upper bound on
+// contest_absent for every group and window.
+float contest_absent_most(const World& world) {
+    const auto& t = contest_turn(world);
+    return t.enemies.empty() ? 0.0f : static_cast<float>(t.could) / static_cast<float>(t.enemies.size());
+}
+
+// The share of enemy bodies (Cassi and Issac two) that provably cannot reach action range of a tile
+// within `stand` of group g's members within `window` rounds from now, our arrival, clear and capture there.
+float contest_absent(const World& world, int g, float window, int stand) {
+    const auto& t = contest_turn(world);
+    if (t.could == 0) return 0.0f;
+    const auto& map = world.map();
+    const auto& members = map.groups[g].members;
+    const int from_spawn = spawn_gap(map, g);
+    int absent = 0;
+    for (const auto& c : t.enemies) {
+        if (c.kind == EnemyContest::Kind::anywhere) continue;
+        // Turns from its first walk on: at most a step a turn and a dash a cooldown, from the spawn ready.
+        const auto from_home = [&](int first) {
+            return from_spawn == unreachable ? unreachable
+                                             : first + earliest_work_delay(from_spawn - stand - c.reach, 0, 0, c.dash_steps, ability_cooldown, false);
+        };
+        int arrive;
+        if (c.kind == EnemyContest::Kind::dead) {
+            arrive = from_home(c.start);
+        } else {
+            int gap = unreachable;
+            for (const auto& m : members) gap = std::min(gap, box_dist(c.box, m.pos));
+            arrive = std::min(earliest_work_delay(gap - stand - c.reach, 0, c.dash_ready, c.dash_steps, ability_cooldown, c.dash_maybe), from_home(c.recall));
+        }
+        if (static_cast<float>(arrive) >= window) ++absent;
+    }
+    return static_cast<float>(absent) / static_cast<float>(t.enemies.size());
+}
