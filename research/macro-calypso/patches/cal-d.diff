+// Turns for an enemy to cover `steps` king steps from its turn in round `start`: one a turn, and a dash's
+// two more in each turn its slot is ready (`dash_ready`, -1 without one; rules: abilities.dash, cooldown).
+int travel_turns(int steps, int dash_ready, int start) {
+    if (steps <= 0) return 0;
+    if (dash_ready < 0) return steps;
+    int t = 0, covered = 0, ready = std::max(dash_ready, start);
+    while (covered < steps) {
+        const int r = start + t++;
+        covered += 1;
+        if (r >= ready) covered += 2, ready = r + ability_cooldown;
+    }
+    return t;
+}
