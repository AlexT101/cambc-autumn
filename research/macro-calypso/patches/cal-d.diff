+    if (at < 0 || w.altars[static_cast<std::size_t>(at)].margin < 0) return WinStart::hold;
+    const float health = my_health(), taken = std::max(memory.damage, safety.camp_damage(my_position()));
+    return taken * static_cast<float>(turns) < health ? WinStart::go : WinStart::none;
