+// home_side's measure at a tile; 1 where either spawn's walk does not reach it (own_ground's).
+float ground_side(const World& world, vec2 p) {
+    const auto& map = world.map();
+    const int us = map.from_ally_spawn().at(p), them = map.enemy_spawn_steps(p);
+    if (us == unreachable || them == unreachable) return 1.0f;
+    return us + them > 0 ? static_cast<float>(them) / static_cast<float>(us + them) : 0.5f;
+}
