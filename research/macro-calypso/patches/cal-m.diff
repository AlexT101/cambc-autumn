diff --git a/bots/variants/cal-m/src/economy/bodyguard.cc b/bots/variants/cal-m/src/economy/bodyguard.cc
new file mode 100644
index 000000000..52deeebe6
--- /dev/null
+++ b/bots/variants/cal-m/src/economy/bodyguard.cc
@@ -0,0 +1,121 @@
+// A bodyguard for a Prism hoarding for its Focus: a Prism whose bag dies with it loses the game
+// most of the time, and it dies with a big bag mostly while few allies stand near it. The guard pays
+// with its own farm: it works only groups near the Prism, and stands by it when none is worth it.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// The ally that guards our Prism: chosen from pick facts and liveness alone, which every ally reads
+// the same, so no comms are needed. Not Willow (willow_follow keeps her by the crowd) nor Cassi or
+// Issac (a linked death gives both bags). Fight power: base output times base health.
+int guard_index(const World& world, int prism) {
+    int best = -1;
+    float best_power = 0;
+    for (const auto& a : world.allies) {
+        if (a.index == prism || !a.alive) continue;
+        const auto& f = a.facts();
+        if (f.heals() || f.passive == Passive::linked_pair || f.passive == Passive::gem_focus) continue;
+        const float power = f.raw_output(f.strength.base, f.focus.base) * f.health.base;
+        if (power > best_power) best = a.index, best_power = power; // ties: the lower index, first seen
+    }
+    return best;
+}
+
+// The Prism's tile as willow_follow reads an ally's: seen within 2 rounds, else posted within 6. Not its
+// claim's centre: the guard keeps to the Prism's real tile or not at all.
+bool prism_tile(const World& world, const ChampionBelief& a, vec2& at) {
+    if (a.visible || (a.pos_round >= world.round - 2 && a.pos.x >= 0)) return at = a.pos, true;
+    if (int told = -1; params::comms_ally && comms::told_ally(a.index, at, told) && told >= world.round - 6 && told > a.pos_round) return true;
+    return false;
+}
+
+int seen_bag(const World& world, const ChampionBelief& a) {
+    if (a.is_self) return static_cast<int>(my_gems());
+    return a.visible ? a.gems : comms::bag_of(world, a.index);
+}
+
+const Bodyguard& bodyguard(const World& world) {
+    static Bodyguard g;
+    static int round = -1;
+    if (round == world.round) return g;
+    round = world.round;
+    [[maybe_unused]] const bool was = g.active;
+    g.active = g.suspended = false;
+    static const int prism = [&] {
+        for (const auto& a : world.allies)
+            if (a.facts().passive == Passive::gem_focus) return a.index;
+        return -1;
+    }();
+    if (prism < 0 || world.me().index == prism || !world.me().alive) return g;
+    const auto& p = world.allies[static_cast<std::size_t>(prism)];
+    if (!p.alive || guard_index(world, prism) != world.me().index) return g;
+    // A guard with a bag of its own banks it first.
+    if (static_cast<int>(my_gems()) >= params::brake_bag) return g;
+    const int bag = seen_bag(world, p);
+    if (bag < params::guard_bag) return g;
+    for (const auto& a : world.allies)
+        if (a.index != prism && a.alive && seen_bag(world, a) > bag) return g;
+    vec2 at;
+    // Only a guard already in the Prism's sight takes the post: no long walks to rejoin it.
+    if (!prism_tile(world, p, at) || test(world.map().ally_spawn, at) || dist(world.me().pos, at) > params::guard_join) return g;
+    g.active = true, g.prism = prism, g.at = at, g.bag = bag;
+    debug_block({
+        if (!was) std::printf("BG ON %d %u prism %d bag %d at %d,%d d %d\n", world.round, my_handle(), prism, bag, at.x, at.y, dist(world.me().pos, at));
+        // Hurt by its latest reading with an enemy in sight beside it: an attack on it while we guard.
+        if (p.visible && p.hurt_round >= world.round - 1 && dist(world.me().pos, at) <= params::guard_radius) {
+            int near = 0;
+            for (const auto& e : world.enemies)
+                if (e.alive && e.visible && dist(e.pos, at) <= e.facts().action_range + 1) ++near;
+            if (near > 0) std::printf("BG HIT %d %u prism %d bag %d d %d enemies %d hp %.0f/%.0f\n", world.round, my_handle(), prism, bag,
+                                      dist(world.me().pos, at), near, p.health, p.max_health);
+        }
+    });
+    return g;
+}
+
+bool guard_far(const World& world, int g) {
+    const auto& b = bodyguard(world);
+    if (!b.active || b.suspended || g < 0) return false;
+    for (const auto& m : world.map().groups[g].members)
+        if (dist(m.pos, b.at) <= params::guard_radius) return false;
+    return true;
+}
+
+void guard_suspend(const World& world) {
+    auto& b = const_cast<Bodyguard&>(bodyguard(world));
+    b.suspended = true;
+    debug_block({ if (b.active) std::printf("BG FREE %d %u prism %d bag %d d %d\n", world.round, my_handle(), b.prism, b.bag, dist(my_position(), b.at)); });
+}
+
+// 3 to guard_station tiles from the Prism: no one 3x3 ground spell covers us both (at 2 the tile
+// between us centres one), off
+// the tiles of a group it holds alone (we would split its payout).
+bool guard_follow(World& world, Pathing& pathing, Safety& safety) {
+    const auto& b = bodyguard(world);
+    if (!b.active || !my_can_move() || stunned_turn) return false;
+    const vec2 here = my_position();
+    const int d = dist(here, b.at);
+    const auto trace = [&](int step) {
+        debug_block({ std::printf("BG FOLLOW %d %u prism %d bag %d d %d at %d,%d from %d,%d step %d\n", world.round, my_handle(), b.prism, b.bag, d,
+                                  b.at.x, b.at.y, here.x, here.y, step); });
+        (void)step;
+    };
+    const bitboard* held = prism_hold_seen(world, false);
+    if (d > 2 * ground_radius && d <= params::guard_station && !(held && test(*held, here))) return trace(0), true;
+    static bitboard goals{cambc::uninitialized};
+    copy_into(within(world.map().open_for_us, b.at, params::guard_station), goals);
+    drop(goals, square(b.at, 2 * ground_radius));
+    if (held) drop(goals, *held);
+    if (board_empty(goals)) return trace(-2), false;
+    world.throw_if_stale();
+    if (!pathing.step_towards(goals)) return trace(-1), false;
+    trace(1);
+    see_revealed(world, pathing, safety);
+    return true;
+}
+
+} // namespace
+
+} // namespace aph
