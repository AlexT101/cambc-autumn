diff --git a/bots/variants/cal-c/src/combat/prism_war.cc b/bots/variants/cal-c/src/combat/prism_war.cc
new file mode 100644
index 000000000..def96c2a2
--- /dev/null
+++ b/bots/variants/cal-c/src/combat/prism_war.cc
@@ -0,0 +1,261 @@
+// The Prism war: our Prism against the enemy's. Prism's Focus grows 1.5 a carried gem, so the duel goes
+// to the bigger bag, and the killer takes the loser's whole bag. Read once a turn from World's beliefs;
+// the systems that decide each thing ask it (want_home, the work guard, farm, the tribute, the game-ender
+// stop, prey).
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+namespace prism_war {
+
+// Tiles from which the enemy Prism can hit our tile before our next turn: its walk this turn and its
+// stun's range (the ground spell's 3x3 reaches as far without the walk). Its spells exclude walking,
+// so the step is a margin for a turn order that gives it two turns before our next.
+constexpr int zone_reach = 1 + ability_range;
+// Past this many rounds unseen and untracked, the square it may be in (one tile a round) is wider than
+// our own sight, which sees it coming farther out than it reaches: no zone.
+constexpr int stale_rounds = vision_radius;
+
+int ally_prism_index(const World& world) {
+    static const int index = [&] {
+        for (const auto& a : world.allies)
+            if (a.facts().passive == Passive::gem_focus) return a.index;
+        return -1;
+    }();
+    return index;
+}
+
+int enemy_prism_index(const World& world) {
+    static const int index = [&] {
+        for (const auto& e : world.enemies)
+            if (e.facts().passive == Passive::gem_focus) return e.index;
+        return -1;
+    }();
+    return index;
+}
+
+struct State {
+    int round = -1;
+    std::uint32_t observations = 0, gems = 0;
+    Reading reading;
+    // E's tiles (`shape`) and the boards drawn around them, each on first ask this key.
+    enum class Shape : std::uint8_t { none, square, possible } shape = Shape::none;
+    vec2 centre{-1, -1};
+    int base = 0; // the square's radius before any reach: its rounds unseen past tracking
+    bool zone_made = false, inner_made = false, deeper_made = false;
+    int inner_k = -1, deeper_k = -1;
+    bitboard zone{cambc::uninitialized}, inner{cambc::uninitialized}, deeper{cambc::uninitialized}, scratch{cambc::uninitialized};
+    // holds_tribute's answer, from `held_at`.
+    vec2 held_at{-1, -1};
+    bool held = false;
+};
+State state;
+Posture traced = Posture::none; // our Prism's last posture traced
+
+// The tiles within k of where E may be, into out.
+void draw(const State& s, const ChampionBelief& e, int k, bitboard& out) {
+    if (s.shape == State::Shape::possible) {
+        square_dilate(e.possible, k, out);
+        return;
+    }
+    clear_board(out);
+    out.draw_chebyshev(s.centre, static_cast<float>(s.base + k));
+}
+
+const Reading& read_now(const World& world) {
+    const std::uint32_t gems = world.me().alive ? my_gems() : 0;
+    auto& s = state;
+    if (s.round == world.round && s.observations == world.observations && s.gems == gems) return s.reading;
+    s.round = world.round, s.observations = world.observations, s.gems = gems;
+    s.zone_made = s.inner_made = s.deeper_made = false;
+    s.held_at = {-1, -1};
+    s.shape = State::Shape::none;
+    Reading r;
+    const int ours = ally_prism_index(world), theirs = enemy_prism_index(world);
+    if (ours >= 0 && theirs >= 0) {
+        const auto& a = world.allies[static_cast<std::size_t>(ours)];
+        const auto& e = world.enemies[static_cast<std::size_t>(theirs)];
+        // An enemy Prism we never saw has no known bag: no reading.
+        if (a.alive && e.alive && e.stats_round >= 0) {
+            r.ours = &a, r.enemy = &e;
+            r.our_bag = a.is_self ? static_cast<int>(gems) : a.visible ? a.gems : comms::bag_of(world, a.index);
+            r.enemy_bag = e.gems;
+            // Equal bags decide nothing, and below a bag worth chasing (brake_bag) on both sides the Focus
+            // between them is too small to decide the duel.
+            if (std::max(r.our_bag, r.enemy_bag) >= params::brake_bag && r.enemy_bag != r.our_bag)
+                r.posture = r.enemy_bag > r.our_bag ? Posture::outgunned : Posture::dominant;
+        }
+    }
+    s.reading = r;
+    if (r.enemy && r.posture == Posture::outgunned) {
+        const auto& e = *r.enemy;
+        if (e.visible) s.shape = State::Shape::square, s.centre = enemy_reach::origin(e), s.base = 0;
+        else if (e.tracked) s.shape = State::Shape::possible;
+        else if (const int age = world.round - e.pos_round; age <= stale_rounds) s.shape = State::Shape::square, s.centre = e.pos, s.base = age;
+    }
+    if (const Posture now = r.posture; ours == world.self_index && now != traced) {
+        debug_block({
+            std::printf("PWAR %d %u %d %d %c\n", world.round, my_handle(), r.our_bag, r.enemy_bag,
+                        now == Posture::outgunned ? 'O' : now == Posture::dominant ? 'D' : '-');
+        });
+        traced = now;
+    }
+    return s.reading;
+}
+
+// Our Prism itself.
+bool is_ours(const Reading& r) { return r.ours && r.ours->is_self; }
+
+} // namespace prism_war
+
+const prism_war::Reading& prism_war::reading(const World& world) { return read_now(world); }
+
+bool prism_war::outgunned(const World& world) { return read_now(world).posture == Posture::outgunned; }
+
+bool prism_war::zone_bound(const World& world) {
+    const auto& r = read_now(world);
+    if (r.posture != Posture::outgunned || !world.me().alive) return false;
+    return is_ours(r) ? params::prism_war_avoid : params::prism_war_ally_avoid && static_cast<int>(my_gems()) >= params::brake_bag;
+}
+
+const bitboard* prism_war::zone(const World& world) {
+    read_now(world);
+    auto& s = state;
+    if (s.shape == State::Shape::none) return nullptr;
+    if (!s.zone_made) draw(s, *s.reading.enemy, zone_reach, s.zone), s.zone_made = true;
+    return &s.zone;
+}
+
+bool prism_war::in_zone(const World& world, vec2 p) {
+    const auto* z = zone(world);
+    return z && in_bounds(p) && test(*z, p);
+}
+
+const bitboard* prism_war::avoid(const World& world, vec2 here) {
+    if (!zone_bound(world)) return nullptr;
+    const auto* z = zone(world);
+    if (!z || !in_bounds(here) || !test(*z, here)) return z;
+    // Inside it, no step nearer to it: the tiles within d - 1 of where it may be, d ours.
+    auto& s = state;
+    const auto& e = *s.reading.enemy;
+    int d = zone_reach;
+    if (s.shape == State::Shape::possible) {
+        while (d > 0 && possible_within(e, here, d - 1)) --d;
+    } else {
+        d = std::max(0, dist(here, s.centre) - s.base);
+    }
+    if (d <= 0) return nullptr;
+    if (!s.deeper_made || s.deeper_k != d - 1) draw(s, e, d - 1, s.deeper), s.deeper_made = true, s.deeper_k = d - 1;
+    return &s.deeper;
+}
+
+bool prism_war::blocks_group(const World& world, int g) {
+    if (!zone_bound(world)) return false;
+    const auto* z = zone(world);
+    if (!z) return false;
+    auto& s = state;
+    const auto& G = world.map().groups[static_cast<std::size_t>(g)];
+    // A capture stands on the camp tiles; a clear stands within attack range of a member: every such
+    // tile is in the zone once the members are within zone_reach - range of where it may be.
+    const bool cleared = world.camps[static_cast<std::size_t>(g)].state == CampState::cleared;
+    const bitboard* core = z;
+    if (!cleared) {
+        const int k = zone_reach - world.me().facts().attack_range();
+        if (k < 0) return false;
+        if (!test(*z, G.centre)) return false;
+        if (!s.inner_made || s.inner_k != k) draw(s, *s.reading.enemy, k, s.inner), s.inner_made = true, s.inner_k = k;
+        core = &s.inner;
+    }
+    if (!test(*core, G.centre)) return false;
+    // tiles & ~core
+    or_into(G.tiles(), *core, s.scratch);
+    xor_into(s.scratch, *core, s.scratch);
+    return board_empty(s.scratch);
+}
+
+bool prism_war::flee(const World& world, vec2 here) {
+    if constexpr (!params::prism_war_avoid) return false;
+    const auto& r = read_now(world);
+    if (r.posture != Posture::outgunned || !is_ours(r) || !in_zone(world, here)) return false;
+    debug_block({
+        static int last = -1;
+        if (last != world.round) {
+            last = world.round;
+            std::printf("PWLEAVE %d %u %d %d %d,%d %d,%d %d\n", world.round, my_handle(), r.our_bag, r.enemy_bag, here.x, here.y,
+                        r.enemy->pos.x, r.enemy->pos.y, world.round - r.enemy->pos_round);
+        }
+    });
+    return true;
+}
+
+bool prism_war::threatens_tribute(const World& world, int altar, int arrive, int turns) {
+    if constexpr (!params::prism_war_hold_tribute) return false;
+    const auto& r = read_now(world);
+    if (altar < 0 || r.posture != Posture::outgunned || !is_ours(r) || !winning_bag(world)) return false;
+    const auto& e = *r.enemy;
+    // Its earliest turn within zone_reach of a tribute tile, as the crow flies, having walked a tile a
+    // round since it was last seen. Unseen past the zone's staleness, where it is is no reading.
+    const int submit = static_cast<int>(cambc::constants::submit_gems_range);
+    const int age = e.visible ? 0 : world.round - e.pos_round;
+    if (!e.visible && !e.tracked && age > stale_rounds) return false;
+    const int theirs = dist(enemy_reach::origin(e), world.map().altars[static_cast<std::size_t>(altar)].pos) - submit - zone_reach - age;
+    return theirs <= arrive + turns;
+}
+
+bool prism_war::holds_tribute(const World& world) {
+    if constexpr (!params::prism_war_hold_tribute) return false;
+    const auto& r = read_now(world);
+    if (r.posture != Posture::outgunned || !is_ours(r) || !winning_bag(world)) return false;
+    auto& s = state;
+    const vec2 here = my_position();
+    if (s.held_at == here) return s.held;
+    s.held_at = here;
+    const int submit = static_cast<int>(cambc::constants::submit_gems_range);
+    const int turns = tribute_turns(world, static_cast<int>(my_gems()));
+    const auto& altars = world.map().altars;
+    // Short of the game's last rounds, every altar not locked against us is in its reach before the channel ends.
+    bool held = false;
+    for (int a = 0; a < static_cast<int>(altars.size()); ++a) {
+        if (world.altars[static_cast<std::size_t>(a)].enemy_lock) continue;
+        const int arrive = std::max(0, dist(here, altars[static_cast<std::size_t>(a)].pos) - submit);
+        if (rounds_left(world) <= arrive + turns + endgame_margin || !threatens_tribute(world, a, arrive, turns)) {
+            held = false;
+            break;
+        }
+        held = true;
+    }
+    s.held = held;
+    if (held) {
+        debug_block({
+            static int last = -1;
+            if (last != world.round) {
+                last = world.round;
+                std::printf("PWHOLD %d %u %d %d %d\n", world.round, my_handle(), r.our_bag, r.enemy_bag, turns);
+            }
+        });
+    }
+    return held;
+}
+
+bool prism_war::spares(const World& world, const ChampionBelief& e) {
+    if constexpr (!params::prism_war_no_ender) return false;
+    const auto& r = read_now(world);
+    return r.posture == Posture::outgunned && is_ours(r) && r.enemy == &e;
+}
+
+const ChampionBelief* prism_war::hunt(const World& world, vec2 here) {
+    if constexpr (!params::prism_war_hunt) return nullptr;
+    const auto& r = read_now(world);
+    if (r.posture != Posture::dominant || !is_ours(r)) return nullptr;
+    const auto& e = *r.enemy;
+    // Seen within the horizon past which it could be anywhere, and as near as prey looks.
+    if (!e.visible && !(e.tracked && world.round - e.pos_round <= params::track_horizon)) return nullptr;
+    if (dist(here, e.pos) > vision_radius) return nullptr;
+    return &e;
+}
