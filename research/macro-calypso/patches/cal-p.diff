+// Prism's spells exclude walking, so in a Prism duel the one whose turn comes while the other stands
+// in range strikes first: our Prism near an enemy Prism acts as late in our team as it can.
+constexpr int prism_duel_range = 10;
+bool prism_duel(const World& world) {
+    const auto& me = world.me();
+    if (!me.alive || me.type != cambc::champion_type::prism) return false;
+    const auto& info = my_record();
+    if (info.x < 0) return false;
+    const vec2 at{info.x, info.y};
+    for (const auto& e : world.enemies)
+        if (e.alive && e.type == cambc::champion_type::prism && e.age(world.round) <= params::track_horizon
+            && dist(e.pos, at) <= prism_duel_range)
+            return true;
+    return false;
+}
