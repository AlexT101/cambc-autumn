@@ -128,6 +128,13 @@ bool chasing_value = false;
 // Above the claim (0-7) and support mailbox (8-10): the chase bit, then its posting round mod 4.
 constexpr int chase_shift = 11;
 static_assert(support_mailbox::payload_shift + 3 <= chase_shift && chase_shift + 3 <= priority_payload_bits);
+// Above the chase: our Prism hunts the enemy's (combat/hunt.cc), then the posting round's parity. A reader
+// knows the round the payload it sees was set in (this one if the poster has acted, else the last), so the
+// parity alone tells a payload a lost turn left standing.
+constexpr int hunt_shift = chase_shift + 3;
+static_assert(hunt_shift + 2 <= priority_payload_bits);
+int hunting_round = -1;
+bool hunting_value = false;
 
 static_assert(support_mailbox::protected_mate == 0 && support_mailbox::healer == 1); // support_pair's order
 
@@ -316,6 +323,15 @@ bool ally_chasing(const World& world, const ChampionBelief& a) {
     return ((world.round - static_cast<int>(p >> (chase_shift + 1) & 3)) & 3) <= 1;
 }
 
+void hunting(int round, bool v) { hunting_round = round, hunting_value = v; }
+
+bool ally_hunting(const World& world, const ChampionBelief& a) {
+    if (a.is_self || !a.alive) return false;
+    const auto p = payload_of(world, a);
+    const int posted = a.acted ? world.round : world.round - 1;
+    return p >= 0 && (p >> hunt_shift & 1) && static_cast<int>(p >> (hunt_shift + 1) & 1) == (posted & 1);
+}
+
 std::uint32_t priority_payload(const World& world) {
     auto payload = static_cast<std::uint32_t>(detail::posts.mine + 1);
     const auto pair = support_pair(world);
@@ -324,6 +340,7 @@ std::uint32_t priority_payload(const World& world) {
                                                                                      pair[0]->alive && pair[1]->alive));
     if (chasing_round == world.round && chasing_value)
         payload |= 1u << chase_shift | static_cast<std::uint32_t>(world.round & 3) << (chase_shift + 1);
+    if (hunting_round == world.round && hunting_value) payload |= 1u << hunt_shift | static_cast<std::uint32_t>(world.round & 1) << (hunt_shift + 1);
     return payload;
 }
 
