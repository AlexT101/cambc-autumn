diff -ruN bots/variants/astraeus-29cd092/src/economy/presence.cc bots/variants/ast-presence-dev/src/economy/presence.cc
--- bots/variants/astraeus-29cd092/src/economy/presence.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/ast-presence-dev/src/economy/presence.cc	2026-11-05 16:23:32.880968247 +0000
@@ -0,0 +1,154 @@
+// Presence on one-zone maps (research/altar-contest-2026-11-05/presence.md). Where every altar is in
+// one zone, each side banks there: a body farming near it sees the enemy's tributes start and can
+// stun, lock or kill the carrier, and is at hand for our own long channels. That is worth more as the
+// game nears its end, so the farm loop weighs groups by their walk to the zone, by the stakes.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// Altars linked by walks of at most zone_link between their tribute tiles, transitively, form one
+// zone (none with no altar). Static, read once.
+bool one_zone(const StaticMap& map) {
+    static int known = -1;
+    if (known >= 0) return known;
+    const int n = static_cast<int>(map.altars.size());
+    known = n == 1;
+    if (n < 2) return known;
+    // A link needs the altars within zone_link + 2 as the crow flies (tribute tiles are within 1).
+    const auto near = [&](int a, int b) { return dist(map.altars[a].pos, map.altars[b].pos) <= params::zone_link + 2; };
+    std::vector<int> zone(n, -1);
+    zone[0] = 0;
+    for (bool grew = true; grew;) {
+        grew = false;
+        for (int a = 0; a < n; ++a)
+            for (int b = 0; b < n; ++b)
+                if (zone[a] == 0 && zone[b] < 0 && near(a, b)) zone[b] = 0, grew = true;
+    }
+    for (int a = 0; a < n; ++a)
+        if (zone[a] < 0) return known = 0;
+    // Now by walk, a capped field from each altar in turn (impassable: the same for both teams).
+    static cambc::distance_field steps;
+    static bitboard visited{cambc::uninitialized};
+    std::fill(zone.begin(), zone.end(), -1);
+    zone[0] = 0;
+    for (bool grew = true; grew;) {
+        grew = false;
+        for (int a = 0; a < n; ++a) {
+            if (zone[a] != 0) continue;
+            bool any = false;
+            for (int b = 0; b < n; ++b) any |= zone[b] < 0 && near(a, b);
+            if (!any) continue;
+            steps.compute(map.impassable, map.altars[a].tribute_tiles(), visited, static_cast<std::uint16_t>(params::zone_link));
+            zone[a] = 1; // flooded
+            for (int b = 0; b < n; ++b) {
+                if (zone[b] >= 0 || !near(a, b)) continue;
+                for (const vec2 p : map.altars[b].tribute_tiles().positions())
+                    if (steps_at(steps, p) <= params::zone_link) {
+                        zone[b] = 0, grew = true;
+                        break;
+                    }
+            }
+        }
+    }
+    for (int a = 0; a < n; ++a)
+        if (zone[a] < 0) return known = 0;
+    return known = 1;
+}
+
+int presence_level(const World& world) {
+    // Settled once a game (a few capped fields at most): other maps then read nothing more.
+    if (!one_zone(world.map())) return 0;
+    // Either side's tributed gems and the bags it must still bank there. Allies' as posted, so that
+    // the team agrees and an ally walking in and out of sight does not flip the level.
+    int ours = world.score.ally, theirs = world.score.enemy;
+    for (const auto& a : world.allies)
+        if (a.alive) ours += a.is_self ? static_cast<int>(my_gems()) : comms::bag_of(world, a.index);
+    for (const auto& e : world.enemies)
+        if (e.alive) theirs += e.gems;
+    const float near_win = std::min(1.0f, static_cast<float>(std::max(ours, theirs)) / static_cast<float>(cambc::constants::winning_gems));
+    // Squared: a tribute decides the game only near the win, and both sides have to bank there.
+    const int level = static_cast<int>(near_win * near_win * static_cast<float>(params::presence_levels));
+    return level;
+}
+
+// presence_wait's goal: tiles on the zone's enemy-facing side 2-4 steps out from its tribute tiles,
+// in a bush and out of camp reach where there are some. Empty where there is no such tile.
+std::optional<Field>& screen_field() {
+    static std::optional<Field> field;
+    return field;
+}
+
+// Once a game, as presence first applies (before the farm loop, whose budget takes it).
+void build_screen(const World& world, Pathing& pathing) {
+    const auto& map = world.map();
+    static bitboard tribute{cambc::uninitialized}, reached{cambc::uninitialized}, band{cambc::uninitialized};
+    clear_board(tribute);
+    int enemy_side = unreachable; // the enemy's walk to the nearest tribute tile
+    for (const auto& a : map.altars) {
+        tribute |= a.tribute_tiles();
+        for (const vec2 p : a.tribute_tiles().positions()) enemy_side = std::min(enemy_side, map.enemy_spawn_steps(p));
+    }
+    static cambc::distance_field steps;
+    steps.compute(map.blocked_for_us, tribute, band, static_cast<std::uint16_t>(ability_range));
+    band &= map.standable;
+    drop(band, map.near_enemy_spawn);
+    drop(band, map.ally_spawn);
+    clear_board(reached);
+    for (const auto& g : map.groups)
+        for (const auto& m : g.members)
+            if (m.strength > 0) reached.draw_chebyshev(m.pos, static_cast<float>(m.reach));
+    // Best class first: bush out of camp reach, out of reach, bush, any; on the enemy's side, then off it.
+    std::array<bitboard, 8> classes;
+    for (auto& c : classes) clear_board(c);
+    for (const vec2 p : band.positions()) {
+        if (steps_at(steps, p) < 2) continue;
+        const bool facing = map.enemy_spawn_steps(p) < enemy_side;
+        set_tile(classes[(facing ? 0 : 4) + (test(reached, p) ? 2 : 0) + (test(map.bushes, p) ? 0 : 1)], p);
+    }
+    for (const auto& c : classes)
+        if (!c.is_empty()) {
+            screen_field().emplace(make_field(pathing.static_walls(), c));
+            break;
+        }
+    world.throw_if_stale();
+}
+
+const float* presence_weights(const World& world, Pathing& pathing, int level) {
+    static std::vector<float> weights;
+    static int for_level = 0;
+    if (level <= 0) return nullptr;
+    const auto& groups = world.map().groups;
+    if (level == for_level && weights.size() == groups.size()) return weights.data();
+    if (for_level == 0) build_screen(world, pathing);
+    for_level = level;
+    debug_block({ std::printf("PRESENCE %d %u level %d\n", world.round, my_handle(), level); });
+    weights.resize(groups.size());
+    const float stake = params::presence_weight * static_cast<float>(level) / static_cast<float>(params::presence_levels);
+    for (std::size_t g = 0; g < groups.size(); ++g) {
+        // Full within sight of the tribute tiles, none past twice that: from the group a body sees a
+        // tribute start, and walks into stun range before a long channel ends.
+        const int steps = pathing.centre_to_altar(static_cast<int>(g));
+        const float near = steps == unreachable ? 0.0f : std::clamp(2.0f - static_cast<float>(steps) / vision_radius, 0.0f, 1.0f);
+        // As a discount on the rest, so that no weight passes 1 and the farm's bounds hold.
+        weights[g] = (1.0f + stake * near) / (1.0f + stake);
+    }
+    return weights.data();
+}
+
+// With no group to farm and presence on: wait at the screen (screen_field). False where there is
+// none or where we are threatened, for the usual step off respawning tiles.
+bool presence_wait(const World& world, Pathing& pathing, Safety& safety) {
+    const auto& field = screen_field();
+    const vec2 here = my_position();
+    if (!field || safety.threatened(here)) return false;
+    debug_block({ std::printf("PWAIT %d %u at %d\n", world.round, my_handle(), field->at(here)); });
+    if (field->at(here) == 0) return true;
+    step_safely(world, pathing, *field, safety);
+    return true;
+}
+
+} // namespace
+
+} // namespace aph
