+// Presence on one-zone maps (economy/presence.cc): altars whose tribute tiles are this walk apart are one zone.
+inline constexpr int zone_link = 10;
+// At the win's stakes, a group within sight of the zone outweighs one far from it by 1 + this.
+inline constexpr float presence_weight = 1.0f;
+// The stakes' resolution: the farm's kept facts are read again at each step.
+inline constexpr int presence_levels = 32;
+
 } // namespace aph::params
