+// One stable service client and Willow, bound to the actual roster even while either is absent.
+inline std::array<const ChampionBelief*, 2> support_pair(const World& world) {
+    static std::array<int, 2> index{-2, -2};
+    if (index[0] == -2) {
+        index = {-1, -1};
+        int preferred = 3;
+        for (int i = 0; i < static_cast<int>(world.allies.size()); ++i) {
+            const auto type = world.allies[i].type;
+            const int rank = type == cambc::champion_type::prism ? 0 : type == cambc::champion_type::stellar ? 1
+                            : type == cambc::champion_type::cassi ? 2 : 3;
+            if (rank < preferred) index[0] = i, preferred = rank;
+            if (type == cambc::champion_type::willow) index[1] = i;
+        }
+    }
+    if (index[0] < 0 || index[1] < 0) return {};
+    return {&world.allies[index[0]], &world.allies[index[1]]};
+}
