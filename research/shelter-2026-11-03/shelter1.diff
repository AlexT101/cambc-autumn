+const bitboard& Safety::camp_range_area() {
+    static bitboard area{cambc::uninitialized};
+    if (!camp_range_known_) {
+        clear_board(area);
+        for (const auto& m : awake_members())
+            draw_square(area, m.pos, static_cast<float>(m.range));
+        camp_range_known_ = true;
+    }
+    return area;
+}
+
+float Safety::camp_fire(vec2 p) {
+    float total = 0;
+    for (const auto& m : awake_members())
+        if (in_square(p, m.pos, m.range)) total += m.strength;
+    return total;
+}
