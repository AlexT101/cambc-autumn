+std::optional<int> Pathing::CampEscape::at(vec2 p) const {
+    if (!valid || !exact || !in_bounds(p) || test(walls, p)) return std::nullopt;
+    if (steps == unreachable) return exhausted ? std::optional<int>{unreachable} : std::nullopt;
+    if (p == origin) return steps;
+    if (steps == 0) return test(goals, p) ? std::optional<int>{0} : std::nullopt;
+    if (ray != vec2{}) {
+        for (int k = 0; k <= steps; ++k)
+            if (p == origin + vec2{ray.x * k, ray.y * k}) return steps - k;
+        return std::nullopt;
+    }
+    const int d = steps_at(*labels, p);
+    return d <= steps ? std::optional<int>{d} : std::nullopt;
+}
+
+const Pathing::CampEscape& Pathing::camp_escape(const bitboard& hazard, int ray_limit, bool exact) {
+    world_.throw_if_stale();
+    if (!camp_escape_) camp_escape_ = std::make_unique<CampEscape>();
+    auto& out = *camp_escape_;
+    static bitboard walls{cambc::uninitialized}, goals{cambc::uninitialized};
+    occupied_into(walls); // attacks can change occupancy without moving or invalidating blocked()
+    if (const auto* held = guard()) or_into(walls, *held, walls);
+    const vec2 here = my_pos();
+    set_tile(walls, here, false);
+    and_into(map().standable, hazard, goals);
+    xor_into(goals, map().standable, goals);
+    drop(goals, walls);
+    if (!out.valid || out.origin != here || out.walls != walls || out.goals != goals) {
+        out.valid = false;
+        copy_into(walls, out.walls);
+        copy_into(goals, out.goals);
+        out.origin = here;
+        out.steps = unreachable;
+        out.ray = {};
+        out.exact = out.exhausted = false;
+        if (test(goals, here)) out.steps = 0, out.exact = true;
+        else {
+            for (const auto d : directions) {
+                for (int k = 1; k <= ray_limit; ++k) {
+                    const vec2 p = here + vec2{d.x * k, d.y * k};
+                    if (!in_bounds(p) || test(walls, p)) break;
+                    if (test(goals, p)) {
+                        if (k < out.steps) out.steps = k, out.ray = d;
+                        break;
+                    }
+                }
+            }
+            if (out.steps != unreachable) out.exact = !any_within(goals, here, out.steps - 1);
+        }
+        out.valid = true;
+    }
+    if (!out.exact && (exact || out.steps == unreachable)) {
+        out.valid = false;
+        if (!out.labels) out.labels = std::make_unique<cambc::distance_field>();
+        static bitboard origin, visited{cambc::uninitialized};
+        origin.clear();
+        set_tile(origin, here);
+        const int layers = out.labels->compute_to_with_expansion_count(out.walls, out.goals, origin, visited, unreachable);
+        world_.throw_if_stale();
+        out.steps = steps_at(*out.labels, here);
+        out.ray = {};
+        out.exhausted = out.steps == unreachable && layers < unreachable;
+        out.exact = out.steps != unreachable || out.exhausted;
+        out.valid = true;
+    }
+    world_.throw_if_stale();
+    return out;
+}
