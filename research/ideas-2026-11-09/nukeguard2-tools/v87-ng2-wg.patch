-// fix-combat (research/ladder-scrims-2026-11-06/fix-combat.md): hidden bush steps, and a lost retreat fought instead.
+// fix-combat (research/ladder-scrims-2026-11-06/fix-combat.md): hidden bush steps, a lost retreat fought instead,
+// and no step onto a lethal tile (every credible threat and camp together kill us there) from a tile that is not.
 #include "../bot_parts.h"
 
 namespace aph {
 
 namespace {
 
+// The guard with the lethal tiles within `radius` added, from a tile that is not lethal.
+const bitboard* fixc_add_lethal(const World& world, Safety& safety, vec2 here, int radius, const bitboard* base, bitboard& out) {
+    if (!safety.credible_enemy_may_hit_within(here, radius)) return base;
+    const int side = 2 * radius + 1;
+    // Each lethal() past the threat build is a few hundred: skip the zone when the turn is short.
+    if (!fuel_ok(act_reserve + safety.build_cost_estimate() + 1500 * static_cast<std::uint64_t>(side * side))) {
+        note_shortcut("lethal-guard");
+        return base;
+    }
+    if (safety.lethal(here)) return base;
+    const auto& open = world.map().open_for_us;
+    bool copied = false;
+    for (int dy = -radius; dy <= radius; ++dy)
+        for (int dx = -radius; dx <= radius; ++dx) {
+            const vec2 q{here.x + dx, here.y + dy};
+            if ((dx == 0 && dy == 0) || !in_bounds(q) || !test(open, q) || (base && test(*base, q)) || !safety.lethal(q)) continue;
+            if (!copied) {
+                copied = true;
+                if (base) copy_into(*base, out);
+                else clear_board(out);
+            }
+            set_tile(out, q);
+        }
+    return copied ? &out : base;
+}
+
+const bitboard* fixc_step_guard(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_lethal(world, safety, here, radius, step_guard(world, safety, here, radius), out);
+}
+const bitboard* fixc_step_cover(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_lethal(world, safety, here, radius, step_guard_cover(world, safety, here, radius), out);
+}
+const bitboard* fixc_work_guard(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_lethal(world, safety, here, radius, work_guard(world, safety, here, radius), out);
+}
+const bitboard* fixc_work_cover(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_lethal(world, safety, here, radius, work_cover(world, safety, here, radius), out);
+}
+
