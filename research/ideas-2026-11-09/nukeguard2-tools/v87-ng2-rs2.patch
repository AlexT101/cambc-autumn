diff -ru oc-base25/src/combat/fight.cc v87-ng2-rs2/src/combat/fight.cc
--- oc-base25/src/combat/fight.cc	2026-11-08 01:43:46.764599765 +0000
+++ v87-ng2-rs2/src/combat/fight.cc	2026-11-09 04:26:39.388426938 +0000
@@ -262,8 +262,32 @@
     for (int i = 0; i < later; ++i)
         price(rest[i]);
     std::stable_sort(rest.begin(), rest.begin() + later, by);
+    // A step where every credible threat and camp together cannot kill us goes first: the bounds
+    // rank by summed upper bounds, which put a lethal step ahead of one that is not (Safety::lethal).
+    const bool weigh = later > 0 && fuel_ok(act_reserve + safety.build_cost_estimate() + 2000 * static_cast<std::uint64_t>(later));
+    std::array<bool, 8> deadly{};
+    if (weigh)
+        for (int i = 0; i < later; ++i)
+            if (!(deadly[i] = safety.lethal(rest[i].p)) && pathing.try_move(rest[i].p)) return;
+    // Every ranked step is lethal: a step that is not, sideways or away (touched, so left unranked),
+    // nearest home, keeps us alive a turn; and where we stand, if not lethal, beats any of them.
+    if (weigh && fuel_ok(act_reserve + safety.build_cost_estimate() + 2000 * 9)) {
+        if (!safety.lethal(here)) return;
+        vec2 best{-1, -1};
+        int best_steps = unreachable;
+        for (auto d : directions) {
+            const vec2 p = here + d;
+            if (!in_bounds(p) || test(blocked, p)) continue;
+            const int s = home.at(p);
+            if (s == unreachable || s >= best_steps) continue;
+            bool ranked = false;
+            for (int i = 0; i < later; ++i) ranked |= rest[i].p == p;
+            if (!ranked && !safety.lethal(p)) best = p, best_steps = s;
+        }
+        if (best.x >= 0 && pathing.try_move(best)) return;
+    }
     for (int i = 0; i < later; ++i)
-        if (pathing.try_move(rest[i].p)) return;
+        if ((!weigh || deadly[i]) && pathing.try_move(rest[i].p)) return;
     pathing.step_towards(home);
 }
 
