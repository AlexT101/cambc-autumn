diff -ru bots/variants/oc-base25/src/combat/fixc.cc bots/variants/ng2-probe/src/combat/fixc.cc
--- bots/variants/oc-base25/src/combat/fixc.cc	2026-11-07 01:14:33.642185907 +0000
+++ bots/variants/ng2-probe/src/combat/fixc.cc	2026-11-09 04:07:23.734652425 +0000
@@ -1,10 +1,117 @@
-// fix-combat (research/ladder-scrims-2026-11-06/fix-combat.md): hidden bush steps, and a lost retreat fought instead.
+// fix-combat (research/ladder-scrims-2026-11-06/fix-combat.md): hidden bush steps, a lost retreat fought instead,
+// and no step into a nuke zone (one enemy's ready abilities alone kill us there) from outside every zone.
 #include "../bot_parts.h"
 
 namespace aph {
 
 namespace {
 
+// Our health and shield as a blow at p meets them, as Safety::lethal reads them.
+float fixc_health_at(const World& world, vec2 p) {
+    const float shield = world.me().shield_slot >= 0 ? shield_value(world.me().handle) : 0.0f;
+    return (test(world.map().ally_spawn, p) ? my_max_health() : my_health()) + shield;
+}
+
+// Per turn: the seen enemies whose largest blow could reach our health, and their basic-only strikes.
+struct Nukers {
+    int round = -1;
+    std::uint32_t observations = 0;
+    float health = -1;
+    std::uint32_t mask = 0;
+    std::array<Strike, 16> basic;
+    struct Memo {
+        vec2 p{-1, -1};
+        std::int8_t who = -1;
+        std::uint32_t stamp = 0;
+    };
+    std::array<Memo, 32> memo;
+    std::uint32_t stamp = 0;
+};
+Nukers nukers_state;
+
+Nukers& fixc_nukers(const World& world, Safety& safety) {
+    auto& n = nukers_state;
+    const float health = my_health();
+    if (n.round == world.round && n.observations == world.observations && n.health == health) return n;
+    n.round = world.round, n.observations = world.observations, n.health = health, n.mask = 0, ++n.stamp;
+    if (!world.me().alive) return n;
+    const float floor = health / world.me().taken;
+    for (auto left = safety.seen_enemies(); left; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (!e.alive || !e.visible || e.index >= 16) continue;
+        const auto& s = safety.strike_of(e);
+        if (s.reach < 0 || s.at(0) < floor) continue;
+        n.basic[static_cast<std::size_t>(e.index)] = strike_with(e, 0u);
+        n.mask |= 1u << e.index;
+    }
+    return n;
+}
+
+// e alone kills us at p before our next turn by its ready abilities (its basic attacks alone would not).
+bool fixc_nuke_kills(const World& world, Safety& safety, const ChampionBelief& e, vec2 p, float health) {
+    const vec2 from = e.teleport_pending() && in_bounds(e.tp_dest) ? e.tp_dest : e.pos;
+    const int d = dist(p, from);
+    const auto& s = safety.strike_of(e);
+    const float taken = world.me().taken;
+    if (d > s.reach || s.at(d) * taken < health) return false;
+    if (safety.blow(e, p).damage * taken < health) return false;
+    const int turns = std::max(1, turns_before_ours(world, e));
+    const float basic = nukers_state.basic[static_cast<std::size_t>(e.index)].at(std::max(0, d - (turns - 1))) * static_cast<float>(turns);
+    return basic * taken < health;
+}
+
+// The visible enemy whose ready abilities alone kill us at p, else -1.
+int fixc_nuke_at(const World& world, Safety& safety, vec2 p) {
+    auto& n = fixc_nukers(world, safety);
+    if (!n.mask || !in_bounds(p)) return -1;
+    auto& m = n.memo[static_cast<std::size_t>((p.x & 7) | (p.y & 3) << 3)];
+    if (m.stamp == n.stamp && m.p == p) return m.who;
+    const float health = fixc_health_at(world, p);
+    int who = -1;
+    for (auto left = n.mask; left && who < 0; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (fixc_nuke_kills(world, safety, e, p, health)) who = e.index;
+    }
+    m = {p, static_cast<std::int8_t>(who), n.stamp};
+    return who;
+}
+
+// The guard with the nuke zone's tiles within `radius` added, from a tile outside every zone.
+const bitboard* fixc_add_zone(const World& world, Safety& safety, vec2 here, int radius, const bitboard* base, bitboard& out) {
+    if (!fixc_nukers(world, safety).mask || fixc_nuke_at(world, safety, here) >= 0) return base;
+    const auto& open = world.map().open_for_us;
+    bool copied = false;
+    for (int dy = -radius; dy <= radius; ++dy)
+        for (int dx = -radius; dx <= radius; ++dx) {
+            const vec2 q{here.x + dx, here.y + dy};
+            if ((dx == 0 && dy == 0) || !in_bounds(q) || !test(open, q) || fixc_nuke_at(world, safety, q) < 0) continue;
+            if (!copied) {
+                copied = true;
+                if (base) copy_into(*base, out);
+                else clear_board(out);
+            }
+            set_tile(out, q);
+        }
+    return copied ? &out : base;
+}
+
+const bitboard* fixc_step_guard(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_zone(world, safety, here, radius, step_guard(world, safety, here, radius), out);
+}
+const bitboard* fixc_step_cover(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_zone(world, safety, here, radius, step_guard_cover(world, safety, here, radius), out);
+}
+const bitboard* fixc_work_guard(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_zone(world, safety, here, radius, work_guard(world, safety, here, radius), out);
+}
+const bitboard* fixc_work_cover(const World& world, Safety& safety, vec2 here, int radius) {
+    static bitboard out{cambc::uninitialized};
+    return fixc_add_zone(world, safety, here, radius, work_cover(world, safety, here, radius), out);
+}
+
 // 0: a bush tile no visible enemy and no enemy ward in sight sees (a bush tile is seen only from its own cluster),
 // 1: another bush tile, 2: off bushes. An unseen ward is not guessed at.
 int fixc_bush_rank(const World& world, vec2 p) {
