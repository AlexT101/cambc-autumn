+    struct Pending {
+        vec2 p;
+        int steps, next = 0;
+        float best = std::numeric_limits<float>::infinity();
+    };
+    int index(vec2 p) const { return p.x + width_ * p.y; }
+    const Field& field_;
+    Safety& safety_;
+    int width_;
+    std::vector<Cost> memo_;
+    std::vector<Pending> pending_;
+};
 
