+// Payload changes often leave the strict priority order intact. Validate that order first.
+template <class Write>
+[[gnu::always_inline]] inline void rank_by(const std::int32_t* p, int n, int side, Write&& write) {
+    if (n <= 4) return rank_small<4>(p, n, write);
+    static std::uint64_t order[2]{0xfedcba9876543210ULL, 0xfedcba9876543210ULL};
+    const auto kept = order[side];
+    bool sorted = true;
+    int prev = kept & 15;
+    for (int r = 1; r < n; ++r) {
+        const int i = (kept >> (4 * r)) & 15;
+        if (p[prev] < p[i] || (p[prev] == p[i] && prev > i)) { sorted = false; break; }
+        prev = i;
+    }
+    if (sorted) {
+        for (int r = 0; r < n; ++r) write(static_cast<int>((kept >> (4 * r)) & 15), r);
+        return;
+    }
+    std::uint64_t next = 0;
+    rank_all(p, n, [&](int i, int rank) {
+        next |= static_cast<std::uint64_t>(i) << (4 * rank);
+        write(i, rank);
+    });
+    order[side] = next;
+}
+
