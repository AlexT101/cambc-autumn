+// The candidate retreats often merge onto the same descending path. Cache its next step,
+// keeping each path's additions in their original order.
+class ExitWalk {
+public:
+    ExitWalk(const Field& field, Safety& safety) : field_(field), safety_(safety), stamp_(++serial_) {}
+    float hits(vec2 p) {
+        float hits = 0;
+        for (int s = field_.at(p); s > 1; --s) {
+            const unsigned key = static_cast<unsigned>(p.x + 100 * p.y);
+            auto& kept = kept_[key % kept_.size()];
+            if (kept.stamp != stamp_ || kept.key != key) {
+                vec2 next{-1, -1};
+                float least = 0;
+                for (const auto d : directions) {
+                    const vec2 q = p + d;
+                    if (!in_bounds(q) || field_.at(q) != s - 1) continue;
+                    const float hit = safety_.camp_damage(q);
+                    if (next.x < 0 || hit < least) next = q, least = hit;
+                }
+                kept = {stamp_, key, next, least};
+            }
+            if (kept.next.x < 0) break;
+            hits += kept.hit;
+            p = kept.next;
+        }
+        return hits;
+    }
+private:
+    struct Kept { unsigned stamp, key; vec2 next; float hit; };
+    inline static std::array<Kept, 256> kept_;
+    inline static unsigned serial_ = 0;
+    const Field& field_;
+    Safety& safety_;
+    unsigned stamp_;
+};
