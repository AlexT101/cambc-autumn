+// The altar the enemy's tributes go to: the nearest their spawn by their walk to a tile beside it, ties to the
+// farther from ours; -1 with none reached.
+int watched_altar(const World& world) {
+    static int watched = -2;
+    if (watched != -2) return watched;
+    const auto& map = world.map();
+    const auto& field = map.from_ally_spawn();
+    int best = -1, best_theirs = unreachable, best_ours = -1;
+    for (int a = 0; a < static_cast<int>(map.altars.size()); ++a) {
+        const vec2 p = map.altars[static_cast<std::size_t>(a)].pos;
+        int ours = unreachable, theirs = unreachable;
+        for (int dx = -1; dx <= 1; ++dx)
+            for (int dy = -1; dy <= 1; ++dy)
+                if (const vec2 t{p.x + dx, p.y + dy}; (dx || dy) && in_bounds(t))
+                    ours = std::min(ours, field.at(t)), theirs = std::min(theirs, map.enemy_spawn_steps(t));
+        if (theirs < best_theirs || (theirs == best_theirs && theirs < unreachable && ours > best_ours)) best = a, best_theirs = theirs, best_ours = ours;
+    }
+    return watched = best;
+}
