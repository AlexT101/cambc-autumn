+// `cap`: reachable-tiles searches, bisected, each at a flat host price.
+int static_steps(const bitboard& walls, vec2 from, const bitboard& goals, int lo, int cap) {
+    static bitboard reach{cambc::uninitialized}, hit{cambc::uninitialized};
