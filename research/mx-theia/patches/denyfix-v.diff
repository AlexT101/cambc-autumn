+// The watcher's walk to the watched altar, to within a ward's reach of it, where the ward goes down. The trip
+// is given up for good (3: our other wards go on) with no walk there or no tile for the ward, and until our next
+// return to spawn when a step is refused.
+bool watch_trip(const World& world, Pathing& pathing, Safety& safety, Memory& memory) {
+    if (memory.watch != 1) return false;
+    const int a = watched_altar(world);
+    const vec2 here = my_position();
