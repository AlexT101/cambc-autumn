+// The team's watcher, by the draft alone so that every body agrees: the last pick that is neither our Prism, nor
+// one of a linked pair (its death is two), nor a healer (it follows its mates); else the last that is not the Prism.
+bool watcher(const World& world) {
+    const ChampionBelief* pick = nullptr;
+    int rank = -1;
+    for (const auto& a : world.allies) {
+        if (carrier(a)) continue;
+        const auto& f = a.facts();
+        const int r = (f.passive != Passive::linked_pair) + (f.passive != Passive::linked_pair && !f.heals());
+        if (r >= rank) rank = r, pick = &a;
+    }
+    return pick && pick->is_self;
+}
+
+// Our ward onto a tile beside the watched altar, from within a ward's reach of one: it sees every tribute
+// there for the rest of the game (wards.lifetime), dead or alive, and the alarm tells the team. Open tiles before
+// bush ones (a ward off bushes sees no bush tile, but an enemy stands in the open to tribute more often than
+// not); never the enemy spawn, where a ward is refused, nor a tile a teammate's ward is seen on (an error).
+bool watch_ward(const World& world, Memory& memory) {
+    const int a = watched_altar(world);
+    if (a < 0) return false;
+    const auto& map = world.map();
+    const vec2 here = my_position(), altar = map.altars[static_cast<std::size_t>(a)].pos;
+    const int reach = static_cast<int>(cambc::constants::ward_placement_radius);
+    if (here.x < 0 || dist(here, altar) > reach + 1) return false;
+    static bitboard allied{cambc::uninitialized};
+    cambc::vision::ward_tiles_into(team::ally, allied);
+    for (const bool bush : {false, true})
+        for (int dx = -1; dx <= 1; ++dx)
+            for (int dy = -1; dy <= 1; ++dy) {
+                const vec2 t{altar.x + dx, altar.y + dy};
+                if (!(dx || dy) || !in_bounds(t) || dist(here, t) > reach || test(map.bushes, t) != bush) continue;
+                if (!test(map.passable, t) || test(map.enemy_spawn, t) || test(allied, t)) continue;
+                if (try_ward(t, memory)) {
+                    debug_block({ std::printf("WATCH %d %u ward %d %d\n", world.round, my_handle(), t.x, t.y); });
+                    return memory.watch = 2, true;
+                }
+            }
+    return false;
+}
