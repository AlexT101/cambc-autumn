+    if (dist(here, world.map().altars[static_cast<std::size_t>(a)].pos) <= static_cast<int>(cambc::constants::ward_placement_radius)) {
+        if (stunned_turn) return false;
+        // Held at the altar until the ward is back, else the turn's other goals walk us off.
+        if (cambc::self().ward_cooldown() > 0) return decision = Branch::watch, memory.claim = -1, true;
+        if (watch_ward(world, memory)) warded_round = world.round;
