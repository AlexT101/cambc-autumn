+// A field to one tile, kept for the last few asked: the escort's stand moves with the threat and the site.
+const Field& field_to(const Pathing& pathing, vec2 t) {
+    struct Kept {
+        vec2 at{-1, -1};
+        std::optional<Field> field;
+    };
+    static std::array<Kept, 6> kept;
+    static std::size_t next = 0;
+    for (auto& k : kept)
+        if (k.at == t && k.field) return *k.field;
+    auto& k = kept[next];
+    next = (next + 1) % kept.size();
+    static bitboard goal{cambc::uninitialized};
+    clear_board(goal);
+    set_tile(goal, t);
+    k.at = t;
+    k.field.emplace(make_field(pathing.static_walls(), goal));
+    return *k.field;
+}
+
+// Where the channel is stopped from: the channeller's tile while seen channelling, else its altar (a carrier on
+// its way is where it will channel only once there).
+vec2 channel_tile(const World& world, const EscortSite& site) {
+    if (site.channeller && site.channelling) return site.channeller->is_self ? my_position() : site.channeller->pos;
+    return world.map().altars[static_cast<std::size_t>(site.altar)].pos;
+}
+
+// The enemy that comes at the channel first: the nearest to it of those in sight, and of the unseen, the nearest
+// tile of their `possible` within our sight's radius of the altar; with neither, the enemy spawn they come from.
+vec2 threat_tile(const World& world, const EscortSite& site) {
+    const vec2 c = channel_tile(world, site), alt = world.map().altars[static_cast<std::size_t>(site.altar)].pos;
+    vec2 best{-1, -1};
+    int best_d = unreachable;
+    for (const auto& e : world.enemies) {
+        if (!e.alive) continue;
+        if (e.visible) {
+            if (dist(e.pos, c) < best_d) best = e.pos, best_d = dist(e.pos, c);
+            continue;
+        }
+        if (!e.tracked) continue;
+        for (const int r : {2, 4, 8}) {
+            if (!possible_within(e, alt, r)) continue;
+            for (const vec2 t : positions_within(e.possible, alt, r))
+                if (dist(t, c) < best_d) best = t, best_d = dist(t, c);
+            break;
+        }
+    }
+    return best.x >= 0 ? best : world.map().enemy_spawn_centre;
+}
+
+// Our place among the escorts, by guard_power (ties by index): every ally alive but the carrier.
+int escort_rank(const World& world, int carrier) {
+    const auto& me = world.me();
+    const float mine = guard_power(me);
+    int rank = 0;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || a.index == carrier) continue;
+        const float p = guard_power(a);
+        rank += p > mine || (p == mine && a.index < me.index);
+    }
+    return rank;
+}
+
+void trace_escort(const World& world, const EscortSite& site, const char* role) {
+    debug_block({
+        const vec2 at = world.map().altars[static_cast<std::size_t>(site.altar)].pos;
+        std::printf("ESCORT %d %u %d %d %d %s\n", world.round, my_handle(), at.x, at.y, site.end_round - world.round, role);
+    });
+}
+
+// Our turn in the escort, after the bag and the shop: an enemy lock on the site's altar is hit (five hits remove it),
+// enemies by the site are fought (the strike search has priced the stops of the channel: escort_worth), else we
+// stand between the channel and the enemy that comes at it first, within a stun's reach of the channeller.
+// Only while the walk there takes no longer than the channel has left; never for the carrier.
+bool escort_turn(const World& world, Pathing& pathing, Safety& safety, Memory& memory, const Pathing::GuardState& strike_guard) {
+    // A copy: the strike search in chase_with_guard reads the site again after a move.
+    const EscortSite site = escort_site(world);
+    if (!site || (site.channeller && site.channeller->is_self)) return false;
+    if (world.score.ally + static_cast<int>(my_gems()) >= static_cast<int>(cambc::constants::winning_gems)) return false;
+    const int a = site.altar, left = site.end_round - world.round;
+    const vec2 here = my_position(), alt = world.map().altars[static_cast<std::size_t>(a)].pos;
+    if (here.x < 0 || left < 0) return false;
+    // A field not built yet costs a search: not at the end of a turn.
+    const std::uint64_t field_fuel = end_reserve + static_field_cost_estimate(max_field_layers());
+    if (!fuel_ok(field_fuel)) return false;
+    const int steps = pathing.to_altar(a).at(here);
+    if (steps == unreachable || steps > left) return false;
+    const auto commit = [&] {
+        memory.claim = -1;
+        memory.farm_group = -1;
+        decision = Branch::escort;
+    };
+    const auto& f = world.me().facts();
+    if (world.altars[a].enemy_lock) {
+        if (break_lock(world, a)) {
+            commit();
+            trace_escort(world, site, "lock");
+            if (!f.walk_and_attack_independent()) return true;
+        } else if (my_can_move() && dist(here, alt) > f.attack_range()) {
+            commit();
+            // The tribute tiles are in every attack's range of the altar.
+            step_safely(world, pathing, pathing.to_altar(a), safety);
+            trace_escort(world, site, break_lock(world, a) ? "lock" : "to-lock");
+            return true;
+        }
+    }
+    const vec2 c = channel_tile(world, site);
+    bool near = false;
+    for (const auto& e : world.enemies) near |= e.alive && e.visible && (dist(e.pos, alt) <= params::altar_leash || dist(e.pos, c) <= params::altar_leash);
+    if (near && chase_with_guard(world, pathing, safety, strike_guard)) {
+        memory.claim = -1, memory.farm_group = -1;
+        trace_escort(world, site, "fight");
+        return true;
+    }
+    const auto& tiles = stands(world, a);
+    // Between: the fewest steps a walk from the threat to the channel would lose by our tile; then nearer the threat
+    // (in front), then stands()'s order.
+    const vec2 q = threat_tile(world, site);
+    struct Scored {
+        int excess, front;
+        std::size_t order;
+    };
+    static std::vector<Scored> scored;
+    scored.clear();
+    for (std::size_t i = 0; i < tiles.size(); ++i) {
+        const vec2 t = tiles[i];
+        // Within a unit stun's range of the channel's tile; off the tribute tiles until the channel starts, which a
+        // cramped altar could leave the carrier none of; not a tile an ally in sight holds (the channeller's).
+        if (dist(t, c) > ability_range) continue;
+        if (!site.channelling && dist(t, alt) <= static_cast<int>(cambc::constants::submit_gems_range)) continue;
+        bool held = false;
+        for (const auto& o : world.allies) held |= !o.is_self && o.alive && o.visible && o.pos == t;
+        if (held) continue;
+        scored.push_back({dist(c, t) + dist(t, q) - dist(c, q), dist(t, q), i});
+    }
+    if (scored.empty()) return false;
+    std::sort(scored.begin(), scored.end(), [](const Scored& x, const Scored& y) {
+        return x.excess != y.excess ? x.excess < y.excess : x.front != y.front ? x.front < y.front : x.order < y.order;
+    });
+    commit();
+    const int rank = escort_rank(world, site.carrier);
+    const vec2 stand = tiles[scored[static_cast<std::size_t>(rank) % scored.size()].order];
+    trace_escort(world, site, here == stand ? "screen" : "to-screen");
+    if (!my_can_move() || here == stand || !fuel_ok(field_fuel)) return true;
+    step_safely(world, pathing, field_to(pathing, stand), safety);
+    return true;
+}
+
+// The site, read once a turn per sighting: a carrier of ours in sight (or us) that channels gives its altar and end
+// exactly; one that walks, the altar it posted (comms::escort), else the nearest; an unseen one, its post alone,
+// while an unseen ally alive posts a bag that wins.
+const EscortSite& escort_site(const World& world) {
+    static EscortSite site;
+    static struct {
+        int round = -1;
+        std::uint32_t observations = 0, gems = 0;
+        vec2 here{-1, -1};
+    } key;
+    const vec2 here = world.me().alive ? my_position() : vec2{-1, -1};
+    const std::uint32_t gems = world.me().alive ? my_gems() : 0;
+    if (key.round == world.round && key.observations == world.observations && key.here == here && key.gems == gems) return site;
+    key = {world.round, world.observations, gems, here};
+    site = {};
+    const int need = static_cast<int>(cambc::constants::winning_gems) - world.score.ally;
+    if (!params::escort || need <= 0) return site;
+    const auto heard = comms::escort(world);
+    const auto& altars = world.map().altars;
+    for (const auto& a : world.allies) {
+        if (!a.alive || !(a.is_self || a.visible)) continue;
+        if (a.is_self && here.x < 0) continue;
+        const int bag = a.is_self ? static_cast<int>(gems) : a.gems;
+        if (bag < need) continue;
+        EscortSite s;
+        s.gems = bag, s.channeller = &a, s.carrier = a.index, s.immune = a.facts().passive == Passive::stun_immune;
+        const vec2 p = a.is_self ? here : a.pos;
+        s.channelling = a.is_self ? my_state().contains(cambc::champion_state::submitting_gems) : a.channel == Channel::tribute;
+        if (s.channelling) {
+            s.altar = tribute_altar(world, p);
+            s.end_round = a.is_self ? world.round + my_channel_time() : a.channel_end_round;
+        } else if (heard.altar >= 0) {
+            s.altar = heard.altar, s.end_round = heard.latest;
+        } else {
+            int d = unreachable;
+            for (int i = 0; i < static_cast<int>(altars.size()); ++i)
+                if (dist(p, altars[static_cast<std::size_t>(i)].pos) < d) d = dist(p, altars[static_cast<std::size_t>(i)].pos), s.altar = i;
+            s.end_round = world.round + d + tribute_turns(bag, a.fast_tribute);
+        }
+        if (s.altar < 0) continue;
+        if (!site || (s.channelling && !site.channelling) || (s.channelling == site.channelling && s.end_round < site.end_round)) site = s;
+    }
+    if (!site && heard.altar >= 0) {
+        // A posted bag is rounded up to fours and capped at 508.
+        const int posted_need = std::min(need, 508);
+        for (const auto& a : world.allies)
+            if (!a.is_self && a.alive && !a.visible && comms::bag_of(world, a.index) >= posted_need && comms::bag_of(world, a.index) > site.gems)
+                site.gems = comms::bag_of(world, a.index), site.carrier = a.index, site.immune = a.facts().passive == Passive::stun_immune;
+        if (site.carrier >= 0) site.altar = heard.altar, site.end_round = heard.latest;
+    }
+    return site;
+}
+
+float escort_worth(const World& world, const ChampionBelief& e, bool stun) {
+    if (!params::escort || !e.alive || !e.visible) return 0;
+    const auto& site = escort_site(world);
+    // The carrier's own strikes are left as they were: its way to the altar is not ours to change.
+    if (!site || (site.channeller && site.channeller->is_self)) return 0;
+    const int next = next_turn_round(world, e);
+    // Its turn comes after the channel's last turn end: the tribute has landed.
+    if (next > site.end_round) return 0;
+    const vec2 alt = world.map().altars[static_cast<std::size_t>(site.altar)].pos;
+    bool stops = false;
+    if (!site.immune) {
+        const int reach = e.ready_stun_reach(next, true);
+        // An unseen channeller is on a tribute tile, within 1 of the altar.
+        stops = reach >= 0 && dist(e.pos, channel_tile(world, site)) <= reach + (site.channelling && site.channeller ? 0 : 1);
+    }
+    // A lock goes down within 2 of the altar, after a walk and (a dasher) its dash.
+    if (!stops && dist(e.pos, alt) <= altar_lock_range + 1 + (e.facts().has_dash() ? 2 : 0)) {
+        // The strike search asks this many times a turn: one read a round per enemy (nothing we do changes it).
+        static std::array<std::pair<int, bool>, 8> carries{};
+        auto& known = carries[static_cast<std::size_t>(e.index) % carries.size()];
+        if (known.first != world.round) {
+            std::array<std::uint32_t, 4> counts{};
+            const auto lock = cambc::detail::raw_consumable_ids[static_cast<std::size_t>(cambc::consumable_type::altar_lock)];
+            known = {world.round, cambc::detail::sdk_champion_consumables(static_cast<std::uint32_t>(e.handle), counts.data()) == 0 && counts[lock] > 0};
+        }
+        stops = known.second;
+    }
+    if (!stops) return 0;
+    // As stun_worth prices an enemy's channel: the turns a stop would cost it, its progress and the restart; at most
+    // what the game is worth (kill_stops' winning tribute).
+    const bool fast = site.channeller && site.channeller->fast_tribute;
+    const int delay = std::max(1, next + 1 + tribute_turns(site.gems, fast) - site.end_round);
+    const float saved = std::min(params::tribute_value + params::gem_value * static_cast<float>(site.gems) * static_cast<float>(delay) / params::stun_tribute_horizon,
+                                 params::tribute_value + params::gem_value * static_cast<float>(cambc::constants::winning_gems));
+    // A stun only puts the stop off a turn: it saves the channel alone if it lands by then, else it is one of the
+    // turns of cover the rest of the channel needs. A kill takes every one of them.
+    return stun ? saved / static_cast<float>(std::max(1, site.end_round - next)) : saved;
+}
+
+void post_escort(const World& world, Pathing& pathing) {
+    if (!params::escort) return;
+    static bool posted = false;
+    static int last_altar = -1, last_end = -1;
+    (void)comms::escort(world); // marks a record past its window expired
+    const int need = static_cast<int>(cambc::constants::winning_gems) - world.score.ally;
+    const vec2 here = world.me().alive ? my_position() : vec2{-1, -1};
+    if (here.x >= 0 && need > 0 && static_cast<int>(my_gems()) >= need) {
+        int altar = -1, end = -1;
+        const bool channel = my_state().contains(cambc::champion_state::submitting_gems);
+        if (channel) {
+            altar = tribute_altar(world, here), end = world.round + my_channel_time();
+        } else if (fuel_ok(end_reserve) && banks_bag(world, pathing)) {
+            // The altar bank_gems walks to: the nearest by walk, an enemy lock's hits added. Short of fuel for a
+            // field not built yet, our last post stands.
+            int best = unreachable;
+            bool whole = true;
+            const auto& altars = world.map().altars;
+            for (int a = 0; a < static_cast<int>(altars.size()); ++a) {
+                if (!fuel_ok(end_reserve + static_field_cost_estimate(max_field_layers()))) {
+                    whole = false;
+                    break;
+                }
+                const int steps = pathing.to_altar(a).at(here);
+                if (steps == unreachable) continue;
+                if (const int total = steps + lock_turns(world.altars[a], world.me().facts(), steps); total < best) best = total, altar = a;
+            }
+            // The channel starts the turn after the walk's last step.
+            if (altar >= 0) end = world.round + best + 1 + tribute_turns(world, static_cast<int>(my_gems()));
+            if (!whole && posted) altar = last_altar, end = last_end;
+        } else if (posted) {
+            altar = last_altar, end = last_end;
+        }
+        if (altar >= 0) {
+            comms::post_escort(altar, end, false);
+            posted = true, last_altar = altar, last_end = end;
+            debug_block({
+                const vec2 at = world.map().altars[static_cast<std::size_t>(altar)].pos;
+                std::printf("ESCORT %d %u %d %d %d %s\n", world.round, my_handle(), at.x, at.y, end - world.round, channel ? "channel" : "carry");
+            });
+            return;
+        }
+    }
+    // Our record outlives our winning bag (killed, or banked short of the win): withdrawn.
+    comms::post_escort(-1, -1, std::exchange(posted, false));
+    last_altar = last_end = -1;
+}
+
 } // namespace
 
 } // namespace aph
