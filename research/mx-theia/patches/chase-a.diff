+struct FarmRate {
+    float value = -1; // gems a round; -1 until the first farm turn
+    int round = -1;   // of the latest sample
+    int group = -1;   // the job it priced, -1 for none
+    CampState state = CampState::alive; // that group's, then
+};
+FarmRate kept_farm_rate;
+
+// farm_turn's chosen job value (rate(): a keeping Prism's premium included, in gems a round) at the job's
+// start: a new group, or our group captured again. Later in a job its rate climbs as the walk and the clear are
+// spent, but a turn given up delays the whole stream of jobs, which pays at their start rates. Averaged over
+// about a job: a capture and the walk to the next group at the map's spacing of gem groups (the square root
+// of the area a group), weighted by the rounds since the last start, so a death or a siege leaves little of it.
+void note_farm_rate(const World& world, float value, int group, CampState state) {
+    auto& r = kept_farm_rate;
+    const bool start = r.round < 0 || group != r.group || (state == CampState::respawning && r.state != CampState::respawning);
+    r.state = state;
+    debug_block({
+        static int traced = -1;
+        if (world.round / 50 != traced && r.round >= 0) traced = world.round / 50, std::printf("FRATE %d %u %.4f\n", world.round, my_handle(), r.value);
+    });
+    if (!start) return;
+    static float tau = 0;
+    if (tau <= 0) {
+        int n = 0;
+        for (const auto& g : world.map().groups) n += g.gems > 0 ? 1 : 0;
+        const float area = static_cast<float>(world.map().width * world.map().height);
+        tau = static_cast<float>(cambc::constants::capture_time + 1) + std::sqrt(area / static_cast<float>(std::max(1, n)));
+    }
+    if (r.round < 0) r.value = value;
+    else r.value += -std::expm1(-static_cast<float>(std::max(1, world.round - r.round)) / tau) * (value - r.value);
+    r.round = world.round, r.group = group;
+}
+
+float farm_rate(const World& world) {
+    return kept_farm_rate.value >= 0 ? kept_farm_rate.value : farm_step_value(world) / params::gem_value;
+}
+
+int farm_rate_group() { return kept_farm_rate.group; }
