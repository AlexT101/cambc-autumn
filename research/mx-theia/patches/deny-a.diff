+// decide_denial, asked up to three times a turn (the channels' checks, then the turn's): the same until we see or move again.
+Denial denial(const World& world, Pathing& pathing) {
+    const auto& self = world.me();
+    if (!self.alive || !self.can_act(world.round)) return {};
+    const vec2 here = my_position();
+    if (here.x < 0) return {};
+    static struct {
+        int round = -1;
+        std::uint32_t observations = 0;
+        vec2 here{-1, -1};
+        Denial answer;
+    } last;
+    if (last.round == world.round && last.observations == world.observations && last.here == here) return last.answer;
+    last.round = world.round, last.observations = world.observations, last.here = here;
+    return last.answer = decide_denial(world, pathing, here);
+}
