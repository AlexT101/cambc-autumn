+// home_ground with the enemy's live arrival in place of its spawn walk. An enemy's arrival at a
+// group: its spawn walk after its respawn while dead; at most its Chebyshev distance from a sighting
+// (seen or posted, not inferred) less the rounds since, while that is within vision_radius rounds
+// old (the rounds it needs to walk out of our sight); its spawn walk otherwise. The front is the
+// least of them: any enemy kills a lone farmer. Only the whole team dead pushes it back; a sighting
+// only brings it closer. Once a round; off on the first turn (every enemy on its spawn).
+const FrontWeights& front_weights(const World& world, bool first_turn) {
+    static FrontWeights f;
+    if (f.round == world.round) return f;
+    f.round = world.round, f.on = false, f.changed = 0;
+    if (first_turn) return f;
+    const auto& map = world.map();
+    const int round = world.round;
+    bool alive = false;
+    int dead_delay = std::numeric_limits<int>::max();
+    struct Sighting {
+        vec2 pos;
+        int age;
+    };
+    std::array<Sighting, 8> seen;
+    int n_seen = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive) {
+            dead_delay = std::min(dead_delay, e.respawn_earliest >= 0 ? std::max(0, e.respawn_earliest - round) : 0);
+            continue;
+        }
+        alive = true;
+        const int age = round - e.pos_round;
+        if ((e.pos_source == Source::seen || e.pos_source == Source::comms) && e.pos_round >= 0 && age <= vision_radius && in_bounds(e.pos)
+            && n_seen < static_cast<int>(seen.size()))
+            seen[static_cast<std::size_t>(n_seen++)] = {e.pos, std::max(0, age)};
+    }
+    // No enemies (cannot happen) or a dead team respawning now: the prior holds.
+    const int delay = alive || dead_delay == std::numeric_limits<int>::max() ? 0 : dead_delay;
+    if (delay == 0 && n_seen == 0) return f;
+    const int n = static_cast<int>(map.groups.size());
+    float max_ratio = 0; // for the trace: the most a live weight is of its static one
+    (void)max_ratio;
+    if (static_cast<int>(f.weight.size()) < n + 3) f.weight.resize(n + 3), f.live.resize(n);
+    // Static weights as read so far (1 before) are bounds where nothing changes.
+    const auto& kept = home_weights();
+    for (int g = 0; g < n + 3; ++g) f.weight[static_cast<std::size_t>(g)] = g < 256 ? kept[static_cast<std::size_t>(g)] : 1.0f;
+    for (int g = 0; g < n; ++g) {
+        int from_us, from_them;
+        ground_steps(map, g, false, from_us, from_them);
+        int live = from_them == unreachable ? from_them : from_them + delay;
+        const vec2 c = map.groups[g].centre;
+        for (int i = 0; i < n_seen; ++i) live = std::min(live, std::max(0, dist(seen[static_cast<std::size_t>(i)].pos, c) - seen[static_cast<std::size_t>(i)].age));
+        // Both at least our walk: both weigh 1.
+        const bool changed = live != from_them && (live < from_us || from_them < from_us);
+        f.live[static_cast<std::size_t>(g)] = changed;
+        if (!changed) continue;
+        f.weight[static_cast<std::size_t>(g)] = ground_weight(from_us, live);
+        ++f.changed;
+        debug_block({ max_ratio = std::max(max_ratio, f.weight[static_cast<std::size_t>(g)] / std::max(1e-6f, ground_weight(from_us, from_them))); });
+    }
+    f.on = f.changed > 0;
+    debug_block({
+        if (f.on) std::printf("FRONT %d %u %d %.3f delay %d seen %d\n", round, my_handle(), f.changed, max_ratio, delay, n_seen);
+    });
+    return f;
+}
