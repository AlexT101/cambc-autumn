+// home_ground's walks to group g from our spawn and the enemy's: beyond our walk (a crystal's
+// region), both as the crow flies, else the enemy's doorstep counts in full.
+void ground_steps(const StaticMap& map, int g, bool first_turn, int& from_us, int& from_them) {
+    from_us = map.ally_steps(g);
+    from_them = first_turn ? map.enemy_steps_of(g) : map.enemy_steps(g);
+    if (from_us == unreachable) {
+        from_us = dist(map.ally_spawn_centre, map.groups[g].centre);
+        from_them = dist(map.enemy_spawn_centre, map.groups[g].centre);
+    }
+}
+// min(1, 2 from_them / (from_us + from_them))^home_power; 1 when either is unreachable, or both 0
+// (a live arrival can be 0).
+float ground_weight(int from_us, int from_them) {
+    if (from_us == unreachable || from_them == unreachable || from_us + from_them == 0) return 1.0f;
+    const float share = std::min(1.0f, 2.0f * static_cast<float>(from_them) / static_cast<float>(from_us + from_them));
+    return std::pow(share, params::home_power);
+}
