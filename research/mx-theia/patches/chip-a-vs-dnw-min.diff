+// The group our last chip woke and the round: chy-ref's casts at awake groups keep to the chip's slot
+// gate on it while that wake lasts (the phase after it, then two empty ones: rules camps.sleep).
+int chipped_group = -1, chipped_round = -1;
+constexpr int wake_phases = 3;
+
+// A live group whose every live striker, once awake, reaches none of us: a hit wakes it, it attacks
+// nobody, sleeps again after its empty camp phases and keeps the damage (rules camps.sleep, camps.attack).
+// Allies read it awake on their turns and price its fire (Safety::awake_members), so only one already
+// within a step of a striker's reach could take a phase unawares: one in sight by its tile; one out of
+// sight, seen or posted (comms_ally, to within 2) within the wake, by the tiles we cannot see that it
+// could have reached since. One staler we leave to its own read.
+bool free_wake(const World& world, int g, vec2 here) {
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    if (c.state != CampState::alive || G.has_monolith) return false;
+    static bitboard hidden{cambc::uninitialized}, box{cambc::uninitialized};
+    for (std::size_t i = 0; i < G.members.size(); ++i) {
+        const auto& m = G.members[i];
+        if (m.strength <= 0 || c.health[i] <= 0) continue;
+        if (dist(here, m.pos) <= m.reach) return false;
+        const int r = m.reach + 1;
+        bool drawn = false, none = false;
+        for (const auto& a : world.allies) {
+            if (a.is_self || !a.alive) continue;
+            if (a.visible) {
+                if (dist(a.pos, m.pos) <= r) return false;
+                continue;
+            }
+            vec2 at = a.pos;
+            int since = a.pos_round, told = -1, blur = 0;
+            if (vec2 t; params::comms_ally && comms::told_ally(a.index, t, told) && told > since) at = t, since = told, blur = 2;
+            if (since < world.round - wake_phases) continue;
+            const int slack = blur + world.round - since;
+            if (dist(at, m.pos) > r + slack) continue;
+            if (!drawn) {
+                // Our vision is this turn's: tiles in it hold no unseen ally.
+                clear_board(hidden);
+                draw_square(hidden, m.pos, static_cast<float>(r));
+                drop(hidden, world.visible);
+                drawn = true, none = board_empty(hidden);
+            }
+            if (none) continue;
+            clear_board(box);
+            draw_square(box, at, static_cast<float>(slack));
+            box &= hidden;
+            if (!board_empty(box)) return false;
+        }
+    }
+    return true;
+}
+
+// The camp health we see in group g: for CHIP traces.
+[[maybe_unused]] float seen_group_health(const World& world, int g) {
+    float total = 0;
+    for (const auto& m : world.map().groups[g].members) {
+        if (!cambc::vision::has_camp(m.pos)) continue;
+        cambc::detail::camp_state record;
+        if (cambc::detail::sdk_camp(m.handle, &record) == 0 && record.health > 0) total += record.health;
+    }
+    return total;
+}
+
+// Our slots' cooldowns: for CHIP traces, the slot a cast spent.
+[[maybe_unused]] std::array<std::int32_t, 2> my_cooldowns() {
+    std::array<std::int32_t, 2> cd{0, 0};
+    for (std::uint32_t s = 0; s < 2; ++s) cambc::detail::sdk_champion_cooldown(my_handle(), s, &cd[s]);
+    return cd;
+}
+[[maybe_unused]] int spent_slot(const std::array<std::int32_t, 2>& before) {
+    const auto now = my_cooldowns();
+    return now[0] > before[0] ? 0 : now[1] > before[1] ? 1 : -1;
+}
