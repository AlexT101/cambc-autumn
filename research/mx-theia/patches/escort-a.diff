+// The watcher's walk to the watched altar, to within a ward's reach of it, where the ward goes down. The trip
+// is given up for good (3: our other wards go on) with no walk there or no tile for the ward, and until our next
+// return to spawn when a step is refused.
+bool watch_trip(const World& world, Pathing& pathing, Safety& safety, Memory& memory) {
+    if (memory.watch != 1) return false;
+    const int a = watched_altar(world);
+    const vec2 here = my_position();
+    if (a < 0 || pathing.to_altar(a).at(here) >= unreachable) return memory.watch = 3, false;
+    if (dist(here, world.map().altars[static_cast<std::size_t>(a)].pos) <= static_cast<int>(cambc::constants::ward_placement_radius)) {
+        if (stunned_turn) return false;
+        // Held at the altar until the ward is back, else the turn's other goals walk us off.
+        if (cambc::self().ward_cooldown() > 0) return decision = Branch::watch, memory.claim = -1, true;
+        if (watch_ward(world, memory)) warded_round = world.round;
+        else memory.watch = 3;
+        return false;
+    }
+    decision = Branch::watch;
+    memory.claim = -1;
+    step_safely(world, pathing, pathing.to_altar(a), safety);
+    if (my_position() != here) return true;
+    memory.watch = 0;
+    decision = Branch::none;
+    return false;
+}
