+// The alarm (comms::alarm): a hoard's or a winning tribute in our sight, still channelling after our turn, is
+// posted for teammates out of its sight; one our turn cancelled, or an alarmed altar seen without one (every
+// tile an enemy tributes from in sight, or from lock range, where answer_alarm's lock has gone down), is withdrawn.
+void post_alarm(const World& world) {
+    comms::post_alarm(-1, -1, false);
+    if (!params::deny_alarm || !fuel_ok(end_reserve)) return;
+    const ChampionBelief* seen = nullptr;
+    bool wins = false;
+    for (const auto& e : world.enemies) {
