+// The concealment plan for this turn's tribute from here, or null when none applies: a short channel,
+// a last-chance bag (any_risk), a bag that has spent its delay, or too
+// little fuel. Kept for the turn's later asks from the same tile.
+const conceal::Plan* conceal_plan(const World& world, Pathing& pathing, Safety& safety, const Memory& memory) {
+    using namespace conceal;
+    const vec2 here = my_position();
+    if (plan.round == world.round && plan.from == here) return plan.active ? &plan : nullptr;
+    plan.round = world.round, plan.from = here;
+    plan.active = plan.wait = false;
+    plan.n = 0;
+    const auto gems = my_gems();
+    if (gems < spent_bag || (start_score >= 0 && world.score.ally - start_score >= start_gems)) spent = waited = 0, start_score = -1;
+    spent_bag = gems;
+    const int channel = tribute_turns(world, static_cast<int>(gems));
+    if (channel <= ability_cooldown) return nullptr;
+    const auto why = [&](const char* r) { debug_block({ std::printf("CONCEALX %d %u %u %s %llu\n", world.round, my_handle(), gems, r, (unsigned long long)fuel()); }); return nullptr; };
+    if (stunned_turn || !world.me().alive || channelling()) return why("state");
+    if (spent >= channel) return why("spent");
+    if (retaining_gems(world, pathing)) return why("retain");
+    if (any_risk(world, channel)) return why("risk");
+    const std::uint64_t tile_fuel = tile_cost(world);
+    if (!fuel_ok(act_reserve + 2 * tile_fuel)) return why("fuel");
+    const auto& map = world.map();
+    const auto& altars = map.altars;
+    const int at = altar_here(world, here);
+    const auto avoided = [&](int a) { return a == memory.avoid_altar && world.round < memory.avoid_until; };
+    // An altar carry_bag gave up waiting at for its threat: the reference's tribute there is judged again
+    // (submit_here), never held back for a wait or a shuffle beside that threat.
+    if (at >= 0 && avoided(at)) return why("avoided");
+    // Whatever closing() says, a later channel that completes beats an earlier one stopped: the guards are
+    // the round limit and the enemy's win at its recent tribute rate, which a delay could let land first.
+    int left = rounds_left(world);
+    if (const float rate = world.enemy_rate(); rate > 0)
+        left = std::min(left, static_cast<int>(static_cast<float>(static_cast<int>(cambc::constants::winning_gems) - world.score.enemy) / rate));
+    // Altars by the Chebyshev bound on the walk to their tiles.
+    std::array<std::pair<int, int>, 16> order;
+    int count = 0;
+    for (int a = 0; a < static_cast<int>(altars.size()) && count < static_cast<int>(order.size()); ++a)
+        if (!world.altars[a].enemy_lock && !avoided(a)) order[count++] = {std::max(0, dist(here, altars[a].pos) - 1), a};
+    std::sort(order.begin(), order.begin() + count);
+    read_wards(world);
+    std::array<std::uint32_t, 16> totals{};
+    for (std::size_t i = 0; i < world.enemies.size() && i < totals.size(); ++i) {
+        const auto& e = world.enemies[i];
+        totals[i] = e.alive && !e.visible && e.tracked ? board_count(e.possible) : 0;
+    }
+    const auto& blocked = pathing.blocked();
+    const float floor = static_cast<float>(channel) / complete_hidden; // a channel's least price
+    // An altar's tiles by walk, open and unoccupied: the altar's walk, or more across its ring.
+    const auto tiles_of = [&](int a, int walk, std::array<std::pair<int, vec2>, 8>& out) {
+        std::array<vec2, 8> ring;
+        const auto k = positions_into(altars[a].tribute_tiles(), ring.data(), static_cast<std::uint32_t>(ring.size()));
+        int m = 0;
+        for (std::uint32_t i = 0; i < k && i < ring.size(); ++i) {
+            const vec2 t = ring[i];
+            if (t != here && test(blocked, t)) continue;
+            if (map.from_ally_spawn().at(t) == unreachable) continue;
+            out[m++] = {std::max(walk, dist(here, t)), t};
+        }
+        std::sort(out.begin(), out.begin() + m, [](const auto& x, const auto& y) { return x.first < y.first; });
+        return m;
+    };
+    const auto price = [&](int a, vec2 t, int walk) -> Priced* {
+        if (plan.n >= max_tiles || !fuel_ok(act_reserve + tile_fuel + (test(map.bushes, t) ? cluster_cost : 0))) return nullptr;
+        if (walk + channel + endgame_margin > left) return nullptr;
+        auto& p = plan.priced[plan.n++];
+        p.tile = t, p.altar = a;
+        expose(world, p, walk, totals);
+        p.rounds = rounds(walk, channel, p.exposure);
+        return &p;
+    };
+    // Room for altar a's field, when it is still to be made, and a tile after it.
+    const auto field_room = [&](int a) {
+        return fuel_ok(act_reserve + tile_fuel + (pathing.altar_ready(a) ? 0 : std::max<std::uint64_t>(costliest_field(), search_cost_estimate(0))));
+    };
+    // The reference: a tribute here, else on the nearest tile of the nearest altar.
+    const int any = altar_steps(world, pathing, here, -1);
+    if (any == unreachable) return why("noaltar");
+    int ref_altar = at;
+    if (ref_altar < 0)
+        for (int i = 0; i < count && ref_altar < 0; ++i) {
+            if (order[i].first > any) break;
+            if (!field_room(order[i].second)) return why("fuel");
+            if (altar_steps(world, pathing, here, order[i].second) == any) ref_altar = order[i].second;
+        }
+    if (ref_altar < 0 || world.altars[ref_altar].enemy_lock) return nullptr;
+    std::array<std::pair<int, vec2>, 8> ring;
+    const Priced* ref = nullptr;
+    if (at >= 0) {
+        ref = price(at, here, 0);
+    } else if (const int m = tiles_of(ref_altar, any, ring); m > 0) {
+        ref = price(ref_altar, ring[0].second, ring[0].first);
+    }
+    if (!ref) return why("noref");
+    plan.ref = *ref;
+    plan.best = *ref;
+    for (int i = 0; i < count && plan.n < max_tiles; ++i) {
+        const auto [bound, a] = order[i];
+        if (static_cast<float>(bound) + floor >= plan.best.rounds) break;
+        if (a != at && !field_room(a)) break;
+        const int walk = a == at ? 0 : altar_steps(world, pathing, here, a);
+        if (walk == unreachable || static_cast<float>(walk) + floor >= plan.best.rounds) continue;
+        const int m = tiles_of(a, walk, ring);
+        for (int j = 0; j < m; ++j) {
+            const auto [w, t] = ring[j];
+            if (static_cast<float>(w) + floor >= plan.best.rounds) break;
+            if (t == plan.ref.tile) continue;
+            const auto* p = price(a, t, w);
+            if (!p) break;
+            if (p->rounds < plan.best.rounds) plan.best = *p;
+        }
+    }
+    // Here, the wait for the enemies in sight to leave, at a round a turn: worth it while the rounds
+    // waited stay below what their sight costs the channel (a wait of unknown length is bounded by
+    // the price of not waiting).
+    if (at >= 0 && plan.ref.tile == here) {
+        const float gone = rounds(0, channel, plan.ref.still);
+        const float gain = plan.ref.rounds - gone;
+        if (1 + gone < plan.best.rounds && static_cast<float>(waited + 1) <= gain && tribute_ok(world, safety, memory, channel)) plan.wait = true;
+    }
+    plan.active = plan.wait || plan.best.tile != plan.ref.tile;
+    const auto& shown = plan.wait ? plan.ref : plan.best;
+    debug_block({
+        std::printf("CONCEAL %d %u %u %d %d %.2f %.2f %d\n", world.round, my_handle(), gems, altars[shown.altar].pos.x, altars[shown.altar].pos.y,
+                    shown.exposure, plan.ref.exposure, shown.walk - plan.ref.walk);
+        std::printf("CONCEALD %d %u %c %d %d %d %d %.1f %.1f %d %d %d\n", world.round, my_handle(),
+                    plan.wait ? 'W' : !plan.active ? 'S' : plan.best.altar != plan.ref.altar ? 'A' : 'M', shown.tile.x, shown.tile.y,
+                    plan.ref.tile.x, plan.ref.tile.y, shown.rounds, plan.ref.rounds, plan.n, spent, channel);
+    });
+    if (!plan.active) return nullptr;
+    if (spent_round != world.round) {
+        spent_round = world.round;
+        ++spent;
+        if (plan.wait) ++waited;
+    }
+    return &plan;
+}
