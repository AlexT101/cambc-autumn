+int altar_here(const World& world, vec2 p);
+
+// Concealment of a long tribute: where and when within the decision to bank, never whether. A big
+// channel an enemy sees in its first rounds is rarely completed (a stun or a lock restarts it whole),
+// so each tribute tile is priced by the expected rounds to a completed channel: the walk there plus
+// the channel over its chance to complete, which falls from that of an unseen channel to that of one
+// seen early with the chance some enemy sees the tile in those rounds. Only for a channel longer
+// than a stun cooldown: a shorter one ends before a stop seen at its start can be cast again.
+namespace conceal {
+
+// Measured on 1,019 chy-ref mirror games: the share of big channels completed when never seen, and
+// when an enemy saw them in their first `early` rounds.
+constexpr float complete_hidden = 0.86f;
+constexpr float complete_seen = 0.07f;
+constexpr int early = 3;
+constexpr int max_tiles = 16; // tiles priced a turn: one shadowcast each
+// Fuel to price a tile: a cast and about 10 whole-board operations, and 9 more for each enemy (squares
+// and counts), each ~13 + 1 a chunk.
+std::uint64_t tile_cost(const World& world) {
+    return 600 + (10 + 9 * static_cast<std::uint64_t>(world.enemies.size())) * (13 + map_chunks);
+}
+// A bush cluster's first lookup floods it (~1.5k + 52 a chunk).
+constexpr std::uint64_t cluster_cost = 12000;
+
+struct Priced {
+    vec2 tile{-1, -1};
+    int altar = -1, walk = 0;
+    float exposure = 0;    // the chance an enemy sees the tile in the channel's first rounds
+    float still = 0;       // the same with the enemies in sight now gone from it: what waiting could reach
+    float rounds = 0;      // walk + channel / chance to complete
+};
+
+struct Plan {
+    int round = -1;
+    vec2 from{-1, -1};
+    bool active = false; // it departs from the reference: a wait, or another tile than the one it would take
+    bool wait = false;
+    Priced best, ref;
+    std::array<Priced, max_tiles> priced;
+    int n = 0;
+};
+Plan plan;
+// The rounds concealment held the current bag back (waits and detours): at most one channel's length a
+// bag, restarts included. A bag ends when it shrinks, or when our score has grown by the bag of our
+// latest start (it completed: allies' tributes may end it early).
+int spent = 0, waited = 0, spent_round = -1;
+std::uint32_t spent_bag = 0;
+int start_score = -1, start_gems = 0;
+
+float complete(float exposure) { return complete_seen + (complete_hidden - complete_seen) * (1 - exposure); }
+float rounds(int walk, int channel, float exposure) { return static_cast<float>(walk) + static_cast<float>(channel) / complete(exposure); }
+
+// The visible enemy wards near the tiles, with the engine's sight mask cast on first need.
+struct Ward {
+    vec2 at;
+    bool cast = false;
+};
+std::array<Ward, 8> wards;
+int ward_count = 0;
+std::vector<bitboard> ward_masks; // grown on first need: a board costs ~260 to make
+
+void read_wards(const World& world) {
+    ward_count = 0;
+    static std::array<cambc::detail::ward_info, 16> raw;
+    std::uint32_t n = 0;
+    ok(cambc::detail::sdk_wards(raw.data(), static_cast<std::uint32_t>(raw.size()), &n));
+    const auto own = static_cast<std::uint32_t>(world.map().team_a ? 0 : 1);
+    for (std::uint32_t k = 0; k < n && k < raw.size() && ward_count < static_cast<int>(wards.size()); ++k)
+        if (raw[k].team != own) wards[ward_count++] = {{raw[k].x, raw[k].y}, false};
+}
+
+bool ward_sees(vec2 t) {
+    for (int i = 0; i < ward_count; ++i) {
+        auto& w = wards[i];
+        if (dist(w.at, t) > static_cast<int>(cambc::constants::ward_vision_radius)) continue;
+        if (!w.cast) {
+            while (ward_masks.size() <= static_cast<std::size_t>(i)) ward_masks.emplace_back(cambc::uninitialized);
+            ok(cambc::detail::sdk_ward_vision(w.at.x, w.at.y, ward_masks[i].ptr()));
+            w.cast = true;
+        }
+        if (test(ward_masks[i], t)) return true;
+    }
+    return false;
+}
+
+// The chance an enemy could see tile t within `early` rounds of our reaching it `walk` rounds from now.
+// Sight is symmetric for fixed opaque tiles, so the tiles that see t are those t sees: off bushes, one
+// cast with every bush opaque; a bush tile only from its own cluster (within sight, the cluster taken
+// as clear). An enemy in a bush beside those tiles steps onto one within the early rounds, so viewers
+// inside other clusters are left out. A champion in sight could walk to a viewing tile (Chebyshev
+// steps, walls ignored: what it could do); one unseen does so from the share of its possible tiles
+// that could: those near enough to step beside t, and of those within sight range of t beyond that,
+// the share of the open tiles there that see t. A dead one walks from its spawn once it is back.
+void expose(const World& world, Priced& p, int walk, const std::array<std::uint32_t, 16>& totals) {
+    const auto& map = world.map();
+    const vec2 t = p.tile;
+    static bitboard viewers{cambc::uninitialized};
+    // The open tiles a viewer could stand on: off bushes for a tile off them, as its viewers are.
+    static std::optional<bitboard> open_off;
+    const bool bush = test(map.bushes, t);
+    if (bush) {
+        clear_board(viewers);
+        draw_square(viewers, t, static_cast<float>(vision_radius));
+        viewers &= map.bush_cluster(t).tiles;
+    } else {
+        map.sight_off_bushes_into(t, vision_radius, viewers);
+        if (!open_off) xor_into(map.open_for_us, map.open_bushes(), open_off.emplace(cambc::uninitialized));
+    }
+    const auto open = count_within(bush ? map.open_for_us : *open_off, t, vision_radius);
+    const float seeing = open > 0 ? std::min(1.0f, static_cast<float>(board_count(viewers)) / static_cast<float>(open)) : 1.0f;
+    float hidden = 1, still = 1;
+    for (std::size_t i = 0; i < world.enemies.size(); ++i) {
+        const auto& e = world.enemies[i];
+        int h = walk + early + (e.facts().has_dash() ? dash_range : 0);
+        float seen = 0;
+        if (!e.alive) {
+            if (e.respawn_earliest < 0 || e.respawn_earliest > world.round + h) continue;
+            h -= std::max(0, e.respawn_earliest - world.round);
+            const vec2 q = map.enemy_spawn_centre;
+            if (dist(q, t) <= h + vision_radius && any_within(viewers, q, h)) seen = 1;
+            hidden *= 1 - seen, still *= 1 - seen;
+        } else if (e.visible) {
+            if (dist(e.pos, t) <= h + vision_radius && any_within(viewers, e.pos, h)) seen = 1;
+            hidden *= 1 - seen; // gone from sight, it is no longer this sure
+        } else if (e.tracked) {
+            if (!e.possible_box.meets(t, h + vision_radius)) continue;
+            const auto total = i < totals.size() ? totals[i] : board_count(e.possible);
+            if (total == 0) continue;
+            const auto near = possible_count_within(e, t, h + 1);
+            const auto far = possible_count_within(e, t, h + vision_radius);
+            seen = std::min(1.0f, (static_cast<float>(near) + seeing * static_cast<float>(far - std::min(far, near))) / static_cast<float>(total));
+            hidden *= 1 - seen;
+            // One just gone from sight is still where it saw from: a wait is for it to go farther.
+            if (world.round - e.pos_round > early) still *= 1 - seen;
+        }
+    }
+    if (ward_sees(t)) hidden = still = 0;
+    p.walk = walk;
+    p.exposure = 1 - hidden;
+    p.still = 1 - still;
+}
+
+} // namespace conceal
