+// To tile t a step or two away, around what step_safely goes around.
+void conceal_step(const World& world, Pathing& pathing, Safety& safety, vec2 t) {
+    if (!my_can_move()) return;
+    static bitboard goal{cambc::uninitialized};
+    clear_board(goal);
+    set_tile(goal, t);
+    // Out of a pack zone as bank_gems' walk keeps, and around what step_safely goes around.
+    if (const auto* zone = pack_zone(world, safety)) {
+        pathing.step_towards(goal, zone, max_detour);
+        return;
+    }
+    if (safety.avoid_within(my_position(), vision_radius) && pathing.step_towards(goal, &safety.avoid(), max_detour)) return;
+    pathing.step_towards(goal, nullptr, max_detour);
+}
