+// A tribute from tile p this turn is one the plan takes: its chosen tile, or one priced no worse.
+// Unpriced, only if no plan departs from the reference; none while waiting.
+bool conceal_allows(vec2 p) {
+    const auto& c = conceal::plan;
+    if (c.round < 0 || !c.active) return true;
+    if (c.wait) return false;
+    if (p == c.best.tile) return true;
+    for (int i = 0; i < c.n; ++i)
+        if (c.priced[i].tile == p) return c.priced[i].rounds <= c.best.rounds;
+    return false;
+}
