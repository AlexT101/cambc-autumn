+// The gems of G's payout Prism ally a is paid on its tiles: all of them as its sole holder (sole_capture_holder;
+// off them, its tests of a that read no tile or enemy), none when another is, else a holders() split's floor
+// share, of no more holders than tiles.
+int prism_paid_gems(const World& world, const ChampionBelief& a, const CampGroup& G) {
+    if ((a.is_self || a.visible) && test(G.tiles(), position_of(a))) {
+        if (const auto* s = sole_capture_holder(world, G)) return s->index == a.index ? G.gems : 0;
+    } else if (a.channel != Channel::tribute && a.channel != Channel::teleport
+               && (!(a.is_self || a.visible) || a.health >= params::hurt_health_fraction * a.max_health)) {
+        return G.gems;
+    }
+    return G.gems / std::max(1, std::min(holders(G), static_cast<int>(G.members.size())));
+}
