+// Off Prism: the Prism ally that may collect a capture we begin (prism_collect_eta), read once a turn. It
+// comes only from posted work: its claim h (or the cleared group it holds, when that is its claim or it has
+// none), whose end it can time, then from its tile on h. In `task` the rounds until it is free there: h's
+// counting hold's payout, or its walk and a whole hold; for a live h also its clear at the other claimers'
+// and its camp output (the 'Q' pick's estimate). The walk runs from its posted tile, plus the steps it may
+// have made since. None without a claim (banking, fighting), with an enemy in our sight (leave_for_prism's
+// gate), short of the premium (keeps_bag), hurt, held back, or with no recent tile.
+struct Collector {
+    int round = -1;
+    std::uint32_t observations = ~0u;
+    const ChampionBelief* a = nullptr;
+    int h = -1, task = 0;
+    vec2 on{-1, -1}; // its tile on h, if it stands there
+};
+const Collector& collector(const World& world, Pathing& pathing, std::uint64_t reserve) {
+    static Collector k;
+    if (k.round == world.round && k.observations == world.observations) return k;
+    k = Collector{world.round, world.observations};
+    if (world.me().facts().passive == Passive::gem_focus || enemy_seen(world)) return k;
+    const auto& map = world.map();
+    const int n = static_cast<int>(map.groups.size());
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || a.facts().passive != Passive::gem_focus) continue;
+        if (a.visible && (held_back(world, a, false) || a.health < params::hurt_health_fraction * a.max_health)) return k;
+        if (!keeps_bag(world, a, 1)) return k;
+        vec2 at;
+        int slack = 0;
+        if (!recent_tile(world, a, at, slack)) return k;
+        const int claim = comms::claim_of(world, a.index);
+        int h = a.visible ? map.group_at(a.pos) : -1;
+        if (h < 0 || world.camps[h].state != CampState::cleared || world.camps[h].holder != team::ally || (claim >= 0 && claim != h)) h = claim;
+        if (h < 0 || h >= n) return k;
+        const auto& H = map.groups[h];
+        const auto& ch = world.camps[h];
+        if (H.has_monolith || ch.holder == team::enemy) return k;
+        const int hold = capture_rounds(a.fast_capture) - 1;
+        if (!pathing.group_walking_ready(h) && !fuel_ok(full_field_cost_estimate() + reserve)) return k;
+        // A Prism that has acted this round moves next round.
+        const int to_h = team_walk_to(world, pathing, h, at) + slack + (a.visible && a.acted ? 1 : 0);
+        if (ch.state == CampState::cleared) {
+            const bool counting = ch.holder == team::ally && ch.held_since >= 0;
+            k.task = counting ? std::max(to_h, ch.payout_round() - world.round) : to_h + hold;
+        } else if (ch.state == CampState::alive) {
+            // Without us: a pick of ours elsewhere takes our output off h.
+            float output = 0, health = 0;
+            for (const auto& b : world.allies)
+                if (!b.is_self && b.alive && comms::claim_of(world, b.index) == h) output += camp_output(b);
+            for (std::size_t i = 0; i < H.members.size(); ++i) health += std::max(0.0f, ch.health[i]);
+            if (!(output > 0)) return k;
+            k.task = to_h + static_cast<int>(std::ceil(health / output)) + hold;
+        } else {
+            return k; // respawning: its return is not ours to time
+        }
+        if (a.visible && test(H.tiles(), a.pos)) k.on = a.pos;
+        k.a = &a, k.h = h;
+        return k;
+    }
+    return k;
+}
+
+// A capture of G we hold can pass to the Prism: a camp tile besides the holders' for it to step on
+// (prism_carries' goal is the free tiles).
+bool takeover_room(const CampGroup& G) { return static_cast<int>(G.members.size()) > holders(G); }
+
+// The tiles of h the collector walks on from: its own while it stands there, else all of them.
+template <class F> int from_h(const World& world, const Collector& k, F&& steps) {
+    if (in_bounds(k.on)) return steps(k.on);
+    int most = unreachable;
+    for (const auto& m : world.map().groups[k.h].members) most = std::min(most, steps(m.pos));
+    return most;
+}
+
+// Rounds until the Prism ally of `collector` can stand on group g's tiles, done with its task, by its walk
+// on from h; `unreachable` where it would not take the hold over: the walk on past carry_reach (the farthest
+// its 'G' and 'L' picks walk) or h's tiles beyond its sight of g ('G' needs to see us on it), no tile for it
+// beside the holders', an enemy that may see the group (prism_carries'), or short of fuel for g's field.
+// Once per group and round.
+int prism_collect_eta(const World& world, Pathing& pathing, int g, std::uint64_t reserve) {
+    const auto& k = collector(world, pathing, reserve);
+    if (!k.a || g == k.h) return unreachable;
+    struct Eta {
+        int round = -1;
+        std::uint32_t observations = ~0u;
+        int eta = unreachable;
+    };
+    static std::vector<Eta> etas;
+    const auto& map = world.map();
+    if (etas.size() != map.groups.size()) etas.assign(map.groups.size(), Eta{});
+    auto& e = etas[static_cast<std::size_t>(g)];
+    if (e.round == world.round && e.observations == world.observations) return e.eta;
+    const auto& G = map.groups[g];
+    if (!takeover_room(G) || from_h(world, k, [&](vec2 p) { return steps_to(G, p); }) > std::min(vision_radius, carry_reach()))
+        return e = {world.round, world.observations, unreachable}, unreachable;
+    for (const auto& m : G.members)
+        if (enemy_may_see(world, m.pos)) return e = {world.round, world.observations, unreachable}, unreachable;
+    // Short of fuel, no promise: not cached, a later call may have the fuel.
+    if (!pathing.group_walking_ready(g) && !fuel_ok(full_field_cost_estimate() + reserve)) return unreachable;
+    const int on = from_h(world, k, [&](vec2 p) { return team_walk_to(world, pathing, g, p); });
+    e = {world.round, world.observations, on > carry_reach() ? unreachable : k.task + on};
+    return e.eta;
+}
+
+// prism_collect_eta's bound before any field or fuel: false where it is surely unreachable.
+bool prism_may_collect(const World& world, Pathing& pathing, int g, std::uint64_t reserve) {
+    const auto& k = collector(world, pathing, reserve);
+    if (!k.a || g == k.h) return false;
+    const auto& G = world.map().groups[g];
+    return takeover_room(G) && from_h(world, k, [&](vec2 p) { return steps_to(G, p); }) <= std::min(vision_radius, carry_reach());
+}
+
+const ChampionBelief* prism_collector(const World& world, Pathing& pathing, std::uint64_t reserve) { return collector(world, pathing, reserve).a; }
+// For traces: the collector's task group, its state (0 cleared, 1 alive) and rounds.
+void prism_collector_task(const World& world, Pathing& pathing, int& h, int& alive, int& task) {
+    const auto& k = collector(world, pathing, end_reserve);
+    h = k.h, task = k.task, alive = k.h >= 0 && world.camps[k.h].state == CampState::alive;
+}
