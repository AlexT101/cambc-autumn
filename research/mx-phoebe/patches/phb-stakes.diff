+    if (gems <= 0 || !e.alive || e.facts().passive != Passive::gem_focus) return 0.0f;
+    if (e.visible && e.health < params::hurt_health_fraction * e.max_health) return 0.0f;
+    const auto& map = world.map();
+    const int bag = std::max(0, e.gems), short_of = static_cast<int>(cambc::constants::winning_gems) - world.score.enemy - bag;
+    const int room = short_of - gems;
+    const int last = rounds_left(world) - map.width - map.height - endgame_margin - tribute_turns(bag + gems, e.fast_tribute);
+    if (room <= 0 || last <= 0) return 0.0f;
