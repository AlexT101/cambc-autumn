+// The stakes (abilities.h life_stake) of one side's bodies, by index, for one round: each side worked out on
+// its first ask.
+struct SideStakes {
+    int round = -1;
+    std::array<float, 16> life{}, gem{};
+};
+std::array<SideStakes, 2> side_stakes; // [0] ours, [1] the enemy's
+
+// A Prism's premium on one gem more (prism_premium, enemy_prism_premium), as holder and as taker, once a round.
+float round_premium(const World& world, const ChampionBelief& c) {
+    struct Kept {
+        int round = -1;
+        float premium = 0;
+    };
+    static std::array<std::array<Kept, 16>, 2> kept;
+    const bool enemy = c.side == team::enemy;
+    auto& k = kept[enemy ? 1 : 0][static_cast<std::size_t>(c.index) & 15];
+    if (k.round != world.round) k = {world.round, enemy ? enemy_prism_premium(world, c, 1) : prism_premium(world, c, 1)};
+    return k.premium;
+}
+
+[[gnu::noinline]] void make_side_stakes(const World& world, int s) {
+    auto& t = side_stakes[static_cast<std::size_t>(s)];
+    t.round = world.round;
+    const auto& side = s == 0 ? world.allies : world.enemies;
+    const auto& other = s == 0 ? world.enemies : world.allies;
+    const std::size_t n = std::min<std::size_t>(side.size(), 16);
+    const auto& map = world.map();
+    const float rho = team_gems_per_output(world), kill_gold = static_cast<float>(cambc::constants::kill_gold) * last_gold_price(world);
+    const int left = std::max(0, rounds_left(world)), respawn = static_cast<int>(cambc::constants::respawn_time);
+    // Prisms of the other side that may take a bag: alive where we know it, with their reach in a turn.
+    struct Taker {
+        vec2 at;
+        int reach;
+        float price; // 1 + its premium
+    };
+    std::array<Taker, 4> takers;
+    int n_takers = 0;
+    for (const auto& o : other)
+        if (o.alive && o.facts().passive == Passive::gem_focus && (o.is_self || o.visible) && n_takers < static_cast<int>(takers.size()))
+            takers[static_cast<std::size_t>(n_takers++)] = {o.is_self ? my_position() : o.pos, one_turn_reach(o.facts()), 1.0f + round_premium(world, o)};
+    // Per body (uninitialised past n): its rate of gems a round, its walk back (-1 unknown), its bag (both bags
+    // of a pair), its gem price, its partner.
+    std::array<float, 16> rate, gem;
+    std::array<int, 16> steps, bag, partner;
+    int known = 0, sum = 0, linked = -1;
+    for (std::size_t i = 0; i < n; ++i) {
+        const auto& c = side[i];
+        const auto passive = c.facts().passive;
+        partner[i] = -1;
+        if (passive == Passive::linked_pair) {
+            if (linked >= 0) partner[i] = linked, partner[static_cast<std::size_t>(linked)] = static_cast<int>(i);
+            linked = static_cast<int>(i);
+        }
+        bag[i] = !c.alive ? 0 : s == 0 ? team_bag(world, c) : std::max(0, c.gems);
+        steps[i] = -1;
+        if (!c.alive) continue;
+        rate[i] = camp_output(c) * rho;
+        const vec2 at = c.is_self ? my_position() : c.pos;
+        float taker = 1;
+        if (in_bounds(at)) {
+            if (const int d = s == 0 ? map.from_ally_spawn().at(at) : map.enemy_spawn_steps(at); d < static_cast<int>(unreachable))
+                steps[i] = d, ++known, sum += d;
+            for (int k = 0; k < n_takers; ++k)
+                if (const auto& x = takers[static_cast<std::size_t>(k)]; dist(x.at, at) <= x.reach) taker = std::max(taker, x.price);
+        }
+        // The taker's price is its premium on the next gem, as the holder's is (a bag's size moves it little).
+        gem[i] = 1.0f + (passive == Passive::gem_focus ? round_premium(world, c) : 0.0f) + taker;
+    }
+    // Where a body is unknown, its walk back is the side's mean known walk.
+    const int fallback = known ? sum / known : 0;
+    std::array<float, 16> out;
+    for (std::size_t i = 0; i < n; ++i)
+        out[i] = side[i].alive ? static_cast<float>(std::min(left, respawn + (steps[i] >= 0 ? steps[i] : fallback))) * rate[i] : 0.0f;
+    float life_sum = 0, gem_sum = 0, bag_sum = 0, weighed = 0;
+    int alive = 0;
+    for (std::size_t i = 0; i < n; ++i) {
+        if (!side[i].alive) continue;
+        if (partner[i] >= 0) bag[i] += bag[static_cast<std::size_t>(partner[i])];
+        t.life[i] = out[i] + (partner[i] >= 0 ? out[static_cast<std::size_t>(partner[i])] : 0.0f) + kill_gold;
+        life_sum += t.life[i], gem_sum += gem[i], ++alive;
+        bag_sum += static_cast<float>(bag[i]), weighed += static_cast<float>(bag[i]) * gem[i];
+    }
+    // A gem's mean is over the gems carried, as fights meet them (most ride with a Prism); over the bodies
+    // while none are.
+    const float life_scale = life_sum > 0 ? params::life_value * static_cast<float>(alive) / life_sum : 0.0f;
+    const float gem_scale = bag_sum > 0 && weighed > 0 ? params::gem_value * bag_sum / weighed
+                            : gem_sum > 0               ? params::gem_value * static_cast<float>(alive) / gem_sum
+                                                        : 0.0f;
+    for (std::size_t i = 0; i < n; ++i) {
+        const bool priced = side[i].alive;
+        t.life[i] = priced && life_scale > 0 ? t.life[i] * life_scale : params::life_value;
+        t.gem[i] = priced && gem_scale > 0 ? gem[i] * gem_scale : params::gem_value;
+    }
+    debug_block({
+        if (world.round % 100 == 0) {
+            std::printf("STAKE %d %u %c", world.round, static_cast<std::uint32_t>(world.me().handle), s == 0 ? 'a' : 'e');
+            for (std::size_t i = 0; i < n; ++i) std::printf(" %zu:%.0f/%.1f", i, t.life[i], t.gem[i]);
+            std::printf("\n");
+        }
+    });
+}
+
+const SideStakes& stakes_of(const World& world, const ChampionBelief& c) {
+    const int s = c.side == team::enemy ? 1 : 0;
+    if (side_stakes[static_cast<std::size_t>(s)].round != world.round) make_side_stakes(world, s);
+    return side_stakes[static_cast<std::size_t>(s)];
+}
+
 } // namespace
 
+float life_stake(const World& world, const ChampionBelief& c) { return stakes_of(world, c).life[static_cast<std::size_t>(c.index) & 15]; }
+
+float gem_stake(const World& world, const ChampionBelief& c) { return stakes_of(world, c).gem[static_cast<std::size_t>(c.index) & 15]; }
+
+float kill_stake(const World& world, const ChampionBelief& c) {
+    return life_stake(world, c) + gem_stake(world, c) * static_cast<float>(std::max(0, pair_gems(world, c)));
+}
+
+float own_life_stake(const World& world) { return life_stake(world, world.me()); }
+
+float own_bag_stake(const World& world) { return gem_stake(world, world.me()) * static_cast<float>(bag_at_stake(world)); }
+
