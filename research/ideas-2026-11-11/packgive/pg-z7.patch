+inline constexpr bool home_pursuit = false;
+// The zone off our own ground for the healthy too, at hurt_retreat_ratio as for the hurt there.
+inline constexpr bool pack_abroad = false;
 // Below this share of max health a sieger out of the besieged group's reach goes home to heal,
