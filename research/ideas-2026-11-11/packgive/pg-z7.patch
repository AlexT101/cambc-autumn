+// Debug trace: bit 0, p is in the zone; bit 1, it would be without the margin.
+int pack_zone_trace(const World& world, Safety& safety, vec2 p) {
+    if (!safety.live_enemies()) return 0;
+    const auto& pz = pack_members_of(world, safety);
+    int out = 0;
+    for (int k = 0; k < 2; ++k) {
+        const int r = pack_radius - k * params::pack_margin;
+        if (const std::uint32_t near = may_be_near(world, safety, p, r); near && outmatch_near(world, pz, near, p, r)) out |= 1 << k;
+    }
+    return out;
+}
