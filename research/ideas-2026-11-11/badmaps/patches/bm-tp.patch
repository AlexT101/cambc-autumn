diff -ru -x .cambc -x compile_commands.json oc-dfuel-506/src/model/world.cc bm-tp/src/model/world.cc
--- oc-dfuel-506/src/model/world.cc	2026-11-10 15:55:21.073063265 +0000
+++ bm-tp/src/model/world.cc	2026-11-11 06:39:36.124889657 +0000
@@ -562,6 +562,43 @@
             camp_hops_ = true;
         }
     }
+    // Shortcuts to altars on the walk: from tiles a crystal's range from the altar's near side (the walk within
+    // `side` steps of it) that the walk itself does not reach within side + the channel + shortcut_gain.
+    {
+        static bitboard near_side{cambc::uninitialized}, by_walk{cambc::uninitialized}, sources{cambc::uninitialized},
+            landings{cambc::uninitialized}, tile{cambc::uninitialized};
+        const std::size_t made = hops.size();
+        for (int a = 0; a < static_cast<int>(altars.size()); ++a) {
+            bool hopped = false;
+            for (std::size_t h = 0; h < made; ++h) hopped |= hops[h].altar == a;
+            and_into(altars[a].tribute_tiles(), foot(), tile);
+            drop(tile, camp_tiles);
+            if (hopped || board_empty(tile)) continue;
+            const vec2 from = first_tile(tile);
+            for (const int side : {params::shortcut_side, 2 * params::shortcut_side}) {
+                blocked_for_us.reachable_tiles_into(from, static_cast<std::uint16_t>(side), near_side);
+                blocked_for_us.reachable_tiles_into(
+                    from, static_cast<std::uint16_t>(side + cambc::constants::tp_crystal_time + params::shortcut_gain), by_walk);
+                square_dilate(near_side, teleport_crystal_range, sources);
+                sources &= foot();
+                drop(sources, by_walk);
+                drop(sources, camp_tiles);
+                if (board_empty(sources)) continue;
+                square_dilate(sources, teleport_crystal_range, landings);
+                landings &= near_side;
+                drop(landings, camp_tiles);
+                if (board_empty(landings)) continue;
+                Hop hop;
+                hop.altar = a;
+                hop.shortcut = true;
+                copy_into(sources, hop.sources);
+                copy_into(landings, hop.landings);
+                clear_board(hop.pocket);
+                clear_board(hop.camp_landings);
+                hops.push_back(std::move(hop));
+            }
+        }
+    }
     debug_block({ std::printf("HOPS %d\n", static_cast<int>(hops.size())); });
     return hops;
 }
