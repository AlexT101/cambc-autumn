 const ChampionBelief* partner(const World& world) { return linked_partner(world, world.me()); }
 
+Standing standing(const World& world) {
+    Standing s{world.score.ally, world.score.enemy};
+    for (const auto& a : world.allies)
+        if (a.alive) s.ally += a.is_self ? static_cast<int>(my_gems()) : a.visible ? a.gems : comms::bag_of(world, a.index);
+    for (const auto& e : world.enemies)
+        if (e.alive) s.enemy += e.gems;
+    return s;
+}
+
+namespace {
+std::array<std::vector<int>, 2> standing_log; // by round: ours, theirs
+} // namespace
+
+void note_standing(const World& world) {
+    const Standing s = standing(world);
+    for (int t = 0; t < 2; ++t) {
+        auto& log = standing_log[static_cast<std::size_t>(t)];
+        const int now = t ? s.enemy : s.ally;
+        if (log.empty()) log.reserve(cambc::constants::max_rounds + 1);
+        if (static_cast<int>(log.size()) <= world.round) log.resize(static_cast<std::size_t>(world.round) + 1, log.empty() ? now : log.back());
+        log[static_cast<std::size_t>(world.round)] = now;
+    }
+}
+
+float standing_pace(const World& world, bool enemy) {
+    const auto& log = standing_log[enemy ? 1 : 0];
+    const int from = std::max(world.first_round, world.round / 2);
+    if (world.round <= from || from >= static_cast<int>(log.size()) || world.round >= static_cast<int>(log.size())) return 0;
+    return static_cast<float>(log[static_cast<std::size_t>(world.round)] - log[static_cast<std::size_t>(from)]) / static_cast<float>(world.round - from);
+}
