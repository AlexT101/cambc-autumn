+// Each team's standing in the race to the win: tributed gems and the bags its living bodies carry, which
+// score once tributed (ours as seen, else as posted; theirs as last seen).
+struct Standing {
+    int ally = 0, enemy = 0;
+};
+Standing standing(const World& world);
+// Each turn: this round's standings, for standing_pace.
+void note_standing(const World& world);
