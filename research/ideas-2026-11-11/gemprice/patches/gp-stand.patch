 const ChampionBelief* partner(const World& world) { return linked_partner(world, world.me()); }
 
+Standing standing(const World& world) {
+    Standing s{world.score.ally, world.score.enemy};
+    for (const auto& a : world.allies)
+        if (a.alive) s.ally += a.is_self ? static_cast<int>(my_gems()) : a.visible ? a.gems : comms::bag_of(world, a.index);
+    for (const auto& e : world.enemies)
+        if (e.alive) s.enemy += e.gems;
+    return s;
+}
