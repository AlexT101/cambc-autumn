+// An unseen living ally's tile as its comms slot tells it this round or last: a cell centre, within
+// comms::told_error() of where it stood.
+inline bool told_tile(const World& world, const ChampionBelief& a, vec2& at) {
+    int round = -1;
+    return params::comms_slots && !a.is_self && a.alive && !a.visible && comms::told_ally(a.index, at, round) && round >= world.round - 1;
+}
 // What plan_crew, share_damage and crew_available read of each ally, read once for a farm call
 // (nothing in its loop changes them), in ally order; the costlier parts on first need.
 // `line` is the recall line plans are priced at.
