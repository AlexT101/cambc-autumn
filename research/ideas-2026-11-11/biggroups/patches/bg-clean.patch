+bool farm_heavy(const World& world, int g) {
+    const auto& map = world.map();
+    if (g < 0 || g >= static_cast<int>(map.groups.size())) return false;
+    static std::vector<std::int8_t> known; // by group: 0 unread, 1 no Golem or Monolith, 2 one
+    if (known.size() != map.groups.size()) known.assign(map.groups.size(), 0);
+    if (known[g] == 0) {
+        known[g] = 1;
+        for (const auto& m : map.groups[g].members)
+            if (m.type == cambc::camp_type::golem || m.type == cambc::camp_type::monolith) known[g] = 2;
+    }
+    if (known[g] != 2) return false;
+    const auto& G = map.groups[g];
+    // Monoliths stay farm_monolith's, as they were.
+    if (G.has_monolith) return false;
+    return !(map.shared_gems && big_group(G)) && G.cluster_gems >= params::heavy_rich_ratio * (G.gems - G.cluster_gems);
+}
