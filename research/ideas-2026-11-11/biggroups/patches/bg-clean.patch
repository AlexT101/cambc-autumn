+HeavyCrew heavy_plan(const World& world, const CrewAllies& allies, int g, const Field* walk, float trip_rounds, float cap_rounds, bool expect, int cap) {
+    HeavyCrew plan;
+    const auto& map = world.map();
+    const auto& G = map.groups[g];
+    const auto& c = world.camps[g];
+    const int n_groups = static_cast<int>(map.groups.size()), round = world.round;
+    const int recent = round - params::crew_seen_rounds;
+    // Copies of the allies' entries with share_damage's fields at the health we price them at.
+    // Static: their vec2s would be zeroed on every call.
+    static std::array<CrewAllies::Ally, 16> pool;
+    struct Body {
+        float arrival;
+        int slot;     // in `pool`, which is in ally order
+        bool committed; // a claimer of the group (us included), wherever it is
+    };
+    std::array<Body, 16> bodies;
+    int n = 0;
+    for (int i = 0; i < allies.n && n < static_cast<int>(pool.size()); ++i) {
+        const auto& x = allies.at[static_cast<std::size_t>(i)];
+        const auto& a = *x.a;
+        float delay = 0, health = 0;
+        const float max_health = a.is_self ? allies.my_max : a.max_health;
+        vec2 p;
+        // Gold farmers keep to their gold, in their own plans too.
+        if (farms_gold(world, a)) continue;
+        if (a.is_self) {
+            p = allies.here, health = allies.my_hp;
+        } else if (!a.alive) {
+            if (!expect || a.respawn_earliest < 0) continue;
+            delay = static_cast<float>(std::max(0, a.respawn_earliest - round));
+            p = map.ally_spawn_centre, health = max_health;
+        } else {
+            if (x.claim != g) {
+                if (!expect) continue;
+                if (x.claim >= 0 && x.claim < n_groups && map.groups[x.claim].strength > 0) {
+                    const auto& h = world.camps[x.claim];
+                    // Another heavy operation keeps its members; a strong group frees its claimer
+                    // once cleared at its own output (an upper bound: helpers only shorten it), a
+                    // cleared one after its hold.
+                    if (h.state == CampState::alive && farm_heavy(world, x.claim)) continue;
+                    if (h.state == CampState::alive) delay = world.clear_health[x.claim] / crew_output(x);
+                    else if (h.state == CampState::cleared) delay = cap_rounds;
+                }
+            }
+            vec2 told{-1, -1};
+            int told_round = -1;
+            if (a.visible) p = a.pos;
+            else if (params::comms_ally && comms::told_ally(a.index, told, told_round) && told_round >= recent && told_round >= a.pos_round && in_bounds(told))
+                p = told;
+            else if (a.pos_round >= recent && in_bounds(a.pos)) p = a.pos;
+            else continue;
+            // Out of sight its health is as last read while recent; on our spawn, or long unread, full.
+            health = test(map.ally_spawn, p) || (!a.visible && a.stats_round < recent) ? max_health : a.health;
+        }
+        int steps = walk ? walk->at(p) : unreachable;
+        if (steps == unreachable) steps = steps_to(G, p);
+        auto& e = pool[static_cast<std::size_t>(n)];
+        e = x;
+        e.has_pool = true;
+        e.weight = a.facts().walk_and_attack_independent() ? 1.5f : 1.0f;
+        e.taken = crew_taken(a);
+        e.score = (health - allies.line * max_health) / std::max(0.01f, e.taken) * e.weight;
+        e.budget = crew_budget(health, max_health, allies.line), e.usable = crew_usable(max_health, allies.line);
+        const bool committed = x.claim == g;
+        const float arrival = delay + static_cast<float>(std::max(0, steps - a.facts().attack_range()));
+        // Not here within a clear's bound: no part of this operation, whose wait it would set.
+        if (!committed && arrival > static_cast<float>(params::heavy_clear_rounds)) continue;
+        bodies[static_cast<std::size_t>(n)] = {arrival, n, committed};
+        ++n;
+    }
+    // Claimers first: the plan only adds to them, so an operation never prices its own members out
+    // (a nearer free ally would otherwise displace one still walking in, and every member re-plan).
+    // Then by arrival, and among equal arrivals the sturdiest (tank_score's order).
+    std::sort(bodies.begin(), bodies.begin() + n, [](const Body& x, const Body& y) {
+        if (x.committed != y.committed) return x.committed;
+        if (x.arrival != y.arrival) return x.arrival < y.arrival;
+        const float sx = pool[static_cast<std::size_t>(x.slot)].score, sy = pool[static_cast<std::size_t>(y.slot)].score;
+        return sx != sy ? sx > sy : x.slot < y.slot;
+    });
+    int at_work = 0;
+    while (at_work < n && bodies[static_cast<std::size_t>(at_work)].committed) ++at_work;
+    const bool awake = c.state == CampState::alive && c.awake != Awake::asleep;
+    // Woken or hit: its claimers finish what they started however long it takes (the retreat and
+    // too_late still end it); the bound is on launching one.
+    const bool under_way = c.state == CampState::alive && (awake || (world.clear_health[g] > 0 && world.clear_health[g] < G.health));
+    const float back = c.state == CampState::respawning ? static_cast<float>(std::max(0, c.respawn_round - round)) : 0.0f;
+    const float horizon = cycle_horizon(map);
+    float output = 0, weighted = 0, survivable = std::numeric_limits<float>::infinity(), best = -1, latest = 0;
+    float first = std::numeric_limits<float>::infinity();
+    int range = ranged_range, self_at = n;
+    for (int k = 0; k < n; ++k)
+        if (pool[static_cast<std::size_t>(bodies[static_cast<std::size_t>(k)].slot)].a->is_self) self_at = k;
+    std::array<const CrewAllies::Ally*, 16> members;
+    int chosen = 0;
+    for (int k = 0; k < n && k < std::max(cap, at_work); ++k) {
+        const auto& e = pool[static_cast<std::size_t>(bodies[static_cast<std::size_t>(k)].slot)];
+        const float o = crew_output(e), arrival = bodies[static_cast<std::size_t>(k)].arrival;
+        output += o, weighted += o * arrival, latest = std::max(latest, arrival), first = std::min(first, arrival);
+        survivable = std::min(survivable, home_survivable(*e.a));
+        range = std::min(range, e.a->facts().attack_range());
+        float rounds = 0;
+        float damage = min_camp_damage(world, g, output, &rounds, 0, range, survivable);
+        // Asleep it is woken once all have come (staged); awake, each works from its arrival, so
+        // the clear ends at the output-weighted mean arrival plus the clear at the full output.
+        const float start = std::max(back, awake ? weighted / output : latest);
+        if (awake && rounds > 0) damage *= (start + rounds - first) / rounds;
+        if (k + 1 < at_work) continue;
+        // share_damage takes its pool in ally order.
+        for (int j = 0; j <= k; ++j) members[static_cast<std::size_t>(j)] = &pool[static_cast<std::size_t>(bodies[static_cast<std::size_t>(j)].slot)];
+        std::sort(members.begin(), members.begin() + k + 1);
+        CrewPlan p;
+        p.damage = damage, p.rounds = rounds;
+        share_damage(members.data(), k + 1, p);
+        // Launched only clean: the hits fit the crew's spare health and send nobody home. Mite's and Fish's
+        // clears that pay take ~22 rounds and no trip; ours launched short of that lost a champion in half.
+        if (!(under_way && k < at_work)) {
+            float spare = 0;
+            for (int j = 0; j <= k; ++j) spare += members[static_cast<std::size_t>(j)]->budget * params::crew_trip_risk;
+            if (p.trips > 0 || damage > spare) continue;
+        }
+        // A member away on a trip home deals nothing: the clear lasts its trips' rounds over the crew
+        // longer, rounds the members' sum already counts.
+        const float away = static_cast<float>(p.trips) * trip_rounds, lasts = rounds + away / static_cast<float>(k + 1);
+        if (lasts > static_cast<float>(params::heavy_clear_rounds) && !(under_way && k < at_work)) continue;
+        const float team = static_cast<float>(k + 1) * (start + rounds) + away + cap_rounds;
+        const float yield = 1.0f / (team * (1.0f + (start + lasts) / horizon));
+        if (yield <= best) continue;
+        best = yield, chosen = k + 1;
+        plan.me = self_at <= k;
+        plan.n = k + 1, plan.trips = p.trips, plan.output = output, plan.start = start, plan.rounds = lasts;
+        plan.damage = damage, plan.my_damage = plan.me ? p.my_damage : 0.0f, plan.team_rounds = team;
+    }
+    for (int k = 0; k < chosen; ++k) {
+        const auto& e = pool[static_cast<std::size_t>(bodies[static_cast<std::size_t>(k)].slot)];
+        plan.claimers += !e.a->is_self && e.claim == g;
+    }
+    plan.expected = plan.n - plan.claimers - (plan.me ? 1 : 0);
+    return plan;
+}
