+// The Prism duel model and its uses (duel.h).
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// One side of a duel: what it can deal and take, and when each slot is next ready (rounds from now).
+struct Duellist {
+    const ChampionFacts* facts;
+    float hp, hit, focus, taken;
+    std::array<int, 2> ready;
+    bool immune;
+    bool cast0 = true, attack0 = true; // turn 0 still has its cast and basic attack (ours: not yet spent this turn)
+};
+
+Duellist duellist(const World& world, const ChampionBelief& c) {
+    Duellist d{&c.facts(), 0, 0, 0, std::max(0.01f, c.taken), {0, 0}, c.facts().passive == Passive::stun_immune};
+    if (c.is_self) {
+        // Our exact reads: the belief's stats date from the turn start, before shards or a kill's gems.
+        const auto& r = my_record();
+        const float scale = damage_scale(c.facts().passive, r.health, r.max_health) * champion_dealt_factor();
+        d.hp = r.health + my_live_shield(world), d.hit = r.strength * scale, d.focus = r.focus * scale;
+        d.cast0 = my_can_cast(), d.attack0 = my_can_attack();
+    } else {
+        // `scale` holds the Skirmish / Collectors factor (dealt) and Heart of Ruin's.
+        d.hp = c.health + c.shield, d.hit = c.strength * c.scale, d.focus = c.focus * c.scale;
+    }
+    // Turn 0 is our turn now, and its next turn for the other: this round if it acts after us, else next
+    // (team order alternates by round), a stun it is under counted apart (the duel's `lost`).
+    const int base = c.is_self ? world.round : next_turn_round(world, c) - (turn_lost(c) ? 1 : 0);
+    for (int s = 0; s < 2; ++s) d.ready[s] = std::max(0, c.ready_round[s] - base);
+    // A slot we cast this turn: our belief's cooldowns are from the turn's start.
+    if (c.is_self)
+        for (int s = 0; s < 2; ++s)
+            if (turn_acts.casts[s]) d.ready[s] = ability_cooldown;
+    return d;
+}
+
+// What side a does on its turn in round t (0: this one): a basic attack, and its one cast, a ready
+// stun first (unless the target is immune), else the most damaging. One attacker a target: a stun
+// cast while the target sits out a turn takes the following one, so none is wasted.
+// Attack resets add a basic attack; heals, shields and dashes are left out.
+struct Blow2 {
+    float damage = 0;
+    bool stuns = false;
+};
+Blow2 duel_turn(Duellist& a, const Duellist& b, int t) {
+    Blow2 out{t > 0 || a.attack0 ? a.hit : 0.0f, false};
+    if (t == 0 && !a.cast0) return out;
+    int pick = -1;
+    float best = 0;
+    bool pick_stuns = false;
+    for (int s = 0; s < 2; ++s) {
+        if (t < a.ready[s]) continue;
+        const auto& ab = a.facts->abilities[s];
+        float dmg = 0;
+        if (ab.kind == AbilityKind::damage) dmg = ab.multiplier * a.focus;
+        else if (ab.kind == AbilityKind::attack_reset) dmg = a.hit;
+        else if (ab.kind != AbilityKind::stun) continue;
+        const bool stuns = ab.stuns && !b.immune;
+        // A useful stun outranks damage: it takes the target's next turn.
+        if (pick < 0 || (stuns && !pick_stuns) || (stuns == pick_stuns && dmg > best)) pick = s, best = dmg, pick_stuns = stuns;
+    }
+    if (pick >= 0 && (best > 0 || pick_stuns)) {
+        out.damage += best, out.stuns = pick_stuns;
+        a.ready[pick] = t + ability_cooldown;
+    }
+    return out;
+}
+
+// Both sides act each round, as if at once: a stun cast in round t takes the target's turn in round
+// t + 1. Who acts first in a round is left out on purpose: once engaged it follows from who stepped
+// into range (an excludes-walking stun cannot follow the step), which the model cannot know; it is
+// what `even` stands for, and it keeps a mirror reading even. Neither side stops when it would fall,
+// so each count is the kill's round from where both stand now, engaged (in range).
+DuelEdge duel_edge(const World& world, const ChampionBelief& ours, const ChampionBelief& theirs) {
+    std::array<Duellist, 2> d{duellist(world, ours), duellist(world, theirs)};
+    std::array<float, 2> hp{d[0].hp, d[1].hp};
+    // A stun already on either takes its turn this round (ours: this turn, if we are the one).
+    std::array<bool, 2> lost{ours.is_self ? stunned_turn : ours.visible && ours.stun_pending, theirs.visible && theirs.stun_pending};
+    std::array<int, 2> kill{0, 0};
+    for (int t = 0; t < duel_horizon && (!kill[0] || !kill[1]); ++t) {
+        std::array<Blow2, 2> blow{};
+        for (int s = 0; s < 2; ++s)
+            if (!lost[s]) blow[s] = duel_turn(d[s], d[1 - s], t);
+        for (int s = 0; s < 2; ++s) {
+            const int o = 1 - s;
+            hp[o] -= blow[s].damage * d[o].taken;
+            if (hp[o] <= 0 && !kill[s]) kill[s] = t + 1;
+        }
+        // Stuns land after the round's turns: each takes the target's next one.
+        lost = {blow[1].stuns, blow[0].stuns};
+    }
+    DuelEdge e;
+    e.ours_kills_in = kill[0] ? kill[0] : duel_horizon + 1;
+    e.theirs_kills_in = kill[1] ? kill[1] : duel_horizon + 1;
+    e.verdict = e.ours_kills_in < e.theirs_kills_in ? DuelVerdict::favoured
+                : e.ours_kills_in > e.theirs_kills_in ? DuelVerdict::disfavoured : DuelVerdict::even;
+    return e;
+}
+
+// duel_edge with the turns in order, `ours_first` or theirs, each side engaging `after` own turns from its
+// duellist() base (cooldowns ticked meanwhile, turn 0 fresh): a stun takes the target's next turn, this
+// round's if it has yet to act. Kills compare by their place in that order.
+DuelEdge ordered_edge(const World& world, const ChampionBelief& ours, const ChampionBelief& theirs, bool ours_first, int ours_after, int theirs_after) {
+    std::array<Duellist, 2> d{duellist(world, ours), duellist(world, theirs)};
+    const std::array<int, 2> after{ours_after, theirs_after};
+    for (int s = 0; s < 2; ++s)
+        if (after[s] > 0) {
+            for (auto& r : d[s].ready) r = std::max(0, r - after[s]);
+            d[s].cast0 = d[s].attack0 = true;
+        }
+    std::array<float, 2> hp{d[0].hp, d[1].hp};
+    std::array<bool, 2> lost{ours_after == 0 && (ours.is_self ? stunned_turn : ours.visible && ours.stun_pending),
+                             theirs_after == 0 && theirs.visible && theirs.stun_pending};
+    std::array<int, 2> kill{0, 0}, at{0, 0};
+    const int first = ours_first ? 0 : 1;
+    for (int t = 0; t < duel_horizon && (!kill[0] || !kill[1]); ++t)
+        for (int h = 0; h < 2; ++h) {
+            const int s = h == 0 ? first : 1 - first, o = 1 - s;
+            if (lost[s]) {
+                lost[s] = false;
+                continue;
+            }
+            const auto b = duel_turn(d[s], d[o], t);
+            hp[o] -= b.damage * d[o].taken;
+            if (hp[o] <= 0 && !kill[s]) kill[s] = t + 1, at[s] = 2 * t + h + 1;
+            if (b.stuns) lost[o] = true;
+        }
+    DuelEdge e;
+    e.ours_kills_in = kill[0] ? kill[0] : duel_horizon + 1;
+    e.theirs_kills_in = kill[1] ? kill[1] : duel_horizon + 1;
+    const int a = at[0] ? at[0] : 4 * duel_horizon, b = at[1] ? at[1] : 4 * duel_horizon;
+    e.verdict = a < b ? DuelVerdict::favoured : a > b ? DuelVerdict::disfavoured : DuelVerdict::even;
+    return e;
+}
+
+int net_bodies(const World& world, vec2 p) {
+    int net = 0;
+    for (const auto& a : world.allies) {
+        if (!a.alive) continue;
+        if (a.is_self || a.visible) {
+            if (dist(a.is_self ? my_position() : a.pos, p) <= vision_radius) ++net;
+            continue;
+        }
+        // Out of our sight (vision is personal): where it last posted, aged as unseen enemies are.
+        vec2 at;
+        int round = -1;
+        if (comms::told_ally(a.index, at, round) && world.round - round <= duel_recent && dist(at, p) - (world.round - round) <= vision_radius) ++net;
+    }
+    for (const auto& e : world.enemies) {
+        if (!e.alive) continue;
+        if (e.visible ? dist(e.pos, p) <= vision_radius
+                      : e.tracked && e.turns_since_fixed <= duel_recent && dist(e.pos, p) - e.turns_since_fixed <= vision_radius)
+            --net;
+    }
+    return net;
+}
+
+// An enemy's reach before it could be answered: a walk on its next turn and its strike on the one
+// after (stuns and damage, with the slots ready by then), as a turn-order double move allows before
+// our next turn. Slots only come ready, so this bounds its one-turn strike too.
+int two_turn_reach(const World& world, const ChampionBelief& e) {
+    const int second = next_turn_round(world, e) + 1;
+    return std::min(vision_radius - 1, std::max(0, strike(e, second).reach) + 1);
+}
+
+struct Avoided {
+    vec2 centre;
+    int radius;
+};
+struct AvoidSet {
+    int round = -1;
+    std::uint32_t observations = ~0u;
+    unsigned actions = ~0u;
+    std::array<Avoided, 8> list;
+    int n = 0;
+    bool spacing = false; // the first entry is the enemy Prism's spacing
+    bitboard board{cambc::uninitialized};
+    bool drawn = false;
+};
+AvoidSet avoid_set;
+
+struct Shadowed {
+    int round = -1;
+    std::uint32_t enemies = 0; // bits by index
+};
+Shadowed shadowed;
+
+DuelVerdict last_verdict[16];
+bool verdict_known[16];
+
+void note_shadowed(const World& world, const ChampionBelief& e) {
+    if (shadowed.round != world.round) shadowed = {world.round, 0};
+    if (e.index < 32) shadowed.enemies |= 1u << e.index;
+    avoid_set.round = -1; // drawn again with it
+}
+
+const DuelSight* enemy_prism_sight(const World& world) {
+    static DuelSight sight;
+    static struct {
+        int round = -1;
+        std::uint32_t observations = ~0u;
+        unsigned actions = ~0u; // our casts, kills (gems: Focus) and moves since
+        float health = -1;
+        vec2 at{-1, -1};
+        bool has = false;
+    } key;
+    const auto& self = world.me();
+    if (!self.alive || self.facts().passive != Passive::gem_focus) return nullptr;
+    const vec2 here = my_position();
+    const float health = my_health();
+    if (key.round == world.round && key.observations == world.observations && key.actions == own_actions && key.health == health && key.at == here)
+        return key.has ? &sight : nullptr;
+    key = {world.round, world.observations, own_actions, health, here, false};
+    const ChampionBelief* found = nullptr;
+    for (const auto& e : world.enemies)
+        if (e.alive && e.facts().passive == Passive::gem_focus && (e.visible || (e.tracked && e.turns_since_fixed <= duel_recent))) found = &e;
+    if (!found) return nullptr;
+    const auto& e = *found;
+    sight.enemy = &e;
+    sight.edge = duel_edge(world, self, e);
+    sight.reach = two_turn_reach(world, e);
+    sight.spread = e.visible ? 0 : e.turns_since_fixed;
+    sight.net = net_bodies(world, here);
+    key.has = true;
+    debug_block({
+        const unsigned i = static_cast<unsigned>(e.index) & 15u;
+        if (e.visible && (!verdict_known[i] || last_verdict[i] != sight.edge.verdict)) {
+            verdict_known[i] = true, last_verdict[i] = sight.edge.verdict;
+            std::printf("DUEL %d %u %u %c %d %d %d\n", world.round, my_handle(), static_cast<std::uint32_t>(e.handle),
+                        static_cast<char>(sight.edge.verdict), sight.edge.ours_kills_in, sight.edge.theirs_kills_in, sight.net);
+        }
+    });
+    return &sight;
+}
+
+HuntOpen hunt_open(const World& world, const ChampionBelief& e) {
+    HuntOpen o;
+    const auto& self = world.me();
+    // Our first turn in stun range with a cast: this one if we stand in range unwalked, else the turn after
+    // the walk there (an excludes-walking stun never follows a walk).
+    const int walks = std::max(0, dist(my_position(), e.pos) - ability_range);
+    const bool now = walks == 0 && my_can_cast() && my_position() == world.turn_start;
+    o.turn = now ? 0 : std::max(1, walks);
+    // It strikes first unless we do now, or our next turn after a one-turn walk comes before its next one.
+    o.ours_first = now || (o.turn == 1 && seat_ahead_of(world, e));
+    // Its first turn after our arrival: o.turn - 1 turns from its next (as this round's order goes on).
+    o.edge = ordered_edge(world, self, e, o.ours_first, o.turn, std::max(0, o.turn - 1));
+    return o;
+}
+
+struct HuntTrace {
+    int round = -1;
+    std::uint32_t handle = 0;
+    int dist = 0;
+    float their_health = 0, our_health = 0;
+};
+HuntTrace hunt_trace;
+
+void note_hunt(const World& world, const ChampionBelief& e) {
+    hunt_trace = {world.round, static_cast<std::uint32_t>(e.handle), dist(my_position(), e.pos), e.health, my_health()};
+}
+
+void hunt_outcome(const World& world) {
+    const auto t = std::exchange(hunt_trace, HuntTrace{});
+    if (t.round < 0 || t.round >= world.round) return;
+    for (const auto& e : world.enemies)
+        if (static_cast<std::uint32_t>(e.handle) == t.handle)
+            std::printf("HUNTO %d %u %u %d %d %d %d %d %.0f %.0f %.0f %.0f\n", world.round, my_handle(), t.handle, world.round - t.round, e.alive ? 1 : 0,
+                        e.visible ? 1 : 0, t.dist, e.visible ? dist(my_position(), e.pos) : -1, t.their_health, e.visible ? e.health : -1.0f, t.our_health,
+                        my_health());
+}
+
+float hunt_worth(const World& world, const ChampionBelief& e) {
+    const int bag = pair_gems(world, e);
+    const float premium = bag > 0 ? prism_premium(world, world.me(), bag) : 0.0f;
+    const float gold = static_cast<float>(cambc::constants::kill_gold) * gold_paid(world) * prices(world).per_gold;
+    return static_cast<float>(bag) * (1.0f + premium) + std::max(0.0f, gold);
+}
+
+bool hunt_target(const World& world, const ChampionBelief& e) {
+    if (!e.alive || !e.visible || e.facts().passive != Passive::gem_focus) return false;
+    // Asked of every chase candidate and verdict in a turn: one answer while nothing it reads moves.
+    static struct {
+        int round = -1;
+        std::uint32_t observations = ~0u, handle = ~0u;
+        unsigned actions = ~0u;
+        float health = -1;
+        vec2 at{-1, -1};
+        bool hunt = false;
+    } key;
+    const vec2 here = my_position();
+    const float health = my_health();
+    const auto h = static_cast<std::uint32_t>(e.handle);
+    if (key.round == world.round && key.observations == world.observations && key.actions == own_actions && key.handle == h && key.health == health
+        && key.at == here)
+        return key.hunt;
+    key = {world.round, world.observations, h, own_actions, health, here, false};
+    const auto* sight = enemy_prism_sight(world);
+    if (!sight || sight->enemy != &e) return false;
+    if (test(world.map().near_enemy_spawn, e.pos)) return false;
+    if (my_state().contains(cambc::champion_state::submitting_gems) && winning_bag(world)) return false;
+    // Favoured as the duel would open: an approacher's walk-excluding stun cannot follow its walk in.
+    const auto o = hunt_open(world, e);
+    if (o.edge.verdict != DuelVerdict::favoured) return false;
+    if (net_bodies(world, e.pos) < 0) return false;
+    // The farm's gems a turn (farm_step_value is in enemy health points at params::gem_value a gem),
+    // against the kill's over the walk to stun range and the duel itself.
+    const float farm = farm_step_value(world) / params::gem_value;
+    key.hunt = hunt_worth(world, e) / static_cast<float>(o.turn + o.edge.ours_kills_in) > farm;
+    return key.hunt;
+}
+
+// The enemy Prism's spacing applies: disfavoured, or even with fewer of us than of them here.
+bool spaced(const DuelSight& s) {
+    return s.edge.verdict == DuelVerdict::disfavoured || (s.edge.verdict == DuelVerdict::even && s.net < 0);
+}
+
+const AvoidSet& avoids(const World& world) {
+    auto& a = avoid_set;
+    if (a.round == world.round && a.observations == world.observations && a.actions == own_actions) return a;
+    a.round = world.round, a.observations = world.observations, a.actions = own_actions, a.n = 0, a.spacing = false, a.drawn = false;
+    if constexpr (duel_spacing)
+        if (const auto* s = enemy_prism_sight(world); s && spaced(*s)) {
+            // A step beyond its reach (want_home's line), widened by a step a turn since it was seen.
+            a.list[a.n++] = {s->enemy->pos, s->reach + 1 + s->spread};
+            a.spacing = true;
+        }
+    if (shadowed.round == world.round && shadowed.enemies) {
+        for (auto left = shadowed.enemies; left; left &= left - 1) {
+            const auto& c = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+            if (!c.alive || !c.visible) continue;
+            // The carrier's and its escort's (visible enemies within sight of it) two-turn reach.
+            for (const auto& e : world.enemies) {
+                if (a.n == static_cast<int>(a.list.size()) || !e.alive || !e.visible || dist(e.pos, c.pos) > vision_radius) continue;
+                // Cassi and Issac carrying together note the same escort twice.
+                bool listed = false;
+                for (int i = 0; i < a.n; ++i) listed |= a.list[i].centre == e.pos;
+                if (!listed) a.list[a.n++] = {e.pos, two_turn_reach(world, e)};
+            }
+        }
+    }
+    return a;
+}
+
+const bitboard* duel_avoid(const World& world) {
+    auto& a = avoid_set;
+    avoids(world);
+    if (a.n == 0) return nullptr;
+    if (!a.drawn) {
+        clear_board(a.board);
+        for (int i = 0; i < a.n; ++i) draw_square(a.board, a.list[i].centre, static_cast<float>(a.list[i].radius));
+        a.drawn = true;
+    }
+    return &a.board;
+}
+
+bool spacing_retreat(const World& world) {
+    if constexpr (!duel_spacing) return false;
+    const auto* s = enemy_prism_sight(world);
+    if (!s || !s->enemy->alive || !s->enemy->visible || !spaced(*s)) return false;
+    // Our channel is continue_tribute's to judge (tribute_ok), and spacing never cancels it.
+    if (my_state().contains(cambc::champion_state::submitting_gems)) return false;
+    const int d = dist(my_position(), s->enemy->pos);
+    if (d > s->reach + 1) return false;
+    debug_block({
+        std::printf("SPACE %d %u %u retreat %c %d %d %d %d\n", world.round, my_handle(), static_cast<std::uint32_t>(s->enemy->handle),
+                    static_cast<char>(s->edge.verdict), s->edge.ours_kills_in, s->edge.theirs_kills_in, s->net, d);
+    });
+    return true;
+}
+
+bool group_avoided(const World& world, int g) {
+    const auto& a = avoids(world);
+    if (a.n == 0) return false;
+    const auto& G = world.map().groups[g];
+    const int range = world.camps[g].state == CampState::alive ? world.me().facts().attack_range() : 0;
+    for (int i = 0; i < a.n; ++i) {
+        bool all = true;
+        for (const auto& m : G.members)
+            if (dist(m.pos, a.list[i].centre) + range > a.list[i].radius) {
+                all = false;
+                break;
+            }
+        if (all) {
+            debug_block({
+                static int traced_round = -1, traced_group = -1;
+                if (traced_round != world.round || traced_group != g) {
+                    traced_round = world.round, traced_group = g;
+                    std::printf("SPACE %d %u %d skip %s\n", world.round, my_handle(), g, a.spacing && i == 0 ? "prism" : "shadow");
+                }
+            });
+            return true;
+        }
+    }
+    return false;
+}
