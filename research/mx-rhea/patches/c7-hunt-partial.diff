+// The Prism duel: one matchup model (who kills whom first, each side's stun cycle played out) and
+// its three uses: our Prism hunting a weaker enemy Prism, keeping its distance from a stronger
+// one (spacing), and the game-ender restraint (fight.cc game_ender).
+#pragma once
+#include <cstdint>
+#include "../model/world.h"
+
+namespace aph {
+
+// Piece 3 (spacing): c2-duel-ns, the ablation, sets it false.
+inline constexpr bool duel_spacing = false;
+
+enum class DuelVerdict : char { favoured = 'F', even = 'E', disfavoured = 'D' };
+
+struct DuelEdge {
+    // Own turns each side needs to kill the other once engaged (in range); stuns take a turn.
+    int ours_kills_in = 0, theirs_kills_in = 0;
+    DuelVerdict verdict = DuelVerdict::even;
+};
+
+namespace {
+
+// Turns past this read as no kill.
+inline constexpr int duel_horizon = 24;
+
+// Both sides acting each round as if at once: who strikes first is left out (a mirror reads even).
+DuelEdge duel_edge(const World& world, const ChampionBelief& ours, const ChampionBelief& theirs);
+
+// Our living visible allies within vision_radius of p (us included) less the enemies there, visible
+// or tracked and possibly there; Cassi and Issac count one body each.
+int net_bodies(const World& world, vec2 p);
+
+// The enemy Prism as our Prism sees it this turn: visible, or seen within duel_recent turns (its
+// tiles bounded by a step a turn since); null if neither, or if we are no Prism.
+inline constexpr int duel_recent = 3;
+struct DuelSight {
+    const ChampionBelief* enemy = nullptr;
+    DuelEdge edge;
+    int reach = 0;  // its two-turn reach (two_turn_reach)
+    int spread = 0; // turns since its tile was known (0 while visible)
+    int net = 0;    // net_bodies at our tile
+};
+const DuelSight* enemy_prism_sight(const World& world);
+
+// The duel as our hunt would open it on e (duel.cc hunt_open): `turn`, our first turn (0: this one) in stun
+// range with a cast; `ours_first`, whether ours comes before its next then; the duel played from there.
+struct HuntOpen {
+    int turn = 0;
+    bool ours_first = false;
+    DuelEdge edge;
+};
+HuntOpen hunt_open(const World& world, const ChampionBelief& e);
+// Debug: a hunt chased this turn, and at our next turn's start (decide) what became of it (HUNTO).
+void note_hunt(const World& world, const ChampionBelief& e);
+void hunt_outcome(const World& world);
+
+// Our Prism hunts e (a visible enemy Prism): favoured as hunt_open plays the duel, net bodies near it >= 0, off its
+// spawn's edge, we not tributing a winning bag, and the kill's worth over our turns to it beats the farm.
+bool hunt_target(const World& world, const ChampionBelief& e);
+// The hunt's worth in gems: e's bag x (1 + our Prism premium on it) and the kill gold.
+float hunt_worth(const World& world, const ChampionBelief& e);
+
+// Spacing (our Prism only): the tiles a disfavoured enemy Prism (or an even one, with net bodies
+// below 0 here) could reach us on within two turns, a step beyond (want_home's line), and a
+// restrained game-ender's reach (fight.cc game_ender) for any of us; null when none.
+const bitboard* duel_avoid(const World& world);
+// want_home's spacing line: such an enemy Prism in sight within its reach + 1, while we are not
+// channelling a tribute.
+bool spacing_retreat(const World& world);
+// A group whose work tiles (camp tiles cleared, else within our attack range of a member) all lie
+// within `zone` of the avoided champions (duel_avoid's), as the farm loop skips it.
+bool group_avoided(const World& world, int g);
+
+// An enemy's reach before we could answer: a walk on its next turn, then its strike (stuns and damage).
+int two_turn_reach(const World& world, const ChampionBelief& e);
+
+// fight.cc's game-ender restraint: a non-channelling carrier set to be shadowed this turn.
+void note_shadowed(const World& world, const ChampionBelief& e);
+
+} // namespace
