+    // For a group an ally claims (callers pass only taken ones, is_claimed: as the turn began, claimed first or
+    // joined as its crew): whether claimers that work it no later than our recall would fill its holders, so the
+    // capture is theirs. A recall is then not taken for it; a walk to it is re-weighed every turn. Theirs is
+    // work_arrival's, the soonest they may work it, as the claimed branch reads it (an ally out of sight works it
+    // from now); ours is measured the same way (the Chebyshev gap from the spawn box into reach). Both no sooner
+    // than the respawn.
+    int my_reach = -1, my_dash_steps = 0;
+    const auto served_first = [&](int g, int respawn, bool trace) {
+        const auto& group = groups[g];
+        const auto& belief = world.camps[g];
+        if (my_reach < 0) {
+            const auto& f = world.me().facts();
+            my_reach = f.attack_range();
+            for (const auto& ability : f.abilities)
+                if (ability.kind == AbilityKind::damage) my_reach = std::max(my_reach, ability.reach());
+                else if (ability.lands()) my_reach = std::max(my_reach, ability.radius);
+            const int dash = f.slot_of(AbilityKind::dash);
+            my_dash_steps = dash >= 0 ? f.abilities[dash].range() : 0;
+        }
+        const bool alive = belief.state == CampState::alive;
+        int spawn_distance = unreachable;
+        for (std::size_t i = 0; i < group.members.size(); ++i) {
+            if (alive && belief.health[i] <= 0) continue;
+            const auto p = group.members[i].pos;
+            const int dx = std::max({spawn_lo.x - p.x, 0, p.x - spawn_hi.x});
+            const int dy = std::max({spawn_lo.y - p.y, 0, p.y - spawn_hi.y});
+            spawn_distance = std::min(spawn_distance, std::max(dx, dy));
+        }
+        if (spawn_distance == unreachable) return false;
+        const int ours = std::max(respawn, via_recall.channel + via_recall.hurt
+                                               + earliest_work_delay(spawn_distance - my_reach, 0, 0, my_dash_steps, ability_cooldown, false));
+        int first = 0, claimers = 0, theirs = unreachable;
+        for (const auto& a : world.allies) {
+            if (a.is_self || !a.alive || comms::claim_of(world, a.index) != g) continue;
+            ++claimers;
+            const int at = std::max(respawn, work_arrival(a, g).delay(world.round));
+            theirs = std::min(theirs, at);
+            if (at <= ours) ++first;
+        }
+        const bool served = first >= holders(group);
+        debug_block({
+            if (served && trace)
+                std::printf("RFSERVED %d %u %d ours %d theirs %d first %d of %d\n", world.round, my_handle(), g, ours, theirs, first, claimers);
+        });
+        return served;
+    };
