--- bots/variants/chy-ref/src/model/presence.h	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/c1-presence/src/model/presence.h	2026-11-13 15:07:23.700073157 +0000
@@ -0,0 +1,67 @@
+// Where the enemy can provably not be: the earliest round each enemy could start its turn within a
+// Chebyshev reach of a tile, a lower bound from how champions move. Dead, from its spawn after the
+// respawn turn; alive, from its last fix (pos, pos_round) or by a recall to its spawn. Terrain is
+// ignored (Chebyshev never exceeds a walk), so a bound holds through walls, holes and fog.
+#pragma once
+#include <cambc.h>
+#include <array>
+#include "../champions.h"
+#include "../util.h"
+
+namespace aph {
+
+class World;
+struct ChampionBelief;
+
+namespace presence_detail {
+// One enemy's bound this round: two ways in, each from an anchor at a round (`k0`: rounds elapsed since
+// it, negative while ahead), at a speed; the earlier arrival counts.
+struct Entry {
+    float weight = 1;   // its share of a pick: Cassi and Issac half each
+    int strike = 0;     // one_turn_reach
+    int interrupt = 0;  // farthest a stun, a kill's first blow or a lock reaches our channel from
+    int px = -1, py = -1, pk0 = 0; // its last fix (px < 0: none)
+    int bk0 = 0;        // its spawn's, by respawn or recall
+    int slack = 0;      // teleports: tiles a crystal gains over walking
+    std::uint8_t speed = 0; // 0 walks; 1 dashes once a cooldown; 2 dashes every turn (Vendetta's kill reset)
+    bool dead = false;
+};
+} // namespace presence_detail
+
+// The round's table: bounds only tighten as a turn learns more, so the first build holds all turn.
+class EnemyPresence {
+public:
+    static const EnemyPresence& of(const World& world);
+    // The earliest round enemy `i` (world.enemies order) could start a turn within `reach` of p.
+    int arrival(int i, vec2 p, int reach) const;
+    // True if it provably cannot be within `reach` of p by the start of its turn in round + horizon.
+    bool absent(int i, vec2 p, int reach, int horizon) const;
+    // The share of the enemy team that may be within strike reach of p by round + horizon.
+    float share(vec2 p, int horizon) const;
+    // share(p, horizon) < 1, with an early out.
+    bool any_absent(vec2 p, int horizon) const;
+    // No enemy could stun, hit or lock a tributer at p before the start of round + horizon's turns end.
+    bool none_interrupts(vec2 p, int horizon) const;
+    // Some enemy may be absent somewhere this round: false means share() is 1 everywhere.
+    bool active() const { return active_; }
+    int round() const { return round_; }
+
+private:
+    void build(const World& world);
+    int round_ = -1;
+    bool active_ = false, overflow_ = false;
+    float total_ = 1;
+    int n_ = 0;
+    std::array<presence_detail::Entry, 8> e_{};
+    std::array<bool, 8> live_{}; // may be absent somewhere
+    std::array<int, 8> respawn_seen_{-1, -1, -1, -1, -1, -1, -1, -1}; // respawn_earliest as last built while dead
+    int sx0_ = 0, sx1_ = 0, sy0_ = 0, sy1_ = 0; // the enemy spawn's box
+};
+
+// The earliest round e could start its turn within Chebyshev `reach` of target (a provable lower bound).
+int earliest_arrival(const World& world, const ChampionBelief& e, vec2 target, int reach);
+// The share of the enemy team (a pick 1, Cassi and Issac half each) that could be within its one-turn
+// strike reach of the group's centre by round + horizon_rounds: 1 everyone may, 0 provably none.
+float presence(const World& world, int group, int horizon_rounds);
+
+} // namespace aph
