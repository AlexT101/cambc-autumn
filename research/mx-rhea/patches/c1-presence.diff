diff -ruN bots/variants/chy-ref/src/model/presence.cc bots/variants/c1-presence/src/model/presence.cc
--- bots/variants/chy-ref/src/model/presence.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/c1-presence/src/model/presence.cc	2026-11-13 15:07:23.699966905 +0000
@@ -0,0 +1,151 @@
+#include "presence.h"
+#include <algorithm>
+#include "safety.h"
+#include "world.h"
+
+namespace aph {
+
+namespace presence_impl {
+
+using presence_detail::Entry;
+constexpr int no_cover = -(1 << 20);
+
+// The farthest it can have moved in k turns from its anchor. A dash adds 2 once a cooldown, ready at
+// the anchor; Vendetta's kill reset may ready it every turn. A crystal's 3 tiles over 3 turns beat
+// walking only by the step taken before starting it: one a crystal, at most two (one carried, one
+// bought on the way through its spawn).
+int cover(int k, const Entry& e) {
+    if (k < 0) return no_cover;
+    const int dashes = e.speed == 0 ? 0 : e.speed == 1 ? (k + ability_cooldown - 1) / ability_cooldown : k;
+    return k + dash_range * dashes + e.slack;
+}
+
+// The fewest turns from its anchor for cover() to reach `need`.
+int turns_to(int need, const Entry& e) {
+    need -= e.slack;
+    if (need <= 0) return 0;
+    if (e.speed == 0) return need;
+    if (e.speed == 2) return (need + dash_range) / (1 + dash_range);
+    // Each cooldown's turns cover ability_cooldown + dash_range, the first turn of it 1 + dash_range.
+    constexpr int block = ability_cooldown + dash_range;
+    const int m = (need - 1) / block, rem = need - m * block;
+    return m * ability_cooldown + std::max(1, rem - dash_range);
+}
+
+} // namespace presence_impl
+using presence_impl::cover;
+using presence_impl::turns_to;
+
+void EnemyPresence::build(const World& world) {
+    round_ = world.round;
+    const int now = world.round;
+    const auto& map = world.map();
+    sx0_ = map.enemy_spawn_box.x0, sx1_ = map.enemy_spawn_box.x1, sy0_ = map.enemy_spawn_box.y0, sy1_ = map.enemy_spawn_box.y1;
+    const int farthest = std::max(map_width, map_height) - 1;
+    n_ = std::min<int>(static_cast<int>(world.enemies.size()), static_cast<int>(e_.size()));
+    overflow_ = world.enemies.size() > e_.size(); // the rest count as present
+    total_ = 0;
+    active_ = false;
+    for (const auto& b : world.enemies) total_ += b.facts().passive == Passive::linked_pair ? 0.5f : 1.0f;
+    if (total_ <= 0) total_ = 1;
+    for (int i = 0; i < n_; ++i) {
+        const auto& b = world.enemies[static_cast<std::size_t>(i)];
+        const auto& f = b.facts();
+        presence_detail::Entry e;
+        e.weight = f.passive == Passive::linked_pair ? 0.5f : 1.0f;
+        e.strike = one_turn_reach(f);
+        // A lock goes on an altar within altar_lock_range, the altar within submit range of the tributer,
+        // after the turn's walk and dash.
+        e.interrupt = std::max(e.strike, cambc::constants::submit_gems_range + altar_lock_range + 1 + (f.has_dash() ? dash_range : 0));
+        e.speed = !f.has_dash() ? 0 : f.passive == Passive::reset_on_kill ? 2 : 1;
+        e.slack = 2;
+        int box_from;
+        auto& respawn = respawn_seen_[static_cast<std::size_t>(i)];
+        e.dead = !b.alive;
+        if (!b.alive) {
+            // It respawns at a turn start in respawn_earliest at the soonest and cannot move that turn.
+            box_from = b.respawn_earliest >= 0 ? b.respawn_earliest + 1 : now;
+            respawn = b.respawn_earliest;
+        } else if (b.pos_source == Source::inferred || b.pos_round < 0 || !in_bounds(b.pos)) {
+            // On its spawn by the rules (start, respawn): any spawn tile, from the round before, or from
+            // the respawn last read while dead when updates skipped rounds (World forgets it on respawn).
+            box_from = b.pos_round < 0 ? 0 : b.pos_round - 1;
+            if (respawn >= 0) box_from = std::min(box_from, respawn + 1);
+        } else {
+            // Seen at pos in pos_round, before or after its turn: its turns from that round count.
+            e.px = b.pos.x, e.py = b.pos.y, e.pk0 = now - b.pos_round;
+            if (b.seen_channel == Channel::teleport) e.slack += teleport_crystal_range;
+            // A recall lands at a turn start, a full turn; Home's is the shortest. A teammate's sighting
+            // carries no channel: a recall may be under way.
+            box_from = b.pos_round + (b.seen_channel == Channel::recall || b.pos_source == Source::comms ? 0 : home_recall_time);
+            respawn = -1;
+        }
+        e.bk0 = now - box_from;
+        e_[static_cast<std::size_t>(i)] = e;
+        // Absent somewhere at horizon 0 only if neither way covers the whole map.
+        const bool box_all = e.bk0 >= 0 && cover(e.bk0, e) + e.strike >= farthest;
+        const bool point_all = e.px >= 0 && cover(e.pk0, e) + e.strike >= farthest;
+        live_[static_cast<std::size_t>(i)] = !box_all && !point_all;
+        active_ |= live_[static_cast<std::size_t>(i)];
+    }
+}
+
+const EnemyPresence& EnemyPresence::of(const World& world) {
+    static EnemyPresence table;
+    if (table.round_ != world.round) table.build(world);
+    return table;
+}
+
+int EnemyPresence::arrival(int i, vec2 p, int reach) const {
+    if (i < 0 || i >= n_) return round_;
+    const auto& e = e_[static_cast<std::size_t>(i)];
+    const int box = std::max({0, sx0_ - p.x, p.x - sx1_, sy0_ - p.y, p.y - sy1_});
+    int at = round_ - e.bk0 + turns_to(box - reach, e);
+    if (e.px >= 0) at = std::min(at, round_ - e.pk0 + turns_to(dist(vec2{e.px, e.py}, p) - reach, e));
+    return std::max(round_, at);
+}
+
+bool EnemyPresence::absent(int i, vec2 p, int reach, int horizon) const {
+    if (i < 0 || i >= n_) return false;
+    const auto& e = e_[static_cast<std::size_t>(i)];
+    // arrival > round + horizon, i.e. neither way's cover in its elapsed turns reaches.
+    if (const int k = e.bk0 + horizon; k >= 0 && std::max({0, sx0_ - p.x, p.x - sx1_, sy0_ - p.y, p.y - sy1_}) - reach <= cover(k, e)) return false;
+    if (e.px < 0) return true;
+    const int k = e.pk0 + horizon;
+    return k < 0 || std::max(std::abs(e.px - p.x), std::abs(e.py - p.y)) - reach > cover(k, e);
+}
+
+float EnemyPresence::share(vec2 p, int horizon) const {
+    if (!active_) return 1.0f;
+    float gone = 0;
+    for (int i = 0; i < n_; ++i)
+        if (live_[static_cast<std::size_t>(i)] && absent(i, p, e_[static_cast<std::size_t>(i)].strike, horizon)) gone += e_[static_cast<std::size_t>(i)].weight;
+    return gone > 0 ? std::max(0.0f, 1.0f - gone / total_) : 1.0f;
+}
+
+bool EnemyPresence::any_absent(vec2 p, int horizon) const {
+    if (!active_) return false;
+    for (int i = 0; i < n_; ++i)
+        if (live_[static_cast<std::size_t>(i)] && absent(i, p, e_[static_cast<std::size_t>(i)].strike, horizon)) return true;
+    return false;
+}
+
+bool EnemyPresence::none_interrupts(vec2 p, int horizon) const {
+    if (overflow_) return false;
+    // A respawn turn allows no walk, attack or cast, but may allow a lock: a turn more for the dead.
+    for (int i = 0; i < n_; ++i)
+        if (const auto& e = e_[static_cast<std::size_t>(i)]; !absent(i, p, e.interrupt, horizon + (e.dead ? 1 : 0))) return false;
+    return true;
+}
+
+int earliest_arrival(const World& world, const ChampionBelief& e, vec2 target, int reach) {
+    const auto i = &e - world.enemies.data();
+    if (i < 0 || i >= static_cast<std::ptrdiff_t>(world.enemies.size())) return world.round;
+    return EnemyPresence::of(world).arrival(static_cast<int>(i), target, reach);
+}
+
+float presence(const World& world, int group, int horizon_rounds) {
+    return EnemyPresence::of(world).share(world.map().groups[static_cast<std::size_t>(group)].centre, horizon_rounds);
+}
+
+} // namespace aph
