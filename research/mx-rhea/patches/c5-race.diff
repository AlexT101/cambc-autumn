diff -ruN -x .cambc bots/variants/chy-ref/src/economy/race.cc bots/variants/c5-race/src/economy/race.cc
--- bots/variants/chy-ref/src/economy/race.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/c5-race/src/economy/race.cc	2026-11-13 16:36:35.113905314 +0000
@@ -0,0 +1,53 @@
+// The endgame tribute race: who stops an enemy's winning channel. Only a stun, a lock placed at its altar or a kill stops a
+// tribute; damage does not (rules: gems.tribute, abilities.stun, altar_locks.effect). A kill hands over the victim's whole bag
+// (combat.kill), so our winning bag's holder is the costliest stopper to send.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+bool ally_stops_in_time(const World& world, const ChampionBelief& e) {
+    if (ally_stops(world, e)) return true;
+    if (e.channel != Channel::tribute || test(world.map().bushes, e.pos)) return false;
+    const int lands = e.channel_end_round, altar = tribute_altar(world, e.pos);
+    // A lock there cancels our own channel at that altar too.
+    const bool lockable = altar >= 0 && tribute_altar(world, my_position()) != altar;
+    const bool stunnable = e.facts().passive != Passive::stun_immune;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || !a.visible || held_by_channel(a) || stun_pending(a.handle)) continue;
+        // It goes only for an ender in its own sight (vision.personal): no beacon tells it of one.
+        if (dist(a.pos, e.pos) > vision_radius) continue;
+        // An ally holding a winning bag of its own leaves the stop to others as we do.
+        if (pair_gems(world, a) + world.score.ally >= static_cast<int>(cambc::constants::winning_gems)) continue;
+        const int r0 = a.acted ? world.round + 1 : world.round;
+        if (!a.can_act(r0)) continue;
+        // Its stop lands before the channel's last turn end: by the turn before the completing round.
+        const int turns = lands - 1 - r0;
+        if (turns < 0) continue;
+        // Only a stun ready by next round sends it (holds_hard_stop): one on cooldown does not walk in.
+        if (stunnable)
+            for (int s = 0; s < 2; ++s)
+                if (const int reach = a.facts().stun_reach(s);
+                    reach >= 0 && a.ready_round[s] <= world.round + 1 && dist(a.pos, e.pos) - reach <= turns)
+                    return true;
+        if (lockable && dist(a.pos, world.map().altars[altar].pos) - altar_lock_range <= turns) {
+            std::array<std::uint32_t, 4> counts{};
+            const auto lock = cambc::detail::raw_consumable_ids[static_cast<std::size_t>(cambc::consumable_type::altar_lock)];
+            if (cambc::detail::sdk_champion_consumables(static_cast<std::uint32_t>(a.handle), counts.data()) == 0 && counts[lock] > 0)
+                return true;
+        }
+    }
+    return false;
+}
+
+bool enemy_race_on(const World& world) {
+    const int need = static_cast<int>(cambc::constants::winning_gems) - world.score.enemy;
+    for (const auto& e : world.enemies)
+        if (e.alive && pair_gems(world, e) >= need) return true;
+    return false;
+}
+
+} // namespace
+
+} // namespace aph
