+// The tile we would work g from: where the descent from our tile down its approach field ends (onto
+// its tiles once cleared, else into attack range), and its steps; off the map without a way or the fuel
+// for its search and descent above `floor`.
+vec2 work_tile(const World& world, Pathing& pathing, int g, std::uint64_t floor, int& steps) {
+    const vec2 off{-1, -1};
+    const auto* field = pathing.prepare_approach(g, walk_range(world, g), floor);
+    if (!field) return off;
+    vec2 p = my_position();
+    int at = steps = field->at(p);
+    if (at == unreachable) return off;
+    while (at > 0) {
+        if (!fuel_ok(floor)) return off;
+        vec2 next = p;
+        for (const auto d : directions)
+            if (const vec2 q = p + d; in_bounds(q))
+                if (const int s = field->at(q); s < at) at = s, next = q;
+        if (next == p) return off;
+        p = next;
+    }
+    return p;
+}
+
+// Farm skips the group want_home's lost stand sent us home from (Memory::threat_group) while the same
+// test at the tile we would work it from, with what we believe and our health now, still sends us home;
+// once it holds there the mark goes. Judged once a turn; with no way there or no fuel to judge, the
+// mark stands.
+bool threat_skips(const World& world, Pathing& pathing, Safety& safety, Memory& memory) {
+    const int g = memory.threat_group;
+    if (g < 0) return false;
+    if (memory.threat_checked == world.round) return memory.threat_skip;
+    memory.threat_checked = world.round, memory.threat_skip = true;
+    // The stand test, and what the turn's work after it keeps.
+    const auto floor = act_reserve + safety.fight_cost_estimate();
+    int steps = 0;
+    const vec2 p = work_tile(world, pathing, g, floor, steps);
+    if (p.x < 0 || !fuel_ok(floor)) return true;
+    if (stand_held_at(world, pathing, safety, p, memory.damage, steps)) {
+        debug_block({ std::printf("THREAT CLEAR %d %u g%d held %d,%d set %d\n", world.round, my_handle(), g, p.x, p.y, memory.threat_round); });
+        memory.threat_group = -1, memory.threat_skip = false;
+        return false;
+    }
+    debug_block({ std::printf("THREAT SKIP %d %u g%d at %d,%d set %d\n", world.round, my_handle(), g, p.x, p.y, memory.threat_round); });
+    return true;
+}
