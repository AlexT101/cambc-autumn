+// The farm group's mark (Memory::threat_group) goes once its verdict may have changed: its camp state
+// changed (cleared, captured, back), we died or reached our spawn, or a heal raised our health.
+void threat_upkeep(const World& world, Memory& memory) {
+    const int g = memory.threat_group;
+    if (g < 0) return;
+    const char* why = nullptr;
+    if (!world.me().alive) why = "dead";
+    else if (static_cast<int>(world.camps[g].state) != memory.threat_state) why = "state";
+    else if (test(world.map().ally_spawn, my_position())) why = "home"; // a recall's landing too (every turn end starts one)
+    else if (my_health() > memory.threat_health) why = "healed";
+    if (!why) return;
+    debug_block({ std::printf("THREAT CLEAR %d %u g%d %s set %d\n", world.round, my_handle(), g, why, memory.threat_round); });
+    memory.threat_group = -1;
+}
+
+// want_home's lost stand (drawn_home, stand_lost_at) sends us home within the pursuers' horizon of our
+// farm group's work tiles: the verdict is about the stand there, so farm asks it again before going back.
+void threat_mark(const World& world, Pathing& pathing, Memory& memory) {
+    const int g = memory.farm_group;
+    const vec2 here = my_position();
+    if (g < 0 || g >= static_cast<int>(world.camps.size()) || !home_verdict.stand || home_verdict.round != world.round || home_verdict.at != here)
+        return;
+    const int range = walk_range(world, g);
+    const Field* field = pathing.approach_ready(g, range) ? pathing.approach(g, range) : nullptr;
+    // No walk is shorter than the crow's.
+    const int steps = field ? field->at(here) : std::max(0, steps_to(world.map().groups[g], here) - range);
+    if (steps > params::pursuit_steps) return;
+    debug_block({ std::printf("THREAT MARK %d %u g%d steps %d hp %.0f\n", world.round, my_handle(), g, steps, my_health()); });
+    memory.threat_group = g, memory.threat_round = world.round, memory.threat_state = static_cast<int>(world.camps[g].state);
+    memory.threat_health = my_health(), memory.threat_checked = -1;
+}
