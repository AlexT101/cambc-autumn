+// The information `sight`, cast r from w, holds: band_count of the tiles, plus each enemy's mass on
+// them. If a bound on it is at most `skip`, the bound instead (a candidate that cannot pass).
+float info_value(const bitboard& sight, vec2 w, int r, const bitboard& near, const bitboard& far, const EnemyMass& mass,
+                 float skip = -1) {
+    float value = static_cast<float>(band_count(sight, w, r, near, far));
+    if (mass.n >= 2 && skip >= 0)
+        if (const float bound = value + mass.total * static_cast<float>(band_count(sight, w, r, mass.any_near(), mass.any_far())); bound <= skip)
+            return bound;
+    for (int i = 0; i < mass.n; ++i)
+        if (mass.box[static_cast<std::size_t>(i)]->meets(w, r))
+            value += mass.weight[static_cast<std::size_t>(i)] * static_cast<float>(band_count(sight, w, r, mass.near(i), mass.far(i)));
+    return value;
+}
