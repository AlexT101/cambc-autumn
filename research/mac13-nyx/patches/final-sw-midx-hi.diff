+        if (site >= 0 && site < groups)
+            for (const auto& m : map.groups[site].members) set_tile(*b, m.pos);
+    }
+    if (in_bounds(memory.ward)) {
+        ward_sight_from(map, memory.ward, static_cast<int>(cambc::constants::ward_vision_radius), sight);
+        drop(near, sight);
+        drop(far, sight);
+    }
+    EnemyMass mass;
+    enemy_mass(world, near, far, mass);
+    ward_sight_from(map, here, vision_radius, sight);
+    const float stay = info_value(sight, here, vision_radius, near, far, mass);
+    std::array<std::pair<float, vec2>, 8> order;
+    int m = 0;
+    for (int k = 0; k < n; ++k) {
+        const vec2 t = candidates[static_cast<std::size_t>(k)];
+        ward_sight_from(map, t, vision_radius, sight);
+        const float v = info_value(sight, t, vision_radius, near, far, mass, stay);
+        if (v <= stay) continue;
