+// The walk's scouting tie-break (Pathing::set_step_pick): of the equally short first steps a walk
+// offers, the one whose own sight holds most by step_for_sight's weights, over the walk's own pick
+// (steps[0]) only if strictly more and no less safe than it by Safety's bound, the camps and bush
+// cover, and on the same camp group or none (step_for_sight's reasons: no step starts, contests or
+// splits a capture, or holds a respawn back). The far band reaches vision_radius + 1 from here, so
+// every step's whole sight counts and open ground ties. For the economy's walks alone (siege and
+// kite walk as farm), never with an enemy in sight: fights place us. Once a turn a tile: a walk
+// refused by a hidden unit saw something new, which the world does not hold until it is observed.
+struct WalkSight {
+    World* world = nullptr;
+    const Pathing* pathing = nullptr;
+    Safety* safety = nullptr;
+    const Memory* memory = nullptr;
+};
+inline constexpr std::uint64_t walk_sight_cost = 4000, walk_sight_candidate_cost = 1500;
+[[gnu::noinline]] int walk_sight(void* ctx, std::span<const vec2> steps) {
+    const auto& w = *static_cast<const WalkSight*>(ctx);
+    World& world = *w.world;
+    Safety& safety = *w.safety;
+    const Memory& memory = *w.memory;
+    switch (decision) {
+    case Branch::farm: case Branch::bank: case Branch::shop: case Branch::guard_altar: break;
+    default: return 0;
+    }
+    if (world.is_stale() || stunned_turn || fixc_bush_threatened || enemy_seen(world) || w.pathing->bumped_this_round()) return 0;
+    // An excludes-walking cast refuses the walk (rules abilities.exclusive).
+    for (int s = 0; s < 2; ++s)
+        if (turn_acts.casts[s] && world.me().facts().abilities[s].excludes_walking) return 0;
+    const vec2 here = my_position();
+    static struct {
+        int round = -1;
+        vec2 at{-1, -1};
+    } looked;
+    if (looked.round == world.round && looked.at == here) return 0;
+    const int n = static_cast<int>(steps.size());
+    // The walk's own work (a hit after the step, the turn's end) keeps act_reserve.
+    const std::uint64_t need = act_reserve + walk_sight_cost + static_cast<std::uint64_t>(n) * walk_sight_candidate_cost;
+    if (!fuel_ok(need)) {
+        note_shortcut("walk-sight-fuel");
+        return 0;
+    }
+    looked = {world.round, here};
+    std::uint64_t spent_from = 0;
+    debug_block({ spent_from = fuel(); });
+    const auto& map = world.map();
+    const vec2 first = steps[0];
+    const int group = map.group_at(first);
+    const auto risk = safety.bound(first);
+    const float camps = safety.camp_damage(first);
+    const int cover = fixc_bush_rank(world, first);
+    std::array<int, 8> alt;
+    int m = 0;
+    for (int k = 1; k < n; ++k) {
+        const vec2 t = steps[static_cast<std::size_t>(k)];
+        if (map.group_at(t) != group) continue;
+        const auto r = safety.bound(t);
+        if (r.damage > risk.damage || r.doubled > risk.doubled || (r.hits && !risk.hits) || (r.stuns && !risk.stuns)
+            || (r.threat && !risk.threat) || safety.camp_damage(t) > camps || fixc_bush_rank(world, t) > cover)
+            continue;
+        alt[static_cast<std::size_t>(m++)] = k;
+    }
+    if (m == 0) {
+        debug_block({ std::printf("WSIGHT0 %d %u %d %c %llu\n", world.round, my_handle(), n, static_cast<char>(decision), static_cast<unsigned long long>(spent_from - fuel())); });
+        return 0;
+    }
+    const std::uint64_t floor = std::max(need, fuel() - std::min<std::uint64_t>(fuel(), reveal_grow_fuel));
+    if ((any_within(map.bushes, here, 1) && !map.find_bush_clusters(here, 1, floor))
+        || (in_bounds(memory.ward) && test(map.bushes, memory.ward) && !map.find_bush_clusters(memory.ward, 0, floor))) {
+        note_shortcut("walk-sight-no-bushes-clusters");
+        return 0;
+    }
+    if (!fuel_ok(need)) {
+        note_shortcut("walk-sight-fuel");
+        return 0;
+    }
+    static bitboard near{cambc::uninitialized}, far{cambc::uninitialized}, sight{cambc::uninitialized};
+    sight_bands(map, memory, here, vision_radius + 1, near, far, sight);
+    EnemyMass mass;
+    enemy_mass(world, near, far, mass);
+    ward_sight_from(map, first, vision_radius, sight);
+    const float base = info_value(sight, first, vision_radius, near, far, mass);
+    float best = base;
+    int pick = 0;
+    for (int i = 0; i < m; ++i) {
+        if (!fuel_ok(act_reserve + walk_sight_candidate_cost)) {
+            note_shortcut("walk-sight-fuel");
+            break;
+        }
+        const int k = alt[static_cast<std::size_t>(i)];
+        const vec2 t = steps[static_cast<std::size_t>(k)];
+        ward_sight_from(map, t, vision_radius, sight);
+        if (const float v = info_value(sight, t, vision_radius, near, far, mass, best); v > best) best = v, pick = k;
+    }
+    debug_block({
+        std::printf("WSIGHT %d %u %d %d %d %c %.1f %llu\n", world.round, my_handle(), n, m, pick, static_cast<char>(decision), best - base,
+                    static_cast<unsigned long long>(spent_from - fuel()));
+    });
+    return pick;
+}
