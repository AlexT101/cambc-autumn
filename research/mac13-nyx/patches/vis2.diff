+float info_value(const bitboard& sight, vec2 w, int r, const bitboard& near, const bitboard& far, const EnemyMass& mass,
+                 float skip = -1) {
+    float value = static_cast<float>(band_count(sight, w, r, near, far));
+    if (mass.n >= 2 && skip >= 0)
+        if (const float bound = value + mass.total * static_cast<float>(band_count(sight, w, r, mass.any_near(), mass.any_far())); bound <= skip)
