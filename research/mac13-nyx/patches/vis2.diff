+void enemy_mass(const World& world, const bitboard& near, const bitboard& far, EnemyMass& out) {
+    auto& boards = EnemyMass::boards();
+    const std::size_t entries = std::min<std::size_t>(world.enemies.size(), out.weight.size());
+    while (boards.size() < 2 * entries + 2) boards.emplace_back(cambc::uninitialized);
+    out.n = 0;
+    out.total = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.visible || !e.tracked) continue;
+        int same = -1;
+        for (int i = 0; i < out.n && e.lineage; ++i)
+            if (out.lineage[static_cast<std::size_t>(i)] == e.lineage) same = i;
+        if (same < 0 && out.n == static_cast<int>(entries)) continue;
+        bool empty = false;
+        if (same < 0) {
+            auto& f = boards[static_cast<std::size_t>(2 * out.n + 1)];
+            and_into(e.possible, far, f);
+            empty = board_empty(f);
+        }
+        if (empty) continue;
+        const float w = enemy_info_mass / static_cast<float>(board_count(e.possible));
+        out.total += w;
+        if (same >= 0) {
+            out.weight[static_cast<std::size_t>(same)] += w;
+            continue;
+        }
+        and_into(e.possible, near, boards[static_cast<std::size_t>(2 * out.n)]);
+        out.weight[static_cast<std::size_t>(out.n)] = w;
+        out.box[static_cast<std::size_t>(out.n)] = &e.possible_box;
+        out.lineage[static_cast<std::size_t>(out.n)] = e.lineage;
+        ++out.n;
+    }
+    if (out.n < 2) return;
+    auto& un = boards[boards.size() - 2];
+    auto& uf = boards[boards.size() - 1];
+    copy_into(boards[0], un);
+    copy_into(boards[1], uf);
+    for (int i = 1; i < out.n; ++i) {
+        un |= boards[static_cast<std::size_t>(2 * i)];
+        uf |= boards[static_cast<std::size_t>(2 * i + 1)];
+    }
