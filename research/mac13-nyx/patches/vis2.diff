+    // An excludes-walking cast forbids the walk (rules abilities.exclusive): a refused move throws (~3.9k).
+    for (int s = 0; s < 2; ++s)
+        if (turn_acts.casts[s] && world.me().facts().abilities[s].excludes_walking) return false;
+    const auto& map = world.map();
+    const vec2 here = my_position();
+    bool hold = false, own = false;
+    if (group >= 0) {
+        const auto& c = world.camps[group];
+        if (c.state == CampState::cleared) hold = true;
+        else if (c.state == CampState::respawning) own = c.respawn_round > world.round + 1;
+        else return false;
+    }
+    const int on = here.x < 0 ? -1 : map.group_at(here);
+    if (here.x < 0 || (hold ? on != group : on >= 0 && (on != group || !own))) return false;
+    const bool in_bush = test(map.bushes, here);
+    std::array<vec2, 8> candidates;
+    int n = 0;
+    for (const auto d : directions) {
+        const vec2 t = here + d;
+        if (!in_bounds(t) || !test(stands, t)) continue;
+        // standable leaves out every camp tile; open_for_us has a dead camp's.
+        const int g = map.group_at(t);
+        if (hold ? g != group || !test(map.open_for_us, t)
+                 : g >= 0 ? g != group || !own || !test(map.open_for_us, t) : !test(map.standable, t))
+            continue;
+        if (test(pathing.blocked(), t)) continue;
+        // Out of our bush we are in sight from outside it again (vision.occlusion): no sight is worth that.
+        if (in_bush && !test(map.bushes, t)) continue;
+        candidates[static_cast<std::size_t>(n++)] = t;
+    }
+    if (n == 0) return false;
+    const std::uint64_t need = end_reserve + stand_cost + static_cast<std::uint64_t>(n) * stand_candidate_cost;
+    if (!fuel_ok(need)) {
+        note_shortcut("stand-fuel");
+        return false;
+    }
+    const std::uint64_t floor = std::max(need, fuel() - std::min<std::uint64_t>(fuel(), reveal_grow_fuel));
