diff -ruN bots/variants/vlx/src/combat/hunt.cc bots/variants/hunt/src/combat/hunt.cc
--- bots/variants/vlx/src/combat/hunt.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/hunt/src/combat/hunt.cc	2026-11-13 05:35:05.650359127 +0000
@@ -0,0 +1,120 @@
+#include "hunt.h"
+#include <algorithm>
+#include "../bot_parts.h"
+
+namespace aph::hunt {
+
+namespace {
+
+// The gems a kill of e hands over, as prey prices it: the life (life_value in gems), both bags of a
+// linked pair, and a cleared group it holds, when we see it on one.
+float kill_gems(const World& world, const ChampionBelief& e, bool seen) {
+    int held = 0;
+    if (seen) {
+        const int g = world.map().group_at(e.pos);
+        held = g >= 0 && world.camps[g].state == CampState::cleared ? world.map().groups[g].gems : 0;
+    }
+    return params::life_value / params::gem_value + static_cast<float>(pair_gems(world, e) + held);
+}
+
+// Those gems per point of effective health, at `health`.
+float worth(const World& world, const ChampionBelief& e, float health, bool seen) {
+    return kill_gems(world, e, seen) * e.taken / std::max(1.0f, health + (seen ? e.shield : 0.0f));
+}
+
+// In our sight and prey for an ally out of its range (preyable's test from afar): off its spawn's
+// edge, not teleporting away, and hurt, carrying a bag, holding a cleared group or on our ground.
+bool huntable(const World& world, const ChampionBelief& e) {
+    if (!e.alive || !e.visible || e.teleport_pending() || test(world.map().near_enemy_spawn, e.pos)) return false;
+    if (e.health < params::hurt_health_fraction * e.max_health || pair_gems(world, e) > 0) return true;
+    if (const int g = world.map().group_at(e.pos); g >= 0 && world.camps[g].state == CampState::cleared) return true;
+    // Not built here: it is a field, and a turn's end has little fuel to spare.
+    return world.map().from_ally_spawn_ready() && own_ground(world, e.pos);
+}
+
+struct Answered {
+    int round = -1;
+    Answer answer;
+    bool drawn = false;
+};
+Answered answered_;
+bitboard tiles_{cambc::uninitialized};
+
+} // namespace
+
+std::optional<Post> post(const World& world, const comms::Call& current) {
+    const ChampionBelief* best = nullptr;
+    float most = 0;
+    for (const auto& e : world.enemies)
+        if (huntable(world, e))
+            if (const float w = worth(world, e, e.health, true); !best || w > most) best = &e, most = w;
+    const bool fresh = comms::call_fresh(current, world.round) && world.enemies[static_cast<std::size_t>(current.enemy)].alive;
+    const auto* called = fresh ? &world.enemies[static_cast<std::size_t>(current.enemy)] : nullptr;
+    if (!best) {
+        // Withdrawn once we see it no longer worth hunting.
+        if (called && called->visible && !huntable(world, *called)) return Post{};
+        return std::nullopt;
+    }
+    if (called && called != best) {
+        const float theirs = called->visible ? (huntable(world, *called) ? worth(world, *called, called->health, true) : 0.0f)
+                                             : worth(world, *called, current.health * called->max_health, false);
+        if (theirs >= most) return std::nullopt;
+    }
+    return Post{best->index, best->health / std::max(1.0f, best->max_health)};
+}
+
+const ChampionBelief* answerable(const World& world, vec2 here, std::uint32_t skip, Answer& out) {
+    const auto& c = comms::call();
+    const int round = world.round;
+    if (!comms::call_fresh(c, round)) return nullptr;
+    const auto& e = world.enemies[static_cast<std::size_t>(c.enemy)];
+    if (!e.alive || e.visible || (skip >> e.index & 1)) return nullptr;
+    if (e.tracked && e.fixed.round >= c.round) return nullptr; // our own picture is as new
+    // A chase would cost a channel, a capture or the winning bag's trip.
+    if (channelling() || winning_bag(world)) return nullptr;
+    if (in_bounds(here))
+        if (const int g = world.map().group_at(here); g >= 0 && world.camps[g].state == CampState::cleared) return nullptr;
+    const int age = round - c.round;
+    // Its turns since: one later in the post's round, and one each round after.
+    const int spread = c.half + age + 1;
+    // Walking towards it until its nearest tile is in our sight must fit in the rounds the call stays fresh.
+    if (std::max(0, dist(here, c.at) - spread - vision_radius) > params::track_horizon - c.half - age) return nullptr;
+    out = {&e, c.at, c.health * e.max_health, spread};
+    return &e;
+}
+
+void answered(const World& world, const Answer& a) {
+    answered_ = {world.round, a, false};
+    debug_block({
+        std::printf("HUNT-ANS %d %u %d %d %d\n", world.round, my_handle(), a.target->index, dist(my_position(), a.at), world.round - comms::call().round);
+    });
+}
+
+const bitboard* tiles_of(const World& world, const ChampionBelief& target) {
+    auto& s = answered_;
+    if (s.round != world.round || s.answer.target != &target) return nullptr;
+    if (!s.drawn) {
+        clear_board(tiles_);
+        draw_square(tiles_, s.answer.at, static_cast<float>(s.answer.spread));
+        s.drawn = true;
+    }
+    return &tiles_;
+}
+
+void trace(const World& world) {
+    debug_block({
+        static std::array<int, 8> last{-1, -1, -1, -1, -1, -1, -1, -1};
+        static std::array<bool, 8> alive{true, true, true, true, true, true, true, true};
+        if (answered_.round == world.round - 1 && answered_.answer.target) last[static_cast<std::size_t>(answered_.answer.target->index & 7)] = world.round - 1;
+        for (const auto& e : world.enemies) {
+            if (e.index >= 8) continue;
+            auto& was = alive[static_cast<std::size_t>(e.index)];
+            const int l = last[static_cast<std::size_t>(e.index)];
+            if (was && !e.alive && l >= 0 && world.round - l <= 2 * params::track_horizon + 2)
+                std::printf("HUNT-KILL %d %u %d %d\n", world.round, my_handle(), e.index, world.round - l);
+            was = e.alive;
+        }
+    });
+}
+
+} // namespace aph::hunt
diff -ruN bots/variants/vlx/src/combat/hunt.h bots/variants/hunt/src/combat/hunt.h
--- bots/variants/vlx/src/combat/hunt.h	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/hunt/src/combat/hunt.h	2026-11-13 05:34:40.857033238 +0000
@@ -0,0 +1,45 @@
+// Hunt calls: a champion that sees an enemy worth hunting posts it in the team's one call
+// (comms::Call); an ally that does not see it adds it to prey's candidates, and chases only when
+// the fight simulation says the trade is not lost, as for any prey. Only offence reads the call:
+// an older experiment that fed sightings into the safety model lost, champions giving way to
+// enemies they could not see. So the call never touches a belief, and Safety's threats, want_home,
+// farm and crew read the world as they would without it; the one simulation that fights the
+// target gets it as an argument (Safety::chase_trade's `called`).
+#pragma once
+#include <optional>
+#include "../model/comms.h"
+#include "../model/world.h"
+
+namespace aph {
+class Safety;
+}
+
+namespace aph::hunt {
+
+// What comms::send posts as the call this turn: an enemy in our sight and its health share, or a
+// clear (enemy -1); nullopt leaves the call as it is.
+struct Post {
+    int enemy = -1;
+    float health = 1;
+};
+std::optional<Post> post(const World& world, const comms::Call& current);
+
+// The call as prey's candidate: its target, where it was posted, its health then (at most), and how
+// far it may have walked from there since.
+struct Answer {
+    const ChampionBelief* target = nullptr;
+    vec2 at{-1, -1};
+    float health = 0;
+    int spread = 0;
+};
+// The fresh call's target when we answer it, else null: one we do not see (nor have in `skip`, by
+// index) and know no newer of, while we are free to chase and near enough to find it in time.
+const ChampionBelief* answerable(const World& world, vec2 here, std::uint32_t skip, Answer& out);
+// prey's pick this turn is the call's target: chase walks to the tiles it could be on.
+void answered(const World& world, const Answer& a);
+// The tiles the target prey answered this turn could be on, if `target` is it; else null.
+const bitboard* tiles_of(const World& world, const ChampionBelief& target);
+// Debug builds: deaths of enemies we answered a call on.
+void trace(const World& world);
+
+} // namespace aph::hunt
