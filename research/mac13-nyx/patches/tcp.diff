+// A posted member's group and its index in it.
+std::pair<int, int> member_of(const Layout& L, int m) {
+    const int g = static_cast<int>(std::upper_bound(L.member_offset.begin(), L.member_offset.end(), m) - L.member_offset.begin()) - 1;
+    return {g, m - L.member_offset[static_cast<std::size_t>(g)]};
