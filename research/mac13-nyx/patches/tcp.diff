+// A live member's health in steps of its max, rounded up: 0 only when dead.
+int steps_of(float health, float max_health) {
+    if (!(health > 0)) return 0;
+    // Float error rounds up at worst, the safe side of a bound.
+    return std::clamp(static_cast<int>(std::ceil(health * camp_health_steps / max_health)), 1, camp_health_steps);
+}
+
+// The group's told healths, cleared for a new life.
+std::uint8_t* told_health(const Layout& L, const World& world, int g) {
+    auto& life = told_.health_life[static_cast<std::size_t>(g)];
+    auto* told = told_.health.data() + L.member_offset[static_cast<std::size_t>(g)];
+    if (life != world.camp_returns[static_cast<std::size_t>(g)]) {
+        life = world.camp_returns[static_cast<std::size_t>(g)];
+        std::fill(told, told + L.members(g), static_cast<std::uint8_t>(camp_health_steps));
+    }
+    return told;
+}
+
+std::uint8_t& told_hold(const World& world, int g) {
+    auto& life = told_.hold_life[static_cast<std::size_t>(g)];
+    auto& told = told_.hold[static_cast<std::size_t>(g)];
+    if (life != world.camp_returns[static_cast<std::size_t>(g)]) life = world.camp_returns[static_cast<std::size_t>(g)], told = 0;
+    return told;
+}
+
+// A cleared group's hold as a code, or -1 when its start cannot be posted.
+int hold_code(const CampBelief& c, int round) {
+    if (!c.holder) return 0;
+    if (c.held_since < 0 || c.held_since > round || c.held_since < round - (hold_period - 2)) return -1;
+    return (*c.holder == team::ally ? 1 : 1 + hold_period) + c.held_since % hold_period;
+}
+
+// One slot's news, posted in its round, which a reader dates to `seen`: no later than that.
+void apply(World& world, const Layout& L, int code, int seen) {
+    const int round = world.round;
+    if (code < L.cleared_base) {
+        const auto [g, respawn] = decode_capture(L, code - 1);
+        ++read_count[respawn_kind];
+        applied_count[respawn_kind] += world.note_capture(g, respawn);
+        return;
+    }
+    // Dated from our previous turn: one we never took tells nothing of when.
+    if (state.last_round < 0) return;
+    if (L.cleared_on && code < L.health_base) {
+        const int g = (code - L.cleared_base) / hold_codes, hold = (code - L.cleared_base) % hold_codes;
+        if (g >= L.groups) return;
+        ++read_count[cleared_kind];
+        std::optional<team> holder;
+        int since = -1;
+        if (hold > 0) {
+            // The hold's start is exact only within hold_period of a post made since last round.
+            if (seen < round - 1) return;
+            holder = hold <= hold_period ? team::ally : team::enemy;
+            since = round - ((round - (hold - 1) % hold_period) % hold_period + hold_period) % hold_period;
+        }
+        applied_count[cleared_kind] += world.note_cleared(g, holder, since, seen);
+        if (world.camps[static_cast<std::size_t>(g)].state == CampState::cleared) told_hold(world, g) = static_cast<std::uint8_t>(1 + hold);
+        return;
+    }
+    if (L.health_on && code < L.codes) {
+        const int m = (code - L.health_base) / camp_health_steps, steps = (code - L.health_base) % camp_health_steps;
+        const auto [g, i] = member_of(L, m);
+        if (g < 0 || g >= L.groups) return;
+        ++read_count[health_kind];
+        const auto& member = world.map().groups[static_cast<std::size_t>(g)].members[static_cast<std::size_t>(i)];
+        const float bound = static_cast<float>(steps) * member.max_health / camp_health_steps;
+        applied_count[health_kind] += world.note_member_health(g, i, bound, seen);
+        // Health only falls within a life: of two posts read together, the lower is the later.
+        if (world.camps[static_cast<std::size_t>(g)].state == CampState::alive) {
+            auto& told = told_health(L, world, g)[i];
+            told = std::min(told, static_cast<std::uint8_t>(steps));
+        }
+    }
+}
