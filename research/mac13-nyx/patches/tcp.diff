+// Our news for the free event slots, most useful first: respawns seen, then holds of cleared groups
+// in view, then live members' health drops in view, larger ones and richer groups first.
+int gather_news(World& world, const Layout& L, int room, std::array<std::uint64_t, max_slots>& news,
+                std::array<std::uint32_t, max_slots>& kind_of) {
+    const int round = world.round;
+    const auto& groups = world.map().groups;
+    int n = 0;
+    world.each_respawning([&](int g) {
+        if (g >= L.groups) return true;
+        auto& c = world.camps[g];
+        if (c.respawn_round <= round || c.told_respawn == c.respawn_round) return false;
+        // Seen respawning, not inferred from a hold out of sight.
+        if (c.state_round + groups[g].respawn < c.respawn_round) return false;
+        news[n] = static_cast<std::uint64_t>(1 + L.camp_offset[static_cast<std::size_t>(g)] + c.respawn_round % L.period(g));
+        kind_of[n++] = static_cast<std::uint32_t>(g) << 2 | respawn_kind;
+        return n == room;
+    });
+    if (n == room || !L.cleared_on) return n;
+    const auto& view = world.groups_in_view();
+    for (std::size_t w = 0; w < view.size() && n < room; ++w)
+        for (std::uint64_t bits = view[w]; bits && n < room; bits &= bits - 1) {
+            const int g = static_cast<int>(64 * w) + __builtin_ctzll(bits);
+            if (g >= L.groups) break;
+            const auto& c = world.camps[static_cast<std::size_t>(g)];
+            if (c.state != CampState::cleared || c.state_round != round) continue;
+            // The hold read at our turn's start, unless our own move onto or off its tiles changed it since.
+            const auto& tiles = groups[static_cast<std::size_t>(g)].tiles();
+            const vec2 now = my_position();
+            if ((in_bounds(now) && test(tiles, now)) != test(tiles, world.turn_start)) continue;
+            const int hold = hold_code(c, round);
+            if (hold < 0 || told_hold(world, g) == 1 + hold) continue;
+            news[n] = static_cast<std::uint64_t>(L.cleared_base + g * hold_codes + hold);
+            kind_of[n++] = static_cast<std::uint32_t>(g) << 2 | cleared_kind;
+        }
+    if (n == room || !L.health_on) return n;
+    // The best drops by steps x (1 + gems), kept in a short list.
+    std::array<int, max_slots> score{};
+    const int first = n;
+    for (std::size_t w = 0; w < view.size(); ++w)
+        for (std::uint64_t bits = view[w]; bits; bits &= bits - 1) {
+            const int g = static_cast<int>(64 * w) + __builtin_ctzll(bits);
+            if (g >= L.groups) break;
+            const auto& c = world.camps[static_cast<std::size_t>(g)];
+            const auto& G = groups[static_cast<std::size_t>(g)];
+            if (c.state != CampState::alive || c.state_round != round || G.gems + G.gold <= 0) continue;
+            const auto* told = told_health(L, world, g);
+            for (int i = 0; i < L.members(g); ++i) {
+                if (c.health_round[static_cast<std::size_t>(i)] != round) continue;
+                const int steps = steps_of(c.health[static_cast<std::size_t>(i)], G.members[static_cast<std::size_t>(i)].max_health);
+                if (steps >= told[i]) continue;
+                const int value = (told[i] - steps) * (1 + G.gems);
+                // Insert, dropping the worst once full.
+                int at = n;
+                while (at > first && score[static_cast<std::size_t>(at - 1)] < value) --at;
+                if (at >= room) continue;
+                for (int k = std::min(n, room - 1); k > at; --k)
+                    news[k] = news[k - 1], kind_of[k] = kind_of[k - 1], score[static_cast<std::size_t>(k)] = score[static_cast<std::size_t>(k - 1)];
+                news[at] = static_cast<std::uint64_t>(L.health_base + (L.member_offset[static_cast<std::size_t>(g)] + i) * camp_health_steps + steps);
+                kind_of[at] = static_cast<std::uint32_t>(L.member_offset[static_cast<std::size_t>(g)] + i) << 2 | health_kind;
+                score[static_cast<std::size_t>(at)] = value;
+                n = std::min(n + 1, room);
+            }
+        }
+    return n;
+}
