+const bitboard* duel_tiles(const World& world, Safety& safety, vec2 here, int radius, bitboard& out) {
+    if (world.me().facts().passive != Passive::gem_focus) return nullptr;
+    bool any = false;
+    for (auto left = safety.seen_enemies(); left; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (!in_square(here, e.pos, Strike::max_reach + radius) || duel_burst(world, e) <= 0) continue;
+        const float now = safety.blow(e, here).damage;
+        for (int dy = -radius; dy <= radius; ++dy)
+            for (int dx = -radius; dx <= radius; ++dx)
+                if (const vec2 q{here.x + dx, here.y + dy}; in_bounds(q) && q != here && safety.blow(e, q).damage > now) {
+                    if (!any) clear_board(out), any = true;
+                    set_tile(out, q);
+                }
+    }
+    return any ? &out : nullptr;
+}
+// `a` with `b`, in `out`.
+const bitboard* union_of(const bitboard* a, const bitboard* b, bitboard& out) {
+    if (!a || !b) return a ? a : b;
+    copy_into(*a, out);
+    out |= *b;
+    return &out;
+}
