+float duel_burst(const World& world, const ChampionBelief& e) {
+    const auto& me = world.me();
+    if (e.facts().passive != Passive::gem_focus || me.facts().passive != Passive::gem_focus || !e.alive || !me.alive) return 0;
+    if ((!e.visible && e.pos_round < world.round - 1) || e.focus <= me.focus) return 0;
+    // Stunned by us, it has no turn before ours: the duel waits.
+    if (e.visible && turns_before_ours(world, e) == 0) return 0;
+    // Two turns from `round`: the damaging slots ready by the later, and a basic attack each (a cast
+    // spends neither the attack nor, for a ranged champion, anything a basic needs).
+    const auto two_turns = [](const ChampionBelief& c, int round) {
+        float m = 0;
+        for (int s = 0; s < 2; ++s)
+            if (const auto& a = c.facts().abilities[s]; a.kind == AbilityKind::damage && c.ability_ready(s, round + 1)) m += a.multiplier;
+        return m * hit_focus(c) + 2 * hit_strength(c);
+    };
+    const float theirs = two_turns(e, next_turn_round(world, e));
+    if (theirs < effective_hp(me) || two_turns(me, world.round) >= effective_hp(e)) return 0;
+    return theirs;
+}
