+        debug_block({ if (m.escapes) std::printf("HUNTESC %d %u\n", world.round, my_handle()); });
+    }
+    return m.escapes ? nullptr : h;
+}
+
+// Set while a hunt converges this turn (chase_aim's aim or chase's target): posted as our chase bit.
+bool hunt_engaged = false;
+// Set by decide's hunt chase: prey offers the hunt's Prism alone.
