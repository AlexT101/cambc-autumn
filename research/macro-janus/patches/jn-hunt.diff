+                break;
+            }
+        }
+        if (!alone || !hunt_force(world, pathing, e) || pack_covers(world, safety, e.pos, range)) continue;
+        best = &e;
+    }
+    if (best) {
+        m.target = best->index;
+        debug_block({
+            std::printf("HUNT %d %u %u %d %.0f %.0f\n", world.round, my_handle(), static_cast<std::uint32_t>(best->handle),
+                        dist(here, best->pos), effective_hp(*best), best->focus);
+        });
+    }
+    return best;
+}
+
+// The hunt we take: hunt_prism's Prism unless, in sight, it walks home clear of our team (escapes, the
