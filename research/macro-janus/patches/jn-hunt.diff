+// The hunt (research: the team whose Prism dies first loses 90% of mirror games, and a Prism alone
+// near 2+ of us died within 15 rounds only 10% of the time, for reinforcements seldom join).
+constexpr int hunt_isolation = 6; // no other enemy this near the Prism
+constexpr int hunt_reach = 10;    // the allies that converge: within this of it
+// A first Prism death costs its team ~2x what any other champion's does (the same mirror games).
+constexpr float prism_life_worth = 2;
+
+// A told ally position counts while this recent, as capture.cc's recent_tile.
+constexpr int hunt_told_recent = 2;
+
+// What the enemy Prism's two turns do to one of us, by the rules: its stun (1.5x Focus) on one, its
+// ground spell (1x Focus, 3x3) on all of a group standing close, and a basic attack each turn.
+struct PrismBurst {
+    float area = 0, single = 0;
+    bool stuns = false;
+};
+PrismBurst prism_burst(const World& world, const ChampionBelief& e) {
+    PrismBurst b;
+    const auto& f = e.facts();
+    // A slot ready by its second turn is cast once.
+    const int by = next_turn_round(world, e) + 1;
+    for (int s = 0; s < 2; ++s) {
+        const auto& a = f.abilities[s];
+        if (a.kind != AbilityKind::damage || !e.ability_ready(s, by)) continue;
+        const float hit = a.multiplier * e.focus * e.scale;
+        if (a.target == Targeting::ground) b.area += hit;
+        else b.single += hit, b.stuns |= a.stuns;
+    }
+    b.single += b.area + 2 * e.strength * e.scale;
+    return b;
+}
+
+// One of the converging group: its body's health with its shield, the damage taken per point, its
+// first turn's and second turn's damage once in reach, and whether its death takes a linked partner too.
+struct Hunter {
+    float health, taken, first, second;
+    bool linked;
+};
+
+// Our champion c, at `at`, joins a hunt of enemy Prism e: alive, above the hurt line, no bag at stake a
+// kill would hand e (brake_bag, as the pack zone's hurt), not on a hold paying within 2 rounds, not held
+// by a channel (ours: not on a winning bag), Willow only early, our Prism only when e is the weaker.
+bool hunter_fit(const World& world, Pathing& pathing, const ChampionBelief& c, vec2 at, const ChampionBelief& e) {
+    if (!c.alive || c.health < params::hurt_health_fraction * c.max_health) return false;
+    if (c.facts().heals() && world.round >= params::willow_fight_until) return false;
+    if (c.facts().passive == Passive::gem_focus && !(e.focus < c.focus)) return false;
+    if (c.is_self) {
+        if (winning_bag(world) || bag_at_stake(world) >= params::brake_bag) return false;
+        const int r = hold_rounds(world, pathing, at);
+        return r < 0 || r > 2;
+    }
+    if (held_by_channel(c) || (c.visible ? c.gems : comms::bag_of(world, c.index)) >= params::brake_bag) return false;
+    if (const int g = world.map().group_at(at); g >= 0) {
+        const auto& camp = world.camps[g];
+        if (camp.state == CampState::cleared && camp.holder == team::ally && camp.held_since >= 0 && camp.payout_round() - world.round <= 2)
+            return false;
+    }
+    return true;
+}
+
+// Whether the group that can converge on enemy Prism e kills it: us within hunt_reach, and fit allies
+// that can see it (within vision_radius, or hunt_reach while they post a chase) - an ally farther off
+// does not see it and stays away. At least two; two turns of their damage, less the turn its stun takes
+// and the hunter its burst kills, reach its health with its shield; the burst kills at most one of them
+// (Cassi and Issac count two).
+bool hunt_force(const World& world, Pathing& pathing, const ChampionBelief& e) {
+    Unwritten<Hunter, 8> scratch;
+    auto& group = scratch.a;
+    int n = 0;
+    const auto add = [&](const ChampionBelief& c, vec2 at, int turn_round, int reach) {
+        if (n == static_cast<int>(group.size()) || dist(at, e.pos) > reach || !hunter_fit(world, pathing, c, at, e)) return;
+        group[n++] = {c.health + c.shield, c.taken, strike(c, turn_round).at(0), strike_with(c, 0u).at(0), c.facts().passive == Passive::linked_pair};
+    };
+    add(world.me(), my_position(), world.round, hunt_reach);
+    if (n == 0) return false;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive) continue;
+        vec2 at = a.pos;
+        if (!a.visible) {
+            vec2 told_at{-1, -1};
+            int told = -1;
+            if (params::comms_ally && comms::told_ally(a.index, told_at, told) && told >= world.round - hunt_told_recent && told > a.pos_round)
+                at = told_at;
+            else if (!(a.pos_source == Source::seen && a.pos_round >= world.round - hunt_told_recent && in_bounds(a.pos)))
+                continue;
+        }
+        add(a, at, next_turn_round(world, a), comms::ally_chasing(world, a) ? hunt_reach : vision_radius);
+    }
+    if (n < 2) return false;
+    const auto burst = prism_burst(world, e);
+    int kills = 0, single = 0, victim = -1;
+    for (int i = 0; i < n; ++i) {
+        const auto& h = group[i];
+        const int bodies = h.linked ? 2 : 1;
+        if (h.health <= burst.area * h.taken) kills += bodies, victim = i;
+        // Of those it kills alone, the one whose loss costs us most.
+        else if (h.health <= burst.single * h.taken
+                 && (bodies > single || (bodies == single && victim >= 0 && h.first + h.second > group[victim].first + group[victim].second)))
+            single = bodies, victim = kills ? victim : i;
+    }
+    if (kills + single >= 2) return false;
+    // Its stun lands on the victim it kills alone; else on whoever's first turn is worth most.
+    const bool stun_free = burst.stuns && single == 0;
+    float damage = 0, stunned = 0;
+    for (int i = 0; i < n; ++i) {
+        if (i == victim) continue;
+        damage += group[i].first + group[i].second;
+        stunned = std::max(stunned, group[i].first);
+    }
+    if (stun_free) damage -= stunned;
+    return damage >= effective_hp(e);
+}
+
+// An enemy Prism we see (or saw last round) that our team converges on: off its spawn's edge, no other
