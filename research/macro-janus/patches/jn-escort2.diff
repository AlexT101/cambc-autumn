+// The escort partner when the protected mate has no healer: the ally with the most base health among
+// melee champions, else among all; found once, as support_pair is.
+inline const ChampionBelief* escort_partner(const World& world) {
+    static int index = -2;
+    if (index == -2) {
+        index = -1;
+        const auto pair = support_pair(world);
+        if (params::escort_partner && pair[0] && !pair[1]) {
+            float best = -1;
+            bool best_melee = false;
+            for (int i = 0; i < static_cast<int>(world.allies.size()); ++i) {
+                const auto& a = world.allies[i];
+                if (&a == pair[0] || a.type == cambc::champion_type::issac) continue;
+                const bool melee = a.facts().walk_and_attack_independent();
+                const float h = a.facts().health.base;
+                if ((melee && !best_melee) || (melee == best_melee && h > best)) index = i, best = h, best_melee = melee;
+            }
+        }
+    }
+    return index >= 0 ? &world.allies[index] : nullptr;
+}
+
