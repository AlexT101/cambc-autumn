+// The escort partner (no heals, so none of Willow's caution): with an enemy in sight and the Prism
+// seen farther than Willow's follow distance, it walks back within that distance of the Prism. It also
+// converges on a Prism within 10 (seen, or as told) with an enemy seen within 8 of it, unless it holds
+// a capture that pays within 2 rounds.
+bool escort_follow(World& world, Pathing& pathing, Safety& safety) {
+    constexpr int follow_dist = 2, converge_dist = 10, threat_dist = 8, payout_wait = 2;
+    const auto* partner = escort_partner(world);
+    if (!partner || !partner->is_self || !my_can_move() || stunned_turn) return false;
+    const auto* mate = support_endpoint(world, false);
+    if (!mate || !mate->alive) return false;
+    const vec2 here = my_position();
+    vec2 at{-1, -1};
+    bool seen = mate->visible && mate->pos.x >= 0;
+    if (seen) at = mate->pos;
+    else if (int told = -1; params::comms_ally && comms::told_ally(mate->index, at, told) && told >= world.round - 6
+                            && told > mate->pos_round) {
+    } else return false;
+    if (at.x < 0 || test(world.map().ally_spawn, at) || dist(here, at) <= follow_dist) return false;
+    bool enemy = false, threat = false;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible) continue;
+        enemy = true;
+        threat |= e.pos.x >= 0 && dist(e.pos, at) <= threat_dist;
+    }
+    if (!(seen && enemy)) {
+        if (!threat || dist(here, at) > converge_dist) return false;
+        if (holding_capture(world, pathing)) {
+            const int g = world.map().group_at(here);
+            if (g >= 0 && world.camps[g].held_since >= 0 && world.camps[g].payout_round() - world.round <= payout_wait) return false;
+        }
+    }
+    const bitboard goals = within(world.map().open_for_us, at, follow_dist);
+    if (board_empty(goals)) return false;
+    world.throw_if_stale();
+    if (!pathing.step_towards(goals)) return false;
+    see_revealed(world, pathing, safety);
+    decision = Branch::willow_support;
+    return true;
+}
