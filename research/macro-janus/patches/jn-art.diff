+int free_camp_cast(const World& world, int target, bool wake_target, float spare_health, std::uint64_t reserve) {
+    world.throw_if_stale();
+    const auto& me = world.me();
+    const auto& f = me.facts();
+    // An enemy in sight may yet bring the fight the stunning slot is kept for. A spent basic attack
+    // left no walk to give up (and camp_cast would redirect a unit cast past our filters).
+    if (f.passive != Passive::gem_focus || !my_can_cast() || !my_can_move() || !my_can_attack() || cast_walked(world) || enemy_seen(world))
+        return -1;
+    const std::array<bool, 2> ready{castable(world, 0), castable(world, 1)};
+    if (!ready[0] && !ready[1]) return -1;
+    const vec2 here = my_position();
+    // camp_cast's hold for visible enemies, once rather than per group.
+    if (engagement_near(world, here, f.cast_reach())) return -1;
+    const auto& map = world.map();
+    std::array<int, 16> near; // groups_near's vector is reused by camp_cast
+    int n = 0;
+    for (int g : map.groups_near(here, std::max(f.cast_reach(), map.max_camp_reach))) {
+        if (n == static_cast<int>(near.size())) break;
+        if (world.camps[g].state == CampState::alive) near[n++] = g;
+    }
+    if (n == 0) return -1;
+    // Standing for the cast takes another phase from every awake monster reaching us: only a cast
+    // at one of those groups repays it.
+    std::uint32_t firing = 0;
+    float fire = 0;
+    for (int k = 0; k < n; ++k) {
+        const auto& ms = map.groups[near[k]].members;
+        const auto& c = world.camps[near[k]];
+        for (std::size_t i = 0; i < ms.size(); ++i)
+            if (c.health[i] > 0 && ms[i].strength > 0 && !c.member_asleep(i) && dist(here, ms[i].pos) <= ms[i].reach)
+                firing |= 1u << k, fire += ms[i].strength;
+    }
+    if (fire * camp_hit_factor() >= spare_health) return -1;
+    const float dealt = camp_dealt_factor();
+    const float unit_raw = ready[0] && f.abilities[0].target == Targeting::unit ? raw_damage(0) * dealt
+                           : ready[1] && f.abilities[1].target == Targeting::unit ? raw_damage(1) * dealt : 0.0f;
+    const float ground_raw = ready[0] && f.abilities[0].target == Targeting::ground ? raw_damage(0) * dealt
+                             : ready[1] && f.abilities[1].target == Targeting::ground ? raw_damage(1) * dealt : 0.0f;
+    // A step is a round of our camp work: the cast must do more than that work, but on our own
+    // choice, where the walk only brings us into reach of what the cast does from here.
+    // On our choice the cast replaces the hit the walk would bring next turn.
+    const float step = camp_output(me), hit = me.strength * dealt;
+    const bool stun_unit = (ready[0] && f.abilities[0].target == Targeting::unit && f.abilities[0].stuns)
+                           || (ready[1] && f.abilities[1].target == Targeting::unit && f.abilities[1].stuns);
+    Cast best;
+    int best_group = -1, tried = 0;
+    for (int k = 0; k < n; ++k) {
+        if (firing && !(firing >> k & 1)) continue;
+        const int g = near[k];
+        const auto& G = map.groups[g];
+        const auto& c = world.camps[g];
+        if (G.has_monolith) continue;
+        const bool ours = g == target;
+        const bool sleeper = G.strength > 0 && !c.fully_awake();
+        bool ally_near = false, ally_exposed = false, claimed = false;
+        for (const auto& a : world.allies) {
+            if (a.is_self || !a.alive) continue;
+            claimed |= comms::claim_of(world, a.index) == g;
+            if (a.visible)
+                for (std::size_t i = 0; i < G.members.size(); ++i) {
+                    if (!(c.health[i] > 0)) continue;
+                    const int d = dist(a.pos, G.members[i].pos);
+                    ally_near |= d <= a.facts().attack_range();
+                    ally_exposed |= G.members[i].strength > 0 && d <= G.members[i].reach;
+                }
+        }
+        // An ally passing a sleeping group works nothing; waking it would fire on that ally.
+        if (sleeper && !ours && ally_exposed) continue;
+        const bool ally_works = ally_near && (!sleeper || ally_engaged(world, g));
+        // Hit lately with none of us on it: an unseen enemy's work.
+        if (!ours && !claimed && !ally_works && c.last_damaged_round >= world.round - 1) continue;
+        // Damage counts only on a group our team will finish (camps never regenerate).
+        if (!ours && !claimed && !ally_works && !(home_side(map, g, false) >= params::own_ground_share)) continue;
+        float unit_bound = 0, ground_bound = 0;
+        bool reaches = false;
+        for (std::size_t i = 0; i < G.members.size(); ++i) {
+            const auto& m = G.members[i];
+            if (!(c.health[i] > 0)) continue;
+            const int d = dist(here, m.pos);
+            // Within a step of its reach: our next walk may enter it.
+            reaches |= m.strength > 0 && d <= m.reach + 1;
+            if (d <= ability_range) unit_bound = std::max(unit_bound, std::min(unit_raw, c.health[i]) + (stun_unit ? m.strength : 0.0f));
+            if (d <= ability_range + ground_radius) ground_bound += std::min(ground_raw, c.health[i]);
+        }
+        // Waking strikers: ours only when the farm would wake it anyway; another only from out of its reach.
+        if (sleeper && (ours ? !wake_target : reaches)) continue;
+        const float floor = ours ? hit : step;
+        if (std::max(unit_bound, ground_bound) <= std::max(floor, best.value)) continue;
+        if (tried == max_free_cast_groups || !fuel_ok(reserve + free_cast_fuel)) break;
+        ++tried;
+        const Cast cast = camp_cast(world, g, false, false);
+        if (cast.slot < 0 || !(cast.value > floor) || cast.value <= best.value) continue;
+        best = cast, best_group = g;
+    }
+    if (best_group < 0) return -1;
+    try {
+        return execute_camp_cast(world, best) ? best_group : -1;
+    } catch (const cambc::error&) {
+        return -1;
+    }
+}
