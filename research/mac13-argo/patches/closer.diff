+
+// Closing. A winning bag whose channel outlasts tribute_window turns (any_risk) wins the game if the
+// channel completes, but any enemy stun, or a lock at its altar, cancels it with all its progress,
+// and a kill hands the enemy the bag. The closer picks the altar where the enemies' earliest arrival
+// leaves the most margin over our own arrival and the channel, and starts there once no enemy we
+// know of (in sight, or credible out of sight) could reach it before the channel ends. Until then it
+// stands at the altar, where its strikes and chases thin out what could stop it (a Prism's big bag
+// one-shots most bodies). Dead enemies and those we lost track of are no reason to wait: waiting only
+// brings the first nearer and tells nothing of the rest.
+
+// Steps from the enemy spawn to a tile within tribute range of altar a, by symmetry; per altar.
+int enemy_spawn_to_altar(const StaticMap& map, int a) {
+    static std::vector<int> steps;
+    if (steps.size() < map.altars.size()) steps.resize(map.altars.size(), -1);
+    if (steps[a] < 0) {
+        int best = unreachable;
+        const vec2 p = map.altars[a].pos;
+        for (int dx = -1; dx <= 1; ++dx)
+            for (int dy = -1; dy <= 1; ++dy)
+                if (const vec2 t{p.x + dx, p.y + dy}; (dx || dy) && in_bounds(t)) best = std::min(best, map.enemy_spawn_steps(t));
+        steps[a] = best;
+    }
+    return steps[a];
+}
+
+// Turns before enemy e could act on a tributer at altar a (`field`: to its tribute tiles), from
+// within its act range (its farthest damage or stun), capped at `cap`. In sight: its walk; out of
+// sight but credible: the box around the tiles it may be on, a bound below its walk; dead: its respawn
+// (it cannot act on that turn) and the walk from its spawn. -1 for one we lost track of.
+int enemy_arrival(const World& world, Safety& safety, const Field& field, int a, const ChampionBelief& e, int cap) {
+    const auto& map = world.map();
+    const vec2 alt = map.altars[a].pos;
+    const int act = enemy_reach::act_range(e.facts());
+    const auto walk_in = [&](int steps) { return steps >= static_cast<int>(unreachable) ? cap : std::clamp(steps - act, 0, cap); };
+    if (!e.alive) return std::min(cap, std::max(0, e.respawn_earliest - world.round) + 1 + walk_in(enemy_spawn_to_altar(map, a)));
+    if (e.visible) {
+        const vec2 from = enemy_reach::origin(e);
+        int steps = in_bounds(from) ? field.at(from) : static_cast<int>(unreachable);
+        if (steps == static_cast<int>(unreachable))
+            steps = in_bounds(from) && test(map.near_enemy_spawn, from) ? enemy_spawn_to_altar(map, a) : std::max(0, dist(from, alt) - 1);
+        return walk_in(steps);
+    }
+    if (!e.tracked || !safety.credible_unseen(e)) return -1;
+    const auto& b = e.possible_box;
+    if (b.x0 > b.x1) return cap;
+    const int d = std::max({b.x0 - alt.x, alt.x - b.x1, b.y0 - alt.y, alt.y - b.y1, 0});
+    return std::clamp(d - static_cast<int>(cambc::constants::submit_gems_range) - act, 0, cap);
