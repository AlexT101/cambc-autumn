+
+// Rounds before the enemy could win: a winning tribute we see it channel, else the gems it is short
+// at its recent tribute rate. A bag it carries scores only through a channel as easily stopped as
+// ours (one in sight is stopped by game_ender's logic), so it does not count until channelled.
+int enemy_clock(const World& world) {
+    constexpr int never = 1 << 20;
+    const int win = static_cast<int>(cambc::constants::winning_gems);
+    const int need = win - world.score.enemy;
+    int quickest = never;
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && e.channel == Channel::tribute && e.gems >= need)
+            quickest = std::min(quickest, std::max(0, e.channel_end_round - world.round));
+    if (quickest < never) return quickest;
+    const float rate = world.enemy_rate();
+    return need <= 0 ? 0 : rate > 0 ? static_cast<int>(static_cast<float>(need) / rate) : never;
