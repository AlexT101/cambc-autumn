+// Probe pb4-chunk: what the team holds towards the win, tributed and carried (an unseen ally's bag as
+// posted, as race_left_now reads it).
+int team_wealth(const World& world) {
+    static BagKey last;
+    static int kept = 0;
+    const BagKey key = bag_key(world);
+    if (key == last) return kept;
+    last = key;
+    int wealth = world.score.ally + static_cast<int>(my_gems());
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive) wealth += a.visible ? a.gems : comms::bag_of(world, a.index);
+    return kept = wealth;
+}
+
 // The rounds left in the game for a bag: to the round limit, and for ours to the race's end.
 int bag_rounds_left(const World& world) {
     return my_gems() > 0 ? std::min(rounds_left(world), race_left(world)) : rounds_left(world);
@@ -902,8 +916,13 @@
 }
 
 // Prism keeps the gems it carries or gains for their Focus, until its bag wins or the game closes.
+// Probe pb4-chunk: once the team is rich, a bag of a chunk is banked as any other body's: a short channel
+// converts far faster than one long final one under the stop hazard.
+constexpr int chunk_wealth = 700, chunk_bag = 300;
 bool keeps_gems(const World& world, Pathing& pathing) {
-    return world.me().facts().passive == Passive::gem_focus && !winning_bag(world) && !closing(world, pathing);
+    if (world.me().facts().passive != Passive::gem_focus || winning_bag(world)) return false;
+    if (static_cast<int>(my_gems()) >= chunk_bag && team_wealth(world) >= chunk_wealth) return false;
+    return !closing(world, pathing);
 }
 
 bool retaining_gems(const World& world, Pathing& pathing) { return my_gems() > 0 && keeps_gems(world, pathing); }
