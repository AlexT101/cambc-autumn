+// Probe pb2-avoid: the work guard with `avoid` in its place. Still deferred, it keeps the strike search's step
+// guard it read (a guard_work call again would place that guard anew).
+void reavoid_work(const World& world, Pathing& pathing, Safety& safety, float damage, const bitboard* avoid) {
+    if (pathing.held_guard().fn != work_guard) return guard_work(world, pathing, safety, damage, avoid);
+    if (avoid && test(*avoid, my_position())) avoid = nullptr;
+    work_guard_inputs.avoid = avoid;
+    pathing.defer_guard(work_guard, safety, my_position(), work_guard_inputs.radius, work_cover);
+}
