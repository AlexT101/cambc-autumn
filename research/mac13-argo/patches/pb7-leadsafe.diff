+// Probe pb2-avoid: as Prism out of a fight (no enemy struck or chased this turn or last), the tiles within an enemy
+// Prism's ready stun reach (else its attack range) + 2, for each one in sight or seen in the last avoid_recent
+// rounds with at least 0.7x our Focus (probe pb7-leadsafe: and only while our team holds the win between its score
+// and bags, team_wealth: a leader refuses even duels). From inside, only the tiles nearer it than ours: we may stay or back off.
+// Null if none. Kept for the round, observations and our tile.
+const bitboard* prism_avoid_zone(const World& world) {
+    constexpr int avoid_recent = 10;
+    const auto& self = world.me();
+    if (!self.alive || self.facts().passive != Passive::gem_focus || engaged || engaged_before
+        || team_wealth(world) < static_cast<int>(cambc::constants::winning_gems))
+        return nullptr;
+    static int round = -1;
+    static std::uint32_t seen = 0;
+    static vec2 at{-1, -1};
+    static bool any = false;
+    static bitboard out{cambc::uninitialized};
+    const vec2 here = my_position();
+    if (round == world.round && seen == world.observations && at == here) return any ? &out : nullptr;
+    round = world.round, seen = world.observations, at = here, any = false;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus || e.stats_round < 0 || !in_bounds(e.pos)) continue;
+        if (!e.visible && !(e.pos_source == Source::seen && world.round - e.pos_round <= avoid_recent)) continue;
+        if (!(e.focus >= 0.7f * self.focus)) continue;
+        int reach = e.ready_stun_reach(world.round + 1, true);
+        if (reach < 0) reach = e.facts().attack_range();
+        const int r = std::min(reach + 2, dist(here, e.pos) - 1);
+        if (r < 0) continue;
+        if (!any) clear_board(out), any = true;
+        out.draw_chebyshev(e.pos, static_cast<float>(r));
+    }
+    return any ? &out : nullptr;
+}
+
+// Probe pb2-avoid: a camp tile of group g lies in prism_avoid_zone.
+bool prism_avoids_group(const World& world, int g) {
+    const bitboard* zone = prism_avoid_zone(world);
+    if (!zone || g < 0) return false;
+    static bitboard both{cambc::uninitialized};
+    and_into(*zone, world.map().groups[g].tiles(), both);
+    return !board_empty(both);
+}
