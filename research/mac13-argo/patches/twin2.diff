diff -ruN bots/variants/chy-ref/src/economy/twin.cc bots/variants/twin2/src/economy/twin.cc
--- bots/variants/chy-ref/src/economy/twin.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/twin2/src/economy/twin.cc	2026-11-13 03:58:32.498340240 +0000
@@ -0,0 +1,116 @@
+// Cassi and Issac under threat (bot_parts.h Twin): while no enemy is credibly near either body each farms
+// as it would alone; once one is, a trip home of either takes the other home, the other comes to its
+// fight only where the two of us win it, and neither walks into the threat or opens a camp or hold alone.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// The round the mate's current trip home was first read, -1 while none is followed.
+int mate_home_since = -1;
+
+// How near a body must be to share the other's fight: Issac's melee target within Cassi's unit spells.
+int tether_range() { return std::max(1, ability_range - melee_range); }
+
+// A mate's trip home is followed for at most this long: a recall's channel and a walk we would see
+// end within it. Past it (the mate stuck in a retreat, or unseen) we work on rather than follow.
+int follow_home_rounds() { return static_cast<int>(cambc::constants::recall_time) + vision_radius; }
+
+// A recall of ours kept through a turn start, not the turn-end feint: by our own recall's length (a
+// Home emblem's is shorter).
+bool own_recall_kept(const World& world) { return kept_recall(world.me().handle, recall_turns(world)); }
+
+// An enemy may reach p soon: one in sight within its strike and threat_radius steps of walking, or an
+// unseen credible one within threat_radius turns (recall_line's test).
+bool threat_near(const World& world, Safety& safety, vec2 p) {
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && enemy_reach::within(world, e, enemy_reach::origin(e), p, Strike::max_reach + params::threat_radius)) return true;
+    return safety.may_reach_within(p, params::threat_radius);
+}
+
+bool mate_trip_home() { return twin.on && (twin.mate_trip == comms::trip_errand || twin.mate_trip == comms::trip_danger); }
+
+void twin_read(const World& world, Safety& safety) {
+    twin = {};
+    const auto& me = world.me();
+    const auto* p = linked_partner(world, me);
+    if (!p || !me.alive || !p->alive) {
+        mate_home_since = -1;
+        return;
+    }
+    twin.mate = p;
+    twin.mate_trip = comms::mate_home(*p);
+    const vec2 here = my_position();
+    const auto& spawn = world.map().ally_spawn;
+    // recall_line's own test, kept for the rest of the turn.
+    twin.threatened = in_bounds(here) && !test(spawn, here) && recall_line(world, safety, here) == params::recall_health_fraction;
+    const bool mate_threatened = twin.mate_trip == comms::trip_danger || twin.mate_trip == comms::trip_threat
+                                 || (p->visible && !test(spawn, p->pos) && threat_near(world, safety, p->pos));
+    twin.on = twin.threatened || mate_threatened;
+    // A recall we keep for the mate's trip home lands even once the mate is there.
+    if (!mate_trip_home() && !(mate_home_since >= 0 && own_recall_kept(world))) mate_home_since = -1;
+    else if (mate_trip_home() && mate_home_since < 0) mate_home_since = world.round;
+}
+
+bool twin_alone() {
+    return twin.mate && twin.on && twin.threatened
+           && !(twin.mate->visible && dist(my_position(), twin.mate->pos) <= safety_params::fight_ally_radius);
+}
+
+// want_home's last reason: under threat the mate goes home, and a death of either is both. Not off a
+// tribute or hold under way, nor a bag we can bank here, each worth more than going home a turn sooner.
+bool twin_follow_home(const World& world, Pathing& pathing) {
+    if (!twin.mate || mate_home_since < 0 || test(world.map().ally_spawn, my_position())) return false;
+    if (!mate_trip_home() || world.round - mate_home_since > follow_home_rounds()) {
+        // Unless the mate stopped short of home, in sight or as it posts: a one-turn retreat is no trip to land.
+        if (!own_recall_kept(world) || twin.mate->visible || twin.mate_trip == comms::trip_threat) return false;
+        twin.induced = true;
+        return true;
+    }
+    if (my_state().contains(cambc::champion_state::submitting_gems) || holding_capture(world, pathing)) return false;
+    if (can_tribute_here(world)) return false;
+    twin.induced = true;
+    return true;
+}
+
+// Beyond tether_range of the mate under threat: to its fight where the two of us win it (Safety::fight
+// counts the allies within fight_ally_radius of it). Camp fire alone makes no fight (a Trade with no
+// enemies is never lost).
+bool twin_tether(World& world, Pathing& pathing, Safety& safety) {
+    if (!twin.mate || !twin.on || !twin.mate->visible || !my_can_move()) return false;
+    const vec2 here = my_position(), at = twin.mate->pos;
+    if (!in_bounds(at) || !in_bounds(here)) return false;
+    const int d = dist(here, at), reach = tether_range(), cap = d + max_detour;
+    if (d <= reach) return false;
+    // The fight costs a few thousand fuel: read only with the walk to it funded.
+    if (!fuel_ok(search_cost_estimate(cap) + end_reserve + 8000) || !safety.threatened(at)) return false;
+    if (const Trade t = safety.fight(at); t.enemies == 0 || t.lost) return false;
+    static bitboard goals{cambc::uninitialized};
+    clear_board(goals);
+    draw_square(goals, at, static_cast<float>(reach));
+    goals &= world.map().standable;
+    set_tile(goals, at, false);
+    if (!pathing.step_towards(goals, nullptr, cap, at)) return false;
+    decision = Branch::farm;
+    debug_block({ std::printf("TWIN HELP %d %u d %d\n", world.round, my_handle(), d); });
+    return true;
+}
+
+// Our state for the mate: a trip home of our own (under threat or not), else whether we are threatened.
+// An induced trip is not posted as one, so the two never send each other home in turn.
+int twin_posts_home(const World& world) {
+    if (!twin.mate || !world.me().alive) return comms::trip_none;
+    const int stay = twin.threatened ? comms::trip_threat : comms::trip_none;
+    const int home = twin.threatened ? comms::trip_danger : comms::trip_errand;
+    switch (decision) {
+    // A retreat for want_home's reasons of ours: not a step off an altar or a fight's, which want_home flickers through.
+    case Branch::retreat: return twin.own_home ? home : stay;
+    case Branch::shop: case Branch::recall_kept: case Branch::capture_recall: return twin.own_home || !twin.induced ? home : stay;
+    default: return stay;
+    }
+}
+
+} // namespace
+
+} // namespace aph
