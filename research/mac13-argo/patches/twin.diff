+
+// economy/twin.cc: Cassi and Issac as one unit, since a death of either kills both. Issac, the melee
+// body that camps hit first as the nearest champion, leads by type (both instances must agree without
+// seeing each other): he picks the farm group priced as the pair. Cassi takes his claim and stands behind
+// him, holding fire until he draws the camps; with no claim to take she keeps within her stun's reach of
+// him. Either body's own trip home takes the other home. Set by twin_read at each turn's start.
+struct Twin {
+    const ChampionBelief* mate = nullptr; // the other body while both live, else null
+    bool leads = false;                   // the mate follows our claim
+    bool mate_home = false;               // the mate posted its own trip home for danger: we follow it
+    bool mate_away = false;               // or for any reason (comms::mate_home): it is not with us
+    bool own_home = false;                // want_home held this turn for a reason of our own
+    int mate_claim = -1;
+    bool induced = false;                 // a want_home this turn held only for the mate's trip home
+    int hold_group = -1;                  // the follower holds fire on this group this turn
+    bool counted = false;                 // the leader's farm counts the mate's output (twin_mate_output)
+};
+Twin twin;
+void twin_read(const World& world);
+bool twin_excluded(const ChampionBelief& a);
+float twin_mate_output(const World& world, const Memory& memory);
+float twin_mate_late(const World& world, int g, vec2 here);
+int twin_follow_claim(const World& world);
+void twin_wait(const World& world, Memory& memory);
+const bitboard* twin_stance(const World& world, int g, const bitboard& tiles, bool& stage);
+bool twin_leaves_pick_up(const World& world, const ChampionBelief& a, int g);
+bool twin_follow_home(const World& world, Pathing& pathing);
+bool twin_waits_home(const World& world);
+bool twin_tether(World& world, Pathing& pathing, Safety& safety, Memory& memory);
+void twin_close_in(const World& world, Pathing& pathing, Safety& safety);
+int twin_posts_home(const World& world);
 AltarWalk& altar_walk();
 void flood_altar_walk(const World& world, Pathing& pathing, AltarWalk& w);
 const AltarAccess& altar_access(const World& world, Pathing& pathing);
