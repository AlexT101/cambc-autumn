+HealSupply heal_supply(const World& world, const ChampionBelief& a) {
+    // Read once a turn and vision: crew pricing asks it for every member of every plan.
+    static std::array<HealSupply, 8> kept;
+    static std::array<std::uint64_t, 8> key{};
+    const std::uint64_t now = static_cast<std::uint64_t>(world.round) << 32 | world.observations;
+    if (a.index < 8 && key[static_cast<std::size_t>(a.index)] == now) return kept[static_cast<std::size_t>(a.index)];
+    HealSupply s;
+    const auto* h = living_healer(world);
+    if (h && h != &a && a.alive) {
+        int ally = -1, due = -1;
+        const bool posted = comms::attachment(world, ally, due);
+        if (posted && ally == a.index) {
+            // Posted at its turn's end, counting from the round after: a round more once it acted this one.
+            const bool acted = !h->is_self && world.slot(*h, world.round) < world.my_slot_now();
+            const int seen = heal_ready_in(world, *h);
+            s.ready_in = due >= 0 ? due + (acted ? 1 : 0) : seen >= 0 ? seen : ability_cooldown - 1;
+            s.on = true;
+        } else if (!posted && first_in_reach(world, *h, a)) {
+            if (const int r = heal_ready_in(world, *h); r >= 0) s.ready_in = r, s.on = true;
+        }
+        if (s.on) s.amount = heal_amount(*h);
+    }
+    if (a.index < 8) kept[static_cast<std::size_t>(a.index)] = s, key[static_cast<std::size_t>(a.index)] = now;
+    return s;
+}
