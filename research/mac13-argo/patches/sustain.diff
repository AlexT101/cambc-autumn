+const ChampionBelief* living_healer(const World& world) {
+    for (const auto& h : world.allies)
+        if (h.alive && h.facts().heals()) return &h;
+    return nullptr;
+}
+
+// The healer's heal: live while we see it, else at the Focus last seen (its base before any sighting).
+float heal_amount(const ChampionBelief& h) {
+    const auto& f = h.facts();
+    const int slot = f.slot_of(AbilityKind::heal);
+    const auto* live = h.visible ? visible_record(h.handle) : nullptr;
+    const float focus = live ? live->focus : h.focus > 0 ? h.focus : f.focus.base;
+    return f.abilities[slot].multiplier * focus;
+}
+
+// A visible healer's rounds from this one until its heal is next ready, -1 if a channel or a stun
+// holds it: a cooldown read after its turn this round counts from next round.
+int heal_ready_in(const World& world, const ChampionBelief& h) {
+    if (!h.visible || !h.can_act(world.round) || h.stun_pending || h.channel == Channel::tribute || h.channel == Channel::teleport) return -1;
+    const auto* live = visible_record(h.handle);
+    if (!live) return -1;
+    if (cambc::champion_state::from_bits_retain(live->state).contains(cambc::champion_state::recalling) && kept_recall(h.handle, h.recall_turns()))
+        return -1;
+    std::int32_t cooldown = 0;
+    ok(cambc::detail::sdk_champion_cooldown(static_cast<std::uint32_t>(h.handle), h.facts().slot_of(AbilityKind::heal), &cooldown));
+    return std::max(0, static_cast<int>(cooldown)) + (h.acted ? 1 : 0);
+}
+
+// Without a posted attachment: `a`, visible, is the ally least healthy (by share) of those within a
+// visible healer's range, so the one its heal goes to. One heal serves one ally.
+bool first_in_reach(const World& world, const ChampionBelief& h, const ChampionBelief& a) {
+    if (!h.visible || h.is_self || !(a.is_self || a.visible)) return false;
+    const auto& f = h.facts();
+    const int range = f.abilities[f.slot_of(AbilityKind::heal)].range();
+    const auto share = [&](const ChampionBelief& o) {
+        const auto* live = o.is_self ? &my_record() : visible_record(o.handle);
+        return live && live->max_health > 0 ? live->health / live->max_health : 2.0f;
+    };
+    const vec2 p = a.is_self ? my_position() : a.pos;
+    if (dist(h.pos, p) > range) return false;
+    const float mine = share(a);
+    for (const auto& o : world.allies)
+        if (&o != &a && &o != &h && o.alive && (o.is_self || o.visible) && dist(h.pos, o.is_self ? my_position() : o.pos) <= range
+            && !test(world.map().ally_spawn, o.is_self ? my_position() : o.pos) && share(o) < mine)
+            return false;
+    return true;
+}
