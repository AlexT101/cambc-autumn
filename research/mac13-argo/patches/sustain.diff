+float heal_on_hand(const World& world, vec2 p, int phases) {
+    const auto* h = living_healer(world);
+    if (!h || h->is_self || !h->visible) return 0;
+    const auto& f = h->facts();
+    const int range = f.abilities[f.slot_of(AbilityKind::heal)].range();
+    if (dist(h->pos, p) > range) return 0;
+    // Posted, only to us; with no room to post, only as the ally she would heal first.
+    if (int ally = -1, due = -1; comms::attachment(world, ally, due) ? ally != world.me().index : !first_in_reach(world, *h, world.me())) return 0;
+    const int r = heal_ready_in(world, *h);
+    if (r < 0 || r > phases) return 0;
+    // Her sight must reach p (abilities.unit_target), as local_support reads it: in a bush her own
+    // cluster is clear to her, and the tiles that see her stand in for what she sees.
+    const int view = std::clamp(range, 0, Reach::Window::radius);
+    const auto viewers = test(world.map().bushes, h->pos) ? attack_viewers(world, h->pos, view) : seen_from(world, h->pos, view);
+    const int dx = p.x - h->pos.x, dy = p.y - h->pos.y;
+    if (!(viewers & Reach::Window::bit(Reach::Window::at(dx, dy)))) return 0;
+    return std::min(heal_amount(*h), std::max(0.0f, my_max_health() - my_health()));
+}
