+// The rounds between arrivals home that no shopping trip brought, prior-weighted. A trip's arrival ends
+// its interval without counting: the next visit would have come no sooner. The prior: our measured
+// rounds per such arrival in rounds 1-400, every champion pooled (256 ladder games against charybdis
+// 525); the mirror's 5-7 completed recalls per 400 rounds, plus deaths and walks home, agree.
+constexpr float prior_visit_rounds = 60;
+// Worth as many rounds of play as income's prior.
+constexpr float prior_visit_play = prior_rounds_per_gem * income_prior_gems;
+
+// The dead shop too (rules: economy.shop), so a death is the visit and its respawn none; a death on a
+// shopping trip is no arrival the trip brought.
+void note_arrival(const World& world, bool home, bool dead) {
+    if (home && !visits.home) {
+        const bool natural = dead || !visits.shopping;
+        visits.rounds += static_cast<float>(world.round - visits.last);
+        visits.natural += natural;
+        debug_block({ std::printf("VISIT %d %u %c %.1f\n", world.round, my_handle(), dead ? 'D' : natural ? 'N' : 'S', static_cast<float>(world.round - visits.last)); });
+        visits.last = world.round;
+    }
+    visits.home = home;
+}
+
+void note_visit_start(const World& world) {
+    const vec2 p = world.me().pos;
+    const bool dead = !world.me().alive;
+    const bool home = dead || (in_bounds(p) && test(world.map().ally_spawn, p));
+    if (visits.last < 0) visits.last = world.round, visits.home = home; // we start on spawn
+    else note_arrival(world, home, dead);
+    visits.shopping = false;
+}
+
+void note_visit_end(const World& world) {
+    if (visits.last < 0) return;
+    const vec2 p = my_position(); // off the map once dead
+    const bool dead = !in_bounds(p);
+    note_arrival(world, dead || test(world.map().ally_spawn, p), dead);
+}
+
+// The share of a purchase's saving over `rounds` of farm that buying it now earns: we own it anyway
+// from our next visit home, expected a mean interval after the last, and no sooner than a recall.
+float bought_early(const World& world, float rounds) {
+    if (!(rounds > 0) || visits.last < 0) return 1;
+    const float interval = (visits.rounds + prior_visit_play) / (static_cast<float>(visits.natural) + prior_visit_play / prior_visit_rounds);
+    const float until = std::max(interval - static_cast<float>(world.round - visits.last), static_cast<float>(recall_turns(world)));
+    return std::min(1.0f, until / rounds);
+}
