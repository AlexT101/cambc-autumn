+// A late stop (research/mac13-argo): a stun cancelling a channel of b turns with k left costs the enemy
+// b - k turns, and the stunner standing by the channel is often killed for it, so a stun at the start
+// buys a few turns and one at the end nearly the whole channel. The channel completes at its owner's
+// turn start in channel_end_round (turn_start): our last stop is our latest turn before that moment.
+// We stop one turn of ours earlier: a stun that fails (a hidden blocker), a body stepping into our way,
+// or a turn order we misread (priorities change from the next round) each costs at most that one turn.
+// Of the bodies holding a stun for it, the lowest index stops so; the others hold to their own last
+// turn, which only a stop that failed leaves to them, and stop then.
+
+// Our latest round whose turn comes before `lands`, or -1.
+int stop_deadline(const World& world, const ChampionBelief& e, Moment lands) {
+    for (int r = e.channel_end_round; r >= world.round; --r)
+        if (world.me().can_act(r) && turn_start(world, world.me(), r) < lands) return r;
+    return -1;
+}
+
+// A visible ally of lower index that sees e, out of channels, holding a ready stun that reaches e
+// (after a walk, if it allows one) on a turn before `lands`.
+bool earlier_stunner(const World& world, const ChampionBelief& e, Moment lands, const bitboard& sight) {
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || !a.visible || a.index > world.me().index || held_by_channel(a) || stun_pending(a.handle)) continue;
+        if (!test(sight, a.pos)) continue;
+        const int r = a.acted ? world.round + 1 : world.round;
+        if (a.can_act(r) && turn_start(world, a, r) < lands && dist(a.pos, e.pos) <= a.ready_stun_reach(r, true)) return true;
+    }
+    return false;
+}
+
+enum class Stage { none, held, walk };
+// stage_stop's, for the walk it hands back: who sees e, and our stun's reach on the planned turn.
+static bitboard stage_sight{cambc::uninitialized};
+static int stage_reach = -1;
+
+// Holding a stun for e's game-ending channel, wait in its reach and our sight of e until the planned
+// turn: held, or walk (in as the old stop walks, holding the stop). Not when we cannot read the
+// channel's end, the channel's landing is not the win's, or waiting could cost the stop: a stun on us
+// before our next turn takes that turn, and a blow that could kill us takes the body. Then the stop
+// is now, as before.
+Stage stage_stop(const World& world, Pathing& pathing, Safety& safety, const ChampionBelief& e) {
+    const auto no = [&](int why) {
+        debug_block({ std::printf("LATEWHY %d %u %d\n", world.round, my_handle(), why); });
+        return Stage::none;
+    };
+    if (e.channel != Channel::tribute || !e.visible || e.facts().passive == Passive::stun_immune || test(world.map().bushes, e.pos)) return no(1);
+    if (e.channel_end_round <= world.round || e.stun_pending) return no(2);
+    const Moment lands = turn_start(world, e, e.channel_end_round);
+    if (const auto win = enemy_tributes_win(world); !win || win->lands != lands) return no(3);
+    // Who sees e: we must keep reading the channel, and a wall between is a stop that fails.
+    auto& sight = stage_sight;
+    world.map().viewers_into(e.pos, vision_radius, sight);
+    const int deadline = stop_deadline(world, e, lands);
+    const int plan = earlier_stunner(world, e, lands, sight) ? deadline : deadline - 1;
+    if (deadline < 0 || plan <= world.round) return no(4);
+    const int reach = stage_reach = world.me().ready_stun_reach(plan);
+    if (reach < 0) return no(5);
+    const vec2 here = my_position();
+    // The channeller strikes only by cancelling (rules channelling), and a restart runs the whole channel again.
+    const auto risky = [&](vec2 p) {
+        const auto b = safety.bound(p, world.me().taken, e.index);
+        return b.stuns || b.doubled >= world.me().health;
+    };
+    const auto staged = [&](bool placed) {
+        decision = Branch::stop_staged;
+        stop_staged = true;
+        debug_block({ std::printf("LATESTAGE %d %u left %d plan %d deadline %d placed %d\n", world.round, my_handle(),
+                                  e.channel_end_round - world.round, plan, deadline, placed ? 1 : 0); });
+    };
+    if (dist(here, e.pos) > reach || !test(sight, here)) {
+        // An excluding stun cannot follow a walk, so we must stand placed when the planned turn starts.
+        // Steps as the crow flies are a floor on the walk's turns; the turn kept beyond them is for a body
+        // in the way or a stun on us where we arrive, and re-planning each turn hands a longer walk back to
+        // the old stop.
+        const int steps = std::max(1, dist(here, e.pos) - reach);
+        if (steps >= plan - world.round || !my_can_move() || risky(here)) return no(6);
+        staged(false);
+        return Stage::walk;
+    }
+    // Re-planned every turn, so only what could reach us before our next turn counts: a risky tile is
+    // left for a step onto one that keeps the stop and is not, else the stop is now.
+    std::optional<vec2> step;
+    if (risky(here)) {
+        if (!my_can_move()) return no(7);
+        const auto& blocked = pathing.blocked();
+        for (const auto d : directions) {
+            const vec2 p = here + d;
+            if (in_bounds(p) && test(world.map().open_for_us, p) && !test(blocked, p) && dist(p, e.pos) <= reach && test(sight, p) && !risky(p)) {
+                step = p;
+                break;
+            }
+        }
+        if (!step) return no(7);
+    }
+    staged(true);
+    // Moved, or refused by a hidden blocker (which spends nothing): staged either way, re-planned next turn.
+    if (step) pathing.try_move(*step);
+    // Damage does not interrupt a tribute, but a kill takes the bag: our basic attack is no stop. After
+    // the step, which a ranged attack would spend.
+    attack_enemy(world);
+    return Stage::held;
+}
