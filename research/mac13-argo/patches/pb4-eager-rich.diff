+// Probe pb4-eager-rich: what the team holds towards the win, tributed and carried (an unseen ally's bag
+// as posted, as race_left_now reads it).
+int team_wealth(const World& world) {
+    static BagKey last;
+    static int kept = 0;
+    const BagKey key = bag_key(world);
+    if (key == last) return kept;
+    last = key;
+    int wealth = world.score.ally + static_cast<int>(my_gems());
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive) wealth += a.visible ? a.gems : comms::bag_of(world, a.index);
+    return kept = wealth;
+}
+
+// Probe pb4-eager-rich: once the team holds the win between its bags, every non-Prism bag of a few
+// tribute turns banks at once, bank floor and chaining aside, so the bags land in short parallel channels.
+constexpr int rich_wealth = 1000, rich_bag = 30;
+bool rich_bank(const World& world, int bag) {
+    return bag >= rich_bag && world.me().facts().passive != Passive::gem_focus && team_wealth(world) >= rich_wealth;
+}
