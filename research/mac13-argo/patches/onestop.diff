+// Probe onestop: whether we walk in on the ender's tribute while holding a hard stop, or play on as if it
+// were not there. Each body ranks every body by the round its stop could land, its cooldown's wait included
+// (ties by index): the first goes, the second too when the first has no spare turn, and a ready stun landing
+// this turn always goes. Allies are read from above (unseen: their posted tile's worst, an unseen cast, a
+// teleport), on fields every body builds alike, never earlier than their own reading: the body truly first
+// ranks itself first, so someone goes. With none that lands in time, or two enders (each body takes its
+// nearest), every holder goes as before.
+bool onestop_goes(const World& world, Pathing& pathing, const ChampionBelief& e) {
+    if (!holds_hard_stop(world, e)) return false;
+    const auto& self = world.me();
+    const bool stunnable = e.facts().passive != Passive::stun_immune;
+    // Cancelling our tribute or recall frees the walk.
+    const auto state = my_state();
+    const bool walk = my_can_move() || state.contains(cambc::champion_state::submitting_gems) || state.contains(cambc::champion_state::recalling);
+    if (stunnable && dist(my_position(), e.pos) <= self.ready_stun_reach(world.round, walk)) return true;
+    for (const auto& o : world.enemies)
+        if (&o != &e && o.alive && o.visible && o.channel == Channel::tribute && enemy_tribute_wins(world, o)) return true;
+    // The ranking, once a turn: read again only after we moved.
+    static int kept_round = -1;
+    static std::uint32_t kept_ender = 0;
+    static vec2 kept_at{-1, -1};
+    static bool kept = false;
+    const vec2 here = my_position();
+    if (kept_round == world.round && kept_ender == static_cast<std::uint32_t>(e.handle) && kept_at == here) return kept;
+    kept_round = world.round, kept_ender = static_cast<std::uint32_t>(e.handle), kept_at = here;
+    kept = true;
+    const auto& map = world.map();
+    const int altar = tribute_altar(world, e.pos);
+    const int end = e.channel_end_round;
+    // Walking fields over the static walls every body shares (a dasher's own would read walkers short), cut
+    // off past any walk that lands in time: farther is unlabelled, as out of time.
+    const int layers = std::max(0, end - world.round) + vision_radius + 2;
+    static bitboard sight{cambc::uninitialized}, goal{cambc::uninitialized}, square{cambc::uninitialized};
+    static std::optional<Field> to_ender, to_lock;
+    map.sight_off_bushes_into(e.pos, vision_radius, sight); // the tiles that see it: sight is symmetric
+    clear_board(goal);
+    goal.set(e.pos);
+    // Labels past the cut are unreachable, as a partial field is kept (make_field's capped form drops it).
+    const auto capped = [&](std::optional<Field>& f, const bitboard& goals) {
+        static bitboard visited{cambc::uninitialized};
+        f.reset();
+        f.emplace();
+        not_into(map.blocked_for_us, f->goals);
+        f->goals &= goals;
+        f->steps.compute_with_expansion_count(map.blocked_for_us, f->goals, visited, static_cast<std::uint16_t>(std::min<int>(layers, unreachable)));
+    };
+    capped(to_ender, goal);
+    if (altar >= 0) capped(to_lock, map.altars[altar].tribute_tiles());
+    else to_lock.reset();
+    const auto at = [](const std::optional<Field>& f, vec2 p) { return f ? f->at(p) : unreachable; };
+    const int need = static_cast<int>(cambc::constants::winning_gems) - world.score.ally;
+    int bags = 0; // every ally's bag, from above: a body whose bag may win first races instead of stopping
+    for (const auto& a : world.allies)
+        if (a.alive) bags += a.is_self ? static_cast<int>(my_gems()) : a.visible ? a.gems : comms::bag_of(world, a.index);
+    // The round a body's stop lands, from its next turn r0: a stun once it holds one for its next turn
+    // (holds_hard_stop: it walks only then), `steps` its walk onto the ender's tile; a lock placed after the
+    // turn's step, `lock_steps` its walk to the altar's tribute tiles. unreachable without one.
+    const auto lands = [&](const ChampionFacts& f, int r0, const std::array<int, 2>& ready, int steps, int lock_steps, bool lock) {
+        int k = unreachable;
+        if (stunnable && steps != unreachable)
+            for (int s = 0; s < 2; ++s)
+                if (const int reach = f.stun_reach_with_walk(s); reach >= 0) {
+                    const int wait = std::max(0, ready[s] - 1 - r0);
+                    k = std::min(k, std::max(wait + std::max(0, steps - reach), ready[s] - r0));
+                }
+        if (lock && lock_steps != unreachable) k = std::min(k, std::max(0, lock_steps - altar_lock_range));
+        return k == unreachable ? unreachable : r0 + k;
+    };
+    struct Eta {
+        int round, index;
+        bool operator<(const Eta& o) const { return round != o.round ? round < o.round : index < o.index; }
+    };
+    std::array<Eta, 8> etas;
+    int n = 0;
+    std::optional<Eta> mine;
+    if (int r = lands(self.facts(), world.round, self.ready_round, at(to_ender, here), at(to_lock, here), carried_locks() > 0);
+        r <= last_round_before_channel_ends(world, e))
+        mine = etas[static_cast<std::size_t>(n++)] = {r, self.index};
+    constexpr int teleport_reach = 3; // a crystal's landing, from the channel's tile
+    const int lock_id = static_cast<int>(cambc::detail::raw_consumable_ids[static_cast<std::size_t>(cambc::consumable_type::altar_lock)]);
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || n >= static_cast<int>(etas.size())) continue;
+        const int bag = a.visible ? a.gems : comms::bag_of(world, a.index);
+        if (bag > 0 && bags >= need) continue;
+        int round = unreachable;
+        if (a.visible) {
+            if (held_by_channel(a) || !test(sight, a.pos)) continue;
+            int r0 = a.acted ? world.round + 1 : world.round;
+            if (!a.can_act(r0)) ++r0;
+            if (a.stun_pending) ++r0;
+            bool lock = false;
+            if (to_lock) {
+                std::array<std::uint32_t, 4> counts{};
+                lock = cambc::detail::sdk_champion_consumables(static_cast<std::uint32_t>(a.handle), counts.data()) == 0
+                       && counts[static_cast<std::size_t>(lock_id)] > 0;
+            }
+            round = lands(a.facts(), r0, a.ready_round, at(to_ender, a.pos), at(to_lock, a.pos), lock);
+        } else {
+            // Its stun may hold a cast unseen this round: read ready at round + ability_cooldown, it lands no
+            // sooner, never before us then. Its tile as posted (to within 2) or seen, a round old at most, up to
+            // a dash a round since and a teleport's 3, each of which must see the ender; a teleport may hold
+            // its next turns, and its locks are not read.
+            if (mine && mine->round < world.round + ability_cooldown) continue;
+            vec2 from{-1, -1};
+            int told = -1, slack = 0;
+            if (params::comms_ally && comms::told_ally(a.index, from, told) && told >= world.round - 1 && told > a.pos_round)
+                slack = 2 + dash_range * (world.round - told) + teleport_reach;
+            else if (a.pos_source == Source::seen && a.pos_round >= world.round - 1 && in_bounds(a.pos))
+                from = a.pos, slack = dash_range * (world.round - a.pos_round + 1) + teleport_reach; // it may have acted since
+            else
+                continue;
+            clear_board(square);
+            draw_square(square, from, static_cast<float>(slack));
+            and_into(square, map.open_for_us, square);
+            static bitboard unseen{cambc::uninitialized};
+            copy_into(square, unseen);
+            drop(unseen, sight);
+            if (!board_empty(unseen)) continue;
+            int steps = -1;
+            for (auto t : Tiles<15 * 15>{square}) steps = std::max(steps, at(to_ender, t));
+            if (steps < 0 || steps == unreachable) continue;
+            const int r0 = world.round + 1 + cambc::constants::tp_crystal_time;
+            std::array<int, 2> ready = a.ready_round;
+            for (auto& r : ready) r = std::max(r, world.round + ability_cooldown);
+            round = lands(a.facts(), r0, ready, steps, unreachable, false);
+        }
+        if (round == unreachable || round > end - 1) continue;
+        etas[static_cast<std::size_t>(n++)] = {round, a.index};
+    }
+    if (n == 0) return kept = true; // none lands in time by our reading: every holder tries, as before
+    if (!mine) return kept = false;
+    std::sort(etas.begin(), etas.begin() + n);
+    const int rank = static_cast<int>(std::find_if(etas.begin(), etas.begin() + n, [&](const Eta& x) { return x.index == mine->index; }) - etas.begin());
+    // The second goes when the first's stop, read from above, leaves no spare turn before the channel ends.
+    const bool backup = rank == 1 && etas[0].round + 1 > end - 1;
+    debug_block({ std::printf("ONESTOP %d %u rank %d of %d lands %d first %d end %d%s\n", world.round, static_cast<unsigned>(self.handle), rank, n, mine->round, etas[0].round, end, backup ? " backup" : ""); });
+    return kept = rank == 0 || backup;
+}
