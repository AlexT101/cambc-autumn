 // The gems we carry, posted when it changes.
 void bag(int gems);
 // The gems an ally (by index) carries as it last posted, rounded up to a multiple of 4 and capped
-// at 508 (ours exact); 0 if never or while dead.
+// at 504 (ours exact); 0 if never or while dead. 508 is posted only by a bag that wins (told_winning).
+inline constexpr int winning_post = 508;
+// The sentinel reads as the least bag that wins.
 inline int bag_of(const World& world, int ally) {
     const auto& a = world.allies[ally];
     if (a.is_self) return detail::posts.my_bag;
-    return a.alive ? detail::posts.bags[ally] : 0;
+    if (!a.alive) return 0;
+    const int b = detail::posts.bags[ally];
+    return b == winning_post ? std::max(1, static_cast<int>(cambc::constants::winning_gems) - world.score.ally) : b;
+}
+// The ally posted that its bag wins with the team's score: a bag past the cap otherwise reads as 504 whatever its size.
+inline bool told_winning(const World& world, int ally) {
+    const auto& a = world.allies[ally];
+    return !a.is_self && a.alive && detail::posts.bags[ally] == winning_post;
 }
 // The group we work towards (-1 for none), posted every turn.
 void claim(int group);
