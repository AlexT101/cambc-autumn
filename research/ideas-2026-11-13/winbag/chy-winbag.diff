+// Escort stand tiles by the escort altar, best first: out of camp reach as in stands(), then off the
+// tribute tiles (the carrier needs one), then nearer the enemy spawn (between it and the carrier), then bushes,
+// then nearer our spawn.
+const std::vector<vec2>& escort_stands(const World& world, int a) {
+    static std::vector<vec2> tiles;
+    static int built = -1;
+    if (built == a) return tiles;
+    built = a;
+    tiles.clear();
+    const auto& map = world.map();
+    const vec2 alt = map.altars[a].pos;
+    const int r = params::altar_stand_radius;
+    struct Near {
+        vec2 pos;
+        int reach;
+    };
+    std::vector<Near> near;
+    for (const auto& g : map.groups)
+        for (const auto& m : g.members)
+            if (m.strength > 0 && dist(m.pos, alt) <= m.reach + r) near.push_back({m.pos, m.reach});
+    const auto in_camp_reach = [&](vec2 p) {
+        for (const auto& m : near)
+            if (dist(m.pos, p) <= m.reach) return true;
+        return false;
+    };
+    struct Scored {
+        int tribute, theirs, bush, home;
+        vec2 p;
+    };
+    std::vector<Scored> all, safe;
+    for (int dx = -r; dx <= r; ++dx)
+        for (int dy = -r; dy <= r; ++dy) {
+            const vec2 p{alt.x + dx, alt.y + dy};
+            if (!in_bounds(p) || !test(map.standable, p) || test(map.near_enemy_spawn, p)) continue;
+            const int home = map.from_ally_spawn().at(p);
+            if (home == unreachable) continue;
+            const Scored s{test(map.altars[a].tribute_tiles(), p) ? 1 : 0, map.enemy_spawn_steps(p), test(map.bushes, p) ? 0 : 1, home, p};
+            all.push_back(s);
+            if (!in_camp_reach(p)) safe.push_back(s);
+        }
+    auto& use = safe.empty() ? all : safe;
+    std::sort(use.begin(), use.end(), [](const Scored& x, const Scored& y) {
+        if (x.tribute != y.tribute) return x.tribute < y.tribute;
+        if (x.theirs != y.theirs) return x.theirs < y.theirs;
+        if (x.bush != y.bush) return x.bush < y.bush;
+        if (x.home != y.home) return x.home < y.home;
+        return x.p.x != y.p.x ? x.p.x < y.p.x : x.p.y < y.p.y;
+    });
+    for (const auto& s : use) tiles.push_back(s.p);
+    return tiles;
+}
