+// The Tribute emblem: in the stat its shards have begun in, else the stat that saves most.
+Emblem forced_tribute(const World& world, const Build& bought, const cambc::enum_map<cambc::item_type>* items) {
+    const auto& owned = items ? *items : my_items();
+    std::optional<Emblem> best;
+    for (int stat = strength_stat; stat <= health_stat; ++stat) {
+        pin_family = tribute, pin_stat = stat;
+        const Emblem t = current_emblem(world, bought, items);
+        pin_family = -1;
+        if (owned[shard_of(tribute, stat)] > 0) return t;
+        if (!best || t.saved > best->saved) best = t;
+    }
+    return *best;
+}
