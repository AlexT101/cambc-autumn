+// A seen enemy whose whole kit in one turn (attack, reset and attack; a dash and attack) kills us
+// from our health now: for a linked body the kill takes both bodies and both bags at no risk to it.
+bool one_turn_killer_seen(const World& world, Safety& safety) {
+    const float life = my_health() + world.me().shield;
+    for (auto left = safety.seen_enemies(); left; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        const Strike& s = strike_with(e, 0b11u);
+        for (int d = 0; d <= s.reach && d <= Strike::max_reach; ++d)
+            if (s.damage[static_cast<std::size_t>(d)] >= life) return true;
+    }
+    return false;
+}
