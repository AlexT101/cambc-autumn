+constexpr std::uint64_t splitmix(std::uint64_t z) {
+    z += 0x9E3779B97F4A7C15ull;
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+    return z ^ (z >> 31);
+}
+
+// The SDK's map masks 0-3 (walls, bushes, holes, altars), made at start-up.
+const cambc::bitboard& mask(int kind) {
+    switch (kind) {
+    case 0: return cambc::map::walls();
+    case 1: return cambc::map::bushes();
+    case 2: return cambc::map::holes();
+    default: return cambc::map::altars();
+    }
+}
+
+// Order-free over the wall, bush, hole and altar tiles; extract.mjs's mapId computes the same from a replay.
+std::uint64_t map_id() {
+    std::uint64_t s = 0, n = 0, W = 0;
+    for (std::int32_t kind = 0; kind < 4; ++kind) {
+        const auto& m = mask(kind);
+        if (kind == 0) W = static_cast<std::uint64_t>(m.width()), s = splitmix(W * 1024 + static_cast<std::uint64_t>(m.height()));
+        const auto tiles = m.positions();
+        for (const auto p : tiles)
+            s += splitmix((static_cast<std::uint64_t>(kind) << 40) + static_cast<std::uint64_t>(p.y) * W + static_cast<std::uint64_t>(p.x) + 1);
+        n = (n << 16) + tiles.size();
+    }
+    return splitmix(s + n);
+}
+
+// Order-free over the camps (type, tile) with their group's gems and gold; extract.mjs's layoutHash computes the same.
+// Terrain alone (map_id) does not tell a map from a copy with edited camps.
+std::uint64_t layout_hash() {
+    static std::uint32_t words[8192];
+    std::uint32_t count = 0;
+    if (d::sdk_map_camp_layout(words, 8192, &count) || count > 8192) return 0;
+    std::uint64_t s = 0;
+    for (std::uint32_t i = 0; i + 5 <= count;) {
+        const std::uint64_t gold = words[i + 1] & 0xFFFFFu, gems = words[i + 2] & 0xFFFFFu, size = words[i + 4];
+        i += 5;
+        for (std::uint32_t m = 0; m < size && i + 4 <= count; ++m, i += 4)
+            s += splitmix(static_cast<std::uint64_t>(words[i + 1] & 255u) << 56 | static_cast<std::uint64_t>(words[i + 2] & 255u) << 48 |
+                          static_cast<std::uint64_t>(words[i + 3] & 255u) << 40 | gems << 20 | gold);
+    }
+    return splitmix(s);
+}
+
+// Absolute team 0 (A) or 1 (B).
+int my_team() { return d::sdk_my_team(); }
+
+// Which (side, width, height) some entry has: off the book the only test that runs, at a few instructions.
+constexpr std::array<std::uint64_t, 2 * 65536 / 64> sizes = [] {
+    std::array<std::uint64_t, 2 * 65536 / 64> b{};
+    for (const auto& e : book_data::entries) {
+        if constexpr (book_data::entry_count == 0) break;
+        const unsigned k = e.side * 65536u + e.w * 256u + e.h;
+        b[k / 64] |= 1ull << (k % 64);
+    }
+    return b;
+}();
+constexpr unsigned size_key(const book_data::Entry& e) { return e.side * 65536u + e.w * 256u + e.h; }
+static_assert([] {
+    for (int i = 1; i < book_data::entry_count; ++i)
+        if (size_key(book_data::entries[i - 1]) > size_key(book_data::entries[i])) return false;
+    return true;
+}(), "build_book.py sorts the entries by side and size");
+
+// The first entry of this side and size (entries are sorted by them).
+int first_of_size(unsigned key) {
+    int lo = 0, hi = book_data::entry_count;
+    while (lo < hi) {
+        const int mid = (lo + hi) / 2;
+        if (size_key(book_data::entries[mid]) < key) lo = mid + 1;
+        else hi = mid;
+    }
+    return lo;
+}
+
+bool size_listed(int team, int W, int H) {
+    if (W < 0 || H < 0 || W > 255 || H > 255) return false;
+    const unsigned k = static_cast<unsigned>(team) * 65536u + static_cast<unsigned>(W) * 256u + static_cast<unsigned>(H);
+    return (sizes[k / 64] >> (k % 64)) & 1u;
+}
+
+int picks(int team, std::array<int, 5>& out) {
+    std::uint8_t rounds = 0;
+    if (d::sdk_draft_num_rounds(&rounds)) return 0;
+    int n = 0;
+    for (std::uint32_t r = 0; r < rounds && n < 5; ++r) {
+        std::int32_t pick = -1;
+        if (d::sdk_draft_get(team, r, &pick)) break;
+        out[static_cast<std::size_t>(n++)] = pick;
+    }
+    return n;
+}
+
+constexpr int cassi_and_issac = static_cast<int>(cambc::champion_draft::cassi_and_issac);
+int bodies_of(const std::int8_t* p, int n) {
+    int b = 0;
+    for (int i = 0; i < n; ++i) b += p[i] == cassi_and_issac ? 2 : 1;
+    return b;
+}
+
+// --- the blob: base64, decoded a group at a time ---
+constexpr std::array<std::uint8_t, 256> b64_table = [] {
+    std::array<std::uint8_t, 256> t{};
+    const char* a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    for (int i = 0; i < 64; ++i) t[static_cast<std::uint8_t>(a[i])] = static_cast<std::uint8_t>(i);
+    return t;
+}();
+
+std::uint8_t blob_byte(std::uint32_t i) {
+    if (i >= book_data::blob_bytes) return 0;
+    const char* g = book_data::blob + (i / 3) * 4;
+    const std::uint32_t v = static_cast<std::uint32_t>(b64_table[static_cast<std::uint8_t>(g[0])]) << 18
+                            | static_cast<std::uint32_t>(b64_table[static_cast<std::uint8_t>(g[1])]) << 12
+                            | static_cast<std::uint32_t>(b64_table[static_cast<std::uint8_t>(g[2])]) << 6
+                            | b64_table[static_cast<std::uint8_t>(g[3])];
+    return static_cast<std::uint8_t>(v >> (8 * (2 - i % 3)));
+}
+
+// --- the range decoder and models: build_book.py's Enc and Model, mirrored ---
+struct Decoder {
+    std::uint32_t range = 0xFFFFFFFFu, code = 0, at = 0, end = 0;
+    std::uint8_t next() { return at < end ? blob_byte(at++) : 0; }
+    void start(std::uint32_t off, std::uint32_t len) {
+        at = off, end = off + len, range = 0xFFFFFFFFu, code = 0;
+        for (int i = 0; i < 5; ++i) code = code << 8 | next();
+    }
+    int bit(std::uint16_t& p) {
+        const std::uint32_t bound = (range >> 11) * p;
+        int b;
+        if (code < bound) range = bound, p = static_cast<std::uint16_t>(p + ((2048 - p) >> 5)), b = 0;
+        else range -= bound, code -= bound, p = static_cast<std::uint16_t>(p - (p >> 5)), b = 1;
+        while (range < (1u << 24)) range <<= 8, code = code << 8 | next();
+        return b;
+    }
+    std::uint32_t tree(std::uint16_t* probs, int nbits) {
+        std::uint32_t m = 1;
+        for (int k = 0; k < nbits; ++k) m = m << 1 | static_cast<std::uint32_t>(bit(probs[m]));
+        return m - (1u << nbits);
+    }
+};
+
+constexpr int kinds = 17;
+enum : int {
+    A_END = 0, A_MOVE, A_ATTACK, A_CAST, A_PRIORITY, A_RECALL, A_SUBMIT, A_BUY, A_SELL, A_BUY_CONS, A_WARD, A_CANCEL,
+    A_LOCK, A_TELEPORT, A_BLOCKED, A_RESIGN, A_USE_CONS
+};
+constexpr bool positional(int k) {
+    return k == A_MOVE || k == A_ATTACK || k == A_CAST || k == A_SUBMIT || k == A_WARD || k == A_LOCK || k == A_TELEPORT
+           || k == A_BLOCKED || k == A_USE_CONS;
+}
+constexpr int fields(int k) {
+    return k == A_CAST || k == A_BUY || k == A_SELL || k == A_BUY_CONS ? 2 : k == A_ATTACK || k == A_BLOCKED || k == A_USE_CONS ? 1 : 0;
+}
+
+struct Model {
+    std::uint16_t roll[1];
+    std::uint16_t kind[kinds * 32];
+    std::uint16_t pos[kinds * 2 * 64];
+    std::uint16_t absxy[2 * 256];
+    std::uint16_t f[kinds * 2 * 256];
+    std::uint16_t fbig[kinds * 2 * 4 * 256];
+    std::uint16_t pr_same[1];
+    std::uint16_t pr[2 * 256];
+    std::uint16_t prfull[4 * 256];
+    void reset() {
+        for (auto* a : {roll, pr_same}) a[0] = 1024;
+        for (auto& p : kind) p = 1024;
+        for (auto& p : pos) p = 1024;
+        for (auto& p : absxy) p = 1024;
+        for (auto& p : f) p = 1024;
+        for (auto& p : fbig) p = 1024;
+        for (auto& p : pr) p = 1024;
+        for (auto& p : prfull) p = 1024;
+    }
+};
+
+struct Action {
+    int kind, x, y, p, q;
+};
+
+struct Stream {
+    Decoder dec;
+    Model model;
+    int cx = -1000, cy = -1000;
+    std::uint32_t prev_pr = 0;
+
+    std::int32_t field(int kind, int which) {
+        const int base = (kind * 2 + which) * 256;
+        std::uint32_t z = dec.tree(model.f + base, 8);
+        if (z == 255) {
+            z = 0;
+            for (int k = 0; k < 4; ++k) z |= dec.tree(model.fbig + ((kind * 2 + which) * 4 + k) * 256, 8) << (8 * k);
+        }
+        return static_cast<std::int32_t>((z >> 1) ^ (0u - (z & 1)));
+    }
+
+    // One turn's actions into `out`; returns whether it rolled over.
+    bool turn(Action* out, int& n, int cap) {
+        n = 0;
+        const bool roll = dec.bit(model.roll[0]) != 0;
+        int prev = 0;
+        while (true) {
+            const int kind = static_cast<int>(dec.tree(model.kind + prev * 32, 5));
+            if (kind == A_END || kind >= kinds) break;
+            Action a{kind, 0, 0, 0, 0};
+            if (positional(kind)) {
+                const int dx = static_cast<int>(dec.tree(model.pos + (kind * 2) * 64, 6));
+                if (dx == 63) {
+                    a.x = static_cast<int>(dec.tree(model.absxy, 8)) - 1;
+                    a.y = static_cast<int>(dec.tree(model.absxy + 256, 8)) - 1;
+                } else {
+                    const int dy = static_cast<int>(dec.tree(model.pos + (kind * 2 + 1) * 64, 6));
+                    a.x = cx + dx - 31, a.y = cy + dy - 31;
+                }
+                if (kind == A_MOVE) cx = a.x, cy = a.y;
+            }
+            if (kind == A_PRIORITY) {
+                std::uint32_t v;
+                if (!dec.bit(model.pr_same[0])) {
+                    v = (prev_pr & 0xFFFF0000u) | dec.tree(model.pr, 8) << 8;
+                    v |= dec.tree(model.pr + 256, 8);
+                } else {
+                    v = 0;
+                    for (int k = 0; k < 4; ++k) v |= dec.tree(model.prfull + k * 256, 8) << (8 * k);
+                }
+                prev_pr = v;
+                a.p = static_cast<std::int32_t>(v);
+            }
+            const int nf = fields(kind);
+            if (nf >= 1) a.p = field(kind, 0);
+            if (nf >= 2) a.q = field(kind, 1);
+            if (n < cap) out[n++] = a;
+            prev = kind;
+        }
+        return roll;
+    }
+};
+
+// --- executing a recorded action: tools/replay/harness/puppet/main.cpp's act() ---
+int target_handle(int tkind, int tx, int ty, std::uint32_t* handle) {
+    if (tkind == 1) return d::sdk_champion_at(tx, ty, handle);
+    if (tkind == 2) return d::sdk_camp_at(tx, ty, handle);
+    if (tkind == 6) {
+        d::altar_lock_info info{};
+        int code = d::sdk_altar_lock(tx, ty, static_cast<std::uint32_t>(1 - d::sdk_my_team()), &info);
+        if (code) code = d::sdk_altar_lock(tx, ty, static_cast<std::uint32_t>(d::sdk_my_team()), &info);
+        *handle = info.handle;
+        return code;
+    }
+    return 1;
+}
+
+int cast(int id, int slot, int tkind, int tx, int ty) {
+    d::ability_props props{};
+    if (int code = d::sdk_champion_ability_props(static_cast<std::uint32_t>(id), static_cast<std::uint32_t>(slot), &props)) return code;
+    std::int32_t ok = 0;
+    if (props.targets & d::ability_target_ground) return d::sdk_cast(static_cast<std::uint32_t>(slot), 0, 0, tx, ty, &ok);
+    if (tkind == 1 || tkind == 2) {
+        std::uint32_t h = 0;
+        if (int code = target_handle(tkind, tx, ty, &h)) return code;
+        if (tkind == 1 && (props.targets & d::ability_target_self) && !(props.targets & (d::ability_target_enemies | d::ability_target_allies)))
+            return d::sdk_cast(static_cast<std::uint32_t>(slot), 0, 0, -1, -1, &ok);
+        return d::sdk_cast(static_cast<std::uint32_t>(slot), static_cast<std::uint32_t>(tkind), h, -1, -1, &ok);
+    }
+    return d::sdk_cast(static_cast<std::uint32_t>(slot), 0, 0, -1, -1, &ok);
+}
+
+// A blocked step does not record which action was blocked: try them in the extractor's order.
+int blocked(int id, int order, int tx, int ty) {
+    std::int32_t ok = 0;
+    for (int k = 0; k < 4; ++k) {
+        const int which = (order >> (4 * k)) & 15;
+        int code = 1;
+        if (which == 1) code = d::sdk_move_to(tx, ty, &ok);
+        else if (which == 2) {
+            for (std::uint32_t slot = 0; slot < 2 && code; ++slot) {
+                d::ability_props props{};
+                if (d::sdk_champion_ability_props(static_cast<std::uint32_t>(id), slot, &props) == 0 && props.kind == 6)
+                    code = d::sdk_cast(slot, 0, 0, tx, ty, &ok);
+            }
+        } else if (which == 3) code = d::sdk_place_ward(tx, ty, &ok);
+        else if (which == 4) code = d::sdk_use_consumable(0, tx, ty, &ok);
+        else break;
+        if (code == 0) return 0;
+    }
+    return -1;
+}
+
+int act(int id, const Action& a) {
+    std::int32_t ok = 0;
+    switch (a.kind) {
+    case A_MOVE: return d::sdk_move_to(a.x, a.y, &ok);
+    case A_ATTACK: {
+        std::uint32_t h = 0;
+        if (int code = target_handle(a.p, a.x, a.y, &h)) return code;
+        return d::sdk_attack(static_cast<std::uint32_t>(a.p), h);
+    }
+    case A_CAST: return cast(id, a.p, a.q, a.x, a.y);
+    case A_PRIORITY: return d::sdk_set_priority(a.p);
+    case A_RECALL: return d::sdk_recall();
+    case A_SUBMIT: return d::sdk_submit_gems(a.x, a.y);
+    case A_BUY: return d::sdk_buy_item(static_cast<std::uint32_t>(a.p), static_cast<std::uint32_t>(a.q));
+    case A_SELL: {
+        int code = 0;
+        for (int k = 0; k < a.q && !code; ++k) code = d::sdk_sell(static_cast<std::uint32_t>(a.p));
+        return code;
+    }
+    case A_BUY_CONS: {
+        int code = 0;
+        for (int k = 0; k < a.q && !code; ++k) code = d::sdk_buy_consumable(static_cast<std::uint32_t>(a.p));
+        return code;
+    }
+    case A_WARD: return d::sdk_place_ward(a.x, a.y, &ok);
+    case A_CANCEL: return d::sdk_cancel_channel();
+    case A_LOCK: return d::sdk_use_consumable(2, a.x, a.y, &ok);
+    case A_TELEPORT: return d::sdk_use_consumable(0, a.x, a.y, &ok);
+    case A_USE_CONS: return d::sdk_use_consumable(static_cast<std::uint32_t>(a.p), a.x, a.y, &ok);
+    case A_BLOCKED: return blocked(id, a.p, a.x, a.y);
+    case A_RESIGN: std::fflush(nullptr); return d::sdk_resign();
+    default: return -2;
+    }
+}
+
+// What this champion sees at its turn's start: every champion in its sight (and its ward's), its own gold and bag,
+// and both teams' tributed gems. Four bits of it per turn are in the book.
+std::uint32_t fingerprint(std::uint32_t round, int me, int champions) {
+    std::uint64_t h = splitmix(static_cast<std::uint64_t>(round) * 64 + static_cast<std::uint64_t>(me));
+    for (int c = 0; c < champions; ++c) {
+        d::champion_info info{};
+        if (d::sdk_champion(static_cast<std::uint32_t>(c), &info) != 0 || info.x < 0 || info.y < 0) continue;
+        std::uint32_t hp;
+        std::memcpy(&hp, &info.health, 4);
+        h = splitmix(h ^ (static_cast<std::uint64_t>(c) | static_cast<std::uint64_t>(info.x) << 8 | static_cast<std::uint64_t>(info.y) << 16)
+                     ^ static_cast<std::uint64_t>(hp) << 32);
+    }
+    std::uint32_t g0 = 0, g1 = 0, gold = 0, gems = 0;
+    (void)d::sdk_bc_submitted_gems(0, &g0), (void)d::sdk_bc_submitted_gems(1, &g1);
+    (void)d::sdk_champion_gold(static_cast<std::uint32_t>(me), &gold), (void)d::sdk_champion_gems(static_cast<std::uint32_t>(me), &gems);
+    h = splitmix(h ^ g0 ^ static_cast<std::uint64_t>(g1) << 32);
+    h = splitmix(h ^ gold ^ static_cast<std::uint64_t>(gems) << 32);
+    return static_cast<std::uint32_t>(h & 15);
+}
+
+struct Play {
+    bool decided = false, on = false;
+    const book_data::Entry* entry = nullptr;
+    int body = 0, me = -1, champions = 0;
+    std::uint32_t next_round = 1; // the round whose turn the stream holds next
+    Stream stream;
+};
+Play play_state;
+
+bool none() {
+    if constexpr (book_data::mode != 0) std::printf("BKNONE %016llx\n", static_cast<unsigned long long>(map_id()));
+    return false;
+}
+
+bool start() {
+    if constexpr (book_data::entry_count == 0) return false;
+    const int team = my_team();
+    const int W = cambc::map::width(), H = cambc::map::height();
+    // Cheapest first, as every map runs this before its first turn: size, tile counts (the SDK's masks, made at
+    // start-up), the picks a round at a time, and only then the map id and the camp layout.
+    if (!size_listed(team, W, H)) return none();
+    static int cand[book_data::entry_count > 0 ? book_data::entry_count : 1];
+    int n = 0;
+    const unsigned key = static_cast<unsigned>(team) * 65536u + static_cast<unsigned>(W) * 256u + static_cast<unsigned>(H);
+    for (int i = first_of_size(key); i < book_data::entry_count && size_key(book_data::entries[i]) == key; ++i) cand[n++] = i;
+    // A count is a host call (~1 fuel per 8x8 chunk), so one kind at a time, walls first.
+    for (int kind = 0; kind < 4 && n > 0; ++kind) {
+        const auto count = mask(kind).count();
+        int k = 0;
+        for (int j = 0; j < n; ++j)
+            if (book_data::entries[cand[j]].counts[kind] == count) cand[k++] = cand[j];
+        n = k;
+    }
+    if (n == 0) return none();
+    std::uint8_t rounds = 0;
+    if (d::sdk_draft_num_rounds(&rounds)) return none();
+    {
+        int k = 0;
+        for (int j = 0; j < n; ++j)
+            if (book_data::entries[cand[j]].n_ours == rounds && book_data::entries[cand[j]].n_opp == rounds) cand[k++] = cand[j];
+        n = k;
+    }
+    for (std::uint32_t r = 0; r < rounds && n > 0; ++r) {
+        std::int32_t ours = -1, theirs = -1;
+        if (d::sdk_draft_get(team, r, &ours) || d::sdk_draft_get(1 - team, r, &theirs)) return none();
+        int k = 0;
+        for (int j = 0; j < n; ++j) {
+            const auto& e = book_data::entries[cand[j]];
+            if (e.ours[r] == ours && e.opp[r] == theirs) cand[k++] = cand[j];
+        }
+        n = k;
+    }
+    if (n == 0) return none();
+    const auto id = map_id();
+    std::uint64_t layout = 0;
+    bool have_layout = false;
+    for (int j = 0; j < n; ++j) {
+        const auto& e = book_data::entries[cand[j]];
+        if (e.map != id) continue;
+        if (!have_layout) layout = layout_hash(), have_layout = true;
+        if (e.layout != layout) continue;
+        auto& s = play_state;
+        s.entry = &e;
+        s.me = d::sdk_my_champion();
+        const int first = team == 0 ? 0 : bodies_of(e.opp, e.n_opp); // team A's bodies come first
+        s.body = s.me - first;
+        s.champions = bodies_of(e.ours, e.n_ours) + bodies_of(e.opp, e.n_opp);
+        if (s.body < 0 || s.body >= e.bodies) return false;
+        s.stream.model.reset();
+        s.stream.dec.start(e.off[s.body], e.len[s.body]);
+        if constexpr (book_data::mode == 1) std::printf("BKSTART %d %016llx body %d\n", cand[j], static_cast<unsigned long long>(id), s.body);
+        return true;
+    }
+    return none();
+}
+
+std::uint32_t recorded_fp(const book_data::Entry& e, int body, std::uint32_t round) {
+    const std::uint32_t i = round - 1;
+    return (blob_byte(e.fp[body] + i / 2) >> (4 * (i & 1))) & 15u;
+}
+
+Turn hand_over(const char* why, std::uint32_t round) {
+    play_state.on = false;
+    if constexpr (book_data::mode != 0) std::printf("BKOFF %u %s\n", round, why);
+    else debug_block({ std::printf("BKOFF %u %s\n", round, why); });
+    return Turn::handed_over;
+}
+
+} // namespace
+
+bool active() {
+    auto& s = play_state;
+    if (!s.decided) {
+        s.decided = true;
+        s.on = start();
+    }
+    return s.on;
+}
+
+Turn play(std::uint32_t round) {
+    auto& s = play_state;
+    const auto& e = *s.entry;
+    if (round > e.last) return hand_over("end", round);
+    std::array<Action, 64> acts{};
+    int n = 0;
+    while (s.next_round < round) (void)s.stream.turn(acts.data(), n, 64), ++s.next_round; // turns we never got
+    if (s.next_round != round) return hand_over("order", round);
+    if constexpr (book_data::mode == 0) {
+        if (fingerprint(round, s.me, s.champions) != recorded_fp(e, s.body, round)) return hand_over("seen", round);
+    } else if constexpr (book_data::mode == 1) {
+        std::printf("BKFP %u %d %x\n", round, s.body, fingerprint(round, s.me, s.champions));
+    }
+    const bool roll = s.stream.turn(acts.data(), n, 64);
+    ++s.next_round;
+    for (int i = 0; i < n; ++i) {
+        if (const int code = act(s.me, acts[static_cast<std::size_t>(i)]); code != 0) {
+            if constexpr (book_data::mode == 0) return hand_over("error", round);
+            else std::printf("BKERR %u %d kind %d code %d\n", round, s.body, acts[static_cast<std::size_t>(i)].kind, code);
+        }
+    }
+    if (!roll) return Turn::done;
+    std::fflush(nullptr);
+    while (true) {
+        std::uint32_t r = 0;
+        d::sdk_bc_round_number(&r);
+        if (r != round) break;
+    }
+    return Turn::rollover;
+}
+
+const std::vector<cambc::champion_draft>* draft_order() {
+    if constexpr (book_data::entry_count == 0 || !book_data::force_draft) return nullptr;
+    static bool init = false;
+    static std::vector<int> cands;
+    static std::vector<cambc::champion_draft> order;
+    static int team = 0;
+    if (!init) {
+        init = true;
+        team = my_team();
+        if (!size_listed(team, cambc::map::width(), cambc::map::height())) return nullptr;
+        std::uint8_t rounds = 0;
+        (void)d::sdk_draft_num_rounds(&rounds);
+        const int W = cambc::map::width(), H = cambc::map::height();
+        bool any = false;
+        for (int i = 0; i < book_data::entry_count && !any; ++i) {
+            const auto& e = book_data::entries[i];
+            any = e.side == team && e.n_ours == rounds && e.w == W && e.h == H;
+        }
+        if (!any) return nullptr;
+        const auto id = map_id();
+        for (int i = 0; i < book_data::entry_count; ++i)
+            if (book_data::entries[i].map == id && book_data::entries[i].side == team && book_data::entries[i].n_ours == rounds) cands.push_back(i);
+        if constexpr (book_data::mode != 0) std::printf("BKDRAFT %016llx %zu\n", static_cast<unsigned long long>(id), cands.size());
+    }
+    if (cands.empty()) return nullptr;
+    std::array<int, 5> ours{}, theirs{};
+    const int n_ours = picks(team, ours), n_theirs = picks(1 - team, theirs);
+    std::erase_if(cands, [&](int i) {
+        const auto& e = book_data::entries[i];
+        for (int k = 0; k < n_ours; ++k)
+            if (k >= e.n_ours || e.ours[k] != ours[static_cast<std::size_t>(k)]) return true;
+        for (int k = 0; k < n_theirs; ++k)
+            if (k >= e.n_opp || e.opp[k] != theirs[static_cast<std::size_t>(k)]) return true;
+        return false;
+    });
+    if (cands.empty()) return nullptr;
+    const auto& e = book_data::entries[cands.front()];
+    order.clear();
+    for (int k = 0; k < e.n_ours; ++k) order.push_back(static_cast<cambc::champion_draft>(e.ours[k]));
+    return &order;
+}
+
+} // namespace book
