+// Debug trace: each visible enemy carrying 50+ gems in vision, our turn's branch and prey's verdict on it
+// ('-': prey did not run this turn).
+void trace_bags(const World& world, char decision) {
+    debug_block({
+        if (!world.me().alive) return;
+        const vec2 here = my_position();
+        for (const auto& e : world.enemies) {
+            if (!e.alive || !e.visible || pair_gems(world, e) < 50) continue;
+            char why = '-';
+            if (bag_notes_round == world.round)
+                for (int i = 0; i < n_bag_notes; ++i)
+                    if (bag_notes[i].handle == static_cast<std::uint32_t>(e.handle)) why = bag_notes[i].why;
+            std::printf("BCP %d %u %c %u %d %d %c %.2f %.2f %d %d %d\n", world.round, my_handle(), decision, static_cast<std::uint32_t>(e.handle),
+                        pair_gems(world, e), dist(here, e.pos), why, e.health / std::max(1.0f, e.max_health), my_health() / std::max(1.0f, my_max_health()),
+                        static_cast<int>(my_gems()), own_ground(world, e.pos) ? 1 : 0, static_cast<int>(e.channel));
+        }
+    });
+}
