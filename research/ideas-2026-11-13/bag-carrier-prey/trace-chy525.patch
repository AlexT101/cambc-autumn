+// Debug trace (bag-carrier-prey): what prey() made of each enemy carrying 50+ gems this turn.
+struct BagNote {
+    std::uint32_t handle;
+    char why;
+};
+std::array<BagNote, 8> bag_notes{};
+int n_bag_notes = 0, bag_notes_round = -1;
+void bag_note(const World& world, const ChampionBelief& e, char why) {
+    debug_block({
+        if (bag_notes_round != world.round) bag_notes_round = world.round, n_bag_notes = 0;
+        if (pair_gems(world, e) < 50) return;
+        for (int i = 0; i < n_bag_notes; ++i)
+            if (bag_notes[i].handle == static_cast<std::uint32_t>(e.handle)) { bag_notes[i].why = why; return; }
+        if (n_bag_notes < 8) bag_notes[n_bag_notes++] = {static_cast<std::uint32_t>(e.handle), why};
+    });
+}
