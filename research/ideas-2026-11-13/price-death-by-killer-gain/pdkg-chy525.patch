+float kill_gold(const ChampionBelief& e) {
+    float rate = e.treasure ? 1.0f + treasure_gold : 1.0f;
+    if (e.facts().passive == Passive::bonus_gold)
+        rate += static_cast<float>(cambc::constants::passive_abilities::vesper_vale_bonus_gold_percent) / 100.0f;
+    return (kill_gold_base + (e.hunter ? kill_gold_hunter : 0.0f)) * rate;
+}
+
+// The gold a kill pays is the killer's stats from its next purchase on: a fed carry's kills feed it
+// (Fish r8's Vesper, Hunter and Treasure, gets 2.1x the base). life_value prices a kill at the base gold.
+float fall_extra(const World& world, Safety& safety, std::uint32_t enemies, bool bag) {
+    float most = -1, gold = 0;
+    for (; enemies; enemies &= enemies - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(enemies))];
+        if (!e.alive) continue;
+        const auto& s = safety.strike_of(e);
+        float top = 0;
+        for (int d = 0; d <= s.reach && d <= Strike::max_reach; ++d) top = std::max(top, s.damage[static_cast<std::size_t>(d)]);
+        if (top > most) most = top, gold = kill_gold(e);
+    }
+    const float bag_gems = bag ? static_cast<float>(bag_at_stake(world)) : 0.0f;
+    const float extra = gold - kill_gold_base;
+    return params::gem_value * (bag_gems + (extra > 0 ? std::max(0.0f, prices(world).per_gold) * extra : 0.0f));
+}
+
