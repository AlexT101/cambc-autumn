+// A plan of its own, built ungated and its fuel refunded, so the bot's plan and fuel are as without it.
+void shadow_dash(char site, vec2 from, vec2 end) {
+#ifdef CAMBC_DEBUG
+    if (!shadow_world || !shadow_pathing || !shadow_safety || my_position() != from) return;
+    const auto& world = *shadow_world;
+    const std::uint64_t f0 = fuel();
+    if (f0 < 30000) {
+        debug_block({ std::printf("EDV %d %u %c %d %d %d %d gated %llu\n", world.round, my_handle(), site, from.x, from.y, end.x, end.y, static_cast<unsigned long long>(f0)); });
+        return;
+    }
+    static Plan sp;
+    sp.build(world, *shadow_pathing, *shadow_safety, false);
+    int kept = many, spent = many, keep = many, walk = many;
+    if (sp.active()) {
+        sp.at = from;
+        kept = sp.after_turn(end, true, false), spent = sp.after_turn(end, false, false), keep = sp.keep_dash(false);
+        const auto& blocked = shadow_pathing->blocked();
+        walk = sp.after_turn(from, true, false);
+        for (auto d : directions) {
+            const vec2 w = from + d;
+            if (in_bounds(w) && !test(blocked, w)) walk = std::min(walk, sp.after_turn(w, true, false));
+        }
+    }
+    const std::uint64_t f1 = fuel();
+    cambc::detail::sdk_fuel_adjust(static_cast<std::int64_t>(f0 - f1)); // positive refunds (probe-fueladjust)
+    debug_block({
+        std::printf("EDV %d %u %c %d %d %d %d act %d %d %d %d %d dn %d fuel %llu gems %d hp %.0f %.0f\n", world.round, my_handle(), site, from.x, from.y,
+                    end.x, end.y, sp.active() ? 1 : 0, kept, spent, keep, walk, sp.dash_now() ? 1 : 0, static_cast<unsigned long long>(f0),
+                    pair_gems(world, world.me()), my_health(), my_max_health());
+    });
+#else
+    (void)site, (void)from, (void)end;
+#endif
+}
