diff -ruN bots/variants/chy-ref/src/combat/screen.cc bots/variants/c11-int/src/combat/screen.cc
--- bots/variants/chy-ref/src/combat/screen.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/c11-int/src/combat/screen.cc	2026-11-13 07:41:32.617344627 +0000
@@ -0,0 +1,239 @@
+// The stun screen. A Prism's damage spells exclude walking, so a Prism must start its turn within cast
+// range to cast: the one that walks in gives the other side a turn before it casts. A stunner of ours
+// standing where it reaches every tile the enemy Prism could cast at ours from spends that turn
+// stunning it, which takes the turn it would cast in (abilities.stun). Taken only while the enemy
+// Prism can come within cast range of ours by the time the stunner reaches its station.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+namespace screen {
+
+// Our Prism's arrival estimate, posted in two bits of its priority payload (comms::screen_threat):
+// 0 none, else 1 + rounds, up to `posted_horizon` rounds.
+constexpr int posted_horizon = 2;
+
+// Stations lie off the 3x3 a ground spell on our Prism also hits, and within unit range of it.
+constexpr int station_min = ground_radius + 1, station_max = ability_range;
+
+const ChampionBelief* prism_of(const std::vector<ChampionBelief>& side) {
+    for (const auto& c : side)
+        if (c.alive && c.facts().passive == Passive::gem_focus) return &c;
+    return nullptr;
+}
+
+// e's walking rounds before it could cast at p from where it starts a turn (0: it can now), no
+// sooner than its first damage spell comes ready; horizon + 1 beyond `horizon`. Out of sight, only
+// while at least credible_weight of its possible tiles lie that near (Safety's weighting).
+int cast_arrival(const World& world, const ChampionBelief& e, vec2 p, int horizon) {
+    const int act = enemy_reach::act_range(e.facts());
+    int walk = horizon + 1;
+    if (e.visible) {
+        walk = std::max(0, enemy_reach::distance(world, e, enemy_reach::origin(e), p, act + horizon) - act);
+    } else if (e.tracked && possible_within(e, p, act + horizon)) {
+        const auto near = possible_count_within(e, p, act + horizon);
+        if (static_cast<float>(near) >= safety_params::credible_weight * static_cast<float>(board_count(e.possible)))
+            for (int k = 0; k <= horizon; ++k)
+                if (possible_within(e, p, act + k)) {
+                    walk = k;
+                    break;
+                }
+    }
+    int ready = horizon + 1;
+    for (int s = 0; s < 2; ++s)
+        if (e.facts().abilities[s].kind == AbilityKind::damage) ready = std::min(ready, std::max(0, e.ready_round[s] - world.round));
+    return std::min(horizon + 1, std::max(walk, ready));
+}
+
+// Our slot whose stun reaches farthest (with a walk where the stun allows one), or -1.
+int stun_slot(const ChampionFacts& f) {
+    int best = -1;
+    for (int s = 0; s < 2; ++s)
+        if (f.stun_reach(s) >= 0 && (best < 0 || f.stun_reach_with_walk(s) > f.stun_reach_with_walk(best))) best = s;
+    return best;
+}
+
+} // namespace screen
+
+// Our Prism's turn end: its own estimate of the enemy Prism's arrival, for screeners that see it.
+void post_screen_threat(const World& world) {
+    using namespace screen;
+    comms::screen_threat(world.round, 0);
+    if (!world.me().alive || world.me().facts().passive != Passive::gem_focus) return;
+    const auto* e = prism_of(world.enemies);
+    if (!e) return;
+    const vec2 here = my_position();
+    if (!in_bounds(here) || test(world.map().ally_spawn, here)) return;
+    const int t = cast_arrival(world, *e, here, posted_horizon);
+    if (t > posted_horizon) return;
+    comms::screen_threat(world.round, 1 + t);
+    debug_block({ std::printf("SCRP %d %u %d\n", world.round, my_handle(), t); });
+}
+
+struct ScreenPick {
+    vec2 q{-1, -1};
+    int steps = 0, t_e = 0;
+};
+
+// The station this stunner screens our Prism from this turn, if one is due: the enemy Prism can come
+// within cast range of ours within a round of our getting there, and not a round past our getting
+// there, by when its first casts are spent. A station covers its quickest way in (the tile within
+// cast range of ours nearest its last tile), else the bounding box of those within a round of it.
+std::optional<ScreenPick> find_station(World& world, Pathing& pathing, Safety& safety, const Memory& memory) {
+    using namespace screen;
+    const auto& me = world.me();
+    const auto& f = me.facts();
+    if (f.passive == Passive::gem_focus || memory.siege || stunned_turn || !my_can_move()) return std::nullopt;
+    const int slot = stun_slot(f);
+    if (slot < 0) return std::nullopt;
+    // Our Prism in sight: its tile is exact and its payload readable.
+    const auto* ours = prism_of(world.allies);
+    const auto* theirs = prism_of(world.enemies);
+    if (!ours || !theirs || !ours->visible || ours->is_self) return std::nullopt;
+    const auto& map = world.map();
+    const vec2 P = ours->pos, here = my_position();
+    if (!in_bounds(here) || test(map.ally_spawn, P)) return std::nullopt;
+    [[maybe_unused]] std::uint64_t fuel_start = 0;
+    debug_block({ fuel_start = fuel(); });
+    // No station is farther than far + station_max steps: an arrival a round past that is not due.
+    const int far = dist(here, P);
+    const int t_most = far + station_max + 1;
+    int t_e = cast_arrival(world, *theirs, P, t_most);
+    if (const auto told = comms::ally_screen_threat(world, *ours); told > 0) t_e = std::min(t_e, told - 1);
+    const auto why = [&](const char* r) -> std::optional<ScreenPick> {
+        debug_block({ std::printf("SCRX %d %u %s %d %d\n", world.round, my_handle(), r, t_e, static_cast<int>(fuel_start - fuel())); });
+        return std::nullopt;
+    };
+    if (t_e > t_most) return std::nullopt;
+    // The stun must be back by the turn after its arrival, when it would cast.
+    if (my_cooldown(slot) > t_e + 1) return why("cd");
+    // One screener: the stunner in our sight nearest our Prism (ties by index) whose stun is back by then.
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || !a.visible || a.facts().passive == Passive::gem_focus || test(map.ally_spawn, a.pos)) continue;
+        const int s = stun_slot(a.facts());
+        if (s < 0 || !a.ability_ready(s, world.round + t_e + 1)) continue;
+        const int d = dist(a.pos, P);
+        if (d < far || (d == far && a.index < me.index)) return why("rank");
+    }
+
+    // The tiles it could cast at ours from that it reaches first, by its last tile: within cast
+    // reach of ours, and within a round of its quickest way in. Out of sight that tile is stale, but
+    // it is still the side it was on.
+    const int act = enemy_reach::act_range(theirs->facts());
+    const vec2 ref = enemy_reach::origin(*theirs);
+    const bool aimed = in_bounds(ref);
+    const int m = aimed ? std::max(0, dist(ref, P) - act) : 0;
+    static bitboard scratch{cambc::uninitialized}, area{cambc::uninitialized};
+    const bitboard& reach = within(map.open_for_them, P, act);
+    if (aimed) {
+        clear_board(scratch);
+        draw_square(scratch, ref, static_cast<float>(m + 1));
+        and_into(reach, scratch, area);
+    } else copy_into(reach, area);
+    // Its quickest way in, and the bounding box of the rest: a Chebyshev reach covers the box from a
+    // tile iff it covers its corners.
+    int minx = map.width, maxx = -1, miny = map.height, maxy = -1;
+    vec2 first{-1, -1};
+    for (const vec2 a : Tiles<11 * 11>{area}) {
+        minx = std::min(minx, a.x), maxx = std::max(maxx, a.x), miny = std::min(miny, a.y), maxy = std::max(maxy, a.y);
+        if (aimed && (first.x < 0 || dist(a, ref) < dist(first, ref))) first = a;
+    }
+    if (maxx < 0) return std::nullopt;
+    const int cover = f.stun_reach_with_walk(slot);
+    // Every station covering its way in lies within cover of it: none in the window, none to list.
+    if (aimed && t_e > dist(here, first) + cover + 1) return why("early");
+    if (aimed && dist(here, first) - cover > t_e + 1) return why("late");
+
+    struct Station {
+        vec2 q;
+        int worst, steps, near;
+        // Listed only if covering its quickest way in; then the whole box first, the fewest steps, the
+        // least reach needed, nearest ours.
+        bool better(const Station& o, int cover) const {
+            if ((worst <= cover) != (o.worst <= cover)) return worst <= cover;
+            if (steps != o.steps) return steps < o.steps;
+            if (worst != o.worst) return worst < o.worst;
+            return near < o.near;
+        }
+    };
+    std::array<Station, 9 * 9> st;
+    int n = 0;
+    copy_into(within(map.open_for_us, P, station_max), area);
+    clear_board(scratch);
+    draw_square(scratch, P, static_cast<float>(station_min - 1));
+    drop(area, scratch);
+    drop(area, pathing.blocked());
+    int early = 0, late = 0, stunned = 0, lethal = 0;
+    for (const vec2 q : Tiles<9 * 9>{area}) {
+        if (aimed && dist(q, first) > cover) continue;
+        const int steps = dist(here, q);
+        if (t_e > steps + 1) {
+            ++early;
+            continue;
+        }
+        if (steps > t_e + 1) {
+            ++late;
+            continue;
+        }
+        const int worst = std::max({q.x - minx, maxx - q.x, q.y - miny, maxy - q.y});
+        st[static_cast<std::size_t>(n++)] = {q, worst, steps, dist(q, P)};
+    }
+    if (n == 0) return why(early ? "early" : late ? "late" : "none");
+    std::sort(st.begin(), st.begin() + n, [cover](const Station& a, const Station& b) { return a.better(b, cover); });
+    // Of the first few, the best on which no enemy can stun us (which
+    // would take the turn the screen is for) and no threat or camp can kill us before our next turn.
+    constexpr int checks = 8;
+    for (int i = 0; i < std::min(n, checks); ++i) {
+        const auto& c = st[static_cast<std::size_t>(i)];
+        if (safety.bound(c.q).stuns) {
+            ++stunned;
+            continue;
+        }
+        if (safety.lethal(c.q)) {
+            ++lethal;
+            continue;
+        }
+        debug_block({
+            std::printf("SCR %d %u %d %d %d %d %d %d %d %d %d %d %d %d %d\n", world.round, my_handle(), t_e, c.steps, c.q.x, c.q.y, P.x, P.y, ref.x,
+                        ref.y, c.worst, theirs->visible ? 1 : 0, static_cast<int>(fuel_start - fuel()), i,
+                        safety.touched(c.q) ? 1 : 0);
+        });
+        return ScreenPick{c.q, c.steps, t_e};
+    }
+    return why(stunned ? "stunned" : lethal ? "lethal" : "unchecked");
+}
+
+// A stunner's goal step to its station (find_station), or its hold there. The strike search, before
+// and after this step, casts the stun once the enemy Prism stands where it would cast from (stun_worth).
+bool stun_screen(World& world, Pathing& pathing, Safety& safety, const Memory& memory) {
+    const auto pick = find_station(world, pathing, safety, memory);
+    if (!pick) return false;
+    if (my_position() == pick->q) {
+        // Held: what the farm would hit from here without waking anything.
+        if (my_can_attack()) attack_camp(world, [&](int g) { return world.camps[g].awake != Awake::asleep; });
+        decision = Branch::screen;
+        return true;
+    }
+    static bitboard goal{cambc::uninitialized};
+    clear_board(goal);
+    set_tile(goal, pick->q);
+    world.throw_if_stale();
+    if (!pathing.step_towards(goal)) return false;
+    see_revealed(world, pathing, safety);
+    decision = Branch::screen;
+    return true;
+}
+
+// want_home sends a stunner home from any stand it could fall in, which is where every station lies
+// that reaches the enemy Prism's way in: while its stun is back for the screen and a station holds
+// (none it could be stunned or killed on before its next turn), the screen keeps it. Once the stun is
+// spent, want_home has the turn again.
+bool screen_keeps(World& world, Pathing& pathing, Safety& safety, const Memory& memory) {
+    return find_station(world, pathing, safety, memory).has_value();
+}
+
+} // namespace
+
+} // namespace aph
