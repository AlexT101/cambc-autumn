+float own_bag(const World& world, const ChampionBelief& a, int gems) {
+    if (gems <= 0) return 0.0f;
+    if (!keeps_bag(world, a, 0)) return static_cast<float>(gems);
+    return bag_worth(gems, kept_growth(world, a, 0), world.score.ally);
+}
+
+// prism_premium's mirror for enemy Prism e on the bag it holds (as last seen): their team's pace from their
+// score and the bags and stats we have seen (bodies unseen at the seen ones' mean output), its Focus as last read.
+// Zero, as keeps_bag for ours, once hurt (it would bank), their score and bag reach the win or too few rounds
+// are left to bank it.
+float enemy_premium(const World& world, const ChampionBelief& e) {
+    if (e.facts().passive != Passive::gem_focus || !e.alive || e.gems <= 0 || e.health < params::hurt_health_fraction * e.max_health)
+        return 0.0f;
+    const auto& map = world.map();
+    const int last = rounds_left(world) - map.width - map.height - endgame_margin - tribute_turns(e.gems, e.fast_tribute);
+    if (world.score.enemy + e.gems >= static_cast<int>(cambc::constants::winning_gems) || last <= 0) return 0.0f;
+    struct Kept {
+        int round = -1;
+        std::uint32_t observations = ~0u;
+        float per_output = 0, to_win = 0;
+    };
+    static Kept kept;
+    if (kept.round != world.round || kept.observations != world.observations) {
+        int collected = world.score.enemy, seen = 0;
+        float output = 0;
+        for (const auto& o : world.enemies) {
+            if (o.alive) collected += std::max(0, o.gems);
+            if (o.stats_round >= 0) output += camp_output(o), ++seen;
+        }
+        const float n = static_cast<float>(std::max<std::size_t>(1, world.enemies.size()));
+        output = seen > 0 ? output * n / static_cast<float>(seen) : n;
+        const float per_round = (static_cast<float>(collected) + n * income_prior_gems)
+                                / (static_cast<float>(std::max(0, world.round)) + prior_rounds_per_gem * income_prior_gems);
+        kept = {world.round, world.observations, per_round / std::max(1.0f, output),
+                static_cast<float>(std::max(0, static_cast<int>(cambc::constants::winning_gems) - collected)) / per_round};
+    }
+    const auto& f = e.facts();
+    const float per_gem = cambc::constants::passive_abilities::prism_focus_per_gem;
+    const float output = (f.raw_output(e.strength, e.focus + per_gem) - f.raw_output(e.strength, e.focus)) * camp_scale(e);
+    return std::expm1(output * kept.per_output * std::min(kept.to_win, static_cast<float>(last)));
+}
+
+float kill_bag(const World& world, const ChampionBelief& e, const ChampionBelief* killer) {
+    const int gems = pair_gems(world, e);
+    if (gems <= 0) return 0.0f;
+    const float gained = killer ? static_cast<float>(gems) * (1.0f + prism_premium(world, *killer, gems)) : static_cast<float>(gems);
+    return gained + bag_worth(e.gems, enemy_premium(world, e), world.score.enemy) - static_cast<float>(std::max(0, e.gems));
+}
