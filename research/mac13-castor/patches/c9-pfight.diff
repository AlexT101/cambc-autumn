+// The team's gems in hand short of the win (score `scored`): gems past it are worth nothing.
+float bag_worth(int gems, float premium, int scored) {
+    const float n = static_cast<float>(gems), room = static_cast<float>(static_cast<int>(cambc::constants::winning_gems) - scored);
+    return std::max(0.0f, std::min(n * (1.0f + premium), std::max(n, room)));
