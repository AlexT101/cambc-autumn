 // prism_premium's mirror for enemy Prism e on the bag it holds (as last seen): their team's pace from their
 // score and the bags and stats we have seen (bodies unseen at the seen ones' mean output), its Focus as last read.
-// Zero once their score and bag reach the win or too few rounds are left to bank it.
+// Zero, as keeps_bag for ours, once hurt (it would bank), their score and bag reach the win or too few rounds
+// are left to bank it.
 float enemy_premium(const World& world, const ChampionBelief& e) {
-    if (e.facts().passive != Passive::gem_focus || !e.alive || e.gems <= 0) return 0.0f;
+    if (e.facts().passive != Passive::gem_focus || !e.alive || e.gems <= 0 || e.health < params::hurt_health_fraction * e.max_health)
+        return 0.0f;
     const auto& map = world.map();
     const int last = rounds_left(world) - map.width - map.height - endgame_margin - tribute_turns(e.gems, e.fast_tribute);
     if (world.score.enemy + e.gems >= static_cast<int>(cambc::constants::winning_gems) || last <= 0) return 0.0f;
