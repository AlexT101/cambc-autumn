+    // carry it either way.
+    const auto& map = world.map();
+    const float held = std::max(0.0f, std::min(k.to_win, static_cast<float>(rounds_left(world) - map.width - map.height - endgame_margin
+                                                                             - tribute_turns(bag, a.fast_tribute))));
+    const float loss = static_cast<float>(bag) * params::bag_swing * -std::expm1(-k.hazard * held);
+    return k.per_round * channel + loss > k.own * (1.0f + p) * (static_cast<float>(2 * k.near) + channel) + static_cast<float>(bag) * p;
