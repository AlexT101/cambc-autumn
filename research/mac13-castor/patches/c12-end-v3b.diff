+        std::uint32_t observations = ~0u, mine = ~0u;
+        vec2 pos{-1, -1};
+        float lambda = 0, per_round = 0, own = 0, hazard = 0, to_win = 0;
+        int near = unreachable;
+    };
+    static std::array<Kept, 16> kept;
+    auto& k = kept[static_cast<std::size_t>(a.index) & 15];
+    if (k.round != world.round || k.observations != world.observations || k.mine != my_gems() || k.pos != a.pos) {
+        const auto& tf = team_farm(world);
+        // The nearest altar no enemy lock (as we believe) refuses our tribute at.
+        int near = unreachable;
+        const auto& altars = world.map().altars;
+        for (std::size_t i = 0; i < altars.size(); ++i)
+            if (!world.altars[i].enemy_lock)
+                near = std::min(near, std::max(0, dist(a.pos, altars[i].pos) - static_cast<int>(cambc::constants::submit_gems_range)));
+        k = {world.round, world.observations, my_gems(), a.pos, channel_hazard(), tf.per_round, camp_output(a) * tf.per_output,
+             carrier_hazard(), tf.to_win, near};
+    }
+    if (k.near == unreachable) return false;
+    const float lambda = k.lambda;
+    // A channel of the bag's turns (continuous, a turn per 10 gems less a Tribute emblem's third), with restarts.
+    const float share = static_cast<float>(bag) / gems_per_tribute_turn * (a.fast_tribute ? 1.0f - tribute_emblem_cut / 100.0f : 1.0f);
+    const float channel = std::expm1(lambda * share) / lambda;
+    // The premium, to the win's room.
+    const int room = std::max(0, static_cast<int>(cambc::constants::winning_gems) - world.score.ally - bag);
+    const float p = std::min(prism_growth(world, a, gems), static_cast<float>(room) / static_cast<float>(bag));
