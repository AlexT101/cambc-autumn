+// Our tribute channels started to complete (submit_here's, not Mite's turn-end habit, which the next turn
+// cancels at will): turn ends channelled and restarts, a channel that ended with its bag still carried.
+struct ChannelRecord {
+    int bag = 0, round = -1;
+    bool on = false, deliberate = false, cancelled = false; // cancelled: by us, this turn, before its turn end
+    float restarts = 0, turns = 0;
+} own_channels;
+
+void note_tribute_start(const World& world, bool deliberate) {
+    auto& c = own_channels;
+    // Still on at this turn's note and started again: we cancelled it this turn.
+    if (c.on && c.deliberate && c.round == world.round) c.restarts += 1;
+    c.on = true, c.deliberate = deliberate, c.cancelled = false, c.bag = static_cast<int>(my_gems()), c.round = world.round;
+}
+
+void note_own_cancel() { own_channels.cancelled = true; }
+
+void note_channels(const World& world) {
+    auto& c = own_channels;
+    if (!c.on || world.round == c.round) return;
+    const bool alive = world.me().alive;
+    const bool channelling_now = alive && my_state().contains(cambc::champion_state::submitting_gems);
+    if (c.deliberate) {
+        // A channel ticked every turn end since the last note, but for the last one when we cancelled it in our turn
+        // (a stun or lock lands after it).
+        const bool restarted = !channelling_now && alive && my_gems() >= static_cast<std::uint32_t>(c.bag);
+        c.turns += static_cast<float>(world.round - c.round - (restarted && c.cancelled ? 1 : 0));
+        if (restarted) c.restarts += 1;
+    }
+    c.on = channelling_now, c.cancelled = false, c.round = world.round;
+}
+
+// The posterior mean of a tribute channel's restart hazard a turn: a Gamma prior worth one restart at
+// params::channel_hazard, updated with our own channels' restarts and turns.
+float channel_hazard() {
+    return (1 + own_channels.restarts) / (1 / params::channel_hazard + own_channels.turns);
+}
