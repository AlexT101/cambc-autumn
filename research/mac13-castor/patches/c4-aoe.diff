+float clear_output(const World& world, int g, float strength, const AreaOutput& area) {
+    const auto& map = world.map();
+    const auto& belief = world.camps[g];
+    if (belief.state == CampState::cleared || !area_helps(map, g, area)) return strength;
+    if (!(strength > 0)) return strength;
+    // The output scales with `strength` at fixed rates per point of it, so it is kept by those ratios: Heart of
+    // Ruin's health moves both together.
+    const AreaOutput ratio = area.scaled(1.0f / strength);
+    struct Slots {
+        std::uint32_t version = ~0u;
+        int count = 0, next = 0;
+        std::array<float, 4> scale{};
+        std::array<AreaOutput, 4> ratio{};
+    };
+    static std::array<Slots, 256> cache;
+    static Slots uncached;
+    const bool kept = static_cast<std::size_t>(g) < cache.size();
+    auto& c = kept ? cache[g] : uncached;
+    if (c.version != belief.version || !kept) c.version = belief.version, c.count = c.next = 0;
