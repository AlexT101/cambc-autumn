+const TeamFarm& team_farm(const World& world) {
+    static TeamFarm kept;
+    static int round = -1;
+    static std::uint32_t observations = ~0u, gems = ~0u;
+    if (round == world.round && observations == world.observations && gems == my_gems()) return kept;
