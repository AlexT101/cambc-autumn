+// The farm's rho: our income per turn alive in the farm's worth, gems at `gem_worth` each and base
+// gold at `per_gold`, prior-weighted as income_rates. It is the gain of the policy we play, the one
+// policy iteration improves on: a round more on a job delays all that follows by a round, so costs it.
+float farm_income_rate(const World& world, float gem_worth, float per_gold) {
+    const float gems = income.gems + income_prior_gems;
+    const float gold = income.capture_gold + income_prior(world.map()).gold * income_prior_gems;
+    const float turns = static_cast<float>(upkeep.turns) + prior_rounds_per_gem * income_prior_gems;
+    return (gem_worth * gems + std::max(0.0f, per_gold) * gold) / turns;
+}
