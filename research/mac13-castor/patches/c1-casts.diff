diff -ruN bots/variants/chy-ref/src/combat/free_cast.cc bots/variants/c1-casts/src/combat/free_cast.cc
--- bots/variants/chy-ref/src/combat/free_cast.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/c1-casts/src/combat/free_cast.cc	2026-11-13 03:06:37.619370636 +0000
@@ -0,0 +1,287 @@
+// Free casts: a damage spell on a camp our team will clear, at the turn's end of a turn that has
+// not walked. The turn's walks are over, so an excludes-walking spell forgoes nothing; camps never
+// regenerate, so the damage stays until the group is cleared.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// An enemy champion could stand within `reach` of `here` after `turns` of its turns: a step a turn
+// and one dash. An unseen one is counted from `possible` while tracked, else from its last tile
+// grown since; one unseen for over a cooldown is counted nowhere, as Safety counts it.
+// Returns why: 1 a visible enemy, 2 a tracked one, 3 one seen within the cooldown, 4 a respawn; 0 for none.
+int enemy_within_turns(const World& world, vec2 here, int reach, int turns) {
+    for (const auto& e : world.enemies) {
+        const int moves = turns + (e.facts().has_dash() ? dash_range : 0);
+        if (!e.alive) {
+            // A respawn within the horizon returns on its spawn.
+            const int back = e.respawn_earliest - world.round;
+            if (e.respawn_earliest >= 0 && back <= turns && dist(here, world.map().enemy_spawn_centre) <= reach + moves - std::max(0, back))
+                return 4;
+            continue;
+        }
+        if (e.visible) {
+            if (dist(here, enemy_reach::origin(e)) <= reach + moves) return 1;
+            continue;
+        }
+        if (e.tracked && !board_empty(e.possible)) {
+            if (possible_within(e, here, reach + moves)) return 2;
+            continue;
+        }
+        const int age = e.age(world.round);
+        if (e.pos.x < 0 || age > ability_cooldown) continue;
+        const int since = age + (e.facts().has_dash() ? dash_range * (1 + age / ability_cooldown) : 0);
+        if (dist(here, e.pos) - since <= reach + moves) return 3;
+    }
+    return 0;
+}
+
+// Whether a slot cast now could be missed in a duel before it is back. A stun slot (and both of
+// Prism's, its opener and its burst) is kept while an enemy could reach its range within the
+// cooldown; another damage slot only while one could by its next turn.
+int keep_for_duel(const World& world, vec2 here, int slot) {
+    const auto& f = world.me().facts();
+    const auto& a = f.abilities[slot];
+    const bool duel = a.stuns || f.passive == Passive::gem_focus;
+    const int turns = duel ? ability_cooldown : 1;
+    if (const int why = enemy_within_turns(world, here, a.reach(), turns)) return why;
+    // The beliefs predate a ward placed at this turn's end: the enemies in sight now, any dasher's reach.
+    static bitboard seen{cambc::uninitialized};
+    occupancy_into(team::enemy, seen);
+    return any_within(seen, here, a.reach() + turns + dash_range) ? 1 : 0;
+}
+
+// The group our team will clear: 'c' ours (claim or farm choice), 'a' an ally's claim, 's' on our
+// side or the mid with no enemy seen working it; 0 for none.
+char clear_kind(const World& world, const Memory& memory, int g) {
+    if (g == memory.claim || g == memory.farm_group) return 'c';
+    for (const auto& a : world.allies)
+        if (!a.is_self && comms::claim_of(world, a.index) == g) return 'a';
+    const auto& map = world.map();
+    if (home_side(map, g, false) < 0.5f) return 0;
+    const auto& G = map.groups[g];
+    const auto& c = world.camps[g];
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible) continue;
+        const int act = enemy_reach::act_range(e.facts());
+        for (std::size_t i = 0; i < G.members.size(); ++i)
+            if (c.health[i] > 0 && dist(e.pos, G.members[i].pos) <= act) return 0;
+    }
+    return 's';
+}
+
+// An ally claiming g is in our sight.
+bool claimer_seen(const World& world, int g) {
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible && comms::claim_of(world, a.index) == g) return true;
+    return false;
+}
+
+// A group's reward per camp health point left, in enemy health points (params::gem_value a gem):
+// its gems and gold, at our gold price and bonuses, over its live health.
+float reward_per_health(const World& world, int g, float live_health, float per_gold) {
+    if (live_health <= 0) return 0;
+    const auto& G = world.map().groups[g];
+    const float gems = static_cast<float>(G.gems) + per_gold * static_cast<float>(G.gold);
+    return gems * params::gem_value / live_health;
+}
+
+struct FreeCast {
+    Cast cast;
+    // Traces: the slots a duel keeps, and the groups in reach that no team clear, a wake refused, or that had no target.
+    int kept = 0, kept_why = 0, unclaimed = 0, woken = 0, unseen = 0, groups = 0;
+    float net = 0, value = 0, deferred = 0;
+    int group = -1;
+    char kind = 0;
+    bool kills = false; // takes a member's last health
+};
+
+FreeCast plan_free_cast(const World& world, const Memory& memory) {
+    FreeCast best;
+    const auto& f = world.me().facts();
+    const vec2 here = my_position();
+    std::array<bool, 2> ready{};
+    int reach = -1;
+    for (int s = 0; s < 2; ++s) {
+        const auto& a = f.abilities[s];
+        // Not a landing (Heart of Ruin's), which moves us: off a hold, or onto a way the goal did not choose.
+        ready[s] = a.kind == AbilityKind::damage && castable(world, s);
+        if (const int why = ready[s] ? keep_for_duel(world, here, s) : 0) ready[s] = false, ++best.kept, best.kept_why |= 1 << why;
+        if (ready[s]) reach = std::max(reach, a.reach());
+    }
+    if (reach < 0) {
+        debug_block({
+            // The groups the kept slots would have reached, for the trace.
+            if (best.kept > 0)
+                for (int g : world.map().groups_near(here, ability_range + ground_radius)) best.groups += world.camps[g].state == CampState::alive;
+        });
+        return best;
+    }
+    const auto& map = world.map();
+    std::array<int, 16> near;
+    int n = 0;
+    for (int g : map.groups_near(here, reach))
+        if (n < static_cast<int>(near.size())) near[static_cast<std::size_t>(n++)] = g;
+    if (n == 0) return best;
+    const float dealt = monster_dealt_factor();
+    const std::array<float, 2> raw{ready[0] ? raw_damage(0) * dealt : 0.0f, ready[1] ? raw_damage(1) * dealt : 0.0f};
+    const float health = my_health_and_shield(world);
+    const float per_gold = prices(world).per_gold * gold_paid(world); // gems a base gold of a capture is worth to us
+    // The farm group's next cast: a slot spent now is back ability_cooldown rounds later, so the cast
+    // the farm would make from its stand (attack range) in k turns, not this one, waits the rest:
+    // over the slot's cycles the spend gains k / cooldown of a cast on our own group, and on another
+    // costs (1 - k / cooldown) of the farm's.
+    const int fg = memory.farm_group;
+    int farm_near = unreachable;
+    float farm_rate = 0;
+    if (fg >= 0 && fg < static_cast<int>(world.camps.size()) && world.camps[fg].state == CampState::alive) {
+        const auto& G = map.groups[fg];
+        float live = 0;
+        for (std::size_t i = 0; i < G.members.size(); ++i)
+            if (const float h = world.camps[fg].health[i]; h > 0) live += h, farm_near = std::min(farm_near, dist(here, G.members[i].pos));
+        farm_rate = reward_per_health(world, fg, live, per_gold);
+    }
+
+    struct Member {
+        int index; // in the group
+        vec2 pos;
+        float health, stun;
+    };
+    static std::vector<Member> members;
+    static std::vector<Target> targets;
+    static bitboard skip{cambc::uninitialized};
+    for (int k = 0; k < n; ++k) {
+        const int g = near[static_cast<std::size_t>(k)];
+        const auto& G = map.groups[g];
+        const auto& c = world.camps[g];
+        if (c.state != CampState::alive || (G.has_monolith && !(g == memory.claim && c.fully_awake()))) continue;
+        ++best.groups;
+        const char kind = clear_kind(world, memory, g);
+        if (!kind) {
+            ++best.unclaimed;
+            continue;
+        }
+        // Waking: every asleep member wakes, and each striker then hits the nearest champion in its
+        // range each camp phase. Its fire on us would cancel the turn-end recall and reads as camp
+        // fire to the hold and the steps (camp_damage > 0), and is worth more than a cast's damage on
+        // every striker type (a phase of Strength against the spell's share of the reward): a woken
+        // striker reaching us or an ally refuses the group.
+        // The ally working its claim may stand unseen in a striker's reach; a siege target waits for the
+        // team to gather (siege()), and wakes only when it does.
+        bool refused = G.strength > 0 && !c.fully_awake() && ((g == siege_group() || (g == memory.claim && memory.siege)) || (kind == 'a' && !claimer_seen(world, g)));
+        if (!c.fully_awake() && !refused)
+            for (std::size_t i = 0; i < G.members.size() && !refused; ++i) {
+                const auto& m = G.members[i];
+                if (!(c.health[i] > 0) || m.strength <= 0 || !c.maybe_asleep(i)) continue;
+                refused = dist(here, m.pos) <= m.reach;
+                for (const auto& a : world.allies)
+                    if (!a.is_self && a.alive && a.visible && dist(a.pos, m.pos) <= m.reach) refused = true;
+            }
+        if (refused) {
+            ++best.woken;
+            continue;
+        }
+        members.clear();
+        float live = 0;
+        for (std::size_t i = 0; i < G.members.size(); ++i) {
+            const auto& m = G.members[i];
+            float h = c.health[i];
+            if (cambc::vision::has_camp(m.pos)) {
+                static cambc::detail::camp_state record;
+                if (cambc::detail::sdk_camp(m.handle, &record) == 0) {
+                    h = record.health;
+                    if (h > 0) {
+                        // A stun skips the next attack of an awake striker, which goes to the nearest champion: one
+                        // of us when any of us is in its range (woken ones in range were refused above).
+                        bool exposed = m.strength > 0 && dist(here, m.pos) <= m.reach;
+                        for (std::size_t j = 0; j < world.allies.size() && m.strength > 0 && !exposed; ++j)
+                            exposed = world.allies[j].alive && world.allies[j].visible && dist(world.allies[j].pos, m.pos) <= m.reach;
+                        const float stun = exposed && !camp_stunned(m.handle) ? m.strength : 0.0f;
+                        members.push_back({static_cast<int>(i), m.pos, h, stun});
+                    }
+                }
+            }
+            live += std::max(0.0f, h);
+        }
+        if (members.empty()) {
+            ++best.unseen;
+            continue;
+        }
+        const float rate = reward_per_health(world, g, live, per_gold);
+        for (int s = 0; s < 2; ++s) {
+            if (!ready[s]) continue;
+            const auto& a = f.abilities[s];
+            const auto worth = [&](const Member& m) { return std::min(raw[s], m.health) * rate + (a.stuns ? m.stun : 0.0f); };
+            Cast cast;
+            bool kills = false;
+            if (a.target == Targeting::unit) {
+                for (const auto& m : members)
+                    if (dist(here, m.pos) <= a.range())
+                        if (const float v = worth(m); v > cast.value) cast = Cast{s, v, std::nullopt, G.camp(m.index), {}}, kills = raw[s] >= m.health;
+            } else {
+                targets.clear();
+                for (const auto& m : members) targets.push_back({m.pos, 1, worth(m)});
+                // Off other groups (each would wake), and off a tracked Ren whose retaliation kills us.
+                clear_board(skip);
+                // A group believed respawning may be back, asleep and out of sight, once its round has come.
+                for (int o = 0; o < n; ++o) {
+                    const int other = near[static_cast<std::size_t>(o)];
+                    if (other == g) continue;
+                    if (const auto& oc = world.camps[other]; oc.state == CampState::alive) draw_alive_members(world, other, skip);
+                    else if (oc.state == CampState::respawning && oc.respawn_round <= world.round + 1)
+                        for (const auto& m : map.groups[other].members) draw_square(skip, m.pos, static_cast<float>(ground_radius));
+                }
+                for (const auto& e : world.enemies)
+                    if (unseen_suicidal(e, health, world.me().taken))
+                        for (auto p : positions_within(e.possible, here, a.reach())) draw_square(skip, p, static_cast<float>(ground_radius));
+                cast = best_ground(s, 0.01f, targets, here, a.range(), skip);
+                for (const auto& m : members) kills = kills || (cast.slot >= 0 && dist(cast.tile, m.pos) <= ground_radius && raw[s] >= m.health);
+            }
+            if (cast.slot < 0) continue;
+            float deferred = 0;
+            if (farm_rate > 0 && farm_near != unreachable) {
+                const int stand = f.ranged && f.cast_reach() > f.attack_range() ? a.range() : f.attack_range();
+                const int wait = std::max(1, farm_near - stand);
+                deferred = (g == fg ? cast.value : raw[s] * farm_rate) * std::max(0.0f, 1.0f - static_cast<float>(wait) / static_cast<float>(ability_cooldown));
+            }
+            const float net = cast.value - deferred;
+            if (net > best.net)
+                best.cast = cast, best.net = net, best.value = cast.value, best.deferred = deferred, best.group = g, best.kind = kind, best.kills = kills;
+        }
+    }
+    return best;
+}
+
+// The planning's least fuel: camp reads and a ground search per slot and group in reach.
+inline constexpr std::uint64_t free_cast_least = 4000;
+
+bool free_camp_cast(const World& world, const Memory& memory) {
+    if (stunned_turn || !world.me().alive || channelling() || !my_can_cast() || my_position() != world.turn_start
+        || !fuel_ok(end_reserve + free_cast_least))
+        return false;
+    world.throw_if_stale();
+    try {
+        const auto plan = plan_free_cast(world, memory);
+        debug_block({
+            // A turn with a damage slot ready and a live group in reach that cast nothing, and why.
+            if (plan.cast.slot < 0 && (plan.groups > 0 || plan.kept > 0))
+                std::printf("FCX %d %u %d %c %d %d %d %d %d %d\n", world.round, my_handle(), static_cast<int>(world.me().type), static_cast<char>(decision),
+                            plan.kept, plan.groups, plan.unclaimed, plan.woken, plan.unseen, plan.kept_why);
+        });
+        if (plan.cast.slot < 0) return false;
+        const bool cast = execute_camp_cast(world, [&] { return plan.cast; });
+        debug_block({
+            if (cast)
+                std::printf("FC %d %u %d %d %d %c %c %.1f %.1f %d\n", world.round, my_handle(), static_cast<int>(world.me().type), plan.cast.slot,
+                            plan.group, plan.kind, static_cast<char>(decision), plan.value, plan.deferred, plan.kills ? 1 : 0);
+        });
+        return cast;
+    } catch (const cambc::error&) {
+        return false;
+    }
+}
+
+} // namespace
+
+} // namespace aph
