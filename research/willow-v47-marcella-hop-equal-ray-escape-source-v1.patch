+// With no visible enemy, compare a camp dash's whole activation against its connected walk.
+bool connected_camp_dash(World& world, Pathing& pathing, Safety& safety, const Field& home, bool& connected) {
+    connected = false;
+    const vec2 here = my_position();
+    if (enemy_seen(world) || safety.camp_damage(here) <= 0) return false;
+    const int slot = world.me().facts().slot_of(AbilityKind::dash);
+    if (slot < 0 || !my_can_cast() || my_cooldown(slot) > 0) return false;
+    const auto& escape = pathing.camp_escape(safety.camp_area(), world.map().max_camp_reach + 1, true);
+    if (!escape.exact || escape.steps == unreachable) return false;
+    connected = true;
+    const bool walking = my_can_move();
+    const auto ordinary = walking ? camp_escape_step(world, pathing, safety, home) : std::nullopt;
+    const vec2 normal = ordinary ? *ordinary : here;
+    const int normal_steps = *escape.at(normal);
+    const float normal_damage = safety.damage_bound(normal);
+    struct Endpoint { int steps; float damage; };
+    Unwritten<Endpoint, 49> points;
+    std::array<bool, 49> evaluated{};
+    const auto endpoint = [&](vec2 p) -> const Endpoint& {
+        const int i = p.x - here.x + 3 + 7 * (p.y - here.y + 3);
+        if (!evaluated[i]) {
+            evaluated[i] = true;
+            const auto steps = escape.at(p);
+            points.a[i] = {steps ? *steps : unreachable, 0};
+            if (steps && *steps < normal_steps) points.a[i].damage = safety.damage_bound(p);
+        }
+        return points.a[i];
+    };
+    vec2 landing{-1, -1}, finish{-1, -1};
+    int best_steps = normal_steps, best_home = unreachable;
+    float best_damage = normal_damage;
+    for (const auto p : Tiles<25>{pathing.dash_landings()}) {
+        const auto consider = [&](vec2 q) {
+            if (!in_bounds(q)) return;
+            const auto& e = endpoint(q);
+            if (e.steps == unreachable || e.steps >= normal_steps || e.damage > normal_damage) return;
+            const int home_steps = home.at(q);
+            if (e.steps < best_steps || (e.steps == best_steps && (e.damage < best_damage
+                || (e.damage == best_damage && home_steps < best_home))))
+                landing = p, finish = q, best_steps = e.steps, best_damage = e.damage, best_home = home_steps;
+        };
+        consider(p);
+        if (walking) for (const auto d : directions) consider(p + d);
+    }
+    if (landing.x < 0) return false;
+    if (!camp_escape_dash(world, pathing, landing)) {
+        see_again(world, pathing, safety);
+        return false;
+    }
+    see_again(world, pathing, safety);
+    world.throw_if_stale();
+    // A newly revealed enemy takes the existing enemy escape; no stale endpoint is imposed.
+    if (enemy_seen(world)) {
+        retreat_step(world, pathing, safety, home);
+        return true;
+    }
+    const vec2 now = my_position();
+    if (safety.camp_damage(now) <= 0) return true;
+    if (my_can_move() && dist(now, finish) == 1) {
+        const auto& fresh = pathing.camp_escape(safety.camp_area(), world.map().max_camp_reach + 1, true);
+        const auto remaining = fresh.at(finish);
+        const auto step = camp_escape_step(world, pathing, safety, home);
+        const float ordinary_damage = safety.damage_bound(step ? *step : now);
+        if (remaining && *remaining < fresh.steps && safety.damage_bound(finish) <= ordinary_damage) {
+            bool refused = true;
+            if (pathing.try_move(finish, &refused)) return true;
