+bool Safety::channel_enemy_may_reach(vec2 p, int activations) {
+    for (const auto& e : world_.enemies) {
+        if (!e.alive && e.respawn_earliest > world_.round + activations - 1) continue;
+        const auto& f = e.facts();
+        int reach = f.attack_range() + (f.passive == Passive::splash_attack ? 1 : 0);
+        for (const auto& ability : f.abilities)
+            if (ability.hits_enemies()) reach = std::max(reach, ability.reach());
+        // A ready mobility slot can be used once; kill resets may ready it each activation.
+        reach += activations + (f.has_dash() ? 2 * (f.passive == Passive::reset_on_kill ? activations : 1) : 0);
+        if (!e.alive) {
+            if (any_within(world_.map().enemy_spawn, p, reach)) return true;
+        } else if (e.visible) {
+            if (dist(p, e.pos) <= reach) return true;
+            if (e.teleport_pending() && (!in_bounds(e.tp_dest) || dist(p, e.tp_dest) <= reach)) return true;
+        } else {
+            // Ordinary credibility omits expired fixes; this does not prove unseen enemies absent.
+            if (!e.tracked) continue;
+            const int tiles = static_cast<int>(board_count(e.possible));
+            if (unseen_weight(reach, tiles) > 0 && any_within(e.possible, p, reach)) return true;
+        }
+    }
+    return false;
+}
