+// Current sleep/stuns/tanks cannot fund a three-phase commitment; known respawns count too.
+float farm_hop_camp_phase(const World& world, vec2 p, int round) {
+    float raw = 0;
+    for (const int g : world.map().groups_near(p, world.map().max_camp_reach)) {
+        const auto& c = world.camps[g];
+        if (c.state == CampState::cleared || (c.state == CampState::respawning && c.respawn_round > round)) continue;
+        const auto& G = world.map().groups[g];
+        for (int i = 0; i < static_cast<int>(G.members.size()); ++i) {
+            const auto& member = G.members[i];
+            if (member.strength > 0 && dist(p, member.pos) <= member.reach
+                && (c.state == CampState::respawning || c.health[i] > 0)) raw += member.strength;
+        }
+    }
+    return raw * camp_hit_factor();
+}
