+// A full kit and both bodies' best movement are generous bounds: failure proves nothing.
+unsigned deferred_stand_allies(const World& world, unsigned allies, unsigned enemies) {
+    std::array<int, max_fighters> enemy_reach, enemy_move;
+    int count = 0;
+    for (auto left = enemies; left; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (!e.alive || !e.visible || e.pos_round != world.round || e.stats_round != world.round
+            || e.teleport_pending() || e.respawned_round >= world.round || count == max_fighters) return 0;
+        enemy_reach[count] = compute_strike(e.facts(), hit_strength(e), hit_focus(e), 3u).reach;
+        enemy_move[count++] = e.facts().has_dash() ? 3 : 1;
+    }
+    unsigned deferred = 0;
+    for (auto left = allies; left; left &= left - 1) {
+        const int i = std::countr_zero(left);
+        const auto& a = world.allies[static_cast<std::size_t>(i)];
+        const auto& f = a.facts();
+        if (a.is_self || !a.alive || !a.visible || a.pos_round != world.round || a.stats_round != world.round
+            || a.acted || a.stun_pending || a.teleport_pending() || a.respawned_round >= world.round
+            || f.passive == Passive::linked_pair || f.has(AbilityKind::heal) || f.has(AbilityKind::shield)) continue;
+        const int reach = compute_strike(f, hit_strength(a), hit_focus(a), 3u).reach;
+        const int move = f.has_dash() ? 3 : 1;
+        bool separate = count > 0;
+        int k = 0;
+        for (auto foes = enemies; foes && separate; foes &= foes - 1, ++k) {
+            const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(foes))];
+            const int d = dist(a.pos, e.pos);
+            separate = d > reach + enemy_move[k] && d > enemy_reach[k] + move;
+        }
+        if (separate) deferred |= 1u << i;
+    }
+    return deferred;
+}
