+// These bodies cannot take part in either activation of exchange zero. Positions retain the
+// original roster order, including weakest-health ties and our watched fighter's identity.
+struct PendingAllies {
+    Side side;
+    unsigned positions = 0;
+
+    void join(Side& us) const {
+        Side joined;
+        joined.turn = us.turn;
+        joined.stunned = us.stunned;
+        joined.camp = us.camp;
+        int local = 0, remote = 0;
+        const int count = us.count + side.count;
+        for (int i = 0; i < count; ++i) {
+            const bool pending = positions >> i & 1;
+            Fighter f = pending ? side.fighters[remote++] : us.fighters[local++];
+            if (!pending && local - 1 == us.self) joined.self = i;
+            f.link = -1; // add() rebuilds local linked pairs after their indices move
+            // Its previous own turn passed while absent; the joining turn has not begun yet.
+            if (pending && f.shield_until < joined.turn) f.shield = 0, f.shield_until = never;
+            joined.add(f);
+        }
+        us = joined;
+    }
+};
