+// The (round, handle) of the last enemy that only gank made preyable, for the GANK trace.
+namespace {
+int gank_round = -1;
+std::uint32_t gank_handle = 0;
+} // namespace
+
+// A visible enemy Prism, the first of a team to die losing most games, alone (no other enemy, seen or
+// credibly unseen, within gank_alone of it) and outnumbered: two or more of us within gank_reach whose
+// basic attacks kill it in gank_turns turns.
+bool gank(const World& world, Safety& safety, const ChampionBelief& e, vec2 here) {
+    constexpr int gank_alone = 6, gank_reach = 8, gank_turns = 2;
+    if (!e.visible || e.facts().passive != Passive::gem_focus) return false;
+    for (const auto& o : world.enemies)
+        if (&o != &e && o.alive && o.visible && dist(o.pos, e.pos) <= gank_alone) return false;
+    int n = 0;
+    float dealt = 0;
+    for (const auto& a : world.allies) {
+        if (!a.alive) continue;
+        if (a.is_self) {
+            if (dist(here, e.pos) > gank_reach) continue;
+            dealt += my_strength() * damage_scale(a.facts().passive, my_health(), my_max_health()) * champion_dealt_factor();
+        } else {
+            if (!a.visible || dist(a.pos, e.pos) > gank_reach) continue;
+            dealt += a.strength * a.damage_scale();
+        }
+        ++n;
+    }
+    if (n < 2 || gank_turns * dealt < effective_hp(e)) return false;
+    return !safety.unseen_within(e.pos, gank_alone);
+}
