diff -ruN bots/variants/charybdis-ref/src/bot_parts.h bots/variants/e7-idle/src/bot_parts.h
--- bots/variants/charybdis-ref/src/bot_parts.h	2026-11-11 18:57:46.618240524 +0000
+++ bots/variants/e7-idle/src/bot_parts.h	2026-11-11 22:03:03.421875417 +0000
@@ -217,10 +217,13 @@
 // Empty-handed, the way to a group by way of spawn, in rounds: the recall's `channel`, `hurt` (the
 // heal turn), the walk `out` from spawn and any wait for its respawn `respawn` rounds away, less
 // `value`, what the stop is worth as HomeTrip prices it (the heal, and the next emblem if our gold
-// completes it). Never below the channel.
+// completes it). Never below the channel. `idle`: a Prism whose stop is worth something (hurt, or a
+// shard affordable), keeping its gems: a stop home that lands no later than the respawn costs it no
+// field time against walking there and waiting.
 struct FarmRecall {
     int channel = 0, hurt = 0;
     float value = 0;
+    bool idle = false;
     float rounds(int out, int respawn) const {
         if (out == unreachable) return static_cast<float>(unreachable);
         const int arrive = std::max(channel + hurt + out, respawn);
@@ -230,8 +233,12 @@
     // arrives before the respawn (the recall only waits it out, and walking keeps us free to act),
     // nor for a wait farm would not take.
     float sooner(int out, int respawn, int walk) const {
-        if (out == unreachable || walk == unreachable || respawn >= walk || respawn - (channel + hurt + out) > params::max_wait)
-            return static_cast<float>(unreachable);
+        if (out == unreachable || walk == unreachable) return static_cast<float>(unreachable);
+        // Landing out by the respawn, its wait moves from the group to the stop, so farm's cap on it
+        // does not apply. Not tested against the walk: standing to channel, the walk stays while the respawn
+        // runs down, and the recall must stay kept once started.
+        if (idle && respawn > 0 && channel + 1 + out <= respawn) return rounds(out, respawn);
+        if (respawn >= walk || respawn - (channel + hurt + out) > params::max_wait) return static_cast<float>(unreachable);
         const float via = rounds(out, respawn);
         return via < static_cast<float>(walk) ? via : static_cast<float>(unreachable);
     }
