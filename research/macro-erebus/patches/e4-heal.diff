+// so that a big bag does not keep us home for good. 0 for the rest. `capped`: whether the cap binds.
+float prism_line(const World& world, bool* capped) {
+    if (capped) *capped = false;
+    const auto& self = world.me();
+    if (self.facts().passive != Passive::gem_focus) return 0;
+    float burst = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus) continue;
+        float mult = 0;
+        for (const auto& a : e.facts().abilities)
