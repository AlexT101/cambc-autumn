diff -ruN bots/variants/charybdis-ref/src/combat/spacing.cc bots/variants/e6-nofeed/src/combat/spacing.cc
--- bots/variants/charybdis-ref/src/combat/spacing.cc	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/e6-nofeed/src/combat/spacing.cc	2026-11-11 21:16:44.802198723 +0000
@@ -0,0 +1,203 @@
+// Spacing from the enemy Prism: while no Prism of ours is alive, a champion of ours ends no turn where
+// the enemy Prism could open on it before our next turn while its two spells together would kill it.
+// With ours down theirs is uncontested, and each kill feeds it gold and the victim's bag (Focus); with
+// ours alive the rule is off. Its stun takes the victim's next turn and its ground spell follows, so the
+// opener alone decides the kill. The steps' guards (guard.cc) keep off the tiles, a hold in reach is
+// left (capture.cc), and a champion left inside with its walk unspent steps out (act()). The reach is
+// Chebyshev: a ground target may be any tile, so walls do not shorten it.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// The enemy Prism an ally keeps from, and how far it reaches before that ally's next turn.
+struct PrismFoe {
+    const ChampionBelief* e = nullptr;
+    int reach = 0;
+    float combo = 0; // its two spells' damage to that ally, after our Durability
+};
+
+// Alive status reads for every ally, seen or not (vision.unseen_units).
+bool our_prism_alive(const World& world) {
+    for (const auto& p : world.allies)
+        if (p.alive && p.facts().passive == Passive::gem_focus) return true;
+    return false;
+}
+
+// Its ready damaging spells' farthest tile (the ground spell's 3x3: 5), one more when it gets two
+// turns (a walk, then the cast). Its turns are read against our next turn; for another ally, taken
+// at two. The window after next counts too, as up to two turns we meet one step nearer: with equal
+// ranks its turns alternate 2, 0, 2, so a free turn would walk us to where a step out is too short,
+// and a spell back from cooldown there would catch us the same way.
+PrismFoe prism_foe(const World& world, Safety& safety, const ChampionBelief& a) {
+    if (a.facts().passive == Passive::gem_focus || !a.alive || our_prism_alive(world)) return {};
+    // A shield drains by the damage after Durability, before health does.
+    const float health = a.is_self ? my_health_and_shield(world) : a.health + a.shield;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus) continue;
+        // Unseen, only while its possible tiles are few enough for Safety to count it.
+        if (!e.visible && !safety.credible_unseen(e)) continue;
+        float combo = 0;
+        for (const auto& f : e.facts().abilities)
+            if (f.kind == AbilityKind::damage) combo += f.multiplier;
+        // Its Focus as last seen.
+        combo *= e.focus * e.dealt * a.taken;
+        if (combo < health) return {};
+        // Less a turn a stun takes, and none while a teleport channels through them.
+        const int turns = a.is_self ? turns_before_ours(world, e) : 2;
+        // Cooldowns read while seen; unseen, projected as if it cast nothing out of sight.
+        const int next = next_turn_round(world, e), twice = turns >= 2 ? 1 : 0;
+        int reach = -1;
+        for (int s = 0; s < 2; ++s) {
+            const auto& f = e.facts().abilities[s];
+            if (f.kind != AbilityKind::damage) continue;
+            if (turns > 0 && e.ability_ready(s, next + twice)) reach = std::max(reach, f.reach() + twice);
+            if (e.ability_ready(s, next + 1)) reach = std::max(reach, f.reach());
+        }
+        if (reach < 0) return {};
+        return {&e, reach, combo};
+    }
+    return {}; // a team picks each champion once
+}
+
+// Ours, kept while the beliefs and Safety hold.
+const PrismFoe& own_foe(const World& world, Safety& safety) {
+    static struct {
+        int round = -1;
+        std::uint32_t generation = 0, observations = 0;
+        PrismFoe foe;
+    } made;
+    if (made.round != world.round || made.generation != Safety::generation() || made.observations != world.observations)
+        made = {world.round, Safety::generation(), world.observations, prism_foe(world, safety, world.me())};
+    return made.foe;
+}
+
+// Within r of where e may act from: a seen teleport's landing, else its tile; unseen, its possible tiles.
+bool foe_within(const ChampionBelief& e, vec2 p, int r) {
+    return e.visible ? dist(p, enemy_reach::origin(e)) <= r : possible_within(e, p, r);
+}
+// The distance from p to the nearest of them, cap + 1 beyond cap. Unseen, known to be at least `lo`
+// and, unless it is cap + 1, at most `hi`: a binary search between, a board test each.
+int foe_gap(const ChampionBelief& e, vec2 p, int cap, int lo = 0, int hi = 1 << 20) {
+    if (e.visible) return std::min(dist(p, enemy_reach::origin(e)), cap + 1);
+    lo = std::clamp(lo, 0, cap + 1);
+    if (lo > cap || !possible_within(e, p, cap)) return cap + 1;
+    hi = std::clamp(hi, lo, cap);
+    if (hi < cap && !possible_within(e, p, hi)) lo = hi + 1, hi = cap;
+    while (lo < hi)
+        if (const int mid = (lo + hi) / 2; possible_within(e, p, mid)) hi = mid;
+        else lo = mid + 1;
+    return lo;
+}
+// foe_gap at q, from `gap` at a tile `d` away.
+int foe_gap_near(const ChampionBelief& e, vec2 q, int cap, int gap, int d) {
+    return foe_gap(e, q, cap, gap - d, gap > cap ? cap : gap + d);
+}
+
+const bitboard* prism_spacing(const World& world, Safety& safety, vec2 here, int radius) {
+    if (world.me().facts().passive == Passive::gem_focus) return nullptr;
+    static struct {
+        int round = -1;
+        std::uint32_t generation = 0, observations = 0;
+        vec2 here{-1, -1};
+        int radius = 0;
+        const bitboard* out = nullptr;
+    } made;
+    if (made.round == world.round && made.generation == Safety::generation() && made.observations == world.observations
+        && made.here == here && made.radius == radius)
+        return made.out;
+    if (!fuel_ok(act_reserve)) return nullptr;
+    made = {world.round, Safety::generation(), world.observations, here, radius, nullptr};
+    radius = std::min(radius, 2); // a dash's landings at most
+    const auto& foe = own_foe(world, safety);
+    if (!foe.e) return nullptr;
+    // Already inside, a step that widens the gap is free, else one that keeps it (our back to a wall,
+    // or an unseen Prism on several sides): every way out guarded would freeze us in reach.
+    const int gap = foe_gap(*foe.e, here, foe.reach);
+    const auto& open = world.map().open_for_us;
+    const auto& spawn = world.map().ally_spawn;
+    // Ending on our spawn heals us to full first (rounds.turn_end).
+    const bool spawn_safe = foe.combo < my_max_health() + my_live_shield(world);
+    std::array<int, 25> gaps; // (dx + 2) + 5 (dy + 2)
+    bool wider = gap > foe.reach;
+    for (int dy = -radius; dy <= radius; ++dy)
+        for (int dx = -radius; dx <= radius; ++dx) {
+            const vec2 q{here.x + dx, here.y + dy};
+            int& g = gaps[static_cast<std::size_t>(dx + 2 + 5 * (dy + 2))];
+            g = q == here || !in_bounds(q) || !test(open, q) ? -1
+                : spawn_safe && test(spawn, q)             ? foe.reach + 1
+                                                           : foe_gap_near(*foe.e, q, foe.reach, gap, std::max(std::abs(dx), std::abs(dy)));
+            wider |= g > gap;
+        }
+    const int bound = std::min(foe.reach, wider ? gap : gap - 1);
+    static bitboard board{cambc::uninitialized};
+    bool any = false;
+    for (int dy = -radius; dy <= radius; ++dy)
+        for (int dx = -radius; dx <= radius; ++dx) {
+            if (const int g = gaps[static_cast<std::size_t>(dx + 2 + 5 * (dy + 2))]; g < 0 || g > bound) continue;
+            if (!any) clear_board(board), any = true;
+            set_tile(board, {here.x + dx, here.y + dy});
+        }
+    return made.out = any ? &board : nullptr;
+}
+
+bool prism_in_reach(const World& world, Safety& safety, const ChampionBelief& a, vec2 at) {
+    if (a.facts().passive == Passive::gem_focus) return false;
+    const PrismFoe foe = a.is_self ? own_foe(world, safety) : prism_foe(world, safety, a);
+    return foe.e && foe_within(*foe.e, at, foe.reach);
+}
+
+bool prism_space_step(const World& world, Pathing& pathing, Safety& safety) {
+    if (world.me().facts().passive == Passive::gem_focus || !world.me().alive) return false;
+    const auto& foe = own_foe(world, safety);
+    if (!foe.e) return false;
+    const vec2 here = my_position();
+    const int gap = foe_gap(*foe.e, here, foe.reach);
+    bool stepped = false;
+    // Our spawn heals us at the turn end, and want_home never leaves it.
+    // Only under a guard placed this turn (guard_steps, guard_work): a retreat that chose to stand left none.
+    // A guard still deferred is worked out by the step: with the fuel step_guard asks, lest it give up
+    // and leave the strikes unguarded, and the turn's end its own.
+    const auto held = pathing.held_guard();
+    if (gap <= foe.reach && (held.guard || held.fn) && my_can_move() && !channelling() && !test(world.map().ally_spawn, here)
+        && fuel_ok(act_reserve + (held.fn ? safety.fight_cost_estimate() + step_guard_costliest() : 0))) {
+        struct Option {
+            vec2 p;
+            int gap;
+            float camps;
+        };
+        std::array<Option, 8> options;
+        int n = 0;
+        const auto& blocked = pathing.blocked();
+        for (const auto d : directions) {
+            const vec2 q = here + d;
+            if (!in_bounds(q) || test(blocked, q)) continue;
+            // Only a step that widens the gap: one keeping it ends the turn in reach all the same.
+            if (const int g = foe_gap_near(*foe.e, q, foe.reach, gap, 1); g > gap) options[static_cast<std::size_t>(n++)] = {q, g, safety.camp_damage(q)};
+        }
+        // Out of reach first, then off camp fire, then the widest gap.
+        std::stable_sort(options.begin(), options.begin() + n, [&](const Option& a, const Option& b) {
+            const bool ao = a.gap > foe.reach, bo = b.gap > foe.reach;
+            if (ao != bo) return ao;
+            if (a.camps != b.camps) return a.camps < b.camps;
+            return a.gap > b.gap;
+        });
+        // The guard placed for the turn still holds: no step onto a lost stand.
+        for (int i = 0; i < n && !stepped; ++i) stepped = pathing.try_move(options[static_cast<std::size_t>(i)].p);
+    }
+    debug_block({
+        const int start = foe_gap(*foe.e, world.turn_start, foe.reach);
+        const int end = stepped ? foe_gap(*foe.e, my_position(), foe.reach) : gap;
+        // Why a champion left in reach did not step: 1 walk spent, 2 cast, 4 channelling, 8 on our spawn, 16 seen foe.
+        const int why = (my_can_move() ? 0 : 1) | (my_can_cast() ? 0 : 2) | (channelling() ? 4 : 0)
+                        | (test(world.map().ally_spawn, my_position()) ? 8 : 0) | (foe.e->visible ? 16 : 0);
+        std::printf("SPACE %d %u %d %d %d %d %d %d %d %d\n", world.round, my_handle(), foe.reach, start, gap, end, spacing_read ? 1 : 0,
+                    stepped ? 1 : 0, why, static_cast<int>(world.me().type));
+    });
+    return stepped;
+}
+
+} // namespace
+
+} // namespace aph
