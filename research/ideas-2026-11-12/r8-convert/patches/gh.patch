+// Ally b's lone hold of G pays the team more than Prism a's with the Focus its gems add to a's kept bag
+// (carried_bonus): a capture's gold goes with its gems, a wolf's 10 gold a gem against a gem cluster's none, and
+// Prism's shards are the weakest (65 Health, 2.5 Strength, 8 Focus). Live against Fish r8 Prism held 43% of our gold
+// at round 100 and died with a median 255 unspent, while Fish's Vesper took 72% of Fish's. At the holders' price.
+bool gold_outweighs(const World& world, const ChampionBelief& a, const ChampionBelief& b, const CampGroup& G) {
+    if (G.gold <= 0) return false;
+    return holder_value(world, b, G, holder_gold_price)
+           > holder_value(world, a, G, holder_gold_price) + static_cast<float>(G.gems) * carried_bonus(world, a, G.gems, holder_gold_price);
+}
+// gold_outweighs for some ally in sight on or beside G's tiles that could hold it (value_holder's candidates).
+bool gold_outweighs(const World& world, const ChampionBelief& a, const CampGroup& G) {
+    if (G.gold <= 0) return false;
+    for (const auto& b : world.allies) {
+        if (&b == &a || !b.alive || (!b.is_self && !b.visible)) continue;
+        const vec2 p = position_of(b);
+        const bool on = test(G.tiles(), p);
+        if ((on || test(G.adjacent(), p)) && !held_back(world, b, on) && gold_outweighs(world, a, b, G)) return true;
+    }
+    return false;
+}
