+// Where the altars are several sites: the altar a winning bag's carrier (another of us) channels at, else the one
+// nearest it (by its tile as seen or posted), while its channel is too long to take at any risk
+// (params::tribute_window). The win is then that one channel, cancelled whole by a lock placed on its altar or a stun
+// (live against Fish r8, 120 lock and 79 stun cancels of winning channels; they complete 24% of the time at 41-70 turn
+// ends), and gems farmed meanwhile score nothing more. -1 for none.
+int escorted_altar(const World& world) {
+    static int round = -1, kept = -1;
+    static std::uint32_t observations = 0;
+    if (round == world.round && observations == world.observations) return kept;
+    round = world.round, observations = world.observations, kept = -1;
+    const ChampionBelief* carrier = nullptr;
+    int best = 0;
+    for (const auto& a : world.allies) {
+        if (!a.alive || a.is_self) continue;
+        if (const int bag = a.visible ? a.gems : comms::bag_of(world, a.index); bag > best) best = bag, carrier = &a;
+    }
+    if (!carrier || world.score.ally + best < static_cast<int>(cambc::constants::winning_gems)
+        || tribute_turns(best, carrier->fast_tribute) <= params::tribute_window)
+        return kept;
+    vec2 at;
+    int slack = 0;
+    if (!recent_tile(world, *carrier, at, slack)) {
+        if (!in_bounds(carrier->pos)) return kept;
+        at = carrier->pos;
+    }
+    if (carrier->visible && carrier->channel == Channel::tribute) return kept = tribute_altar(world, at);
+    const auto& altars = world.map().altars;
+    int near = unreachable;
+    for (int a = 0; a < static_cast<int>(altars.size()); ++a)
+        if (const int d = dist(at, altars[static_cast<std::size_t>(a)].pos); d < near) near = d, kept = a;
+    return kept;
+}
