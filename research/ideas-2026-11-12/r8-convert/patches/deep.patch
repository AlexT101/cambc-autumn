+// The deep altar (deep_altar) a long tribute goes to instead of the nearest, or -1: a channel longer than
+// params::tribute_window, where the walk there and one channel take no longer than the walk to the nearest and the
+// channel's expected turn ends at a contested altar with its restarts, (e^(hL) - 1) / h at the cancel hazard h
+// (params::channel_hazard), and still end in time. Not one under an enemy lock or given up on.
+int long_tribute_altar(const World& world, Pathing& pathing, const Memory& memory) {
+    const int turns = tribute_turns(world, my_gems());
+    const auto& map = world.map();
+    if (turns <= params::tribute_window || map.altars.size() < 2) return -1;
+    struct Key {
+        std::uint32_t round, observations, gems;
+        vec2 here;
+        bool operator==(const Key&) const = default;
+    };
+    static Key last{~0u};
+    static int kept = -1;
+    const vec2 here = my_position();
+    const Key key{static_cast<std::uint32_t>(world.round), world.observations, my_gems(), here};
+    if (key == last) return kept;
+    last = key, kept = -1;
+    int best = -1, steps = unreachable;
+    for (int a = 0; a < static_cast<int>(map.altars.size()); ++a) {
+        if (!deep_altar(map, a) || world.altars[a].enemy_lock || (a == memory.avoid_altar && world.round < memory.avoid_until)) continue;
+        // On foot, or home by the recall and on from its landing (recall_to_bank keeps that recall).
+        int s = altar_steps(world, pathing, here, a);
+        if (const int out = pathing.to_altar(a).at(recall_landing(world)); out != unreachable) s = std::min(s, recall_turns(world) + out);
+        if (s < steps) best = a, steps = s;
+    }
+    if (best < 0 || steps + turns + endgame_slack > rounds_left(world)) return -1;
+    const int near = altar_steps(world, pathing, here, -1);
+    const float h = params::channel_hazard;
+    const float contested = (std::exp(h * static_cast<float>(turns)) - 1.0f) / h;
+    if (near != unreachable && static_cast<float>(steps + turns) > static_cast<float>(near) + contested) return -1;
+    return kept = best;
+}
