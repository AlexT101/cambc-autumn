+// An altar deep in our half: the enemy's walk from its spawn to a tribute tile of it is longer than ours by more than
+// two sight radii, so nobody on the line midway between the spawns sees a channel there. Against the local Fish body
+// our channels of 21+ turn ends completed 77 of 77 at such altars, 62% at those 5-15 steps on our side and 22-40% at
+// the rest (1,252 channels). Kept per altar.
+bool deep_altar(const StaticMap& map, int a) {
+    static std::vector<signed char> deep;
+    if (deep.size() < map.altars.size()) deep.resize(map.altars.size(), -1);
+    if (deep[a] < 0) {
+        const vec2 p = map.altars[a].pos;
+        const auto& field = map.from_ally_spawn();
+        int ours = unreachable, theirs = unreachable;
+        for (int dx = -1; dx <= 1; ++dx)
+            for (int dy = -1; dy <= 1; ++dy)
+                if (const vec2 t{p.x + dx, p.y + dy}; (dx || dy) && in_bounds(t))
+                    ours = std::min(ours, field.at(t)), theirs = std::min(theirs, map.enemy_spawn_steps(t));
+        deep[a] = ours != unreachable && theirs != unreachable && theirs - ours > 2 * vision_radius;
+    }
+    return deep[a] > 0;
+}
