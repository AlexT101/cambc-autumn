+// How far inside our half an altar is: the enemy's walk from its spawn to a tribute tile of it less ours, 0 where
+// either is unknown. Past two sight radii nobody on the line midway between the spawns sees a channel there: against
+// the local Fish body our channels of 21+ turn ends completed 77 of 77 at such altars, 62% at those 5-15 steps on our
+// side and 22-40% at the rest (1,252 channels). Kept per altar.
+int altar_depth(const StaticMap& map, int a) {
+    static std::vector<int> depth;
+    if (depth.size() < map.altars.size()) depth.resize(map.altars.size(), unreachable);
+    if (depth[a] == unreachable) {
+        const vec2 p = map.altars[a].pos;
+        const auto& field = map.from_ally_spawn();
+        int ours = unreachable, theirs = unreachable;
+        for (int dx = -1; dx <= 1; ++dx)
+            for (int dy = -1; dy <= 1; ++dy)
+                if (const vec2 t{p.x + dx, p.y + dy}; (dx || dy) && in_bounds(t))
+                    ours = std::min(ours, field.at(t)), theirs = std::min(theirs, map.enemy_spawn_steps(t));
+        depth[a] = ours != unreachable && theirs != unreachable ? theirs - ours : 0;
+    }
+    return depth[a];
+}
