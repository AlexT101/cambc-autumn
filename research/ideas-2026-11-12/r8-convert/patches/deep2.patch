+// The altar a long tribute (a channel longer than params::tribute_window) goes to instead of the nearest, or -1: the
+// one with the fewest expected turn ends, its walk (on foot, or home by the recall and on) and the channel with its
+// restarts, (e^(hL) - 1) / h. The cancel hazard h is params::channel_hazard at a contested altar and falls in a line
+// to none at one two sight radii inside our half (altar_depth), where the channel takes its own length. Not an altar
+// under an enemy lock or given up on, nor one whose channel would end after the last round.
+int long_tribute_altar(const World& world, Pathing& pathing, const Memory& memory) {
+    const int turns = tribute_turns(world, my_gems());
+    const auto& map = world.map();
+    if (turns <= params::tribute_window || map.altars.size() < 2) return -1;
+    struct Key {
+        std::uint32_t round, observations, gems;
+        vec2 here;
+        bool operator==(const Key&) const = default;
+    };
+    static Key last{~0u};
+    static int kept = -1;
+    const vec2 here = my_position();
+    const Key key{static_cast<std::uint32_t>(world.round), world.observations, my_gems(), here};
+    if (key == last) return kept;
+    last = key, kept = -1;
+    const int near = altar_steps(world, pathing, here, -1);
+    const auto expected = [&](int a) {
+        const float h = params::channel_hazard * std::clamp(1.0f - static_cast<float>(altar_depth(map, a)) / static_cast<float>(2 * vision_radius), 0.0f, 1.0f);
+        return h > 1e-4f ? (std::exp(h * static_cast<float>(turns)) - 1.0f) / h : static_cast<float>(turns);
+    };
+    // The nearest altar at worst (contested); only one inside our half, whose hazard is lower, can beat it.
+    const float h0 = params::channel_hazard;
+    float least = near == unreachable ? std::numeric_limits<float>::infinity() : static_cast<float>(near) + (std::exp(h0 * static_cast<float>(turns)) - 1.0f) / h0;
+    int best = -1, best_foot = unreachable;
+    for (int a = 0; a < static_cast<int>(map.altars.size()); ++a) {
+        if (altar_depth(map, a) <= 0 || world.altars[a].enemy_lock || (a == memory.avoid_altar && world.round < memory.avoid_until)) continue;
+        const int foot = altar_steps(world, pathing, here, a);
+        int s = foot;
+        if (const int out = pathing.to_altar(a).at(recall_landing(world)); out != unreachable) s = std::min(s, recall_turns(world) + out);
+        if (s == unreachable || s + turns + endgame_slack > rounds_left(world)) continue;
+        if (const float t = static_cast<float>(s) + expected(a); t < least) best = a, least = t, best_foot = foot;
+    }
+    // The nearest serves as before.
+    if (best < 0 || best_foot == near) return -1;
+    return kept = best;
+}
