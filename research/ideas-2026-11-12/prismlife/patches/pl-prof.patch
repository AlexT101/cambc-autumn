 // The escape plan (model/escape.h) ranks ahead of all but HomeWalk: this turn's hit (Safety's) and the
 // plan's after it, so a step away round the pursuers, or one hit now to be clear after, wins over a
 // step clear now that the pursuers catch later; a step whose damage now would kill us goes last.
+// prismlife (params::pl::flee_blocked): an enemy in sight stands nearer our spawn than we do, by the walk, so the
+// way home leads past it and descending it ends at the edge of its reach. The step is instead the untouched one
+// farthest, by the walk, from every enemy in sight, nearer home among equals; with none farther than here we stay,
+// and the turn-end recall is the way home. False: not the case, or every step is touched (retreat_step's ranking).
+bool flee_blocked_step(const World& world, Pathing& pathing, Safety& safety, const Field& home) {
+    const int mode = params::pl::flee_blocked;
+    if (mode == 0 || (mode == 1 && world.me().facts().passive != Passive::gem_focus)) return false;
+    const vec2 here = my_position();
