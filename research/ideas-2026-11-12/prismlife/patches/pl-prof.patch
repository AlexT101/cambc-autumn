+    static bitboard foes{cambc::uninitialized};
+    bool homeward = false, any = false;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible || !in_bounds(e.pos)) continue;
+        if (!any) clear_board(foes), any = true;
+        set_tile(foes, e.pos);
+        homeward |= home.at(e.pos) < steps;
+    }
+    if (!homeward) return false;
+    debug_block({ std::printf("FLEE %d %u seen\n", world.round, my_handle()); });
+    // Past sight and any one-turn reach, nothing tells two tiles apart.
+    constexpr int cap = vision_radius + Strike::max_reach;
+    if (!fuel_ok(end_reserve + search_cost_estimate(cap))) return false;
+    static cambc::distance_field away;
+    static bitboard visited{cambc::uninitialized};
+    away.compute_with_expansion_count(pathing.static_walls(), foes, visited, static_cast<std::uint16_t>(cap));
+    const auto far = [&](vec2 p) { return std::min(steps_at(away, p), cap); };
+    struct Option {
+        vec2 p;
+        int far, home;
+    };
+    Unwritten<Option, 8> scratch;
+    auto& options = scratch.a;
+    int n = 0;
+    const auto& blocked = pathing.blocked();
+    const float taken = world.me().taken;
+    for (const auto d : directions) {
+        const vec2 p = here + d;
+        if (!in_bounds(p) || test(blocked, p) || home.at(p) == unreachable || safety.touched(p, taken)) continue;
+        const Option o{p, far(p), home.at(p)};
+        int i = n++;
+        for (; i > 0 && (o.far > options[i - 1].far || (o.far == options[i - 1].far && o.home < options[i - 1].home)); --i) options[i] = options[i - 1];
+        options[i] = o;
+    }
+    if (n == 0) {
+        debug_block({ std::printf("FLEE %d %u touched\n", world.round, my_handle()); });
+        return false;
+    }
+    const bool safe_here = !safety.touched(here, taken);
+    const int far_here = far(here);
+    for (int i = 0; i < n; ++i) {
+        // Untouched here, a step no farther from them gains nothing.
+        if (safe_here && options[i].far <= far_here) {
+            debug_block({ std::printf("FLEE %d %u stay %d\n", world.round, my_handle(), far_here); });
+            return true;
+        }
+        if (pathing.try_move(options[i].p)) {
+            debug_block({ std::printf("FLEE %d %u step %d %d\n", world.round, my_handle(), far_here, options[i].far); });
+            return true;
+        }
+    }
+    debug_block({ std::printf("FLEE %d %u refused %d\n", world.round, my_handle(), static_cast<int>(safe_here)); });
+    return safe_here;
+}
