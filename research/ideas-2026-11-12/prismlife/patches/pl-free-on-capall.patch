+// prismlife measurement: refunds the fuel spent while alive, when `on`.
+struct FreeScope {
+    bool on;
+    std::int64_t start = 0;
+    explicit FreeScope(bool on) : on(on) {
+        if (on) start = static_cast<std::int64_t>(cambc::detail::sdk_fuel_remaining());
+    }
+    ~FreeScope() {
+        if (on) cambc::detail::sdk_fuel_adjust(start - static_cast<std::int64_t>(cambc::detail::sdk_fuel_remaining()) + 2);
+    }
+    FreeScope(const FreeScope&) = delete;
+    FreeScope& operator=(const FreeScope&) = delete;
+};
