+    const auto hoard = [&](int g) __attribute__((always_inline)) {
+        if (!(hoard_cut > 0)) return 1.0f;
+        float uncached = -1;
+        float& off = static_cast<std::size_t>(g) < off_ground.size() ? off_ground[static_cast<std::size_t>(g)] : uncached;
