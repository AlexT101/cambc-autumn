diff -ruN -x .cambc -x compile_commands.json r8s-base/src/combat/fight.cc r8s-cmg/src/combat/fight.cc
--- r8s-base/src/combat/fight.cc	2026-11-12 17:44:44.661575959 +0000
+++ r8s-cmg/src/combat/fight.cc	2026-11-12 18:24:01.917655056 +0000
@@ -599,8 +599,12 @@
     const float health = my_health();
     HoldAt hold(world, pathing, here, memory.damage);
     if (drawn_home(world, safety, hold)) return true;
-    const int mono = mono_trapped(world, pathing, safety, memory, health);
-    if (mono >= 0 ? mono == 1 : camp_trapped(world, pathing, safety, here, health, memory.siege)) return true;
+    // A camp's kill destroys the bag (combat.camp_kill): a carrier keeps two more camp phases of health in hand than
+    // the exit needs (research/ideas-2026-11-12/v118-fish: three live games lost from a 400+ lead by a 400-970 hoard
+    // dying to a camp on the turn after it first wanted home).
+    const float held = bag_at_stake(world) >= params::brake_bag ? 2 * safety.camp_damage(here) : 0.0f;
+    const int mono = mono_trapped(world, pathing, safety, memory, health - held);
+    if (mono >= 0 ? mono == 1 : camp_trapped(world, pathing, safety, here, health - held, memory.siege)) return true;
     // Once camps sent us home, only a heal brings us back: stepping back into their reach to work
     // would take the hits again from no more health.
     if (memory.camp_fled >= 0 && !memory.siege) return true;
diff -ruN -x .cambc -x compile_commands.json r8s-base/src/economy/altar_guard.cc r8s-cmg/src/economy/altar_guard.cc
--- r8s-base/src/economy/altar_guard.cc	2026-11-12 17:44:44.663636875 +0000
+++ r8s-cmg/src/economy/altar_guard.cc	2026-11-12 18:50:41.962635314 +0000
@@ -164,6 +164,12 @@
         set_tile(goal, stand);
         field.emplace(make_field(pathing.static_walls(), goal));
     }
+    // A camp's kill destroys the bag (combat.camp_kill): carrying one, the guard takes no step that only leads through
+    // an awake camp's reach (step_safely's straight fallback), and waits where it stands.
+    if (bag_at_stake(world) >= params::brake_bag && safety.avoid_within(my_position(), vision_radius)) {
+        pathing.step_towards(*field, &safety.avoid());
+        return true;
+    }
     step_safely(world, pathing, *field, safety);
     return true;
 }
