+// What a retreat's walk is worth to a cast that excludes it: the blows the best step spares us before our next
+// turn, priced as their dealers price them (the fall in kill_distance on us, bag and all), at least
+// escape_step_value. A stun on everyone who reaches us still needs only its cast cost (enemy_cast).
+float retreat_walk_value(const World& world, Pathing& pathing, Safety& safety) {
+    if (!my_can_move() || !my_can_cast()) return escape_step_value;
+    const vec2 here = my_position();
+    bool near = false;
+    for (const auto& e : world.enemies) near |= e.alive && e.visible && dist(here, e.pos) <= ability_range;
+    if (!near) return escape_step_value;
+    const float taken = world.me().taken, stay = safety.bound(here, taken).damage;
+    if (stay <= 0) return escape_step_value;
+    float least = stay;
+    const auto& blocked = pathing.blocked();
+    for (const auto d : directions) {
+        const vec2 p = here + d;
+        if (least <= 0 || !in_bounds(p) || test(blocked, p)) continue;
+        least = std::min(least, safety.bound(p, taken).damage);
+    }
+    const float health = my_health_and_shield(world), full = std::max(my_max_health(), health);
+    const float bag = params::gem_value * static_cast<float>(bag_at_stake(world));
+    const float spared = kill_distance(std::max(0.0f, health - least), full, bag) - kill_distance(std::max(0.0f, health - stay), full, bag);
+    return std::max(escape_step_value, spared);
+}
