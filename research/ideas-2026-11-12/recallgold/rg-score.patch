+    return damage > 0 && damage < health - 0.01f && !on_spawn && recall_kept(e) ? v + recall_worth(world, e) : v;
 }
 
 } // namespace
 
+// A recall lands its owner on spawn to shop (rules: economy.shop), so cancelling one puts off spending
+// the gold it carries. Enemy gold is hidden: in our games against the bodies, the gold an enemy carried
+// on a kept recall we cancelled was 26 + 3.3% of what its stats show it spent (R^2 0.10), 101 on average.
+float recall_worth(const World& world, const ChampionBelief& e) {
+    float gold;
+    if (params::recall_gold_score) {
+        gold = 39.6f + 0.114f * static_cast<float>(std::max(world.score.ally, world.score.enemy));
+    } else {
+        const auto& f = e.facts();
+        const float health = std::max(0.0f, e.max_health - f.health.base);
+        float strength = e.strength, focus = e.focus;
+        if (f.passive == Passive::health_strength) strength -= cambc::constants::passive_abilities::ryth_health_strength_ratio * health;
+        if (f.passive == Passive::gem_focus) focus -= cambc::constants::passive_abilities::prism_focus_per_gem * static_cast<float>(e.gems);
+        const float shards = health / f.health.growth + std::max(0.0f, strength - f.strength.base) / f.strength.growth
+                             + std::max(0.0f, focus - f.focus.base) / f.focus.growth;
+        gold = 25.6f + 0.0328f * static_cast<float>(shard_price) * shards;
+    }
+    constexpr float mean_gold = 101;
+    return params::recall_value * (1.0f - params::recall_gold_share + params::recall_gold_share * gold / mean_gold);
+}
+
 bool recall_kept(const ChampionBelief& e) {
     return e.channel == Channel::recall && e.visible && aph::kept_recall(e.handle, e.recall_turns());
 }
