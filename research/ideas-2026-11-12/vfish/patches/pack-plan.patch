+// emblem_share (economy/crew.cc) and gold_efficiency (economy/capture.cc) of a body at its base stats.
+float base_emblem_share(const ChampionFacts& f) {
+    const float str = f.strength.base, foc = f.focus.base, shards = static_cast<float>(shards_per_emblem);
+    return std::max(f.raw_output(str + shards * f.strength.growth, foc), f.raw_output(str, foc + shards * f.focus.growth))
+           / std::max(1.0f, f.raw_output(str, foc)) - 1.0f;
+}
+float base_gold_efficiency(const ChampionFacts& f) {
+    static const cambc::enum_map<cambc::item_type> none{};
+    const float hp = f.health.base, str = f.strength.base, foc = f.focus.base;
+    const float p0 = std::max(1.0f, f.raw_output(str, foc)) * hp;
+    float best = std::max(1.0f, f.raw_output(str + 5 * f.strength.growth, foc)) * hp;
+    best = std::max(best, std::max(1.0f, f.raw_output(str, foc + 5 * f.focus.growth)) * hp);
+    const float ryth = f.passive == Passive::health_strength ? cambc::constants::passive_abilities::ryth_health_strength_ratio * 5 * f.health.growth : 0.0f;
+    best = std::max(best, std::max(1.0f, f.raw_output(str + ryth, foc)) * (hp + 5 * f.health.growth));
+    return std::max(1.0f, best - p0) * gold_rate(f, none);
+}
