+const Safety::StunChain& Safety::stun_chain(const ChampionBelief& e) {
+    auto& c = chains_[static_cast<std::size_t>(e.index)];
+    const auto bit = static_cast<std::uint16_t>(1u << e.index);
+    if (chain_known_ & bit) return c;
+    chain_known_ |= bit;
+    c.reach = -1;
+    c.damage.fill(0);
+    auto& x = struck(e);
+    const int turns = turns_before_ours(world_, e, x.turns);
+    // Its next turn stuns and the one after strikes. With two turns before ours those are the two (a stun on
+    // the second leaves it no turn before our next: teams alternate who starts a round, rules rounds.champion_order).
+    const int cast_round = next_turn_round(world_, e);
+    const auto ready = [&](int round) { return (e.ability_ready(0, round) ? 1u : 0u) | (e.ability_ready(1, round) ? 2u : 0u); };
+    const unsigned now = ready(cast_round), after = ready(cast_round + 1);
+    for (unsigned k = 0; k < 2; ++k) {
+        if (!(now >> k & 1)) continue;
+        // One cast a turn: the stunning slot alone, then what is left without it.
+        const Strike& first = strike_with(e, 1u << k);
+        const Strike& second = strike_with(e, after & ~(1u << k));
+        for (int d = 0; d <= first.reach; ++d) {
+            if (!first.stuns[static_cast<std::size_t>(d)]) continue;
+            c.damage[static_cast<std::size_t>(d)] = std::max(c.damage[static_cast<std::size_t>(d)], first.at(d) + second.at(d));
+            c.reach = std::max(c.reach, d);
+        }
+    }
+    // With none of its turns before our next, we step once more before it acts, then it has both: only the
+    // tiles a step does not take us out from count, the reach less one.
+    if (turns <= 0 && c.reach >= 0) {
+        for (int d = 0; d < c.reach; ++d) c.damage[static_cast<std::size_t>(d)] = c.damage[static_cast<std::size_t>(d + 1)];
+        c.damage[static_cast<std::size_t>(c.reach--)] = 0;
+    }
+    return c;
+}
+
+int Safety::stun_kill_reach(const ChampionBelief& e) {
+    if (own_health_ < 0) own_health_ = my_health() + (world_.me().shield_slot >= 0 ? shield_value(world_.me().handle) : 0.0f);
+    const auto& c = stun_chain(e);
+    const float taken = world_.me().taken;
+    // The chain only falls with distance: each strike's damage does, and its stun's reach is one stretch from 0.
+    int reach = c.reach;
+    while (reach >= 0 && c.damage[static_cast<std::size_t>(reach)] * taken < own_health_) --reach;
+    return reach;
+}
+
+// Who stun_kill() must look at, found once for our health and where we stand: most turns nobody.
+std::span<const Safety::StunKiller> Safety::stun_killers() {
+    if (own_health_ < 0) own_health_ = my_health() + (world_.me().shield_slot >= 0 ? shield_value(world_.me().handle) : 0.0f);
+    const vec2 here = my_position();
+    if (stun_killer_count_ < 0 || stun_health_ != own_health_ || !in_square(here, stun_at_, stun_near)) {
+        stun_health_ = own_health_, stun_at_ = here;
+        int n = 0;
+        const float taken = world_.me().taken;
+        // A kit with a stun, and two turns of its most at no distance (a bound on the chain) reaching our
+        // health: else no strike needs working out.
+        const auto may = [&](const ChampionBelief& e) {
+            const auto& a = e.facts().abilities;
+            return (a[0].stuns || a[1].stuns) && 2 * most_damage(e) * taken >= own_health_;
+        };
+        if (world_.me().facts().passive != Passive::stun_immune) {
+            for (auto left = seen_enemies(); left && n < static_cast<int>(stun_killers_.size()); left &= left - 1) {
+                const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+                if (!in_square(here, acts_from(e), Strike::max_reach + 2 * stun_near) || !may(e)) continue;
+                if (const int reach = stun_kill_reach(e); reach >= 0) stun_killers_[static_cast<std::size_t>(n++)] = {e.index, reach, true};
+            }
+            // Out of sight, likewise only one near enough for a tile within stun_near of where we may stand.
+            for (auto left = live_enemies() & ~seen_enemies(); left && n < static_cast<int>(stun_killers_.size()); left &= left - 1) {
+                const auto& e = world_.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+                if (!e.possible_box.meets(here, Strike::max_reach + 2 * stun_near) || !may(e) || !credible_unseen(e)) continue;
+                if (const int reach = stun_kill_reach(e); reach >= 0) stun_killers_[static_cast<std::size_t>(n++)] = {e.index, reach, false};
+            }
+        }
+        stun_killer_count_ = n;
+    }
+    return {stun_killers_.data(), static_cast<std::size_t>(stun_killer_count_)};
+}
+
+bool Safety::stun_kill(vec2 p) {
+    const auto killers = stun_killers();
+    if (killers.empty() || test(world_.map().ally_spawn, p)) return false;
+    for (const auto& k : killers) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(k.enemy)];
+        if (!k.seen) {
+            // From the tiles it may be on, as near as an unseen threat's strike counts (unseen_radius).
+            if (possible_within(e, p, unseen_radius(k.reach, foe(e).tiles))) return true;
+            continue;
+        }
+        if (!in_square(p, acts_from(e), k.reach) || gone(e)) continue;
+        // Its sight of p and the walls, as its blow has them.
+        if (const Blow b = blow(e, p); b.hits && b.stuns) return true;
+    }
+    return false;
+}
+
+bool Safety::stun_kill_within(vec2 p, int r) {
+    const auto killers = stun_killers();
+    if (killers.empty() || (r == 0 && test(world_.map().ally_spawn, p))) return false;
+    for (const auto& k : killers)
+        if (const auto& e = world_.enemies[static_cast<std::size_t>(k.enemy)]; k.seen && in_square(p, acts_from(e), k.reach + r) && !gone(e)) return true;
+    return false;
+}
+
+bool Safety::draw_stun_kill(bitboard& b, vec2 p, int r) {
+    bool any = false;
+    for (const auto& k : stun_killers()) {
+        const auto& e = world_.enemies[static_cast<std::size_t>(k.enemy)];
+        const vec2 from = acts_from(e);
+        if (!k.seen || !in_square(p, from, k.reach + r) || gone(e)) continue;
+        draw_square(b, from, static_cast<float>(k.reach));
+        any = true;
+        // Our spawn heals us at each turn end, a stunned one too (stun_kill).
+        for (const vec2 t : world_.map().ally_spawn_tiles)
+            if (in_square(t, from, k.reach)) set_tile(b, t, false);
+    }
+    return any;
+}
