+// `gain`: our lone hold's over the best claimer's (holder_value), negative when it is not ours to take.
+// `clear`: the rounds its clear takes them; `count`: until its first count pays, a whole count later.
+// `slip_cost`: what a round's slip of that payout costs, the group's next cycle and the best claimer's work
+// starting later.
+struct MateClear {
+    float gain = -1, clear = 0, count = 0, slip_cost = 0;
+};
+MateClear mate_clear(const World& world, int g, float price, float earning, float strength) {
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    MateClear m;
+    if (!relayed(G) || c.state != CampState::alive) return m;
+    float output = 0, held = 0, mate_output = 0;
+    bool worked = c.last_damaged_round >= world.round - 1;
+    for (const auto& b : world.allies) {
+        if (b.is_self || !b.alive || comms::claim_of(world, b.index) != g) continue;
+        output += camp_output(b);
+        if (b.visible) worked = worked || crew_in_reach(world, g, b.pos, b.facts().attack_range());
+        if (const float v = holder_value(world, b, G, price); v > held) held = v, mate_output = camp_output(b);
+    }
+    if (!worked || !(output > 0)) return m;
+    float health = 0;
+    for (std::size_t i = 0; i < G.members.size(); ++i) health += std::max(0.0f, c.health[i]);
+    if (!(health > 0)) return m;
+    m.clear = health / output, m.count = m.clear + static_cast<float>(capture_rounds(false));
+    m.slip_cost = held / static_cast<float>(G.respawn) + earning * mate_output / strength;
+    m.gain = holder_value(world, world.me(), G, price) - held;
+    return m;
+}
+// Its rate from `walk` steps off: the gain, less the slip when we come after its first count's last round (the
+// mates keep it for us), over the rounds there, to the payout and back.
+float mate_clear_rate(const World& world, const MateClear& m, int walk) {
+    const float late = static_cast<float>(walk + 1) - m.count;
+    if (!(m.gain > 0)) return 0.0f;
+    return rate(world, m.gain - std::max(0.0f, late) * m.slip_cost, std::max(m.count, static_cast<float>(walk + 1)) + static_cast<float>(walk));
+}
