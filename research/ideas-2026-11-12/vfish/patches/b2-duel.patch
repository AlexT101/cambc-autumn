+// The damage an enemy of these facts and stats lands on one of us before we can answer: with a stun in its kit
+// every damaging cast (one a turn, the stun taking our turn between: Prism's 1.5 and 1.0 x Focus), else its
+// strongest; a basic attack in each of those turns, and a reset's.
+struct Burst {
+    float damage;
+    bool stuns;
+};
+Burst burst_damage(const ChampionFacts& f, float strength, float focus) {
+    float casts = 0, strongest = 0;
+    bool stuns = false, reset = false;
+    for (const auto& a : f.abilities) {
+        stuns |= a.stuns, reset |= a.kind == AbilityKind::attack_reset;
+        if (a.kind == AbilityKind::damage || a.lands()) casts += a.multiplier, strongest = std::max(strongest, a.multiplier);
+    }
+    return {(stuns ? casts : strongest) * focus + static_cast<float>((stuns ? 2 : 1) + reset) * strength, stuns};
+}
+
+// The strongest enemy burst we have seen, its owner's health (over the damage it takes a point) and the turns of
+// each of its cooldowns we are free to hit it in (a stun takes one). Each enemy's stats are carried from our last
+// sighting to our next shop stop (a stop every round / stops so far) at its growth so far, from its type's base at
+// round 0: a Prism's Focus is its bag, which we see only when we see it. A sighting shows the growth of its own
+// rounds and is trusted for as many again, no further: an early glimpse of a bag later tributed stays small.
+struct BurstThreat {
+    float burst = 0, health = 0;
+    int free_turns = ability_cooldown;
+};
+int shop_stops = 0;
+const BurstThreat& burst_threat(const World& world) {
+    static int round = -1;
+    static BurstThreat kept;
+    if (round == world.round) return kept;
+    round = world.round, kept = {};
+    const float then = static_cast<float>(world.round + world.round / (shop_stops + 1));
+    for (const auto& e : world.enemies) {
+        if (e.stats_round <= 0) continue;
+        const auto& f = e.facts();
+        const float grown = std::min(2.0f, then / static_cast<float>(e.stats_round));
+        const auto carried = [&](float seen, float base) { return base + std::max(0.0f, seen - base) * grown; };
+        const Burst burst = burst_damage(f, carried(e.strength, f.strength.base), carried(e.focus, f.focus.base));
+        if (e.dealt * burst.damage > kept.burst)
+            kept = {e.dealt * burst.damage, carried(e.max_health, f.health.base) / e.taken, ability_cooldown - burst.stuns};
+    }
+    return kept;
+}
+
+// `rotations` asks for one rotation and the next, a cooldown later: the plain rule beside `duel`, which derives
+// the count.
+inline constexpr float burst_rotations = 2;
+// The health (over the damage we take a point) the enemy's burst asks of a body dealing `output` a turn to
+// champions: 0 before any sighting, and under her base health against a team of basic attacks.
+float burst_floor(const World& world, float output) {
+    const BurstThreat& t = burst_threat(world);
+    switch (burst_rule) {
+    case BurstRule::rotations: return burst_rotations * t.burst;
+    // The rotations it lands while we kill it: its health over our output, in the free turns of each cooldown.
+    case BurstRule::duel: return t.burst * std::max(1.0f, t.health / std::max(1.0f, output) / static_cast<float>(t.free_turns));
+    case BurstRule::left: return t.burst;
+    default: return 0;
+    }
+}
+// The carry of this build (taking `taken` a point of damage) is under the floor, and Health is what lifts it.
+bool under_burst(const World& world, float strength, float focus, float max_health, float taken, const cambc::enum_map<cambc::item_type>& owned) {
+    if (burst_rule == BurstRule::none || !priced_carry(world)) return false;
+    const auto& f = world.me().facts();
+    const float floor = burst_floor(world, f.raw_output(strength, focus) * dealt_with(owned).champion);
+    if (!(max_health / taken < floor)) return false;
+    // `duel`, over one rotation with more to outlast: the floor is on output x health, which a Strength shard
+    // raises too (it shortens the kill). Health while its shard raises that product more.
+    if (const float burst = burst_threat(world).burst; burst_rule == BurstRule::duel && floor > burst && max_health / taken >= burst)
+        return f.health.growth * strength >= f.strength.growth * max_health;
+    return true;
+}
+// The fight power of build `b`: its output times its health over the damage it takes. With `burst_left` (the
+// `left` rule), times the health a rotation of that burst leaves, never less than 1: under a rotation only the
+// purchase that crosses it adds any.
+float fight_power(const ChampionFacts& f, const Build& b, float burst_left) {
+    const float out = std::max(1.0f, f.raw_output(b.strength, b.focus));
+    return burst_left > 0 ? out * std::max(1.0f, b.max_health / b.taken - burst_left) : out * b.max_health / b.taken;
+}
+// The burst `left` takes from the carry's health in its fight power.
+float burst_left(const World& world) { return burst_rule == BurstRule::left && priced_carry(world) ? burst_threat(world).burst : 0.0f; }
+
+// under_burst as we stand, for the price caches: asked many times a turn, it moves with a round's sightings or a
+// purchase.
+bool burst_bound(const World& world) {
+    if (burst_rule == BurstRule::none || !priced_carry(world)) return false;
+    static int round = -1;
+    static float health = -1;
+    static bool kept = false;
+    const auto& self = world.me();
+    if (round == world.round && health == self.max_health) return kept;
+    round = world.round, health = self.max_health;
+    const auto& owned = my_items();
+    return kept = under_burst(world, self.strength, self.focus, self.max_health, has_family(owned, durability) ? durability_taken : 1.0f, owned);
 }
 
