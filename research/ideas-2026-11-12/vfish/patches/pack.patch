+// The output of the allies free to join an operation of ours (crew_available for some group): the most plan_crew
+// expects beside a group's claimers.
+float crew_free_output(const World& world, const CrewAllies& allies) {
+    float output = 0;
+    for (int i = 0; i < allies.n; ++i) {
+        const auto& a = allies.at[static_cast<std::size_t>(i)];
+        if (!a.has_avail) read_avail(world, allies, a);
+        if (a.avail != 0) output += crew_output(a);
+    }
+    return output;
+}
+
+// The share of its output an emblem of a's better stat adds. An emblem's price (prices) is the rounds it saves, which
+// scale with this share: it stands in for an ally's price, which only the ally can read.
+float emblem_share(const ChampionBelief& a) {
+    const auto& f = a.facts();
+    const bool seen = a.max_health > 0;
+    const float str = seen ? a.strength : f.strength.base, foc = seen ? a.focus : f.focus.base;
+    const float shards = static_cast<float>(shards_per_emblem);
+    return std::max(f.raw_output(str + shards * f.strength.growth, foc), f.raw_output(str, foc + shards * f.focus.growth))
+           / std::max(1.0f, f.raw_output(str, foc)) - 1.0f;
+}
+
+// The gold payee: the living ally value_holder hands a gold hold to (the highest relative_efficiency, never a
+// hold-shy body). A payout goes to whoever stands on the group: where the payee can be that holder, the gold is worth
+// the payee's price to every ally clearing the group, and to the payee all of it but what the next-best holder would
+// have been paid.
+struct GoldPayee {
+    const ChampionBelief* a = nullptr;
+    // A gold on the payee, and on the best other ally (read for ourselves only), in golds of ours before our own
+    // bonuses and efficiency: farm's price of it (gold bonuses x relative_efficiency), at its emblem_share over ours.
+    float rate = 0, next = 0;
+    vec2 at{-1, -1}; // where its holds are counted from: its claim's centre, else its tile as last known; else off the map
+};
+const GoldPayee& gold_payee(const World& world) {
+    static GoldPayee p;
+    static int round = -1;
+    static std::uint32_t gold = ~0u;
+    if (round == world.round && gold == my_gold()) return p; // relative_efficiency's key
+    round = world.round, gold = my_gold();
+    p = {};
+    const auto& rel = relative_efficiency(world);
+    // holder_value's order of a gold hold, at the passive's gold rate (an ally's emblems are read only in sight).
+    static const cambc::enum_map<cambc::item_type> none{};
+    const auto rank = [&](const ChampionBelief& a) { return gold_rate(a.facts(), none) * rel[a.index & 63]; };
+    const ChampionBelief *second = nullptr, *shy = nullptr;
+    for (const auto& a : world.allies) {
+        if (!(a.alive || a.is_self)) continue;
+        if (hold_shy(world, a)) {
+            if (!shy || rank(a) > rank(*shy)) shy = &a;
+        } else if (!p.a || rank(a) > rank(*p.a)) second = p.a, p.a = &a;
+        else if (!second || rank(a) > rank(*second)) second = &a;
+    }
+    if (!p.a) return p;
+    const float mine = std::max(1e-6f, emblem_share(world.me()));
+    const auto price = [&](const ChampionBelief& a) { return ally_gold_paid(world, a) * rel[a.index & 63] * emblem_share(a) / mine; };
+    p.rate = price(*p.a);
+    if (p.a->is_self) {
+        // With none but hold-shy bodies beside us, one of those holds.
+        if (const auto* other = second ? second : shy) p.next = price(*other);
+        return p;
+    }
+    // Held by a channel (a recall home, a tribute, a teleport), it holds nothing here.
+    if (p.a->visible && held_by_channel(*p.a)) return p;
+    const int claim = comms::claim_of(world, p.a->index);
+    vec2 tile{-1, -1};
+    int slack = 0;
+    const bool placed = recent_tile(world, *p.a, tile, slack);
+    if (claim >= 0 && claim < static_cast<int>(world.map().groups.size())) {
+        // A claim it is known to be far from is one it left (to bank, to shop) or has yet to walk to: its tile counts.
+        const vec2 centre = world.map().groups[claim].centre;
+        p.at = placed && dist(tile, centre) > carry_reach() ? tile : centre;
+    } else if (placed) p.at = tile;
+    return p;
+}
