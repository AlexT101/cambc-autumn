+
+// A payload read this round was set at the caller's latest turn: this round or last.
+float called_blow(const World& world, const ChampionBelief& e) {
+    float blow = 0;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || !a.visible || posts_support(world, a)) continue;
+        const auto p = payload_of(world, a);
+        if (p < 0 || static_cast<int>(p >> support_mailbox::payload_shift & 7) != e.index + 1) continue;
+        blow += params::focus_follow * strike(a, next_turn_round(world, a)).at(dist(a.pos, e.pos));
+    }
+    return blow;
