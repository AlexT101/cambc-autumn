+// The last round a fight step was cut for fuel or a turn ran out (note_fight_cut): fuel short on one
+// turn of a fight is short on the next too (a press turn after one is cut 48% of the time, 16% otherwise).
+inline int fight_cut_round = -1000;
+inline void note_fight_cut(const char* what) {
+    fight_cut_round = cambc::round_number();
+    note_shortcut(what);
+}
