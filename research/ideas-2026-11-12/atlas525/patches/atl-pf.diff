 namespace {
 
+// A visible enemy whose casts at us are its main damage (a stun, or more than its basic attack), with
+// every such slot cooling: its own turns, from its next, before the first is ready again (rules
+// abilities.cooldown). -1: no such cast, or its cooldowns are unknown.
+int disarm_window(const World& world, const ChampionBelief& e) {
+    if (!e.alive || !e.visible || e.cooldowns_uncertain()) return -1;
+    const auto& f = e.facts();
+    const int first = next_turn_round(world, e);
+    int window = -1;
+    for (int s = 0; s < 2; ++s) {
+        const auto& a = f.abilities[s];
+        // Marcella's reset stuns with the attack after it.
+        if (!(a.hits_enemies() || a.stuns) || !(a.stuns || a.multiplier * e.focus > e.strength)) continue;
+        const int w = std::max(0, e.ready_round[static_cast<std::size_t>(s)] - first);
+        window = window < 0 ? w : std::min(window, w);
+    }
+    return window;
+}
+
+// Our champion a's turns before e's turn in round `armed`, this one counting for us.
+int turns_before(const World& world, const ChampionBelief& a, const ChampionBelief& e, int armed) {
+    const int now = world.round;
+    const bool pending = a.is_self || world.slot(a, now) > world.my_slot_now();
+    const bool last = world.slot(a, armed) < enemy_earliest_slot(world, e, armed);
+    const int turns = (pending ? 1 : 0) + std::max(0, armed - now - 1) + (last ? 1 : 0) - (!a.is_self && a.stun_pending ? 1 : 0);
+    return std::max(0, turns);
+}
+
+// What our champion a, at `from`, deals e in `turns` turns ending before round `armed`: its basic
+// attack on each turn once in basic reach (a step a turn closes in, as the crow flies), and each cast
+// at enemies ready in time once, one a turn (cast in the window, a slot is not back before it ends).
+float press_damage(const ChampionBelief& a, vec2 from, const ChampionBelief& e, int turns, int armed) {
+    const auto& basic = strike_with(a, 0);
+    if (basic.reach < 0) return 0;
+    const int in_reach = turns - std::max(0, dist(from, e.pos) - basic.reach);
+    if (in_reach <= 0) return 0;
+    const float hit = a.strength * a.scale;
+    std::array<float, 2> casts{};
+    for (int s = 0; s < 2; ++s) {
+        const auto& ability = a.facts().abilities[static_cast<std::size_t>(s)];
+        if (!a.ability_ready(s, armed - 1)) continue;
+        if (ability.kind == AbilityKind::attack_reset) casts[static_cast<std::size_t>(s)] = hit;
+        else if (ability.kind == AbilityKind::damage || ability.lands()) casts[static_cast<std::size_t>(s)] = ability.multiplier * a.focus * a.scale;
+    }
+    if (casts[0] < casts[1]) std::swap(casts[0], casts[1]);
+    return static_cast<float>(in_reach) * hit + casts[0] + (in_reach >= 2 ? casts[1] : 0.0f);
+}
+
+// press_damage summed over us and the visible allies that can act (none channelling); `own`: ours.
+float pack_damage(const World& world, const ChampionBelief& e, int armed, float& own) {
+    own = 0;
+    float total = 0;
+    for (const auto& a : world.allies) {
+        // start_recall's turn-end feint shows nearly every ally recalling: only a real channel holds it.
+        if (!a.alive || (!a.is_self && (!a.visible || held_by_channel(a) || a.facts().heals()))) continue;
+        const float d = press_damage(a, a.is_self ? my_position() : a.pos, e, turns_before(world, a, e, armed), armed);
+        total += d;
+        if (a.is_self) own = d;
+    }
+    return total;
+}
+
+// A visible enemy whose strike before our next turn (Safety's threat strike, its ready casts in) kills
