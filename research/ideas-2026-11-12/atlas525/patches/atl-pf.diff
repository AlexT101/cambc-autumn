+// another enemy's kill reach. Of several, the most valuable kill (its bag), then the nearest.
+const Press& press(const World& world, Safety& safety) {
+    auto& m = press_memo;
+    const vec2 here = my_position();
+    const float health = my_health();
+    const std::uint32_t bits = my_record().state;
+    if (m.round == world.round && m.observations == world.observations && m.stun_reads == world.stun_reads && m.here == here && m.health == health
+        && m.state == bits && m.feint == recall_feint)
+        return m.value;
+    m.round = world.round, m.observations = world.observations, m.stun_reads = world.stun_reads, m.here = here, m.health = health;
+    m.state = bits, m.feint = recall_feint;
