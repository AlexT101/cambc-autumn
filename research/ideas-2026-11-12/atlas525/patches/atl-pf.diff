+    const int range = me.facts().attack_range();
+    const bool linked = partner(world) != nullptr;
+    std::array<KillReach, 8> kills;
+    int nk = -1;
+    float best_value = -1;
+    int best_dist = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !e.visible || e.teleport_pending() || test(world.map().near_enemy_spawn, e.pos) || dist(here, e.pos) > vision_radius) continue;
+        const int window = disarm_window(world, e);
+        if (window < params::press::min_window) continue;
+        const float value = params::life_value / params::gem_value + static_cast<float>(pair_gems(world, e));
+        if (value < best_value || (value == best_value && dist(here, e.pos) >= best_dist)) continue;
