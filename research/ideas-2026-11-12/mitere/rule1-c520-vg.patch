+// An ally with Vesper Vale's gold bonus or more, healthy and free, on G's tiles or within capture_time steps of
+// them: a hold begun now pays no sooner than she walks in. G pays gold and takes one holder. Its gold is
+// hers (sole_capture_holder), not a Prism's: Mite's Vesper holds 56-58% of its captured gold, ours 36%, the
+// Prism carrying a quarter of it unpaid (research/ideas-2026-11-12/mitere/README.md section 9).
+const ChampionBelief* gold_taker(const World& world, const CampGroup& G) {
+    if (G.gold <= 0 || G.has_monolith || holders(G) != 1) return nullptr;
+    const float bonus = 1.0f + static_cast<float>(cambc::constants::passive_abilities::vesper_vale_bonus_gold_percent) / 100.0f;
+    const auto& map = world.map();
+    for (const auto& a : world.allies) {
+        if (!a.alive || (!a.is_self && !a.visible) || a.facts().passive == Passive::gem_focus) continue;
+        if (a.health < params::hurt_health_fraction * a.max_health || ally_gold_paid(world, a) < bonus - 1e-3f) continue;
+        const vec2 p = position_of(a);
+        const bool on = test(G.tiles(), p);
+        if (held_back(world, a, on) || (!on && a.channel == Channel::tribute)) continue;
+        if (!on) {
+            // Holding another cleared group of ours: busy.
+            const int h = map.group_at(p);
+            if (h >= 0 && world.camps[h].state == CampState::cleared && world.camps[h].holder == team::ally) continue;
+            if (steps_to(G, p) >= cambc::constants::capture_time) continue;
+        }
+        return &a;
+    }
+    return nullptr;
+}
