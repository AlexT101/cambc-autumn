+// The enemy Prism, priced into the farm choice: working a group within its reach risks our death at
+// the measured hazard (params::duel). For our Prism the hazard is by the duel's openings: each side
+// opens with its damage spells at its Focus and the basic attacks of the turns it gets before the
+// reply (two after a stun, which takes the victim's turn), and the spells come back once a cooldown,
+// so a kill takes ceil(health / opening) openings.
+struct DuelPrice {
+    const ChampionBelief* enemy = nullptr; // null: nothing priced this turn
+    float hazard = 0; // chance we are killed working within its reach
+    float loss = 0;   // what our death costs, in worth: the bag, and the respawn's rounds of our farm
+    float tiles = 0;  // its possible tiles
+    int reach = 0;    // its stun's range, and a walk more on a double turn
+};
+
+float duel_opening(const ChampionBelief& c, float target_taken) {
+    float spells = 0;
+    bool stuns = false;
+    for (const auto& a : c.facts().abilities) {
+        if (a.kind == AbilityKind::damage || a.lands()) spells += a.multiplier;
+        stuns |= a.stuns;
+    }
+    return (spells * c.focus + static_cast<float>(stuns ? 2 : 1) * c.strength) * c.scale * target_taken;
+}
+
+DuelPrice duel_price(const World& world, const Memory& memory) {
+    DuelPrice d;
+    const auto& me = world.me();
+    const int bag = static_cast<int>(my_gems());
+    if (!params::duel::on || !me.alive || (me.facts().passive != Passive::gem_focus && bag < params::duel::carrier_bag)) return d;
+    const ChampionBelief* e = nullptr;
+    for (const auto& x : world.enemies)
+        if (x.facts().passive == Passive::gem_focus) e = &x;
+    // Fresh information only: `possible` is informative while tracked, within track_horizon of a
+    // sighting, ours or a teammate's.
+    if (!e || !e->alive || !e->tracked) return d;
+    if (me.facts().passive == Passive::gem_focus) {
+        const float on_us = duel_opening(*e, me.taken), on_them = duel_opening(me, e->taken);
+        if (!(on_us > 0)) return d;
+        const float ours = std::ceil((my_health() + me.shield) / on_us);
+        const float theirs = on_them > 0 ? std::ceil((e->health + e->shield) / on_them) : ours + 1;
+        d.hazard = ours < theirs ? params::duel::lose_hazard : ours == theirs ? params::duel::even_hazard : 0.0f;
+    } else {
+        d.hazard = params::duel::carrier_hazard;
+    }
+    if (d.hazard <= 0) return d;
+    d.tiles = static_cast<float>(board_count(e->possible));
+    if (!(d.tiles > 0)) return d;
+    const auto& f = e->facts();
+    d.reach = std::max({f.stun_range[0], f.stun_range[1], f.attack_range()}) + 1;
+    d.loss = static_cast<float>(bag) + static_cast<float>(cambc::constants::respawn_time) * std::max(0.0f, memory.farm_rate);
+    d.enemy = e;
+    return d;
+}
+
+// The chance we are killed working group g: the hazard, at the share of its possible tiles within its
+// reach of where we work it (its camp tiles and, while it lives, our attack range around them).
+float duel_hazard(const World& world, const DuelPrice& d, int g) {
+    const auto& G = world.map().groups[static_cast<std::size_t>(g)];
+    static std::vector<std::int16_t> radius; // by group: its farthest camp tile from the centre
+    if (radius.size() != world.map().groups.size()) radius.assign(world.map().groups.size(), -1);
+    auto& r = radius[static_cast<std::size_t>(g)];
+    if (r < 0) {
+        int most = 0;
+        for (const auto& m : G.members) most = std::max(most, dist(m.pos, G.centre));
+        r = static_cast<std::int16_t>(most);
+    }
+    const auto n = possible_count_within(*d.enemy, G.centre, r + walk_range(world, g) + d.reach);
+    return d.hazard * static_cast<float>(n) / d.tiles;
+}
