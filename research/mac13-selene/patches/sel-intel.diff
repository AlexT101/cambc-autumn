+void World::note_told(int enemy_index, vec2 centre, int half, int seen_round, bool acted, float focus) {
+    if (enemy_index < 0 || enemy_index >= static_cast<int>(enemies.size()) || !in_bounds(centre) || round - seen_round > params::track_horizon) return;
+    auto& b = enemies[enemy_index];
+    const Moment told{seen_round, acted ? Moment::end : -1};
+    if (!b.alive || b.visible || seen_round < b.pos_round || (b.tracked && !(b.fixed < told))) return;
+    // A teleport we saw under way lands where we expect it; the teammate's tile would undo that.
+    if (b.seen_channel == Channel::teleport && b.channel_end_round >= seen_round) return;
+    b.pos = centre;
+    b.pos_round = seen_round;
+    b.pos_source = Source::comms;
+    if (b.stats_round < seen_round && focus > 0) b.focus = focus;
+    if (half <= 0) {
+        fix(b, centre, told);
+    } else {
+        copy_into(within(map().open_for_them, centre, half), b.possible);
+        b.possible_box.set(centre);
+        b.possible_box.grow(half);
+        mark_fixed(b, told);
+        b.fixed_tile = {-1, -1};
+        b.lineage = 0;
+    }
+    track(b);
+}
