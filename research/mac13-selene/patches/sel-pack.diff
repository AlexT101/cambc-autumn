+// turn would be too late.
+int walk_ahead(const World& world, const ChampionBelief& e) {
+    static struct {
+        int round = -1;
+        std::uint32_t observations = 0, stun_reads = 0;
+        std::uint32_t known = 0;
+        std::array<std::int8_t, 32> steps;
+    } memo;
+    if (memo.round != world.round || memo.observations != world.observations || memo.stun_reads != world.stun_reads)
+        memo.round = world.round, memo.observations = world.observations, memo.stun_reads = world.stun_reads, memo.known = 0;
+    const auto i = static_cast<unsigned>(e.index) & 31u;
+    if (memo.known >> i & 1) return memo.steps[i];
+    const auto& f = e.facts();
+    const int dash = f.slot_of(AbilityKind::dash);
+    const auto dash_by = [&](int round) { return dash >= 0 && (e.ability_ready(dash, round) || e.cooldowns_uncertain()); };
+    int steps = 0;
+    if (e.visible) {
+        const int turns = turns_before_ours(world, e);
+        steps = turns;
+        if (turns > 0 && dash_by(turns == 2 ? world.round + 1 : next_turn_round(world, e))) steps += f.abilities[static_cast<std::size_t>(dash)].range();
+        if (turns > 0 && e.teleport_pending()) steps += in_bounds(e.tp_dest) ? dist(e.pos, e.tp_dest) : teleport_crystal_range;
+    } else if (enemy_turn_before_ours_next(world, e)) {
+        // `possible` already holds its turn this round (World::track), with a dash if one was ready
+        // then: one walked step covers next round's dash from there, as the cooldown allows only one.
+        steps = 1;
+        if (!dash_by(world.round) && dash_by(world.round + 1)) steps += f.abilities[static_cast<std::size_t>(dash)].range();
+    }
+    memo.known |= 1u << i, memo.steps[i] = static_cast<std::int8_t>(steps);
+    return steps;
+}
