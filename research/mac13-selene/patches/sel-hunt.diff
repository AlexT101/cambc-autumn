+// Prism keeping its gems hunts the enemy Prism it dominates (hunt_target) when the kill's rate beats the
+// farm's best as last weighed (Memory::hunt_bar): the hunt goes ahead of camp hits in passing, which would
+// spend the walk. The kill is its bag (capped as a capture's, Focus bonus included), a life and the kill
+// gold, at the measured params::hunt_kill_share. The hunt is a chase: next turn's strike search and prey
+// see the target engaged, and turn_order.cc seats us as a chaser.
+HuntStep farm_hunt(const World& world, Pathing& pathing, Safety& safety, Memory& memory, int short_by) {
+    if (!my_can_move() || my_health() < params::hurt_health_fraction * my_max_health()) return HuntStep::none;
+    const auto h = hunt_target(world);
+    if (!h.target) return HuntStep::none;
+    const auto& e = *h.target;
+    const auto& map = world.map();
+    const int gems = std::min(e.gems, std::max(0, short_by));
+    // The bag the kill makes must still reach an altar by the round limit.
+    if (rounds_left(world) <= tribute_turns(static_cast<int>(my_gems()) + gems, world.me().fast_tribute) + map.width + map.height + endgame_margin)
+        return HuntStep::none;
+    const bool going = memory.hunt_enemy == e.index && memory.hunt_round >= world.round - 2;
+    const int start = going ? memory.hunt_start : world.round;
+    const float per_gold = prices(world).per_gold * gold_paid(world) * relative_efficiency(world)[world.me().index & 63];
+    const float bonus = carried_bonus(world, world.me(), gems, prices(world).per_gold);
+    const float worth = params::hunt_kill_share * (static_cast<float>(gems) * (1.0f + bonus) + params::life_value / params::gem_value
+                                                   + per_gold * static_cast<float>(cambc::constants::kill_gold));
+    // The rounds hunted so far count too: the crow's steps leave out the wait for a way in.
+    const float value = rate(world, worth, static_cast<float>(world.round - start + h.steps + h.turns));
+    const bool hunts = value > memory.hunt_bar;
+    debug_block({
+        std::printf("HUNT-PRICE %d %u e%u steps %d turns %d since %d worth %.1f value %.3f bar %.3f %s\n", world.round, my_handle(),
+                    static_cast<std::uint32_t>(e.handle), h.steps, h.turns, world.round - start, worth, value, memory.hunt_bar, hunts ? "hunt" : "farm");
+    });
+    // The verdict's plan last: it costs ~10k.
+    if (!hunts || hunt_escapes(world, pathing, e, memory.hunt_clean)) return HuntStep::none;
+    const auto step = hunt_step(world, pathing, safety, e, memory.hunt_waited == world.round - 1);
+    if (step == HuntStep::none) return step;
+    debug_block({
+        std::printf("HUNT %d %u e%u at %d,%d d %d vis %d bag %u/%d hp %.0f/%.0f %c\n", world.round, my_handle(), static_cast<std::uint32_t>(e.handle),
+                    e.pos.x, e.pos.y, dist(my_position(), e.pos), e.visible ? 1 : 0, my_gems(), e.gems, my_health(), my_max_health(),
+                    step == HuntStep::stood ? 's' : 'm');
+    });
+    decision = Branch::chase;
+    note_engaged(static_cast<std::uint32_t>(e.handle));
+    memory.hunt_enemy = e.index, memory.hunt_round = world.round, memory.hunt_start = start;
+    if (step == HuntStep::stood) memory.hunt_waited = world.round;
+    drop_carry_claim(memory);
+    memory.claim = -1, memory.crew = false;
+    return step;
+}
