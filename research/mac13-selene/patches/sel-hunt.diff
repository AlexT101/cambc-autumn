diff --git a/bots/variants/sel-hunt/src/economy/hunt.cc b/bots/variants/sel-hunt/src/economy/hunt.cc
new file mode 100644
index 000000000..8122b6a1c
--- /dev/null
+++ b/bots/variants/sel-hunt/src/economy/hunt.cc
@@ -0,0 +1,163 @@
+// The dominant Prism's hunt of the weak enemy Prism: farm's 'h' pick, priced against the farm by the
+// same rate. A kill hands us the victim's bag (rules combat.kill) and Focus with it.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// c's ready slots as a strike's mask, at `round`.
+unsigned ready_slots(const ChampionBelief& c, int round) {
+    unsigned out = 0;
+    for (int s = 0; s < 2; ++s)
+        if (c.ability_ready(s, round)) out |= 1u << s;
+    return out;
+}
+
+// Whether a slot in `ready` stuns.
+bool stuns_with(const ChampionBelief& c, unsigned ready) {
+    for (int s = 0; s < 2; ++s)
+        if ((ready >> s & 1u) && c.facts().abilities[s].stuns) return true;
+    return false;
+}
+
+// c's turns standing at distance d to deal `hp`: each turn its best strike (one cast, rules turn.cast,
+// with its basic hit), the slot cast then spent. No slot comes back within a cooldown, so past `cap`
+// (at most ability_cooldown) the count reads cap + 1.
+int duel_turns(const ChampionBelief& c, unsigned ready, int d, float hp, int cap) {
+    float dealt = 0;
+    for (int t = 1; t <= cap; ++t) {
+        const float now = strike_with(c, ready).at(d);
+        dealt += now;
+        if (dealt >= hp) return t;
+        // The slot cast: the one whose loss costs this turn's strike most.
+        unsigned left = ready;
+        float least = now;
+        for (int s = 0; s < 2; ++s)
+            if (ready >> s & 1u)
+                if (const float v = strike_with(c, ready & ~(1u << s)).at(d); v < least) least = v, left = ready & ~(1u << s);
+        ready = left;
+    }
+    return cap + 1;
+}
+
+int hunt_reach(const World& world) {
+    const auto& self = world.me();
+    const auto& f = self.facts();
+    // Our next turn's: a unit or ground cast's range (the ground splash aside: it lands on the target's tile
+    // as a unit cast would), else the basic attack's.
+    int r = f.basic_reach();
+    for (int s = 0; s < 2; ++s)
+        if (const auto& a = f.abilities[s]; (a.kind == AbilityKind::damage || a.kind == AbilityKind::stun) && self.ability_ready(s, world.round + 1))
+            r = std::max(r, a.range());
+    return r;
+}
+
+HuntTarget hunt_target(const World& world) {
+    HuntTarget out;
+    const auto& self = world.me();
+    if (!self.alive || self.facts().passive != Passive::gem_focus) return out;
+    const ChampionBelief* target = nullptr;
+    float most = 0;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || e.facts().passive != Passive::gem_focus || e.stats_round < 0) continue;
+        most = std::max(most, e.focus);
+        target = &e; // a team drafts each champion once (rules draft.rules)
+    }
+    // prism_dominant's bar: at twice its Focus our hits already win most duels (71% of Prism-on-Prism kills).
+    if (!target || !(most > 0) || !(self.focus >= 2 * most)) return out;
+    const auto& e = *target;
+    const auto& spawn = world.map().near_enemy_spawn;
+    if (e.visible) {
+        if (test(spawn, e.pos)) return out; // it heals there, and we cannot enter
+    } else {
+        // Located only while tracked (params::track_horizon): an older fix could be anywhere.
+        if (!e.tracked || e.possible.is_empty()) return out;
+        static bitboard off{cambc::uninitialized};
+        copy_into(e.possible, off);
+        drop(off, spawn);
+        if (off.is_empty()) return out;
+    }
+    // The duel in openings, standing in basic reach: we must kill it in fewer turns than it needs for us
+    // even if it strikes first. Its stun then takes our first turn; ours, if ready, takes one of its. So it
+    // has max(2, ours) turns before our last, or ours + 1 without our stun.
+    const int cap = ability_cooldown;
+    const unsigned mine_ready = ready_slots(self, world.round + 1);
+    const int ours = duel_turns(self, mine_ready, self.facts().attack_range(), effective_hp(e), cap);
+    if (ours > cap) return out;
+    const float mine = (my_health() + self.shield) / self.taken;
+    const int theirs = duel_turns(e, ready_slots(e, next_turn_round(world, e)), e.facts().attack_range(), mine, cap);
+    if (theirs <= (stuns_with(self, mine_ready) ? std::max(2, ours) : ours + 1)) return out;
+    out.target = &e;
+    out.turns = ours;
+    // To the duel's distance, as `turns` is counted.
+    out.steps = std::max(0, dist(my_position(), e.pos) - self.facts().attack_range());
+    // Unseen, it may have walked a step a turn since the fix, any way.
+    if (!e.visible) out.steps += e.turns_since_fixed;
+    return out;
+}
+
+bool hunt_escapes(const World& world, Pathing& pathing, const ChampionBelief& e, int& clean_round) {
+    // Tracked: walking to where it may be finds it again, as lost_prey does, unless it was getting away
+    // when last seen.
+    if (!e.visible) return clean_round >= e.pos_round;
+    // The verdict's plan must leave the step's search its fuel (chase_aim's gate); without it, no hunt.
+    const auto need = escape::chase_cost_estimate() + search_reserve;
+    if (!fuel_ok(need)) return true;
+    const bool clean = escapes(world, pathing, e, need);
+    debug_block({
+        std::printf("HUNT-CAND %d %u e%u d %d clean %d focus %.0f/%.0f bag %u/%d\n", world.round, my_handle(), static_cast<std::uint32_t>(e.handle),
+                    dist(my_position(), e.pos), clean ? 1 : 0, world.me().focus, e.focus, my_gems(), e.gems);
+    });
+    if (clean) clean_round = world.round;
+    return clean;
+}
+
+HuntStep hunt_step(const World& world, Pathing& pathing, Safety& safety, const ChampionBelief& e, bool waited) {
+    if (!my_can_move()) return HuntStep::none;
+    const vec2 here = my_position();
+    const int reach = hunt_reach(world);
+    const auto& map = world.map();
+    const bitboard* zone = pack_zone(world, safety);
+    // Near it, the step that lets us cast first: a ranged Prism casts only from where its turn starts
+    // (rules abilities.exclusive), so whoever ends a turn in the other's reach while the other acts
+    // before its next turn takes the first stun. Tiles it cannot stun before our next turn first, so we
+    // wait just out of its reach for the turn order to let us in; but only one turn: if our rank keeps us
+    // first every round, no such turn comes, and the duel won with its stun first (hunt_target) says go.
+    if (e.visible && dist(here, e.pos) <= reach + 2) {
+        const auto& blocked = pathing.blocked();
+        const int basic = world.me().facts().attack_range();
+        // Lexicographic: stunnable, distance down to basic reach (nearer gains no hit), a step.
+        const auto key = [&](vec2 p) {
+            return (!waited && safety.blow(e, p).stuns ? 1 << 16 : 0) + 2 * std::max(basic, dist(p, e.pos)) + (p == here ? 0 : 1);
+        };
+        std::array<std::pair<int, vec2>, 9> order;
+        int n = 0;
+        order[n++] = {key(here), here};
+        for (const auto d : directions) {
+            const vec2 p = here + d;
+            if (!in_bounds(p) || !test(map.open_for_us, p) || test(blocked, p) || (zone && test(*zone, p))) continue;
+            order[n++] = {key(p), p};
+        }
+        std::sort(order.begin(), order.begin() + n, [](const auto& a, const auto& b) { return a.first < b.first; });
+        // The step guard may refuse a tile: the next best then.
+        for (int i = 0; i < n; ++i) {
+            if (order[i].second == here) return HuntStep::stood;
+            if (pathing.try_move(order[i].second)) return HuntStep::moved;
+        }
+        return HuntStep::none;
+    }
+    static bitboard goals{cambc::uninitialized};
+    clear_board(goals);
+    if (e.visible) draw_square(goals, e.pos, static_cast<float>(reach));
+    else goals |= e.possible;
+    and_into(goals, map.open_for_us, goals);
+    drop(goals, map.near_enemy_spawn);
+    if (zone) drop(goals, *zone);
+    if (goals.is_empty()) return HuntStep::none;
+    return pathing.step_towards(goals, zone, 2 * vision_radius, e.pos) ? HuntStep::moved : HuntStep::none;
+}
+
+} // namespace
+
+} // namespace aph
