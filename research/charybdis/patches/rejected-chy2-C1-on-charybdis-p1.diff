diff -ruN charybdis-p1/src/economy/hub.cc chy2-C1/src/economy/hub.cc
--- charybdis-p1/src/economy/hub.cc	1970-01-01 00:00:00.000000000 +0000
+++ chy2-C1/src/economy/hub.cc	2026-11-11 11:31:28.938748302 +0000
@@ -0,0 +1,81 @@
+// A carried gem's Focus, priced as team-marginal value (macro4's hub): every gem a Prism carries adds
+// Focus to both its damage spells until tributed, so a gem in Prism's bag is worth more than the same gem
+// in another ally's. Farm's 'G' and 'L' carry picks and leave_for_prism's claimed hand-over read it.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// Gems per camp health point over the map's gem groups: farm_step_value's exchange rate.
+float camp_gem_density(const StaticMap& map) {
+    static float density = -1;
+    if (density < 0) {
+        float gems = 0, health = 0;
+        for (const auto& g : map.groups) {
+            if (g.gems == 0 || (g.has_monolith && !map.monolith_only)) continue;
+            gems += static_cast<float>(g.gems);
+            for (const auto& m : g.members) health += m.max_health;
+        }
+        density = health > 0 ? gems / health : 0.0f;
+    }
+    return density;
+}
+
+// The damage a round one carried gem adds: its Focus times the damage spells' multipliers, each cast
+// once a cooldown.
+float gem_damage_rate(const ChampionFacts& f) {
+    float multipliers = 0;
+    for (const auto& a : f.abilities)
+        if (a.kind == AbilityKind::damage) multipliers += a.multiplier;
+    return cambc::constants::passive_abilities::prism_focus_per_gem * multipliers / static_cast<float>(ability_cooldown);
+}
+
+// Extra gems of output per gem Prism carries. A gem stays carried until the bag must leave for an
+// altar: the round limit or the race's end (race_left), less the last trip sole_capture_holder keeps
+// back. Its extra damage d a round, at the map's gems per health point, is discounted by the farm's
+// own horizon h (rate's 1 + r / h): the sum over t < H of d / (1 + t / h) is d h ln(1 + H / h).
+float hub_premium(const World& world, const ChampionFacts& prism) {
+    const auto& map = world.map();
+    const float h = cycle_horizon(map);
+    const int carried = std::min(rounds_left(world), race_left(world)) - (map.width + map.height + endgame_margin);
+    if (carried <= 0) return 0;
+    const float rho = gem_damage_rate(prism) * camp_gem_density(map) * h * std::log1p(static_cast<float>(carried) / h);
+    return std::clamp(rho, 0.0f, params::hub_rho_most);
+}
+
+// A group's worth to the team, carried to Prism, over its worth in an ally's bag: the ally's payout
+// `ours` rounds away, Prism's `theirs`, each discounted as rate() does (1 + r / h).
+float hub_factor(const World& world, float rho, float ours, float theirs) {
+    const float h = cycle_horizon(world.map());
+    return std::max(1.0f, (1.0f + rho) * (h + ours) / (h + theirs));
+}
+
+// The gems one of our champions earns a round, as the team has so far: its score and living bags
+// over the rounds played, per champion (its dead rounds included). Prism's rounds on a carry are
+// worth this elsewhere.
+float champion_gem_rate(const World& world) {
+    static int round = -1;
+    static float r = 0;
+    if (round == world.round) return r;
+    round = world.round;
+    int gems = world.score.ally;
+    for (const auto& a : world.allies) {
+        if (!a.alive && !a.is_self) continue;
+        gems += a.is_self ? static_cast<int>(my_gems()) : a.visible ? a.gems : comms::bag_of(world, a.index);
+    }
+    // The score is the game's, so the rounds are too, not this instance's.
+    const int played = std::max(1, world.round);
+    r = world.allies.empty() ? 0.0f : static_cast<float>(gems) / static_cast<float>(played) / static_cast<float>(world.allies.size());
+    return r;
+}
+
+// The team's gain, in gems, from `gems` going to Prism rather than staying in an ally's bag: the premium
+// (hub_factor) less the rounds Prism spends on them (`theirs`, its walk and hold) at a champion's rate.
+float hub_net(const World& world, float rho, float gems, float ours, float theirs) {
+    return gems * (hub_factor(world, rho, ours, theirs) - 1.0f) - theirs * champion_gem_rate(world);
+}
+
+} // namespace
+
+} // namespace aph
