diff -ruN chy2-C2/src/combat/stun_lock.cc chy2-C4/src/combat/stun_lock.cc
--- chy2-C2/src/combat/stun_lock.cc	1970-01-01 00:00:00.000000000 +0000
+++ chy2-C4/src/combat/stun_lock.cc	2026-11-11 12:55:26.642234245 +0000
@@ -0,0 +1,270 @@
+// Our Prism's stun lock: an enemy whose stun takes our next turn can follow it with its next turn's
+// cast and attacks before we act again. Safety prices what lands before our next turn, and widens a
+// strike to two turns only by a walk or a second basic attack; with our turn taken, the follow-up
+// cast lands too, and we can neither answer nor leave in between.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// One enemy's lock, fixed for a Safety's life (its beliefs are).
+struct Locker {
+    const ChampionBelief* e = nullptr;
+    enum Kind : std::uint8_t { seen, tracked, remembered } kind = seen;
+    vec2 origin{-1, -1}; // seen: where its stun turn starts; remembered: its last-seen tile
+    int reach = -1;       // farthest tile its stun turn stuns
+    int growth = 0;       // remembered: the steps it may have taken since, to its stun turn's start
+    bool sight = false;   // a unit stun that excludes walking: only tiles its origin sees
+    std::array<float, Strike::max_reach + 1> damage{}; // stun turn and follow-up, by distance, as we take it
+    float most = 0;
+    int board = -1; // seen with sight, or remembered: its scratch board, built on first need
+    bool built = false;
+};
+
+constexpr int max_lockers = 8;
+struct LockState {
+    std::uint32_t generation = 0;
+    bool valid = false;
+    int count = 0;
+    std::array<Locker, max_lockers> lockers;
+    float health = 0;
+    int boards = 0;
+    struct Memo {
+        vec2 p;
+        int locker;
+        bool several;
+    };
+    std::array<Memo, 16> memo;
+    int memo_count = 0, memo_next = 0;
+};
+LockState lock_state;
+
+// Scratch boards, one per locker that needs one: allocated once (~300 fuel each).
+bitboard& lock_board(int i) {
+    static std::array<std::optional<bitboard>, max_lockers> boards;
+    auto& b = boards[static_cast<std::size_t>(i)];
+    return b ? *b : b.emplace(cambc::uninitialized);
+}
+
+// Where a visible enemy acts from: a teleport lands before it acts.
+vec2 stun_origin(const ChampionBelief& e) { return e.teleport_pending() && in_bounds(e.tp_dest) ? e.tp_dest : e.pos; }
+
+// e's lock: its stun on its next turn, which falls before ours (else we act first and can leave),
+// then the best of its following turn (in the next round) with the stun slot spent.
+bool make_locker(const World& world, const ChampionBelief& e, Locker& out) {
+    const auto& f = e.facts();
+    int s = -1;
+    for (int k = 0; k < 2; ++k)
+        if (f.abilities[k].stuns) s = k;
+    if (s < 0 || turns_before_ours(world, e) < 1) return false;
+    const int round = next_turn_round(world, e);
+    if (!e.can_act(round) || !(e.cooldowns_uncertain() || e.ability_ready(s, round))) return false;
+    const auto& stun = strike_with(e, 1u << s);
+    const bool uncertain = e.cooldowns_uncertain();
+    const unsigned follow = (uncertain || e.ability_ready(0, round + 1) ? 1u : 0u) | (uncertain || e.ability_ready(1, round + 1) ? 2u : 0u);
+    const auto& next = strike_with(e, follow & ~(1u << s));
+    const float taken = world.me().taken;
+    const auto& a = f.abilities[s];
+    out = Locker{};
+    out.e = &e;
+    for (int d = 0; d <= stun.reach; ++d) {
+        if (!stun.stuns[d]) break;
+        out.reach = d;
+        // The follow-up starts where the stun turn ended: beside us after a dash landing, a step
+        // nearer after a walk the stun allows.
+        const int after = a.lands() ? std::min(d, a.radius) : !a.excludes_walking ? std::max(0, d - 1) : d;
+        out.damage[d] = (stun.at(d) + next.at(after)) * taken;
+        out.most = std::max(out.most, out.damage[d]);
+    }
+    if (out.reach < 0) return false;
+    if (e.visible) {
+        out.kind = Locker::seen;
+        out.origin = stun_origin(e);
+        // From a bush it sees its own cluster too: counted as seeing every tile.
+        out.sight = a.target == Targeting::unit && a.excludes_walking && !test(world.map().bushes, out.origin);
+    } else if (e.tracked) {
+        out.kind = Locker::tracked;
+    } else {
+        // Past track_horizon, kept from its last sighting for one ability cooldown: a step a turn
+        // (and a dash a cooldown) from there, to its next turn's start.
+        if (e.pos_round < 0 || !in_bounds(e.pos)) return false;
+        const int turns = world.round - e.pos_round + 1;
+        if (turns > ability_cooldown) return false;
+        out.kind = Locker::remembered;
+        out.origin = e.pos;
+        out.growth = turns + (f.has_dash() ? dash_range * ((turns + ability_cooldown - 1) / ability_cooldown) : 0);
+    }
+    return true;
+}
+
+LockState& lockers(const World& world, Safety& safety) {
+    auto& st = lock_state;
+    if (st.valid && st.generation == Safety::generation()) return st;
+    world.throw_if_stale();
+    st.valid = true;
+    st.generation = Safety::generation();
+    st.count = st.boards = st.memo_count = st.memo_next = 0;
+    st.health = my_health_and_shield(world);
+    for (auto left = safety.live_enemies(); left && st.count < max_lockers; left &= left - 1) {
+        const auto& e = world.enemies[static_cast<std::size_t>(std::countr_zero(left))];
+        if (make_locker(world, e, st.lockers[st.count])) ++st.count;
+    }
+    // live_enemies leaves out the unseen past track_horizon.
+    for (const auto& e : world.enemies) {
+        if (st.count >= max_lockers) break;
+        if (!e.alive || e.visible || e.tracked) continue;
+        if (make_locker(world, e, st.lockers[st.count])) ++st.count;
+    }
+    return st;
+}
+
+// Whether L's stun can land on p, by geometry alone.
+bool stun_reaches(const World& world, LockState& st, Locker& L, vec2 p) {
+    switch (L.kind) {
+    case Locker::seen: {
+        if (dist(p, L.origin) > L.reach) return false;
+        if (!L.sight) return true;
+        if (!L.built) {
+            L.built = true;
+            L.board = st.boards++;
+            // Sight is symmetric: the tiles off bushes that see its tile are those it sees.
+            world.map().sight_off_bushes_into(L.origin, L.reach, lock_board(L.board));
+        }
+        return test(lock_board(L.board), p);
+    }
+    case Locker::tracked: return possible_within(*L.e, p, L.reach);
+    case Locker::remembered: {
+        if (dist(p, L.origin) > L.growth + L.reach) return false;
+        if (L.board < 0) L.board = st.boards++;
+        auto& b = lock_board(L.board);
+        if (!L.built) {
+            L.built = true;
+            // Not where we see now: it stands where its next turn starts.
+            clear_board(b);
+            draw_square(b, L.origin, static_cast<float>(L.growth));
+            and_into(b, world.map().open_for_them, b);
+            drop(b, world.visible);
+        }
+        return any_within(b, p, L.reach);
+    }
+    }
+    return false;
+}
+
+// What the other threats add at p while we stand stunned: their blows before our next turn, and
+// two camp phases (ours lost, then the next). Each worked out once per tile, for every locker.
+struct Others {
+    float ceiling = -1; // at least `total` less the locker's blow
+    int n = -1;
+    std::array<Safety::ThreatAt, 16> at;
+    float total = 0;
+    float without(int enemy) const {
+        float out = total;
+        for (int i = 0; i < n; ++i)
+            if (at[i].enemy == enemy) out -= at[i].blow.damage * taken;
+        return out;
+    }
+    float taken = 1;
+};
+
+// The lockers of p: `found` the first, `several` whether another locks it too.
+void locker_at(const World& world, Safety& safety, LockState& st, vec2 p, int& found, bool& several) {
+    world.throw_if_stale();
+    found = -1, several = false;
+    Others o;
+    o.taken = world.me().taken;
+    float camps = -1; // the second camp phase
+    for (int i = 0; i < st.count; ++i) {
+        auto& L = st.lockers[i];
+        // Cheap bounds first: the most it can deal, then where.
+        const int far = L.kind == Locker::remembered ? L.growth + L.reach : L.reach;
+        if (L.kind != Locker::tracked ? dist(p, L.origin) > far : !L.e->possible_box.meets(p, L.reach)) continue;
+        const float own = L.kind == Locker::seen ? L.damage[static_cast<std::size_t>(dist(p, L.origin))] : L.most;
+        if (own < st.health) {
+            if (camps < 0) camps = safety.camp_damage(p, true, false);
+            if (o.ceiling < 0) o.ceiling = safety.damage_ceiling(p, false, o.taken) + camps;
+            if (own + o.ceiling < st.health) continue;
+        }
+        if (!stun_reaches(world, st, L, p)) continue;
+        if (own < st.health) {
+            if (o.n < 0) {
+                o.n = safety.threats_at(p, o.at);
+                o.total = camps + safety.camp_damage(p, true, true);
+                for (int k = 0; k < o.n; ++k) o.total += o.at[k].blow.damage * o.taken;
+            }
+            if (own + o.without(L.e->index) < st.health) continue;
+        }
+        if (found >= 0) {
+            several = true;
+            return;
+        }
+        found = L.e->index;
+    }
+}
+
+const LockState::Memo* lock_memo(const World& world, Safety& safety, vec2 p) {
+    if (world.me().facts().passive != Passive::gem_focus || !in_bounds(p)) return nullptr;
+    auto& st = lockers(world, safety);
+    if (st.count == 0) return nullptr;
+    for (int i = 0; i < st.memo_count; ++i)
+        if (st.memo[i].p == p) return &st.memo[i];
+    auto& m = st.memo[st.memo_count < static_cast<int>(st.memo.size()) ? st.memo_count++ : std::exchange(st.memo_next, (st.memo_next + 1) % 16)];
+    m = {p, -1, false};
+    // Only tiles we can stand on (Safety's blows assume a tile that is not a wall), and off our spawn,
+    // where a turn end heals us to full, the stunned one's too (rules abilities.stun).
+    if (test(world.map().open_for_us, p) && !test(world.map().ally_spawn, p)) locker_at(world, safety, st, p, m.locker, m.several);
+    return &m;
+}
+
+int stun_locker(const World& world, Safety& safety, vec2 p) {
+    const auto* m = lock_memo(world, safety, p);
+    return m ? m->locker : -1;
+}
+
+int sole_stun_locker(const World& world, Safety& safety, vec2 p) {
+    const auto* m = lock_memo(world, safety, p);
+    return m && !m->several ? m->locker : -1;
+}
+
+unsigned stun_locked_steps(const World& world, Safety& safety, vec2 here) {
+    if (world.me().facts().passive != Passive::gem_focus || lockers(world, safety).count == 0) return 0;
+    unsigned out = 0;
+    for (int i = 0; i < 8; ++i)
+        if (stun_locker(world, safety, here + directions[i]) >= 0) out |= 1u << i;
+    return out;
+}
+
+bool stun_lock_around(const World& world, Safety& safety, vec2 here) {
+    return stun_locker(world, safety, here) >= 0 || stun_locked_steps(world, safety, here) != 0;
+}
+
+bool stun_lock_exit(const World& world, Pathing& pathing, Safety& safety, vec2 here) {
+    const unsigned locked = stun_locked_steps(world, safety, here);
+    const auto& blocked = pathing.blocked();
+    for (int i = 0; i < 8; ++i) {
+        const vec2 q = here + directions[i];
+        if (!(locked >> i & 1) && in_bounds(q) && test(world.map().open_for_us, q) && !test(blocked, q)) return true;
+    }
+    return false;
+}
+
+void trace_stun_lock(const World& world, Safety& safety, vec2 p, char tag) {
+    debug_block({
+        const int i = stun_locker(world, safety, p);
+        if (i < 0) return;
+        const auto& st = lock_state;
+        for (int k = 0; k < st.count; ++k) {
+            const auto& L = st.lockers[k];
+            if (L.e->index != i) continue;
+            const int d = L.kind == Locker::tracked ? -1 : dist(p, L.origin);
+            std::printf("SLOCK %d %u %c %d %d %d %.0f %.0f %d %d %d\n", world.round, my_handle(), tag, i, static_cast<int>(L.kind), d,
+                        L.kind == Locker::seen ? L.damage[static_cast<std::size_t>(d)] : L.most, st.health, L.e->gems, static_cast<int>(my_gems()),
+                        static_cast<int>(L.e->type));
+        }
+    });
+}
+
+} // namespace
+
+} // namespace aph
