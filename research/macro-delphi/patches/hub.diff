+const ChampionBelief* carry_prism(const World& world, vec2& at, int& bag) {
+    if (world.me().facts().passive == Passive::gem_focus || enemy_seen(world) || winning_bag(world)) return nullptr;
+    for (const auto& a : world.allies) {
