+// Our body whose bag wins (as seen, else as posted, or last seen past the post's cap), the largest, ties by
+// index; null for none. Its long channel is cancelled by any enemy stun or lock that reaches it. Bags are
+// ranked as comms posts them (rounded up to fours, capped), so bodies seeing exact and posted bags agree.
+const ChampionBelief* carrier(const World& world) {
+    const ChampionBelief* best = nullptr;
+    int best_key = -1, best_bag = 0;
+    for (const auto& a : world.allies) {
+        if (!a.alive) continue;
+        // A posted bag at the cap is only a floor: the last sighting may say more.
+        const int posted = a.is_self || a.visible ? 0 : comms::bag_of(world, a.index);
+        const int bag = a.is_self ? static_cast<int>(my_gems()) : a.visible ? a.gems : posted >= comms_bag_cap ? std::max(posted, a.gems) : posted;
+        if (const int key = std::min(comms_bag_cap, (bag + 3) / 4 * 4); key > best_key) best = &a, best_key = key, best_bag = bag;
