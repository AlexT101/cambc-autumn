+// so the guards gather at one altar. Where it is unknown, the altar last computed for it.
+int carrier_altar(const World& world, const ChampionBelief& c) {
+    static std::array<int, 8> last{-1, -1, -1, -1, -1, -1, -1, -1};
+    int& kept = last[static_cast<std::size_t>(c.index) % last.size()];
+    vec2 at;
+    int slack = 0;
+    if (c.is_self) {
+        at = my_position();
+        if (my_state().contains(cambc::champion_state::submitting_gems)) return kept = tribute_altar(world, at);
+    } else if (c.visible && c.channel == Channel::tribute) {
+        return kept = tribute_altar(world, c.pos);
+    } else if (!recent_tile(world, c, at, slack)) {
+        if (kept >= 0 || !in_bounds(c.pos)) return kept;
+        at = c.pos;
+    }
+    const auto& map = world.map();
+    int best = -1, best_lock = 0, best_dist = 0, best_home = 0;
+    for (int a = 0; a < static_cast<int>(map.altars.size()); ++a) {
+        const int lock = world.altars[static_cast<std::size_t>(a)].enemy_lock;
+        const int d = dist(at, map.altars[static_cast<std::size_t>(a)].pos);
+        if (best >= 0 && (lock > best_lock || (lock == best_lock && d > best_dist))) continue;
+        const int home = altar_home_steps(map, a);
+        if (best < 0 || lock < best_lock || d < best_dist || home < best_home) best = a, best_lock = lock, best_dist = d, best_home = home;
