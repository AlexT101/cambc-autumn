+// Steps from our spawn to a tile beside altar a.
+int altar_home_steps(const StaticMap& map, int a) {
+    const auto& field = map.from_ally_spawn();
+    const vec2 p = map.altars[static_cast<std::size_t>(a)].pos;
+    int steps = unreachable;
+    for (int dx = -1; dx <= 1; ++dx)
