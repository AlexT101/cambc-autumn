+// the enemy Prism's death opens a window to bank (prism_window).
 bool keeps_gems(const World& world, Pathing& pathing) {
-    return world.me().facts().passive == Passive::gem_focus && !winning_bag(world) && !closing(world, pathing);
+    return world.me().facts().passive == Passive::gem_focus && !winning_bag(world) && !closing(world, pathing)
+           && !prism_window(world, pathing);
 }
 
 bool retaining_gems(const World& world, Pathing& pathing) { return my_gems() > 0 && keeps_gems(world, pathing); }
