+
+bool closing_now(const World& world, Pathing& pathing) {
+    const int trip = altar_trip(world, pathing);
+    return bag_rounds_left(world) <= (trip == unreachable ? 0 : trip) + tribute_turns(world, my_gems()) + endgame_margin;
+}
+
+namespace {
+struct WindowSeen {
+    int opened = -1, respawn = -1, bag = 0, last = -1; // last: the last round prism_window held
+    bool started = false;
+} window_seen;
+} // namespace
+
+// Every enemy Prism is dead, so neither its Focus-scaled stun nor its duel for the gems' Focus is in
+// play, and a bag worth a bank (bankable_bag) can reach an altar and finish its tribute before the
+// earliest respawn: Prism banks it.
+bool prism_window(const World& world, Pathing& pathing) {
+    if (my_gems() == 0) return false;
+    int respawn = -1;
+    for (const auto& e : world.enemies) {
+        if (e.facts().passive != Passive::gem_focus) continue;
+        if (e.alive || e.respawn_earliest < 0) return false;
+        respawn = respawn < 0 ? e.respawn_earliest : std::min(respawn, e.respawn_earliest);
+    }
+    if (respawn < 0) return false;
+    const int trip = altar_trip(world, pathing), channel = tribute_turns(world, my_gems());
+    if (trip == unreachable || world.round + trip + channel > respawn || bankable_bag(world, pathing) == 0) return false;
+    if (window_seen.opened < 0) {
+        window_seen = {world.round, respawn, static_cast<int>(my_gems()), world.round, false};
+        debug_block({ std::printf("WINDOW-OPEN %d %u bag=%u respawn_in=%d trip=%d channel=%d\n", world.round, my_handle(), my_gems(),
+                                  respawn - world.round, trip, channel); });
+    }
+    window_seen.last = world.round;
+    return true;
+}
+
+void window_trace(const World& world) {
+    if (window_seen.opened < 0) return;
+    const bool tributing = my_state().contains(cambc::champion_state::submitting_gems);
+    const char* end = nullptr;
+    if (!world.me().alive) end = "WINDOW-DIED";
+    else if (window_seen.started && !tributing) end = my_gems() == 0 ? "WINDOW-BANKED" : "WINDOW-CANCELLED";
+    else if (!window_seen.started && world.round > window_seen.last + 1) end = "WINDOW-LAPSED";
+    else if (!window_seen.started && tributing) {
+        window_seen.started = true;
+        std::printf("WINDOW-START %d %u bag=%u respawn_in=%d\n", world.round, my_handle(), my_gems(), window_seen.respawn - world.round);
     }
-    return bag_rounds_left(world) <= walk + tribute_turns(world, my_gems()) + endgame_margin;
+    if (!end) return;
+    std::printf("%s %d %u bag=%u opened=%d respawn=%d\n", end, world.round, my_handle(), my_gems(), window_seen.opened, window_seen.respawn);
+    window_seen = {};
 }
 
-// Prism keeps the gems it carries or gains for their Focus, until its bag wins or the game closes.
