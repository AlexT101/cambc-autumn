+// The anchor of a non-Prism champion: our living Prism keeping its bag, at the group it posts as its claim, else
+// at its tile seen or posted lately. None for Prism itself.
+const PackAnchor& pack_anchor(const World& world) {
+    static PackAnchor anchor;
+    static int round = -1;
+    if (round == world.round) return anchor;
+    round = world.round, anchor = PackAnchor{};
+    if (world.me().facts().passive == Passive::gem_focus || world.round > 300) return anchor;
+    const auto& groups = world.map().groups;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || a.facts().passive != Passive::gem_focus) continue;
+        const int bag = a.visible ? a.gems : comms::bag_of(world, a.index);
+        if (!keeps_bag(world, a, bag - a.gems)) break;
+        const int g = comms::claim_of(world, a.index);
+        vec2 at;
+        int slack = 0;
+        if (g >= 0 && g < static_cast<int>(groups.size())) anchor = PackAnchor{a.index, g, groups[g].centre};
+        else if (recent_tile(world, a, at, slack)) anchor = PackAnchor{a.index, -1, at};
+        break;
+    }
+    return anchor;
+}
