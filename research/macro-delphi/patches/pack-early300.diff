+// reading), so allies rank alike.
+bool pack_escort(const World& world) {
+    const auto unit = [&](const ChampionBelief& a) {
+        const ChampionBelief* body = &a;
+        if (a.facts().ranged)
+            if (const auto* p = linked_partner(world, a)) body = p; // Issac, Cassi's melee partner
+        const int id = std::min(a.index, body->index);
+        const auto& f = body->facts();
+        const float score = body->stats_round >= 0 && body->max_health > 0 ? body->max_health * body->strength : f.health.base * f.strength.base;
+        return std::pair<float, int>{score, id};
+    };
+    const auto me = unit(world.me());
+    int above = 0;
+    for (const auto& a : world.allies) {
+        if (!a.alive || a.facts().passive == Passive::gem_focus || (a.facts().ranged && linked_partner(world, a))) continue;
+        const auto u = unit(a);
+        if (u.second == me.second) continue;
+        above += u.first > me.first || (u.first == me.first && u.second < me.second);
+    }
+    return above < params::pack_escorts;
+}
+
+// Group g lies within pack_reach (+ slack) of the anchor's centre (or there is no anchor): Prism can still come for a
+// capture there. The crow's steps first, then, at a claimed group, the walk from that group's centre field,
+// made once and kept; short of fuel for it, the crow's.
+bool in_pack(const World& world, Pathing& pathing, int g, int slack) {
+    const auto& anchor = pack_anchor(world);
+    if (anchor.prism < 0 || g == anchor.group) return true;
+    const auto& G = world.map().groups[g];
+    const int reach = pack_reach() + slack;
+    if (steps_to(G, anchor.centre) > reach) return false;
+    if (anchor.group < 0) return true;
+    const Field* field = pathing.from_centre(anchor.group);
+    if (!field && fuel_ok(full_field_cost_estimate() + end_reserve)) field = pathing.centre_field(anchor.group);
+    if (!field) return true;
+    int walk = unreachable;
+    for (const auto& m : G.members) walk = std::min(walk, field->at(m.pos));
+    return walk == unreachable || walk <= reach;
+}
