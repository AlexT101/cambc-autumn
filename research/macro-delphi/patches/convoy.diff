+const ConvoySupport& convoy_support(const World& world) {
+    static ConvoySupport support;
+    static int round = -1;
+    if (round == world.round) return support;
+    round = world.round, support = ConvoySupport{};
+    if (world.me().facts().passive != Passive::gem_focus) return support;
+    const auto& groups = world.map().groups;
+    for (const auto& a : world.allies) {
+        if (a.is_self || !a.alive || support.n == static_cast<int>(support.at.size())) continue;
+        const int g = comms::claim_of(world, a.index);
+        vec2 at;
+        int slack = 0;
+        if (g >= 0 && g < static_cast<int>(groups.size())) support.group[support.n] = g, support.at[support.n++] = groups[g].centre;
+        else if (recent_tile(world, a, at, slack)) support.group[support.n] = -1, support.at[support.n++] = at;
+    }
+    return support;
+}
+
+// Group g lies within carry_reach of some ally's work (or none is known): an ally there can still hand Prism a
+// capture, and reach Prism's fight within about two ability cooldowns. The crow's steps first, then, from a
+// claimed group, the walk down its centre field (made once and kept); short of fuel for it, the crow's.
+bool in_convoy(const World& world, Pathing& pathing, int g) {
+    const auto& support = convoy_support(world);
+    if (support.n == 0) return true;
+    const auto& G = world.map().groups[g];
+    for (int i = 0; i < support.n; ++i) {
+        const int h = support.group[i];
+        if (g == h) return true;
+        if (steps_to(G, support.at[i]) > carry_reach()) continue;
+        if (h < 0) return true;
+        const Field* field = pathing.from_centre(h);
+        if (!field && fuel_ok(full_field_cost_estimate() + act_reserve)) field = pathing.centre_field(h);
+        if (!field) return true;
+        int walk = unreachable;
+        for (const auto& m : G.members) walk = std::min(walk, field->at(m.pos));
+        if (walk == unreachable || walk <= carry_reach()) return true;
+    }
+    return false;
+}
