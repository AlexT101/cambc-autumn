+// Cassi's or Issac's living partner, else null. By index, not address: c may be a copy of a belief
+// (turn_order's live self).
+inline const ChampionBelief* living_partner(const World& world, const ChampionBelief& c) {
+    if (c.facts().passive != Passive::linked_pair) return nullptr;
+    for (const auto& o : c.side == team::ally ? world.allies : world.enemies)
+        if (o.index != c.index && o.facts().passive == Passive::linked_pair) return o.alive ? &o : nullptr;
+    return nullptr;
+}
+
+// Cassi or Issac whose partner lives: its death takes a second life.
+inline bool pair_partner_alive(const World& world, const ChampionBelief& c) { return living_partner(world, c) != nullptr; }
+
+// The second life its death takes (pair_partner_alive), in params value units: the partner's full
+// health and life, as kill_distance prices a body from full. 0 for anyone else.
+inline float pair_life_extra(const World& world, const ChampionBelief& c) {
+    const auto* p = living_partner(world, c);
+    return p ? p->max_health + params::life_value : 0.0f;
+}
+
+// A kill's worth beyond the body's own health and life (kill_distance's bag): both bags and the
+// second life.
+inline float kill_bag(const World& world, const ChampionBelief& c) {
+    return params::gem_value * static_cast<float>(pair_gems(world, c)) + pair_life_extra(world, c);
+}
