+// The tiles a dominant enemy Prism (yields_to) reaches with a unit cast after one step, off our
+// spawn; null if none is in sight. Already inside, only the tiles closer to it than ours: the steps
+// may then not close in, and lead out.
+const bitboard* prism_yield_zone(const World& world) {
+    if (world.me().facts().passive != Passive::gem_focus) return nullptr;
+    static bitboard zone{cambc::uninitialized};
+    bool any = false;
+    const vec2 here = my_position();
+    for (const auto& e : world.enemies) {
+        if (!yields_to(world, e)) continue;
+        constexpr int reach = ability_range + 1;
+        const int d = dist(here, e.pos);
+        if (d > reach + 2) continue; // no step or dash of ours lands in it
+        if (!any) clear_board(zone), any = true;
+        draw_square(zone, e.pos, static_cast<float>(std::min(reach, d - 1)));
+        debug_block({ std::printf("YIELD %d %.1f %.1f %d\n", world.round, e.focus, world.me().focus, d); });
+    }
+    if (!any) return nullptr;
+    drop(zone, world.map().ally_spawn);
+    return &zone;
+}
