+// Our Prism facing a visible enemy Prism of at least twice our Focus: we keep out of its reach and
+// start no fight on it (the dominated Prism dies, and hands its bag over).
+inline bool yields_to(const World& world, const ChampionBelief& e) {
+    const auto& self = world.me();
+    return self.facts().passive == Passive::gem_focus && e.alive && e.visible && e.facts().passive == Passive::gem_focus
+           && e.focus >= 2 * self.focus;
+}
