diff -ruN charybdis-ref/src/combat/rally.cc rally/src/combat/rally.cc
--- charybdis-ref/src/combat/rally.cc	1970-01-01 00:00:00.000000000 +0000
+++ rally/src/combat/rally.cc	2026-11-11 19:42:36.863958534 +0000
@@ -0,0 +1,258 @@
+// The team answers fights: each champion posts the fight it is in (comms::fight), and one that is
+// not engaged walks to a fight it can reach within a cooldown while its arrival makes our side at
+// least level there. Re-decided every turn: nothing commits it beyond the post's recency.
+#include "../bot_parts.h"
+
+namespace aph {
+
+namespace {
+
+// What an engaged champion sees around it: the enemies of its fight.
+constexpr int fight_site_radius = vision_radius;
+// A post older than this is a fight over or moved on.
+constexpr int fight_recency = 2;
+
+float champion_damage_taken = 0; // since our previous turn (rally_turn_start)
+
+// A visible enemy off its spawn whose strike before its next turn reaches p. One on its spawn heals
+// each turn end and is not followed there.
+bool enemy_reaches(const World& world, vec2 p) {
+    const auto& spawn = world.map().enemy_spawn;
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && strike(e, next_turn_round(world, e)).hits(dist(p, e.pos)) && !test(spawn, e.pos)) return true;
+    return false;
+}
+
+int enemies_seen_near(const World& world, vec2 p) {
+    int n = 0;
+    for (const auto& e : world.enemies) n += e.alive && e.visible && dist(p, e.pos) <= fight_site_radius;
+    return n;
+}
+
+// Our hit or cast on an enemy champion this turn, champion damage since our previous turn, or a
+// visible enemy's strike on our tile.
+bool self_engaged(const World& world) {
+    if (!world.me().alive) return false;
+    const vec2 here = my_position();
+    return here.x >= 0 && (engaged != 0 || champion_damage_taken > 0.5f || enemy_reaches(world, here));
+}
+
+// For the traces: our answers since the first of a run, and whether one reached the fight.
+struct AnswerRun {
+    int first = -1, last = -1, turns = 0;
+    vec2 at{-1, -1};
+};
+AnswerRun answer_run;
+
+struct Site {
+    vec2 at;
+    int round, radius, enemies;
+    bool seen;
+};
+
+// Where ally a is within the last fight_recency rounds, seen or posted, with the steps it may have
+// walked since.
+bool ally_tile(const World& world, const ChampionBelief& a, vec2& at, int& age) {
+    if (a.visible) return at = a.pos, age = 0, true;
+    int told = -1;
+    if (params::comms_ally && comms::told_ally(a.index, at, told) && told >= world.round - fight_recency && told > a.pos_round)
+        return age = world.round - told + 2, true;
+    if (a.pos_round >= world.round - fight_recency && in_bounds(a.pos)) return at = a.pos, age = world.round - a.pos_round, true;
+    return false;
+}
+
+// Health times damage a side at the site, as the pack zone weighs them (guard.cc): us and the allies
+// near it against the enemies we believe near it, at least as many as posted.
+struct Sides {
+    float ours = 0, theirs = 0;
+    int allies = 0, enemies = 0;
+    bool stronger_prism = false; // an enemy Prism there with more Focus than ours, if we are Prism
+};
+
+Sides weigh(const World& world, const Site& s) {
+    Sides out;
+    const auto& me = world.me();
+    float oh = (my_health() + me.shield) / me.taken, od = output(me);
+    for (const auto& a : world.allies) {
+        vec2 at;
+        int age = 0;
+        if (a.is_self || !a.alive || !ally_tile(world, a, at, age) || dist(at, s.at) > fight_site_radius + age) continue;
+        oh += effective_hp(a), od += output(a), ++out.allies;
+    }
+    // A post names no poster, which stands there though we may place no ally there: the weakest.
+    if (!s.seen && out.allies == 0) {
+        const ChampionBelief* weakest = nullptr;
+        for (const auto& a : world.allies)
+            if (!a.is_self && a.alive && (!weakest || effective_hp(a) * output(a) < effective_hp(*weakest) * output(*weakest))) weakest = &a;
+        if (weakest) oh += effective_hp(*weakest), od += output(*weakest), ++out.allies;
+    }
+    float th = 0, td = 0;
+    std::uint32_t counted = 0;
+    const bool prism = me.facts().passive == Passive::gem_focus;
+    for (const auto& e : world.enemies) {
+        if (!e.alive || !in_bounds(e.pos)) continue;
+        const int age = e.visible ? 0 : world.round - e.pos_round;
+        if (age > ability_cooldown || dist(e.pos, s.at) > fight_site_radius + age) continue;
+        th += effective_hp(e), td += output(e), ++out.enemies, counted |= 1u << e.index;
+        out.stronger_prism |= prism && e.facts().passive == Passive::gem_focus && e.focus > me.focus;
+    }
+    // A fight with no count posted has at least the enemy that engaged the poster: the strongest
+    // unaccounted, as for every posted enemy we do not place there; not one we know is elsewhere.
+    for (int want = std::max(s.enemies, 1); out.enemies < want;) {
+        const ChampionBelief* best = nullptr;
+        for (const auto& e : world.enemies)
+            if (e.alive && !(counted >> e.index & 1) && !e.visible && !(in_bounds(e.pos) && world.round - e.pos_round <= ability_cooldown)
+                && (!best || effective_hp(e) * output(e) > effective_hp(*best) * output(*best))) best = &e;
+        if (!best) break;
+        th += effective_hp(*best), td += output(*best), ++out.enemies, counted |= 1u << best->index;
+        out.stronger_prism |= prism && best->facts().passive == Passive::gem_focus && best->focus > me.focus;
+    }
+    out.ours = oh * od, out.theirs = th * td;
+    return out;
+}
+
+// Steps to within s.radius of the site, if at most `limit`: a field capped just past it, kept for the round.
+const Field* site_field(const World& world, Pathing& pathing, const Site& s, int limit) {
+    static Field field;
+    static vec2 made_at{-1, -1};
+    static int made_round = -1, made_radius = -1;
+    if (made_round != world.round || made_at != s.at || made_radius != s.radius) {
+        static bitboard goals{cambc::uninitialized}, visited{cambc::uninitialized};
+        const auto& walls = pathing.static_walls();
+        made_round = -1;
+        clear_board(goals);
+        draw_square(goals, s.at, static_cast<float>(s.radius));
+        not_into(walls, field.goals);
+        field.goals &= goals;
+        if (field.goals.is_empty()) return nullptr;
+        (void)field.steps.compute_with_expansion_count(walls, field.goals, visited, static_cast<std::uint16_t>(limit + 1));
+        made_round = world.round, made_at = s.at, made_radius = s.radius;
+    }
+    return field.at(my_position()) <= limit ? &field : nullptr;
+}
+
+void rally_turn_start(const World& world, Safety& safety, float damage) {
+    const vec2 here = world.me().pos;
+    champion_damage_taken = damage > 0 && world.me().alive ? damage - std::min(damage, safety.camp_damage(here)) : 0.0f;
+    if (champion_damage_taken <= 0) return;
+    // camp_damage misses fire it did not foresee (a camp it took for asleep): only with an enemy that
+    // could have struck us is the loss a champion's.
+    for (const auto& e : world.enemies)
+        if (e.alive && (e.visible ? dist(here, e.pos) <= Strike::max_reach : e.tracked && possible_within(e, here, Strike::max_reach))) return;
+    champion_damage_taken = 0;
+}
+
+void rally_turn_end(const World& world) {
+    const bool fighting = self_engaged(world);
+    debug_block({
+        if (fighting) {
+            const vec2 p = my_position();
+            std::printf("RALLY-POST %d %u %d %d %d%d%d %d %.0f\n", world.round, my_handle(), p.x, p.y, engaged != 0, champion_damage_taken > 0.5f,
+                        enemy_reaches(world, p), enemies_seen_near(world, p), champion_damage_taken);
+        }
+    });
+    comms::fight(world.round, fighting ? enemies_seen_near(world, my_position()) : -1);
+    auto& r = answer_run;
+    if (r.first < 0) return;
+    if (fighting) {
+        debug_block({ std::printf("RALLY-ARRIVE %d %u %d %d\n", world.round, my_handle(), world.round - r.first, r.turns); });
+        r = {};
+    } else if (world.round - r.last > ability_cooldown) {
+        debug_block({ std::printf("RALLY-MISS %d %u %d %d\n", world.round, my_handle(), r.last - r.first, r.turns); });
+        r = {};
+    }
+}
+
+bool answer_fight(const World& world, Pathing& pathing, Safety& safety) {
+    const auto& me = world.me();
+    if (!me.alive || stunned_turn || !my_can_move() || channelling() || banks_bag(world, pathing)) return false;
+    if (my_health() <= params::hurt_health_fraction * my_max_health() || self_engaged(world)) return false;
+    const vec2 here = my_position();
+    // The latest fights first: those we see now, nearest first, then the one posted.
+    Unwritten<Site, 9> scratch;
+    auto& sites = scratch.a;
+    int n = 0;
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible && n < 8 && enemy_reaches(world, a.pos)) {
+            const Site s{a.pos, world.round, 1, enemies_seen_near(world, a.pos), true};
+            int i = n++;
+            for (; i > 0 && dist(here, sites[static_cast<std::size_t>(i - 1)].at) > dist(here, s.at); --i) sites[static_cast<std::size_t>(i)] = sites[static_cast<std::size_t>(i - 1)];
+            sites[static_cast<std::size_t>(i)] = s;
+        }
+    {
+        Site s{};
+        if (comms::told_fight(s.at, s.round, s.enemies, s.radius) && s.round >= world.round - fight_recency) {
+            s.radius = std::max(1, s.radius), s.seen = false;
+            sites[static_cast<std::size_t>(n++)] = s;
+        }
+    }
+    // One cooldown is an exchange of casts: arriving later misses it.
+    const int dash = me.facts().slot_of(AbilityKind::dash);
+    const int limit = ability_cooldown + (dash >= 0 && me.ability_ready(dash, world.round) ? dash_range : 0);
+    for (int i = 0; i < n; ++i) {
+        const auto& s = sites[static_cast<std::size_t>(i)];
+        // Beside a fight already: not off to another.
+        if (dist(here, s.at) <= s.radius) return false;
+        if (dist(here, s.at) - s.radius > limit) continue;
+        if (!fuel_ok(act_reserve + search_cost_estimate(limit + 1))) return false;
+        const Field* field = site_field(world, pathing, s, limit);
+        if (!field) continue;
+        // The latest fight we reach is the one considered.
+        const auto sides = weigh(world, s);
+        const bool join = sides.ours >= sides.theirs && !sides.stronger_prism;
+        bool moved = false;
+        if (join) {
+            step_safely(world, pathing, *field, safety);
+            moved = my_position() != here;
+        }
+        // join: 0 declined, 1 joined without a step, 2 stepped.
+        debug_block({
+            std::printf("RALLY %d %u %c %d %d %d %d %d %d %d %.0f %.0f %d\n", world.round, my_handle(), s.seen ? 's' : 'p', s.at.x, s.at.y,
+                        world.round - s.round, field->at(here), sides.allies, sides.enemies, s.enemies, sides.ours / 1e3f, sides.theirs / 1e3f,
+                        join + moved);
+        });
+        if (!moved) return false;
+        decision = Branch::answer;
+        auto& r = answer_run;
+        if (r.first < 0) r.first = world.round, r.turns = 0;
+        r.last = world.round, r.at = s.at, ++r.turns;
+        return true;
+    }
+    return false;
+}
+
+// An ally within fight_ally_radius of us is engaged and an enemy champion is in our basic or cast reach.
+bool rally_targets_champions(const World& world) {
+    if (!world.me().alive) return false;
+    const vec2 here = my_position();
+    if (here.x < 0) return false;
+    const auto& f = world.me().facts();
+    const int reach = std::max(f.basic_reach(), f.cast_reach());
+    bool in_reach = false;
+    for (const auto& e : world.enemies) in_reach |= e.alive && e.visible && dist(here, e.pos) <= reach;
+    if (!in_reach) return false;
+    for (const auto& a : world.allies)
+        if (!a.is_self && a.alive && a.visible && dist(here, a.pos) <= safety_params::fight_ally_radius && enemy_reaches(world, a.pos)) return true;
+    return false;
+}
+
+int rally_hit(const World& world) {
+    // strike_enemy found nothing from here this turn: the other camp targets would ask it again.
+    static int kept_round = -1;
+    static vec2 kept_at{-1, -1};
+    if (!rally_targets_champions(world)) return 0;
+    if (!my_can_attack()) return 2;
+    const vec2 here = my_position();
+    if (kept_round == world.round && kept_at == here) return 0;
+    if (!strike_enemy(world)) {
+        kept_round = world.round, kept_at = here;
+        debug_block({ std::printf("RALLY-KEEP %d %u\n", world.round, my_handle()); });
+        return 0;
+    }
+    debug_block({ std::printf("RALLY-HIT %d %u\n", world.round, my_handle()); });
+    return 1;
+}
+
+} // namespace
+
+} // namespace aph
