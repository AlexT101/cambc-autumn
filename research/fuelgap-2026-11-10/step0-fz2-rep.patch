+template <int Scope> struct PauseScope {
+    // Inside a FreeScope<Scope>: stop refunding until this ends (what is spent here is not refunded).
+    int saved = 0;
+    PauseScope() {
+        if constexpr (Scope == fz_scope)
+            if (fz_on() && fz_depth() > 0) {
+                const auto raw = fuel_raw();
+                if (fz_entry() > raw) fz_refund() += fz_entry() - raw;
+                saved = fz_depth(), fz_depth() = 0;
+            }
+    }
+    ~PauseScope() {
+        if constexpr (Scope == fz_scope)
+            if (saved > 0) fz_depth() = saved, fz_entry() = fuel_raw();
+    }
+    PauseScope(const PauseScope&) = delete;
+    PauseScope& operator=(const PauseScope&) = delete;
+};
