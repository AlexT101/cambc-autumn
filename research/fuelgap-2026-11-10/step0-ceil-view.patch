+// Fuel-ceiling view (measurement only): run on a 2x quantum, fuel() reads the budget less one 1x budget (set per
+// turn in main.cc), so every gate cuts as at 1x and only out-of-fuel turns go away.
+inline std::int64_t& fuel_shift() {
+    static std::int64_t shift = 0;
+    return shift;
+}
+inline std::uint64_t fuel() {
+    const auto raw = static_cast<std::uint64_t>(cambc::detail::sdk_fuel_remaining());
+    const auto s = static_cast<std::uint64_t>(fuel_shift());
+    return raw > s ? raw - s : 0;
+}
