+// Fuel-ceiling decomposition (measurement only, EXPERIMENTS "Fuel ceiling (ocean, 2026-11-08)"): run on a
+// fv_mult x quantum with gates reading the 1x budget (fuel_shift(), set per turn in main.cc), and fuel spent
+// inside the fz_scope subsystem (FreeScope) refunded to every read: "what if subsystem X cost nothing".
+// fz_scope: 0 none, 1 farm, 2 step guard, 3 prey, 4 fight trade, 5 strike search, 6 world update, 7 turn order,
+// 8 turn-end queue.
+inline constexpr int fv_sign = -1;
+inline constexpr int fv_mult = 100;
+inline constexpr int fz_scope = 0;
+// fz_when: 0 every turn, 1 the first turn only, 2 every turn but the first. t1_mult: the first turn's gates read t1_mult x 200k.
+inline constexpr int fz_when = 0;
+inline constexpr int t1_mult = 1;
+inline bool& fz_first() {
+    static bool f = true;
+    return f;
+}
+inline bool fz_on() { return fz_when == 0 || (fz_when == 1) == fz_first(); }
+inline std::int64_t& fuel_shift() {
+    static std::int64_t shift = 0;
+    return shift;
+}
+inline std::uint64_t& fz_refund() {
+    static std::uint64_t r = 0;
+    return r;
+}
+inline int& fz_depth() {
+    static int d = 0;
+    return d;
+}
+inline std::uint64_t& fz_entry() {
+    static std::uint64_t e = 0;
+    return e;
+}
+inline std::uint64_t fuel_raw() { return static_cast<std::uint64_t>(cambc::detail::sdk_fuel_remaining()); }
+inline std::uint64_t fuel() {
+    const auto raw = fuel_raw();
+    const auto s = fuel_shift();
+    std::uint64_t v = s >= 0 ? raw + static_cast<std::uint64_t>(s) : raw > static_cast<std::uint64_t>(-s) ? raw - static_cast<std::uint64_t>(-s) : 0;
+    if constexpr (fz_scope != 0) {
+        v += fz_refund();
+        if (fz_depth() > 0 && fz_entry() > raw) v += fz_entry() - raw;
+    }
+    // Never above what is really left: a dear free subsystem must not run the rest out.
+    v = std::min(v, raw);
+    return v;
+}
+template <int Scope> struct FreeScope {
+    FreeScope() {
+        if constexpr (Scope == fz_scope)
+            if (fz_on() && fz_depth()++ == 0) fz_entry() = fuel_raw();
+    }
+    ~FreeScope() {
+        if constexpr (Scope == fz_scope)
+            if (fz_on() && --fz_depth() == 0) {
+                const auto raw = fuel_raw();
+                if (fz_entry() > raw) fz_refund() += fz_entry() - raw;
+            }
+    }
+    FreeScope(const FreeScope&) = delete;
+    FreeScope& operator=(const FreeScope&) = delete;
+};
