+int safe_turns(const World& world, const ChampionBelief& holder, const ChampionBelief& e, int altar, vec2 p, bool tile, int limit,
+               bool dead_now, bool informed, bool cheap) {
+    const int R = world.round;
+    if (limit <= 0) return 0;
+    const auto& map = world.map();
+    if (altar < 0 || altar >= static_cast<int>(map.altars.size())) return never;
+    const std::uint32_t key = static_cast<std::uint32_t>(e.index) | static_cast<std::uint32_t>(holder.index) << 3
+                              | static_cast<std::uint32_t>(altar) << 6 | static_cast<std::uint32_t>(p.x) << 11
+                              | static_cast<std::uint32_t>(p.y) << 18 | static_cast<std::uint32_t>(tile) << 25
+                              | static_cast<std::uint32_t>(dead_now) << 26 | static_cast<std::uint32_t>(informed) << 27
+                              | static_cast<std::uint32_t>(holder.side == team::enemy) << 28 | static_cast<std::uint32_t>(cheap) << 29;
+    auto& slot = cache[(key * 2654435761u) >> 26];
+    if (slot.round == R && slot.key == key && (slot.value < slot.limit || limit <= slot.limit)) return std::min(slot.value, limit);
+
+    const auto& f = e.facts();
+    const bool immune = holder.facts().passive == Passive::stun_immune;
+    const int widen = tile ? 0 : static_cast<int>(cambc::constants::submit_gems_range);
+    const vec2 ap = map.altars[altar].pos;
+    // Where its walk starts, and its first turn that can act.
+    enum class From { tile, unseen, spawn } from = From::tile;
+    vec2 origin{-1, -1};
+    int first = R;
+    int lag = 0; // rounds an unseen enemy has walked since its last sighting
+    bool ready_all = false; // respawned: both abilities ready
+    // Informed: only an enemy that sees the tile can answer a channel there: in our sight, possibly in sight of it while
+    // unseen, or through its ward (then even dead, from its respawn).
+    if (informed && !ward_watches(world, e, p, widen)
+        && !(e.alive && !dead_now && (e.visible || (e.tracked && possible_within(e, p, vision_radius + widen)))))
+        return never;
+    if (dead_now || !e.alive) {
+        // Died in our turn now: its respawn turn comes at R + respawn_time at the earliest (before its own turn).
+        const int respawn = dead_now ? R + static_cast<int>(cambc::constants::respawn_time) : e.respawn_earliest;
+        if (respawn < 0) return never;
+        first = respawn + 1; // no walk, attack or cast on the respawn turn
+        from = From::spawn;
+        ready_all = true;
+    } else if (e.visible) {
+        origin = enemy_reach::origin(e);
+        first = next_turn_round(world, e);
+    } else {
+        from = From::unseen;
+        origin = e.pos;
+        lag = e.pos_round < 0 ? 1 << 20 : R - e.pos_round + 1; // seen before its own turn that round: one walk more
+        first = next_turn_round(world, e);
+    }
+    // Steps it needs to stand within `reach` of `target` (a lower bound); never if no walk gets there. Asked up to
+    // `cap` steps: the stop then falls past the limit anyway.
+    const int cap = limit + 1;
+    // The Chebyshev distance from `target` to e's nearest possible tile, if within `most`; else most + 1.
+    struct Near {
+        vec2 target{-1, -1};
+        int most = -1, value = 0;
+    };
+    std::array<Near, 2> nears{};
+    const auto possible_distance = [&](vec2 target, int most) {
+        for (auto& n : nears)
+            if (n.target == target && (n.most >= most || n.value <= n.most)) return std::min(n.value, most + 1);
+        int value = most + 1;
+        if (possible_within(e, target, most)) {
+            int lo = 0, hi = most;
+            while (lo < hi) {
+                const int mid = (lo + hi) / 2;
+                if (possible_within(e, target, mid)) hi = mid;
+                else lo = mid + 1;
+            }
+            value = lo;
+        }
+        auto& slot = nears[nears[0].most < 0 ? 0 : 1];
+        slot = {target, most, value};
+        return value;
+    };
+    const auto steps_to = [&](int reach, vec2 target) -> int {
+        if (from == From::spawn) {
+            int best = never;
+            for (int dx = -reach; dx <= reach; ++dx)
+                for (int dy = -reach; dy <= reach; ++dy) {
+                    const vec2 q{target.x + dx, target.y + dy};
+                    if (!in_bounds(q)) continue;
+                    const int s = map.enemy_spawn_steps(q);
+                    if (s != unreachable) best = std::min(best, s);
+                }
+            return best;
+        }
+        const enemy_reach::Profile who{reach, f.has_dash()};
+        int s = 0;
+        if (in_bounds(origin) && cheap) {
+            s = std::max(0, dist(origin, target) - reach - (from == From::unseen ? lag : 0));
+        } else if (in_bounds(origin)) {
+            const int d = enemy_reach::distance(world, who, origin, target, reach + cap + (from == From::unseen ? std::min(lag, 64) : 0));
+            if (d >= enemy_reach::far) {
+                if (from == From::tile) return never;
+            } else {
+                s = std::max(0, d - reach - (from == From::unseen ? lag : 0));
+            }
+        }
+        if (from == From::unseen && e.tracked) {
+            // The fewest steps from a tile it may be on, as the crow flies: the nearest such tile, found once a target.
+            const int near = possible_distance(target, reach + cap);
+            s = std::max(s, std::max(0, near - reach));
+        }
+        return s;
+    };
+    int stop = never; // the round of its earliest stopping turn
+    const auto turn_round = [&](int steps, bool walk_ok) {
+        // A dasher covers 2 more a dash, one a cooldown (taken as ready now): the fewest walking turns for the steps.
+        if (f.has_dash() && steps > 0) {
+            int t = 0;
+            while (t + 2 * ((t + ability_cooldown - 1) / ability_cooldown) < steps) ++t;
+            steps = std::max(1, t);
+        }
+        // A stop that may follow a walk lands on the turn of the last step; one that excludes walking a turn after.
+        const int turns = steps == 0 ? 1 : walk_ok ? steps : steps + 1;
+        return first + turns - 1;
+    };
+    if (!immune)
+        for (int s = 0; s < 2; ++s) {
+            const int reach = f.stun_reach(s);
+            if (reach < 0) continue;
+            const int steps = steps_to(reach + widen, p);
+            if (steps >= never) continue;
+            int r = turn_round(steps, f.stun_reach_with_walk(s) > reach);
+            if (!ready_all) r = std::max(r, e.ready_round[static_cast<std::size_t>(s)]);
+            stop = std::min(stop, r);
+        }
+    if (dead_now || may_carry_lock(world, e)) {
+        const int steps = steps_to(altar_lock_range, ap);
+        if (steps < never) stop = std::min(stop, turn_round(steps, true));
+    }
+    int value = never;
+    if (stop < never) {
+        // Its turn in round `stop` cancels a channel completing at the holder's turn start that round only if it comes first.
+        const bool before = enemy_earliest_slot(world, e, stop) < world.slot(holder, stop);
+        value = std::max(0, stop - R - (before ? 1 : 0));
+    }
+    slot = {R, key, value, limit};
+    return std::min(value, limit);
+}
+
+} // namespace aph::stop_eta
diff -ruN bots/variants/chy-ref/src/model/stop_eta.h bots/variants/ia-finish/src/model/stop_eta.h
--- bots/variants/chy-ref/src/model/stop_eta.h	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/ia-finish/src/model/stop_eta.h	2026-11-13 16:02:53.606780653 +0000
@@ -0,0 +1,33 @@
+// Stop ETA: how long a tribute channel at a tile can run before an enemy could stop it. A stun (unit, ground,
+// landing or Marcella's stunning attack) cancels any channel, and a lock placed on the altar cancels every
+// tribute there, whatever the channel's length; the kill window (tribute_safe) does not see either.
+//
+// safe_turns() is the most turn ends a channel at p that starts this turn (or is running, with that many left)
+// can have and still complete, at the holder's turn start in round + turns, before e's earliest turn that could
+// stop it. Its tools: each stun slot (its reach from the rules, after a walk unless it excludes walking, once its
+// cooldown is believed ready) and a lock (any enemy may carry one: placed within altar_lock_range of the altar,
+// after a walk, no cast). Its walk: from its tile in sight (enemy_reach's terrain), from its last tile less the
+// rounds since and from its `possible` tiles while unseen, from its spawn after its respawn turn while dead.
+// Every bound is a lower one: the true stop comes no sooner.
+#pragma once
+#include "../util.h"
+
+namespace aph {
+
+class World;
+struct ChampionBelief;
+
+namespace stop_eta {
+
+inline constexpr int never = 1 << 14;
+
+// `tile`: p is the tribute tile itself; else p is the altar and each reach grows by the tribute range, a bound for
+// every tribute tile of it. `limit`: only whether the answer reaches it matters (it is capped there). `dead_now`:
+// as if e died in our turn now. `informed`: an unseen enemy binds only if it may see p now (or its ward does). `cheap`:
+// walks as the crow flies, a lower bound still (terrain only lengthens them), without the terrain's searches.
+int safe_turns(const World& world, const ChampionBelief& holder, const ChampionBelief& e, int altar, vec2 p, bool tile, int limit,
+               bool dead_now = false, bool informed = false, bool cheap = false);
+
+} // namespace stop_eta
+
+} // namespace aph
