+// A long winning channel at our tile p of `altar` waits only for a window it can reach: an enemy that sees p could
+// stop it there, while another altar's window is open on arrival and the enemy's clock outlasts the walk and the
+// channel. Waiting where we stand opens none (an enemy in sight is fought as before, a ward keeps watching), so
+// with no such altar, or the round limit near, the kill window decides as before.
+bool window_shut(const World& world, Pathing& pathing, const Memory& memory, int altar, vec2 p, int turns) {
+    if (altar < 0 || !long_winning(world, turns) || rounds_left(world) <= turns + endgame_margin) return false;
+    // The clock first: it rules most waits out at no cost.
+    const int clock = enemy_clock(world);
+    if (clock <= turns) return false;
+    const auto w = window_at(world, world.me(), altar, p, true, turns);
+    if (w.safe >= turns) return false;
+    int steps = unreachable;
+    const int go = finish_altar(world, pathing, memory, steps);
+    const bool shut = go >= 0 && go != altar && clock > steps + turns;
+    debug_block({
+        static int said = -1;
+        if (said != world.round) {
+            said = world.round;
+            std::printf("WIN %d %u turns %d safe %d binding %d go %d steps %d clock %d shut %d\n", world.round, my_handle(), turns, w.safe,
+                        w.binding, go, steps, clock, static_cast<int>(shut));
+        }
+    });
+    return shut;
+}
