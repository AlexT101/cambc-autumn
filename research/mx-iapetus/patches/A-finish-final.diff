+// Kept for the round: the strike search and the bank ask the same few tiles.
+struct Entry {
+    int round = -1;
+    std::uint32_t key = 0;
+    int value = 0, limit = 0; // value is exact below the limit it was asked with
+};
+std::array<Entry, 64> cache;
+
+} // namespace
