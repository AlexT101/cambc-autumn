+// For a long winning bag, the nearest reachable altar where a channel begun on arrival can finish (no enemy that sees
+// it could stop it within the walk and the channel), or -1. Kept for the turn's tile and bag.
+int finish_altar(const World& world, Pathing& pathing, const Memory& memory, int& steps_out) {
+    struct Key {
+        int round = -1;
+        vec2 here{-1, -1};
+        std::uint32_t gems = 0;
+        int avoid = -1, avoid_until = -1;
+        bool operator==(const Key&) const = default;
+    };
+    static Key last;
+    static int kept = -1, kept_steps = unreachable;
+    const vec2 here = my_position();
+    const Key key{world.round, here, my_gems(), memory.avoid_altar, memory.avoid_until};
+    if (key == last) {
+        if (kept >= 0) steps_out = kept_steps;
+        return kept;
+    }
+    last = key;
+    kept = -1, kept_steps = unreachable;
+    const int turns = tribute_turns(world, my_gems());
+    if (!long_winning(world, turns)) return -1;
+    const auto& altars = world.map().altars;
+    for (int a = 0; a < static_cast<int>(altars.size()); ++a) {
+        // An optional search (the nearest altar serves without it): within half a turn's fuel, on maps of many altars.
+        if (!fuel_ok(50000)) break; // half the rules' 100k turn
+        if (world.altars[a].enemy_lock || (a == memory.avoid_altar && world.round < memory.avoid_until)) continue;
+        // The walk is at least the crow's: an altar whose window shuts within that needs no field.
+        const int least = std::max(0, dist(here, altars[a].pos) - static_cast<int>(cambc::constants::submit_gems_range));
+        if (least >= kept_steps || least + turns >= rounds_left(world)) continue;
+        if (window_at(world, world.me(), a, altars[a].pos, false, least + turns, true).safe < least + turns) continue;
+        // A field per altar: the scan stops while the fuel left would not cover one.
+        if (!fuel_ok(full_field_cost_estimate() + 2000)) break;
+        const int steps = altar_steps(world, pathing, here, a);
+        if (steps == unreachable || steps >= kept_steps || steps + turns >= rounds_left(world)) continue;
+        if (window_at(world, world.me(), a, altars[a].pos, false, steps + turns).safe >= steps + turns) kept = a, kept_steps = steps;
+    }
+    debug_block({
+        if (kept >= 0) std::printf("WALTAR %d %u altar %d steps %d\n", world.round, my_handle(), kept, kept_steps);
+    });
+    if (kept >= 0) steps_out = kept_steps;
+    return kept;
+}
