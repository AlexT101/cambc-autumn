+// An enemy in sight shows its consumables; one out of sight may have bought a lock on its spawn or while dead.
+bool may_carry_lock(const World& world, const ChampionBelief& e) {
+    // On its spawn it can buy one this turn.
+    if (!e.alive || !e.visible || test(world.map().enemy_spawn, e.pos)) return true;
+    std::array<std::uint32_t, 4> counts{};
+    if (cambc::detail::sdk_champion_consumables(static_cast<std::uint32_t>(e.handle), counts.data()) != 0) return true;
+    return counts[cambc::detail::raw_consumable_ids[static_cast<std::size_t>(cambc::consumable_type::altar_lock)]] > 0;
+}
+
+// Each enemy's ward as last seen (one each: a new one replaces it), and its sight. Wards never expire, so one is kept
+// until its tile is in our vision without it.
+struct SeenWard {
+    vec2 at{-1, -1};
+    bitboard sight{cambc::uninitialized};
+};
+std::array<SeenWard, 8> wards;
+int wards_round = -1;
+
+void refresh_wards(const World& world) {
+    if (wards_round == world.round) return;
+    wards_round = world.round;
+    static std::array<cambc::detail::ward_info, 16> raw;
+    std::uint32_t n = 0;
+    if (cambc::detail::sdk_wards(raw.data(), static_cast<std::uint32_t>(raw.size()), &n) != 0) n = 0;
+    const auto own = static_cast<std::uint32_t>(world.map().team_a ? 0 : 1);
+    std::uint32_t listed = 0;
+    for (std::uint32_t k = 0; k < n && k < raw.size(); ++k) {
+        const auto& w = raw[k];
+        if (w.team == own || w.disabled) continue;
+        std::size_t i = 0;
+        while (i < world.enemies.size() && static_cast<std::uint32_t>(world.enemies[i].handle) != w.owner) ++i;
+        if (i >= world.enemies.size() || i >= wards.size()) continue;
+        listed |= 1u << i;
+        const vec2 at{w.x, w.y};
+        if (wards[i].at == at) continue;
+        wards[i].at = at;
+        if (cambc::detail::sdk_ward_vision(at.x, at.y, wards[i].sight.ptr()) != 0) wards[i].at = {-1, -1};
+    }
+    for (std::size_t i = 0; i < wards.size(); ++i)
+        if (!(listed >> i & 1) && in_bounds(wards[i].at) && test(world.visible, wards[i].at)) wards[i].at = {-1, -1};
+}
+
+// e's ward, as last seen, sees a tile within `r` of p: its owner sees a channel there, alive or dead.
+bool ward_watches(const World& world, const ChampionBelief& e, vec2 p, int r) {
+    refresh_wards(world);
+    if (e.index < 0 || e.index >= static_cast<int>(wards.size())) return false;
+    const auto& w = wards[static_cast<std::size_t>(e.index)];
+    return in_bounds(w.at) && any_within(w.sight, p, r);
+}
