+// The finish window (model/stop_eta.h). A winning channel longer than the kill window (tribute_safe) is judged on
+// its first turns only, and a stun or a lock cancels it whatever its length: it starts only where no enemy could
+// stop it before it completes, while a window can be expected before the enemy's clock runs out.
+bool long_winning(const World& world, int turns) { return turns > params::tribute_window && winning_bag(world); }
+
+// At p, for a channel of `turns` held by `holder`: the fewest turns any enemy leaves it, how many could stop it (a
+// linked pair once: one death takes both), and which of those are in sight.
+struct FinishWindow {
+    int safe = stop_eta::never;
+    int binding = 0;
+    std::uint32_t seen = 0; // bit i: enemies[i], in sight, could stop it
+};
+FinishWindow window_at(const World& world, const ChampionBelief& holder, int altar, vec2 p, bool tile, int turns, bool cheap = false) {
+    FinishWindow w;
+    std::uint32_t counted = 0;
+    for (const auto& e : world.enemies) {
+        const int s = stop_eta::safe_turns(world, holder, e, altar, p, tile, turns, false, params::finish_informed, cheap);
+        w.safe = std::min(w.safe, s);
+        if (s >= turns || e.index >= 32) continue;
+        if (e.alive && e.visible) w.seen |= 1u << e.index;
+        const auto* mate = linked_partner(world, e);
+        if (!(mate && mate->index < 32 && (counted >> mate->index & 1))) ++w.binding;
+        counted |= 1u << e.index;
+    }
+    return w;
+}
+
+// Rounds until the enemy's tributes, at their recent rate, cover what it needs beyond the bags we last saw it carry.
+int enemy_clock(const World& world) {
+    int need = static_cast<int>(cambc::constants::winning_gems) - world.score.enemy;
+    for (const auto& e : world.enemies) need -= e.alive ? std::max(0, e.gems) : 0;
+    if (need <= 0) return 0;
+    const float rate = world.enemy_rate();
+    const float rounds = rate > 0 ? static_cast<float>(need) / rate : static_cast<float>(rounds_left(world));
+    return static_cast<int>(std::min(rounds, static_cast<float>(rounds_left(world))));
+}
+
+// The team's winning bag not yet channelling: its holder (the largest), where its window is judged (its tribute
+// tile, else the nearest altar for any of its tiles) and its channel. Null holder if none, or one the kill window covers.
+struct TeamFinish {
+    const ChampionBelief* holder = nullptr;
+    int altar = -1;
+    vec2 p{-1, -1};
+    bool tile = false;
+    int turns = 0;
+};
+TeamFinish team_finish(const World& world) {
+    TeamFinish f;
+    int most = 0;
+    for (const auto& a : world.allies) {
+        if (!a.alive) continue;
+        const int bag = a.is_self ? static_cast<int>(my_gems()) : a.visible ? a.gems : comms::bag_of(world, a.index);
+        const bool tributing = a.is_self ? my_state().contains(cambc::champion_state::submitting_gems)
+                                         : a.visible && a.channel == Channel::tribute;
+        const vec2 pos = a.is_self ? my_position() : a.pos;
+        if (tributing || bag <= most || world.score.ally + bag < static_cast<int>(cambc::constants::winning_gems) || !in_bounds(pos)) continue;
+        most = bag;
+        f.holder = &a;
+        f.p = pos;
+        f.turns = tribute_turns(bag, a.is_self ? world.me().fast_tribute : a.fast_tribute);
+    }
+    if (!f.holder || f.turns <= params::tribute_window) return {};
+    f.altar = tribute_altar(world, f.p);
+    f.tile = f.altar >= 0;
+    if (!f.tile) {
+        int near = unreachable;
+        const auto& altars = world.map().altars;
+        for (int a = 0; a < static_cast<int>(altars.size()); ++a)
+            if (const int d = dist(f.p, altars[a].pos); d < near) near = d, f.altar = a;
+        if (f.altar < 0) return {};
+        f.p = altars[f.altar].pos;
+    }
+    return f;
+}
+
+float window_kill_value(const World& world, const ChampionBelief& e) {
+    static int round = -1;
+    static std::uint32_t stoppers = 0;
+    if (round != world.round) {
+        round = world.round;
+        stoppers = 0;
+        if (const auto f = team_finish(world); f.holder) stoppers = window_at(world, *f.holder, f.altar, f.p, f.tile, f.turns, true).seen;
+    }
+    // A stopper in sight of our winning bag's altar: its death takes a respawn off what shuts the window, worth a
+    // tribute stopped, as the channel it would stop is.
+    return e.side == team::enemy && e.index >= 0 && e.index < 32 && (stoppers >> e.index & 1) ? params::tribute_value : 0.0f;
+}
