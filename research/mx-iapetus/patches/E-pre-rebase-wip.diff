+void World::note_tribute(int enemy_index, vec2 at, int end_round, int gems) {
+    if (enemy_index < 0 || enemy_index >= static_cast<int>(enemies.size())) return;
+    auto& b = enemies[enemy_index];
+    if (!b.alive || b.visible) return;
+    if (gems <= 0) {
+        if (b.channel == Channel::tribute) b.channel = Channel::none;
+        return;
+    }
+    if (end_round <= round || !in_bounds(at)) return;
+    // Channelling, it stands where it was seen.
+    if (b.pos != at || b.pos_round < round - 1) note_sighting(enemy_index, at, round, b.max_health > 0 ? b.health / b.max_health : 1.0f);
+    b.channel = b.seen_channel = Channel::tribute;
+    b.channel_end_round = end_round;
+    if (b.facts().passive == Passive::gem_focus) b.focus += cambc::constants::passive_abilities::prism_focus_per_gem * static_cast<float>(gems - b.gems);
+    b.gems = gems;
+    b.relayed_round = round;
+}
