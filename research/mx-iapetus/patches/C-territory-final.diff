+// King steps an enemy covers in `turns` turns: one a turn, a dasher's dash range more once a cooldown.
+int enemy_cover(const ChampionBelief& e, int turns) {
+    if (turns <= 0) return 0;
+    return turns + (e.facts().has_dash() ? dash_range * ((turns + ability_cooldown - 1) / ability_cooldown) : 0);
+}
+// The farthest member tile from a group's centre. Static, so kept per group.
+int group_radius(const StaticMap& map, int g) {
+    static std::array<std::int16_t, 256> cache = [] {
+        std::array<std::int16_t, 256> a;
+        a.fill(-1);
+        return a;
+    }();
+    if (static_cast<std::size_t>(g) < cache.size() && cache[g] >= 0) return cache[g];
+    const auto& G = map.groups[g];
+    int r = 0;
+    for (const auto& m : G.members) r = std::max(r, dist(m.pos, G.centre));
+    if (static_cast<std::size_t>(g) < cache.size()) cache[g] = static_cast<std::int16_t>(r);
+    return r;
+}
+
+// Whether enemy e may come within its act range of a camp tile of group g within `rounds` rounds
+// from now, by lower bounds on its travel: dead, from its spawn after its earliest respawn (whose turn
+// allows no walk); alive, from where it is (seen), may be (tracked: the box holding `possible`) or was
+// last seen, or (`recalls`) from its spawn once a recall, under way or started now, lands. Chebyshev
+// distances (a walk is never shorter); teleport crystals and Vendetta's kill reset are not counted.
+bool may_contest(const World& world, const ChampionBelief& e, int g, int rounds, bool recalls) {
+    const auto& map = world.map();
+    const auto& G = map.groups[g];
+    const int reach = enemy_reach::act_range(e.facts()) + group_radius(map, g);
+    // Its turn this round may still come after ours.
+    const int turns = rounds + 1;
+    const auto spawn_need = [&] {
+        const auto& b = map.enemy_spawn_box;
+        const vec2 c = G.centre;
+        return std::max({b.x0 - c.x, c.x - b.x1, b.y0 - c.y, c.y - b.y1, 0}) - reach;
+    };
+    if (!e.alive) {
+        if (e.respawn_earliest < 0) return true;
+        const int walking = world.round + rounds - e.respawn_earliest;
+        return walking >= 0 && enemy_cover(e, walking) >= spawn_need();
+    }
+    if (recalls) {
+        const int lands = e.channel == Channel::recall && e.channel_end_round >= 0 ? std::max(0, e.channel_end_round - world.round) : e.recall_turns();
+        if (turns - lands >= 0 && enemy_cover(e, turns - lands) >= spawn_need()) return true;
+    }
+    if (e.visible) return enemy_cover(e, turns) >= dist(enemy_reach::origin(e), G.centre) - reach;
+    if (e.tracked) return e.possible_box.meets(G.centre, enemy_cover(e, turns) + reach);
+    if (e.pos.x < 0 || e.pos_round < 0) return true;
+    return enemy_cover(e, world.round - e.pos_round + turns) >= dist(e.pos, G.centre) - reach;
+}
+
+// Of the enemy bodies, the share that cannot contest group g within `rounds` rounds (may_contest).
+float contest_absent(const World& world, int g, int rounds, bool recalls) {
+    int n = 0, absent = 0;
+    for (const auto& e : world.enemies) {
+        ++n;
+        if (!may_contest(world, e, g, rounds, recalls)) ++absent;
+    }
+    return n > 0 ? static_cast<float>(absent) / static_cast<float>(n) : 1.0f;
+}
