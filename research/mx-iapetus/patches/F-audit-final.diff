+// The field a retreat walks home by. A dasher's crosses hole and altar lines as its dash does (Pathing::static_walls),
+// so beside such a line, with no step on it that gains, its next gain is the dash: while that cools, the walk round
+// is home sooner once it is no longer than the wait and the dashed route.
+const Field& retreat_home(const World& world, Pathing& pathing) {
+    const auto& dashed = pathing.to_ally_spawn();
+    const int slot = world.me().facts().slot_of(AbilityKind::dash);
+    if (slot < 0) return dashed;
+    const int wait = my_cooldown(slot);
+    if (wait <= 0) return dashed;
+    const vec2 here = my_position();
+    const int by_dash = dashed.at(here);
+    if (by_dash == unreachable || by_dash == 0) return dashed;
+    const auto& foot = world.map().from_ally_spawn();
+    const int by_foot = foot.at(here);
+    if (by_foot == unreachable || by_foot <= by_dash) return dashed;
+    for (const auto d : directions) {
+        const vec2 q = here + d;
+        // A walk that gains on it without losing on the walk round (else, a step round, the next turn would step back).
+        if (in_bounds(q) && foot.at(q) != unreachable && foot.at(q) <= by_foot && dashed.at(q) < by_dash) return dashed;
+    }
+    return by_foot <= by_dash + wait ? foot : dashed;
+}
