+// The share of the enemy's bodies (one each, Cassi and Issac two) that can be at group g by round
+// `end`: all but those dead whose earliest respawn (rules death.respawn) plus the walk from their
+// spawn, on which no step is taken, is later. home_ground's discount prices the enemy team at home.
+float enemy_presence(const World& world, int g, int end) {
+    if (world.enemies.empty()) return 1;
+    const auto& map = world.map();
+    int steps = -1, absent = 0;
+    for (const auto& e : world.enemies) {
+        if (e.alive || e.respawn_earliest < 0) continue;
+        if (steps < 0) {
+            steps = map.enemy_steps(g);
+            if (steps == unreachable) steps = dist(map.enemy_spawn_centre, map.groups[g].centre);
+        }
+        if (e.respawn_earliest + steps > end) ++absent;
+    }
+    return static_cast<float>(static_cast<int>(world.enemies.size()) - absent) / static_cast<float>(world.enemies.size());
+}
+
+bool enemy_dead(const World& world) {
+    for (const auto& e : world.enemies)
+        if (!e.alive && e.respawn_earliest >= 0) return true;
+    return false;
+}
+
+// home_ground's weight with its power scaled by the enemy's presence: weight^presence.
+float home_present(float weight, float presence) {
+    return presence >= 1 ? weight : presence <= 0 ? 1.0f : std::pow(weight, presence);
+}
+
+// home_weights() for this turn: the weights read so far at the presence of a work there ending as
+// soon as our walk and a capture could (no clear), so at least farm's, which add the clear.
+void refresh_home_weights(const World& world, vec2 here, int capture) {
+    static bool scaled = false;
+    const bool dead = enemy_dead_flag = enemy_dead(world);
+    if (!dead && !scaled) return;
+    scaled = dead;
+    const auto& map = world.map();
+    auto& cache = home_cache();
+    const int n = std::min(static_cast<int>(map.groups.size()), static_cast<int>(cache.size()));
+    for (int g = 0; g < n; ++g) {
+        const float weight = cache[static_cast<std::size_t>(g)].weight;
+        if (weight < 0) continue;
+        home_weights()[static_cast<std::size_t>(g)]
+            = dead ? home_present(weight, enemy_presence(world, g, world.round + dist(here, map.groups[g].centre) + capture)) : weight;
+    }
+}
