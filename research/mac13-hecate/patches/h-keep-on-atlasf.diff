+// A retreat keeps our claim: most are a turn or two inside a trip, and a withdrawn claim has allies re-plan
+// around it (crews, claimed groups, a capture left for Prism). The farm takes it up again or replaces it.
+// A siege the retreat ends, a heal trip (under the recall line, drawn_home's; from camp fire, camp_fled) and a
+// bag to bank still take us away.
+void retreat_claim(const World& world, Safety& safety, Memory& memory) {
+    const float health = my_health();
+    const bool healing = memory.camp_fled >= 0
+                         || (health < params::recall_health_fraction * my_max_health() && health < recall_line(world, safety) * my_max_health());
+    if (memory.siege || healing) drop_carry_claim(memory), memory.claim = -1;
+    else if (memory.banking) drop_carry_claim(memory);
+}
