+float Safety::second_turn(const ChampionBelief& e, vec2 p, const Blow& b, float blow_scale) {
+    auto& x = struck(e);
+    // A teleport's channel turns are not its own: threat_strike times it from the landing.
+    if (e.teleport_pending() || turns_before_ours(world_, e, x.turns) < 2 || !b.first) return 0;
