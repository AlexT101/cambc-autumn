+// e cannot both fight us and keep its work: a visible tribute or kept recall (damage or a stun ends
+// the recall, a stun the tribute), or a monster that would hit it in the next camp phase: a striking
+// member of an awake group, read alive this round, with e within its range, no other visible
+// champion nearer it and none of ours as near (a tie may go to ours: rules camps.attack).
+bool busy(const World& world, const ChampionBelief& e) {
+    if (!e.visible) return false;
+    if (e.channel == Channel::tribute || recall_kept(e)) return true;
+    const auto& map = world.map();
+    for (const int g : map.groups_near(e.pos, map.max_camp_reach)) {
+        const auto& group = map.groups[g];
+        const auto& c = world.camps[g];
+        if (group.strength <= 0 || c.state != CampState::alive || c.awake != Awake::awake) continue;
+        for (std::size_t i = 0; i < group.members.size(); ++i) {
+            const auto& m = group.members[i];
+            const int d = dist(m.pos, e.pos);
+            if (m.strength <= 0 || !(c.health[i] > 0) || c.health_round[i] != world.round || d > m.reach || (i < 64 && (c.asleep >> i & 1)))
+                continue;
+            bool nearest = true;
+            for (const auto& a : world.allies) {
+                const vec2 at = a.is_self ? my_position() : a.pos;
+                if (a.alive && in_bounds(at) && dist(m.pos, at) <= d) nearest = false;
+            }
+            for (const auto& o : world.enemies)
+                if (&o != &e && o.alive && o.visible && dist(m.pos, o.pos) < d) nearest = false;
+            if (nearest) return true;
+        }
+    }
+    return false;
+}
