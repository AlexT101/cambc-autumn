+int Plan::stay_hits(Pathing& pathing, vec2 p) const {
+    if (!active_ || chase_ || !field_) return many;
+    if (std::max(std::abs(p.x - origin_.x - radius), std::abs(p.y - origin_.y - radius)) > 1) return many;
+    const int steps = pathing.to_ally_spawn().at(p);
+    if (steps == 0) return 0;
+    if (steps == unreachable) return many;
+    const int near = std::max(0, steps - (horizon - 1));
+    Rows goal, unused;
+    goal_rows<false, false>(field_, walk_, origin_, near, near, goal, unused);
+    Pass out;
+    if (dash_) run_pass<true>(goal, walk_, path_, hit_, dash_turn_, out, true);
+    else run_pass<false>(goal, walk_, path_, hit_, dash_turn_, out, true);
+    const int d = dash_ ? 1 : 0;
+    return value(out.after[0][d], out.after[1][d], p);
+}
