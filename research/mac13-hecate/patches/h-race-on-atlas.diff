+// The pursuit race: walkers move at equal speed, so a walk home cannot widen the gap it starts with, and the
+// trigger above looks only at this turn. Leave while the escape plan still finds a clean way home from here
+// (a walk this turn, then a step a turn) that one more turn on this tile would lose: a pursuer we stand for
+// closes a step we never win back. Only for a body whose death costs more than the work (stand_lost_at's `falls`
+// bar its tile's lethal read: Prism, a linked pair, a bag worth a life), and not on deliberate holds: a capture held,
+// contested or paying before any reach (keeps_us), a winning bag (finish_heal), a siege or Monolith crew, an altar
+// guard, a camp we finish, a disarmed enemy we press, Willow (it holds no fight: its own exposure rule). Once a turn
+// and vision; retreat reuses the plan.
+RaceState race_state;
+bool race_lost(const World& world, Pathing& pathing, Safety& safety, const Memory& memory) {
+    auto& st = race_state;
+    const vec2 here = my_position();
+    if (st.round == world.round && st.at == here && st.observations == world.observations) return st.fired;
+    st.round = world.round, st.at = here, st.observations = world.observations, st.fired = st.armed = false;
+    const auto& f = world.me().facts();
+    if constexpr (params::race::prism_only)
+        if (f.passive != Passive::gem_focus) return false;
+    if (f.heals()) return false;
+    if (!in_bounds(here) || test(world.map().ally_spawn, here) || fuel() < params::escape::min_fuel) return false;
+    if (memory.siege || (memory.claim >= 0 && memory.claim == memory.mono_group)) return false;
+    if (partner(world) == nullptr && f.passive != Passive::gem_focus
+        && params::gem_value * static_cast<float>(bag_at_stake(world)) < params::life_value)
+        return false;
+    bool seen = false;
+    for (const auto& e : world.enemies) seen |= e.alive && e.visible;
+    if (!seen || !safety.may_reach_within(here, escape::horizon)) return false;
+    if (winning_bag(world) || contesting(world) || holding_capture(world, pathing) || altar_guarding(world) || finishing_camp(world))
+        return false;
+    if (HoldAt hold(world, pathing, here, memory.damage); hold.keeps_us(safety)) return false;
+    if (press_taken(world, pathing, safety)) return false;
+    const auto& plan = escape::plan(world, pathing, safety);
+    if (!plan.active()) return false;
+    const auto& blocked = pathing.blocked();
+    bool clean = false;
+    for (const auto d : directions) {
+        const vec2 q = here + d;
+        if (in_bounds(q) && !test(blocked, q) && plan.after_walk(q, false) == 0 && !safety.touched(q, world.me().taken)) {
+            clean = true;
+            break;
+        }
+    }
+    // Armed: the work guard keeps the steps beside us whose race is lost (keep_out).
+    st.armed = clean;
+    if (!clean || plan.stay_hits(pathing, here) == 0) return false;
+    st.fired = true;
+    debug_block({ std::printf("RACE %d %u %c %d %d %d\n", world.round, my_handle(), static_cast<char>(last_decision), here.x, here.y,
+                              pathing.to_ally_spawn().at(here)); });
+    return true;
+}
+
+bool race_fired(const World& world) { return race_state.round == world.round && race_state.fired; }
+
+// The steps beside us, bit i for directions[i], whose race this turn's armed plan finds lost: walked onto now, the way
+// home from them is hit, where a clean one is left from here. Without them a pursuer that waits draws us back onto the
+// tile we just left.
+unsigned race_keep_out(const World& world, Pathing& pathing, vec2 here) {
+    const auto& st = race_state;
+    if (st.round != world.round || st.at != here || st.observations != world.observations || !st.armed || st.fired) return 0;
+    const auto* plan = escape::built(world);
+    if (!plan || plan->at != here) return 0;
+    const auto& home = pathing.to_ally_spawn();
+    const int steps = home.at(here);
+    unsigned out = 0;
+    for (int i = 0; i < 8; ++i) {
+        const vec2 q = here + directions[i];
+        // A homeward step is the race's own way out.
+        if (!in_bounds(q) || test(world.map().ally_spawn, q) || home.at(q) < steps) continue;
+        if (plan->stay_hits(pathing, q) > 0) out |= 1u << i;
+    }
+    return out;
+}
