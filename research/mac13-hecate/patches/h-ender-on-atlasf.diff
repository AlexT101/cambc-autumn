+// Our Prism standing where Safety reads lethal leaves a tributing ender to an ally that stops it alone
+// before the channel lands (ally_stops): the Prism holds the bag, and the team whose Prism dies first
+// loses most games. The ally is no Prism, so it never spares the stop in turn; vision is personal, so
+// it must see the ender itself, and its game_ender must choose it: no other enemy may end the game by
+// its bag or pair (one we do not see may be in the ally's sight), and no ally's bag may win.
+bool prism_spares_stop(const World& world, Safety& safety, const ChampionBelief& e) {
+    if (e.channel != Channel::tribute || !support_protected(world, world.me())) return false;
+    const int need = static_cast<int>(cambc::constants::winning_gems) - world.score.enemy;
+    for (const auto& o : world.enemies)
+        if (&o != &e && o.alive && pair_gems(world, o) >= need) return false;
+    const int ours = static_cast<int>(cambc::constants::winning_gems) - world.score.ally;
+    for (const auto& a : world.allies)
+        if (a.alive && a.gems >= ours) return false;
+    const bool ally = ally_stops(world, e, true);
+    debug_block({
+        if (!ally && safety.lethal(my_position())) std::printf("ENDER-ALONE %d %u\n", world.round, static_cast<unsigned>(world.me().handle));
+    });
+    if (!ally || !safety.lethal(my_position())) return false;
+    int enders = 0;
+    if (game_ender(world, &enders) != &e || enders != 1) return false;
+    debug_block({ std::printf("ENDER-SPARE %d %u\n", world.round, static_cast<unsigned>(world.me().handle)); });
+    return true;
+}
