+// Debug builds only: farm's pick as it is (0) and without each stale belief part (1 unseen_cycle,
+// 2 wait_priced, 3 enemy_race), to count the turns each part changed it.
+struct StaleShadow {
+    std::array<int, 4> best, shared;
+    std::array<float, 4> best_value, shared_value;
+    int turns = 0, unseen = 0, raced = 0, waited = 0, changed[4] = {}, last_print = -1;
+    void reset() { best.fill(-1), shared.fill(-1), best_value.fill(0), shared_value.fill(0); }
+    // `time`: the rounds `value` was rated over; `less1`, `less3`: the rounds without part 1 or 3;
+    // `over_wait`: a wait past max_wait, which part 2 lets in.
+    void note(const World& world, bool share, int g, float value, float time, float less1, float less3, bool over_wait) {
+        const float base = rate(world, 1.0f, time);
+        for (int p = 0; p < 4; ++p) {
+            float v = value;
+            if (p == 1 && less1 > 0) v *= rate(world, 1.0f, time - less1) / base;
+            if (p == 3 && less3 > 0) v *= rate(world, 1.0f, time - less3) / base;
+            if (p == 2 && over_wait) continue;
+            auto& at = share ? shared : best;
+            auto& at_value = share ? shared_value : best_value;
+            if (at[static_cast<std::size_t>(p)] < 0 || v > at_value[static_cast<std::size_t>(p)])
+                at[static_cast<std::size_t>(p)] = g, at_value[static_cast<std::size_t>(p)] = v;
+        }
+    }
+    int top(int p) const {
+        const auto i = static_cast<std::size_t>(p);
+        return shared[i] >= 0 && (best[i] < 0 || shared_value[i] > best_value[i]) ? shared[i] : best[i];
+    }
+};
+StaleShadow stale_shadow;
