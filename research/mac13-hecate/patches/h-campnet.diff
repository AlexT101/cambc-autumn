+void World::note_cleared(int group, int seen_round) {
+    if (group < 0 || group >= static_cast<int>(camps.size()) || seen_round > round) return;
+    auto& c = camps[group];
+    c.told_cleared = static_cast<std::int16_t>(std::max<int>(c.told_cleared, seen_round));
+    if (c.state_round == round) return; // in view: our own reading stands
+    if (static_cast<std::size_t>(group) < 64 * camps_pending_.size()) camps_pending_[group >> 6] |= std::uint64_t{1} << (group & 63);
+    const auto version = c.version;
+    note_reported_clear(c, map().groups[group], seen_round, camp_geometry_version);
+    if (c.version != version) camp_moved(static_cast<std::size_t>(group));
+    note_stirring(group);
+}
+
+void World::note_enemy_hold(int group, int payout_round) {
+    if (group < 0 || group >= static_cast<int>(camps.size()) || payout_round <= round) return;
+    auto& c = camps[group];
+    c.told_hold = static_cast<std::int16_t>(payout_round);
+    if (c.state_round == round) return; // in view: our own reading stands
+    if (static_cast<std::size_t>(group) < 64 * camps_pending_.size()) camps_pending_[group >> 6] |= std::uint64_t{1} << (group & 63);
+    if (c.state == CampState::cleared && c.holder == team::enemy && c.held_since == payout_round - cambc::constants::capture_time - 1) return;
+    const auto version = c.version;
+    // Seen this round or last, held from no later than that.
+    note_reported_clear(c, map().groups[group], round - 1, camp_geometry_version);
+    c.holder = team::enemy;
+    c.held_since = payout_round - cambc::constants::capture_time - 1;
+    if (c.version != version) camp_moved(static_cast<std::size_t>(group));
+    note_stirring(group);
+}
