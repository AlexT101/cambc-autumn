+namespace {
+// A teammate's report of group g cleared, no earlier than `seen_round`, merged into a belief not read
+// this turn: every member dead, nobody's capture under way.
+bool note_reported_clear(CampBelief& c, const CampGroup& G, int seen_round, std::uint32_t& camp_geometry_version) {
+    bool died = c.state == CampState::alive;
+    for (std::size_t i = 0; i < G.members.size(); ++i) {
+        died |= c.health[i] > 0;
+        if (c.health[i] != 0) ++c.version;
+        c.health[i] = 0, c.health_round[i] = std::max(c.health_round[i], seen_round);
+    }
+    if (died) ++camp_geometry_version, ++c.geometry_version;
+    const bool moved = c.state != CampState::cleared || c.holder;
+    c.version += moved;
+    c.state = CampState::cleared;
+    c.awake = Awake::asleep;
+    c.asleep = 0;
+    c.holder.reset();
+    c.held_since = -1;
+    c.occupants = 0;
+    c.reported = static_cast<std::int16_t>(seen_round);
+    return moved || died;
+}
