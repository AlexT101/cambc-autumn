+// Debug counters (debug_block): contests started, enemy holds we reset by stepping on, captures we then took, and
+// our deaths within 5 rounds of a contest step.
+struct ContestWatch {
+    int last_round = -100, last_group = -1; // our last contest step
+    int reset_group = -1;                   // a group whose enemy hold or stand we reset, while we stay on it
+    bool alive = false;
+};
+ContestWatch contest_watch;
+
+void note_contest(const World& world, int claim, bool denied) {
+    debug_block({
+        auto& w = contest_watch;
+        const int g = world.map().group_at(my_position());
+        if (w.last_round != world.round - 1 || w.last_group != claim)
+            std::printf("CONTEST-START %d %u %d %d\n", world.round, my_handle(), claim, denied ? 1 : 0);
+        w.last_round = world.round;
+        w.last_group = claim;
+        // The beliefs are still those from before our step.
+        if (g >= 0 && g == claim && w.reset_group != g
+            && (world.camps[g].holder == team::enemy || enemy_on(world, world.map().groups[g].tiles()))) {
+            const auto& G = world.map().groups[g];
+            std::printf("CONTEST-RESET %d %u %d %d %d %d\n", world.round, my_handle(), g, G.gems, G.gold, denied ? 1 : 0);
+            w.reset_group = g;
+        }
+    });
+}
+
+void watch_contests(const World& world, const Memory& memory) {
+    debug_block({
+        auto& w = contest_watch;
+        const bool alive = world.me().alive;
+        if (w.alive && !alive && memory.round == world.round - 1 && world.round - w.last_round <= 5)
+            std::printf("CONTEST-DEATH %d %u %d\n", world.round, my_handle(), world.round - w.last_round);
+        w.alive = alive;
+        if (w.reset_group < 0) return;
+        const int g = w.reset_group;
+        if (!alive || world.map().group_at(world.me().pos) != g) {
+            w.reset_group = -1;
+            return;
+        }
+        // A contest still standing counts as a contest round for the death window.
+        if (world.camps[g].state == CampState::cleared && enemy_on(world, world.map().groups[g].tiles())) w.last_round = world.round;
+        if (world.camps[g].state != CampState::cleared) {
+            const auto& G = world.map().groups[g];
+            std::printf("CONTEST-TOOK %d %u %d %d %d\n", world.round, my_handle(), g, G.gems, G.gold);
+            w.reset_group = -1;
+        }
+    });
+}
