+// deny_capture before a small bag's walk home, a shopping trip and the altar guard (and so before the chase, which
+// follows them): with a walk left, not a bag at an altar or closing, not Prism
+// keeping a bag a kill would make worth chasing (brake_bag), not Cassi or Issac out of the other's fight (the
+// fight model counts allies within fight_ally_radius), and a bag we bank only if it is too small to chase.
+bool denies_first(const World& world, Pathing& pathing) {
+    if (!my_can_move()) return false;
+    // A bag at an altar, or on its last trip to score, is banked first.
+    if (my_gems() > 0 && (can_tribute_here(world) || closing(world, pathing))) return false;
+    if (keeps_gems(world, pathing) && static_cast<int>(my_gems()) >= params::brake_bag) return false;
+    if (const auto* p = partner(world); p && p->alive && (!p->visible || dist(my_position(), p->pos) > safety_params::fight_ally_radius))
+        return false;
+    return !banks_bag(world, pathing) || bag_at_stake(world) < params::brake_bag;
+}
+
+// A cleared group paying gems or gold (as farm prices it) that the enemy holds or stands on, a free tile of which
+// we reach before the hold pays (enemy_hold_left), most valuable first: one body of ours there resets their count,
+// and staying takes the capture. Only onto tiles where want_home would keep us (stand_refused_at): a holder there
+// that our fight model says cannot punish the stand. The steps keep the work guard.
+bool deny_capture(const World& world, Pathing& pathing, Safety& safety, Memory& memory) {
+    if (winning_bag(world)) return false;
+    const auto& map = world.map();
+    const vec2 here = my_position();
+    struct Option {
+        float value;
+        int g, steps, left;
+    };
+    std::array<Option, 8> options;
+    int n = 0;
+    world.each_cleared([&](int g) {
+        const auto& G = map.groups[g];
+        const auto& c = world.camps[g];
+        if (!enemy_on(world, G.tiles()) && c.holder != team::enemy) return;
+        const float value = capture_value(world, G);
+        if (value <= 0) return;
+        if (!enemy_hold_pays(world, c)) return;
+        const int left = enemy_hold_left(world, c);
+        // A walk is at least the Chebyshev distance: most groups are settled without a field.
+        if (left <= 0 || !any_within(G.tiles(), here, left) || contest_manned(world, g, here)) return;
+        const int steps = pathing.to_group(g).at(here);
+        if (steps > left) return;
+        // One body resets the count: an ally claiming it from a shorter walk (ties to the lower index) takes it.
+        for (const auto& a : world.allies)
+            if (!a.is_self && a.alive && a.visible && comms::claim_of(world, a.index) == g) {
+                const int theirs = team_walk_to(world, pathing, g, a.pos);
+                if (theirs < steps || (theirs == steps && a.index < world.me().index)) return;
+            }
+        const auto before = [&](const Option& o) { return o.value < value || (o.value == value && o.steps > steps); };
+        int i;
+        if (n < static_cast<int>(options.size())) i = n++;
+        else if (before(options[n - 1])) i = n - 1;
+        else return;
+        for (; i > 0 && before(options[i - 1]); --i) options[i] = options[i - 1];
+        options[i] = {value, g, steps, left};
+    });
+    static bitboard free{cambc::uninitialized}, goal{cambc::uninitialized};
+    for (int k = 0; k < n; ++k) {
+        const auto& o = options[k];
+        copy_into(free_tiles(map.groups[o.g].tiles()), free);
+        // The stand is judged where the walk ends, each free tile a fight read: nearest first, ring by ring out to
+        // the payout, until one we may stand on is walked towards.
+        bool stepped = false;
+        int tried = 0;
+        for (int d = 1; d <= o.left && !stepped; ++d) {
+            clear_board(goal);
+            for (const vec2 p : Tiles<17 * 17>{within(free, here, d)}) {
+                if (dist(here, p) != d) continue;
+                // decide re-checks its goal floor after a refusal.
+                if (!fuel_ok(safety.fight_cost_estimate() + act_reserve)) {
+                    note_shortcut("deny-stand");
+                    return false;
+                }
+                ++tried;
+                if (!stand_refused_at(world, pathing, safety, p, memory.damage)) set_tile(goal, p);
+            }
+            stepped = !goal.is_empty() && pathing.step_towards(goal, nullptr, o.left);
+        }
+        debug_block({
+            const auto& G = map.groups[o.g];
+            std::printf("DENY-TRY %d %u %d %d %d %d %d %d %d %c\n", world.round, my_handle(), o.g, G.gems, G.gold, o.steps, o.left,
+                        enemy_on(world, G.tiles()) ? 1 : 0, tried, stepped ? 'S' : 'R');
+        });
+        if (!stepped) continue;
+        memory.claim = o.g;
+        memory.crew = false;
+        world.throw_if_stale();
+        return true;
+    }
+    return false;
+}
