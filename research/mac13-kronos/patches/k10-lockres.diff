+// Rules win: the enemy wins once its tributed gems reach winning_gems, so the gems we believe its living
+// champions carry (as game_ender counts them) can end the game in one tribute. One lock cancels that
+// channel (altar_locks.effect) and only one is carried: while this holds it is kept for that channel.
+bool enemy_bags_win(const World& world) {
+    int carried = 0;
+    for (const auto& e : world.enemies) carried += e.alive ? e.gems : 0;
+    return world.score.enemy + carried >= static_cast<int>(cambc::constants::winning_gems);
+}
