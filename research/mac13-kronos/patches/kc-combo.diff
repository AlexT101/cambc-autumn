+// Prism starts no channel longer than tribute_window turns with an enemy champion in its sight within
+// vision_radius, unless the round limit forces it (any_risk's): one so long rarely completes beside an
+// enemy, and the bag it carries meanwhile is the Focus that wins its fights. Not a winning bag, which
+// waits for tribute_safe already: refused too, it stood at a one-altar map's altar for ~1500 rounds
+// with the team escorting it (altar_guard), the guards' turns running out of fuel.
+bool quiet_refuses(const World& world, int turns) {
+    if (world.me().facts().passive != Passive::gem_focus || turns <= params::tribute_window
+        || rounds_left(world) <= turns + endgame_slack || winning_bag(world))
+        return false;
+    const vec2 here = my_position();
+    for (const auto& e : world.enemies)
+        if (e.alive && e.visible && dist(e.pos, here) <= vision_radius) return true;
+    return false;
+}
