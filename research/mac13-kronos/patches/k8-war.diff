diff -ruN bots/variants/chy-ref/src/combat/prism_war.h bots/variants/k8-war/src/combat/prism_war.h
--- bots/variants/chy-ref/src/combat/prism_war.h	1970-01-01 00:00:00.000000000 +0000
+++ bots/variants/k8-war/src/combat/prism_war.h	2026-11-13 05:19:10.816969179 +0000
@@ -0,0 +1,72 @@
+// The Prism war's duel model: how two Prisms' two-turn bursts compare (rules: prism, abilities.stun,
+// combat.modifiers), both slots taken as ready. The stun (1.5 x Focus) removes the victim's next
+// turn and the ground spell (1.0 x Focus) follows on the caster's next. When only one side's burst
+// covers the other's health, that side wins the exchange whoever starts: even with the victim's turn
+// in between (team order flips each round), the victim's own burst does not kill it.
+#pragma once
+#include "../model/world.h"
+
+namespace aph {
+
+inline bool is_prism(const ChampionBelief& c) { return c.facts().passive == Passive::gem_focus; }
+
+// The two-turn burst of a's damage spells as it lands on v: a's Focus (a Prism's carries its bag's
+// +1.5 a gem), its damage modifiers (Skirmish, Collectors: `scale`) and v's Durability (`taken`).
+// An enemy's Focus is its last reading, less a bag believed tributed or lost (drop_bag): the world
+// keeps no belief of gems gained out of sight, so none is added.
+inline float prism_burst(const ChampionBelief& a, const ChampionBelief& v) {
+    float multiplier = 0;
+    for (const auto& s : a.facts().abilities)
+        if (s.kind == AbilityKind::damage) multiplier += s.multiplier;
+    return multiplier * a.focus * a.damage_scale() * v.taken;
+}
+
+// a's burst takes all of v's health and shield.
+inline bool prism_covers(const ChampionBelief& a, const ChampionBelief& v) { return prism_burst(a, v) >= v.health + v.shield; }
+
+// The living enemy Prism, or null: a team cannot repeat a pick, so there is at most one.
+inline const ChampionBelief* enemy_prism(const World& world) {
+    for (const auto& e : world.enemies)
+        if (e.alive && is_prism(e)) return &e;
+    return nullptr;
+}
+
+// We, a Prism, win the exchange with the enemy Prism e whoever starts: our burst covers its health
+// and its burst does not cover ours.
+inline bool prism_dominant_over(const World& world, const ChampionBelief& e) {
+    const auto& me = world.me();
+    return is_prism(me) && is_prism(e) && me.alive && e.alive && prism_covers(me, e) && !prism_covers(e, me);
+}
+
+// The reverse: its burst covers ours and ours does not cover its.
+inline bool prism_outmatched_by(const World& world, const ChampionBelief& e) {
+    const auto& me = world.me();
+    return is_prism(me) && is_prism(e) && me.alive && e.alive && prism_covers(e, me) && !prism_covers(me, e);
+}
+
+// Where an enemy Prism that outmatches ours may strike: while it was seen within capture_time rounds
+// (a capture's hold), the tiles within its spells' reach from its sighting (the ground spell's 5:
+// range 4 and its 3x3; a spell excludes walking) and a step a round since.
+struct PrismThreat {
+    vec2 at{-1, -1};
+    int radius = -1;
+    bool on() const { return radius >= 0; }
+    // A camp tile of G lies within the radius.
+    bool reaches(const CampGroup& G) const {
+        if (!on()) return false;
+        for (const auto& m : G.members)
+            if (dist(at, m.pos) <= radius) return true;
+        return false;
+    }
+};
+inline PrismThreat prism_threat(const World& world) {
+    PrismThreat t;
+    const auto* e = enemy_prism(world);
+    if (!e || !in_bounds(e->pos) || (e->pos_source != Source::seen && e->pos_source != Source::comms)) return t;
+    const int age = world.round - e->pos_round;
+    if (age < 0 || age > cambc::constants::capture_time || !prism_outmatched_by(world, *e)) return t;
+    t.at = e->pos, t.radius = e->facts().cast_reach() + age;
+    return t;
+}
+
+} // namespace aph
