+// The claim race: a solo group's claim belongs to the teammate that reaches it first. Each side
+// runs the same test on the same tiles, so a claim one takes is a claim the other gives up, with
+// no comms. Solo: one claimer's live or respawning group, strikers included, or a harmless one
+// cleared; no Monolith, kite or siege. A striker group cleared is a crew's capture: its members
+// post their claims until their next turn. Two claimers or more are a crew operation (comms carry
+// no crew bit), as is a crew we proposed.
+bool solo_job(const World& world, int g) {
+    const auto& map = world.map();
+    const auto& G = map.groups[g];
+    if (G.has_monolith || G.gems + G.gold == 0 || (map.shared_gems && big_group(G)) || g == siege_group()) return false;
+    return G.strength <= 0 || world.camps[g].state != CampState::cleared;
+}
+
+// Allies other than us claiming g.
+int other_claimers(const World& world, int g) {
+    int n = 0;
+    for (const auto& a : world.allies) n += !a.is_self && comms::claim_of(world, a.index) == g;
+    return n;
+}
+
+// A champion in the race, at its known tile: ours, an ally's in sight, or one it told or we saw
+// within `slack` steps.
+struct Racer {
+    vec2 at{-1, -1};
+    int range = 0, reach = 0, slack = 0, index = -1;
+    bool prism = false, busy = false, dash = false; // busy: channelling, so its tile is no walk
+};
+
+bool self_racer(const World& world, Racer& r) {
+    r.at = my_position();
+    if (r.at.x < 0) return false;
+    const auto& f = world.me().facts();
+    r.range = f.attack_range(), r.reach = std::max(r.range, f.cast_reach()), r.slack = 0, r.index = world.me().index;
+    r.prism = f.passive == Passive::gem_focus, r.busy = channelling(), r.dash = f.has_dash();
+    return true;
+}
+
+bool ally_racer(const World& world, const ChampionBelief& a, Racer& r) {
+    if (a.is_self || !a.alive || !recent_tile(world, a, r.at, r.slack)) return false;
+    const auto& f = a.facts();
+    r.range = f.attack_range(), r.reach = std::max(r.range, f.cast_reach()), r.index = a.index;
+    r.prism = f.passive == Passive::gem_focus, r.busy = a.channel != Channel::none, r.dash = f.has_dash();
+    return true;
+}
+
+// Rounds until r can work g: its steps into attack range, onto the tiles once cleared. Chebyshev
+// steps, the one measure both sides read alike: walking fields are cached per instance, and one
+// side reading a field where the other reads none could have each find the other sooner.
+int race_arrival(const World& world, int g, const Racer& r) {
+    const int steps = steps_to(world.map().groups[g], r.at);
+    return world.camps[g].state == CampState::cleared ? steps : std::max(0, steps - r.range);
+}
+
+// r works g already: in reach (+1, a round of turn order) of a live member by a basic attack or a
+// spell, or in a striker's, taking its fire; or on its tiles.
+bool race_begun(const World& world, int g, const Racer& r) {
+    const auto& G = world.map().groups[g];
+    const auto& c = world.camps[g];
+    if (test(G.tiles(), r.at)) return true;
+    const int reach = (c.state == CampState::cleared ? 0 : r.reach) + 1 + r.slack;
+    for (std::size_t i = 0; i < G.members.size(); ++i) {
+        const auto& m = G.members[i];
+        if ((c.state != CampState::alive || c.health[i] > 0) && dist(r.at, m.pos) <= std::max(reach, m.strength > 0 ? m.reach + 1 + r.slack : 0)) return true;
+    }
+    return false;
+}
+
+// Whether solo group g's claim passes from `from` to `to`: `to` is sooner by more than what either
+// may move between the two readings (a step of turn order, a dash's 2 more) and the tiles' slack.
+// Clear wins only: a tie rule would flip at the margin's edge, where the two readings differ by
+// that move, and could have both give the group up. Never from a Prism's gem group (the funnel),
+// from a step of `from`'s opening plan, from one it has begun, or while either channels.
+bool claim_passes(const World& world, int g, const Racer& to, const Racer& from) {
+    const auto& G = world.map().groups[g];
+    if (to.busy || from.busy || (from.prism && G.gems > 0) || race_begun(world, g, from)) return false;
+    if (params::open_plan::on && world.round <= params::open_plan::horizon)
+        for (int k = 0; k < params::open_plan::steps; ++k)
+            if (world.map().opening_group(from.index, k) == g) return false;
+    constexpr int dash_steps = 2;
+    const int margin = 1 + to.slack + from.slack + dash_steps * (to.dash + from.dash);
+    return race_arrival(world, g, to) + margin < race_arrival(world, g, from);
+}
