+// The map's altar sites (altars linked by steps of at most site_link) that both teams can reach, each held at
+// its altar nearest the enemy spawn by walk (ties by ours), nearest the enemy first: their carriers bank at their
+// nearest. site_of[altar] is its site's place in that order, -1 for an unheld site.
+struct Sites {
+    std::vector<int> anchor;
+    std::vector<int> site_of;
+};
+// Some stand tile by the altar (stands() is empty exactly when none is): without its camp-reach test.
+bool has_stand(const World& world, int a) {
+    const auto& map = world.map();
+    const vec2 alt = map.altars[static_cast<std::size_t>(a)].pos;
+    const int r = params::altar_stand_radius;
+    for (int dx = -r; dx <= r; ++dx)
+        for (int dy = -r; dy <= r; ++dy)
+            if (const vec2 p{alt.x + dx, alt.y + dy}; in_bounds(p) && test(map.standable, p) && !test(map.near_enemy_spawn, p)
