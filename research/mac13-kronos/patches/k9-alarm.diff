+const Sites& sites(const World& world) {
+    static Sites s;
+    static bool built = false;
+    if (built) return s;
+    built = true;
+    const auto& map = world.map();
+    const int n = static_cast<int>(map.altars.size());
+    s.site_of.assign(static_cast<std::size_t>(n), -1);
+    std::vector<int> comp(static_cast<std::size_t>(n), -1);
+    struct Site {
+        int theirs, ours, anchor, comp;
+    };
+    std::vector<Site> found;
+    const auto& field = map.from_ally_spawn();
+    for (int root = 0, c = 0; root < n; ++root) {
+        if (comp[static_cast<std::size_t>(root)] >= 0) continue;
+        std::vector<int> linked{root};
+        comp[static_cast<std::size_t>(root)] = c;
+        for (std::size_t i = 0; i < linked.size(); ++i)
+            for (int b = 0; b < n; ++b)
+                if (comp[static_cast<std::size_t>(b)] < 0 && dist(map.altars[static_cast<std::size_t>(linked[i])].pos, map.altars[static_cast<std::size_t>(b)].pos) <= site_link)
+                    comp[static_cast<std::size_t>(b)] = c, linked.push_back(b);
+        Site best{unreachable, unreachable, -1, c};
+        for (const int a : linked) {
+            const vec2 p = map.altars[static_cast<std::size_t>(a)].pos;
+            int ours = unreachable, theirs = unreachable;
+            for (int dx = -1; dx <= 1; ++dx)
+                for (int dy = -1; dy <= 1; ++dy)
+                    if (const vec2 t{p.x + dx, p.y + dy}; (dx || dy) && in_bounds(t))
+                        ours = std::min(ours, field.at(t)), theirs = std::min(theirs, map.enemy_spawn_steps(t));
+            // Held only at an altar both sides can tribute at, with a stand tile we reach.
+            if (theirs == unreachable || ours == unreachable || !has_stand(world, a)) continue;
+            if (best.anchor < 0 || theirs < best.theirs || (theirs == best.theirs && ours < best.ours)) best = {theirs, ours, a, c};
+        }
+        if (best.anchor >= 0) found.push_back(best);
+        ++c;
+    }
+    std::sort(found.begin(), found.end(), [](const Site& x, const Site& y) {
+        return x.theirs != y.theirs ? x.theirs < y.theirs : (x.ours != y.ours ? x.ours < y.ours : x.anchor < y.anchor);
+    });
+    for (std::size_t k = 0; k < found.size(); ++k) {
