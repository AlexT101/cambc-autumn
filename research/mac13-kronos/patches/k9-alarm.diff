+// The enemy can end the game by tributing what we believe its living bodies carry (bags as last seen; a
+// linked pair's both). Beliefs are per body, so a guard's trigger is held for capture_time rounds after it
+// last held: a score read between a tribute and its bag's drop, or a bag read anew, does not flicker it.
+//   A rise in their score that update_scores cannot pin on one bag leaves the tributer's believed bag up: an
+// unseen bag no larger than the rise may be the one tributed, so it counts again only once seen.
+bool watching(const World& world) {
+    static int last = -1, score = 0;
+    static std::array<int, 8> doubt{-1, -1, -1, -1, -1, -1, -1, -1};
+    const std::size_t n = std::min(world.enemies.size(), doubt.size());
+    if (const int rise = world.score.enemy - score; rise > 0)
+        for (std::size_t i = 0; i < n; ++i)
+            if (const auto& e = world.enemies[i]; e.alive && !e.visible && e.gems > 0 && e.gems <= rise) doubt[i] = world.round;
+    score = world.score.enemy;
+    int carried = 0;
+    for (std::size_t i = 0; i < n; ++i)
+        if (const auto& e = world.enemies[i]; e.alive && !(doubt[i] >= 0 && e.stats_round < doubt[i])) carried += e.gems;
+    if (world.score.enemy + carried >= static_cast<int>(cambc::constants::winning_gems)) last = world.round;
+    const bool on = last >= 0 && world.round - last <= cambc::constants::capture_time;
+    debug_block({
+        static bool was = false;
+        if (on != was) std::printf("WATCH %d %u %s\n", world.round, static_cast<unsigned>(world.me().handle), on ? "on" : "off"), was = on;
+    });
+    return on;
+}
