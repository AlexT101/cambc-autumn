+// How lethal standing on enemy ground is this turn, L in [0, 1], set once a turn by note_lethality
+// (1 until then): the share of the farm's home discount and middle-band price that applies.
+float ground_lethality();
+void note_lethality(const World& world);
+// A home weight w (at most 1) at lethality L, given waive = 1 - L: 1 - L (1 - w), written so that
+// L = 1 gives w exactly and L = 0 gives 1, and never above 1 (the prunes' bounds take it so).
+inline float lethal_weight(float w, float waive) { return w + (1.0f - w) * waive; }
+// A middle-band price m (at least 1) at lethality L: 1 + L (m - 1), m exactly at L = 1, never above m.
+inline float lethal_exposure(float m, float lethality) { return 1.0f + (m - 1.0f) * lethality; }
