+namespace {
+float lethality_now = 1.0f;
+}
+float ground_lethality() { return lethality_now; }
+
+// A control for the lethality reading (k2-leth): the discount on enemy ground by game phase alone,
+// none up to round 100, rising linearly to the full discount at round 300.
+void note_lethality(const World& world) {
+    constexpr float from = 100, to = 300;
+    lethality_now = std::clamp((static_cast<float>(world.round) - from) / (to - from), 0.0f, 1.0f);
+    if (world.round % 50 == 0) debug_block({ std::printf("LETH %d %u %.3f\n", world.round, my_handle(), lethality_now); });
+}
