+// s1 trace (debug only): the chosen value's numerator and rounds, and the top evaluated groups.
+struct FcParts {
+    float worth = -1, rounds = -1, trip = -1, clear = -1, cap = -1, home = -1, wx = -1, part = -1, carry = -1, bk = 0, wait = 0;
+    bool via = false;
+};
+struct FcTrace {
+    FcParts best, shared;
+    int top_g[3] = {-1, -1, -1};
+    float top_v[3] = {0, 0, 0};
+    float part = 1, clear = 0; // the kited branch's partner terms
+    void seen(int g, float v) {
+        for (int i = 0; i < 3; ++i)
+            if (top_g[i] == g) {
+                if (v <= top_v[i]) return;
+                for (int j = i; j < 2; ++j) top_g[j] = top_g[j + 1], top_v[j] = top_v[j + 1];
+                top_g[2] = -1, top_v[2] = 0;
+                break;
+            }
+        for (int i = 0; i < 3; ++i)
+            if (top_g[i] < 0 || v > top_v[i]) {
+                for (int j = 2; j > i; --j) top_g[j] = top_g[j - 1], top_v[j] = top_v[j - 1];
+                top_g[i] = g, top_v[i] = v;
+                return;
+            }
+    }
+};
