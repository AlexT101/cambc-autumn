 // The map's features, measured once (the first draft turn's fuel covers them), and the pick count.
+int engine_travel(const mapfeat::Input& in, const std::vector<int>& base, int level, std::vector<int>* out, int* work) {
+    constexpr int buckets = 9;
+    bitboard blocked = cambc::map::walls() | cambc::map::holes() | cambc::map::altars();
+    bitboard enemy, roots;
+    for (int y = in.sy; y < in.sy + in.sh; ++y)
+        for (int x = in.sx; x < in.sx + in.sw; ++x) {
+            roots.set({x, y});
+            enemy.set(in.sym == mapfeat::horizontal ? vec2{in.W - 1 - x, y}
+                      : in.sym == mapfeat::vertical ? vec2{x, in.H - 1 - y}
+                                                   : vec2{in.W - 1 - x, in.H - 1 - y});
+        }
+    blocked |= enemy;
+    bitboard open = ~blocked, cross = cambc::map::holes() | cambc::map::altars();
+    bitboard dashers{cambc::uninitialized};
+    square_dilate(cross, 1, dashers);
+    bitboard seeds = dashers;
+    if (level > 1) {
+        square_dilate(blocked, 2, seeds);
+        for (int x = 0; x < in.W; ++x) {
+            seeds.draw_chebyshev( {x, 0}, 1), seeds.draw_chebyshev( {x, in.H - 1}, 1);
+        }
+        for (int y = 0; y < in.H; ++y) {
+            seeds.draw_chebyshev( {0, y}, 1), seeds.draw_chebyshev( {in.W - 1, y}, 1);
+        }
+    }
+    std::vector<int> distance = base;
+    const int top = *std::max_element(base.begin(), base.end());
+    std::vector<int> head(static_cast<std::size_t>(top + 1), -1);
+    const auto next = std::make_unique_for_overwrite<int[]>(base.size());
+    for (std::size_t i = 0; i < base.size(); ++i)
+        if (base[i] >= 0) next[i] = head[base[i]], head[base[i]] = static_cast<int>(i);
+    bitboard available = open, fringe{cambc::uninitialized}, layer{cambc::uninitialized},
+        starts{cambc::uninitialized}, middle{cambc::uninitialized}, ends{cambc::uninitialized};
+    std::array<bitboard, buckets> queue;
+    std::vector<vec2> tiles(distance.size());
+    unsigned pending = 0;
+    int gained = 0, popped = 0, heads = 0;
+    for (int v = 0; v <= top || pending; ++v) {
+        const int at = v % buckets;
+        and_into(queue[at], available, fringe);
+        clear_board(queue[at]);
+        pending &= ~(1u << at);
+        clear_board(layer);
+        if (v <= top)
+            for (int i = head[v]; i >= 0; i = next[i]) set_tile(layer, {i % in.W, i / in.W});
+        and_into(layer, seeds, starts);
+        heads += starts.count();
+        starts &= available;
+        drop(available, layer);
+        fringe &= available;
+        const bool improved = !fringe.is_empty();
+        if (improved) {
+            xor_into(available, fringe, available);
+            const auto n = positions_into(fringe, tiles.data(), static_cast<std::uint32_t>(tiles.size()));
+            popped += n;
+            for (std::uint32_t k = 0; k < n; ++k) {
+                const int i = tiles[k].y * in.W + tiles[k].x;
+                distance[i] = v;
+                gained += base[i] - v >= 6;
+            }
+        }
+        const auto push = [&](const bitboard& candidates, int cost) {
+            and_into(candidates, available, ends);
+            if (ends.is_empty()) return;
+            const int to = (v + cost) % buckets;
+            queue[to] |= ends;
+            pending |= 1u << to;
+        };
+        if (improved) {
+            square_dilate(fringe, 1, middle);
+            push(middle, 1);
+        }
+        starts |= fringe;
+        if (starts.is_empty()) continue;
+        square_dilate(starts, 1, middle);
+        middle &= cross;
+        if (!middle.is_empty()) {
+            square_dilate(middle, 1, fringe);
+            push(fringe, 4);
+        }
+        if (level > 1) {
+            square_dilate(starts, 3, middle);
+            push(middle, 8);
+        }
+    }
+    if (work) work[0] = heads, work[1] = popped;
+    if (out) *out = std::move(distance);
+    return gained;
+}
