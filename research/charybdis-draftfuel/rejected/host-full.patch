 // The map's features, measured once (the first draft turn's fuel covers them), and the pick count.
+int engine_travel(const mapfeat::Input& in, const std::vector<int>& base, int level, std::vector<int>* out, int* work) {
+    constexpr int buckets = 9;
+    bitboard blocked = cambc::map::walls() | cambc::map::holes() | cambc::map::altars();
+    bitboard enemy, roots;
+    for (int y = in.sy; y < in.sy + in.sh; ++y)
+        for (int x = in.sx; x < in.sx + in.sw; ++x) {
+            roots.set({x, y});
+            enemy.set(in.sym == mapfeat::horizontal ? vec2{in.W - 1 - x, y}
+                      : in.sym == mapfeat::vertical ? vec2{x, in.H - 1 - y}
+                                                   : vec2{in.W - 1 - x, in.H - 1 - y});
+        }
+    blocked |= enemy;
+    bitboard open = ~blocked, cross = cambc::map::holes() | cambc::map::altars();
+    bitboard available = open, fringe{cambc::uninitialized}, middle{cambc::uninitialized}, ends{cambc::uninitialized};
+    std::array<bitboard, buckets> queue;
+    copy_into(roots, queue[0]);
+    unsigned pending = 1;
+    std::vector<int> distance(static_cast<std::size_t>(in.W * in.H), -1);
+    std::vector<vec2> tiles(distance.size());
+    for (int v = 0; pending; ++v) {
+        const int at = v % buckets;
+        if (!(pending >> at & 1)) continue;
+        pending &= ~(1u << at);
+        and_into(queue[at], available, fringe);
+        clear_board(queue[at]);
+        if (fringe.is_empty()) continue;
+        xor_into(available, fringe, available);
+        const auto n = positions_into(fringe, tiles.data(), static_cast<std::uint32_t>(tiles.size()));
+        for (std::uint32_t i = 0; i < n; ++i) distance[tiles[i].y * in.W + tiles[i].x] = v;
+        const auto push = [&](const bitboard& candidates, int cost) {
+            and_into(candidates, available, ends);
+            if (ends.is_empty()) return;
+            const int to = (v + cost) % buckets;
+            queue[to] |= ends;
+            pending |= 1u << to;
+        };
+        square_dilate(fringe, 1, middle);
+        push(middle, 1);
+        // A dash with a walkable middle is dominated by its two walking steps.
+        middle &= cross;
+        if (!middle.is_empty()) {
+            square_dilate(middle, 1, fringe);
+            push(fringe, 4);
+        }
+        if (level > 1) {
+            // Re-read the settled layer: fringe was scratch for the dash ends.
+            clear_board(fringe);
+            for (std::uint32_t i = 0; i < n; ++i) set_tile(fringe, tiles[i]);
+            square_dilate(fringe, 3, middle);
+            push(middle, 8);
+        }
+    }
+    int gained = 0, popped = 0;
+    for (std::size_t i = 0; i < distance.size(); ++i) {
+        const int d = distance[i], b = base[i];
+        gained += d >= 0 && b - d >= 6;
+        popped += d >= 0 && (b < 0 || d < b);
+    }
+    if (work) {
+        if (level == 1) square_dilate(cross, 1, middle);
+        else {
+            // The original crystal search also seeds the radius-two map border.
+            copy_into(blocked, cross);
+            for (int y = 0; y < in.H; ++y)
+                for (int x = 0; x < in.W; ++x)
+                    if (x < 2 || y < 2 || x >= in.W - 2 || y >= in.H - 2) set_tile(cross, {x, y});
+            square_dilate(blocked, 2, middle);
+            middle |= cross;
+        }
+        const auto n = positions_into(middle, tiles.data(), static_cast<std::uint32_t>(tiles.size()));
+        int heads = 0;
+        for (std::uint32_t i = 0; i < n; ++i) heads += base[tiles[i].y * in.W + tiles[i].x] >= 0;
+        work[0] = heads, work[1] = popped;
+    }
+    if (out) *out = std::move(distance);
+    return gained;
+}
