+        memory.claim = -1;
+        memory.crew = false;
+        heal_ally(world);
+        if (bank) {
+            memory.banking = true;
+            decision = 'B';
+            bank_gems(world, pathing, safety, memory);
+        } else {
+            decision = 'S';
+            step_safely(pathing, pathing.to_ally_spawn(), safety);
+        }
+        return true;
+    }
+    return false;
