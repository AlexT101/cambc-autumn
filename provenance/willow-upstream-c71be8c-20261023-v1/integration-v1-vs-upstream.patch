+    world.throw_if_stale();
+    support_owned = true;
+    if (prism) {
+        support_requested = true;
+        decision = 'r';
+        return true;
+    }
+    memory.claim = -1;
+    memory.crew = false;
+    memory.siege = false;
+    const bool healed = !leave && heal_ally(world);
+    bool productive = healed || healed_before;
+    if (!leave && best == here && support_exposure(world, safety, my_position()).safe()) {
