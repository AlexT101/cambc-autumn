+// No-strike movement serves only qualified occupancy. Ordinary growth keeps its node budget.
+void Search::economic_moves() {
+    if (!economic || !moves || walked_first) return;
+    const auto offer_move = [&](Grid ends, Node s, Act first, Act second, int depth, auto mid) {
+        ends &= economic;
+        if (!ends) return;
+        s.depth = static_cast<std::int8_t>(depth);
+        s.owed = false;
+        stack[0] = first;
+        if (depth == 2) stack[1] = second;
+        std::int16_t leaf = -1;
+        offer(ends, leaf_value(s), s, leaf, mid);
+    };
+    if (can_walk) {
+        Node s = root();
+        s.walk = false;
+        if (!melee) s.attack = false;
+        offer_move(free_n, s, {Op::walk}, {}, 1,
+                   [](int c, std::int8_t& w, std::int8_t&) { w = static_cast<std::int8_t>(c); });
+    }
+    if (!dash_ready) return;
+    Node dashed = root();
+    dashed.cast = dashed.dash = false;
+    dashed.value -= dash_cost;
+    // Damage landings belong to ordinary growth: this path claims no unperformed hit or stun.
+    offer_move(plain_here, dashed, {Op::dash}, {}, 1,
+               [](int c, std::int8_t&, std::int8_t& d) { d = static_cast<std::int8_t>(c); });
+    if (!can_walk) return;
+    Node both = dashed;
+    both.walk = false;
+    if (!melee) both.attack = false;
+    each_bit(free_n, [&](int m) {
+        offer_move(landings(m) & ~land_hits, both, {Op::walk}, {Op::dash}, 2,
+                   [m](int c, std::int8_t& w, std::int8_t& d) { w = static_cast<std::int8_t>(m); d = static_cast<std::int8_t>(c); });
+    });
+    each_bit(plain_here, [&](int m) {
+        offer_move(dilate(gbit(m)) & free_ & ~gbit(m), both, {Op::dash}, {Op::walk}, 2,
+                   [m](int c, std::int8_t& w, std::int8_t& d) { d = static_cast<std::int8_t>(m); w = static_cast<std::int8_t>(c); });
+    });
+}
