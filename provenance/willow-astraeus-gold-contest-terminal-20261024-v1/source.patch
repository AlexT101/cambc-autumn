+void Search::read_economics() {
+    if (intent.anchored || intent.gold_denial <= 0 || intent.gold_capture <= 0
+        || world.round + cambc::constants::capture_time + 1 > static_cast<int>(cambc::constants::max_rounds)) return;
+    std::array<int, 49> checked;
+    std::array<bool, 49> qualified;
+    std::array<std::uint16_t, 49> enemies;
+    int count = 0;
+    each_bit(free_ | gbit(cell(here)), [&](int c) {
+        const int g = world.map().group_at(tile(c));
+        if (g < 0) return;
+        int k = 0;
+        while (k < count && checked[k] != g) ++k;
+        if (k == count) {
+            checked[count++] = g;
+            qualified[k] = false;
+            enemies[k] = 0;
+            const auto& G = world.map().groups[g];
+            const auto& b = world.camps[g];
+            if (G.has_monolith || G.gems != 0 || G.gold <= 0 || b.state != CampState::cleared
+                || b.state_round != world.round || !(G.tiles() & ~world.visible).is_empty()) return;
+            std::uint32_t occupants = 0;
+            bool other_ally = false;
+            for (const auto& a : world.allies)
+                if (a.alive && (a.visible || a.is_self) && test(G.tiles(), a.is_self ? here : a.pos)) {
+                    occupants |= 1u << a.index;
+                    other_ally |= !a.is_self;
+                }
+            for (const auto& e : world.enemies)
+                if (e.alive && e.visible && test(G.tiles(), e.pos)) {
+                    occupants |= 1u << (16 + e.index);
+                    enemies[k] |= static_cast<std::uint16_t>(1u << e.index);
+                }
+            if (other_ally || occupants != b.occupants) return;
+            const bool ally = (occupants & 0xffffu) != 0, enemy = enemies[k] != 0;
+            if (b.holder != (ally == enemy ? std::optional<team>{}
+                            : std::optional<team>{ally ? team::ally : team::enemy})) return;
+            if (b.holder == team::enemy && (b.held_since < 0 || b.payout_round() <= world.round)) return;
+            qualified[k] = true;
+        }
+        if (qualified[k]) {
+            economic |= gbit(c);
+            gold[c] = static_cast<float>(world.map().groups[g].gold);
+            gold_enemies[c] = enemies[k];
+        }
+    });
+}
