+// Narrow source-known diagnostic window; instrumentation exists only in isolated copies.
+bool recall_diag_scope(const World& world) {
+    return static_cast<std::uint32_t>(world.me().handle) == 4 && world.round >= 41 && world.round <= 43;
+}
+bool recall_diag_home(const World& world, const char* reason, bool result) {
+    if (recall_diag_scope(world))
+        std::printf("HOME r%d actor%u pos%d,%d %s result%d\n", world.round, static_cast<std::uint32_t>(world.me().handle),
+                    world.me().pos.x, world.me().pos.y, reason, result);
+    return result;
+}
+void recall_diag_line(const World& world, const Memory& memory, const char* reason, int channel, int home_state) {
+    if (recall_diag_scope(world))
+        std::printf("RECALL r%d actor%u channel%d home%d %s pos%d,%d farm%d claim%d banking%d\n",
+                    world.round, static_cast<std::uint32_t>(world.me().handle), channel, home_state, reason, world.me().pos.x,
+                    world.me().pos.y, memory.farm_group, memory.claim, memory.banking);
+}
+void recall_diag_path(const World& world, const Memory& memory, const char* reason, vec2 from) {
+    if (recall_diag_scope(world)) {
+        const vec2 to = my_position();
+        std::printf("PATH r%d actor%u %s %d,%d->%d,%d farm%d claim%d banking%d\n", world.round,
+                    static_cast<std::uint32_t>(world.me().handle), reason, from.x, from.y, to.x, to.y, memory.farm_group, memory.claim, memory.banking);
+    }
+}
