+void Pathing::farm_occupied_into(bitboard& out) {
+    world_.throw_if_stale();
+    // Pair fresh native occupancy and vision: World/blocked() may predate our move or camp kill.
+    // Visible emptiness overrides belief; native occupied camps still block after a respawn.
+    static bitboard unseen{cambc::uninitialized}, remembered{cambc::uninitialized};
+    occupied_into(out);
+    vision_into(unseen);
+    not_into(unseen, unseen);
+    and_into(live_camps(), unseen, remembered);
+    or_into(out, remembered, out);
+    world_.throw_if_stale();
+}
+
+const bitboard& Pathing::walking_blocked(RoutePolicy policy) {
+    if (policy == RoutePolicy::visible) return blocked();
+    static bitboard walls{cambc::uninitialized};
+    farm_occupied_into(walls);
+    set_tile(walls, my_pos(), false);
+    return walls;
+}
