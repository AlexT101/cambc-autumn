+std::optional<float> Safety::after_camp_kill(vec2 p, float bound, std::size_t member) const {
+    if (!members_known_ || member >= static_cast<std::size_t>(member_count_)) return std::nullopt;
+    const auto& hit = members_[member];
+    if (hit.stunned || !(hit.strength > 0) || !in_square(p, hit.pos, hit.reach) || !(bound >= hit.strength)) return std::nullopt;
+    return bound - hit.strength;
+}
