+// A ranged basic spends the walk: use it only when every evaluated step and staying are lethal.
+bool emergency_camp_basic(const World& world, Pathing& pathing, Safety& safety, vec2 here, float stay_bound, float step_bound) {
+    if (world.me().type != cambc::champion_type::prism) return false;
+    world.throw_if_stale();
+    const auto live = my_record();
+    world.throw_if_stale();
+    using cambc::champion_state;
+    const auto state = champion_state::from_bits_retain(live.state);
+    if (!state.contains(champion_state::alive) || !state.contains(champion_state::can_move)
+        || !state.contains(champion_state::can_attack) || state.contains(champion_state::recalling)
+        || state.contains(champion_state::submitting_gems) || state.contains(champion_state::teleporting)
+        || vec2{live.x, live.y} != here || !(live.health > 0) || !(stay_bound >= live.health) || !(step_bound >= live.health))
+        return false;
+    const float basic = live.strength * damage_scale(world.me().facts().passive, live.health, live.max_health)
+                        * (has_family(my_items(), monster) ? 1.1f : 1.0f);
+    world.throw_if_stale();
+    if (!(basic > 0)) return false;
+    const auto members = safety.awake_members();
+    int checked = 0;
+    for (std::size_t i = 0; i < members.size() && checked < 16; ++i) {
+        const auto& hit = members[i];
+        if (dist(here, hit.pos) > live.attack_range || !test(world.visible, hit.pos)) continue;
+        const auto after = safety.after_camp_kill(here, stay_bound, i);
+        if (!after || !(*after < live.health) || !(*after < step_bound)) continue;
+        const int g = world.map().group_at(hit.pos);
+        if (g < 0) continue;
+        const auto& group = world.map().groups[g];
+        const auto& belief = world.camps[g];
+        if (group.members.size() > 16 || group.has_monolith || belief.state != CampState::alive || !belief.fully_awake()) continue;
+        const auto target = std::find_if(group.members.begin(), group.members.end(), [&](const auto& m) { return m.handle == hit.handle; });
+        if (target == group.members.end() || target->strength <= 0) continue;
+        ++checked;
+        try {
+            world.throw_if_stale();
+            cambc::detail::camp_state camp{};
+            ok(cambc::detail::sdk_camp(hit.handle, &camp));
+            world.throw_if_stale();
+            if (vec2{camp.x, camp.y} != hit.pos || !(camp.health > 0) || !(camp.health <= basic) || camp.strength != target->strength) continue;
+            bool awake = true;
+            for (const auto& m : group.members) {
+                if (m.strength <= 0) continue;
+                std::uint32_t current{};
+                ok(cambc::detail::sdk_camp_state(m.handle, &current));
+                if ((current != 0 && current != 1) || (m.handle == hit.handle && current != 1)) { awake = false; break; }
+            }
+            world.throw_if_stale();
+            if (!awake) continue;
+            const CampAttackTarget choice{g, static_cast<int>(target - group.members.begin()), 0};
+            const bool attacked = attack_camp_target(world, choice);
+            world.throw_if_stale();
+            if (!attacked) continue;
+            safety.refresh();
+            pathing.invalidate();
+            world.throw_if_stale();
+            return true;
+        } catch (const cambc::error&) {
+        }
+        world.throw_if_stale();
+    }
+    world.throw_if_stale();
+    return false;
 }
 
