+namespace {
+
+bitboard grown(const bitboard& tiles, int r) {
+    auto rows = tiles;
+    for (int d = 1; d <= r; ++d) rows |= tiles.shift_right(d) | tiles.shift_right(-d);
+    auto b = rows;
+    for (int d = 1; d <= r; ++d) b |= rows.shift_up(d) | rows.shift_up(-d);
+    return b;
+}
+
+} // namespace
+
+const std::vector<Pathing::VaultLeg>* Pathing::vault_legs(std::uint64_t fuel_floor) {
+    if (vault_legs_) return &*vault_legs_;
+    const auto& s = map();
+    const int everywhere = std::min(s.width * s.height, static_cast<int>(unreachable) - 1);
+    if (!fuel_ok(fuel_floor + 2 * field_cost_estimate())) return nullptr;
+    FuelMeter meter{"vaults"};
+    const auto outside = s.blocked_for_us.reachable_tiles(s.ally_spawn_centre, static_cast<std::uint16_t>(everywhere));
+    bitboard sealed;
+    for (const auto& a : s.altars) sealed |= a.tribute_tiles();
+    sealed &= ~outside;
+    std::vector<VaultLeg> legs;
+    if (sealed.is_empty()) {
+        vault_legs_ = std::move(legs);
+        return &*vault_legs_;
+    }
+    bitboard inside;
+    for (auto t : sealed.positions())
+        if (!inside.is_set(t)) inside |= s.blocked_for_us.reachable_tiles(t, static_cast<std::uint16_t>(everywhere));
+    vault_landings_ = inside & ~s.camp_tiles;
+    // Landings within a crystal's reach of tiles we walk, by their steps to a tribute tile.
+    const auto& to_altar = to_any_altar();
+    std::vector<bitboard> by_steps;
+    for (auto t : (vault_landings_ & grown(outside, teleport_crystal_range)).positions()) {
+        const int steps = to_altar.at(t);
+        if (steps == unreachable) continue;
+        if (static_cast<int>(by_steps.size()) <= steps) by_steps.resize(steps + 1);
+        by_steps[steps].set(t);
+    }
+    const auto launchable = outside & s.standable;
+    bitboard covered;
+    for (int steps = 0; steps < static_cast<int>(by_steps.size()); ++steps) {
+        if (by_steps[steps].is_empty()) continue;
+        auto launch = grown(by_steps[steps], teleport_crystal_range) & launchable & ~covered;
+        if (launch.is_empty()) continue;
+        covered |= launch;
+        legs.push_back({static_cast<int>(cambc::constants::tp_crystal_time) + steps, make_field(s.blocked_for_us, launch)});
+    }
+    vault_legs_ = std::move(legs);
+    return &*vault_legs_;
+}
+
+int Pathing::vault_steps(vec2 p, const VaultLeg** leg) {
+    const auto* legs = vault_legs();
+    int best = unreachable;
+    if (!legs) return best;
+    for (const auto& l : *legs) {
+        const int walk = l.field.at(p);
+        if (walk == unreachable || walk + l.cost >= best) continue;
+        best = walk + l.cost;
+        if (leg) *leg = &l;
+    }
+    return best;
+}
