+
+/// cambc runner (fastrunner's native mode): records how each bulk memory operation's size-proportional fuel was
+/// translated, keyed by the operator's offset in the module, while a recording is active.
+#[doc(hidden)]
+pub mod cambc_hook {
+    use std::sync::Mutex;
+    static LOG: Mutex<Option<Vec<(u32, u8, u8, i64)>>> = Mutex::new(None);
+    /// Starts a recording (dropping any previous one).
+    pub fn start() {
+        *LOG.lock().unwrap() = Some(Vec::new());
+    }
+    /// Ends the recording: (operator offset, 0 = constant charged up front / 1 = constant charged after
+    /// with a fuel check / 2 = runtime size charged after with a fuel check, cost per unit, constant units).
+    pub fn take() -> Vec<(u32, u8, u8, i64)> {
+        LOG.lock().unwrap().take().unwrap_or_default()
+    }
+    pub(crate) fn record(loc: u32, kind: u8, cost: u8, units: i64) {
+        if let Some(v) = LOG.lock().unwrap().as_mut() {
+            v.push((loc, kind, cost, units));
+        }
+    }
+}
