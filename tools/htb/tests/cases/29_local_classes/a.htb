#include <algorithm>
#include <vector>

struct Sorter {
    std::vector<int> sorted(std::vector<int> v) const {
        struct Desc {
            bool operator()(int a, int b) const { return a > b; }
        };
        std::sort(v.begin(), v.end(), Desc{});
        auto add = [offset = 1](int x) { return x + offset; };
        for (auto& x : v) {
            x = add(x);
        }
        return v;
    }
};

int local_class_fn() {
    struct Local {
        int twice(int v) { return v * 2; }
    };
    class {
    public:
        int k = 3;
    } anon;
    return Local{}.twice(anon.k);
}
