#include <cstdio>

int main() {
    geo::Point p{3, 4};
    std::printf("%d\n", geo::metrics::length2(p));
    std::printf("%d\n", gm::length2(geo::add(p, p)));
    std::printf("%d\n", geo::dot(p, origin()));
    std::printf("%d %d\n", node_value(a::Node{}), node_value(b::Node{}));
    std::printf("%d %d %d\n", version(), v2::version(), use_hidden());
    std::printf("%d\n", ::geo::detail::square(5));
}
