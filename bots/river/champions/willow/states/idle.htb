// The respawn turn: no walking, attacking or casting.
namespace willow::states::idle {
inline constexpr int max_score = 18;
inline int score(aph::Turn& t) { return aph::steps::wants::idle(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::idle(t); }
} // namespace willow::states::idle
