#include <cambc.h>
#include <array>

// Claims without comms, as Khaos's harvest: a group belongs to the ally strictly nearest it (ties
// to nobody), and an ally claims the nearest group it owns, if one is within `reach`. Every ally
// works this out the same from the same positions (comms keeps them exact), so nothing is posted.
// Chebyshev distance to the group's centre: a walk would need a field lookup per ally and group.
namespace aph::claims {

inline constexpr int reach = 8;
inline constexpr bool enabled = true; // test switch
inline int _round = -1;
inline std::array<int, 8> _claim{}; // by ally index, -1 for none

// Where we have ally a this turn, if we know.
inline bool placed(const World& world, const ChampionBelief& a) {
    return a.alive && (a.is_self || a.visible || (a.pos_source == Source::comms && a.pos_round == world.round));
}

inline bool claimable(const World& world, int g) {
    const auto& G = world.map().groups[g];
    return !G.has_monolith && G.gems + G.gold > 0 && world.camps[g].state != CampState::respawning;
}

// Per tile, the groups with a reward and no Monolith within reach of it, nearest first (ties by
// group): fixed for the game, so each tile's list is worked out once, the first time an ally stands
// there. An ally's claim is the first of its tile's groups that is open and that no other ally is as
// near to: usually the first or second, so a turn costs a few lookups an ally, not a pass over every
// group (~100 fuel a group and ally).
inline constexpr int listed = 8;
struct Near {
    std::array<std::int16_t, listed> group;
    std::array<std::int8_t, listed> dist;
    std::int8_t count; // listed + 1; 0: not worked out
};
// Static and zeroed for free: a vector of one entry per tile would cost a fuel a byte to fill.
inline std::array<Near, 100 * 100> _near;
// Groups by the 8x8 cell of their centre, built once: a tile's list reads only the cells in reach.
inline std::vector<std::vector<std::int16_t>> _cells;
inline int _cells_x = 0;

const Near& near_groups(const World& world, vec2 p) {
    const auto& map = world.map();
    const auto& groups = map.groups;
    if (_cells.empty()) {
        _cells_x = (map.width + 7) / 8;
        _cells.resize(static_cast<std::size_t>(_cells_x * ((map.height + 7) / 8)));
        for (int g = 0; g < static_cast<int>(groups.size()); ++g)
            if (!groups[g].has_monolith && groups[g].gems + groups[g].gold > 0)
                _cells[static_cast<std::size_t>((groups[g].centre.y >> 3) * _cells_x + (groups[g].centre.x >> 3))].push_back(static_cast<std::int16_t>(g));
    }
    auto& n = _near[static_cast<std::size_t>(p.y * map.width + p.x)];
    if (n.count > 0) return n;
    int count = 0;
    const int x0 = std::max(0, (p.x - reach) >> 3), x1 = std::min(_cells_x - 1, (p.x + reach) >> 3);
    const int y0 = std::max(0, (p.y - reach) >> 3), y1 = std::min((map.height - 1) >> 3, (p.y + reach) >> 3);
    for (int cy = y0; cy <= y1; ++cy)
        for (int cx = x0; cx <= x1; ++cx)
            for (const int g : _cells[static_cast<std::size_t>(cy * _cells_x + cx)]) {
                const int d = dist(p, groups[g].centre);
                if (d > reach) continue;
                // Insert keeping (distance, group) order; the farthest falls off a full list.
                int i = count < listed ? count++ : listed;
                if (i == listed) {
                    if (d > n.dist[listed - 1] || (d == n.dist[listed - 1] && g > n.group[listed - 1])) continue;
                    i = listed - 1;
                }
                while (i > 0 && (n.dist[i - 1] > d || (n.dist[i - 1] == d && n.group[i - 1] > g)))
                    n.group[i] = n.group[i - 1], n.dist[i] = n.dist[i - 1], --i;
                n.group[i] = static_cast<std::int16_t>(g), n.dist[i] = static_cast<std::int8_t>(d);
            }
    n.count = static_cast<std::int8_t>(count + 1);
    return n;
}

void work_out(const World& world) {
    if (_round == world.round) return;
    _round = world.round;
    _claim.fill(-1);
    if constexpr (!enabled) return;
    std::array<vec2, 8> at;
    std::array<int, 8> who;
    int k = 0;
    for (const auto& a : world.allies)
        if (placed(world, a)) at[k] = a.pos, who[k++] = a.index;
    const auto& groups = world.map().groups;
    const auto* camps = world.camps.data();
    for (int i = 0; i < k; ++i) {
        const auto& n = near_groups(world, at[i]);
        for (int j = 0; j < n.count - 1; ++j) {
            const int g = n.group[j], d = n.dist[j];
            if (camps[g].state == CampState::respawning) continue;
            bool alone = true;
            for (int o = 0; o < k && alone; ++o) alone = o == i || dist(at[o], groups[g].centre) > d;
            if (alone) {
                _claim[who[i]] = g;
                break;
            }
        }
    }
}

// Ally a's claim, -1 for none.
inline int of(const World& world, int a) {
    work_out(world);
    return a >= 0 && a < 8 ? _claim[a] : -1;
}

inline bool claims(const World& world, int a, int g) { return of(world, a) == g; }

// Another ally claims group g.
inline bool theirs(const World& world, int g) {
    work_out(world);
    for (int i = 0; i < static_cast<int>(world.allies.size()); ++i)
        if (i != world.self_index && _claim[i] == g) return true;
    return false;
}

} // namespace aph::claims
