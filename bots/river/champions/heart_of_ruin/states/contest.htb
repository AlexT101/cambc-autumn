// A capture the enemy holds that we can break.
namespace heart_of_ruin::states::contest {
inline constexpr int max_score = 3;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::contest(t); }
} // namespace heart_of_ruin::states::contest
