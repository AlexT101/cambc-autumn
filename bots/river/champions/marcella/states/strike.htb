// The strike search: hits, casts and the walk that sets them up; ends the turn only if we died.
namespace marcella::states::strike {
inline constexpr int max_score = 9;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::strike(t); }
} // namespace marcella::states::strike
