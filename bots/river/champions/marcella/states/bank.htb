// Carrying a bag: bank it, wait for a safe tribute, or chain a capture.
namespace marcella::states::bank {
inline constexpr int max_score = 7;
inline int score(aph::Turn& t) { return aph::steps::wants::bank(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::bank(t); }
} // namespace marcella::states::bank
