// Captures, where the capture rule puts us: off one a Prism holds, onto one Vesper Vale relieves, staying on
// ours, or walking to the nearest of ours.
namespace vesper_vale::states::capture {
inline constexpr int max_score = 10;
inline int score(aph::Turn& t) { return aph::steps::capture_score(t, max_score); }
inline bool run(aph::Turn& t) { return aph::steps::capture(t); }
} // namespace vesper_vale::states::capture
