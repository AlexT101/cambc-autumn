// A teleport or tribute under way: kept, or the tribute cancelled and the turn goes on.
namespace stellar::states::channel {
inline constexpr int max_score = 19;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::channel(t); }
} // namespace stellar::states::channel
