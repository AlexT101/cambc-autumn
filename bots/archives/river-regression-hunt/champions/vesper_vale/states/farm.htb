// The best group to clear, by gems a round.
namespace vesper_vale::states::farm {
inline constexpr int max_score = 1;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::farm(t); }
} // namespace vesper_vale::states::farm
