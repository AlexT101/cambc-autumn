#include <cambc.h>
#include <optional>
#include <span>

// The turn as states: each champion's states/ list them in priority order, and each runs until one
// ends the turn (run() returns true). Some only prepare what later ones read (prepare, assess,
// tend, guard, strike). These are astraeus's decide() in its order, so play is unchanged.
namespace aph {

// What one turn's states share: the world and tools, and what earlier states found.
struct Turn {
    World& world;
    Pathing& pathing;
    Safety& safety;
    Memory& memory;
    cambc::champion_state state{};
    std::optional<bool> home; // want_home's answer once asked, until shopping changes our stats
    bool on_spawn = false, willow = false, prism = false;
    bool mend = false, leave = false, working = false, strikes = false, mate_eligible = false;
    bool holding = false, attacked = false;
};

// A camp member's reach covers a tile of our spawn (a rectangle), read once.
bool camps_reach_spawn(const World& world) {
    static int known = -1;
    if (known >= 0) return known == 1;
    known = 0;
    const auto& map = world.map();
    if (map.ally_spawn_tiles.empty()) return false;
    vec2 lo = map.ally_spawn_tiles[0], hi = lo;
    for (const vec2 t : map.ally_spawn_tiles)
        lo = {std::min(lo.x, t.x), std::min(lo.y, t.y)}, hi = {std::max(hi.x, t.x), std::max(hi.y, t.y)};
    for (const auto& g : map.groups)
        for (const auto& m : g.members)
            if (std::max({lo.x - m.pos.x, m.pos.x - hi.x, lo.y - m.pos.y, m.pos.y - hi.y, 0}) <= m.reach) known = 1;
    return known == 1;
}

namespace steps {

// Dead, the only thing left is shopping.
bool dead(Turn& t) {
    auto& world = t.world;
    if (!world.me().alive || bankable_bag(world, t.pathing) == 0 || retaining_gems(world, t.pathing)) t.memory.banking = false;
    if (world.me().alive) return false;
    t.memory.claim = -1;
    // The crystal first: an altar only it reaches holds our bags, and shards could spend its gold.
    buy_crystal(t.memory);
    buy_shards(world); // the dead can only shop
    buy_lock();
    return true;
}

// A teleport cannot act; a tribute or a recall goes on, or is cancelled and the turn goes on.
bool channel(Turn& t) {
    // One state read covers the channels until one is cancelled; a channel excludes the others.
    t.state = my_state();
    if (t.state.contains(cambc::champion_state::teleporting)) return true;
    if (t.state.contains(cambc::champion_state::submitting_gems) && continue_tribute(t.world, t.pathing, t.safety, t.memory, t.home))
        return true;
    if (t.state.contains(cambc::champion_state::recalling) && continue_recall(t.world, t.pathing, t.safety, t.memory, t.home))
        return true;
    return false;
}

// A ward, then shopping: neither moves us.
bool prepare(Turn& t) {
    auto& world = t.world;
    // A ward shares the recall's channel, so this is its first chance; its sight counts this turn
    // (probe-ward-sight). Growing clusters here would starve the search: the turn end grows them.
    if (place_ward(world, t.memory, false)) {
        see_again(world, t.pathing, t.safety);
        t.home.reset();
    }
    t.on_spawn = test(world.map().ally_spawn, my_position());
    if (t.on_spawn) buy_crystal(t.memory);
    if ((t.on_spawn || world.me().facts().passive == Passive::remote_shop) && buy_shards(world)) t.home.reset();
    if (t.on_spawn) buy_lock();
    return false;
}

// The respawn turn allows no walking, attacking or casting.
bool idle(Turn& t) { return !t.world.me().can_act(t.world.round); }

// An enemy bag that would win the game: stop it.
bool ender(Turn& t) {
    if (const auto* ender = game_ender(t.world)) {
        stop_game_ender(t.world, t.pathing, t.memory, *ender);
        return true;
    }
    return false;
}

// What the rest of the turn reads: healing on spawn, leaving for home, Willow at work, a strike.
bool assess(Turn& t) {
    auto& world = t.world;
    t.willow = world.me().type == cambc::champion_type::willow;
    t.prism = world.me().type == cambc::champion_type::prism;
    // Healing needs a turn end on spawn; a recall arrives at turn start.
    // Not under an awake camp: it hits us every round, so we would mend forever while it stays awake.
    t.mend = t.on_spawn && my_health() < my_max_health() && !(camps_reach_spawn(world) && t.safety.camp_damage(my_position()) > 0);
    t.leave = !t.mend && (t.home ? *t.home : want_home(world, t.pathing, t.safety, t.memory));
    // Willow at work heals first, and the work goes on without the strike search.
    t.working = t.willow && !t.mend && !t.leave && support_work(world, t.pathing, t.safety, t.memory);
    t.strikes = !t.working && strike_possible(world);
    t.mate_eligible = false;
    return false;
}

// Prism and Willow together: Willow keeps Prism alive, or heals on its own, or both leave.
bool support(Turn& t) {
    auto& world = t.world;
    if (!t.mend && (t.prism || (t.willow && !t.leave && !t.working))
        && support_endpoint(world, t.willow ? cambc::champion_type::prism : cambc::champion_type::willow)
        && local_support(world, t.pathing, t.safety, t.memory, t.leave, t.mate_eligible))
        return true;
    if (t.willow && !t.mend && !t.leave && !t.strikes && !stunned_turn && !t.working && !t.mate_eligible && !support_retreat
        && willow_independent_heal_step(world, t.pathing, t.safety))
        return true;
    if (support_retreat) {
        heal_ally(world);
        aph::retreat(world, t.pathing, t.safety, t.memory);
        return true;
    }
    return false;
}

// Heals and shields where the strike search will not weigh them.
bool tend(Turn& t) {
    if (!t.strikes || t.mend || t.leave) {
        heal_ally(t.world);
        if (!t.strikes || !(reset_may_kill(t.world) || landing_ready(t.world))) shield_if_needed(t.world, t.safety, t.memory.claim);
    }
    return false;
}

// On spawn and hurt: fight from where we heal.
bool mend(Turn& t) {
    if (!t.mend) return false;
    decision = 'H';
    const bool attacked = attack_enemy(t.world);
    if (attacked) reset_and_attack_enemy(t.world, true);
    cast_at_enemies(t.world);
    if (attacked) reset_and_attack_enemy(t.world);
    return true;
}

bool retreat(Turn& t) {
    if (!t.leave) return false;
    aph::retreat(t.world, t.pathing, t.safety, t.memory);
    return true;
}

// Steps that would hand a fight to the enemy are left out of every route this turn.
bool guard(Turn& t) {
    guard_steps(t.world, t.pathing, t.safety);
    return false;
}

// A capture an ally is better placed to hold, or one handed to us.
bool capture(Turn& t) {
    if (yield_capture(t.world, t.pathing, t.safety, t.memory)) return true;
    if (take_capture_handoff(t.world, t.pathing, t.safety, t.memory)) return true;
    return false;
}

// The strike search: hits, casts and the walk that sets them up, priced together.
bool strike(Turn& t) {
    auto& world = t.world;
    auto& pathing = t.pathing;
    auto& safety = t.safety;
    auto& memory = t.memory;
    t.holding = holding_capture(world, pathing) || contesting(world);
    t.attacked = false;
    if (t.strikes) {
        Intent intent;
        intent.anchored = t.holding;
        intent.walks = !t.holding && (retaining_gems(world, pathing) || !can_tribute_here(world));
        // A carrier's step banks a turn sooner, freeing a turn of output for the farm.
        intent.step_value = farm_step_value(world);
        // An enemy already in attack range was not worth leaving (want_home): the fight is here.
        if (enemy_within(world, my_position(), world.me().facts().attack_range())) intent.walks = false;
        // The goal most likely walks to an altar when carrying, else to the farm choice.
        intent.to_altar = bankable_bag(world, pathing) > 0 && !retaining_gems(world, pathing);
        intent.group = memory.farm_group;
        struck = true;
        const auto planned = plan_strikes(world, pathing, safety, intent);
        t.attacked = planned.attacked;
        searched = planned.searched;
        searched_at = my_position();
        searched_hit = !my_can_attack();
        if (!searched) heal_ally(world);
        // The search priced nothing against an enemy its own moves revealed.
        if (see_revealed(world, pathing, safety)) searched = false;
        // A cast the search left priced the shield at nothing, blind to the goal's coming camp hit:
        // judged here, before farm's camp reset or dash takes it.
        shield_if_needed(world, safety, memory.claim);
    }
    decision = t.holding ? 'P' : t.attacked ? 'A' : decision;
    if (!cambc::self().is_alive()) return true;
    if (!my_can_attack() || !my_can_cast()) see_stuns(world, safety), safety.refresh();
    // The guard was placed around the tile we started on: the goal steps from where the search left us.
    if (my_position() != world.me().pos && (my_can_move() || my_can_cast())) guard_steps(world, pathing, safety);
    return false;
}

// On a capture we hold or contest: hold it.
bool hold(Turn& t) {
    if (!t.holding) return false;
    hold_capture(t.world, t.memory, t.attacked);
    return true;
}

// Carrying a bag an altar can take: bank it, or wait for a safe tribute, or chain a capture.
bool bank(Turn& t) {
    if (bankable_bag(t.world, t.pathing) <= 0 || retaining_gems(t.world, t.pathing)) return false;
    carry_bag(t.world, t.pathing, t.safety, t.memory, t.attacked);
    return true;
}

// A ranged attack spent the walk.
bool spent(Turn& t) { return t.attacked && !t.world.me().facts().walk_and_attack_independent(); }

// Home to shop, when the emblem is worth the trip.
bool shop(Turn& t) {
    if (!wants_shop(t.world, t.pathing, t.safety, t.memory)) return false;
    decision = 'S';
    t.memory.claim = -1;
    step_safely(t.pathing, t.pathing.to_ally_spawn(), t.safety);
    return true;
}

bool chase(Turn& t) { return aph::chase(t.world, t.pathing, t.safety); }

// A capture the enemy holds that we can break.
bool contest(Turn& t) {
    if (!contest_capture(t.world, t.pathing, t.memory)) return false;
    decision = 'X';
    return true;
}

// A Monolith or a group sealing the altars, by the team together; a big shared group, kited.
bool siege(Turn& t) {
    decision = 'F';
    if (!(t.world.map().shared_gems ? kite(t.world, t.pathing, t.memory) : aph::siege(t.world, t.pathing, t.memory))) return false;
    decision = 'G';
    return true;
}

bool farm(Turn& t) {
    aph::farm(t.world, t.pathing, t.safety, t.memory);
    return true;
}

} // namespace steps

} // namespace aph
