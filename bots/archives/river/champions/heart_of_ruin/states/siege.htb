// A Monolith or a group sealing the altars, by the team; a big shared group, kited.
namespace heart_of_ruin::states::siege {
inline constexpr int max_score = 2;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::siege(t); }
} // namespace heart_of_ruin::states::siege
