// A ranged attack spent the walk.
namespace heart_of_ruin::states::spent {
inline constexpr int max_score = 6;
inline int score(aph::Turn& t) { return aph::steps::wants::spent(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::spent(t); }
} // namespace heart_of_ruin::states::spent
