#include <cambc.h>
#include <algorithm>
#include <array>
#include <cstdint>
#include <vector>

// The team's 8 shared bytes: one arithmetic-coded number holding a slot per ally, in ally order, then a
// report of the enemies each ally sees, in ally order, in whatever the slots leave.
//
// A slot starts with its turn bit (the parity of the round it was written), then says what its ally did
// in its latest turn: a move of up to 3 tiles from where the team had it (a walk and a dash; none is
// "stay"), or an arrival on a named spawn tile followed by such a move. Every champion's bot runs every
// turn, the dead's too, and rewrites its slot first thing, so the turn bits tell a reader how many slots
// each teammate has written since the reader's turn before: one, none, or two when the teammate moved
// ahead of it in the turn order (a priority applies from the next round). The writer sees the same, so
// it knows where each teammate has it. When one missed its last slot, the slot covers it: the new
// position's residues mod a square window that holds every position teammates have for it. A reader
// applies any new slot to what it has, so it needs only to tell a new slot from one it has read. Turn
// order can change at will. A slot that would leave less than a reserve is written as a hold (nothing
// new: readers lag a turn), which always fits, so the turn bit is always written.
//
// The code is exact arithmetic coding in 64-bit integers: the range starts at 2^64 - 1 and each value
// keeps its share of it (a frequency out of 1024, or 1 of n equal values), so a word costs the sum of
// log2(1 / p) over its values. A move is coded by its frequency given the ally's two moves before (by
// class: stay, each step, other), about 2.1 bits; a slot's mode by its frequency given the previous
// slot's (windows come together: a teammate that moved back in the turn order missed every slot of those
// now ahead of it). A window or an absolute slot starts the ally's history again. About 3.6 bits a slot in
// all (simulated over 80 ladder games: research/EXPERIMENTS.md).
//
// Wards, after the reports: one entry, absent (the zeros a word ends in read as absent) or an ally's
// ward tile, flagged new or not. A writer puts, by priority: its own new ward (written at once; yields to
// another ally's new entry), the entry it read if new, its own on its two refresh rounds (round / 2 mod
// the team size is its index), else the entry it read, put again so later writers keep it; dropped when
// it does not fit. A new ward is put new until our next tick finds it still in the word (every teammate
// ticked in between, so read it), else put new again; then once more, not new, for any that missed a tick.
//
// Reports, after every slot: an ally's is absent (it sees nobody), or the enemies it sees, relative to
// its last report (an enemy in both by its move, given its move before) or fresh (each tile from the
// writer's communicated position: its ring, its sector about the line from our spawn to theirs, and its
// tile in that sector; past ring 16 its tile index). A writer short of room drops teammates' reports,
// the last first; a dropped report reads as absent. Relative only when every teammate has the writer's
// last report: each has written since reading it, and it is still in the word. A reader decodes a report
// only when its writer's slot is new, and otherwise puts it again as it read it, so no reader ever
// decodes one after a report it does not have. Slots never depend on reports: a report a reader cannot
// read costs only the reports after it, which it then writes as absent.
//
// Shared memory is read and written whole, so a write must land in the round of the read it is based
// on, or it would put back slots teammates have replaced since. A turn that runs out of fuel inside a
// host call gets that call's answer, then resumes next round: every write is preceded by a fuel check
// that leaves room for the round check and the write. A round the turn's start never comes (it resumed
// after running out of fuel and ran out again) still ticks: aph::fuel() runs the tick whenever the
// budget rises. Main never ends a turn with too little fuel to end it, which would cost the next turn.
namespace comms {

using aph::vec2;

// The tiles at Chebyshev distance r, bottom row left to right, then the sides, then the top row.
template <int r> constexpr std::array<vec2, 8 * r> make_ring() {
    std::array<vec2, 8 * r> out{};
    int n = 0;
    for (int x = -r; x <= r; ++x) out[n++] = {x, -r};
    for (int y = -r + 1; y <= r - 1; ++y) out[n++] = {-r, y}, out[n++] = {r, y};
    for (int x = -r; x <= r; ++x) out[n++] = {x, r};
    return out;
}
inline constexpr auto ring2 = make_ring<2>();
inline constexpr auto ring3 = make_ring<3>();

// Offsets 0-48: none, the steps in aph::directions order, then the rings of 2 and 3.
inline constexpr int offsets = 49;
constexpr vec2 offset(int k) {
    if (k == 0) return {0, 0};
    if (k <= 8) return aph::directions[k - 1];
    if (k <= 24) return ring2[k - 9];
    return ring3[k - 25];
}
constexpr std::array<std::array<std::int8_t, 7>, 7> make_offset_table() {
    std::array<std::array<std::int8_t, 7>, 7> t{};
    for (int k = 0; k < offsets; ++k) t[offset(k).x + 3][offset(k).y + 3] = static_cast<std::int8_t>(k);
    return t;
}
inline constexpr auto offset_table = make_offset_table();
inline int offset_index(vec2 d) {
    if (d.x < -3 || d.x > 3 || d.y < -3 || d.y > 3) return -1;
    return offset_table[d.x + 3][d.y + 3];
}

// Symbols: 0-48 a move by that offset (0 is "stay"), 49-97 an arrival (its spawn tile a field of its
// own) then a move.
inline constexpr int stay = 0, arrival_symbol = offsets, symbol_count = 2 * offsets;

// Frequencies out of 1024 by context (the two moves before, each by class: stay, step 1-8, other; 10 * the last
