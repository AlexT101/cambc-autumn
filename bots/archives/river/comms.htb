constexpr int symbol_class(int s) { return s == stay ? 0 : s <= 8 ? s : 9; }
inline constexpr int arrival_weight = 8, dashes = arrival_symbol - 9;
constexpr std::array<std::array<std::uint16_t, 10>, contexts + 1> make_frequency() {
    auto f = model;
    for (auto& row : f) row[0] = static_cast<std::uint16_t>(row[0] - (arrival_weight - 1) * row[9]);
    return f;
}
inline constexpr auto frequency_table = make_frequency();
constexpr std::array<std::array<std::uint16_t, 10>, contexts + 1> make_cumulative() {
    std::array<std::array<std::uint16_t, 10>, contexts + 1> c{};
    for (int k = 0; k <= contexts; ++k)
        for (int s = 1; s < 10; ++s) c[k][s] = static_cast<std::uint16_t>(c[k][s - 1] + frequency_table[k][s - 1]);
    return c;
}
inline constexpr auto cumulative_table = make_cumulative();
inline int frequency(int ctx, int s) {
    const auto& f = frequency_table[ctx];
    return s <= 8 ? f[s] : s == arrival_symbol ? arrival_weight * f[9] : f[9];
}
// Rare symbols: the dashes, the arrival with no move, then the arrivals with one.
inline int cumulative(int ctx, int s) {
    const auto& c = cumulative_table[ctx];
    const int f = frequency_table[ctx][9];
    return s <= 8 ? c[s] : s <= arrival_symbol ? c[9] + (s - 9) * f : c[9] + (dashes + arrival_weight + s - arrival_symbol - 1) * f;
}

// Slot modes. The mode symbol: single, a window of each radius, absolute, hold.
enum Mode : int { single_mode, window_mode, absolute_mode, hold_mode };
inline constexpr std::array<int, 5> window_radius = {1, 2, 3, 4, 6};
inline constexpr int mode_symbols = 8;
constexpr int mode_symbol(int mode, int radius) {
    if (mode == window_mode) {
        int k = 0;
        while (window_radius[k] != radius) ++k;
        return 1 + k;
    }
    return mode == single_mode ? 0 : mode == absolute_mode ? 6 : 7;
}
// Their frequencies out of 1024 (cumulative), after a single or hold (or first) and after a window or
// absolute slot.
inline constexpr std::array<std::array<std::uint16_t, mode_symbols + 1>, 2> mode_cumulative = {{
    {0, 953, 971, 991, 995, 1000, 1001, 1009, 1024},
    {0, 813, 883, 953, 965, 985, 986, 994, 1024},
}};

// An interval of the word's value: each value keeps its share of it. `ok` turns false once one does not
// fit (or, reading, once the word is spent).
struct Coder {
    std::uint64_t low = 0, range = ~std::uint64_t{0};
    bool ok = true;
    void symbol(int ctx, int s) {
        const auto q = range >> frequency_bits;
        if (q == 0) {
            ok = false;
            return;
        }
        low += q * static_cast<std::uint64_t>(cumulative(ctx, s));
        range = q * static_cast<std::uint64_t>(frequency(ctx, s));
    }
    int read_symbol(std::uint64_t word, int ctx) {
        const auto q = range >> frequency_bits;
        if (q == 0) {
            ok = false;
            return stay;
        }
        const auto v = (word - low) / q;
        const int t = v < (1u << frequency_bits) ? static_cast<int>(v) : (1 << frequency_bits) - 1;
        const auto& c = cumulative_table[ctx];
        // The last of the 10 entries at or below t (c[0] is 0): stay, the likeliest, first.
        int s = 0;
        if (t >= c[1])
            for (int step = 8; step > 0; step >>= 1)
                if (s + step <= 9 && t >= c[s + step]) s += step;
        int f = frequency_table[ctx][s], at = c[s];
        if (s == 9) {
            const int u = (t - at) / f;
            if (u < dashes) s += u, at += u * f;
            else if (u < dashes + arrival_weight) s = arrival_symbol, at += dashes * f, f *= arrival_weight;
            else {
                const int k = std::min(u - dashes - arrival_weight, symbol_count - arrival_symbol - 2);
                s = arrival_symbol + 1 + k, at += (dashes + arrival_weight + k) * f;
            }
        }
        low += q * static_cast<std::uint64_t>(at);
        range = q * static_cast<std::uint64_t>(f);
        return s;
    }
    // A value of weight f at cumulative weight c out of n (one of n equal values: f 1, c the value).
    void field(std::uint64_t f, std::uint64_t c, std::uint64_t n) {
        const auto q = range / n;
        if (q == 0) {
            ok = false;
            return;
        }
        low += q * c, range = q * f;
    }
    // The cumulative weight among n the word falls on; field() then keeps its value.
    std::uint64_t peek(std::uint64_t word, std::uint64_t n) {
        const auto q = range / n;
        if (q == 0) {
            ok = false;
            return 0;
        }
        const auto v = (word - low) / q;
        return v < n ? v : n - 1;
    }
    int read_field(std::uint64_t word, int n) {
        const int v = static_cast<int>(peek(word, static_cast<std::uint64_t>(n)));
        field(1, static_cast<std::uint64_t>(v), static_cast<std::uint64_t>(n));
        return v;
    }
    // Bits used so far.
    int bits() const { return 64 - (63 - __builtin_clzll(range)); }
};

inline std::vector<vec2> _spawn; // our spawn tiles, allies' start order
inline int spawn_count() { return std::max(1, static_cast<int>(_spawn.size())); }
inline int tile_count() { return cambc::map::width() * cambc::map::height(); }
inline vec2 tile_at(int k) { return {k % cambc::map::width(), k / cambc::map::width()}; }
inline int tile_index(vec2 p) { return p.y * cambc::map::width() + p.x; }

// One slot. single: a is the move; window: a and b the residues of x and y mod 2 radius + 1; absolute: a is
// the tile index.
struct Slot {
    int bit = 0, mode = single_mode, radius = 0;
    int a = stay, a_spawn = 0, b = stay;
    int ctx = 0; // the context a is coded in
};

inline void put_move(Coder& c, int ctx, int s, int spawn) {
    c.symbol(ctx, s);
    if (s >= arrival_symbol) c.field(1, static_cast<std::uint64_t>(spawn), static_cast<std::uint64_t>(spawn_count()));
}
inline int read_move(Coder& c, std::uint64_t word, int ctx, int& spawn) {
    const int s = c.read_symbol(word, ctx);
    spawn = s >= arrival_symbol ? c.read_field(word, spawn_count()) : 0;
    return s;
}
inline bool special(int mode) { return mode == window_mode || mode == absolute_mode; }
inline void put_slot(Coder& c, const Slot& s, bool after_special) {
    c.field(1, static_cast<std::uint64_t>(s.bit), 2);
    const auto& t = mode_cumulative[after_special];
    const int k = mode_symbol(s.mode, s.radius);
    c.field(t[k + 1] - t[k], t[k], 1024);
    switch (s.mode) {
    case absolute_mode: c.field(1, static_cast<std::uint64_t>(s.a), static_cast<std::uint64_t>(tile_count())); return;
    case window_mode: {
        const auto m = static_cast<std::uint64_t>(2 * s.radius + 1);
        c.field(1, static_cast<std::uint64_t>(s.a), m), c.field(1, static_cast<std::uint64_t>(s.b), m);
        return;
    }
    case single_mode: put_move(c, s.ctx, s.a, s.a_spawn); return;
    default: return;
    }
}
// The mode symbol at the reader: the mode and its window radius.
inline void read_mode(Coder& c, std::uint64_t word, bool after_special, Slot& s) {
    const auto& t = mode_cumulative[after_special];
    const auto v = c.peek(word, 1024);
    int k = 0;
    while (k + 1 < mode_symbols && v >= t[k + 1]) ++k;
    c.field(t[k + 1] - t[k], t[k], 1024);
    s.mode = k == 0 ? single_mode : k <= 5 ? window_mode : k == 6 ? absolute_mode : hold_mode;
    s.radius = s.mode == window_mode ? window_radius[k - 1] : 0;
}

// An ally's last two moves by class, latest first: the context of its next move. A window or absolute slot
// starts it again; a hold leaves it. A teammate that missed a single (or the start a window makes) is only
// ever sent a window or an absolute slot, so every reader the writer sends a single to has the same moves.
struct History {
    int c1 = 0, c2 = 0;
    int context() const { return c1 * 10 + c2; }
    bool operator==(const History&) const = default;
    void read(const Slot& s) {
        if (s.mode == window_mode || s.mode == absolute_mode) c1 = 9, c2 = 0;
        else if (s.mode == single_mode) c2 = c1, c1 = symbol_class(s.a);
    }
};

// The tile within Chebyshev r of ref with residues (x, y) mod 2r + 1.
inline vec2 residue_tile(vec2 ref, int x, int y, int r) {
    const int m = 2 * r + 1;
    const auto axis = [&](int c, int v) { const int lo = c - r; return lo + ((v - lo) % m + m) % m; };
    return {axis(ref.x, x), axis(ref.y, y)};
}

struct Sighting {
    int enemy;
    vec2 pos;
    int round;
};
inline std::array<Sighting, 8> _sightings{};
inline int _sighting_count = 0;
inline std::array<std::uint32_t, 8> _enemies{};
inline int _enemy_count = 0;

// Reports. Up to 7 enemies. Forms out of 64, so that every report's form fits after the slots' reserve
// (a field of n values needs the range to hold n); an enemy's flag in a relative report given whether
// the last had it, in a fresh one plain, out of 1024.
inline constexpr int max_enemies = 7;
enum Form { absent_form, relative_form, fresh_form };
inline constexpr int form_total = 64;
inline constexpr std::array<std::uint16_t, 4> form_cumulative = {0, 53, 63, 64};
inline constexpr std::array<std::uint16_t, 2> report_weight = {69, 975};
inline constexpr std::uint16_t report_weight_plain = 258;
