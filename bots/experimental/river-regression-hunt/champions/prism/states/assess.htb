// Reads what the later states need; never ends the turn.
namespace prism::states::assess {
inline constexpr int max_score = 16;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::assess(t); }
} // namespace prism::states::assess
