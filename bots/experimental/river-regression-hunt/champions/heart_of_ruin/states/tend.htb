// Heals and shields the strike search will not weigh; never ends the turn.
namespace heart_of_ruin::states::tend {
inline constexpr int max_score = 14;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::tend(t); }
} // namespace heart_of_ruin::states::tend
