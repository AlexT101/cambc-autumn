// A ward and shopping, which do not move us; never ends the turn.
namespace vesper_vale::states::prepare {
inline constexpr int max_score = 18;
inline int score(aph::Turn& t) { return aph::steps::wants::any(t) ? max_score : 0; }
inline bool run(aph::Turn& t) { return aph::steps::prepare(t); }
} // namespace vesper_vale::states::prepare
