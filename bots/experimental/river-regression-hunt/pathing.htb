// ---- from astraeus pathing.h ----
// Live routes treat the units we see as standing still: walk one step, then replan. A host
// search costs a fixed setup plus a little per layer, not per tile, so routes run in full.
#include <cambc.h>
#include <array>
#include <cstdint>
#include <functional>
#include <memory>
#include <optional>
#include <vector>

namespace aph {

// Extra steps a live route may take over the static walking distance.
inline constexpr int max_detour = 16;

class World;
class Safety;
struct StaticMap;

// Tiles a dash from `from` can land on: <= 2 king steps not through walls or camps, onto a free
// tile; off `also` too when given.
// A scratch board, valid until the next call.
const bitboard& dash_landings_from(const StaticMap& map, vec2 from, const bitboard* also = nullptr);
// A 2-step dash that passes a bush an equally short walk could step into. Dashes that only speed a route
// skip none: walking through shows what the bush hides. Landing in a bush or leaving one is fine.
inline bool skips_bush(const StaticMap& map, vec2 from, vec2 to) {
    if (dist(from, to) != 2) return false;
    for (int y = std::max(from.y, to.y) - 1; y <= std::min(from.y, to.y) + 1; ++y)
        for (int x = std::max(from.x, to.x) - 1; x <= std::min(from.x, to.x) + 1; ++x)
            if (const vec2 m{x, y}; m != from && m != to && test(map.bushes, m)) return true;
    return false;
}

class Pathing {
public:
    explicit Pathing(const World& world);

    void begin_turn();

    const Field& to_ally_spawn();
    const Field& to_altar(int altar); // goals: the altar's tribute tiles
    const Field& to_any_altar();
    int centre_to_altar(int group); // to_any_altar() at the group's centre, kept once read
    const Field& to_hop(int hop);   // goals: StaticMap::hops[hop]'s source tiles
    int hop_landing_steps(int hop); // the walk from its nearest landing tile to its altar, kept once read
    // Static steps to tiles within `range` of the group's camp tiles, around the camps believed alive:
    // the walk to its attack tiles but for sight lines near the end. Range 0: onto its camp tiles, to
    // capture. Null if no walk reaches it within the search's cap.
    const Field* approach(int group, int range);
    // approach(), or null without searching if the search could take the fuel below `fuel_floor`.
    const Field* prepare_approach(int group, int range, std::uint64_t fuel_floor);
    bool approach_ready(int group, int range); // usable from here without a search
    std::uint64_t approach_cost(int group, int range); // 0 when ready
    static std::uint64_t max_approach_cost() { return search_cost_estimate(cambc::map::width() + cambc::map::height()); }
    // Walking steps from the centre of a group worth farming (a reward, no Monolith): by symmetry,
    // from anywhere to it. Null until warmed up; centres_ready() once all are.
    const Field* from_centre(int group);
    bool centres_ready() const { return centres_ready_; }
    // Walkable tiles from which a basic attack reaches and sees the member, camp tiles included.
    const bitboard& member_attack_tiles(int group, int member, int range);
    // Over the members believed alive; off camp tiles, but for those of its dead members.
    void attack_tiles(int group, int range, bitboard& out);
    // Compute attack_tiles' missing parts while more than `fuel_floor` remains; true once cached.
    bool prepare_attack_tiles(int group, int range, std::uint64_t fuel_floor);
    // The same for the members in `members` (bit i: member i), alive or not.
    bool prepare_member_tiles(int group, int range, std::uint32_t members, std::uint64_t fuel_floor);
    bool prepare_member(int group, int member, int range, std::uint64_t fuel_floor);
    // Static steps to the tiles within `range` of any of the group's members, every camp tile a wall:
    // farm scores groups by it and walks down it, so each step it takes brings its target one nearer
    // (live sight lines and members only for the last steps). Made once per group; null until then.
    const Field* attack_field(int group, int range);
    // attack_field(), made now unless that could take the fuel below `fuel_floor`.
    const Field* prepare_attack_field(int group, int range, std::uint64_t fuel_floor);
    // attack_field() at our tile; on a camp tile (its walls), one more than the nearest neighbour. -1 without it.
    int attack_steps(int group, int range);
    // A turn down attack_field(), dash_route's for a dasher (true while it waits for the dash): units block
    // only next to us.
    bool walk_to_attack(int group, int range, const bitboard* avoid, std::optional<vec2> aim);
    // Precompute while more than `fuel_floor` remains; true once everything is cached.
    bool warm_up(int attack_range, std::uint64_t fuel_floor);
    // The centre fields first: until they are ready, farm builds a field from wherever we stand.
    // A field capped at centre_cap() has a bounded cost, so it may go down to last_reserve.
    bool warm_centres(std::uint64_t fuel_floor);

    // Our static fields' walls: a dasher's leave out the hole and altar lines a dash crosses.
    const bitboard& static_walls() const;
    const bitboard& foot() const;
    const bitboard& live_camps(); // members believed alive
    // Changes whenever a tile of live_camps() does, as of its last call.
    std::uint32_t live_flips() const { return live_flips_; }
    // Static walls, visible units and teleport reservations, and tiles bumped this round.
    const bitboard& blocked();
    void occupied_into(bitboard& out); // blocked() with our own tile set
    void invalidate(); // after we move or dash
    // The crossings (hole and altar lines a dash jumps in its two steps, map().crossable, less our own
    // static walls) a route may go over this turn: null unless the dash is ready.
    const bitboard* route_crossings();

    // While the dash is ready, routes are our own search over the 7x7 window around us (local_search):
    // a backward Dijkstra in half turns, bit-parallel in one u64. A step costs 2; a dash (a jump of up
    // to 2 king steps over a tile a dash may cross) costs its price; the window's rim costs 2 a host
    // walking step on to the goals. The search has no cooldown: the price is what a spent dash is worth.
    // With no need for it within its cooldown (8 turns) it is ready again before it is wanted:
    // eager_price, a dash for a gain of 2 steps. With a crossing ahead, keep_price(): the draft's tuned
    // price, else eager_price. With an enemy near, at least fight_price: the dash is the way out of a
    // fight, kept unless a dash gains 5 steps.
    static constexpr int window = 3;
    static constexpr int eager_price = 3, fight_price = 9;
    int keep_price() const;
    // The price for a route from our tile, `here_steps` walking steps from the goals by steps_at.
    template <class Steps>
    int dash_price(int here_steps, Steps steps_at);
    // From our tile toward `goals` over `walls`, with host_steps(p) the walking steps from p to the goals
    // (0 on one, unreachable if unknown); a dash costs `dash` (0: no dashes). Kept for the turn: repeats
    // with the same arguments are free. False if no way was found.
    template <class Steps>
    bool local_search(const bitboard& goals, const bitboard& walls, Steps host_steps, int dash);
    // After local_search, for tiles within 2 of us: the cost to go in half turns (-1: more than ours, or
    // no search from here this turn).
    int cost_to_go(vec2 p) const;

    // A hidden blocker fails a move without spending the walk; the other first steps are tried,
    // then the route is replanned.
    // An optional aim breaks equal-distance ties, retaining compass order for equal aim distance.
    bool step_towards(const bitboard& goals, const bitboard* avoid = nullptr, int max_steps = unreachable, std::optional<vec2> aim = std::nullopt);
    bool step_towards_funded(const bitboard& goals, std::uint64_t fuel_floor);
    // A live route within `max_detour` of the static distance, else greedy descent of the field.
    bool step_towards(const Field& field, const bitboard* avoid = nullptr, std::optional<vec2> aim = std::nullopt);
    // Cheap fallbacks without a search, when fuel is short: a step down the field, or one that
    // gets closer to the target as the crow flies.
    bool descend(const Field& field, const bitboard* avoid = nullptr, std::optional<vec2> aim = std::nullopt);
    bool step_closer(vec2 target, const bitboard* avoid = nullptr, std::optional<vec2> aim = std::nullopt);
    // False, spending nothing, if illegal, guarded or blocked by a hidden unit; `refused`: set
    // unless a hidden unit was the reason.
    bool try_move(vec2 tile, bool* refused = nullptr);
    // A hidden unit refused a move since the last call: it is in sight now.
    bool take_bump() { const bool b = bumped_new_; bumped_new_ = false; return b; }
    // While an advance runs, a tile `advance` names (the retreat would send us back from it) is never
    // stepped or dashed onto: refused like a hidden blocker, so routes go round it for the rest of the turn.
    void set_advance(std::function<bool(vec2)> advance) { advance_ = std::move(advance); }
    bool refuses(vec2 tile) {
        if (!advance_ || !advance_(tile)) return false;
        set_tile(bumped_, tile);
        bumped_any_ = true;
        ++refusals_;
        invalidate();
        return true;
    }
    int refusals() const { return refusals_; }
    // Tiles no step or dash may end on until cleared: routes go around them.
    void set_guard(const bitboard* guard) { guard_ = guard, guard_fn_ = nullptr; }
    // A guard worked out on first need, from inputs read now: a turn that never steps skips it.
    using GuardFn = const bitboard* (*)(const World&, Safety&, vec2 here, int radius);
    void defer_guard(GuardFn fn, Safety& safety, vec2 here, int radius) {
        guard_ = nullptr, guard_fn_ = fn, guard_safety_ = &safety, guard_here_ = here, guard_radius_ = radius;
    }
    const bitboard* guard() const {
        if (guard_fn_) {
            const auto fn = guard_fn_;
            guard_fn_ = nullptr;
            guard_ = fn(world_, *guard_safety_, guard_here_, guard_radius_);
        }
        return guard_;
    }
    // The guard as set, deferred or not, to put back without working it out.
    struct GuardState {
        const bitboard* guard;
        GuardFn fn;
    };
    GuardState held_guard() const { return {guard_, guard_fn_}; }
    void restore_guard(const GuardState& s) { guard_ = s.guard, guard_fn_ = s.fn; }

    // Routes are host searches from the goals, unweighted: steering by enemies' and camps' reach made
    // river passive (research/EXPERIMENTS.md, river: local router). Safety, the guard and the callers'
    // avoid boards keep it out of danger. play_turn sets the turn's Safety.
    void set_safety(Safety* safety) { safety_ = safety; }

    // Unseen units can still block these.
    const bitboard& dash_landings(); // <= 2 king steps not through walls or camps, onto a free tile, off the guard
    bitboard teleport_targets(); // free open or bush tiles within 3, not camp tiles or enemy spawn

private:
    Safety* safety_ = nullptr;
    // The last local search: where and for what, and its results for the 5x5 around us.
    struct Local {
        int round = -1;
        vec2 at{-1, -1};
        int dash = 0;
        bitboard goals{cambc::uninitialized}, walls{cambc::uninitialized};
        bool found = false;
        int cost = -1;
        std::array<std::int16_t, 25> to_go{};
    } local_;
    vec2 my_pos(); // our tile, read again after invalidate() or in a new round
    struct Neighbours {
        std::array<vec2, 8> tiles;
        int count = 0;
        const vec2* begin() const { return tiles.data(); }
        const vec2* end() const { return tiles.data() + count; }
    };
    // Free neighbours that get strictly closer on a static field, nearest first.
    Neighbours closer_neighbours(const Field& field, const bitboard* avoid = nullptr, std::optional<vec2> aim = std::nullopt);
    struct Route {
        int steps = unreachable; // 0: already on a goal; unreachable: none within the cap
        int count = 0;
        std::array<vec2, 8> first_steps; // the first `count`: all equally short, compass order unless aimed
        vec2 dash_to{-1, -1}; // when in bounds: the move is a dash onto it, not a step
    };
    // Host walking routes; while the dash is ready, the first move (a step or a dash) is local_search's,
    // a dash at its price. With no walk at all to goals beyond the window, a whole-map route over the
    // crossings, jumped by dash_over.
    Route route(const bitboard& goals, const bitboard* avoid = nullptr, int max_steps = unreachable, vec2 through = {-1, -1}, std::optional<vec2> aim = std::nullopt);
    Route route_on(const bitboard& goals, const bitboard* avoid, int max_steps, vec2 through, std::optional<vec2> aim, bool crossings);
    // Equally short first steps in step_tiebreak's order.
    void order_steps(Route& r, vec2 from, std::optional<vec2> aim) const;
    // The latest route's search: its distances from the goals, and whether it found no way
    // although it stopped short of its cap, so that no wider search finds one either.
    cambc::distance_field route_field_;
    bool route_exhausted_ = false;
    // Where a failed search last found us enclosed (enclosed()).
    vec2 pocket_at_{-1, -1};
    static constexpr int pocket_radius = 16;
    // No goal within the walkable region around us, which ends within pocket_radius, and no ally beside us.
    bool enclosed(const bitboard& walls, const bitboard& goals, vec2 me);
    // The latest search that found a way, with its goals and walls: complete below `layer`, the
    // layer that reached us.
    struct KeptRoute {
        cambc::distance_field field;
        bitboard goals{cambc::uninitialized}, walls{cambc::uninitialized};
        int layer = -1;
    } kept_route_;
    // Our steps in k if a search over `walls` would label every tile below them as k's did.
    static int kept_steps(const KeptRoute& k, const bitboard& goals, const bitboard& walls, vec2 me, int cap);
    // Two allies head-on with no way past: the one with fewer gems (ties: lower champion) backs off.
    // Right after a route that found no way, with the same arguments: read from its field.
    // Leaves route_exhausted_ set only if no ally's tile, freed, opens a way at any cap.
    bool make_way(const bitboard& goals, const bitboard* avoid, int max_steps);
    // The route's first step is a crossing: dash to the landing it reaches soonest, at least the
    // crossing's two steps nearer than `steps`.
    bool dash_over(int steps, const bitboard* avoid);
    int approach_steps(int group, int range);
    const Field* search_approach(int group, int range, int steps); // approach() once known not ready
    using Slot = std::unique_ptr<Field>;
    const Field& cached(Slot& slot, const bitboard& goals);
    Slot& altar_slot(int altar);
    struct Approach {
        Field field;
        bitboard camps; // the live camp tiles it walks around
        std::uint32_t flips = 0; // live_flips() when made
    };
    std::unique_ptr<Approach>& approach_slot(int group, int range);
    // approach_ready's latest answer, reused for the same slot, round and tile.
    struct ReadyCheck {
        const Approach* slot = nullptr;
        int round = -1;
        vec2 at{-1, -1};
        bool ready = false;
    } ready_check_;
    std::unique_ptr<Approach> spare_approach_; // a replaced one, refilled by the next search
    struct AttackField {
        int range = -1;
        Field field;
        bitboard walls;
    };
    std::vector<std::unique_ptr<AttackField>> attack_fields_; // by group
    std::optional<bitboard>& attack_slot(int group, int member, int range);
    const StaticMap& map() const;
    bool farmed(int group) const; // farm reads only groups with a reward and no monolith
    // Layers to cap its centre field at, doubled after a field cut short; 0: uncapped (no draft plan).
    int& centre_cap(int group);

    const World& world_;
    Slot any_altar_;
    Slot ally_spawn_;
    std::vector<std::optional<int>> centre_to_altar_;
    std::vector<Slot> altar_fields_, centre_fields_, hop_fields_;
    std::vector<std::optional<int>> hop_landing_steps_;
    std::vector<int> centre_caps_;
    std::vector<std::vector<std::unique_ptr<Approach>>> approach_fields_; // by range, then group
    bitboard live_camps_;
    std::uint32_t live_camps_version_ = ~0u; // the World::camps_version it was built for
    std::vector<std::uint32_t> live_versions_; // per group: the CampBelief::version written
    std::vector<std::uint64_t> live_members_;  // per group: bit i, member i written alive
    std::uint32_t live_flips_ = 0;
    bool centres_ready_ = false;
    int warm_group_ = 0, warm_member_ = 0; // warm_up's progress through the attack tiles
    // By attack range, then group, then member.
    std::vector<std::vector<std::vector<std::optional<bitboard>>>> attack_tiles_;
    // Kept between rebuilds: allocating a board costs more than filling it.
    bitboard blocked_{cambc::uninitialized};
    bool blocked_fresh_ = false;
    bitboard bumped_;
    bool bumped_any_ = false, bumped_new_ = false;
    std::function<bool(vec2)> advance_;
    int refusals_ = 0;
    mutable const bitboard* guard_ = nullptr;
    mutable GuardFn guard_fn_ = nullptr;
    Safety* guard_safety_ = nullptr;
    vec2 guard_here_{-1, -1};
    int guard_radius_ = 1;
    int bumped_round_ = -1;
    vec2 pos_;
    std::uint32_t pos_round_ = 0;
    bool pos_fresh_ = false;
    unsigned dashes_seen_ = 0; // outside_dashes() when our tile was last read
};

} // namespace aph

// ---- from astraeus pathing.cpp ----
#include <algorithm>
#include <array>

namespace aph {

namespace {

template <class T> T& entry(std::vector<T>& table, std::size_t count, int i) {
    if (table.size() != count) table.resize(count);
    return table[static_cast<std::size_t>(i)];
}

int aim_distance(vec2 p, vec2 aim) { return std::abs(p.x - aim.x) + std::abs(p.y - aim.y); }

// Among equally short steps from `from` to `p`: into a bush first (out of sight), then diagonal, then
// nearer `aim` by Manhattan distance; lower first. Compass order breaks what is left.
int step_tiebreak(const StaticMap& s, vec2 from, vec2 p, std::optional<vec2> aim) {
    const bool bush = test(s.bushes, p), diagonal = p.x != from.x && p.y != from.y;
    return (bush ? 0 : 1 << 20) + (diagonal ? 0 : 1 << 19) + (aim ? aim_distance(p, *aim) : 0);
}

} // namespace

Pathing::Pathing(const World& world) : world_{world} {}

const StaticMap& Pathing::map() const { return world_.map(); }

namespace {
// 0: no dash; 1: a dash; 2: a dash that hits where it lands (StaticMap::landing_dash_walls).
int dash_kind(const ChampionFacts& f) {
    const int dash = f.slot_of(AbilityKind::dash);
    return dash < 0 ? 0 : f.abilities[dash].lands() ? 2 : 1;
}
} // namespace

const bitboard& Pathing::static_walls() const {
    const int kind = dash_kind(world_.me().facts());
    return kind == 0 ? map().blocked_for_us : kind == 1 ? map().dash_walls : map().landing_dash_walls;
}

const bitboard& Pathing::foot() const {
    const int kind = dash_kind(world_.me().facts());
    return kind == 0 ? map().foot() : kind == 1 ? map().dash_foot() : map().landing_dash_foot();
}

void Pathing::begin_turn() {
    guard_ = nullptr, guard_fn_ = nullptr; // a turn abandoned as stale left its guard set
    blocked_fresh_ = false;
    pos_fresh_ = false;
    if (bumped_round_ != world_.round) {
        if (bumped_any_) bumped_.clear();
        bumped_any_ = bumped_new_ = false;
        bumped_round_ = world_.round;
    }
}

const Field& Pathing::cached(Slot& slot, const bitboard& goals) {
    if (!slot) {
        FuelMeter meter{"field"};
        // Fill the slot only once computed, so a failure leaves it empty to retry.
        slot = std::make_unique<Field>(make_field(static_walls(), goals));
    }
    return *slot;
}

Pathing::Slot& Pathing::altar_slot(int altar) { return entry(altar_fields_, map().altars.size(), altar); }

const Field& Pathing::to_ally_spawn() {
    return world_.me().facts().has_dash() ? cached(ally_spawn_, map().ally_spawn) : map().from_ally_spawn();
}

const Field& Pathing::to_altar(int altar) { return cached(altar_slot(altar), map().altars[altar].tribute_tiles()); }

const Field& Pathing::to_any_altar() {
    if (any_altar_) return *any_altar_;
    bitboard goals;
    for (const auto& a : map().altars) goals |= a.tribute_tiles();
    return cached(any_altar_, goals);
}

const Field& Pathing::to_hop(int hop) { return cached(entry(hop_fields_, map().hops().size(), hop), map().hops()[hop].sources); }

int Pathing::hop_landing_steps(int hop) {
    auto& steps = entry(hop_landing_steps_, map().hops().size(), hop);
    if (!steps) {
        const auto& h = map().hops()[hop];
        const auto& field = to_altar(h.altar);
        int best = unreachable;
        for (const vec2 l : h.landings.positions()) best = std::min(best, field.at(l));
        steps = best;
    }
    return *steps;
}

int Pathing::centre_to_altar(int group) {
    auto& steps = entry(centre_to_altar_, map().groups.size(), group);
    // Draft steps use walking walls; a dasher keeps its own field's graph, as for spawn steps.
    if (!steps && (!world_.me().facts().has_dash() || map().crossable.is_empty())) steps = map().drafted_altar_steps(group);
    if (!steps) steps = to_any_altar().at(map().groups[group].centre);
    return *steps;
}

const bitboard& Pathing::live_camps() {
    if (live_camps_version_ != world_.camps_version) {
        live_camps_version_ = world_.camps_version;
        // Only the groups whose belief changed are rewritten.
        const auto& groups = map().groups;
        if (live_versions_.size() != groups.size()) live_versions_.assign(groups.size(), ~0u), live_members_.assign(groups.size(), 0);
        for (std::size_t g = 0; g < groups.size(); ++g) {
            const auto& c = world_.camps[g];
            if (live_versions_[g] == c.version) continue;
            live_versions_[g] = c.version;
            const auto& members = groups[g].members;
            if (members.size() > 64) {
                for (std::size_t i = 0; i < members.size(); ++i) live_camps_.set(members[i].pos, c.state == CampState::alive && c.health[i] > 0);
                ++live_flips_;
                continue;
            }
            std::uint64_t alive = 0;
            if (c.state == CampState::alive)
                for (std::size_t i = 0; i < members.size(); ++i) alive |= static_cast<std::uint64_t>(c.health[i] > 0) << i;
            for (std::uint64_t flipped = alive ^ live_members_[g]; flipped; flipped &= flipped - 1) {
                const int i = __builtin_ctzll(flipped);
                live_camps_.set(members[i].pos, (alive >> i & 1) != 0);
            }
            live_flips_ += alive != live_members_[g];
            live_members_[g] = alive;
        }
    }
    return live_camps_;
}

std::unique_ptr<Pathing::Approach>& Pathing::approach_slot(int group, int range) {
    const auto r = static_cast<std::size_t>(range);
    if (approach_fields_.size() <= r) approach_fields_.resize(r + 1);
    return entry(approach_fields_[r], map().groups.size(), group);
}

[[gnu::flatten]] bool Pathing::approach_ready(int group, int range) {
    const auto& slot = approach_slot(group, range);
    if (!slot) return false;
    const vec2 me = my_pos();
    auto& c = ready_check_;
    if (c.slot != slot.get() || c.round != world_.round || c.at != me) {
        bool ready = slot->field.at(me) != unreachable;
        if (ready) {
            const auto& live = live_camps();
            ready = slot->flips == live_flips_ || slot->camps == live;
        }
        c = {slot.get(), world_.round, me, ready};
    }
    return c.ready;
}

// About our distance to the group: from the approach field it replaces, the group's centre field,
// or by way of our spawn. Walking around live camps can add a few layers.
// Negative when no field bounds it.
int Pathing::approach_steps(int group, int range) {
    const auto& s = map();
    const vec2 me = my_pos();
    const vec2 centre = s.groups[group].centre;
    int steps = -1;
    if (const auto& old = approach_slot(group, range); old && old->field.at(me) != unreachable) steps = old->field.at(me);
    else if (const auto* from = from_centre(group)) steps = from->at(me);
    else if (s.from_ally_spawn_ready() && s.from_ally_spawn().at(me) != unreachable && s.from_ally_spawn().at(centre) != unreachable)
        steps = s.from_ally_spawn().at(me) + s.from_ally_spawn().at(centre);
    else if (s.drafted() && test(s.ally_spawn, me) && s.ally_steps(group) != unreachable)
        steps = s.ally_steps(group);
    return std::min(steps, s.width + s.height);
}

// Unbounded, walls seldom double the distance as the crow flies. At most max_approach_cost().
std::uint64_t Pathing::approach_cost(int group, int range) {
    if (approach_ready(group, range)) return 0;
    const int steps = approach_steps(group, range);
    return search_cost_estimate(steps >= 0 ? steps : std::min(2 * dist(my_pos(), map().groups[group].centre), map().width + map().height));
}

[[gnu::flatten]] const Field* Pathing::prepare_approach(int group, int range, std::uint64_t fuel_floor) {
    if (approach_ready(group, range)) return &approach_slot(group, range)->field;
    const int steps = approach_steps(group, range);
    // With no distance known, the search may run to width + height layers.
    if (!fuel_ok(fuel_floor + search_cost_estimate(steps >= 0 ? steps : map().width + map().height))) return nullptr;
    return search_approach(group, range, steps);
}

const Field* Pathing::approach(int group, int range) {
    if (approach_ready(group, range)) return &approach_slot(group, range)->field;
    return search_approach(group, range, approach_steps(group, range));
}

// Searched out to our tile only: it costs by our distance rather than the map's, and every tile of
// a walk down it is labelled, so it lasts the whole way unless we leave it or a camp dies or returns.
const Field* Pathing::search_approach(int group, int range, int steps) {
    const auto& s = map();
    const vec2 me = my_pos();
    const int layers = steps >= 0 ? steps + max_detour : s.width + s.height;
    FuelMeter meter{"approach"};
    if (!spare_approach_) spare_approach_ = std::make_unique<Approach>();
    auto& made = *spare_approach_;
    static bitboard walls{cambc::uninitialized}, open{cambc::uninitialized}, origin{cambc::uninitialized},
        visited{cambc::uninitialized};
    copy_into(live_camps(), made.camps);
    made.flips = live_flips_;
    or_into(static_walls(), made.camps, walls);
    auto& goals = made.field.goals;
    if (range == 0) {
        copy_into(s.groups[group].tiles(), goals);
    } else {
        clear_board(goals);
        // Live members only: in range of a dead one, a walk down the field saw no gain and stayed.
        const auto& members = s.groups[group].members;
        const bool any_live = std::any_of(members.begin(), members.end(), [&](const auto& m) { return test(made.camps, m.pos); });
        for (const auto& m : members)
            if (!any_live || test(made.camps, m.pos)) draw_square(goals, m.pos, static_cast<float>(range));
        // A respawning group waits for its tiles to empty before it returns.
        if (!any_live) drop(goals, s.groups[group].tiles());
        // Not static_walls(): a dasher cannot stand on the tiles it jumps.
        or_into(s.blocked_for_us, made.camps, open);
        not_into(open, open);
        and_into(goals, open, goals);
    }
    set_tile(walls, me, false);
    clear_board(origin);
    set_tile(origin, me);
    made.field.steps.compute_to(walls, goals, origin, visited, static_cast<std::uint16_t>(layers));
    if (made.field.at(me) == unreachable) return nullptr;
    auto& slot = approach_slot(group, range);
    std::swap(slot, spare_approach_);
    ready_check_.slot = nullptr;
    return &slot->field;
}

const Field* Pathing::from_centre(int group) {
    const auto& slot = entry(centre_fields_, map().groups.size(), group);
    return slot ? slot.get() : nullptr;
}

std::optional<bitboard>& Pathing::attack_slot(int group, int member, int range) {
    const auto r = static_cast<std::size_t>(range);
    if (attack_tiles_.size() <= r) attack_tiles_.resize(r + 1);
    auto& members = entry(attack_tiles_[r], map().groups.size(), group);
    return entry(members, map().groups[group].members.size(), member);
}

const bitboard& Pathing::member_attack_tiles(int group, int member, int range) {
    auto& slot = attack_slot(group, member, range);
    if (!slot && map().attack_tiles_drafted(group, range)) slot = map().drafted_attack_tiles(group, member, range);
    if (!slot) {
        FuelMeter meter{"attack_tiles"};
        const auto& s = map();
        auto tiles = s.viewers(s.groups[group].members[member].pos, range);
        tiles &= s.open_for_us;
        slot = std::move(tiles);
    }
    return *slot;
}

void Pathing::attack_tiles(int group, int range, bitboard& tiles) {
    const auto& health = world_.camps[group].health;
    static bitboard freed{cambc::uninitialized};
    tiles.clear();
    bool any_freed = false;
    for (int i = 0; i < static_cast<int>(health.size()); ++i) {
        if (health[i] > 0) {
            tiles |= member_attack_tiles(group, i, range);
            continue;
        }
        if (!any_freed) copy_into(map().standable, freed);
        any_freed = true;
        freed.set(map().groups[group].members[i].pos);
    }
    tiles &= any_freed ? freed : map().standable;
}

bool Pathing::prepare_member(int group, int member, int range, std::uint64_t fuel_floor) {
    if (attack_slot(group, member, range) || map().attack_tiles_drafted(group, range)) return true;
    // Bush clusters in reach are the costly part; without them a shadowcast or two remain.
    constexpr std::uint64_t viewers_cost = 10000;
    if (!fuel_ok(fuel_floor + viewers_cost)
        || !map().find_bush_clusters(map().groups[group].members[member].pos, range, fuel_floor + viewers_cost))
        return false;
    member_attack_tiles(group, member, range);
    return true;
}

bool Pathing::prepare_attack_tiles(int group, int range, std::uint64_t fuel_floor) {
    const auto& health = world_.camps[group].health;
    for (int i = 0; i < static_cast<int>(health.size()); ++i)
        if (health[i] > 0 && !prepare_member(group, i, range, fuel_floor)) return false;
    return true;
}

bool Pathing::prepare_member_tiles(int group, int range, std::uint32_t members, std::uint64_t fuel_floor) {
    const int n = static_cast<int>(map().groups[group].members.size());
    for (int i = 0; i < n && i < 32; ++i)
        if ((members >> i & 1) && !prepare_member(group, i, range, fuel_floor)) return false;
    return true;
}

const Field* Pathing::attack_field(int group, int range) {
    const auto& slot = entry(attack_fields_, map().groups.size(), group);
    return slot && slot->range == range ? &slot->field : nullptr;
}

const Field* Pathing::prepare_attack_field(int group, int range, std::uint64_t fuel_floor) {
    if (const auto* field = attack_field(group, range)) return field;
    if (!fuel_ok(fuel_floor + field_cost_estimate())) return nullptr;
    FuelMeter meter{"attack_field"};
    auto& slot = entry(attack_fields_, map().groups.size(), group);
    if (!slot) slot = std::make_unique<AttackField>();
    auto& made = *slot;
    static bitboard roots{cambc::uninitialized};
    // Dead camps stay walls too: a field kept through every death and respawn.
    or_into(static_walls(), map().camp_tiles, made.walls);
    clear_board(roots);
    for (const auto& m : map().groups[group].members) draw_square(roots, m.pos, static_cast<float>(range));
    and_into(roots, map().standable, roots);
    made.field = make_field(made.walls, roots);
    made.range = range;
    return &made.field;
}

int Pathing::attack_steps(int group, int range) {
    const auto* field = attack_field(group, range);
    if (!field) return -1;
    const vec2 me = my_pos();
    int steps = field->at(me);
    if (steps != unreachable) return steps;
    for (auto d : directions)
        if (const vec2 p = me + d; in_bounds(p))
            if (const int s = field->at(p); s != unreachable) steps = std::min(steps, s + 1);
    return steps;
}

bool Pathing::walk_to_attack(int group, int range, const bitboard* avoid, std::optional<vec2> aim) {
    const auto* field = attack_field(group, range);
    const int here = attack_steps(group, range);
    if (here <= 0 || here == unreachable || !my_can_move()) return false;
    const auto& walls = entry(attack_fields_, map().groups.size(), group)->walls;
    if (dash_route::step(*this, world_, field->goals, avoid, here + max_detour, aim, &walls)) return true;
    return descend(*field, avoid, aim);
}

bool Pathing::farmed(int g) const { return !map().groups[g].has_monolith && map().groups[g].gems + map().groups[g].gold > 0; }

int& Pathing::centre_cap(int group) {
    auto& cap = entry(centre_caps_, map().groups.size(), group);
    if (!cap && map().drafted()) {
        const int steps = std::max(map().ally_steps(group), map().enemy_steps(group));
        // Off the spawns' walking routes, a centre is on an island: its field is shallow.
        cap = (steps == unreachable ? 0 : steps) + centre_depth_margin;
    }
    return cap;
}

[[gnu::flatten]] bool Pathing::warm_centres(std::uint64_t fuel_floor) {
    if (centres_ready_) return true;
    const auto round = cambc::round_number();
    const auto cost = field_cost_estimate();
    for (int g = 0; g < static_cast<int>(map().groups.size()); ++g) {
        if (!farmed(g)) continue;
        auto& slot = entry(centre_fields_, map().groups.size(), g);
        if (slot) continue;
        if (!centre_cap(g)) {
            if (cambc::round_number() != round || !fuel_ok(fuel_floor + cost)) return false;
            cached(slot, single(map().groups[g].centre));
            continue;
        }
        while (!slot) {
            auto& cap = centre_cap(g);
            if (cambc::round_number() != round || !fuel_ok(last_reserve + search_cost_estimate(cap))) return false;
            FuelMeter meter{"field"};
            slot = make_field(static_walls(), single(map().groups[g].centre), cap);
            if (!slot) cap *= 2;
        }
    }
    centres_ready_ = true;
    return true;
}

bool Pathing::warm_up(int attack_range, std::uint64_t fuel_floor) {
    const auto cost = field_cost_estimate();
    const auto round = cambc::round_number();
    const auto afford = [&](const Slot& slot) { return slot || (cambc::round_number() == round && fuel_ok(fuel_floor + cost)); };
    if (!warm_centres(fuel_floor) || !afford(any_altar_)) return false;
    to_any_altar();
    for (int a = 0; a < static_cast<int>(map().altars.size()); ++a) {
        if (!afford(altar_slot(a))) return false;
        to_altar(a);
    }
    for (int g = 0; g < static_cast<int>(map().groups.size()); ++g)
        if (farmed(g) && (cambc::round_number() != round || !prepare_attack_field(g, attack_range, fuel_floor))) return false;
    for (; warm_group_ < static_cast<int>(map().groups.size()); ++warm_group_, warm_member_ = 0) {
        if (!farmed(warm_group_) || map().attack_tiles_drafted(warm_group_, attack_range)) continue;
        for (; warm_member_ < static_cast<int>(map().groups[warm_group_].members.size()); ++warm_member_)
            if (cambc::round_number() != round || !prepare_member(warm_group_, warm_member_, attack_range, fuel_floor)) return false;
    }
    return true;
}

void Pathing::occupied_into(bitboard& out) {
    static bitboard t{cambc::uninitialized};
    occupancy_into(team::ally, out);
    or_into(out, map().blocked_for_us, out);
    occupancy_into(team::enemy, t);
    or_into(out, t, out);
    camps_into(t);
    or_into(out, t, out);
    teleports_into(t);
    or_into(out, t, out);
    if (bumped_any_) or_into(out, bumped_, out);
}

const bitboard& Pathing::blocked() {
    if (dashes_seen_ != outside_dashes()) invalidate();
    if (!blocked_fresh_) {
        occupied_into(blocked_);
        set_tile(blocked_, my_pos(), false);
        blocked_fresh_ = true;
    }
    return blocked_;
}

void Pathing::invalidate() {
    blocked_fresh_ = false;
    pos_fresh_ = false;
    dashes_seen_ = outside_dashes();
}

vec2 Pathing::my_pos() {
    const auto round = round_now();
    if (dashes_seen_ != outside_dashes()) invalidate();
    if (!pos_fresh_ || pos_round_ != round) {
        pos_ = my_position();
        pos_round_ = round;
        pos_fresh_ = true;
    }
    return pos_;
}

Pathing::Neighbours Pathing::closer_neighbours(const Field& field, const bitboard* avoid, std::optional<vec2> aim) {
    const vec2 me = my_pos();
    const int here = field.at(me);
    const auto& walls = blocked();
    Neighbours out;
    std::array<int, 8> steps_of{};
    std::array<int, 8> aim_of{};
    for (auto d : directions) {
        const vec2 p = me + d;
        if (!in_bounds(p) || test(walls, p) || (avoid && test(*avoid, p)) || (guard() && test(*guard(), p))) continue;
        const int steps = field.at(p);
        if (steps >= here) continue;
        const int towards = step_tiebreak(map(), me, p, aim);
        auto i = out.count++;
        for (; i > 0 && (steps_of[i - 1] > steps || (steps_of[i - 1] == steps && aim_of[i - 1] > towards)); --i)
            out.tiles[i] = out.tiles[i - 1], steps_of[i] = steps_of[i - 1], aim_of[i] = aim_of[i - 1];
        out.tiles[i] = p;
        steps_of[i] = steps;
        aim_of[i] = towards;
    }
    return out;
}

// ---- the local search: the 7x7 window around us in one u64, bit r * 8 + c for tile (x0 + c, y0 + r) ----

namespace local_route {

constexpr std::uint64_t col0 = 0x0101010101010101ull, col7 = 0x8080808080808080ull;
constexpr std::uint64_t inside = 0x007F7F7F7F7F7F7Full; // rows and columns 0..6: column 7 and row 7 stay empty
constexpr std::uint64_t rim = 0x007F41414141417Full;    // rows 0 and 6, columns 0 and 6
constexpr std::uint64_t box5 = 0x00003E3E3E3E3E00ull;   // within 2 of the centre
constexpr std::uint64_t centre = std::uint64_t{1} << 27;

// King neighbours and the tiles themselves; nothing wraps, as column 7 and row 7 stay empty.
inline std::uint64_t dilate(std::uint64_t m) {
    const std::uint64_t t = m | ((m << 1) & ~col0) | ((m >> 1) & ~col7);
    return (t | (t << 8) | (t >> 8)) & inside;
}

// A board's window from (x0, y0), straight from its 8x8 chunk words; off the map reads 0.
inline std::uint64_t window_of(const bitboard& b, int x0, int y0) {
    const auto& layout = cambc::detail::layout();
    const int stride = static_cast<int>(layout.chunk_stride), H = cambc::map::height();
    const int chunks = (cambc::map::width() + 7) >> 3, k0 = x0 >> 3, sh = x0 - 8 * k0;
    const std::uint64_t* words = b.ptr();
    std::uint64_t out = 0;
    for (int r = 0; r < 7; ++r) {
        const int y = y0 + r;
        if (y < 0 || y >= H) continue;
        const std::uint64_t* row = words + (y >> 3) * stride;
        const int s = (y & 7) * 8;
        std::uint32_t v = 0;
        if (k0 >= 0 && k0 < chunks) v = static_cast<std::uint32_t>((row[k0] >> s) & 0xFF);
        if (k0 + 1 >= 0 && k0 + 1 < chunks) v |= static_cast<std::uint32_t>((row[k0 + 1] >> s) & 0xFF) << 8;
        out |= static_cast<std::uint64_t>((v >> sh) & 0x7F) << (r * 8);
    }
    return out;
}

// The window's tiles on the map.
inline std::uint64_t on_map(int x0, int y0) {
    const int W = cambc::map::width(), H = cambc::map::height();
    const int lo = std::max(0, -x0), hi = std::min(6, W - 1 - x0);
    if (lo > hi) return 0;
    const std::uint64_t row = ((std::uint64_t{1} << (hi - lo + 1)) - 1) << lo;
    std::uint64_t out = 0;
    for (int r = 0; r < 7; ++r)
        if (y0 + r >= 0 && y0 + r < H) out |= row << (r * 8);
    return out;
}

inline int slot(int b) { return ((b >> 3) - 1) * 5 + (b & 7) - 1; } // a box5 bit's index in the 5x5

} // namespace local_route

int Pathing::keep_price() const {
    static int price = -1;
    if (price < 0) {
        const auto* plan = read_draft_plan();
        price = plan && plan->reserved[0] > 0 ? plan->reserved[0] : eager_price;
    }
    return price;
}

template <class Steps>
int Pathing::dash_price(int here_steps, Steps steps_at) {
    const vec2 me = my_pos();
    const int keep = keep_price();
    if (enemy_within(world_, me, 8)) return std::max(fight_price, keep);
    // A crossing ahead: a takeoff tile within 8, nearer the goals.
    constexpr int horizon = 8;
    if (here_steps != unreachable && any_within(map().near_crossable, me, horizon)) {
        static bitboard square{cambc::uninitialized}, near{cambc::uninitialized};
        clear_board(square);
        square.draw_chebyshev(me, static_cast<float>(horizon));
        and_into(map().near_crossable, square, near);
        for (auto q : Tiles<17 * 17>{near})
            if (const int s = steps_at(q); s != unreachable && s < here_steps) return keep;
    }
    return eager_price;
}

template <class Steps>
bool Pathing::local_search(const bitboard& goals, const bitboard& walls, Steps host_steps, int dash) {
    using namespace local_route;
    const vec2 me = my_pos();
    const int round = static_cast<int>(world_.round);
    auto& L = local_;
    if (L.round == round && L.at == me && L.dash == dash && boards_equal(L.goals, goals) && boards_equal(L.walls, walls)) return L.found;
    L.round = round, L.at = me, L.dash = dash, L.found = false, L.cost = -1;
    L.to_go.fill(-1);
    copy_into(goals, L.goals);
    copy_into(walls, L.walls);
    const int x0 = me.x - window, y0 = me.y - window;
    const std::uint64_t valid = on_map(x0, y0);
    const std::uint64_t goal = window_of(goals, x0, y0) & valid;
    const std::uint64_t open = (~window_of(walls, x0, y0) & valid) | goal | centre;
    // A dash path may cross holes, altars and allies, not walls, visible camps or enemies, or their spawn.
    std::uint64_t cross = 0;
    if (dash) {
        static bitboard enemies{cambc::uninitialized};
        occupancy_into(team::enemy, enemies);
        cross = valid & ~(window_of(map().walls, x0, y0) | window_of(map().enemy_spawn, x0, y0) | window_of(live_camps(), x0, y0)
                          | window_of(enemies, x0, y0));
    }
    // Rim seeds at 2 a host step, levels relative to the lowest; the goals at 0.
    int levels[24], base = goal ? 0 : 1 << 30, n_seeds = 0;
    std::uint64_t seed_bit[24];
    for (std::uint64_t l = rim & open & ~goal; l; l &= l - 1) {
        const int b = __builtin_ctzll(l);
        const int d = host_steps(vec2{x0 + (b & 7), y0 + (b >> 3)});
        if (d == unreachable) continue;
        levels[n_seeds] = 2 * d, seed_bit[n_seeds++] = std::uint64_t{1} << b;
        base = std::min(base, 2 * d);
    }
    if (base == (1 << 30)) return false;
    // Pending levels in a ring of 64 (every move costs less), `dirty` marking the slots holding some.
    static std::array<std::uint64_t, 64> pending;
    std::uint64_t dirty = 0, later = 0;
    const auto add = [&](int level, std::uint64_t m) {
        const int s = level & 63;
        if (dirty >> s & 1) pending[s] |= m;
        else pending[s] = m, dirty |= std::uint64_t{1} << s;
    };
    if (goal) add(0, goal);
    for (int i = 0; i < n_seeds; ++i)
        if (levels[i] - base < 48) add(levels[i] - base, seed_bit[i]);
        else later |= std::uint64_t{1} << i;
    std::uint64_t settled = 0;
    for (int lv = 0; lv < 4096; ++lv) {
        for (std::uint64_t l = later; l; l &= l - 1) {
            const int i = __builtin_ctzll(l);
            if (levels[i] - base < lv + 48) add(levels[i] - base, seed_bit[i]), later &= ~(std::uint64_t{1} << i);
        }
        const int s = lv & 63;
        if (!(dirty >> s & 1)) {
            if (!dirty && !later) break;
            continue;
        }
        dirty &= ~(std::uint64_t{1} << s);
        const std::uint64_t S = pending[s] & ~settled;
        if (!S) continue;
        settled |= S;
        for (std::uint64_t l = S & box5; l; l &= l - 1) L.to_go[slot(__builtin_ctzll(l))] = static_cast<std::int16_t>(lv + base);
        if (S & centre) {
            L.found = true;
            L.cost = lv + base;
            return true;
        }
        // Onto a tile of S: a step costs 2, a dash the price.
        const std::uint64_t near = dilate(S);
        if (const std::uint64_t step = near & open & ~settled) add(lv + 2, step);
        if (dash)
            if (const std::uint64_t jump = dilate(near & cross) & open & ~settled) add(lv + dash, jump);
    }
    return false;
}

int Pathing::cost_to_go(vec2 p) const {
    const int dx = p.x - local_.at.x, dy = p.y - local_.at.y;
    if (local_.round != static_cast<int>(world_.round) || dx < -2 || dx > 2 || dy < -2 || dy > 2) return -1;
    return local_.to_go[(dy + 2) * 5 + dx + 2];
}

Pathing::Route Pathing::route(const bitboard& goals, const bitboard* avoid, int max_steps, vec2 through, std::optional<vec2> aim) {
    const auto* crossings = route_crossings();
    // Without the dash the walk is the route, returned in place rather than copied.
    if (!crossings) return route_on(goals, avoid, max_steps, through, aim, false);
    auto walk = route_on(goals, avoid, max_steps, through, aim, false);
    if (walk.steps == 0) return walk;
    // The dash ready: the local search picks the first move, a step or a dash, by its price.
    const vec2 me = my_pos();
    const bool walks = walk.steps != unreachable;
    const auto host = [&](vec2 p) { return walks ? steps_at(kept_route_.field, p) : static_cast<int>(unreachable); };
    static bitboard walls{cambc::uninitialized};
    copy_into(blocked(), walls);
    if (avoid && !test(*avoid, me)) or_into(walls, *avoid, walls);
    if (guard()) or_into(walls, *guard(), walls);
    set_tile(walls, me, false);
    const int price = dash_price(walks ? walk.steps : static_cast<int>(unreachable), host);
    if (local_search(goals, walls, host, price)) {
        int step = 1 << 30, jump = 1 << 30;
        for (auto d : directions)
            if (const vec2 p = me + d; in_bounds(p) && !test(walls, p))
                if (const int c = cost_to_go(p); c >= 0) step = std::min(step, 2 + c);
        vec2 land{-1, -1};
        for (auto y : Tiles<5 * 5>{dash_landings()}) {
            if ((avoid && test(*avoid, y)) || wakes_camp(world_, y) || landing_suicidal(world_, y)) continue;
            if (const int c = cost_to_go(y); c >= 0 && price + c < jump && !skips_bush(map(), me, y)) jump = price + c, land = y;
        }
        if (jump < step) {
            Route r;
            r.steps = walks ? walk.steps : (jump + 1) / 2;
            r.dash_to = land;
            return r;
        }
        // A step: the neighbours the search found cheapest, in step_tiebreak's order.
        Route r;
        r.steps = walks ? walk.steps : (step + 1) / 2;
        for (auto d : directions)
            if (const vec2 p = me + d; in_bounds(p) && !test(walls, p) && cost_to_go(p) >= 0 && 2 + cost_to_go(p) == step)
                r.first_steps[r.count++] = p;
        if (r.count > 0) {
            order_steps(r, me, aim);
            return r;
        }
    }
    if (walks) return walk;
    // No walk to goals beyond the window: a whole-map route with the crossings open, jumped by dash_over
    // where the route needs one now.
    auto dash = route_on(goals, avoid, max_steps, through, aim, true);
    int walking = 0;
    for (int i = 0; i < dash.count; ++i)
        if (!test(*crossings, dash.first_steps[i])) dash.first_steps[walking++] = dash.first_steps[i];
    if (walking > 0) dash.count = walking;
    return dash;
}

[[gnu::flatten]] Pathing::Route Pathing::route_on(const bitboard& goals, const bitboard* avoid, int max_steps, vec2 through, std::optional<vec2> aim, bool crossings) {
    world_.throw_if_stale();
    Route r;
    route_exhausted_ = false;
    const vec2 me = my_pos();
    if (test(goals, me)) {
        r.steps = 0;
        return r;
    }
    // Scratch kept between calls: the host overwrites every output in full.
    static bitboard walls{cambc::uninitialized}, origin, visited{cambc::uninitialized};
    static vec2 origin_at{-1, -1};
    // A route is mostly followed by a step, which makes blocked() stale: unless it is fresh, the
    // walls are read straight into the route's board. Our tile is freed below.
    if (blocked_fresh_) copy_into(blocked_, walls);
    else occupied_into(walls);
    if (crossings) drop(walls, *route_crossings());
    if (in_bounds(through)) set_tile(walls, through, false);
    if (avoid && test(*avoid, me)) {
        // Inside danger every neighbour is in it too: free the connected region we stand in. Kept
        // for the next route from this tile around the same danger.
        static bitboard outside{cambc::uninitialized}, region{cambc::uninitialized}, danger{cambc::uninitialized},
            danger_of{cambc::uninitialized};
        static vec2 danger_at{-1, -1};
        if (me != danger_at || !boards_equal(*avoid, danger_of)) {
            not_into(*avoid, outside);
            outside.reachable_tiles_into(me, static_cast<std::uint16_t>(map().width + map().height), region);
            copy_into(*avoid, danger);
            drop(danger, region);
            copy_into(*avoid, danger_of);
            danger_at = me;
        }
        or_into(walls, danger, walls);
    } else if (avoid) {
        or_into(walls, *avoid, walls);
    }
    if (guard()) or_into(walls, *guard(), walls);
    set_tile(walls, me, false);
    const int cap = std::min<int>(max_steps, unreachable);
    auto& kept = kept_route_;
    int here = kept_steps(kept, goals, walls, me, cap);
    if (here == unreachable) {
        // A search fails only at its cap, having labelled all the goals reach, so in a pocket (holes a
        // dash crossed, units) it costs a whole map; a standoff repeats it every turn. Once a failed
        // search finds us enclosed, that tile is tested first.
        if (me == pocket_at_) {
            if (enclosed(walls, goals, me)) {
                route_exhausted_ = true;
                return r;
            }
            pocket_at_ = {-1, -1};
        }
        // Search outwards from the goals until it reaches us: every tile one layer nearer than ours
        // is then labelled, so each neighbour on a shortest route is known.
        FuelMeter meter{"route"};
        if (in_bounds(origin_at)) set_tile(origin, origin_at, false);
        set_tile(origin, me);
        origin_at = me;
        // Goals on walls are no roots; with none left we stay unreachable. A search that runs dry
        // counts one layer past its last; one cut off at the cap counts the cap.
        const int layers = route_field_.compute_to_with_expansion_count(walls, goals, origin, visited, static_cast<std::uint16_t>(cap));
        here = steps_at(route_field_, me);
        if (here == unreachable) {
            route_exhausted_ = layers < cap;
            if (!route_exhausted_ && enclosed(walls, goals, me)) route_exhausted_ = true, pocket_at_ = me;
            return r;
        }
        std::swap(route_field_, kept.field);
        copy_into(goals, kept.goals);
        walls.swap(kept.walls);
        kept.layer = here;
    }
    const auto& field = kept.field;
    r.steps = here;
    // As distance_field::next_moves_from, without its vector: the nearest neighbours, north first.
    std::array<std::uint16_t, 8> around{};
    std::uint16_t best = unreachable;
    const bool inside = me.x > 0 && me.y > 0 && me.x < map().width - 1 && me.y < map().height - 1;
    for (int i = 0; i < 8; ++i) {
        const vec2 p = me + directions[i];
        around[i] = inside || in_bounds(p) ? static_cast<std::uint16_t>(steps_at(field, p)) : unreachable;
        best = std::min(best, around[i]);
    }
    if (best < here)
        for (int i = 0; i < 8; ++i)
            if (around[i] == best) r.first_steps[r.count++] = me + directions[i];
    order_steps(r, me, aim);
    return r;
}

void Pathing::order_steps(Route& r, vec2 from, std::optional<vec2> aim) const {
    if (r.count < 2) return;
    std::array<int, 8> towards{};
    for (int j = 0; j < r.count; ++j) {
        const vec2 p = r.first_steps[j];
        const int score = step_tiebreak(map(), from, p, aim);
        int i = j;
        for (; i > 0 && towards[i - 1] > score; --i)
            r.first_steps[i] = r.first_steps[i - 1], towards[i] = towards[i - 1];
        r.first_steps[i] = p;
        towards[i] = score;
    }
}

// make_way reads the failed search's labels, but only beside an ally next to us: with none there, no
// cap reaches a goal from a closed walkable region that holds none.
bool Pathing::enclosed(const bitboard& walls, const bitboard& goals, vec2 me) {
    static bitboard region{cambc::uninitialized}, wider{cambc::uninitialized}, allies{cambc::uninitialized};
    walls.reachable_tiles_into(me, pocket_radius, region);
    walls.reachable_tiles_into(me, pocket_radius + 1, wider);
    if (!boards_equal(region, wider)) return false;
    and_into(region, goals, wider);
    if (!board_empty(wider)) return false;
    occupancy_into(team::ally, allies);
    for (auto d : directions)
        if (in_bounds(me + d) && test(allies, me + d)) return false;
    return true;
}

// Removing a tile at or past our layer, or adding one whose neighbours all lie at or past the
// layer before ours (it would land at or past ours), changes no label below ours.
int Pathing::kept_steps(const KeptRoute& k, const bitboard& goals, const bitboard& walls, vec2 me, int cap) {
    if (k.layer < 0) return unreachable;
    const int steps = steps_at(k.field, me);
    if (steps == unreachable || steps > k.layer || steps > cap || !(goals == k.goals)) return unreachable;
    static bitboard changed{cambc::uninitialized};
    xor_into(walls, k.walls, changed);
    constexpr std::uint32_t most = 4;
    if (board_empty(changed)) return steps;
    std::array<vec2, most + 1> at;
    const auto n = positions_into(changed, at.data(), most + 1);
    if (n > most) return unreachable;
    for (std::uint32_t i = 0; i < n; ++i) {
        const vec2 t = at[i];
        if (test(walls, t)) {
            if (steps_at(k.field, t) < steps) return unreachable;
            continue;
        }
        if (test(goals, t)) return unreachable;
        for (const auto d : directions)
            if (in_bounds(t + d) && steps_at(k.field, t + d) + 1 < steps) return unreachable;
    }
    return steps;
}

[[gnu::flatten]] bool Pathing::try_move(vec2 tile, bool* refused) {
    if (refused) *refused = true;
    if (guard() && test(*guard(), tile)) return false;
    if (refuses(tile)) return false;
    throw_if_stale();
    // Posted to the team before it is made, and where we are after.
    const vec2 from = my_position();
    if (!::comms::may_move(from, tile)) return false;
    try {
        if (cambc::self().move_absolute(tile)) {
            ::comms::moved(from);
            invalidate();
            return true;
        }
        ::comms::moved(from);
        // A hidden unit was there: the tile is now revealed to us for the rest of the round.
        if (refused) *refused = false;
        set_tile(bumped_, tile);
        bumped_any_ = bumped_new_ = true;
        invalidate();
    } catch (const cambc::error&) {
        ::comms::moved(from);
    }
    return false;
}

[[gnu::flatten]] bool Pathing::step_towards(const bitboard& goals, const bitboard* avoid, int max_steps, std::optional<vec2> aim) {
    if (!my_can_move()) return false;
    if constexpr (debug_state_lines) debug_block({ _state_target = aim ? *aim : nearest_goal(goals, my_position()); });
    // A dasher's turn by dash_route's router, which plans the dash with its cooldown and the crossings ahead.
    if (const auto moved = dash_route::step(*this, world_, goals, avoid, max_steps, aim)) return *moved;
    // Only a hidden blocker makes a retry worth its search.
    for (int attempt = 0; attempt < 3; ++attempt) {
        const auto r = route(goals, avoid, max_steps, {-1, -1}, aim);
        if (in_bounds(r.dash_to)) {
            if (const int dash = ready(world_, AbilityKind::dash); dash >= 0 && self_cast(dash, r.dash_to)) {
                invalidate();
                return true;
            }
            return false;
        }
        const auto* crossings = route_crossings();
        bool bumped = false;
        for (int i = 0; i < r.count; ++i) {
            if (crossings && test(*crossings, r.first_steps[i])) {
                if (dash_over(r.steps, avoid)) return true;
                continue;
            }
            if (try_move(r.first_steps[i])) return true;
            bumped |= test(bumped_, r.first_steps[i]);
        }
        if (!bumped) return r.steps == unreachable && make_way(goals, avoid, max_steps);
    }
    return false;
}

const bitboard* Pathing::route_crossings() {
    const auto& f = world_.me().facts();
    if (!f.has_dash() || map().crossable.is_empty() || !my_can_cast() || ready(world_, AbilityKind::dash) < 0) return nullptr;
    static bitboard crossings{cambc::uninitialized};
    static int kind = -1;
    if (const int k = dash_kind(f); k != kind) {
        kind = k;
        copy_into(map().crossable, crossings);
        drop(crossings, static_walls());
    }
    return &crossings;
}

bool Pathing::dash_over(int steps, const bitboard* avoid) {
    const int dash = ready(world_, AbilityKind::dash);
    if (dash < 0) return false;
    const auto& field = kept_route_.field;
    vec2 best{-1, -1};
    int best_steps = steps - self_dash_steps + 1;
    for (auto y : Tiles<5 * 5>{dash_landings()}) {
        const int at = steps_at(field, y);
        if (at >= best_steps || (avoid && test(*avoid, y)) || wakes_camp(world_, y) || landing_suicidal(world_, y)
            || skips_bush(map(), my_pos(), y))
            continue;
        best = y, best_steps = at;
    }
    if (best.x < 0 || !self_cast(dash, best)) return false;
    invalidate();
    return true;
}

bool Pathing::make_way(const bitboard& goals, const bitboard* avoid, int max_steps) {
    const vec2 me = my_pos();
    static bitboard allies{cambc::uninitialized};
    occupancy_into(team::ally, allies);
    // Freeing ally tile a adds only a to the failed search: a's distance is one more than its
    // nearest labelled neighbour's (labels run up to the cap), and ours one more than a's. Our own
    // labelled neighbours are all at the cap, so a is then the only first step.
    const int cap = std::min<int>(max_steps, unreachable);
    bool opened = false;
    for (auto d : directions) {
        const vec2 a = me + d;
        if (!in_bounds(a) || !test(allies, a)) continue;
        // route() blocks these again after freeing a; inside danger, a is in our own region.
        if ((guard() && test(*guard(), a)) || (avoid && test(*avoid, a) && !test(*avoid, me))) continue;
        if (test(goals, a)) {
            opened = true;
            continue;
        }
        int nearest = unreachable;
        for (auto e : directions)
            if (in_bounds(a + e)) nearest = std::min(nearest, steps_at(route_field_, a + e));
        if (nearest == unreachable) continue;
        opened = true;
        if (nearest + 2 > cap) continue;
        route_exhausted_ = false;
        auto& self = cambc::self();
        const auto ally = cambc::vision::champion_at(a);
        const auto mine = self.gem_count(), theirs = ally.gem_count();
        if (mine > theirs || (mine == theirs && self.champion_name() > ally.champion_name())) return false;
        const auto& walls = blocked();
        std::optional<vec2> best;
        int best_dist = 0;
        for (auto e : directions) {
            const vec2 p = me + e;
            if (!in_bounds(p) || test(walls, p) || (avoid && test(*avoid, p)) || (guard() && test(*guard(), p))) continue;
            if (const int d2 = dist(p, a); d2 > best_dist) best = p, best_dist = d2;
        }
        return best && try_move(*best);
    }
    // A search that ran dry reaches a free ally's tile only to open a way through it.
    route_exhausted_ &= !opened;
    return false;
}

bool Pathing::step_towards_funded(const bitboard& goals, std::uint64_t fuel_floor) {
    const auto round = cambc::round_number();
    if (world_.round != round) return false;
    if (!my_can_move() || test(goals, my_pos())) return false;
    const auto fixed = search_cost_estimate(0) + small_cost_estimate;
    const auto chunks = search_chunks();
    for (int attempt = 0; attempt < 3; ++attempt) {
        const auto remaining = fuel();
        if (remaining < fuel_floor || remaining - fuel_floor < fixed + chunks) {
            note_shortcut("siege-route-fuel");
            return false;
        }
        // A shortest simple path cannot exceed the map's tile count. Budget every search at
        // its actual cap, including hidden-blocker retries, and never substitute other goals.
        const int cap = static_cast<int>(std::min<std::uint64_t>(
            static_cast<std::uint64_t>(map().width) * map().height,
            (remaining - fuel_floor - fixed) / chunks));
        if (cambc::round_number() != round) return false;
        const auto r = route(goals, nullptr, cap);
        if (cambc::round_number() != round) return false;
        bool bumped = false;
        for (int i = 0; i < r.count; ++i) {
            if (cambc::round_number() != round) return false;
            const auto before_move = fuel();
            if (before_move < fuel_floor || before_move - fuel_floor < last_reserve) return false;
            if (try_move(r.first_steps[i])) return true;
            bumped |= test(bumped_, r.first_steps[i]);
        }
        if (!bumped) return false;
    }
    return false;
}

bool Pathing::step_towards(const Field& field, const bitboard* avoid, std::optional<vec2> aim) {
    const int here = field.at(my_pos());
    if (here == 0 || !my_can_move()) return false;
    bool searched = false;
    if (here != unreachable) {
        const int cap = here + max_detour;
        if (!fuel_ok(search_cost_estimate(cap) + end_reserve)) note_shortcut("static-descend");
        else if (step_towards(field.goals, avoid, cap, aim)) return true;
        else searched = true;
    }
    if (descend(field, avoid, aim)) return true;
    // Live camps can block the static way for longer than max_detour (a dead-end pocket whose way
    // out a camp holds): a wider search walks round them, unless the last ran dry.
    return searched && !route_exhausted_ && step_towards(field.goals, avoid, here + 6 * max_detour, aim);
}

bool Pathing::descend(const Field& field, const bitboard* avoid, std::optional<vec2> aim) {
    if (!my_can_move()) return false;
    for (auto p : closer_neighbours(field, avoid, aim))
        if (try_move(p)) return true;
    return false;
}

bool Pathing::step_closer(vec2 target, const bitboard* avoid, std::optional<vec2> aim) {
    if (!my_can_move()) return false;
    const vec2 me = my_pos();
    const auto& walls = blocked();
    std::optional<vec2> best;
    int best_dist = dist(me, target);
    for (auto d : directions) {
        const vec2 p = me + d;
        if (!in_bounds(p) || test(walls, p) || (avoid && test(*avoid, p)) || (guard() && test(*guard(), p))) continue;
        if (const int d2 = dist(p, target); d2 < best_dist
            || (best && d2 == best_dist && aim && aim_distance(p, *aim) < aim_distance(*best, *aim)))
            best = p, best_dist = d2;
    }
    return best && try_move(*best);
}

const bitboard& dash_landings_from(const StaticMap& map, vec2 from, const bitboard* also) {
    static bitboard camps{cambc::uninitialized}, excluded{cambc::uninitialized}, t{cambc::uninitialized},
        landings{cambc::uninitialized};
    camps_into(camps);
    // Dash paths cross holes, altars, allies and unseen enemies, but not walls, camps, visible
    // enemies (probe-dash-enemy) or the enemy spawn.
    occupancy_into(team::enemy, t);
    or_into(map.walls, camps, excluded);
    or_into(excluded, t, excluded);
    or_into(excluded, map.enemy_spawn, excluded);
    excluded.reachable_tiles_into(from, 2, landings);
    and_into(landings, map.open_for_us, landings);
    or_into(camps, t, excluded);
    occupancy_into(team::ally, t);
    or_into(excluded, t, excluded);
    teleports_into(t);
    or_into(excluded, t, excluded);
    if (also) or_into(excluded, *also, excluded);
    and_into(excluded, landings, excluded);
    xor_into(landings, excluded, landings);
    set_tile(landings, from, false);
    return landings;
}

const bitboard& Pathing::dash_landings() {
    static bitboard off{cambc::uninitialized};
    const bitboard* also = nullptr;
    if (bumped_any_ && guard()) or_into(bumped_, *guard(), off), also = &off;
    else if (bumped_any_) also = &bumped_;
    else if (guard()) also = guard();
    return dash_landings_from(map(), my_pos(), also);
}

bitboard Pathing::teleport_targets() {
    static bitboard t{cambc::uninitialized};
    auto targets = square(my_pos(), 3);
    targets &= map().standable;
    occupancy_into(team::ally, t);
    drop(targets, t);
    occupancy_into(team::enemy, t);
    drop(targets, t);
    teleports_into(t);
    drop(targets, t);
    if (bumped_any_) drop(targets, bumped_);
    return targets;
}

} // namespace aph
